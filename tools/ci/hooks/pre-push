#!/bin/sh
# CI 基线门禁 pre-push 守卫（地板清单咬合 + 断言质量假绿）
#
# 背景：light-merge 有多道「基线对比」类 CI 门禁，其基线都是人工维护的镜像，极易因
# 行号漂移 / 漏同步而误判。本钩子把这些门禁前置到推送前，避免「推上去才在 CI 长红」的往返。
#
#   • 地板清单咬合（floor_bootstrap）：stdlib/builtins.py 顶层函数名 集合 必须 ==
#     任务书/自举地板清单.json 的 名字 集合，否则拦截；咬合后再跑完整门禁，基线棘轮红则警告。
#     靠手同步已两次流到 CI 才被发现（test_地板清单与builtins咬合 / 地板自举率门禁 棘轮红）。
#   • 断言质量假绿（assert_quality）：全仓扫描「零信号断言」（is not None / len<=N 等）。
#     2026-09-01 因 code_generator.py 在 1090→1107 行号漂移，基线失效条目给新违规留了赦免票，
#     被 CI 判成「新增违规」长红——本段在推送前把这道门禁也跑一遍，基线失效即警告刷新。
#
# 行为：
#   1) 名单双向咬合（builtins.py 顶层函数名 集合 == 清单 名字 集合）不通过 → 拦截推送，
#      并打印具体「代码有清单无 / 清单有代码无」差异，给出修复命令。
#   2) 咬合通过后，再跑完整地板门禁（floor_bootstrap.py --root .）；若仍红 → 非阻塞警告，
#      提示「清单变了但基线没刷新」，建议本地 --write-baseline 后再推。这一步不拦推送，
#      因为基线棘轮（自举率只升不降 / 豁免只降不升）本就是合并点的人工裁决动作，
#      不应被钩子自动放过或自动刷新。
#   3) 断言质量假绿门禁（assert_quality.py --root .）：推送前先跑一遍对比模式。
#      出现基线条目之外的新增假绿 → 非阻塞警告（CI 会硬拦，建议改断言或 --write-baseline）；
#      基线存在失效条目（多半是行号漂移）→ 非阻塞警告，提示本地 --write-baseline 后再推，
#      避免像 2026-09-01 那样在 CI 长红。
#
# 安装（任选其一）：
#   cp tools/ci/hooks/pre-push .git/hooks/pre-push && chmod +x .git/hooks/pre-push
#   # 或团队统一：git config core.hooksPath tools/ci/hooks
#
# 跳过本次推送：git push --no-verify

# 选 python 解释器：优先本机托管 python，退回 python3 / python
PY="${WORKBUDDY_PYTHON:-C:/Users/skywalk/.workbuddy/binaries/python/versions/3.13.12/python.exe}"
if [ ! -x "$PY" ]; then
  if command -v python3 >/dev/null 2>&1; then PY=python3
  elif command -v python >/dev/null 2>&1; then PY=python
  else
    echo "[pre-push 地板守卫] 找不到 python，跳过守卫（未拦截）。" >&2
    exit 0
  fi
fi

"$PY" - <<'PYEOF'
import io, ast, json, os, subprocess, sys

root = '.'
清单路径 = os.path.join(root, '任务书', '自举地板清单.json')
源路径 = os.path.join(root, 'stdlib', 'builtins.py')

def 读函数名():
    with io.open(源路径, encoding='utf-8') as f:
        tree = ast.parse(f.read())
    return {n.name for n in tree.body
            if isinstance(n, (ast.FunctionDef, ast.AsyncFunctionDef))}

def 读清单名():
    with io.open(清单路径, encoding='utf-8') as f:
        data = json.load(f)
    条目 = data.get('函数') or []
    return {c.get('名字') for c in 条目 if isinstance(c, dict)}

try:
    真 = 读函数名()
    清单 = 读清单名()
except (OSError, SyntaxError, ValueError) as e:
    print('[pre-push 地板守卫] 读不动地板源/清单（%s），跳过守卫。' % e, file=sys.stderr)
    sys.exit(0)

漏 = sorted(真 - 清单)
吹 = sorted(清单 - 真)
if 漏 or 吹:
    print('[pre-push 地板守卫] 拦截推送：stdlib/builtins.py 与 任务书/自举地板清单.json 脱节', file=sys.stderr)
    if 漏:
        print('  代码有、清单缺（防腐烂）：' + '、'.join(漏), file=sys.stderr)
    if 吹:
        print('  清单有、代码无（防吹牛）：' + '、'.join(吹), file=sys.stderr)
    print('  修复：python tools/ci/floor_bootstrap.py --root . --sync-list  （补完分类/职责/证据行后提交）', file=sys.stderr)
    sys.exit(1)

print('[pre-push 地板守卫] 名单双向咬合 ✓')

# 咬合通过：再跑完整门禁。若仍红，多半是「清单改了但基线未刷新」→ 非阻塞警告。
门禁 = os.path.join(root, 'tools', 'ci', 'floor_bootstrap.py')
if os.path.isfile(门禁):
    g = subprocess.run([sys.executable, 门禁, '--root', root],
                       stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                       encoding='utf-8', errors='replace')
    if g.returncode != 0:
        print('[pre-push 地板守卫] 警告：完整地板门禁仍红（名单已咬合，多半是清单改了但基线未刷新）。', file=sys.stderr)
        print('  本地刷新基线后再推：', file=sys.stderr)
        print('    python tools/ci/floor_bootstrap.py --root . --write-baseline tools/ci/floor_bootstrap_baseline.json', file=sys.stderr)
        print('  （此警告不拦截推送；CI 的完整门禁会硬拦，请务必先刷新基线）', file=sys.stderr)

# ── 断言质量门禁守卫（举一反三：同一类「人工镜像基线」漂移脆弱性）──
# src/code_generator.py 等文件只要被插入/删除几行，之前登记在基线里的违规行号就会失效，
# 失效条目会给「同文件同行号的新违规」留一张永久赦免票，于是 CI 把它判成「新增违规」长红
# （本次 2026-09-01 的 src/code_generator.py:1107 正是如此：1090→1107 行号漂移）。
# 本段在推送前把这道门禁也跑一遍：新增违规 → 警告并给修复命令；基线失效（仅行号漂移）→ 警告刷新。
# 两步都不拦推送：CI 才是硬闸门；钩子只做「提前一轮」的早发现，避免推上去才往返。
import re as _re
质量门禁 = os.path.join(root, 'tools', 'ci', 'assert_quality.py')
if os.path.isfile(质量门禁):
    g = subprocess.run([sys.executable, 质量门禁, '--root', root],
                       stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                       encoding='utf-8', errors='replace')
    out = g.stdout or ''
    _m = _re.search(r'新增违规\s+(\d+)\s+条', out)
    _new = int(_m.group(1)) if _m else 0
    _s = _re.search(r'已减少\s+(\d+)\s+条', out)
    _stale = int(_s.group(1)) if _s else 0
    if _new > 0:
        print('[pre-push 断言质量守卫] 警告：出现 %d 条基线条目之外的新增假绿断言（CI 会判红拦截）：' % _new, file=sys.stderr)
        for _l in out.splitlines():
            if _l.strip().startswith('! '):
                print('   ' + _l.strip(), file=sys.stderr)
        print('   建议：把断言改得有信号（不只断 is not None / len<=N 等），或本地 --write-baseline 将其纳入基线后重推：', file=sys.stderr)
        print('     python tools/ci/assert_quality.py --root . --write-baseline tools/ci/assert_quality_baseline.json', file=sys.stderr)
    if _stale > 0:
        print('[pre-push 断言质量守卫] 警告：基线存在 %d 条失效条目（多半是行号漂移），推送前建议先刷新基线：' % _stale, file=sys.stderr)
        print('   python tools/ci/assert_quality.py --root . --write-baseline tools/ci/assert_quality_baseline.json', file=sys.stderr)
        print('  （不刷新会像本次一样在 CI 长红）', file=sys.stderr)
sys.exit(0)
PYEOF
