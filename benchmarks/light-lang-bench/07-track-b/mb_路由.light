# 文体: 白话
# MiniBridge · 路由表（route.conf 的读取与查表）
#
# 职责边界（规格 §2.2 / DoD D4）：
#   **本模块只做「读配置 + 查表 + 默认分支」**，而路由决策必须发生在光明侧、
#   且不得藏在任何 `引 ...:` 块里。本文件里没有任何 `引` 块——查表是纯光明代码，
#   handler 的调用在 mb_进程.light（进程）与 mb_cffi.light（B2 FFI）里。
#
# route.conf 语法（规格 §2.1）：
#   每行 `service<TAB>handler`；`#` 开头为注释；空白行忽略；
#   必须有一行 `*<TAB>handler` 作为默认分支；同名 service 后者覆盖前者。

导出 载入路由 查句柄。

# 把一份路由文本解析成「服务名 → 句柄名」的映射。
段落 载入路由(路径):
  文本 = 读取文件(路径)
  表 = {}
  行号 = 0
  遍历 物理行 于 文本.分割("\n"):
    行号 = 行号 + 1
    行 = 物理行
    如果 行.结尾("\r"):
      行 = 行[0:行.长度() - 1]
    干净 = 行.去除空白()
    # 空行与注释行不参与路由（规格 §2.1）。
    如果 干净 == "":
      跃
    如果 干净.开头("#"):
      跃
    段们 = 行.分割("\t")
    如果 段们.长度() < 2:
      抛出 运行时错误("route.conf 第 " + 串(行号) + " 行缺少 TAB 分隔: " + 干净)
    服务 = 段们[0].去除空白()
    句柄 = 段们[1].去除空白()
    如果 服务 == "" 或 句柄 == "":
      抛出 运行时错误("route.conf 第 " + 串(行号) + " 行有空列: " + 干净)
    表[服务] = 句柄
  如果 非 ("*" 在 表):
    抛出 运行时错误("route.conf 缺少通配行 *<TAB>handler")
  返回 表

# 查表：命中就用命中的句柄，否则走通配行的默认句柄。
段落 查句柄(表, 服务):
  如果 服务 在 表:
    返回 表[服务]
  返回 表["*"]
