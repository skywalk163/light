# 文体: 白话
# MiniBridge · 主程序（B1 进程编排 / B2 C FFI，规格 §3 + §4）
#
# 输入：参数给一个 NDJSON 路径（缺省从 stdin 读到 EOF）。
# 模式：环境变量 MB_MODE=b1|b2（缺省 b1）。b2 只把 h_c_hash 换成 C FFI 直调，
#       其余 handler 与全部路由/错误语义保持不变（规格 §4.3）。
# 输出：按输入顺序逐条打印 `service<TAB>结果`，行尾 `\n`。
# 错误：见规格 §3.3 —— handler 失败 → 该行 `ERR` 且继续；非法 JSON 行 → 跳过并
#       在 stderr 打 `WARN invalid_json index=<n>`；两者都不改最终退出码（0）。
#
# 结构（DoD D4）：路由决策全在本文件与 mb_路由.light（纯光明代码）；
# handler 的调用在 mb_进程.light / mb_cffi.light；`引 C:` 块只出现在 mb_cffi.light。

从 mb_路由 导入 载入路由 查句柄。
从 mb_调度 导入 调用一条。

# 取一条记录的 service 字段（必须是 JSON 字符串，否则视为缺失 → 空串）。
段落 取服务(记录):
  值 = 记录.获取("service", 空)
  如果 值 == 空:
    返回 ""
  如果 类型(值) == 类型(""):
    返回 值
  返回 ""

# 处理一行：返回 `服务<TAB>结果`；不是 JSON 对象（语法错误 / 数组 / 标量）返回 空，
# 由调用方按规格 §3.3 打 `WARN invalid_json index=<n>`。
段落 处理行(行, 表, 模式):
  尝试:
    记录 = 解析JSON(行)
  捕获 错误 为 e:
    返回 空
  如果 类型(记录) != 类型({}):
    返回 空
  服务 = 取服务(记录)
  句柄 = 查句柄(表, 服务)
  结果 = 空
  尝试:
    结果 = 调用一条(句柄, 行, 模式)
  捕获 错误 为 e:
    结果 = 空
  如果 结果 == 空:
    返回 服务 + "\t" + "ERR"
  返回 服务 + "\t" + 结果

# 读全部输入并切行。结尾的 \n 会切出一个空尾巴，按「空行忽略」丢掉。
段落 切行(文本):
  行们 = []
  遍历 片段 于 文本.分割("\n"):
    如果 片段 == "":
      跃
    行 = 片段
    如果 行.结尾("\r"):
      行 = 行[0:行.长度() - 1]
    行们.追加(行)
  返回 行们

# 从 stdin 读到 EOF（分块读，不假设单次调用能拿全）。
段落 读标准输入():
  块们 = []
  当 真:
    块 = 读取N字节(1048576)
    如果 块 == "":
      断
    块们.追加(块)
  返回 块们.连接("")

段落 运行(路径, 模式):
  表 = 载入路由(连接路径(当前目录(), "route.conf"))
  如果 路径 == "":
    文本 = 读标准输入()
  否则:
    文本 = 读取文件(路径)
  行们 = 切行(文本)
  索引 = 0
  遍历 行 于 行们:
    索引 = 索引 + 1
    结果 = 处理行(行, 表, 模式)
    如果 结果 == 空:
      打印错误("WARN invalid_json index=" + 串(索引))
    否则:
      打印(结果)

段落 主():
  模式 = 环境变量("MB_MODE", "b1")
  参数 = 用户参数()
  路径 = ""
  如果 参数.长度() > 0:
    路径 = 参数[0]
  运行(路径, 模式)

主()
