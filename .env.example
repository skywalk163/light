# SSH 连接配置 - 请勿提交到版本控制
SSH_HOST=your_remote_host

# trae 用户
SSH_USER_TRAE=trae
SSH_PASS_TRAE=your_password_here

# dumate 用户
SSH_USER_DUMATE=dumate
SSH_PASS_DUMATE=your_password_here
SSH_PASS_DUMATE2=your_password_here

# sudo 密码
SUDO_PASS=your_sudo_password_here

# pypi 密码
TWINE_USERNAME="__token__"
TWINE_PASSWORD="your_pypi_token_here"

# AI Studio Access Token
AIStudio_Access_Token="your_ai_studio_token_here"

# GitHub Token (用于推送代码到 GitHub，需有 repo 权限)
# 生成地址: https://github.com/settings/tokens
GITHUB_TOKEN="your_github_token_here"

# ---------------------------------------------------------------------------
# 光明（LightLang）运行期开关
# v7 起统一 LIGHT_* 前缀；旧 DUAN_* 已硬切换删除，设了不再生效。
# 全部可选，不设即用注释里标注的默认值；行尾给出代码读取处便于溯源。
# ---------------------------------------------------------------------------

# 配置目录（默认 ~/.light；仅有旧 ~/.duan 时首次运行整目录迁移过去）  src/first_run.py:78
LIGHT_CONFIG_DIR=

# 模块搜索路径，多条用系统路径分隔符分隔  src/module_resolver.py:247、antlrparser/light_module.py:100
LIGHT_PATH=

# =1 显式启用真·句向量检索；默认走概念图/TF-IDF  积木库/embedding选块.py:483、语义选块.py:204、混合选块.py:173（写入点：积木库/评估/跑分.py:236）
LIGHT_EMBED_REAL=

# 真·句向量模型名（默认 shibing624/text2vec-base-chinese）  积木库/embedding选块.py:345
LIGHT_EMBED_MODEL=

# 真向量相似度地板（默认 0.15）  积木库/embedding选块.py:347
LIGHT_EMBED_FLOOR=

# 混合选块「并列群」判定：概念分与 top1 差距在此以内视为分不清（默认 0.03）  积木库/混合选块.py:44
LIGHT_HYBRID_DELTA=

# 混合选块融合权重：概念图分占比，其余给语义分（默认 0.7）  积木库/混合选块.py:46
LIGHT_HYBRID_ALPHA=

# 补召回候选的「待裁决分」（默认 0.5）  积木库/混合选块.py:48
LIGHT_HYBRID_BACKFILL=

# 计划缓存条目上限（默认 500）  积木库/计划缓存.py:36
LIGHT_PLAN_CACHE_MAX=

# 取 1/true/yes/on 时抹空 api_key，强制零 token 走本地规则（CI 默认置 1）  读：积木库/兜底生成器.py:68；写：积木库/评估/ci_eval.py:343
LIGHT_NO_LLM=

# =1 时扰动跑分额外加测 real（真·句向量）选块器  积木库/评估/扰动跑分.py:43
LIGHT_EVAL_REAL=

# 积木库目录绝对路径；不设则用包内数据（wheel 自带）或仓库内目录  blocks_pkg/light_blocks/cli.py:20
LIGHT_BLOCKS_LIB=

# 合并后的本地推理模型目录；不设则按脚本内规则推断  tools/ai_copilot/local_infer.py:93
LIGHT_MERGED_MODEL=