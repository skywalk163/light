# ═══════════════════════════════════════════════════════════
# 光明 Level 6 综合演示
# 展示所有 P3 增强功能
# ═══════════════════════════════════════════════════════════

# ── 1. 基本运算 ──────────────────────────────────────────
段演示基本运算
    输出("=== 1. 基本运算 ===")
    设x为10
    设y为3
    输出("x + y =", x + y)
    输出("x * y =", x * y)
    输出("x / y =", x / y)
    输出("x % y =", x % y)

# ── 2. 运算符符号别名 ────────────────────────────────────
段演示运算符符号
    输出("=== 2. 运算符符号 ===")
    输出(10 + 20 * 3)
    输出(100 / 4)
    输出(10 % 3)
    如果5 > 3
        输出("5大于3")
    如果5 < 10
        输出("5小于10")
    如果10 == 10
        输出("10等于10")
    如果10 != 20
        输出("10不等于20")
    如果5 >= 3
        输出("5大于等于3")
    如果3 <= 5
        输出("3小于等于5")

# ── 3. 反引号转义标识符 ──────────────────────────────────
段演示反引号
    输出("=== 3. 反引号标识符 ===")
    设`类`为"class_keyword"
    设`返回`为"return_keyword"
    设`如果`为"if_keyword"
    输出(`类`)
    输出(`返回`)
    输出(`如果`)

# ── 4. 单行块 ────────────────────────────────────────────
段演示单行块
    输出("=== 4. 单行块 ===")
    设score为85
    如果score>=90：输出("优秀")
    否则如果score>=80：输出("良好")
    否则：输出("继续努力")
    设i为0
    当i<3
        输出("循环中:", i)
        i=i+1

# ── 5. 函数定义与调用 ────────────────────────────────────
段add接收a,b
    返回a+b
段greet接收name
    输出("Hello, " + name)

段演示函数
    输出("=== 5. 函数定义与调用 ===")
    输出("add(3,4) =", add(3,4))
    greet("World")

# ── 6. 字符串操作 ────────────────────────────────────────
段演示字符串
    输出("=== 6. 字符串操作 ===")
    设msg为"Hello, 光明!"
    输出(字符串长度(msg))
    输出(字符串获取(msg, 0))
    输出(截取(msg, 0, 5))

# ── 7. 列表操作 ──────────────────────────────────────────
段演示列表
    输出("=== 7. 列表操作 ===")
    设arr为列表创建(1,2,3)
    列表追加(arr, 4)
    输出(列表长度(arr))
    输出(列表获取(arr, 0))
    输出(列表弹栈(arr))

# ── 8. 向后兼容 ──────────────────────────────────────────
段演示向后兼容
    输出("=== 8. 向后兼容 ===")
    设msg为"Hello World"
    设x为10
    输出(msg)
    输出(x+1)

# ── 9. 循环与条件嵌套 ────────────────────────────────────
段演示循环条件
    输出("=== 9. 循环与条件嵌套 ===")
    设i为1
    当i<=5
        如果i%2==0：输出(i, "是偶数")
        否则：输出(i, "是奇数")
        i=i+1

