# Reasonix 推理引擎 - AI API 配置
# 复制此文件为 .env 并填入您的 API 密钥
# 支持所有 OpenAI 兼容接口（OpenAI、DeepSeek、通义千问等）

# API 密钥（必填）
REASONIX_API_KEY=

# API 基础地址（默认 OpenAI）
REASONIX_API_BASE_URL=https://api.openai.com/v1

# 模型名称
REASONIX_MODEL=gpt-4o-mini

# 最大 Token 数
REASONIX_MAX_TOKENS=2000

# 生成温度（0.0-2.0）
REASONIX_TEMPERATURE=0.7