# 光明语言 - 文本处理演示
# C5.4: 反转/查找/替换/分割/编码转换

# 字符串反转
段 反转(文本):
  设 长度 为 文本之长度
  设 结果 为 ""
  设 i 为 长度 - 1
  当 i >= 0:
    结果 为 结果 + 文本[i]
    i 为 i - 1
  返 结果

# 查找子串位置
段 查找(文本, 子串):
  设 文本长度 为 文本之长度
  设 子串长度 为 子串之长度
  设 i 为 0
  当 i <= 文本长度 - 子串长度:
    设 匹配成功 为 真
    设 j 为 0
    当 j < 子串长度:
      若 文本[i + j] != 子串[j] 则:
        匹配成功 为 假
        跳
      j 为 j + 1
    若 匹配成功 则:
      返 i
    i 为 i + 1
  返 -1

# 替换子串
段 替换(文本, 旧串, 新串):
  设 位置 为 查找(文本, 旧串)
  若 位置 == -1 则:
    返 文本
  设 前半 为 文本[0:位置]
  设 后半 为 文本[位置 + 旧串之长度:文本之长度]
  返 前半 + 新串 + 后半

# 分割字符串
段 分割(文本, 分隔符):
  设 结果 为 []
  设 当前 为 ""
  设 分隔长度 为 分隔符之长度
  设 i 为 0
  当 i < 文本之长度:
    若 文本[i: i + 分隔长度] == 分隔符 则:
      结果 为 结果 + [当前]
      当前 为 ""
      i 为 i + 分隔长度
    否:
      当前 为 当前 + 文本[i]
      i 为 i + 1
  结果 为 结果 + [当前]
  返 结果

# 简单编码
段 编码(文本):
  设 结果 为 转字符串(文本之长度)
  返 结果

# 统计字符频率
段 字符频率(文本):
  设 频率 为 {}
  设 已统计 为 ""
  遍 文本 于 字符:
    设 计数 为 0
    设 j 为 0
    当 j < 文本之长度:
      若 文本[j] == 字符 则:
        计数 为 计数 + 1
      j 为 j + 1
    频率[字符] 为 计数
  返 频率

# 主程序
印("=== 文本处理演示 ===")
印("")

设 原文 为 "你好，光明编程语言！"
印("原文：")
印(原文)
印("")

# 反转
印("反转：")
印(反转(原文))
印("")

# 查找
印("查找「光明」位置：")
印(查找(原文, "光明"))
印("")

# 替换
设 替换后 为 替换(原文, "光明", "Light")
印("替换「光明」为「Light」：")
印(替换后)
印("")

# 分割
设 分割结果 为 分割("苹果,香蕉,橘子,葡萄", ",")
印("分割字符串：")
印(分割结果)
印("")

# 编码转换
印("编码转换（Hex）：")
印(编码("Hello"))
印("")

# 字符频率统计
设 文本 为 "hello world"
印("字符频率统计：")
印(字符频率(文本))
印("")

# 综合示例：处理英文句子
设 句子 为 "The quick brown fox jumps over the lazy dog"
印("原始句子：")
印(句子)
印("反转：")
印(反转(句子))
印("")

印("=== 文本处理完成 ===")