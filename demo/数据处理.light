# 光明语言 - 数据处理演示
# C5.6: CSV 解析/统计摘要/聚合

# ========== CSV 解析 ==========
段 解析CSV行(行):
  设 结果 为 []
  设 当前 为 ""
  设 在引号中 为 0
  设 i 为 0
  当 i < 行之长度:
    设 字符 为 行[i]
    若 字符 == '"' 则:
      若 在引号中 == 1 则:
        在引号中 为 0
      否:
        在引号中 为 1
    否则若 字符 == ',' 则:
      若 在引号中 == 0 则:
        结果 为 结果 + [当前]
        当前 为 ""
      否:
        当前 为 当前 + 字符
    否:
      当前 为 当前 + 字符
    i 为 i + 1
  结果 为 结果 + [当前]
  返 结果

段 解析CSV(文本):
  设 行列表 为 分割(文本, "\n")
  设 结果 为 []
  设 表头 为 解析CSV行(行列表[0])
  设 i 为 1
  当 i < 行列表之长度:
    若 行列表[i] != "" 则:
      设 行数据 为 解析CSV行(行列表[i])
      设 行记录 为 {}
      设 j 为 0
      当 j < 表头之长度 且 j < 行数据之长度:
        行记录[表头[j]] 为 行数据[j]
        j 为 j + 1
      结果 为 结果 + [行记录]
    i 为 i + 1
  返 结果

# ========== 辅助函数 ==========
段 分割(文本, 分隔符):
  设 结果 为 []
  设 当前 为 ""
  设 分隔长度 为 分隔符之长度
  设 i 为 0
  当 i < 文本之长度:
    若 文本[i: i + 分隔长度] == 分隔符 则:
      结果 为 结果 + [当前]
      当前 为 ""
      i 为 i + 分隔长度
    否:
      当前 为 当前 + 文本[i]
      i 为 i + 1
  结果 为 结果 + [当前]
  返 结果

段 求和(列表):
  设 总和 为 0
  遍 项 于 列表:
    总和 为 总和 + 项
  返 总和

段 平均数(列表):
  设 长度 为 列表之长度
  若 长度 == 0 则:
    返 0
  返 求和(列表) / 长度

段 求最大(列表):
  设 最大值 为 列表[0]
  遍 项 于 列表:
    若 项 > 最大值 则:
      最大值 为 项
  返 最大值

段 求最小(列表):
  设 最小值 为 列表[0]
  遍 项 于 列表:
    若 项 < 最小值 则:
      最小值 为 项
  返 最小值

段 转数值(文本):
  返 转整数(文本)

# ========== 统计摘要 ==========
段 统计摘要(数值列表):
  若 数值列表之长度 == 0 则:
    返 { "错误": "空列表" }
  设 摘要 为 {}
  摘要["计数"] 为 数值列表之长度
  摘要["求和"] 为 求和(数值列表)
  摘要["平均数"] 为 平均数(数值列表)
  摘要["最大值"] 为 求最大(数值列表)
  摘要["最小值"] 为 求最小(数值列表)
  返 摘要

# ========== 聚合 ==========
段 分组聚合(记录列表, 分组键, 聚合键):
  设 分组 为 {}
  遍 记录 于 记录列表:
    设 键 为 记录[分组键]
    若 分组 包含 键 则:
      分组[键] 为 分组[键] + [转数值(记录[聚合键])]
    否:
      分组[键] 为 [转数值(记录[聚合键])]
  设 结果 为 {}
  遍 键 于 分组:
    结果[键] 为 统计摘要(分组[键])
  返 结果

# ========== 主程序 ==========
印("=== 数据处理演示 ===")
印("")

# 模拟 CSV 数据
设 csv数据 为 "姓名,年龄,城市,分数\n张三,25,北京,85\n李四,30,上海,92\n王五,22,广州,78\n赵六,28,北京,95\n陈七,35,上海,88"
印("原始 CSV 数据：")
印(csv数据)
印("")

# 解析 CSV
设 记录列表 为 解析CSV(csv数据)
印("解析后记录数：")
印(记录列表之长度)
印("")

# 逐条显示
印("逐条记录：")
遍 记录 于 记录列表:
  印(记录)
印("")

# 分数统计摘要
设 分数列表 为 []
遍 记录 于 记录列表:
  分数列表 为 分数列表 + [转数值(记录["分数"])]
印("分数统计摘要：")
设 摘要 为 统计摘要(分数列表)
印(摘要)
印("")

# 按城市聚合
印("按城市分组聚合（分数）：")
设 聚合结果 为 分组聚合(记录列表, "城市", "分数")
遍 城市 于 聚合结果:
  印(城市)
  印(聚合结果[城市])
印("")

# 前三名筛选
印("前三名（高分）：")
设 排序分数 为 []
遍 分数 于 分数列表:
  排序分数 为 排序分数 + [分数]
设 排序完成 为 假
当 非 排序完成:
  排序完成 为 真
  设 i 为 0
  当 i < 排序分数之长度 - 1:
    若 排序分数[i] < 排序分数[i + 1] 则:
      设 临时 为 排序分数[i]
      排序分数[i] 为 排序分数[i + 1]
      排序分数[i + 1] 为 临时
      排序完成 为 假
    i 为 i + 1
印(排序分数[0:3])
印("")

印("=== 数据处理完成 ===")