# R99 路 A · try/catch 最小插件 demo（LP-D-011 冒烟）
#
# 跑法（任选其一）：
#   python -c "import sys; sys.path[:0]=['src','stdlib']; \
#     from light_parser_v3 import LightParser; from code_generator import PythonCodeGenerator; \
#     exec(PythonCodeGenerator().generate(LightParser().parse(open('_smoke/try_catch_demo.light',encoding='utf-8').read())))"
#
# 期望输出（两行）：
#   兜住: 炸:批处理
#   DEMO PASS

段落 不可信执行器(任务):
  抛出 新建 错误("炸:" + 任务)
  返回 0

段落 主():
  尝试:
    设 结果 为 不可信执行器("批处理")
    打印("没兜住: " + 字符串(结果))
  捕获 错误 e:
    打印("兜住: " + 字符串(e))
    返回 "DEMO PASS"
  返回 "DEMO FAIL"

打印(主())
