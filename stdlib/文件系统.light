# R145-C：文件系统族缺口补齐（对齐 stdlib/文件系统.py 115 defs）
# ----------------------------------------------------------------------------
# 分层口径：
#   · 系统调用边界（os/shutil 无光明原语）一律转发 _light_builtin.*；
#   · 纯逻辑（路径拆分/列表筛选/递归/字典拼装）用光明原语实现；
#   · 哈希族从 哈希.light 导入（runtime _md5/_sha1/_sha256/_sha512）；
#   · runtime 无对应原语的（归档/磁盘用量/which/chmod/chown/锁/目录监控/
#     seek 位置读写/islink/os.access/MIME 魔术字节/编码探测）不在此实现，
#     登记 _R145_C线交付报告.md「未实现边界」，留 R146（需地板层加原语）。
# ============================================================================

段落 获取扩展名(路径):
  设 对 为 _分割扩展名对(路径)
  返回 对[1]

段落 获取目录名(路径):
  设 对 为 _分割路径对(路径)
  返回 对[0]

段落 路径分割(路径):
  返回 _分割路径对(路径)

段落 扩展名分割(路径):
  返回 _分割扩展名对(路径)

段落 获取文件名不含扩展名(路径):
  设 对 为 _分割扩展名对(文件名(路径))
  返回 对[0]

段落 路径存在(路径):
  返回 _light_builtin.文件存在(路径) 或 _light_builtin.目录存在(路径)

段落 文件扩展名匹配(路径, 期望):
  设 对 为 _分割扩展名对(路径)
  返回 对[1] == 期望

段落 展开用户目录(路径):
  如果 开头(路径, "~"):
    设 家 为 _light_builtin.环境变量("HOME", "")
    如果 是空(家):
      设 家 为 _light_builtin.环境变量("USERPROFILE", "")
    如果 是空(家):
      返回 路径
    设 尾 为 截取(路径, 1, 长(路径))
    返回 连接路径(家, 尾)
  返回 路径

段落 是否为有效路径名(路径):
  如果 路径 == "" 或 路径 == " ":
    返回 假
  如果 字符串包含(路径, "<"):
    返回 假
  如果 字符串包含(路径, ">"):
    返回 假
  如果 字符串包含(路径, ":"):
    返回 假
  如果 字符串包含(路径, "\""):
    返回 假
  如果 字符串包含(路径, "|"):
    返回 假
  如果 字符串包含(路径, "?"):
    返回 假
  如果 字符串包含(路径, "*"):
    返回 假
  返回 真

段落 复制文件(源, 目标):
  写入文件(目标, 读取文件(源))

段落 复制目录(源, 目标):
  _light_builtin.创建目录(目标)
  设 项们 为 _light_builtin.列出目录(源)
  设 i 为 0
  当 i < 长(项们):
    设 全 为 连接路径(源, 项们[i])
    设 全目 为 连接路径(目标, 项们[i])
    如果 _light_builtin.是文件(全):
      写入文件(全目, 读取文件(全))
    否则:
      复制目录(全, 全目)
    设 i 为 i + 1

