  _删目录树(源)

段落 移动(源, 目标):
  如果 _light_builtin.是文件(源):
    移动文件(源, 目标)
  否则:
    移动目录(源, 目标)
  返回 目标

段落 重命名(源, 目标):
  移动(源, 目标)

