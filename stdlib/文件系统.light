  _light_builtin.删除目录(路径)

段落 创建文件(路径):
  设 f 为 打开文件(路径, "w")
  f.close()

段落 触摸文件(路径):
  如果 _light_builtin.文件存在(路径):
    返回 真
  创建文件(路径)
  返回 真

段落 创建临时目录(后缀 等于 "", 前缀 等于 "tmp", 目录 等于 空):
  设 基 为 目录
  如果 是空(基):
    设 基 为 _light_builtin.当前目录()
  设 名 为 前缀 加上 转字符串(_light_builtin.时间戳())
  如果 后缀 != "":
    设 名 为 名 加上 后缀
  设 全 为 连接路径(基, 名)
  _light_builtin.创建目录(全)
  返回 全

段落 删除临时目录(路径):
  _删目录树(路径)

段落 目录列表(路径):
  返回 _light_builtin.列出目录(路径)

段落 _顶层文件完整路径(路径):
  设 结果 为 []
  设 项们 为 _light_builtin.列出目录(路径)
  设 i 为 0
  当 i < 长(项们):
    设 项 为 项们[i]
    设 全 为 连接路径(路径, 项)
    如果 _light_builtin.是文件(全):
      结果.追加(全)
    设 i 为 i + 1
  返回 结果

段落 子目录列表(路径):
  设 结果 为 []
  设 项们 为 _light_builtin.列出目录(路径)
  设 i 为 0
  当 i < 长(项们):
    设 项 为 项们[i]
    设 全 为 连接路径(路径, 项)
    如果 _light_builtin.目录存在(全):
      结果.追加(全)
    设 i 为 i + 1
  返回 结果

段落 遍历目录树(路径):
  返回 _收集文件(路径, 真)

段落 按扩展名筛选(路径, 扩展名):
  设 结果 为 []
  设 项们 为 _light_builtin.列出目录(路径)
  设 i 为 0
  当 i < 长(项们):
    设 项 为 项们[i]
    设 全 为 连接路径(路径, 项)
    如果 _light_builtin.是文件(全) 且 结尾(项, 扩展名):
      结果.追加(全)
    设 i 为 i + 1
  返回 结果

段落 目录大小(路径):
  设 总 为 0
  设 文件们 为 遍历目录树(路径)
  设 i 为 0
  当 i < 长(文件们):
    设 sz 为 _light_builtin.文件大小(文件们[i])
    设 总 为 总 + sz
    设 i 为 i + 1
  返回 总

段落 按大小筛选目录(路径, 最小字节 等于 0, 最大字节 等于 空, 递归 等于 假):
  设 结果 为 []
  设 文件们 为 遍历目录树(路径)
  设 i 为 0
  当 i < 长(文件们):
    设 sz 为 _light_builtin.文件大小(文件们[i])
    如果 sz >= 最小字节:
      如果 最大字节 等于 空 或 sz <= 最大字节:
        结果.追加(文件们[i])
    设 i 为 i + 1
  返回 结果

段落 获取环境变量(名, 默认 等于 空):
  返回 _light_builtin.环境变量(名, 默认)

段落 设置环境变量(名, 值):
  _light_builtin.设置环境变量(名, 值)

段落 当前工作目录():
  返回 _light_builtin.当前目录()

段落 切换工作目录(路径):
  _light_builtin.切换目录(路径)

段落 安全写入文件(路径, 内容, 备份 等于 真):
  设 备份路径 为 ""
  如果 备份 且 _light_builtin.文件存在(路径):
    设 备份路径 为 路径 加上 ".bak"
    写入文件(备份路径, 读取文件(路径))
  写入文件(路径, 内容)
  返回 备份路径

段落 备份文件(路径, 备份目录 等于 空):
  如果 _light_builtin.文件存在(路径):
    如果 备份目录 等于 空:
      设 备份路径 为 路径 加上 ".bak"
    否则:
      _light_builtin.创建目录(备份目录)
      设 备份路径 为 连接路径(备份目录, 文件名(路径) 加上 ".bak")
    写入文件(备份路径, 读取文件(路径))
    返回 备份路径
  抛出 运行时错误("文件不存在: " 加上 路径)

段落 安全删除文件(路径, 移动到回收站 等于 假):
  如果 _light_builtin.文件存在(路径):
    _light_builtin.删除文件(路径)
    返回 真
  返回 假

段落 比较文件内容(甲, 乙):
  如果 _light_builtin.文件存在(甲):
    如果 _light_builtin.文件存在(乙):
      返回 读取文件(甲) == 读取文件(乙)
  返回 假

段落 查找重复文件(路径, 递归 等于 真):
  设 文件们 为 遍历目录树(路径)
  设 大小表 为 {}
  设 i 为 0
  当 i < 长(文件们):
    设 sz 为 _light_builtin.文件大小(文件们[i])
    如果 字典包含键(大小表, sz):
      设 组 为 大小表[sz]
      组.追加(文件们[i])
      大小表[sz] 为 组
    否则:
      设 组 为 []
      组.追加(文件们[i])
      大小表[sz] = 组
    设 i 为 i + 1
  设 重复分组 为 []
  设 键们 为 _light_builtin.字典键列表(大小表)
  设 j 为 0
  当 j < 长(键们):
    设 组 为 大小表[键们[j]]
    如果 长(组) >= 2:
      重复分组.追加(组)
    设 j 为 j + 1
  返回 重复分组

段落 计算文件MD5(路径):
  返回 MD5(读取文件(路径))

段落 计算文件SHA1(路径):
  返回 SHA1(读取文件(路径))

段落 计算文件SHA256(路径):
  返回 SHA256(读取文件(路径))

段落 计算文件哈希(路径, 算法 等于 "sha256"):
  如果 算法 == "md5":
    返回 MD5(读取文件(路径))
  如果 算法 == "sha1":
    返回 SHA1(读取文件(路径))
  如果 算法 == "sha256":
    返回 SHA256(读取文件(路径))
  如果 算法 == "sha512":
    返回 SHA512(读取文件(路径))
  抛出 运行时错误("不支持的哈希算法: " 加上 算法)

段落 写入行列表(路径, 行们):
  设 f 为 打开文件(路径, "w", encoding="utf-8")
  设 i 为 0
  当 i < 长(行们):
    f.write(行们[i])
    设 i 为 i + 1
  f.close()

段落 文件树(路径, 前缀 等于 "", 显示大小 等于 真):
  设 行们 为 []
  行们.追加(前缀 加上 文件名(路径) 加上 "/")
  设 项们 为 _light_builtin.列出目录(路径)
  设 i 为 0
  当 i < 长(项们):
    设 项 为 项们[i]
    设 全 为 连接路径(路径, 项)
    设 行 为 前缀 加上 "├── " 加上 项
    如果 显示大小 且 _light_builtin.是文件(全):
      设 行 为 行 加上 " (" 加上 转字符串(_light_builtin.文件大小(全)) 加上 "字节)"
    行们.追加(行)
    设 i 为 i + 1
  返回 连接字符串(行们, "\n")

段落 路径验证(路径):
  返回 {"路径": 路径, "绝对路径": _light_builtin.绝对路径(路径), "存在": 路径存在(路径), "是文件": _light_builtin.是文件(路径), "是目录": _light_builtin.目录存在(路径)}

段落 批量重命名(目录, 前缀, 起始编号 等于 1, 指定扩展名 等于 ""):
  设 文件们 为 _顶层文件完整路径(目录)
  设 i 为 0
  当 i < 长(文件们):
    设 旧 为 文件们[i]
    设 数 为 起始编号 + i
    设 新名 为 前缀 加上 转字符串(数)
    如果 指定扩展名 != "":
      设 新名 为 新名 加上 指定扩展名
    否则:
      设 对 为 _分割扩展名对(旧)
      设 新名 为 新名 加上 对[1]
    设 新全 为 连接路径(目录, 新名)
    重命名(旧, 新全)
    设 i 为 i + 1
