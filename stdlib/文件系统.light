段落 _顶层文件完整路径(路径):
  设 结果 为 []
  设 项们 为 _light_builtin.列出目录(路径)
  设 i 为 0
  当 i < 长(项们):
    设 项 为 项们[i]
    设 全 为 连接路径(路径, 项)
    如果 _light_builtin.是文件(全):
      结果.追加(全)
    设 i 为 i + 1
  返回 结果

段落 子目录列表(路径):
  设 结果 为 []
  设 项们 为 _light_builtin.列出目录(路径)
  设 i 为 0
  当 i < 长(项们):
    设 项 为 项们[i]
    设 全 为 连接路径(路径, 项)
    如果 _light_builtin.目录存在(全):
      结果.追加(全)
    设 i 为 i + 1
  返回 结果

段落 遍历目录树(路径):
  返回 _收集文件(路径, 真)

段落 按扩展名筛选(路径, 扩展名):
  设 结果 为 []
  设 项们 为 _light_builtin.列出目录(路径)
  设 i 为 0
  当 i < 长(项们):
    设 项 为 项们[i]
    设 全 为 连接路径(路径, 项)
    如果 _light_builtin.是文件(全) 且 结尾(项, 扩展名):
      结果.追加(全)
    设 i 为 i + 1
  返回 结果

段落 目录大小(路径):
  设 总 为 0
  设 文件们 为 遍历目录树(路径)
  设 i 为 0
  当 i < 长(文件们):
    设 sz 为 _light_builtin.文件大小(文件们[i])
    设 总 为 总 + sz
    设 i 为 i + 1
  返回 总

段落 按大小筛选目录(路径, 最小字节 等于 0, 最大字节 等于 空, 递归 等于 假):
  设 结果 为 []
  设 文件们 为 遍历目录树(路径)
  设 i 为 0
  当 i < 长(文件们):
    设 sz 为 _light_builtin.文件大小(文件们[i])
    如果 sz >= 最小字节:
      如果 最大字节 等于 空 或 sz <= 最大字节:
        结果.追加(文件们[i])
    设 i 为 i + 1
  返回 结果

段落 获取环境变量(名, 默认 等于 空):
  返回 _light_builtin.环境变量(名, 默认)

段落 设置环境变量(名, 值):
  _light_builtin.设置环境变量(名, 值)

段落 当前工作目录():
  返回 _light_builtin.当前目录()

段落 切换工作目录(路径):
  _light_builtin.切换目录(路径)

段落 安全写入文件(路径, 内容, 备份 等于 真):
  设 备份路径 为 ""
  如果 备份 且 _light_builtin.文件存在(路径):
    设 备份路径 为 路径 加上 ".bak"
    写入文件(备份路径, 读取文件(路径))
  写入文件(路径, 内容)
  返回 备份路径

段落 备份文件(路径, 备份目录 等于 空):
  如果 _light_builtin.文件存在(路径):
    如果 备份目录 等于 空:
      设 备份路径 为 路径 加上 ".bak"
    否则:
      _light_builtin.创建目录(备份目录)
      设 备份路径 为 连接路径(备份目录, 文件名(路径) 加上 ".bak")
    写入文件(备份路径, 读取文件(路径))
    返回 备份路径
  抛出 运行时错误("文件不存在: " 加上 路径)

段落 安全删除文件(路径, 移动到回收站 等于 假):
  如果 _light_builtin.文件存在(路径):
    _light_builtin.删除文件(路径)
    返回 真
  返回 假

段落 比较文件内容(甲, 乙):
  如果 _light_builtin.文件存在(甲):
    如果 _light_builtin.文件存在(乙):
      返回 读取文件(甲) == 读取文件(乙)
  返回 假

段落 查找重复文件(路径, 递归 等于 真):
  设 文件们 为 遍历目录树(路径)
  设 大小表 为 {}
  设 i 为 0
  当 i < 长(文件们):
    设 sz 为 _light_builtin.文件大小(文件们[i])
    如果 字典包含键(大小表, sz):
      设 组 为 大小表[sz]
      组.追加(文件们[i])
      大小表[sz] 为 组
    否则:
      设 组 为 []
      组.追加(文件们[i])
      大小表[sz] = 组
    设 i 为 i + 1
  # R149-B（L-211 收口）：同大小组内再按**内容**分组，对齐 文件系统.py 的
  # 比较文件内容 语义。此前只按大小分组，会把「同大小但内容不同」的文件也并入
  # 同一组——即 .py 返 [[a,b]]、.light 返 [[a,b,c]] 的分歧根因。
  设 重复分组 为 []
  设 键们 为 _light_builtin.字典键列表(大小表)
  设 j 为 0
  当 j < 长(键们):
    设 组 为 大小表[键们[j]]
    如果 长(组) >= 2:
      设 内容表 为 {}
      设 k 为 0
      当 k < 长(组):
        设 摘要 为 计算文件MD5(组[k])
        如果 字典包含键(内容表, 摘要):
          设 桶 为 内容表[摘要]
          桶.追加(组[k])
          内容表[摘要] 为 桶
        否则:
          设 桶 为 []
          桶.追加(组[k])
          内容表[摘要] = 桶
        设 k 为 k + 1
      设 摘们 为 _light_builtin.字典键列表(内容表)
      设 m 为 0
      当 m < 长(摘们):
        设 桶 为 内容表[摘们[m]]
        如果 长(桶) >= 2:
          重复分组.追加(桶)
        设 m 为 m + 1
    设 j 为 j + 1
  返回 重复分组

段落 计算文件MD5(路径):
  返回 MD5(读取文件(路径))

段落 计算文件SHA1(路径):
  返回 SHA1(读取文件(路径))

段落 计算文件SHA256(路径):
  返回 SHA256(读取文件(路径))

段落 计算文件哈希(路径, 算法 等于 "sha256"):
  如果 算法 == "md5":
    返回 MD5(读取文件(路径))
  如果 算法 == "sha1":
    返回 SHA1(读取文件(路径))
  如果 算法 == "sha256":
    返回 SHA256(读取文件(路径))
  如果 算法 == "sha512":
    返回 SHA512(读取文件(路径))
  抛出 运行时错误("不支持的哈希算法: " 加上 算法)

段落 写入行列表(路径, 行们):
  设 f 为 打开文件(路径, "w", encoding="utf-8")
  设 i 为 0
  当 i < 长(行们):
    f.write(行们[i])
    设 i 为 i + 1
  f.close()

段落 文件树(路径, 前缀 等于 "", 显示大小 等于 真):
  设 行们 为 []
  行们.追加(前缀 加上 文件名(路径) 加上 "/")
  设 项们 为 _light_builtin.列出目录(路径)
  设 i 为 0
  当 i < 长(项们):
    设 项 为 项们[i]
    设 全 为 连接路径(路径, 项)
    设 行 为 前缀 加上 "├── " 加上 项
    如果 显示大小 且 _light_builtin.是文件(全):
      设 行 为 行 加上 " (" 加上 转字符串(_light_builtin.文件大小(全)) 加上 "字节)"
    行们.追加(行)
    设 i 为 i + 1
  返回 连接字符串(行们, "\n")

段落 路径验证(路径):
  返回 {"路径": 路径, "绝对路径": _light_builtin.绝对路径(路径), "存在": 路径存在(路径), "是文件": _light_builtin.是文件(路径), "是目录": _light_builtin.目录存在(路径)}

段落 批量重命名(目录, 前缀, 起始编号 等于 1, 指定扩展名 等于 ""):
  设 文件们 为 _顶层文件完整路径(目录)
  设 i 为 0
  当 i < 长(文件们):
    设 旧 为 文件们[i]
    设 数 为 起始编号 + i
    设 新名 为 前缀 加上 转字符串(数)
    如果 指定扩展名 != "":
      设 新名 为 新名 加上 指定扩展名
    否则:
      设 对 为 _分割扩展名对(旧)
      设 新名 为 新名 加上 对[1]
    设 新全 为 连接路径(目录, 新名)
    重命名(旧, 新全)
    设 i 为 i + 1

# ============================================================================
# R147-A：16 下架段地板原语落地（2026-10-14；原下架登记见 :40-41 与
# _R145_收口报告.md:82「16 段无地板原语下架登记 R146」）
# ----------------------------------------------------------------------------
# TRUNK 新原语（src/llvm/runtime_typed.c + codegen_typed.py，R147-A 新增，
# 对齐 src 腿 builtin_map:542/543/551/511/512 + builtins.py 同名函数）：
#   文件状态（stat -> dict，键名 = os.stat_result 字段 st_size/st_mtime/…；
#             取不到返回 null，对齐 builtins.py:文件状态 的 None 语义）
#   真实路径（os.path.realpath；POSIX realpath，失败回退 cwd+normpath；
#             Windows GetFullPathNameA 不解析 symlink 为已知边界）
#   读二进制文件（bytes = 整数列表 0-255，同 dv_random_bytes 既有口径）
#   写入二进制文件（整数列表或字符串 -> 原始字节；自动建父目录）
#   环境枚举（[[名, 值], ...]；R131 os 族漏登收口）
# 其余段为纯光明组合（零新原语）。两腿陷阱防护（MEMORY §5，R145 实证）：
#   列.追加 方法式；不用 in/not；dict 属性访问（L-203 后两腿同形）；
#   段名与内置 mutating 名（写/读/排序/反转…）无撞。
# 已知边界（诚实登记交付报告）：追加二进制文件 走 读-解码-拼接-写、str 载荷
#   契约——既有内容非 UTF-8 时 src 腿 UnicodeDecodeError 转光明运行时错误，
#   原生腿 int list 字节保真（NUL 截断属原生腿 str 表示既有边界）；
#   展开环境变量 只做 $VAR/${VAR}（Linux 口径），%VAR% Windows 形态未做；
#   通配匹配 大小写敏感（= Linux fnmatch 口径），[]] 首成员为字面量等
#   CPython 病理形态未复刻；比较文件信息 把 .py 的 and-对象怪癖修正为规范布尔。
# ============================================================================

段落 真实路径(路径):
  返回 _light_builtin.真实路径(路径)

# 路径比较（等价 文件系统.py:384 路径比较 = os.path.samefile；st_ino+st_dev 判定）

段落 路径比较(甲, 乙):
  设 状甲 为 _light_builtin.文件状态(甲)
  设 状乙 为 _light_builtin.文件状态(乙)
  如果 是空(状甲) 或 是空(状乙):
    抛出 运行时错误("路径比较: 文件不存在（" 加上 甲 加上 " / " 加上 乙 加上 "）")
  返回 状甲.st_ino == 状乙.st_ino 且 状甲.st_dev == 状乙.st_dev

# 二进制族（等价 文件系统.py:307/313/319；bytes 载荷契约见节首已知边界）

段落 读取二进制文件(路径):
  返回 _light_builtin.读二进制文件(路径)

段落 写入二进制文件(路径, 数据):
  _light_builtin.写入二进制文件(路径, 数据)

段落 追加二进制文件(路径, 数据):
  设 追加串 为 ""
  设 规范成 为 假
  尝试:
    设 追加串 为 字符串(数据, "utf-8")
    设 规范成 为 真
  捕获 异常:
    设 规范成 为 假
  结束。
  如果 规范成 等于 假:
    设 追加串 为 数据
  如果 _light_builtin.文件存在(路径):
    设 旧 为 _light_builtin.读二进制文件(路径)
    设 旧串 为 ""
    尝试:
      设 旧串 为 字符串(旧, "utf-8")
    捕获 错误:
      抛出 运行时错误("追加二进制文件: 现有内容非 UTF-8，无法纯光明追加: " 加上 路径)
    结束。
    尝试:
      _light_builtin.写入二进制文件(路径, 旧串 加上 追加串)
    捕获 异常:
      抛出 运行时错误("追加二进制文件: 新数据非 UTF-8，无法纯光明追加: " 加上 路径)
    结束。
  否则:
    _light_builtin.写入二进制文件(路径, 追加串)

# stat 时间族（等价 文件系统.py:154/159/164 + 3 字符串形态 + 文件属性）

段落 _取stat时间值(状态, 哪个):
  如果 哪个 == "访问":
    返回 状态.st_atime
  如果 哪个 == "创建":
    返回 状态.st_ctime
  返回 状态.st_mtime

段落 文件修改时间(路径):
  设 状 为 _light_builtin.文件状态(路径)
  如果 是空(状):
    抛出 运行时错误("文件不存在: " 加上 路径)
  返回 _取stat时间值(状, "修改")

段落 文件访问时间(路径):
  设 状 为 _light_builtin.文件状态(路径)
  如果 是空(状):
    抛出 运行时错误("文件不存在: " 加上 路径)
  返回 _取stat时间值(状, "访问")

段落 文件创建时间(路径):
  设 状 为 _light_builtin.文件状态(路径)
  如果 是空(状):
    抛出 运行时错误("文件不存在: " 加上 路径)
  返回 _取stat时间值(状, "创建")

段落 文件修改时间字符串(路径, 格式 等于 "%Y-%m-%d %H:%M:%S"):
  返回 格式化时间(文件修改时间(路径), 格式)

段落 文件访问时间字符串(路径, 格式 等于 "%Y-%m-%d %H:%M:%S"):
  返回 格式化时间(文件访问时间(路径), 格式)

段落 文件创建时间字符串(路径, 格式 等于 "%Y-%m-%d %H:%M:%S"):
  返回 格式化时间(文件创建时间(路径), 格式)

# 权限八进制串（对齐 .py 的 oct(mode)[-4:]；整除/取模 函数式两腿语义一致）

段落 _取八进制串(模式):
  设 数 为 ""
  设 n 为 整数(模式)
  当 n > 0:
    设 余 为 取模(n, 8)
    设 数 为 转字符串(余) 加上 数
    设 n 为 整除(n, 8)
  如果 数 == "":
    返回 "0"
  返回 数

段落 文件属性(路径):
  设 状 为 _light_builtin.文件状态(路径)
  如果 是空(状):
    抛出 运行时错误("文件不存在: " 加上 路径)
  设 八进制 为 _取八进制串(状.st_mode)
  设 权限 为 八进制
  如果 长(八进制) > 4:
    设 权限 为 截取(八进制, 长(八进制) 减去 4, 长(八进制))
  返回 {"大小": 状.st_size, "修改时间": 状.st_mtime, "访问时间": 状.st_atime, "创建时间": 状.st_ctime, "权限": 权限, "inode": 状.st_ino, "链接数": 状.st_nlink, "用户ID": 状.st_uid, "组ID": 状.st_gid}

# 按时间筛选目录（等价 文件系统.py:806；时间属性 = 修改/访问/创建）

段落 按时间筛选目录(路径, 属性 等于 "修改", 起始时间 等于 0, 结束时间 等于 空, 递归 等于 假):
  设 结果 为 []
  设 文件们 为 []
  如果 递归:
    设 文件们 为 遍历目录树(路径)
  否则:
    设 文件们 为 _顶层文件完整路径(路径)
  设 i 为 0
  当 i < 长(文件们):
    设 全 为 文件们[i]
    设 状 为 _light_builtin.文件状态(全)
    如果 是空(状) 等于 假:
      设 t 为 _取stat时间值(状, 属性)
      设 够新 为 t >= 起始时间
      设 够旧 为 真
      如果 结束时间 等于 空:
        设 够旧 为 真
      否则:
        设 够旧 为 t <= 结束时间
      如果 够新 且 够旧:
        结果.追加(全)
    设 i 为 i 加上 1
  返回 结果

# 比较文件信息（等价 文件系统.py:1337 的 6 键口径；.py 的 and-对象怪癖修正为规范布尔）

段落 比较文件信息(甲, 乙):
  设 状甲 为 _light_builtin.文件状态(甲)
  设 状乙 为 _light_builtin.文件状态(乙)
  设 都存在 为 假
  如果 是空(状甲) 等于 假 且 是空(状乙) 等于 假:
    设 都存在 为 真
  设 大小相同 为 假
  设 修改时间相同 为 假
  设 权限相同 为 假
  设 大小差异 为 空
  设 时间差异 为 空
  如果 都存在:
    设 大小相同 为 状甲.st_size == 状乙.st_size
    设 修改时间相同 为 状甲.st_mtime == 状乙.st_mtime
    设 权限相同 为 状甲.st_mode == 状乙.st_mode
    设 大小差异 为 状甲.st_size 减去 状乙.st_size
    设 时间差异 为 状甲.st_mtime 减去 状乙.st_mtime
  返回 {"存在": 都存在, "大小相同": 大小相同, "修改时间相同": 修改时间相同, "权限相同": 权限相同, "大小差异": 大小差异, "时间差异": 时间差异}

# 展开环境变量（等价 文件系统.py:878 = os.path.expandvars 的 Linux $ 形态；
# 未知名保持原样（与 .py 一致）；%VAR% Windows 形态为已知边界）

段落 _是变量名字符(c):
  如果 c >= "a" 且 c <= "z":
    返回 真
  如果 c >= "A" 且 c <= "Z":
    返回 真
  如果 c >= "0" 且 c <= "9":
    返回 真
  如果 c == "_":
    返回 真
  返回 假

段落 _展开单变量(路径, 起点):
  设 n 为 长(路径)
  设 j 为 起点 加上 1
  设 花 为 假
  如果 j < n 且 路径[j:j 加上 1] == "{":
    设 花 为 真
    设 j 为 j 加上 1
  设 名 为 ""
  当 j < n:
    设 nc 为 路径[j:j 加上 1]
    如果 花:
      如果 nc == "}":
        如果 名 != "":
          设 值 为 _light_builtin.环境变量(名, "")
          返回 (真, 值, j 减去 起点 加上 1)
        返回 (假, "", 0)
    否则:
      如果 _是变量名字符(nc) 等于 假:
        如果 名 != "":
          设 值 为 _light_builtin.环境变量(名, "")
          返回 (真, 值, j 减去 起点)
        返回 (假, "", 0)
    设 名 为 名 加上 nc
    设 j 为 j 加上 1
  如果 名 != "":
    设 值 为 _light_builtin.环境变量(名, "")
    返回 (真, 值, n 减去 起点)
  返回 (假, "", 0)

段落 展开环境变量(路径):
  设 结果 为 ""
  设 i 为 0
  设 n 为 长(路径)
  当 i < n:
    设 c 为 路径[i:i 加上 1]
    如果 c == "$":
      设 展开 为 _展开单变量(路径, i)
      如果 展开[0]:
        设 结果 为 结果 加上 展开[1]
        设 i 为 i 加上 展开[2]
      否则:
        设 结果 为 结果 加上 c
        设 i 为 i 加上 1
    否则:
      设 结果 为 结果 加上 c
      设 i 为 i 加上 1
  返回 结果

# 筛选目录列表（等价 文件系统.py:754 = fnmatch；纯光明通配匹配器，
# 大小写敏感 = Linux fnmatch 口径；递归只收文件、非递归收全部条目，
# 均返回完整路径——与 .py 一致）

段落 _在区间(字符, 起, 终):
  返回 字符 >= 起 且 字符 <= 终

段落 _通配类匹配(名, 名位, 模式, 模位):
  设 字符 为 名[名位:名位 加上 1]
  设 i 为 模位 加上 1
  设 否定 为 假
  如果 i < 长(模式) 且 模式[i:i 加上 1] == "!":
    设 否定 为 真
    设 i 为 i 加上 1
  设 命中 为 假
  设 上个 为 ""
  设 闭合 为 假
  当 i < 长(模式) 且 闭合 等于 假:
    设 c 为 模式[i:i 加上 1]
    如果 c == "]":
      设 闭合 为 真
      设 i 为 i 加上 1
    否则 如果 c == "-" 且 上个 != "" 且 i 加上 1 < 长(模式) 且 模式[i 加上 1:i 加上 2] != "]":
       设 终 为 模式[i 加上 1:i 加上 2]
       如果 _在区间(字符, 上个, 终):
         设 命中 为 真
       设 上个 为 ""
       设 i 为 i 加上 2
     否则:
       如果 c == 字符:
         设 命中 为 真
       设 上个 为 c
       设 i 为 i 加上 1
   如果 闭合 等于 假:
     返回 (字符 == "[", 模位 加上 1)
   如果 否定:
     返回 (命中 等于 假, i)
   返回 (命中, i)

段落 _通配匹配自(名, 名位, 模式, 模位):
  当 模位 < 长(模式):
    设 模字符 为 模式[模位:模位 加上 1]
    如果 模字符 == "*":
      设 跳过 为 模位
      当 跳过 < 长(模式) 且 模式[跳过:跳过 加上 1] == "*":
        设 跳过 为 跳过 加上 1
      如果 跳过 >= 长(模式):
        返回 真
      设 试位 为 名位
      当 试位 <= 长(名):
        如果 _通配匹配自(名, 试位, 模式, 跳过):
          返回 真
        设 试位 为 试位 加上 1
      返回 假
    如果 名位 >= 长(名):
      返回 假
    设 名字符 为 名[名位:名位 加上 1]
    如果 模字符 == "?":
      设 名位 为 名位 加上 1
      设 模位 为 模位 加上 1
    否则 如果 模字符 == "[":
      设 类果 为 _通配类匹配(名, 名位, 模式, 模位)
      如果 类果[0] 等于 假:
        返回 假
      设 名位 为 名位 加上 1
      设 模位 为 类果[1]
    否则:
      如果 名字符 != 模字符:
        返回 假
      设 名位 为 名位 加上 1
      设 模位 为 模位 加上 1
  如果 名位 >= 长(名):
    返回 真
  返回 假

段落 _通配匹配(名, 模式):
  返回 _通配匹配自(名, 0, 模式, 0)

段落 筛选目录列表(目录, 模式 等于 "*", 递归 等于 假):
  设 结果 为 []
  如果 递归:
    设 文件们 为 遍历目录树(目录)
    设 i 为 0
    当 i < 长(文件们):
      设 全 为 文件们[i]
      如果 _通配匹配(文件名(全), 模式):
        结果.追加(全)
      设 i 为 i 加上 1
  否则:
    设 项们 为 _light_builtin.列出目录(目录)
    设 i 为 0
    当 i < 长(项们):
      如果 _通配匹配(项们[i], 模式):
        结果.追加(连接路径(目录, 项们[i]))
      设 i 为 i 加上 1
  返回 结果

