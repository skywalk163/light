段落 支持的归档格式():
  返回 ["zip", "tar", "gztar", "bztar", "xztar"]

# 支持的解压格式（镜像 CPython shutil.get_unpack_formats 当前注册表）

段落 支持的解压格式():
  返回 ["zip", "tar", "gztar", "bztar", "xztar"]

# --- R148-B：纯光明补齐（基于 _light_builtin.文件状态 的 st_mode / st_uid / st_gid，native/src 两腿通用） ---
# 与 文件系统.py:134/723 参考实现三腿对拍；符号链接=st_mode 的 S_IFLNK(0o120000=40960) 位判定，
# 文件所有者=stat.st_uid/st_gid（dev/Windows 平台无 pwd/grp，用户名与 .py 同走字符串化口径）。

段落 是否符号链接(路径):
  设 状 为 _light_builtin.文件状态(路径)
  如果 是空(状):
    返回 假
  设 八 为 _取八进制串(状.st_mode)
  如果 长(八) >= 3:
    返回 八[0:3] == "120"
  返回 假

段落 获取文件所有者(路径):
  设 状 为 _light_builtin.文件状态(路径)
  如果 是空(状):
    抛出 运行时错误("文件不存在: " 加上 路径)
  返回 {"uid": 状.st_uid, "gid": 状.st_gid, "用户": 转字符串(状.st_uid), "组": 转字符串(状.st_gid)}

# R149-A：文件系统平台原语第一批（对齐 文件系统.py 参考语义 + C 层 dv_fs_*）。
# 两腿共用 _light_builtin.* 门面：原生腿走 C 原语，src 腿走 builtins.py 地板实体。
# Windows 边界（登记 R150）：symlink/readlink/statvfs 无等价 → 假/空/空。
段落 是否可执行(路径):
  返回 _light_builtin.是否可执行(路径)

段落 设置权限(路径, 权限):
  返回 _light_builtin.设置权限(路径, 权限)

段落 创建符号链接(目标, 链接路径):
  返回 _light_builtin.创建符号链接(目标, 链接路径)

段落 读取符号链接(链接路径):
  返回 _light_builtin.读取符号链接(链接路径)

段落 磁盘用量字典(路径 等于 "."):
  返回 _light_builtin.磁盘用量(路径)

段落 磁盘总空间(路径 等于 "."):
  设 用量 为 _light_builtin.磁盘用量(路径)
  如果 是空(用量):
    返回 0
  返回 字典获取(用量, "总空间", 0)

段落 磁盘可用空间(路径 等于 "."):
  设 用量 为 _light_builtin.磁盘用量(路径)
  如果 是空(用量):
    返回 0
  返回 字典获取(用量, "可用空间", 0)

段落 磁盘已用空间(路径 等于 "."):
  设 用量 为 _light_builtin.磁盘用量(路径)
  如果 是空(用量):
    返回 0
  返回 字典获取(用量, "已用空间", 0)

段落 磁盘使用情况(路径 等于 "."):
  设 用量 为 _light_builtin.磁盘用量(路径)
  如果 是空(用量):
    返回 字典创建()
  返回 {"总空间": 字典获取(用量, "总空间", 0), "已用空间": 字典获取(用量, "已用空间", 0), "可用空间": 字典获取(用量, "可用空间", 0)}

段落 获取磁盘使用情况(路径 等于 "/"):
  设 用量 为 _light_builtin.磁盘用量(路径)
  如果 是空(用量):
    返回 字典创建()
  返回 {"总空间": 字典获取(用量, "总空间", 0), "已用空间": 字典获取(用量, "已用空间", 0), "可用空间": 字典获取(用量, "可用空间", 0), "使用率": 字典获取(用量, "使用率", 0.0)}
