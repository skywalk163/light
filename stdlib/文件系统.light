段落 _最后分隔位(路径):
  设 正斜杠 为 路径.rfind("/")
  设 反斜杠 为 路径.rfind("\\")
  如果 反斜杠 > 正斜杠:
    返回 反斜杠
  返回 正斜杠

段落 _分割扩展名对(路径):
  设 斜杠位 为 _最后分隔位(路径)
  设 点位 为 路径.rfind(".")
  如果 点位 > 斜杠位:
    设 名起 为 斜杠位 加上 1
    当 名起 < 点位:
      如果 路径[名起:名起 加上 1] != ".":
        返回 (路径[0:点位], 路径[点位:])
      设 名起 为 名起 加上 1
  返回 (路径, "")

段落 _分割路径对(路径):
  设 位 为 _最后分隔位(路径)
  如果 位 < 0:
    返回 ("", 路径)
  返回 (路径[0:位], 路径[位 加上 1:])

段落 _删目录树(路径):
  设 项们 为 _light_builtin.列出目录(路径)
  设 i 为 0
  当 i < 长(项们):
    设 全 为 连接路径(路径, 项们[i])
    如果 _light_builtin.是文件(全):
      _light_builtin.删除文件(全)
    否则:
      _删目录树(全)
    设 i 为 i + 1
  _light_builtin.删除目录(路径)

段落 _收集文件(路径, 递归):
  设 结果 为 []
  设 项们 为 _light_builtin.列出目录(路径)
  设 i 为 0
  当 i < 长(项们):
    设 全 为 连接路径(路径, 项们[i])
    如果 _light_builtin.是文件(全):
      结果.追加(全)
    否则 如果 递归:
      设 子 为 _收集文件(全, 递归)
      设 j 为 0
      当 j < 长(子):
        结果.追加(子[j])
        设 j 为 j + 1
    设 i 为 i + 1
  返回 结果

段落 写入文件(路径, 内容):
  设 目录 为 目录名(路径)
  如果 目录 != "":
    创建目录(目录)
  设 f 为 打开文件(路径, "w", encoding="utf-8")
  f.write(内容)
  f.close()

