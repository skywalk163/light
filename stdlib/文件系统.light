# 是否可读（近似 文件系统.py:144 os.access(R_OK)：只读打开+关闭探测；
# 目录探测与真实 uid 位差异为已登记边界）

段落 是否可读(路径):
  尝试:
    设 f 为 打开文件(路径, "r", encoding="utf-8")
    f.close()
    返回 真
  捕获 异常:
    返回 假

# 是否可写（近似 文件系统.py:149 os.access(W_OK)：追加模式打开+关闭探测，
# 不截断；不存在文件直接返假，避免副作用创建）

段落 是否可写(路径):
  如果 路径存在(路径) 等于 假:
    返回 假
  尝试:
    设 f 为 打开文件(路径, "a", encoding="utf-8")
    f.close()
    返回 真
  捕获 异常:
    返回 假

# MIME 扩展名表（镜像 Python mimetypes 常见口径；平台 mime.types 差异为已登记边界）

段落 _MIME扩展名表():
  返回 ["txt": "text/plain", "md": "text/markdown", "html": "text/html", "htm": "text/html", "css": "text/css", "js": "text/javascript", "json": "application/json", "xml": "text/xml", "csv": "text/csv", "py": "text/x-python", "c": "text/x-c", "h": "text/x-c", "cpp": "text/x-c++src", "png": "image/png", "jpg": "image/jpeg", "jpeg": "image/jpeg", "gif": "image/gif", "bmp": "image/bmp", "webp": "image/webp", "svg": "image/svg+xml", "ico": "image/x-icon", "pdf": "application/pdf", "zip": "application/zip", "gz": "application/gzip", "tar": "application/x-tar", "bz2": "application/x-bzip2", "xz": "application/x-xz", "7z": "application/x-7z-compressed", "rar": "application/x-rar-compressed", "mp3": "audio/mpeg", "wav": "audio/x-wav", "flac": "audio/flac", "ogg": "audio/ogg", "mp4": "video/mp4", "webm": "video/webm", "avi": "video/x-msvideo", "mov": "video/quicktime", "exe": "application/x-msdownload", "doc": "application/msword", "docx": "application/vnd.openxmlformats-officedocument.wordprocessingml.document", "xls": "application/vnd.ms-excel", "xlsx": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", "ppt": "application/vnd.ms-powerpoint", "pptx": "application/vnd.openxmlformats-officedocument.presentationml.presentation", "ttf": "font/ttf", "woff": "font/woff", "woff2": "font/woff2"]

# 字节前缀匹配（魔术字节判定；int list 逐项比对）

段落 _字节前缀匹配(数据, 签名):
  如果 长(数据) < 长(签名):
    返回 假
  设 i 为 0
  当 i < 长(签名):
    如果 数据[i] != 签名[i]:
      返回 假
    设 i 为 i 加上 1
  返回 真

# 前 N 字节（收敛切片，避开原生腿越界补空）

段落 _前N字节(数据, 数量):
  设 终点 为 数量
  如果 终点 > 长(数据):
    设 终点 为 长(数据)
  返回 数据[0:终点]

# MIME类型检测（对齐 文件系统.py:1024：扩展名优先→魔术字节→文本探测；
# 魔术字节只取前 8 字节；文本探测读全文件（.py 只读 1024 字符）为已登记边界）

段落 MIME类型检测(路径):
  如果 路径存在(路径) 等于 假:
    抛出 运行时错误("文件不存在: " 加上 路径)
  如果 目录存在(路径):
    抛出 运行时错误("文件不存在: " 加上 路径)
  设 扩展名 为 获取扩展名(路径)
  如果 长(扩展名) > 1:
    设 键 为 截取(扩展名, 1, 长(扩展名))
    设 表 为 _MIME扩展名表()
    如果 字典包含键(表, 键):
      返回 字典获取(表, 键)
  设 数据 为 _前N字节(读取二进制文件(路径), 8)
  如果 _字节前缀匹配(数据, [137, 80, 78, 71, 13, 10, 26, 10]):
    返回 "image/png"
  如果 _字节前缀匹配(数据, [255, 216, 255]):
    返回 "image/jpeg"
  如果 _字节前缀匹配(数据, [71, 73, 70, 56, 55, 97]):
    返回 "image/gif"
  如果 _字节前缀匹配(数据, [71, 73, 70, 56, 57, 97]):
    返回 "image/gif"
  如果 _字节前缀匹配(数据, [37, 80, 68, 70]):
    返回 "application/pdf"
  如果 _字节前缀匹配(数据, [80, 75, 3, 4]):
    返回 "application/zip"
  如果 _字节前缀匹配(数据, [82, 73, 70, 70]):
    返回 "image/webp"
  如果 _字节前缀匹配(数据, [31, 139]):
    返回 "application/gzip"
  如果 _字节前缀匹配(数据, [66, 90, 104]):
    返回 "application/bzip2"
  如果 _字节前缀匹配(数据, [253, 55, 122, 88, 90, 0]):
    返回 "application/x-xz"
  如果 _字节前缀匹配(数据, [0, 0, 0, 24, 102, 116, 121, 112]):
    返回 "video/mp4"
  如果 _字节前缀匹配(数据, [0, 0, 0, 28, 102, 116, 121, 112]):
    返回 "video/mp4"
  如果 _字节前缀匹配(数据, [0, 0, 0, 12, 102, 116, 121, 112]):
    返回 "image/heic"
  如果 _字节前缀匹配(数据, [26, 69, 223, 163]):
    返回 "video/webm"
  尝试:
    设 _ 为 读取文件(路径)
    返回 "text/plain"
  捕获 异常:
    返回 "application/octet-stream"

