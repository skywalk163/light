# 文件类型检测（对齐 文件系统.py:993：MIME→中文描述，未知名带 MIME 后缀）

段落 文件类型检测(路径):
  尝试:
    设 mime 为 MIME类型检测(路径)
    设 表 为 _类型映射表()
    如果 字典包含键(表, mime):
      返回 字典获取(表, mime)
    返回 "未知类型 (" 加上 mime 加上 ")"
  捕获 异常:
    返回 "未知类型"

# 批量复制文件（对齐 文件系统.py:1152：模式筛选+保留相对目录结构；
# 复制为内容拷贝（.py 为 copy2 含元数据），单文件失败跳过）

段落 批量复制文件(源目录, 目标目录, 模式 等于 "*", 递归 等于 假):
  设 成功 为 []
  创建目录(目标目录)
  设 文件们 为 筛选目录列表(源目录, 模式, 递归)
  设 i 为 0
  当 i < 长(文件们):
    设 全 为 文件们[i]
    设 相对 为 截取(全, 长(源目录) 加上 1, 长(全))
    设 目标全 为 连接路径(目标目录, 相对)
    设 所在目录 为 获取目录名(目标全)
    如果 所在目录 != "":
      创建目录(所在目录)
    尝试:
      复制文件(全, 目标全)
      成功.追加(目标全)
    捕获 异常:
      设 _ 为 0
    结束。
    设 i 为 i 加上 1
  返回 成功

# 批量移动文件（对齐 文件系统.py:1180：模式筛选+保留相对目录结构；
# 移动为同设备重命名语义（.py 为 shutil.move 跨设备拷贝），失败跳过）

段落 批量移动文件(源目录, 目标目录, 模式 等于 "*", 递归 等于 假):
  设 成功 为 []
  创建目录(目标目录)
  设 文件们 为 筛选目录列表(源目录, 模式, 递归)
  设 i 为 0
  当 i < 长(文件们):
    设 全 为 文件们[i]
    设 相对 为 截取(全, 长(源目录) 加上 1, 长(全))
    设 目标全 为 连接路径(目标目录, 相对)
    设 所在目录 为 获取目录名(目标全)
    如果 所在目录 != "":
      创建目录(所在目录)
    尝试:
      移动文件(全, 目标全)
      成功.追加(目标全)
    捕获 异常:
      设 _ 为 0
    结束。
    设 i 为 i 加上 1
  返回 成功

# 批量删除文件（对齐 文件系统.py:1208：模式筛选删除，返回删除计数）

段落 批量删除文件(目录路径, 模式 等于 "*", 递归 等于 假):
  设 计数 为 0
  设 文件们 为 筛选目录列表(目录路径, 模式, 递归)
  设 i 为 0
  当 i < 长(文件们):
    尝试:
      删除文件(文件们[i])
      设 计数 为 计数 加上 1
    捕获 异常:
      设 _ 为 0
    结束。
    设 i 为 i 加上 1
  返回 计数

# 取 PATH 值（经 环境枚举 原生内置；兼容 Windows 环境变量大小写形态）

段落 _取PATH值():
  设 环境们 为 环境枚举()
  设 i 为 0
  当 i < 长(环境们):
    设 项 为 环境们[i]
    如果 项[0] == "PATH":
      返回 项[1]
    如果 项[0] == "Path":
      返回 项[1]
    设 i 为 i 加上 1
  返回 ""

# 查找命令（近似 shutil.which：PATH 双分隔符探测 + 常见 Windows 后缀；
# X_OK 执行位探测缺失为已登记边界）

段落 查找命令(命令名):
  设 路径值 为 _取PATH值()
  设 分隔符们 为 [";", ":"]
  设 d 为 0
  当 d < 长(分隔符们):
    设 目录们 为 分割(路径值, 分隔符们[d])
    设 i 为 0
    当 i < 长(目录们):
      设 目录 为 目录们[i]
      如果 长(目录) > 0:
        设 候选 为 连接路径(目录, 命令名)
        如果 路径存在(候选):
          如果 目录存在(候选) 等于 假:
            返回 候选
        设 后缀们 为 [".exe", ".bat", ".cmd"]
        设 s 为 0
        当 s < 长(后缀们):
          设 候选2 为 候选 加上 后缀们[s]
          如果 路径存在(候选2):
            如果 目录存在(候选2) 等于 假:
              返回 候选2
          设 s 为 s 加上 1
      设 i 为 i 加上 1
    设 d 为 d 加上 1
  返回 空

# 命令存在（近似 文件系统.py:500 = which 非空）

段落 命令存在(命令名):
  如果 查找命令(命令名) == 空:
    返回 假
  返回 真

# 获取权限（对齐 文件系统.py:695 os.stat().st_mode 全量口径，非 oct 截断；
# 文件不存在时两腿均抛错，与 .py 一致）

段落 获取权限(路径):
  设 状 为 _light_builtin.文件状态(路径)
  返回 状.st_mode

# 文件定位（对齐 文件系统.py:546 file.seek：whence 0=开头/1=当前/2=末尾）

段落 文件定位(文件对象, 偏移量, 起点 等于 0):
  返回 文件对象.seek(偏移量, 起点)

# 文件当前位置（对齐 文件系统.py:611 file.tell）

段落 文件当前位置(文件对象):
  返回 文件对象.tell()

# 读取文件位置（对齐 文件系统.py:561：字节偏移 seek 后读 大小 字符；
# 多字节边界与编码差异为已登记边界）

段落 读取文件位置(路径, 偏移量, 大小, 编码 等于 "utf-8"):
  设 f 为 打开文件(路径, "r", encoding=编码)
  设 _ 为 f.seek(偏移量, 0)
  设 内容 为 f.read()
  f.close()
  设 终点 为 大小
  如果 终点 > 长(内容):
    设 终点 为 长(内容)
  返回 截取(内容, 0, 终点)

# 读取二进制文件位置（对齐 文件系统.py:579：int list 字节序列口径；
# 经整文件读取+收敛切片，大文件性能为已登记边界）

段落 读取二进制文件位置(路径, 偏移量, 大小):
  设 数据 为 读取二进制文件(路径)
  设 终点 为 偏移量 加上 大小
  如果 终点 > 长(数据):
    设 终点 为 长(数据)
  返回 数据[偏移量:终点]

# 写入文件位置（对齐 文件系统.py:596：r+ 模式 seek 后写入，不截断）

段落 写入文件位置(路径, 偏移量, 内容, 编码 等于 "utf-8"):
  设 f 为 打开文件(路径, "r+", encoding=编码)
  设 _ 为 f.seek(偏移量, 0)
  f.write(内容)
  f.close()

# 读取文件块（对齐 文件系统.py:337：按 块大小 切分文本，返回块列表）

段落 读取文件块(路径, 块大小 等于 4096, 编码 等于 "utf-8"):
  设 f 为 打开文件(路径, "r", encoding=编码)
  设 内容 为 f.read()
  f.close()
  设 总长 为 长(内容)
  设 块们 为 []
  设 位置 为 0
  当 位置 < 总长:
    设 终点 为 位置 加上 块大小
    如果 终点 > 总长:
      设 终点 为 总长
    块们.追加(截取(内容, 位置, 终点))
    设 位置 为 终点
  返回 块们

# 文件编码检测（对齐 文件系统.py:423 结构：utf-8 优先→gbk→未知；
# ⚠️ native 腿 fopen 无编码概念，非 UTF-8 文件恒判 utf-8（已登记边界））

段落 文件编码检测(路径):
  如果 路径存在(路径) 等于 假:
    抛出 运行时错误("文件不存在: " 加上 路径)
  设 可utf 为 假
  尝试:
    设 _ 为 读取文件(路径)
    设 可utf 为 真
  捕获 异常:
    设 可utf 为 假
  结束。
  如果 可utf:
    返回 "utf-8"
  设 可gbk 为 假
  尝试:
    设 f 为 打开文件(路径, "r", encoding="gbk")
    设 _c 为 f.read()
    f.close()
    设 可gbk 为 真
  捕获 异常:
    设 可gbk 为 假
  结束。
  如果 可gbk:
    返回 "gbk"
  返回 "未知"

