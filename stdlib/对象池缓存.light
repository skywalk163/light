# 光明标准库 —— 对象池与缓存模块（原生腿真身）
#
# 对齐 stdlib/对象池缓存.py 的 12 个顶层导出 + 任务点名的池/缓存操作函数
# （获取/放入/过期清理/大小/清空）。原生腿无类可实例化，全部以「字典 + 列表」
# 函数式实现；对象池带时间戳（整数秒，来自 时间戳 builtin）。
#
# 原生腿能力边界（详见 docs/known_issues.md T5C 章节）：
# 1. 创建函数 / 刷新函数 / 工厂 / 装饰器函数不可作为值调用（原生腿边界）：
#    - 对象池获取 在空闲池为空时返回 空（不做工厂创建）；
#    - 缓存装饰器 / LRU缓存装饰器 / 记忆化 返回 空（无法返回包装函数）；
#    - 定时缓存 在需要刷新时返回 空。
# 2. 字典新增原语经函数参数（REF）写回会丢失（原生腿浅拷贝 + 扩容重绑），
#    故缓存家族内部一律用「键/值/截止 并行列表」存储：追加走字典读出的
#    列表句柄（原地生效），删除/清空用重建列表 + 字典设置（更新路径生效）。
#    缓存值不能为 空（语义上与缺失冲突时以 空 为缺失标记，缓存不存 空）。
# 3. 时间戳为整数秒（时间戳 builtin 为浮点秒，取整）；过期判定为
#    now - 放入时刻 > 最大空闲秒数。
# 4. 对象池获取 取最近放入对象（LIFO，对齐 .py 的 pop()）。
# 5. 缓存不驱逐（LRU 容量上限不触发淘汰，仅记录 最大容量），见 known_issues。

导出 对象上下文管理器 缓存装饰器 LRU缓存装饰器 记忆化。
导出 创建对象池 创建LRU缓存 创建简单缓存 创建定时缓存 创建缓存。
导出 设置缓存 获取缓存 清除缓存。
导出 对象池获取 对象池放入 对象池过期清理 对象池大小 对象池清空。
导出 缓存获取 缓存设置 缓存删除 缓存包含 缓存清空 缓存大小。
导出 简单缓存获取 简单缓存设置 简单缓存清理过期 简单缓存大小 简单缓存清空。
导出 定时缓存获取 定时缓存刷新 定时缓存清除。

# 对象上下文管理器 —— 上下文语义不可表达，返回池本身（API 对齐标注）
段落 对象上下文管理器 接收 池:
  返回 池

# 缓存装饰器 —— 无法返回包装函数（原生腿边界），返回 空
段落 缓存装饰器 接收 最大容量 = 128:
  返回 空

# LRU缓存装饰器 —— 同上
段落 LRU缓存装饰器 接收 最大容量 = 128:
  返回 空

# 记忆化 —— 同上
段落 记忆化 接收 函数:
  返回 空

# 创建对象池（创建函数, 最大大小=10, 初始化数量=0）
段落 创建对象池 接收 创建函数, 最大大小 = 10, 初始化数量 = 0:
  设 池 为 {}
  字典设置(池, "对象", 新建列表())
  字典设置(池, "创建函数", 创建函数)
  字典设置(池, "最大大小", 最大大小)
  返回 池

# 对象池获取 —— 空闲取最近放入（LIFO）；池空时返回 空（工厂不可调用）
段落 对象池获取 接收 池:
  设 列表 为 字典获取(池, "对象", 新建列表())
  如果 长(列表) == 0:
    返回 空
  设 最后 为 长(列表) 减 1
  设 条目 为 列表[最后]
  设 新 为 新建列表()
  设 i 为 0
  当 i < 最后:
    追加(新, 列表[i])
    设 i 为 i 加上 1
  字典设置(池, "对象", 新)
  返回 条目[0]

# 对象池放入 —— 记录放入时刻（整数秒）
段落 对象池放入 接收 池, 对象:
  设 列表 为 字典获取(池, "对象", 新建列表())
  追加(列表, 列表(对象, 整数(时间戳())))
  返回 空

# 对象池过期清理 —— 移除空闲超过 最大空闲秒数 的对象
段落 对象池过期清理 接收 池, 最大空闲秒数 = 60:
  设 列表 为 字典获取(池, "对象", 新建列表())
  设 现在 为 整数(时间戳())
  设 新 为 新建列表()
  设 i 为 0
  当 i < 长(列表):
    设 条目 为 列表[i]
    如果 现在 减 条目[1] <= 最大空闲秒数:
      追加(新, 条目)
    设 i 为 i 加上 1
  字典设置(池, "对象", 新)
  返回 空

# 对象池大小
段落 对象池大小 接收 池:
  返回 长(字典获取(池, "对象", 新建列表()))

# 对象池清空
段落 对象池清空 接收 池:
  字典设置(池, "对象", 新建列表())
  返回 空

# ============ 缓存家族：键/值/截止 并行列表存储 ============

# 创建LRU缓存（最大容量=128）—— 并行列表结构 {"键":[], "值":[], "最大容量":N}
段落 创建LRU缓存 接收 最大容量 = 128:
  设 缓存 为 {}
  字典设置(缓存, "键", 新建列表())
  字典设置(缓存, "值", 新建列表())
  字典设置(缓存, "最大容量", 最大容量)
  返回 缓存

# 缓存获取（默认值=空）；键不存在返回默认值
段落 缓存获取 接收 缓存, 键, 默认值 = 空:
  设 键们 为 字典获取(缓存, "键", 新建列表())
  设 值们 为 字典获取(缓存, "值", 新建列表())
  设 i 为 0
  当 i < 长(键们):
    如果 键们[i] 等于 键:
      返回 值们[i]
    设 i 为 i 加上 1
  返回 默认值

# 缓存设置 —— 键存在则更新值，否则追加；缓存值不能为 空
段落 缓存设置 接收 缓存, 键, 值:
  设 键们 为 字典获取(缓存, "键", 新建列表())
  设 值们 为 字典获取(缓存, "值", 新建列表())
  设 找到 为 假
  设 i 为 0
  当 i < 长(键们):
    如果 键们[i] 等于 键:
      设 找到 为 真
      设 新值们 为 新建列表()
      设 j 为 0
      当 j < 长(值们):
        如果 j == i:
          追加(新值们, 值)
        否则:
          追加(新值们, 值们[j])
        设 j 为 j 加上 1
      字典设置(缓存, "值", 新值们)
    设 i 为 i 加上 1
  如果 找到:
    返回 空
  追加(键们, 键)
  追加(值们, 值)
  返回 空

# 缓存删除 —— 键不存在时静默；存在则重建两表（跳过该键）
段落 缓存删除 接收 缓存, 键:
  设 键们 为 字典获取(缓存, "键", 新建列表())
  设 值们 为 字典获取(缓存, "值", 新建列表())
  设 新键们 为 新建列表()
  设 新值们 为 新建列表()
  设 i 为 0
  当 i < 长(键们):
    如果 键们[i] 不等于 键:
      追加(新键们, 键们[i])
      追加(新值们, 值们[i])
    设 i 为 i 加上 1
  字典设置(缓存, "键", 新键们)
  字典设置(缓存, "值", 新值们)
  返回 空

# 缓存包含
段落 缓存包含 接收 缓存, 键:
  设 键们 为 字典获取(缓存, "键", 新建列表())
  设 i 为 0
  当 i < 长(键们):
    如果 键们[i] 等于 键:
      返回 真
    设 i 为 i 加上 1
  返回 假

# 缓存清空
段落 缓存清空 接收 缓存:
  字典设置(缓存, "键", 新建列表())
  字典设置(缓存, "值", 新建列表())
  返回 空

# 缓存大小
段落 缓存大小 接收 缓存:
  返回 长(字典获取(缓存, "键", 新建列表()))

# 创建简单缓存（过期时间=空，单位秒）—— 键/值/截止 并行列表
段落 创建简单缓存 接收 过期时间 = 空:
  设 缓存 为 {}
  字典设置(缓存, "键", 新建列表())
  字典设置(缓存, "值", 新建列表())
  字典设置(缓存, "截止", 新建列表())
  字典设置(缓存, "过期时间", 过期时间)
  返回 缓存

# 简单缓存设置 —— 截止 = now + 过期时间（过期时间为空则不限期）
段落 简单缓存设置 接收 缓存, 键, 值:
  设 过期 为 字典获取(缓存, "过期时间", 空)
  设 截止 为 空
  如果 过期 不等于 空:
    设 截止 为 整数(时间戳()) 加上 过期
  设 键们 为 字典获取(缓存, "键", 新建列表())
  设 值们 为 字典获取(缓存, "值", 新建列表())
  设 截止们 为 字典获取(缓存, "截止", 新建列表())
  设 找到 为 假
  设 i 为 0
  当 i < 长(键们):
    如果 键们[i] 等于 键:
      设 找到 为 真
      设 新值们 为 新建列表()
      设 新截止们 为 新建列表()
      设 j 为 0
      当 j < 长(值们):
        如果 j == i:
          追加(新值们, 值)
          追加(新截止们, 截止)
        否则:
          追加(新值们, 值们[j])
          追加(新截止们, 截止们[j])
        设 j 为 j 加上 1
      字典设置(缓存, "值", 新值们)
      字典设置(缓存, "截止", 新截止们)
    设 i 为 i 加上 1
  如果 找到:
    返回 空
  追加(键们, 键)
  追加(值们, 值)
  追加(截止们, 截止)
  返回 空

# 简单缓存获取 —— 过期视为缺失（返回 默认值）
段落 简单缓存获取 接收 缓存, 键, 默认值 = 空:
  设 键们 为 字典获取(缓存, "键", 新建列表())
  设 值们 为 字典获取(缓存, "值", 新建列表())
  设 截止们 为 字典获取(缓存, "截止", 新建列表())
  设 i 为 0
  当 i < 长(键们):
    如果 键们[i] 等于 键:
      如果 截止们[i] 不等于 空:
        如果 整数(时间戳()) 大于 截止们[i]:
          返回 默认值
      返回 值们[i]
    设 i 为 i 加上 1
  返回 默认值

# 简单缓存清理过期 —— 移除过期条目（重建两表）
段落 简单缓存清理过期 接收 缓存:
  设 现在 为 整数(时间戳())
  设 键们 为 字典获取(缓存, "键", 新建列表())
  设 值们 为 字典获取(缓存, "值", 新建列表())
  设 截止们 为 字典获取(缓存, "截止", 新建列表())
  设 新键们 为 新建列表()
  设 新值们 为 新建列表()
  设 新截止们 为 新建列表()
  设 i 为 0
  当 i < 长(键们):
    设 保留 为 真
    如果 截止们[i] 不等于 空:
      如果 现在 大于 截止们[i]:
        设 保留 为 假
    如果 保留:
      追加(新键们, 键们[i])
      追加(新值们, 值们[i])
      追加(新截止们, 截止们[i])
    设 i 为 i 加上 1
  字典设置(缓存, "键", 新键们)
  字典设置(缓存, "值", 新值们)
  字典设置(缓存, "截止", 新截止们)
  返回 空

# 简单缓存大小 —— 先清理过期再计数
段落 简单缓存大小 接收 缓存:
  设 空值 为 简单缓存清理过期(缓存)
  返回 长(字典获取(缓存, "键", 新建列表()))

# 简单缓存清空
段落 简单缓存清空 接收 缓存:
  字典设置(缓存, "键", 新建列表())
  字典设置(缓存, "值", 新建列表())
  字典设置(缓存, "截止", 新建列表())
  返回 空

# 创建定时缓存（刷新函数, 刷新间隔=60）
段落 创建定时缓存 接收 刷新函数, 刷新间隔 = 60:
  设 缓存 为 {}
  字典设置(缓存, "刷新函数", 刷新函数)
  字典设置(缓存, "刷新间隔", 刷新间隔)
  字典设置(缓存, "值", 空)
  字典设置(缓存, "最后刷新", 0)
  返回 缓存

# 定时缓存获取 —— 值空或到期时返回 空（刷新函数不可调用）
段落 定时缓存获取 接收 缓存:
  设 值 为 字典获取(缓存, "值", 空)
  如果 值 等于 空:
    返回 空
  设 间隔 为 字典获取(缓存, "刷新间隔", 60)
  设 最后 为 字典获取(缓存, "最后刷新", 0)
  如果 整数(时间戳()) 减 最后 > 间隔:
    返回 空
  返回 值

# 定时缓存刷新 —— 刷新函数不可调用，返回 空
段落 定时缓存刷新 接收 缓存:
  返回 空

# 定时缓存清除
段落 定时缓存清除 接收 缓存:
  字典设置(缓存, "值", 空)
  字典设置(缓存, "最后刷新", 0)
  返回 空

# 创建缓存 —— 简单字典缓存（键/值并行列表）
段落 创建缓存:
  设 缓存 为 {}
  字典设置(缓存, "键", 新建列表())
  字典设置(缓存, "值", 新建列表())
  返回 缓存

# 设置缓存
段落 设置缓存 接收 缓存, 键, 值:
  设 键们 为 字典获取(缓存, "键", 新建列表())
  设 值们 为 字典获取(缓存, "值", 新建列表())
  设 找到 为 假
  设 i 为 0
  当 i < 长(键们):
    如果 键们[i] 等于 键:
      设 找到 为 真
      设 新值们 为 新建列表()
      设 j 为 0
      当 j < 长(值们):
        如果 j == i:
          追加(新值们, 值)
        否则:
          追加(新值们, 值们[j])
        设 j 为 j 加上 1
      字典设置(缓存, "值", 新值们)
    设 i 为 i 加上 1
  如果 找到:
    返回 空
  追加(键们, 键)
  追加(值们, 值)
  返回 空

# 获取缓存
段落 获取缓存 接收 缓存, 键, 默认值 = 空:
  设 键们 为 字典获取(缓存, "键", 新建列表())
  设 值们 为 字典获取(缓存, "值", 新建列表())
  设 i 为 0
  当 i < 长(键们):
    如果 键们[i] 等于 键:
      返回 值们[i]
    设 i 为 i 加上 1
  返回 默认值

# 清除缓存 —— 重建两表
段落 清除缓存 接收 缓存:
  字典设置(缓存, "键", 新建列表())
  字典设置(缓存, "值", 新建列表())
  返回 空
