# ============ 简单缓存家族 ============

# 创建简单缓存（过期时间=空，单位秒）—— 函数式 {键: [值, 截止]} 承载
段落 创建简单缓存(过期时间 等于 空):
  设 缓存 为 {}
  字典设置(缓存, "过期时间", 过期时间)
  返回 缓存

# 简单缓存设置 —— 截止 = now + 过期时间（过期时间为空则不限期）
段落 简单缓存设置(缓存, 键, 值):
  设 过期 为 字典获取(缓存, "过期时间", 空)
  设 截止 为 空
  如果 过期 不等于 空:
    设 截止 为 整数(时间戳()) 加上 过期
  设 条目 为 新建列表()
  列表追加(条目, 值)
  列表追加(条目, 截止)
  字典设置(缓存, 键, 条目)
  返回 空

# 简单缓存获取 —— 过期视为缺失（返回 默认值）并顺手删除
段落 简单缓存获取(缓存, 键, 默认值 等于 空):
  如果 字典包含键(缓存, 键):
    设 条目 为 字典获取(缓存, 键, 空)
    设 截止 为 条目[1]
    如果 截止 不等于 空:
      如果 整数(时间戳()) 大于 截止:
        设 空值 为 字典删除(缓存, 键)
        返回 默认值
    返回 条目[0]
  返回 默认值

# 简单缓存清理过期 —— 移除过期条目（保留元键 过期时间）
段落 简单缓存清理过期(缓存):
  设 键们 为 字典键列表(缓存)
  设 现在 为 整数(时间戳())
  设 i 为 0
  当 i < 长(键们):
    设 键 为 键们[i]
    如果 键 不等于 "过期时间":
      设 条目 为 字典获取(缓存, 键, 空)
      如果 条目 不等于 空:
        设 截止 为 条目[1]
        如果 截止 不等于 空:
          如果 现在 大于 截止:
            设 空值 为 字典删除(缓存, 键)
    设 i 为 i 加上 1
  返回 空

# 简单缓存大小 —— 先清理过期再计数（剔除元键 过期时间）
段落 简单缓存大小(缓存):
  设 空值 为 简单缓存清理过期(缓存)
  设 全部 为 长(字典键列表(缓存))
  如果 字典包含键(缓存, "过期时间"):
    返回 全部 减 1
  返回 全部

# 简单缓存清空 —— 清掉全部条目，保留 过期时间 元键
段落 简单缓存清空(缓存):
  设 键们 为 字典键列表(缓存)
  设 i 为 0
  当 i < 长(键们):
    如果 键们[i] 不等于 "过期时间":
      设 空值 为 字典删除(缓存, 键们[i])
    设 i 为 i 加上 1
  返回 空

# ============ 定时缓存家族 ============

# 创建定时缓存（刷新函数, 刷新间隔=60）—— 函数式字典承载
段落 创建定时缓存(刷新函数, 刷新间隔 等于 60):
  设 缓存 为 {}
  字典设置(缓存, "刷新函数", 刷新函数)
  字典设置(缓存, "刷新间隔", 刷新间隔)
  字典设置(缓存, "值", 空)
  字典设置(缓存, "最后刷新", 0)
  返回 缓存

# 定时缓存获取 —— 值空或到期时返回 空（刷新函数不可调用，native 腿边界）
段落 定时缓存获取(缓存):
  设 值 为 字典获取(缓存, "值", 空)
  如果 值 等于 空:
    返回 空
  设 间隔 为 字典获取(缓存, "刷新间隔", 60)
  设 最后 为 字典获取(缓存, "最后刷新", 0)
  如果 整数(时间戳()) 减 最后 > 间隔:
    返回 空
  返回 值

# 定时缓存刷新 —— 刷新函数不可调用（native 腿边界），返回 空
段落 定时缓存刷新(缓存):
  返回 空

# 定时缓存清除
段落 定时缓存清除(缓存):
  字典设置(缓存, "值", 空)
  字典设置(缓存, "最后刷新", 0)
  返回 空

# ============ 普通字典缓存 ============

# 创建缓存 —— 普通字典缓存（对齐 .py：返回 {}）
段落 创建缓存:
  设 缓存 为 {}
  返回 缓存

# 设置缓存 —— 直接写键
段落 设置缓存(缓存, 键, 值):
  字典设置(缓存, 键, 值)
  返回 空

# 获取缓存
段落 获取缓存(缓存, 键, 默认值 等于 空):
  如果 字典包含键(缓存, 键):
    返回 字典获取(缓存, 键, 默认值)
  返回 默认值

# 清除缓存 —— 遍历删除
段落 清除缓存(缓存):
  设 键们 为 字典键列表(缓存)
  设 i 为 0
  当 i < 长(键们):
    设 空值 为 字典删除(缓存, 键们[i])
    设 i 为 i 加上 1
  返回 空
