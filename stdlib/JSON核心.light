# 纯光明实现 —— 本模块由光明段言自写，纯光明 JSON 解析/序列化/落盘，不调 Python json
# 提供：解析(文本) / 序列化(值, 缩进) / 写入文件(路径, 值)。与 stdlib/JSON.py 行为对齐（ensure_ascii=False，保中文原样）。
# 魔数：首两行含「纯光明实现」——若有同名 JSON核心.py 即由本文件完全取代。
#
# 与 JSON编解码.light 的关系：解析器直接复用其已验证的递归下降实现（对象/数组/字符串含转义与 \uXXXX/
# 数字含指数/true/false/null），仅把导出名收敛成任务书要求的 解析/序列化/写入文件，并为 序列化 补上
# 缩进能力。两个文件都是纯光明自举写库的证明，本文件是「关键路径」专用裁剪版（harness 只吃 5 个符号）。

导出 解析 序列化 写入文件。
导出 JSON解码器。

# ---------- 序列化（编码） ----------
# 入口：序列化(值, 缩进)；缩进=0 压成一行（紧凑），缩进>0 按该空格数缩进（等价 json.dumps(..., indent=缩进)）。
段落 序列化 接收 值, 缩进 = 0:
  返回 编码值(值, 缩进, 0)

# 编码一个值，层级用于缩进计算
段落 编码值 接收 值, 缩进, 层级:
  如果 值 == 空:
    返回 "null"
  # 用 type 而不是 == 判断布尔，避免 1==True / 0==False 干扰
  如果 type(值) == bool:
    如果 值 == 真:
      返回 "true"
    返回 "false"
  如果 type(值) == str:
    返回 编码字符串(值)
  如果 type(值) == dict:
    返回 编码对象(值, 缩进, 层级)
  如果 type(值) == list:
    返回 编码数组(值, 缩进, 层级)
  返回 转字符串(值)

# 编码字符串：转义 " \ 与 5 个有名控制符；其余 <0x20 控制符直接原样（见交付报告差异清单）
段落 编码字符串 接收 文本:
  设 结果 为 ""
  设 i 为 0
  设 n 为 长(文本)
  当 i < n:
    设 c 为 文本[i]
    如果 c == "\"":
      设 结果 为 结果 加上 "\\\""
    否则 如果 c == "\\":
      设 结果 为 结果 加上 "\\\\"
    否则 如果 c == "\n":
      设 结果 为 结果 加上 "\\n"
    否则 如果 c == "\r":
      设 结果 为 结果 加上 "\\r"
    否则 如果 c == "\t":
      设 结果 为 结果 加上 "\\t"
    否则 如果 c == "\b":
      设 结果 为 结果 加上 "\\b"
    否则 如果 c == "\f":
      设 结果 为 结果 加上 "\\f"
    否则:
      设 结果 为 结果 加上 c
    设 i 为 i + 1
  返回 "\"" 加上 结果 加上 "\""

# 编码对象
段落 编码对象 接收 对象, 缩进, 层级:
  如果 长(对象) == 0:
    返回 "{}"
  设 部分 为 []
  遍历 k 之 对象:
    设 键串 为 编码字符串(k)
    设 值串 为 编码值(对象[k], 缩进, 层级 + 1)
    如果 缩进 == 0:
      部分.追加(键串 加上 ": " 加上 值串)
    否则:
      设 内层缩进 为 重复空格(缩进 * (层级 + 1))
      部分.追加(内层缩进 加上 键串 加上 ": " 加上 值串)
  如果 缩进 == 0:
    返回 "{" 加上 连接(部分, ", ") 加上 "}"
  否则:
    设 本层缩进 为 重复空格(缩进 * 层级)
    返回 "{\n" 加上 连接(部分, ",\n") 加上 "\n" 加上 本层缩进 加上 "}"

# 编码数组
段落 编码数组 接收 数组, 缩进, 层级:
  如果 长(数组) == 0:
    返回 "[]"
  设 部分 为 []
  遍历 项 之 数组:
    如果 缩进 == 0:
      部分.追加(编码值(项, 0, 0))
    否则:
      设 内层缩进 为 重复空格(缩进 * (层级 + 1))
      部分.追加(内层缩进 加上 编码值(项, 缩进, 层级 + 1))
  如果 缩进 == 0:
    返回 "[" 加上 连接(部分, ", ") 加上 "]"
  否则:
    设 本层缩进 为 重复空格(缩进 * 层级)
    返回 "[\n" 加上 连接(部分, ",\n") 加上 "\n" 加上 本层缩进 加上 "]"

# 用分隔符连接字符串列表
段落 连接 接收 部分, 分隔:
  设 结果 为 ""
  设 i 为 0
  设 n 为 长(部分)
  当 i < n:
    如果 i > 0:
      设 结果 为 结果 加上 分隔
    设 结果 为 结果 加上 部分[i]
    设 i 为 i + 1
  返回 结果

# 重复 count 个空格（缩进用）
段落 重复空格 接收 count:
  设 s 为 ""
  设 i 为 0
  当 i < count:
    设 s 为 s 加上 " "
    设 i 为 i + 1
  返回 s

# 写入文件：序列化（默认 2 空格美化）后落盘。用 打开文件 内置原语，避开与「写入文件」内置同名遮蔽。
段落 写入文件 接收 路径, 值:
  设 文本 为 序列化(值, 2)
  设 f 为 打开文件(路径, "w", encoding="utf-8")
  f.write(文本)
  f.close()

# ---------- 解码（递归下降，复用 JSON编解码.light 已验证实现） ----------
类 JSON解码器:
  设 文本 等于 ""
  设 下标 等于 0

  段落 构造 接收 文本:
    设 己.文本 为 文本
    设 己.下标 为 0

  # 入口：解析一个完整 JSON 值
  段落 解析 接收:
    设 值 为 己.解析值()
    返回 值

  # 当前字符；越界返回 ""
  段落 当前 接收:
    如果 己.下标 >= 长(己.文本):
      返回 ""
    返回 己.文本[己.下标]

  # 跳过空白
  段落 跳过空白 接收:
    当 长(己.当前()) > 0:
      设 c 为 己.当前()
      如果 c == " " 或 c == "\n" 或 c == "\r" 或 c == "\t":
        设 己.下标 为 己.下标 加上 1
      否则:
        跳出

  # 解析一个值
  段落 解析值 接收:
    己.跳过空白()
    设 c 为 己.当前()
    如果 c == "{":
      返回 己.解析对象()
    如果 c == "[":
      返回 己.解析数组()
    如果 c == "\"":
      返回 己.解析字符串()
    如果 c == "t":
      己.期望字("true")
      返回 真
    如果 c == "f":
      己.期望字("false")
      返回 假
    如果 c == "n":
      己.期望字("null")
      返回 空
    如果 己.是数字起始(c):
      返回 己.解析数字()
    抛出 新建 异常("JSON 解析错误：非法字符 '" 加上 c 加上 "'")

  # 期望接下来的字面量文本
  段落 期望字 接收 字:
    设 长字 为 长(字)
    如果 己.文本[己.下标:己.下标 加上 长字] != 字:
      抛出 新建 异常("JSON 解析错误：期望 " 加上 字)
    设 己.下标 为 己.下标 加上 长字

  # 解析对象
  段落 解析对象 接收:
    设 己.下标 为 己.下标 加上 1   # 越过 {
    设 结果 为 {}
    己.跳过空白()
    如果 己.当前() == "}":
      设 己.下标 为 己.下标 加上 1
      返回 结果
    当 真:
      己.跳过空白()
      设 键 为 己.解析字符串()
      己.跳过空白()
      如果 己.当前() != ":":
        抛出 新建 异常("JSON 解析错误：对象缺少冒号")
      设 己.下标 为 己.下标 加上 1
      设 值 为 己.解析值()
      结果[键] 为 值
      己.跳过空白()
      设 c 为 己.当前()
      如果 c == ",":
        设 己.下标 为 己.下标 加上 1
      否则 如果 c == "}":
        设 己.下标 为 己.下标 加上 1
        跳出
      否则:
        抛出 新建 异常("JSON 解析错误：对象缺少逗号或右花括号")
    返回 结果

  # 解析数组
  段落 解析数组 接收:
    设 己.下标 为 己.下标 加上 1   # 越过 [
    设 结果 为 []
    己.跳过空白()
    如果 己.当前() == "]":
      设 己.下标 为 己.下标 加上 1
      返回 结果
    当 真:
      设 值 为 己.解析值()
      结果.追加(值)
      己.跳过空白()
      设 c 为 己.当前()
      如果 c == ",":
        设 己.下标 为 己.下标 加上 1
      否则 如果 c == "]":
        设 己.下标 为 己.下标 加上 1
        跳出
      否则:
        抛出 新建 异常("JSON 解析错误：数组缺少逗号或右方括号")
    返回 结果

  # 解析字符串（当前必须在引号处）
  段落 解析字符串 接收:
    设 己.下标 为 己.下标 加上 1   # 越过开引号
    设 结果 为 ""
    当 真:
      如果 己.下标 >= 长(己.文本):
        抛出 新建 异常("JSON 解析错误：字符串未闭合")
      设 c 为 己.文本[己.下标]
      如果 c == "\"":
        设 己.下标 为 己.下标 加上 1
        跳出
      如果 c == "\\":
        设 己.下标 为 己.下标 加上 1
        设 e 为 己.当前()
        如果 e == "n":
          设 结果 为 结果 加上 "\n"
        否则 如果 e == "t":
          设 结果 为 结果 加上 "\t"
        否则 如果 e == "r":
          设 结果 为 结果 加上 "\r"
        否则 如果 e == "b":
          设 结果 为 结果 加上 "\b"
        否则 如果 e == "f":
          设 结果 为 结果 加上 "\f"
        否则 如果 e == "u":
          设 果 为 己.解析Unicode()
          设 结果 为 结果 加上 果
        否则:
          设 结果 为 结果 加上 e
        设 己.下标 为 己.下标 加上 1
      否则:
        设 结果 为 结果 加上 c
        设 己.下标 为 己.下标 加上 1
    返回 结果

  # 解析 \uXXXX
  段落 解析Unicode 接收:
    设 己.下标 为 己.下标 加上 1   # 越过 'u'
    设 码点 为 己.文本[己.下标:己.下标 加上 4]
    如果 长(码点) < 4:
      抛出 新建 异常("JSON 解析错误：无效 \\u 转义")
    设 数 为 整数(码点, 16)
    设 己.下标 为 己.下标 加上 3   # 使外层循环再前进 1 停在 4 字符后
    返回 chr(数)

  # 解析数字
  段落 解析数字 接收:
    设 起点 为 己.下标
    设 c 为 己.当前()
    如果 c == "-":
      设 己.下标 为 己.下标 加上 1
    当 己.下标 < 长(己.文本):
      设 ch 为 己.文本[己.下标]
      如果 己.是数字字符(ch) 或 ch == "." 或 ch == "e" 或 ch == "E" 或 ch == "+" 或 ch == "-":
        设 己.下标 为 己.下标 加上 1
      否则:
        跳出
    设 符号 为 己.文本[起点:己.下标]
    如果 己.含浮点(符号):
      返回 转浮点(符号)
    返回 转整数(符号)

  # 是否可能是数字起始（数字或负号）
  段落 是数字起始 接收 c:
    如果 c == "-":
      返回 真
    如果 c >= "0" 且 c <= "9":
      返回 真
    返回 假

  段落 是数字字符 接收 c:
    返回 c >= "0" 且 c <= "9"

  # 判断数字文本是否含小数点或指数（决定按整数还是浮点读）
  段落 含浮点 接收 符号:
    如果 己.内找到(符号, "."):
      返回 真
    返回 己.内找到(符号, "e") 或 己.内找到(符号, "E")

  段落 内找到 接收 文本, 子串:
    设 i 为 0
    当 i < 长(文本):
      如果 文本[i] == 子串:
        返回 真
      设 i 为 i + 1
    返回 假

# 便捷入口：解析(文本) -> 值
段落 解析 接收 文本:
  设 解析器 为 新建 JSON解码器(文本)
  返回 解析器.解析()
