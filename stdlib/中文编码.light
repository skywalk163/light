# 光明标准库 - 中文编码.light（R11B 原生腿真实现，能力受限版）
#
# 转写自 stdlib/中文编码.py。光明原生腿无 bytes/codecs 类型，本项目以
# 「十六进制串」表示字节序列（每字节 2 字符；输入大小写均可，输出小写，
# 与 stdlib/编码.light 的 Hex/字节口径一致）。
#
# 能力边界（与 .py 的差异，详见 R11B 简报 _taskR11B_brief_中文编码.md）：
#   1. 检测编码：仅返回 'utf-8' / 'gbk' / 'unknown'；.py 的 gb2312 / gb18030 /
#      big5 / ascii 不区分——「非 utf-8 且 GBK 结构有效」一律归 'gbk'。
#   2. 编码转换：仅支持 utf-8 / ascii 之间的转换（内容须纯 ASCII，否则抛
#      值错误；utf-8 源还须为有效 UTF-8）；含 gbk / big5 / gb2312 / gb18030 的
#      组合一律抛 值错误（光明无码表，无法真实互转）。
#   3. GBK转UTF8：无 GBK→Unicode 码表。数据为有效 UTF-8（含纯 ASCII）时按
#      UTF-8 解回文本返回（纯 ASCII 时与 .py 的 gbk 解码一致）；否则抛
#      值错误（消息含“不支持 GBK 码表转换”）。
#   4. UTF8转GBK：只支持纯 ASCII 文本（GBK 对 ASCII 编码 = 原字节，返回其
#      小写 hex）；含非 ASCII 字符时抛 值错误。
#   5. GBK 结构判定为纯结构规则（单字节 ASCII；双字节：首字节 0x81-0xFE、
#      次字节 0x40-0xFE 且非 0x7F），不做码表查询；与 .py decode('gbk') 在
#      个别边缘（如单字节 0x80→€）可能不一致。
#   6. UTF-8 有效性按真实 UTF-8 规则逐字节校验（含 E0/ED/F0/F4 的
#      最短序列/代理区/超 U+10FFFF 约束），与 Python utf-8 解码器判定一致。
#   7. 原生腿抛异常时异常对象消息串不随附（stderr 仅显示异常类名 值错误），
#      与转译腿 raise ValueError("...") 的消息呈现不同。
#
# 模块自包含：零导入、零 _light_builtin 依赖，仅用语言内置算子。

导出 检测编码 编码转换 判断GBK 判断UTF8。
导出 GBK转UTF8 UTF8转GBK Unicode转义 Unicode反转义。

设 _zhbmHEXP 为 "0123456789ABCDEF"

# 单字节 -> 大写 2 位十六进制
段落 _zhbmhex2 接收 b:
  设 hi 为 整除(b, 16)
  设 lo 为 取模(b, 16)
  返回 _zhbmHEXP[hi] 加上 _zhbmHEXP[lo]

# 十六进制字符 -> 数值（0-15），非法返回 -1（大小写均可）
段落 _zhbmhexval 接收 c:
  设 o 为 码位(c)
  如果 o >= 48:
    如果 o <= 57:
      返回 o 减去 48
  如果 o >= 65:
    如果 o <= 70:
      返回 o 减去 55
  如果 o >= 97:
    如果 o <= 102:
      返回 o 减去 87
  返回 -1

# 从十六进制串取第 k 个字节（0 基）
段落 _zhbmhexbyte 接收 hx, k:
  设 p 为 2 乘以 k
  设 hi 为 _zhbmhexval(hx[p])
  设 lo 为 _zhbmhexval(hx[p 加上 1])
  返回 hi 乘以 16 加上 lo

# 十六进制串是否合法：长度为偶数且每字符均为 hex 字符
段落 _zhbmhex合法 接收 hx:
  如果 取模(长(hx), 2) != 0:
    返回 假
  设 n 为 长(hx)
  设 i 为 0
  当 i < n:
    如果 _zhbmhexval(hx[i]) < 0:
      返回 假
    设 i 为 i 加上 1
  返回 真

# 字节序列是否为有效 UTF-8（逐字节结构校验，对齐 Python utf-8 解码器）
# R12A：「非」已在 codegen 根因修复（dv_to_bool 真值取反），恢复自然写法。
段落 _zhbmutf8有效 接收 hx:
  如果 hx == "":
    返回 假
  如果 非 _zhbmhex合法(hx):
    返回 假
  设 nb 为 整除(长(hx), 2)
  设 k 为 0
  当 k < nb:
    设 b 为 _zhbmhexbyte(hx, k)
    如果 b < 128:
      # ASCII：0x00-0x7F
      设 k 为 k 加上 1
    否则:
      如果 b < 224:
        # 双字节：0xC2-0xDF + 1 续字节（0x80-0xBF）
        如果 b < 194:
          返回 假
        如果 k 加上 1 >= nb:
          返回 假
        设 b2 为 _zhbmhexbyte(hx, k 加上 1)
        如果 b2 < 128:
          返回 假
        如果 b2 > 191:
          返回 假
        设 k 为 k 加上 2
      否则:
        如果 b < 240:
          # 三字节：0xE0-0xEF + 2 续字节（E0 次字节 >=0xA0，ED 次字节 <=0x9F）
          如果 k 加上 2 >= nb:
            返回 假
          设 b2 为 _zhbmhexbyte(hx, k 加上 1)
          设 b3 为 _zhbmhexbyte(hx, k 加上 2)
          如果 b2 < 128:
            返回 假
          如果 b2 > 191:
            返回 假
          如果 b == 224:
            如果 b2 < 160:
              返回 假
          如果 b == 237:
            如果 b2 > 159:
              返回 假
          如果 b3 < 128:
            返回 假
          如果 b3 > 191:
            返回 假
          设 k 为 k 加上 3
        否则:
          # 四字节：0xF0-0xF4 + 3 续字节（F0 次字节 >=0x90，F4 次字节 <=0x8F）
          如果 b > 244:
            返回 假
          如果 k 加上 3 >= nb:
            返回 假
          设 b2 为 _zhbmhexbyte(hx, k 加上 1)
          设 b3 为 _zhbmhexbyte(hx, k 加上 2)
          设 b4 为 _zhbmhexbyte(hx, k 加上 3)
          如果 b2 < 128:
            返回 假
          如果 b2 > 191:
            返回 假
          如果 b == 240:
            如果 b2 < 144:
              返回 假
          如果 b == 244:
            如果 b2 > 143:
              返回 假
          如果 b3 < 128:
            返回 假
          如果 b3 > 191:
            返回 假
          如果 b4 < 128:
            返回 假
          如果 b4 > 191:
            返回 假
          设 k 为 k 加上 4
  返回 真

# 字节序列是否为 GBK 结构有效：
# ASCII 单字节，或双字节对（首字节 0x81-0xFE，次字节 0x40-0xFE 且非 0x7F）
段落 _zhbmgbk有效 接收 hx:
  如果 hx == "":
    返回 假
  如果 非 _zhbmhex合法(hx):
    返回 假
  设 nb 为 整除(长(hx), 2)
  设 k 为 0
  当 k < nb:
    设 b 为 _zhbmhexbyte(hx, k)
    如果 b < 128:
      设 k 为 k 加上 1
    否则:
      如果 b < 129:
        返回 假
      如果 b > 254:
        返回 假
      如果 k 加上 1 >= nb:
        返回 假
      设 b2 为 _zhbmhexbyte(hx, k 加上 1)
      如果 b2 < 64:
        返回 假
      如果 b2 > 254:
        返回 假
      如果 b2 == 127:
        返回 假
      设 k 为 k 加上 2
  返回 真

# 字节序列是否全为 ASCII（每字节 < 0x80）
段落 _zhbm纯ASCII 接收 hx:
  如果 取模(长(hx), 2) != 0:
    返回 假
  如果 非 _zhbmhex合法(hx):
    返回 假
  设 nb 为 整除(长(hx), 2)
  设 k 为 0
  当 k < nb:
    如果 _zhbmhexbyte(hx, k) > 127:
      返回 假
    设 k 为 k 加上 1
  返回 真

# 十六进制串 -> 字节 -> UTF-8 解码 -> 字符串（仅对有效 UTF-8 调用）
段落 _zhbm解UTF8 接收 hx:
  设 nb 为 整除(长(hx), 2)
  设 结果 为 ""
  设 k 为 0
  当 k < nb:
    设 b 为 _zhbmhexbyte(hx, k)
    如果 b < 128:
      设 结果 为 结果 加上 字符自码位(b)
      设 k 为 k 加上 1
    否则:
      如果 b < 224:
        设 b2 为 _zhbmhexbyte(hx, k 加上 1)
        设 结果 为 结果 加上 字符自码位(取模(b, 32) 乘以 64 加上 取模(b2, 64))
        设 k 为 k 加上 2
      否则:
        如果 b < 240:
          设 b2 为 _zhbmhexbyte(hx, k 加上 1)
          设 b3 为 _zhbmhexbyte(hx, k 加上 2)
          设 结果 为 结果 加上 字符自码位(取模(b, 16) 乘以 4096 加上 取模(b2, 64) 乘以 64 加上 取模(b3, 64))
          设 k 为 k 加上 3
        否则:
          设 b2 为 _zhbmhexbyte(hx, k 加上 1)
          设 b3 为 _zhbmhexbyte(hx, k 加上 2)
          设 b4 为 _zhbmhexbyte(hx, k 加上 3)
          设 结果 为 结果 加上 字符自码位(取模(b, 8) 乘以 262144 加上 取模(b2, 64) 乘以 4096 加上 取模(b3, 64) 乘以 64 加上 取模(b4, 64))
          设 k 为 k 加上 4
  返回 结果

# 全 ASCII 文本 -> 小写 hex（UTF8转GBK 用，GBK 对 ASCII 编码 = 原字节）
段落 _zhbmASCIIhex 接收 文本:
  设 n 为 长(文本)
  设 结果 为 ""
  设 i 为 0
  当 i < n:
    设 结果 为 结果 加上 _zhbmhex2(码位(文本[i]))
    设 i 为 i 加上 1
  返回 转小写(结果)

# 码位 -> 大写 hex，不足 4 位左补 0（对齐 Python '{:04X}'）
段落 _zhbmhex4 接收 n:
  设 s 为 十六进制(n)
  当 长(s) < 4:
    设 s 为 "0" 加上 s
  返回 s

# ── 检测编码 ──
# 空 -> "unknown"；UTF-8 有效 -> "utf-8"；GBK 结构有效 -> "gbk"；否则 "unknown"。
# 边界：gb2312/gb18030/big5/ascii 不区分，非 utf-8 且 GBK 结构有效一律归 "gbk"。
段落 检测编码 接收 数据:
  如果 数据 == "":
    返回 "unknown"
  如果 _zhbmutf8有效(数据):
    返回 "utf-8"
  如果 _zhbmgbk有效(数据):
    返回 "gbk"
  返回 "unknown"

# ── 判断UTF8 ──
段落 判断UTF8 接收 数据:
  如果 数据 == "":
    返回 假
  返回 _zhbmutf8有效(数据)

# ── 判断GBK ──
# 对齐 .py：GBK 结构有效 且 非 UTF-8（gbk 能解但 utf8 不能）才判 GBK。
段落 判断GBK 接收 数据:
  如果 数据 == "":
    返回 假
  如果 非 _zhbmgbk有效(数据):
    返回 假
  如果 _zhbmutf8有效(数据):
    返回 假
  返回 真

# ── 编码转换 ──
# 空 -> 空串；源==目标（忽略大小写）-> 原样；仅支持 utf-8/ascii 组合
# （内容须纯 ASCII 方可互转，否则抛 值错误）；含 gbk/big5 等组合一律抛 值错误。
段落 编码转换 接收 数据, 源编码, 目标编码:
  如果 数据 == "":
    返回 ""
  设 源 为 转小写(源编码)
  设 目标 为 转小写(目标编码)
  如果 源 == 目标:
    返回 数据
  设 源UTF8 为 源 == "utf-8" 或 源 == "utf8"
  设 源ASCII 为 源 == "ascii" 或 源 == "us-ascii"
  设 目标UTF8 为 目标 == "utf-8" 或 目标 == "utf8"
  设 目标ASCII 为 目标 == "ascii" 或 目标 == "us-ascii"
  如果 源UTF8 或 源ASCII:
    如果 目标UTF8 或 目标ASCII:
      如果 源UTF8:
        如果 非 _zhbmutf8有效(数据):
          抛出 值错误("源编码 utf-8 解码失败")
      否则:
        如果 非 _zhbm纯ASCII(数据):
          抛出 值错误("源编码 ascii 解码失败")
      如果 目标ASCII:
        如果 非 _zhbm纯ASCII(数据):
          抛出 值错误("目标编码 ascii 无法编码非 ASCII 内容")
      返回 数据
  抛出 值错误("不支持的编码转换: " 加上 源编码 加上 " -> " 加上 目标编码)

# ── GBK转UTF8 ──
# 边界：无 GBK→Unicode 码表。数据为有效 UTF-8（含纯 ASCII）时按 UTF-8 解回
# 文本（纯 ASCII 输入与 .py gbk 解码一致）；否则抛 值错误。
段落 GBK转UTF8 接收 数据:
  如果 数据 == "":
    返回 ""
  如果 _zhbmutf8有效(数据):
    返回 _zhbm解UTF8(数据)
  抛出 值错误("不支持 GBK 码表转换: 数据非有效 UTF-8，无法转回文本")

# ── UTF8转GBK ──
# 边界：只支持纯 ASCII 文本（GBK 对 ASCII 编码 = 原字节，返回其小写 hex）；
# 含非 ASCII 字符时抛 值错误。
段落 UTF8转GBK 接收 文本:
  如果 文本 == "":
    返回 ""
  设 n 为 长(文本)
  设 i 为 0
  当 i < n:
    如果 码位(文本[i]) > 127:
      抛出 值错误("不支持 GBK 码表转换: 文本含非 ASCII 字符")
    设 i 为 i 加上 1
  返回 _zhbmASCIIhex(文本)

# ── Unicode转义 ──
# 码位 > 0x7F 的字符 -> \u + 大写 4 位 hex（不足补 0）；其余原样。
段落 Unicode转义 接收 文本:
  如果 文本 == "":
    返回 ""
  设 n 为 长(文本)
  设 i 为 0
  设 结果 为 ""
  当 i < n:
    设 o 为 码位(文本[i])
    如果 o > 127:
      设 结果 为 结果 加上 "\\u" 加上 _zhbmhex4(o)
    否则:
      设 结果 为 结果 加上 文本[i]
    设 i 为 i 加上 1
  返回 结果

# ── Unicode反转义 ──
# 扫描：遇 \u 且后 4 个字符均为 hex -> 还原为字符（多段都支持）；否则原样拷贝。
段落 Unicode反转义 接收 文本:
  如果 文本 == "":
    返回 ""
  设 n 为 长(文本)
  设 i 为 0
  设 结果 为 ""
  当 i < n:
    如果 文本[i] == "\\":
      如果 i 加上 5 < n:
        如果 文本[i 加上 1] == "u":
          设 h1 为 _zhbmhexval(文本[i 加上 2])
          设 h2 为 _zhbmhexval(文本[i 加上 3])
          设 h3 为 _zhbmhexval(文本[i 加上 4])
          设 h4 为 _zhbmhexval(文本[i 加上 5])
          如果 h1 >= 0 且 h2 >= 0 且 h3 >= 0 且 h4 >= 0:
            设 结果 为 结果 加上 字符自码位(h1 乘以 4096 加上 h2 乘以 256 加上 h3 乘以 16 加上 h4)
            设 i 为 i 加上 6
          否则:
            设 结果 为 结果 加上 文本[i]
            设 i 为 i 加上 1
        否则:
          设 结果 为 结果 加上 文本[i]
          设 i 为 i 加上 1
      否则:
        设 结果 为 结果 加上 文本[i]
        设 i 为 i 加上 1
    否则:
      设 结果 为 结果 加上 文本[i]
      设 i 为 i 加上 1
  返回 结果
