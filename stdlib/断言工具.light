class 断言失败异常(断言错误):
    def初始化(消息='',期望值=无,实际值=无):
        超级().初始化(消息)
        self.期望值=期望值
        self.实际值=实际值


def断言(条件,消息=''):
    如果不是条件:
        抛出断言失败异常(消息或'断言失败')


def断言为真(条件,消息=''):
    如果不是条件:
        抛出断言失败异常(消息或'断言失败:条件不为真')


def断言为假(条件,消息=''):
    如果条件:
        抛出断言失败异常(消息或'断言失败:条件不为假')


def断言为无(值,消息=''):
    如果值不是无:
        抛出断言失败异常(消息或'断言失败:'+字符串值+'不为None',无,值)


def断言不为无(值,消息=''):
    如果值是无:
        抛出断言失败异常(消息或'断言失败:值为None','非None',无)


def断言相等(实际值,期望值,消息=''):
    如果实际值!=期望值:
        抛出断言失败异常(消息或'断言失败:'+字符串(实际值)+'!='+字符串(期望值),期望值,实际值)


def断言不相等(实际值,期望值,消息=''):
    如果实际值==期望值:
        抛出断言失败异常(消息或'断言失败:'+字符串(实际值)+'=='+字符串(期望值),f'不等于{期望值}',实际值)


def断言深相等(实际值,期望值,消息=''):
    导入json
    
    尝试:
        实际JSON=json.转JSON字符串(实际值,排序键=真)
        期望JSON=json.转JSON字符串(期望值,排序键=真)
    除类型错误:
        抛出断言失败异常('断言失败:无法序列化比较')
    
    如果实际JSON!=期望JSON:
        抛出断言失败异常(消息或'断言失败:深度不相等',期望值,实际值)


def断言大于(实际值,期望值,消息=''):
    如果实际值<=期望值:
        抛出断言失败异常(消息或'断言失败:'+字符串(实际值)+'<='+字符串(期望值),'>'+字符串(期望值),实际值)


def断言大于等于(实际值,期望值,消息=''):
    如果实际值<期望值:
        抛出断言失败异常(消息或'断言失败:'+字符串(实际值)+'<'+字符串(期望值),'>='+字符串(期望值),实际值)


def断言小于(实际值,期望值,消息=''):
    如果实际值>=期望值:
        抛出断言失败异常(消息或'断言失败:'+字符串(实际值)+'>='+字符串(期望值),'<'+字符串(期望值),实际值)


def断言小于等于(实际值,期望值,消息=''):
    如果实际值>期望值:
        抛出断言失败异常(消息或'断言失败:'+字符串(实际值)+'>'+字符串(期望值),'<='+字符串(期望值),实际值)


def断言接近(实际值,期望值,公差=0.0001,消息=''):
    如果绝对值(实际值-期望值)>公差:
        抛出断言失败异常(消息或'断言失败:两个值的差超过'+字符串(公差),期望值,实际值)


def断言在范围内(实际值,最小值,最大值,消息=''):
    如果不是(最小值<=实际值<=最大值):
        抛出断言失败异常(消息或'断言失败:'+字符串(实际值)+'不在范围内',f'[{最小值},{最大值}]',实际值)


def断言正数(值,消息=''):
    如果值<=0:
        抛出断言失败异常(消息或'断言失败:'+字符串(值)+'不是正数','正数',值)


def断言负数(值,消息=''):
    如果值>=0:
        抛出断言失败异常(消息或'断言失败:'+字符串(值)+'不是负数','负数',值)


def断言字符串相等(实际值,期望值,忽略大小写=假,消息=''):
    实际=实际值.转小写()如果忽略大小写否则实际值
    期望=期望值.转小写()如果忽略大小写否则期望值
    
    如果实际!=期望:
        抛出断言失败异常(消息或'断言失败:"'+实际值+'"!="'+期望值+'"',期望值,实际值)


def断言包含子串(实际值,子串,忽略大小写=假,消息=''):
    实际=实际值.转小写()如果忽略大小写否则实际值
    子串=子串.转小写()如果忽略大小写否则子串
    
    如果子串不在实际:
        抛出断言失败异常(消息或'断言失败:"'+实际值+'"不包含"'+子串+'"',f'包含"{子串}"',实际值)


def断言不包含子串(实际值,子串,忽略大小写=假,消息=''):
    实际=实际值.转小写()如果忽略大小写否则实际值
    子串=子串.转小写()如果忽略大小写否则子串
    
    如果子串在实际:
        抛出断言失败异常(消息或'断言失败:"'+实际值+'"包含"'+子串+'"',f'不包含"{子串}"',实际值)


def断言以开头(实际值,前缀,忽略大小写=假,消息=''):
    实际=实际值.转小写()如果忽略大小写否则实际值
    前缀=前缀.转小写()如果忽略大小写否则前缀
    
    如果不是实际.以开头(前缀):
        抛出断言失败异常(消息或'断言失败:"'+实际值+'"不以"'+前缀+'"开头',f'以"{前缀}"开头',实际值)


def断言以结尾(实际值,后缀,忽略大小写=假,消息=''):
    实际=实际值.转小写()如果忽略大小写否则实际值
    后缀=后缀.转小写()如果忽略大小写否则后缀
    
    如果不是实际.以结尾(后缀):
        抛出断言失败异常(消息或'断言失败:"'+实际值+'"不以"'+后缀+'"结尾',f'以"{后缀}"结尾',实际值)


def断言匹配正则(实际值,模式,消息=''):
    导入正则
    
    如果不是正则.匹配(模式,实际值):
        抛出断言失败异常(消息或'断言失败:"'+实际值+'"不匹配"'+模式+'"',f'匹配"{模式}"',实际值)


def断言包含(容器,元素,消息=''):
    如果元素不在容器:
        抛出断言失败异常(消息或'断言失败:容器不包含元素',f'包含{元素}',容器)


def断言不包含(容器,元素,消息=''):
    如果元素在容器:
        抛出断言失败异常(消息或'断言失败:容器包含元素',f'不包含{元素}',容器)


def断言长度(序列,期望长度,消息=''):
    实际长度=长度(序列)
    如果实际长度!=期望长度:
        抛出断言失败异常(消息或'断言失败:长度'+字符串(实际长度)+'!='+字符串(期望长度),期望长度,实际长度)


def断言为空(序列,消息=''):
    如果长度(序列)!=0:
        抛出断言失败异常(消息或'断言失败:序列不为空','空序列',序列)


def断言不为空(序列,消息=''):
    如果长度(序列)==0:
        抛出断言失败异常(消息或'断言失败:序列为空','非空序列',[])


def断言子集(实际集合,期望子集,消息=''):
    实际=集合(实际集合)
    期望=集合(期望子集)
    
    如果不是实际.是子集(期望):
        抛出断言失败异常(消息或'断言失败:不是子集',期望,实际)


def断言超集(实际集合,期望超集,消息=''):
    实际=集合(实际集合)
    期望=集合(期望超集)
    
    如果不是实际.是超集(期望):
        抛出断言失败异常(消息或'断言失败:不是超集',期望,实际)


def断言集合相等(实际集合,期望集合,消息=''):
    实际=集合(实际集合)
    期望=集合(期望集合)
    
    如果实际!=期望:
        抛出断言失败异常(消息或'断言失败:集合不相等',期望,实际)


def断言类型(对象,期望类型,消息=''):
    如果不是实例(对象,期望类型):
        抛出断言失败异常(消息或'断言失败:类型不匹配',期望类型.__名称__,类型(对象).__名称__)


def断言可调用(对象,消息=''):
    如果不是可调用(对象):
        抛出断言失败异常(消息或'断言失败:对象不可调用','可调用对象',对象)


def断言抛出异常(函数,异常类型=异常,消息=''):
    尝试:
        函数()
        抛出断言失败异常(消息或'断言失败:未抛出预期异常',f'抛出{异常类型.__名称__}','无异常')
    除异常类型:
        跳过
    除异常(e):
        抛出断言失败异常(消息或'断言失败:抛出了错误的异常类型',异常类型.__名称__,类型(e).__名称__)


def断言不抛出异常(函数,消息=''):
    尝试:
        函数()
    除异常(e):
        抛出断言失败异常(消息或'断言失败:意外抛出异常','无异常',e)


def断言满足条件(值,条件函数,消息=''):
    如果不是条件函数(值):
        抛出断言失败异常(消息或'断言失败:不满足条件','满足条件',值)


def断言所有满足条件(序列,条件函数,消息=''):
    对于元素在序列:
        如果不是条件函数(元素):
            抛出断言失败异常(消息或'断言失败:元素不满足条件','所有元素满足条件',元素)


def断言任一满足条件(序列,条件函数,消息=''):
    如果不是任何(条件函数(元素)对于元素在序列):
        抛出断言失败异常(消息或'断言失败:没有元素满足条件','任一元素满足条件',序列)


def断言属性存在(对象,属性名,消息=''):
    如果不是有属性(对象,属性名):
        抛出断言失败异常(消息或'断言失败:对象没有属性'+属性名,f'存在属性"{属性名}"',对象)


def断言属性值(对象,属性名,期望值,消息=''):
    如果不是有属性(对象,属性名):
        抛出断言失败异常(消息或'断言失败:对象没有属性'+属性名,f'存在属性"{属性名}"',对象)
    
    实际值=_获取属性(对象,属性名)
    如果实际值!=期望值:
        抛出断言失败异常(消息或'断言失败:属性值不匹配',期望值,实际值)


def断言文件存在(路径,消息=''):
    导入os
    
    如果不是os.路径.存在(路径):
        抛出断言失败异常(消息或'断言失败:文件不存在:'+路径,'文件存在',路径)


def断言文件不存在(路径,消息=''):
    导入os
    
    如果os.路径.存在(路径):
        抛出断言失败异常(消息或'断言失败:文件存在:'+路径,'文件不存在',路径)


def必为真(条件,消息=''):
    断言为真(条件,消息)


def必为假(条件,消息=''):
    断言为假(条件,消息)


def必相等(实际值,期望值,消息=''):
    断言相等(实际值,期望值,消息)


def必不相等(实际值,期望值,消息=''):
    断言不相等(实际值,期望值,消息)


def必包含(容器,元素,消息=''):
    断言包含(容器,元素,消息)


def必不包含(容器,元素,消息=''):
    断言不包含(容器,元素,消息)


def必为无(值,消息=''):
    断言为无(值,消息)


def必不为无(值,消息=''):
    断言不为无(值,消息)


def必抛出异常(函数,异常类型=异常,消息=''):
    断言抛出异常(函数,异常类型,消息)


class 链式断言器:
    def初始化(实际值):
        self.实际值=实际值
    
    def为真():
        断言为真(self.实际值)
        return self
    
    def为假():
        断言为假(self.实际值)
        return self
    
    def为无():
        断言为无(self.实际值)
        return self
    
    def不为无():
        断言不为无(self.实际值)
        return self
    
    def等于(期望值):
        断言相等(self.实际值,期望值)
        return self
    
    def不等于(期望值):
        断言不相等(self.实际值,期望值)
        return self
    
    def大于(期望值):
        断言大于(self.实际值,期望值)
        return self
    
    def小于(期望值):
        断言小于(self.实际值,期望值)
        return self
    
    def包含(元素):
        断言包含(self.实际值,元素)
        return self
    
    def不包含(元素):
        断言不包含(self.实际值,元素)
        return self
    
    def长度为(期望长度):
        断言长度(self.实际值,期望长度)
        return self
    
    def为空():
        断言为空(self.实际值)
        return self
    
    def不为空():
        断言不为空(self.实际值)
        return self
    
    def类型为(期望类型):
        断言类型(self.实际值,期望类型)
        return self
    
    def匹配正则(模式):
        断言匹配正则(self.实际值,模式)
        return self


def期望(实际值):
    return链式断言器(实际值)