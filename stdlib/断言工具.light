# 断言工具（纯光明实现）—— 原生腿真实现
#
# 光明实现：基础 / 数值 / 字符串 / 集合 / 类型 / 异常 / 自定义条件 / 对象属性 /
# 文件 断言，外加链式断言器与方法链。
#
# 方言要点（本文件已规避）：
#   - 模块级段落默认参数一律用 ASCII `=`（如 `消息 = ""`）：v3 parser 在模块级
#     默认参数关键字与类方法名 `等于` 共存时会崩；改用 ASCII `=` 后两者可同文件
#     共存，故链式断言器的方法直接命名 `等于`（与同名 .py 对齐），无需动态挂别名。
#   - `hasattr` / `getattr` / `是函数` / `issubclass` 原生腿 codegen 未定义，
#     相关「属性类 / 可调用类 / 子类类」断言只在 Python 转译腿可用；
#     R11A 对拍只触及 比较 / 成员 / 类型 / 真值 断言，不受影响。
#   - 异常基类用「错误」（原生腿与 Python 后端都映射为 Exception）。

从 字符串工具 导入 子串查找。
从 正则表达式 导入 完全匹配。

# ---------------- 异常 ----------------
类 断言失败异常 继承 错误:
  段落 构造(消息 = ""):
    父.构造(消息)

段落 断言失败(消息 = ""):
  如果 消息 == "":
    抛出 新建 断言失败异常("断言失败")
  否则:
    抛出 新建 断言失败异常(消息)

# ---------------- 基本断言 ----------------
段落 断言(条件, 消息 = ""):
  如果 条件 == 假:
    断言失败(消息)

段落 断言为真(条件, 消息 = ""):
  如果 条件 == 假:
    断言失败(消息)

段落 断言为假(条件, 消息 = ""):
  如果 条件 == 真:
    断言失败(消息)

段落 断言为无(值, 消息 = ""):
  如果 是空(值) == 假:
    断言失败(消息)

段落 断言不为无(值, 消息 = ""):
  如果 是空(值) == 真:
    断言失败(消息)

# ---------------- 相等断言 ----------------
段落 断言相等(实际值, 期望值, 消息 = ""):
  如果 实际值 != 期望值:
    断言失败(消息)

段落 断言不相等(实际值, 期望值, 消息 = ""):
  如果 实际值 == 期望值:
    断言失败(消息)

段落 断言浅相等(实际值, 期望值, 消息 = ""):
  如果 实际值 != 期望值:
    断言失败(消息)

段落 断言深相等(实际值, 期望值, 消息 = ""):
  如果 实际值 != 期望值:
    断言失败(消息)

# ---------------- 数值断言 ----------------
段落 断言大于(实际值, 期望值, 消息 = ""):
  如果 实际值 <= 期望值:
    断言失败(消息)

段落 断言大于等于(实际值, 期望值, 消息 = ""):
  如果 实际值 < 期望值:
    断言失败(消息)

段落 断言小于(实际值, 期望值, 消息 = ""):
  如果 实际值 >= 期望值:
    断言失败(消息)

段落 断言小于等于(实际值, 期望值, 消息 = ""):
  如果 实际值 > 期望值:
    断言失败(消息)

段落 断言接近(实际值, 期望值, 容差 = 0.0001, 消息 = ""):
  设 差 为 实际值 减去 期望值
  如果 差 < 0:
    设 差 为 差 乘以 -1
  如果 差 > 容差:
    断言失败(消息)

段落 断言在范围内(值, 最小值, 最大值, 消息 = ""):
  如果 值 < 最小值 或 值 > 最大值:
    断言失败(消息)

段落 断言正数(值, 消息 = ""):
  如果 值 <= 0:
    断言失败(消息)

段落 断言负数(值, 消息 = ""):
  如果 值 >= 0:
    断言失败(消息)

段落 断言零(值, 消息 = ""):
  如果 值 != 0:
    断言失败(消息)

# ---------------- 字符串断言 ----------------
段落 断言字符串相等(实际值, 期望值, 消息 = ""):
  如果 实际值 != 期望值:
    断言失败(消息)

段落 断言包含子串(文本, 子串, 消息 = ""):
  如果 子串查找(文本, 子串) < 0:
    断言失败(消息)

段落 断言不包含子串(文本, 子串, 消息 = ""):
  如果 子串查找(文本, 子串) >= 0:
    断言失败(消息)

段落 断言以开头(文本, 前缀, 消息 = ""):
  如果 文本.开头(前缀) == 假:
    断言失败(消息)

段落 断言以结尾(文本, 后缀, 消息 = ""):
  如果 文本.结尾(后缀) == 假:
    断言失败(消息)

段落 断言为空字符串(文本, 消息 = ""):
  如果 长(文本) != 0:
    断言失败(消息)

段落 断言不为空字符串(文本, 消息 = ""):
  如果 长(文本) == 0:
    断言失败(消息)

段落 断言空白字符串(文本, 消息 = ""):
  如果 长(文本) != 0:
    断言失败(消息)

段落 断言非空白字符串(文本, 消息 = ""):
  如果 长(文本) == 0:
    断言失败(消息)

段落 断言匹配正则(文本, 模式, 消息 = ""):
  如果 完全匹配(模式, 文本) == 假:
    断言失败(消息)

# ---------------- 集合/容器断言 ----------------
段落 断言包含(容器, 元素, 消息 = ""):
  如果 容器.包含(元素) == 假:
    断言失败(消息)

段落 断言不包含(容器, 元素, 消息 = ""):
  如果 容器.包含(元素) == 真:
    断言失败(消息)

段落 断言长度(容器, 期望长度, 消息 = ""):
  如果 长(容器) != 期望长度:
    断言失败(消息)

段落 断言为空(容器, 消息 = ""):
  如果 长(容器) != 0:
    断言失败(消息)

段落 断言不为空(容器, 消息 = ""):
  如果 长(容器) == 0:
    断言失败(消息)

段落 断言子集(子集, 超集, 消息 = ""):
  设 全包含 为 真
  设 i 为 0
  当 i < 长(子集):
    如果 超集.包含(子集[i]) == 假:
      设 全包含 为 假
    设 i 为 i 加上 1
  如果 全包含 == 假:
    断言失败(消息)

段落 断言超集(超集, 子集, 消息 = ""):
  断言子集(子集, 超集, 消息)

段落 断言集合相等(集合1, 集合2, 消息 = ""):
  如果 长(集合1) != 长(集合2):
    断言失败(消息)
  断言子集(集合1, 集合2, 消息)

段落 断言交集非空(集合1, 集合2, 消息 = ""):
  设 有交 为 假
  设 i 为 0
  当 i < 长(集合1):
    如果 集合2.包含(集合1[i]) == 真:
      设 有交 为 真
    设 i 为 i 加上 1
  如果 有交 == 假:
    断言失败(消息)

段落 断言无交集(集合1, 集合2, 消息 = ""):
  设 有交 为 假
  设 i 为 0
  当 i < 长(集合1):
    如果 集合2.包含(集合1[i]) == 真:
      设 有交 为 真
    设 i 为 i 加上 1
  如果 有交 == 真:
    断言失败(消息)

# ---------------- 类型断言 ----------------
段落 断言类型(值, 期望类型, 消息 = ""):
  如果 类型(值) != 期望类型:
    断言失败(消息)

段落 断言实例(值, 期望类型, 消息 = ""):
  如果 isinstance(值, 期望类型) == 假:
    断言失败(消息)

# 原生腿 codegen 无 issubclass 内建（emit 全模块时该调用即 NotImplementedError），
# 故 断言子类 降级为「直接判失败」——与 C 轨前阴影版本一致，保证整文件原生可编译。
段落 断言子类(子类, 父类, 消息 = ""):
  断言失败(消息)

# 原生腿 codegen 无 是函数/callable 内建，断言可调用 同样降级为「直接判失败」。
段落 断言可调用(值, 消息 = ""):
  断言失败(消息)

# ---------------- 异常断言（原生腿受限：函数值作参数调用未定义，降级）----------------
# 原生腿 codegen 不支持「把段落当作值传入再调用」（`目标()`/`条件函数(值)` 会报
# 未定义段落），且原生编译会 emit 全模块的所有段落。故以下 3 段保留导出名但
# 降级为「直接判失败」，真实语义见同名 stdlib/断言工具.py。
段落 断言抛出异常(目标, 异常类型 = Exception, 消息 = ""):
  断言失败(消息)

段落 断言不抛出异常(目标, 消息 = ""):
  断言失败(消息)

段落 断言抛出特定异常(目标, 异常类型, 异常消息, 消息 = ""):
  断言失败(消息)

# ---------------- 自定义条件断言（同上：条件函数为函数值，降级）----------------
段落 断言满足条件(值, 条件函数, 消息 = ""):
  断言失败(消息)

段落 断言所有满足条件(序列, 条件函数, 消息 = ""):
  断言失败(消息)

段落 断言任一满足条件(序列, 条件函数, 消息 = ""):
  断言失败(消息)

# ---------------- 对象属性断言（原生腿受限：hasattr/getattr 未定义，降级）----------------
# 原生腿 codegen 无 hasattr/getattr 内建，且原生编译会 emit 全模块的所有段落，
# 一旦函数体出现这两个名字，整份 断言工具.light 立即不可编译（R11A 对拍红）。
# 故这里保留导出名但降级为「直接判失败」——原生可编译优先；真实属性断言语义
# 见同名 stdlib/断言工具.py（hook 未装载本魔数时由它接管）。
段落 断言属性存在(对象, 属性名, 消息 = ""):
  断言失败(消息)

段落 断言属性不存在(对象, 属性名, 消息 = ""):
  断言失败(消息)

段落 断言属性值(对象, 属性名, 期望值, 消息 = ""):
  断言失败(消息)

# ---------------- 文件断言 ----------------
段落 断言文件存在(路径, 消息 = ""):
  如果 文件存在(路径) == 假:
    断言失败(消息)

段落 断言文件不存在(路径, 消息 = ""):
  如果 文件存在(路径):
    断言失败(消息)

段落 断言目录存在(路径, 消息 = ""):
  如果 目录存在(路径) == 假:
    断言失败(消息)

段落 断言目录不存在(路径, 消息 = ""):
  如果 目录存在(路径):
    断言失败(消息)

# ---------------- 链式断言器 ----------------
类 链式断言器:
  段落 构造(实际值):
    己.实际值 为 实际值
  段落 为真:
    断言为真(己.实际值)
    返回 己
  段落 为假:
    断言为假(己.实际值)
    返回 己
  段落 为无:
    断言为无(己.实际值)
    返回 己
  段落 不为无:
    断言不为无(己.实际值)
    返回 己
  段落 等于(期望值):
    断言相等(己.实际值, 期望值)
    返回 己
  段落 不等于(期望值):
    断言不相等(己.实际值, 期望值)
    返回 己
  段落 大于(期望值):
    断言大于(己.实际值, 期望值)
    返回 己
  段落 小于(期望值):
    断言小于(己.实际值, 期望值)
    返回 己
  段落 包含(元素):
    断言包含(己.实际值, 元素)
    返回 己
  段落 不包含(元素):
    断言不包含(己.实际值, 元素)
    返回 己
  段落 长度为(期望长度):
    断言长度(己.实际值, 期望长度)
    返回 己
  段落 为空:
    断言为空(己.实际值)
    返回 己
  段落 不为空:
    断言不为空(己.实际值)
    返回 己
  段落 类型为(期望类型):
    断言类型(己.实际值, 期望类型)
    返回 己
  段落 匹配正则(模式):
    断言匹配正则(己.实际值, 模式)
    返回 己

段落 期望(实际值):
  返回 新建 链式断言器(实际值)

# ---------------- 必为系列（简写，等价于对应断言）----------------
段落 必为真(条件, 消息 = ""):
  断言为真(条件, 消息)

段落 必为假(条件, 消息 = ""):
  断言为假(条件, 消息)

段落 必相等(实际值, 期望值, 消息 = ""):
  断言相等(实际值, 期望值, 消息)

段落 必不相等(实际值, 期望值, 消息 = ""):
  断言不相等(实际值, 期望值, 消息)

段落 必包含(容器, 元素, 消息 = ""):
  断言包含(容器, 元素, 消息)

段落 必不包含(容器, 元素, 消息 = ""):
  断言不包含(容器, 元素, 消息)

段落 必为无(值, 消息 = ""):
  断言为无(值, 消息)

段落 必不为无(值, 消息 = ""):
  断言不为无(值, 消息)

段落 必抛出异常(目标, 异常类型 = Exception, 消息 = ""):
  断言失败(消息)

# ---------------- 测试框架计数函数（降级 docs）----------------
段落 测试开始(名称 = ""):
  返回 0

段落 测试结束(名称 = ""):
  返回 0

段落 测试运行(名称 = ""):
  返回 0

导出 断言 断言为真 断言为假 断言为无 断言不为无 断言相等 断言不相等 断言浅相等 断言深相等。
导出 断言大于 断言大于等于 断言小于 断言小于等于 断言接近 断言在范围内 断言正数 断言负数 断言零。
导出 断言字符串相等 断言包含子串 断言不包含子串 断言以开头 断言以结尾 断言为空字符串 断言不为空字符串 断言空白字符串 断言非空白字符串 断言匹配正则。
导出 断言包含 断言不包含 断言长度 断言为空 断言不为空 断言子集 断言超集 断言集合相等 断言交集非空 断言无交集。
导出 断言类型 断言实例 断言子类 断言可调用。
导出 断言抛出异常 断言不抛出异常 断言抛出特定异常。
导出 断言满足条件 断言所有满足条件 断言任一满足条件。
导出 断言属性存在 断言属性不存在 断言属性值。
导出 断言文件存在 断言文件不存在 断言目录存在 断言目录不存在。
导出 必为真 必为假 必相等 必不相等 必包含 必不包含 必为无 必不为无 必抛出异常。
导出 链式断言器 期望 断言失败异常。
导出 测试开始 测试结束 测试运行。