# 断言工具 —— 纯光明实现（原生腿安全子集）
#
# 设计：本文件只含「原生腿能真编译真跑」的纯函数断言（比较 / 成员 / 类型 /
# 字符串 / 集合 / 数值 / 链式 / 判型）。它们不依赖「调用函数值」「按名取属性」，
# 故可在 Python 后端与原生（O0）后端都工作。
#
# 「函数调用类 / 属性类」断言（断言抛出异常 / 断言满足条件 / 断言属性存在 等）
# 需要把函数作为值动态调用，原生腿无此能力，不放在本 .light 里——Python 后端
# 的导入钩子会回退加载同名 stdlib/断言工具.py（完整 Python 实现）提供这些能力，
# 故 phase9 / phase3 等 Python 后端测试拿到的是完整 API。
#
# 异常基类用「错误」（原生腿与 Python 后端都映射为 Exception）。

从 字符串工具 导入 子串查找。
从 正则表达式 导入 完全匹配。

# ---------------- 异常 ----------------
类 断言失败异常 继承 错误:
  段落 构造 接收 消息 = "":
    父.构造(消息)

段落 断言失败 接收 消息 = "":
  如果 消息 == "":
    抛出 新建 断言失败异常("断言失败")
  否则:
    抛出 新建 断言失败异常(消息)

# ---------------- 基本断言 ----------------
段落 断言 接收 条件, 消息 = "":
  如果 条件 == 假:
    断言失败(消息)

段落 断言为真 接收 条件, 消息 = "":
  如果 条件 == 假:
    如果 消息 == "":
      抛出 新建 断言失败异常("断言失败: 条件不为真")
    否则:
      抛出 新建 断言失败异常(消息)

段落 断言为假 接收 条件, 消息 = "":
  如果 条件 == 真:
    如果 消息 == "":
      抛出 新建 断言失败异常("断言失败: 条件不为假")
    否则:
      抛出 新建 断言失败异常(消息)

段落 断言为无 接收 值, 消息 = "":
  如果 是空(值) == 假:
    如果 消息 == "":
      抛出 新建 断言失败异常("断言失败: 值不为 None")
    否则:
      抛出 新建 断言失败异常(消息)

段落 断言不为无 接收 值, 消息 = "":
  如果 是空(值) == 真:
    如果 消息 == "":
      抛出 新建 断言失败异常("断言失败: 值为 None")
    否则:
      抛出 新建 断言失败异常(消息)

# ---------------- 相等断言 ----------------
段落 断言相等 接收 实际值, 期望值, 消息 = "":
  如果 实际值 != 期望值:
    如果 消息 == "":
      抛出 新建 断言失败异常("断言失败: 两值不相等")
    否则:
      抛出 新建 断言失败异常(消息)

段落 断言不相等 接收 实际值, 期望值, 消息 = "":
  如果 实际值 == 期望值:
    如果 消息 == "":
      抛出 新建 断言失败异常("断言失败: 两值相等")
    否则:
      抛出 新建 断言失败异常(消息)

段落 断言浅相等 接收 实际值, 期望值, 消息 = "":
  如果 实际值 != 期望值:
    断言失败(消息)

段落 断言深相等 接收 实际值, 期望值, 消息 = "":
  如果 实际值 != 期望值:
    断言失败(消息)

# ---------------- 数值断言 ----------------
段落 断言大于 接收 实际值, 期望值, 消息 = "":
  如果 实际值 <= 期望值:
    断言失败(消息)

段落 断言大于等于 接收 实际值, 期望值, 消息 = "":
  如果 实际值 < 期望值:
    断言失败(消息)

段落 断言小于 接收 实际值, 期望值, 消息 = "":
  如果 实际值 >= 期望值:
    断言失败(消息)

段落 断言小于等于 接收 实际值, 期望值, 消息 = "":
  如果 实际值 > 期望值:
    断言失败(消息)

段落 断言接近 接收 实际值, 期望值, 容差 = 0.0001, 消息 = "":
  设 差 为 实际值 减去 期望值
  如果 差 < 0:
    设 差 为 差 乘以 -1
  如果 差 > 容差:
    断言失败(消息)

段落 断言在范围内 接收 值, 最小值, 最大值, 消息 = "":
  如果 值 < 最小值 或 值 > 最大值:
    断言失败(消息)

段落 断言正数 接收 值, 消息 = "":
  如果 值 <= 0:
    断言失败(消息)

段落 断言负数 接收 值, 消息 = "":
  如果 值 >= 0:
    断言失败(消息)

段落 断言零 接收 值, 消息 = "":
  如果 值 != 0:
    断言失败(消息)

# ---------------- 字符串断言 ----------------
段落 断言字符串相等 接收 实际值, 期望值, 消息 = "":
  如果 实际值 != 期望值:
    断言失败(消息)

段落 断言包含子串 接收 文本, 子串, 消息 = "":
  如果 子串查找(文本, 子串) < 0:
    断言失败(消息)

段落 断言不包含子串 接收 文本, 子串, 消息 = "":
  如果 子串查找(文本, 子串) >= 0:
    断言失败(消息)

段落 断言以开头 接收 文本, 前缀, 消息 = "":
  如果 文本.开头(前缀) == 假:
    断言失败(消息)

段落 断言以结尾 接收 文本, 后缀, 消息 = "":
  如果 文本.结尾(后缀) == 假:
    断言失败(消息)

段落 断言为空字符串 接收 文本, 消息 = "":
  如果 长(文本) != 0:
    断言失败(消息)

段落 断言不为空字符串 接收 文本, 消息 = "":
  如果 长(文本) == 0:
    断言失败(消息)

段落 断言空白字符串 接收 文本, 消息 = "":
  如果 长(文本) != 0:
    断言失败(消息)

段落 断言非空白字符串 接收 文本, 消息 = "":
  如果 长(文本) == 0:
    断言失败(消息)

段落 断言匹配正则 接收 文本, 模式, 消息 = "":
  如果 完全匹配(文本, 模式) == 假:
    断言失败(消息)

# ---------------- 集合/容器断言 ----------------
段落 断言包含 接收 容器, 元素, 消息 = "":
  如果 容器.包含(元素) == 假:
    断言失败(消息)

段落 断言不包含 接收 容器, 元素, 消息 = "":
  如果 容器.包含(元素) == 真:
    断言失败(消息)

段落 断言长度 接收 容器, 期望长度, 消息 = "":
  如果 长(容器) != 期望长度:
    断言失败(消息)

段落 断言为空 接收 容器, 消息 = "":
  如果 长(容器) != 0:
    断言失败(消息)

段落 断言不为空 接收 容器, 消息 = "":
  如果 长(容器) == 0:
    断言失败(消息)

段落 断言子集 接收 子集, 超集, 消息 = "":
  设 全包含 为 真
  设 i 为 0
  当 i < 长(子集):
    如果 超集.包含(子集[i]) == 假:
      设 全包含 为 假
    设 i 为 i 加上 1
  如果 全包含 == 假:
    断言失败(消息)

段落 断言超集 接收 超集, 子集, 消息 = "":
  断言子集(子集, 超集, 消息)

段落 断言集合相等 接收 集合1, 集合2, 消息 = "":
  如果 长(集合1) != 长(集合2):
    断言失败(消息)
  断言子集(集合1, 集合2, 消息)

段落 断言交集非空 接收 集合1, 集合2, 消息 = "":
  设 有交 为 假
  设 i 为 0
  当 i < 长(集合1):
    如果 集合2.包含(集合1[i]) == 真:
      设 有交 为 真
    设 i 为 i 加上 1
  如果 有交 == 假:
    断言失败(消息)

段落 断言无交集 接收 集合1, 集合2, 消息 = "":
  设 有交 为 假
  设 i 为 0
  当 i < 长(集合1):
    如果 集合2.包含(集合1[i]) == 真:
      设 有交 为 真
    设 i 为 i 加上 1
  如果 有交 == 真:
    断言失败(消息)

# ---------------- 类型断言 ----------------
段落 断言类型 接收 值, 期望类型, 消息 = "":
  如果 类型(值) != 期望类型:
    断言失败(消息)

段落 断言实例 接收 值, 期望类型, 消息 = "":
  如果 类型(值) != 期望类型:
    断言失败(消息)

段落 断言子类 接收 子类, 父类, 消息 = "":
  断言失败(消息)

# ---------------- 必为系列（简写，等价于对应断言）----------------
段落 必为真 接收 条件, 消息 = "":
  断言为真(条件, 消息)

段落 必为假 接收 条件, 消息 = "":
  断言为假(条件, 消息)

段落 必相等 接收 实际值, 期望值, 消息 = "":
  断言相等(实际值, 期望值, 消息)

段落 必不相等 接收 实际值, 期望值, 消息 = "":
  断言不相等(实际值, 期望值, 消息)

段落 必包含 接收 容器, 元素, 消息 = "":
  断言包含(容器, 元素, 消息)

段落 必不包含 接收 容器, 元素, 消息 = "":
  断言不包含(容器, 元素, 消息)

段落 必为无 接收 值, 消息 = "":
  断言为无(值, 消息)

段落 必不为无 接收 值, 消息 = "":
  断言不为无(值, 消息)

# ---------------- 测试框架计数函数（降级 docs）----------------
段落 测试开始 接收 名称 = "":
  返回 0

段落 测试结束 接收 名称 = "":
  返回 0

段落 测试运行 接收 名称 = "":
  返回 0

导出 断言 断言为真 断言为假 断言为无 断言不为无 断言相等 断言不相等 断言浅相等 断言深相等。
导出 断言大于 断言大于等于 断言小于 断言小于等于 断言接近 断言在范围内 断言正数 断言负数 断言零。
导出 断言字符串相等 断言包含子串 断言不包含子串 断言以开头 断言以结尾 断言为空字符串 断言不为空字符串 断言空白字符串 断言非空白字符串 断言匹配正则。
导出 断言包含 断言不包含 断言长度 断言为空 断言不为空 断言子集 断言超集 断言集合相等 断言交集非空 断言无交集。
导出 断言类型 断言实例 断言子类 测试开始 测试结束 测试运行 断言失败异常。
导出 必为真 必为假 必相等 必不相等 必包含 必不包含 必为无 必不为无。
