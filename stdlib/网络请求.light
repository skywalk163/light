# 纯光明实现 —— stdlib/网络请求.py 的原生腿实现
#
# 基于 runtime B1 Socket + B2-4 TLS 符号实现 HTTP/1.1 客户端。
# 不依赖 requests/urllib，纯光明 socket/tls 调用。
#
# R13B 能力扩展（详见 docs/known_issues.md R13B 章节）：
#   1. HTTPS：接入 runtime TLS 后端（Windows Schannel / POSIX mbedTLS，T7），
#      https:// URL 走 TLS 握手 + 加密读写，证书校验默认开启。
#   2. POST：支持 POST/PUT/DELETE + 请求体（application/x-www-form-urlencoded）。
#   3. 重定向：301/302/303/307/308 自动跟随，最大跳转次数可配置（默认 5），
#      303 改写为 GET 并清空请求体；响应携带 最终URL 字段。
#   4. chunked：Transfer-Encoding: chunked 响应体解析。
#   5. 超时：握手/读取超时（基于 runtime poller 等待，秒为单位）。
#   6. URL 解码：%XX 十六进制解码（ASCII 范围），与 .py unquote 对齐。
#
# 能力边界（保留）：
#   1. 非 ASCII URL 编码仍为 %3F 占位；解码仅还原 ASCII 的 %XX 序列。
#   2. multipart/form-data、JSON 自动序列化（发送JSON）不支持，JSON 体可传字符串。
#   3. HTTP/2、Cookie 管理、代理不支持。
#   4. 连接阶段依赖系统阻塞 connect（握手/读取阶段有 poller 超时保护）。
#   5. 解析URL 对 https 无端口 URL 返回 443（.py 因 `port or 80` 口径返回 80，
#      属 .py 缺陷，以本实现为准，对拍用 http URL）。
#
# 注：「关闭/接收/创建」等为光明保留字，socket/tls/poller 内建调用统一使用
# 英文别名（关闭socket → socket_close、接收tls → tls_recv 等）。
#
# 导出与 .py 主要函数对齐：获取 POST PUT 删除 发起请求 解析URL 编码URL 解码URL
#                          响应文本 响应成功 响应状态码 获取响应头

导出 获取 POST PUT 删除 发起请求 解析URL 编码URL 解码URL 响应文本 响应成功 响应状态码 获取响应头 响应 请求错误 HTTP错误 超时错误 连接错误 拼接URL 解析查询串。

# JSON 解析复用纯光明 JSON核心（顶层导入）：
# 原「响应.JSON」方法体内函数级导入（从 JSON核心 导入 解析）是全 stdlib 唯一的
# 函数级导入先例，native 后端 _gen_statement 对方法内 ImportStatement 不绑定名字
# （codegen_typed.py 直接 pass），导致 import 网络请求 即整模块编译失败
# （「未定义的段落：解析」，R11C/R13B 网络对拍全红的根因）。提到模块级后走
# 既有跨模块导入路径（与 JSON.light 等模块一致），.py 后端口径不变。
从 JSON核心 导入 解析。

# ── URL 解析 ───────────────────────────────────────────────────────────────
# 解析 URL 为 [协议, 主机, 端口, 路径, 查询, 片段]
段落 解析URL 接收 url:
  设 协议 为 "http"
  设 剩余 为 url
  # 检测 ://
  设 冒号位置 为 查找子串(url, "://")
  如果 冒号位置 >= 0:
    设 协议 为 截取子串(url, 0, 冒号位置)
    设 剩余 为 截取子串(url, 冒号位置 加上 3, 长(url))
  # 分离片段（# 后）
  设 片段 为 ""
  设 井号 为 查找子串(剩余, "#")
  如果 井号 >= 0:
    设 片段 为 截取子串(剩余, 井号 加上 1, 长(剩余))
    设 剩余 为 截取子串(剩余, 0, 井号)
  # 分离主机和路径
  设 斜杠位置 为 查找子串(剩余, "/")
  设 主机端口 为 剩余
  设 路径查询 为 "/"
  如果 斜杠位置 >= 0:
    设 主机端口 为 截取子串(剩余, 0, 斜杠位置)
    设 路径查询 为 截取子串(剩余, 斜杠位置, 长(剩余))
  否则:
    设 路径查询 为 "/"
  # 分离端口（https 默认 443，http 默认 80）
  设 主机 为 主机端口
  设 端口 为 80
  如果 协议 == "https":
    设 端口 为 443
  设 冒号2 为 查找子串(主机端口, ":")
  如果 冒号2 >= 0:
    设 主机 为 截取子串(主机端口, 0, 冒号2)
    设 端口串 为 截取子串(主机端口, 冒号2 加上 1, 长(主机端口))
    设 端口 为 字符串转整数(端口串)
  # 分离路径和查询
  设 路径 为 路径查询
  设 查询 为 ""
  设 问号位置 为 查找子串(路径查询, "?")
  如果 问号位置 >= 0:
    设 路径 为 截取子串(路径查询, 0, 问号位置)
    设 查询 为 截取子串(路径查询, 问号位置 加上 1, 长(路径查询))
  返回 ["协议": 协议, "主机": 主机, "端口": 端口, "路径": 路径, "查询": 查询, "片段": 片段]

# ── 字符串工具 ─────────────────────────────────────────────────────────────

段落 查找子串 接收 串, 子串:
  返回 查找子串自(串, 子串, 0)

# 带起点的子串查找
段落 查找子串自 接收 串, 子串, 起点:
  设 串长 为 长(串)
  设 子长 为 长(子串)
  如果 子长 == 0:
    返回 起点
  如果 子长 > 串长:
    返回 0 减 1
  设 i 为 起点
  当 i <= 串长 减 子长:
    设 匹配 为 真
    设 j 为 0
    当 j < 子长:
      如果 串[i 加上 j] != 子串[j]:
        设 匹配 为 假
        设 j 为 子长
      设 j 为 j 加上 1
    如果 匹配:
      返回 i
    设 i 为 i 加上 1
  返回 0 减 1

段落 截取子串 接收 串, 开始, 结束:
  设 结果 为 ""
  设 i 为 开始
  当 i < 结束 且 i < 长(串):
    设 结果 为 结果 加上 串[i]
    设 i 为 i 加上 1
  返回 结果

# ASCII 大写转小写（响应头键名归一用）
段落 转小写ASCII 接收 串:
  设 结果 为 ""
  设 i 为 0
  当 i < 长(串):
    设 c 为 串[i]
    如果 c >= "A" 且 c <= "Z":
      设 结果 为 结果 加上 字符自码位(码位(c) 加上 32)
    否则:
      设 结果 为 结果 加上 c
    设 i 为 i 加上 1
  返回 结果

段落 字符串转整数 接收 串:
  设 结果 为 0
  设 i 为 0
  当 i < 长(串):
    设 c 为 串[i]
    如果 c >= "0" 且 c <= "9":
      设 结果 为 结果 乘 10 加上 十六进制值(c)
    设 i 为 i 加上 1
  返回 结果

# 单字符十六进制值（'0'-'9' 'a'-'f' 'A'-'F'，其余 0）
段落 十六进制值 接收 字符:
  如果 字符 >= "0" 且 字符 <= "9":
    返回 码位(字符) 减 48
  如果 字符 >= "a" 且 字符 <= "f":
    返回 码位(字符) 减 87
  如果 字符 >= "A" 且 字符 <= "F":
    返回 码位(字符) 减 55
  返回 0

# 十六进制串转整数（chunked 长度行用）
段落 十六进制转整数 接收 串:
  设 结果 为 0
  设 i 为 0
  当 i < 长(串):
    设 结果 为 结果 乘 16 加上 十六进制值(串[i])
    设 i 为 i 加上 1
  返回 结果

# ── URL 编码/解码 ──────────────────────────────────────────────────────────

段落 编码URL 接收 文本:
  设 结果 为 ""
  设 i 为 0
  当 i < 长(文本):
    设 c 为 文本[i]
    如果 (c >= "a" 且 c <= "z") 或 (c >= "A" 且 c <= "Z") 或 (c >= "0" 且 c <= "9") 或 c == "-" 或 c == "_" 或 c == "." 或 c == "~":
      设 结果 为 结果 加上 c
    否则:
      # 非 ASCII 字符：原生腿无法获取 Unicode 码点，用 %3F 占位
      设 结果 为 结果 加上 "%3F"
    设 i 为 i 加上 1
  返回 结果

# 解码：%XX（ASCII 范围）还原为字符；+ 不转空格（与 .py unquote 口径一致）；
# 多字节 UTF-8 序列原样保留
段落 解码URL 接收 编码文本:
  设 结果 为 ""
  设 i 为 0
  设 n 为 长(编码文本)
  当 i < n:
    如果 编码文本[i] == "%":
      如果 i 加上 2 < n:
        设 高 为 十六进制值(编码文本[i 加上 1])
        设 低 为 十六进制值(编码文本[i 加上 2])
        设 值 为 高 乘 16 加上 低
        如果 (高 > 0 或 低 > 0) 且 值 < 128:
          设 结果 为 结果 加上 字符自码位(值)
        否则:
          设 结果 为 结果 加上 截取子串(编码文本, i, i 加上 3)
        设 i 为 i 加上 3
      否则:
        设 i 为 n
    否则:
      设 结果 为 结果 加上 编码文本[i]
      设 i 为 i 加上 1
  返回 结果

# ── 便捷函数 ───────────────────────────────────────────────────────────────

段落 获取 接收 url, 头部 = 空, 超时 = 30:
  返回 发起请求(url, "GET", 头部, 空, 超时)

段落 POST 接收 url, 数据 = 空, 头部 = 空, 超时 = 30:
  返回 发起请求(url, "POST", 头部, 数据, 超时)

段落 PUT 接收 url, 数据 = 空, 头部 = 空, 超时 = 30:
  返回 发起请求(url, "PUT", 头部, 数据, 超时)

段落 删除 接收 url, 头部 = 空, 超时 = 30:
  返回 发起请求(url, "DELETE", 头部, 空, 超时)

# ── 发起请求（重定向跟随入口） ─────────────────────────────────────────────

段落 发起请求 接收 url, 方法 = "GET", 头部 = 空, 数据 = 空, 超时 = 30, 最大重定向 = 5:
  设 当前URL 为 url
  设 当前方法 为 方法
  设 当前数据 为 数据
  设 跳转 为 0
  当 真:
    设 响应 为 单次请求(当前URL, 当前方法, 头部, 当前数据, 超时)
    设 码 为 响应["状态码"]
    如果 (码 == 301 或 码 == 302 或 码 == 303 或 码 == 307 或 码 == 308) 且 跳转 < 最大重定向:
      设 位置 为 响应头值(响应, "location")
      如果 位置 == "":
        返回 响应
      # 303 语义：改写为 GET 并清空请求体
      如果 码 == 303:
        设 当前方法 为 "GET"
        设 当前数据 为 空
      设 当前URL 为 合并URL(当前URL, 位置)
      设 跳转 为 跳转 加上 1
    否则:
      字典设置(响应, "最终URL", 当前URL)
      返回 响应

# 单次 HTTP/HTTPS 请求（不含重定向）
段落 单次请求 接收 url, 方法, 头部, 数据, 超时:
  设 解析 为 解析URL(url)
  # 字典值需拷贝成独立字符串/整数（字典获取返回内部引用，直接传
  # C 内建会把引用结构体误当字符串指针，导致「无法解析主机」）
  设 协议 为 解析["协议"] 加上 ""
  设 主机名 为 解析["主机"] 加上 ""
  设 端口号 为 解析["端口"] 加 0
  如果 协议 != "http" 且 协议 != "https":
    返回 错误响应(0, "不支持的协议: " 加上 协议)
  如果 主机名 == "":
    返回 错误响应(0, "URL 缺少主机名")
  # 创建 socket（AF_INET=2, SOCK_STREAM=1）
  设 fd 为 socket_create(2, 1)
  如果 fd < 0:
    返回 错误响应(0, "socket 创建失败")
  # 连接
  设 连接结果 为 socket_connect(fd, 主机名, 端口号)
  如果 连接结果 < 0:
    设 错误信息 为 socket_last_error()
    socket_close(fd)
    返回 错误响应(0, 错误信息)
  # poller 用于 TLS 握手与读取阶段的超时保护（DV_POLL_READ=1）
  设 p 为 poller_create()
  poller_register(p, fd, 1)
  设 是TLS 为 假
  # HTTPS：TLS 握手（Windows Schannel / POSIX mbedTLS，T7）
  如果 协议 == "https":
    设 t 为 tls_wrap(fd, 主机名)
    设 握手失败 为 ""
    当 真:
      设 r 为 tls_handshake(t)
      如果 r == 0:
        跳出
      如果 r < 0:
        设 握手失败 为 tls_last_error()
        跳出
      # r==1 WANT_READ / r==2 WANT_WRITE：等待 fd 就绪，超时中断
      设 就绪 为 poller_wait(p, 超时 乘 1000)
      如果 就绪 <= 0:
        设 握手失败 为 "TLS 握手超时"
        跳出
    如果 握手失败 != "":
      tls_free(t)
      socket_close(fd)
      poller_destroy(p)
      返回 错误响应(0, 握手失败)
    设 是TLS 为 真
  # 构建请求
  设 请求路径 为 解析["路径"] 加上 ""
  设 查询串 为 解析["查询"] 加上 ""
  如果 查询串 != "":
    设 请求路径 为 请求路径 加上 "?" 加上 查询串
  设 主机头 为 解析["主机"]
  如果 (协议 == "http" 且 端口号 != 80) 或 (协议 == "https" 且 端口号 != 443):
    设 主机头 为 主机头 加上 ":" 加上 转字符串(端口号)
  设 请求 为 方法 加上 " " 加上 请求路径 加上 " HTTP/1.1\r\nHost: " 加上 主机头 加上 "\r\nUser-Agent: DuanLang-Native-HTTP/1.1\r\nAccept: */*\r\nConnection: close\r\n"
  # 自定义头部
  如果 头部 不等于 空:
    设 键表 为 字典键列表(头部)
    设 i 为 0
    当 i < 长(键表):
      设 请求 为 请求 加上 键表[i] 加上 ": " 加上 头部[键表[i]] 加上 "\r\n"
      设 i 为 i 加上 1
  # 请求体（表单编码；已自定义 Content-Type 时不覆盖）
  设 体 为 ""
  如果 数据 不等于 空:
    设 体 为 数据
    如果 体 != "":
      设 有类型头 为 假
      如果 头部 不等于 空:
        设 已有类型 为 字典获取(头部, "Content-Type")
        如果 已有类型 不等于 空:
          设 有类型头 为 真
      如果 有类型头 等于 假:
        设 请求 为 请求 加上 "Content-Type: application/x-www-form-urlencoded\r\n"
      设 请求 为 请求 加上 "Content-Length: " 加上 转字符串(长(体)) 加上 "\r\n"
  设 请求 为 请求 加上 "\r\n"
  如果 体 != "":
    设 请求 为 请求 加上 体
  # 发送（循环直到全部发出）
  设 已发 为 0
  设 总长 为 长(请求)
  当 已发 < 总长:
    设 剩余 为 截取子串(请求, 已发, 总长)
    设 n 为 0 减 1
    如果 是TLS:
      设 n 为 tls_send(t, 剩余)
    否则:
      设 n 为 socket_send(fd, 剩余)
    如果 n <= 0:
      如果 是TLS:
        tls_free(t)
      socket_close(fd)
      poller_destroy(p)
      返回 错误响应(0, "发送失败")
    设 已发 为 已发 加上 n
  # 接收（poller 超时保护，直到连接关闭）
  设 响应内容 为 ""
  设 接收失败 为 ""
  当 真:
    设 就绪 为 poller_wait(p, 超时 乘 1000)
    如果 就绪 <= 0:
      设 接收失败 为 "读取超时"
      跳出
    如果 是TLS:
      设 块 为 tls_recv(t, 65536)
      设 状态 为 tls_recv_status(t)
      如果 长(块) > 0:
        设 响应内容 为 响应内容 加上 块
      # 0=有数据继续 / -2=对端关闭 / -1=错误
      如果 状态 == -2 或 状态 == -1:
        跳出
    否则:
      设 块 为 socket_recv(fd, 65536)
      如果 长(块) == 0:
        跳出
      设 响应内容 为 响应内容 加上 块
  # 清理
  如果 是TLS:
    tls_free(t)
  socket_close(fd)
  poller_destroy(p)
  如果 接收失败 != "" 且 响应内容 == "":
    返回 错误响应(0, 接收失败)
  # 解析响应
  返回 解析HTTP响应(响应内容)

段落 错误响应 接收 码, 信息:
  返回 ["状态码": 码, "头部": 新建字典(), "内容": "", "错误": 信息]

# ── 相对 Location 合并 ─────────────────────────────────────────────────────

段落 合并URL 接收 基础, 位置:
  # 绝对地址
  如果 查找子串(位置, "://") >= 0:
    返回 位置
  设 解析 为 解析URL(基础)
  设 前缀 为 解析["协议"] 加上 "://" 加上 解析["主机"]
  如果 (解析["协议"] == "http" 且 解析["端口"] != 80) 或 (解析["协议"] == "https" 且 解析["端口"] != 443):
    设 前缀 为 前缀 加上 ":" 加上 转字符串(解析["端口"])
  # 根相对
  如果 截取子串(位置, 0, 1) == "/":
    返回 前缀 加上 位置
  # 相对当前目录：取基础路径到最后一个 / 为止
  设 路径 为 解析["路径"]
  设 目录 为 "/"
  设 i 为 0
  设 最后斜杠 为 0 减 1
  当 i < 长(路径):
    如果 路径[i] == "/":
      设 最后斜杠 为 i
    设 i 为 i 加上 1
  如果 最后斜杠 >= 0:
    设 目录 为 截取子串(路径, 0, 最后斜杠 加上 1)
  返回 前缀 加上 目录 加上 位置

# ── HTTP 响应解析 ─────────────────────────────────────────────────────────

段落 解析HTTP响应 接收 原始响应:
  # 分离响应头和体（空行分隔）
  设 空行位置 为 查找子串(原始响应, "\r\n\r\n")
  如果 空行位置 < 0:
    设 空行位置 为 查找子串(原始响应, "\n\n")
    如果 空行位置 < 0:
      返回 错误响应(0, "无法解析响应")
    设 头部分 为 截取子串(原始响应, 0, 空行位置)
    设 体 为 截取子串(原始响应, 空行位置 加上 2, 长(原始响应))
  否则:
    设 头部分 为 截取子串(原始响应, 0, 空行位置)
    设 体 为 截取子串(原始响应, 空行位置 加上 4, 长(原始响应))
  # 解析状态行
  设 第一行结束 为 查找子串(头部分, "\r\n")
  如果 第一行结束 < 0:
    设 第一行结束 为 查找子串(头部分, "\n")
  设 状态行 为 头部分
  如果 第一行结束 >= 0:
    设 状态行 为 截取子串(头部分, 0, 第一行结束)
  设 状态码 为 解析状态码(状态行)
  # 头部解析为字典（键名小写归一）
  设 头部 为 新建字典()
  设 行列表 为 分割字符串(头部分, "\r\n")
  设 i 为 1
  当 i < 长(行列表):
    设 行 为 行列表[i]
    设 冒号 为 查找子串(行, ":")
    如果 冒号 > 0:
      设 键 为 转小写ASCII(截取子串(行, 0, 冒号))
      设 值 为 截取子串(行, 冒号 加上 1, 长(行))
      # 去掉值首空格
      当 长(值) > 0:
        如果 值[0] == " ":
          设 值 为 截取子串(值, 1, 长(值))
        否则:
          跳出
      字典设置(头部, 键, 值)
    设 i 为 i 加上 1
  # chunked 解码
  设 传输编码 为 字典获取(头部, "transfer-encoding")
  如果 传输编码 不等于 空:
    设 传输编码 为 传输编码 加上 ""
    如果 查找子串(转小写ASCII(传输编码), "chunked") >= 0:
      设 体 为 解码chunked(体)
  否则:
    # Content-Length 截断（Connection: close 下多余数据防御）
    设 内容长 为 字典获取(头部, "content-length")
    如果 内容长 不等于 空:
      设 内容长 为 内容长 加上 ""
      设 期望 为 字符串转整数(内容长)
      如果 期望 >= 0 且 期望 < 长(体):
        设 体 为 截取子串(体, 0, 期望)
  返回 ["状态码": 状态码, "头部": 头部, "内容": 体, "错误": ""]

# 响应头查找（键名小写归一）
段落 响应头值 接收 响应, 名:
  设 值 为 字典获取(响应["头部"], 转小写ASCII(名))
  如果 值 等于 空:
    返回 ""
  返回 值 加上 ""

# chunked 传输编码解码
段落 解码chunked 接收 体:
  设 结果 为 ""
  设 位置 为 0
  设 n 为 长(体)
  当 位置 < n:
    设 行尾 为 查找子串自(体, "\r\n", 位置)
    如果 行尾 < 0:
      跳出
    设 长度串 为 截取子串(体, 位置, 行尾)
    # 去掉分号后的扩展
    设 分号 为 查找子串(长度串, ";")
    如果 分号 >= 0:
      设 长度串 为 截取子串(长度串, 0, 分号)
    设 大小 为 十六进制转整数(长度串)
    如果 大小 <= 0:
      跳出
    设 起点 为 行尾 加上 2
    如果 起点 加上 大小 > n:
      设 结果 为 结果 加上 截取子串(体, 起点, n)
      跳出
    设 结果 为 结果 加上 截取子串(体, 起点, 起点 加上 大小)
    设 位置 为 起点 加上 大小 加上 2
  返回 结果

段落 解析状态码 接收 状态行:
  # 找到第一个空格后的数字
  设 空格位置 为 查找子串(状态行, " ")
  如果 空格位置 < 0:
    返回 0
  设 码串 为 截取子串(状态行, 空格位置 加上 1, 长(状态行))
  # 只取前3位数字
  设 结果 为 0
  设 i 为 0
  当 i < 长(码串) 且 i < 3:
    设 c 为 码串[i]
    如果 c >= "0" 且 c <= "9":
      设 结果 为 结果 乘 10 加上 十六进制值(c)
    设 i 为 i 加上 1
  返回 结果

# ── 响应访问器 ─────────────────────────────────────────────────────────────

段落 响应状态码 接收 响应:
  返回 响应["状态码"]

段落 响应文本 接收 响应:
  返回 响应["内容"]

段落 响应成功 接收 响应:
  设 码 为 响应["状态码"]
  返回 码 >= 200 且 码 < 300

段落 获取响应头 接收 响应, 名:
  返回 响应头值(响应, 名)

# ── 分割字符串（按单字符分隔符） ───────────────────────────────────────────
段落 分割字符串 接收 串, 分隔符:
  设 结果 为 新建列表()
  设 当前 为 ""
  设 i 为 0
  设 分隔长 为 长(分隔符)
  当 i < 长(串):
    设 匹配 为 真
    如果 i 加上 分隔长 > 长(串):
      设 匹配 为 假
    否则:
      设 j 为 0
      当 j < 分隔长:
        如果 串[i 加上 j] != 分隔符[j]:
          设 匹配 为 假
          设 j 为 分隔长
        设 j 为 j 加上 1
    如果 匹配:
      追加(结果, 当前)
      设 当前 为 ""
      设 i 为 i 加上 分隔长
    否则:
      设 当前 为 当前 加上 串[i]
      设 i 为 i 加上 1
  追加(结果, 当前)
  返回 结果

# ── 异常层级（任务2：请求错误 → HTTP错误/超时错误/连接错误） ────────────────
# 测试口径：请求错误 是 Exception；超时错误/连接错误 isinstance 请求错误。

类 请求错误 继承 Exception:
  段落 构造 接收 消息:
    父.构造(消息)

类 HTTP错误 继承 请求错误:
  段落 构造 接收 消息:
    父.构造(消息)

类 超时错误 继承 请求错误:
  段落 构造 接收 消息:
    父.构造(消息)

类 连接错误 继承 请求错误:
  段落 构造 接收 消息:
    父.构造(消息)

# ── 响应类（封装字典响应为对象接口） ───────────────────────────────────────
# 测试口径（tests/test_stdlib_phase3.py::test_响应对象）：
#   响应(状态码=200, 响应头={...}, 内容=b'...', 请求地址='...')
#   r.状态码 / r.是否成功 / r.获取头(名) / r.文本 / r.JSON()
# 关键字参数构造：解析器把 关键名=值 转为同名段落参数。

类 响应:
  段落 构造 接收 状态码 = 0, 响应头 = 空, 内容 = "", 请求地址 = "":
    己.状态码 为 状态码
    如果 响应头 等于 空:
      己.响应头 为 新建字典()
    否则:
      己.响应头 为 响应头
    己.内容 为 内容
    己.请求地址 为 请求地址

  # 200..299 为成功（对齐 HTTP 语义）
  段落 是否成功 接收:
    返回 己.状态码 >= 200 且 己.状态码 < 300

  # 头查找：键小写归一，缺省空串
  段落 获取头 接收 名:
    设 值 为 字典获取(己.响应头, 转小写ASCII(名))
    如果 值 等于 空:
      返回 ""
    返回 值 加上 ""

  # 文本视图：.light 字符串即字节串，原样返回
  段落 文本 接收:
    返回 己.内容 加上 ""

  # JSON 解析（复用纯光明 JSON核心，失败抛 运行时错误）
  # 注：解析 由模块顶层「从 JSON核心 导入 解析」提供（方法内函数级导入
  #     native 后端不支持，见文件头部说明）。
  段落 JSON 接收:
    返回 解析(己.文本())

# ── URL 拼接与查询串解析 ──────────────────────────────────────────────────
# 拼接URL(基准, 参数...)：可变参数，逐段以 / 缝合（复用 合并URL 的绝对地址判定）。
# 测试：拼接URL('https://example.com/', 'path', 'to', 'page') 结果含 'path/to/page'。

段落 拼接URL 接收 基准, 参数:
  设 结果 为 基准
  设 i 为 0
  当 i < 长(参数):
    设 段 为 参数[i]
    # 绝对地址段直接替换
    如果 查找子串(段, "://") >= 0:
      设 结果 为 段
    否则:
      # 去掉结果尾部所有 /
      当 长(结果) > 0 且 结果[长(结果) 减 1] == "/":
        设 结果 为 截取子串(结果, 0, 长(结果) 减 1)
      # 去掉段头部所有 /
      当 长(段) > 0 且 段[0] == "/":
        设 段 为 截取子串(段, 1, 长(段))
      如果 长(结果) > 0:
        设 结果 为 结果 加上 "/" 加上 段
      否则:
        设 结果 为 "/" 加上 段
    设 i 为 i 加上 1
  返回 结果

# 解析查询串('a=1&b=2') -> 字典。无 = 的段存空串；键值均原样（不做解码，
# 与 测试 的 'a=1&b=2&c=3' 纯键值口径一致）。

段落 解析查询串 接收 查询串:
  设 结果 为 新建字典()
  # 允许传入完整 URL：取 ? 之后 # 之前的部分
  设 问号 为 查找子串(查询串, "?")
  如果 问号 >= 0:
    设 查询串 为 截取子串(查询串, 问号 加上 1, 长(查询串))
  设 井号 为 查找子串(查询串, "#")
  如果 井号 >= 0:
    设 查询串 为 截取子串(查询串, 0, 井号)
  设 段们 为 分割字符串(查询串, "&")
  设 i 为 0
  当 i < 长(段们):
    设 段 为 段们[i]
    如果 长(段) > 0:
      设 等号 为 查找子串(段, "=")
      如果 等号 > 0:
        字典设置(结果, 截取子串(段, 0, 等号), 截取子串(段, 等号 加上 1, 长(段)))
      否则:
        如果 等号 < 0:
          字典设置(结果, 段, "")
    设 i 为 i 加上 1
  返回 结果
