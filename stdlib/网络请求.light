# 纯光明实现 —— stdlib/网络请求.py 的原生腿极简实现
#
# 基于 runtime B1 Socket 符号实现极简 HTTP/1.0 GET 请求。
# 不依赖 requests/urllib，纯光明 socket 调用。
#
# 能力边界（详见 docs/known_issues.md R11C 章节）：
#   1. 仅支持 HTTP（端口 80），不支持 HTTPS/TLS（无 TLS 运行时符号）。
#   2. 仅支持 GET 方法；POST/PUT/DELETE/PATCH 返回明确错误。
#   3. 不自动跟随重定向（3xx 原样返回）。
#   4. 不支持 chunked 传输编码（仅 Content-Length 或连接关闭判定体结束）。
#   5. 无超时控制（阻塞式 recv，依赖服务器关闭连接）。
#   6. 请求体/表单数据不支持（GET 无 body）。
#   7. URL 编码/解码为基础实现（仅处理常见 ASCII 字符）。
#
# 导出与 .py 主要函数对齐：获取 发起请求 解析URL 编码URL 解码URL
#                          响应文本 响应成功 响应状态码

导出 获取 发起请求 解析URL 编码URL 解码URL 响应文本 响应成功 响应状态码。

# ── URL 解析 ───────────────────────────────────────────────────────────────
# 解析 URL 为 [协议, 主机, 端口, 路径, 查询]
段落 解析URL 接收 url:
  设 协议 为 "http"
  设 剩余 为 url
  # 检测 ://
  设 冒号位置 为 查找子串(url, "://")
  如果 冒号位置 >= 0:
    设 协议 为 截取子串(url, 0, 冒号位置)
    设 剩余 为 截取子串(url, 冒号位置 加上 3, 长(url))
  # 分离主机和路径
  设 斜杠位置 为 查找子串(剩余, "/")
  设 主机端口 为 剩余
  设 路径查询 为 "/"
  如果 斜杠位置 >= 0:
    设 主机端口 为 截取子串(剩余, 0, 斜杠位置)
    设 路径查询 为 截取子串(剩余, 斜杠位置, 长(剩余))
  否则:
    设 路径查询 为 "/"
  # 分离端口
  设 主机 为 主机端口
  设 端口 为 80
  设 冒号2 为 查找子串(主机端口, ":")
  如果 冒号2 >= 0:
    设 主机 为 截取子串(主机端口, 0, 冒号2)
    设 端口串 为 截取子串(主机端口, 冒号2 加上 1, 长(主机端口))
    设 端口 为 字符串转整数(端口串)
  # 分离路径和查询
  设 路径 为 路径查询
  设 查询 为 ""
  设 问号位置 为 查找子串(路径查询, "?")
  如果 问号位置 >= 0:
    设 路径 为 截取子串(路径查询, 0, 问号位置)
    设 查询 为 截取子串(路径查询, 问号位置 加上 1, 长(路径查询))
  返回 ["协议": 协议, "主机": 主机, "端口": 端口, "路径": 路径, "查询": 查询]

# ── 字符串工具 ─────────────────────────────────────────────────────────────

段落 查找子串 接收 串, 子串:
  设 串长 为 长(串)
  设 子长 为 长(子串)
  如果 子长 == 0:
    返回 0
  如果 子长 > 串长:
    返回 0 减 1
  设 i 为 0
  当 i <= 串长 减 子长:
    设 匹配 为 真
    设 j 为 0
    当 j < 子长:
      如果 串[i 加上 j] != 子串[j]:
        设 匹配 为 假
        设 j 为 子长
      设 j 为 j 加上 1
    如果 匹配:
      返回 i
    设 i 为 i 加上 1
  返回 0 减 1

段落 截取子串 接收 串, 开始, 结束:
  设 结果 为 ""
  设 i 为 开始
  当 i < 结束 且 i < 长(串):
    设 结果 为 结果 加上 串[i]
    设 i 为 i 加上 1
  返回 结果

段落 字符串转整数 接收 串:
  设 结果 为 0
  设 i 为 0
  当 i < 长(串):
    设 c 为 串[i]
    如果 c >= "0" 且 c <= "9":
      设 数字 为 0
      如果 c == "0": 设 数字 为 0
      如果 c == "1": 设 数字 为 1
      如果 c == "2": 设 数字 为 2
      如果 c == "3": 设 数字 为 3
      如果 c == "4": 设 数字 为 4
      如果 c == "5": 设 数字 为 5
      如果 c == "6": 设 数字 为 6
      如果 c == "7": 设 数字 为 7
      如果 c == "8": 设 数字 为 8
      如果 c == "9": 设 数字 为 9
      设 结果 为 结果 乘 10 加上 数字
    设 i 为 i 加上 1
  返回 结果

# ── URL 编码/解码（基础实现） ──────────────────────────────────────────────

段落 编码URL 接收 文本:
  设 结果 为 ""
  设 i 为 0
  当 i < 长(文本):
    设 c 为 文本[i]
    如果 (c >= "a" 且 c <= "z") 或 (c >= "A" 且 c <= "Z") 或 (c >= "0" 且 c <= "9") 或 c == "-" 或 c == "_" 或 c == "." 或 c == "~":
      设 结果 为 结果 加上 c
    否则:
      # 非 ASCII 字符：原生腿无法获取 Unicode 码点，用 %3F 占位
      设 结果 为 结果 加上 "%3F"
    设 i 为 i 加上 1
  返回 结果

段落 解码URL 接收 编码文本:
  设 结果 为 ""
  设 i 为 0
  当 i < 长(编码文本):
    如果 编码文本[i] == "%":
      # 跳过 %XX（原生腿无法做十六进制解码，直接跳过）
      设 i 为 i 加上 3
    否则如果 编码文本[i] == "+":
      设 结果 为 结果 加上 " "
      设 i 为 i 加上 1
    否则:
      设 结果 为 结果 加上 编码文本[i]
      设 i 为 i 加上 1
  返回 结果

# ── HTTP GET（核心） ───────────────────────────────────────────────────────

段落 获取 接收 url, 头部 = 空, 超时 = 30:
  返回 发起请求(url, "GET", 头部, 空, 超时)

段落 发起请求 接收 url, 方法, 头部, 数据, 超时:
  # 能力边界：仅支持 GET
  如果 方法 != "GET":
    返回 ["状态码": 0, "头部": ["能力边界": "原生腿仅支持 GET"], "内容": "", "错误": "仅支持 GET 方法"]
  # 解析 URL
  设 解析 为 解析URL(url)
  # 能力边界：仅支持 HTTP
  如果 解析["协议"] != "http":
    返回 ["状态码": 0, "头部": ["能力边界": "原生腿不支持 HTTPS/TLS"], "内容": "", "错误": "仅支持 HTTP（不支持 HTTPS）"]
  # 创建 socket（AF_INET=2, SOCK_STREAM=1）
  设 fd 为 socket_create(2, 1)
  如果 fd < 0:
    返回 ["状态码": 0, "头部": [], "内容": "", "错误": "socket 创建失败"]
  # 连接
  设 连接结果 为 socket_connect(fd, 解析["主机"], 解析["端口"])
  如果 连接结果 < 0:
    设 错误信息 为 socket_last_error()
    socket_close(fd)
    返回 ["状态码": 0, "头部": [], "内容": "", "错误": 错误信息]
  # 构建请求
  设 请求路径 为 解析["路径"]
  如果 解析["查询"] != "":
    设 请求路径 为 请求路径 加上 "?" 加上 解析["查询"]
  设 请求 为 "GET " 加上 请求路径 加上 " HTTP/1.0\r\nHost: " 加上 解析["主机"] 加上 "\r\nUser-Agent: DuanLang-Native-HTTP/1.0\r\nAccept: */*\r\nConnection: close\r\n\r\n"
  # 发送
  socket_send(fd, 请求)
  # 接收（循环直到连接关闭或达到最大字节）
  设 响应内容 为 ""
  设 继续接收 为 真
  当 继续接收:
    设 块 为 socket_recv(fd, 4096)
    如果 长(块) == 0:
      设 继续接收 为 假
    否则:
      设 响应内容 为 响应内容 加上 块
      如果 长(块) < 4096:
        设 继续接收 为 假
  socket_close(fd)
  # 解析响应
  返回 解析HTTP响应(响应内容)

# ── HTTP 响应解析 ─────────────────────────────────────────────────────────

段落 解析HTTP响应 接收 原始响应:
  # 分离响应头和体（空行分隔）
  设 空行位置 为 查找子串(原始响应, "\r\n\r\n")
  如果 空行位置 < 0:
    设 空行位置 为 查找子串(原始响应, "\n\n")
    如果 空行位置 < 0:
      返回 ["状态码": 0, "头部": [], "内容": 原始响应, "错误": "无法解析响应"]
    设 头部分 为 截取子串(原始响应, 0, 空行位置)
    设 体 为 截取子串(原始响应, 空行位置 加上 2, 长(原始响应))
  否则:
    设 头部分 为 截取子串(原始响应, 0, 空行位置)
    设 体 为 截取子串(原始响应, 空行位置 加上 4, 长(原始响应))
  # 解析状态行
  设 第一行结束 为 查找子串(头部分, "\r\n")
  如果 第一行结束 < 0:
    设 第一行结束 为 查找子串(头部分, "\n")
  设 状态行 为 头部分
  如果 第一行结束 >= 0:
    设 状态行 为 截取子串(头部分, 0, 第一行结束)
  # 解析状态码（"HTTP/1.0 200 OK" → 200）
  设 状态码 为 解析状态码(状态行)
  # 头部解析为字典（简化：只存原始头字符串列表）
  设 头部列表 为 分割字符串(头部分, "\n")
  返回 ["状态码": 状态码, "头部": 头部列表, "内容": 体]

段落 解析状态码 接收 状态行:
  # 找到第一个空格后的数字
  设 空格位置 为 查找子串(状态行, " ")
  如果 空格位置 < 0:
    返回 0
  设 码串 为 截取子串(状态行, 空格位置 加上 1, 长(状态行))
  # 只取前3位数字
  设 结果 为 0
  设 i 为 0
  当 i < 长(码串) 且 i < 3:
    设 c 为 码串[i]
    如果 c >= "0" 且 c <= "9":
      设 数字 为 0
      如果 c == "1": 设 数字 为 1
      如果 c == "2": 设 数字 为 2
      如果 c == "3": 设 数字 为 3
      如果 c == "4": 设 数字 为 4
      如果 c == "5": 设 数字 为 5
      如果 c == "6": 设 数字 为 6
      如果 c == "7": 设 数字 为 7
      如果 c == "8": 设 数字 为 8
      如果 c == "9": 设 数字 为 9
      设 结果 为 结果 乘 10 加上 数字
    设 i 为 i 加上 1
  返回 结果

# ── 响应访问器 ─────────────────────────────────────────────────────────────

段落 响应状态码 接收 响应:
  返回 响应["状态码"]

段落 响应文本 接收 响应:
  返回 响应["内容"]

段落 响应成功 接收 响应:
  设 码 为 响应["状态码"]
  返回 码 >= 200 且 码 < 300

# ── 分割字符串（按单字符分隔符） ───────────────────────────────────────────
段落 分割字符串 接收 串, 分隔符:
  设 结果 为 新建列表()
  设 当前 为 ""
  设 i 为 0
  设 分隔长 为 长(分隔符)
  当 i < 长(串):
    设 匹配 为 真
    如果 i 加上 分隔长 > 长(串):
      设 匹配 为 假
    否则:
      设 j 为 0
      当 j < 分隔长:
        如果 串[i 加上 j] != 分隔符[j]:
          设 匹配 为 假
          设 j 为 分隔长
        设 j 为 j 加上 1
    如果 匹配:
      追加(结果, 当前)
      设 当前 为 ""
      设 i 为 i 加上 分隔长
    否则:
      设 当前 为 当前 加上 串[i]
      设 i 为 i 加上 1
  追加(结果, 当前)
  返回 结果
