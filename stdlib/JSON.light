# ---- 辅助：规范化序列化（去重键 / 排序键稳定化）----
段落 递归查找(当前, 键, 结果):
  如果 type(当前) == dict:
    遍历 k 之 当前:
      如果 k == 键:
        结果.追加(当前[k])
      递归查找(当前[k], 键, 结果)
  否则 如果 type(当前) == list:
    设 i 为 0
    当 i < 长(当前):
      递归查找(当前[i], 键, 结果)
      i 为 i + 1

# ═══════════════════════════════════════════════════════════════════════════
# 17. JSON去重
# ═══════════════════════════════════════════════════════════════════════════
段落 JSON去重(数据, 键 等于 空):
  设 已见 为 {}
  设 结果 为 []
  遍历 项 之 数据:
    如果 键 == 空:
      设 键值 为 规范化序列化(项)
    否则:
      设 键值 为 字典获取(项, 键, 空)
    如果 字典包含键(已见, 键值) == 假:
      已见[键值] 为 真
      结果.追加(项)
  返回 结果

# ═══════════════════════════════════════════════════════════════════════════
# 18. JSON扁平化
# ═══════════════════════════════════════════════════════════════════════════
段落 JSON扁平化(数据, 前缀 等于 空):
  设 结果 为 {}
  如果 前缀 == 空:
    设 前缀 为 ""
  扁平递归(数据, 前缀, 结果)
  返回 结果

段落 扁平递归(当前, 路径, 结果):
  如果 type(当前) == dict:
    遍历 k 之 当前:
      如果 路径 == "":
        设 新键 为 k
      否则:
        设 新键 为 路径 + "." + k
      扁平递归(当前[k], 新键, 结果)
  否则:
    结果[路径] 为 当前

# ═══════════════════════════════════════════════════════════════════════════
# 19. JSON展开（dict 递归展开为点路径；list 视为叶子）
# ═══════════════════════════════════════════════════════════════════════════
# 对齐 JSON.py:452 JSON展开 —— 入参为「扁平化」字典 {"a.b":1}，返回嵌套 {"a":{"b":1}}（反向展开）
段落 JSON展开(数据):
  设 结果 为 {}
  遍历 键值 之 数据:
    设 键列表 为 分割字符串(键值, ".")
    设 当前 为 结果
    设 n 为 长(键列表)
    设 i 为 0
    当 i < n:
      设 k 为 键列表[i]
      如果 i == n - 1:
        当前[k] 为 数据[键值]
      否则:
        如果 字典包含键(当前, k) == 假:
          当前[k] 为 {}
        设 当前 为 当前[k]
      i 为 i + 1
  返回 结果

# ═══════════════════════════════════════════════════════════════════════════
# 20. JSON转CSV / 21. CSV转JSON（实现为 段落，但不列入 导出，规避命名空间翻转）
# ═══════════════════════════════════════════════════════════════════════════
段落 JSON转CSV(数据):
  # 对齐 JSON.py:491：data 可为 JSON 字符串或已解析列表（字典列表）
  如果 type(数据) == str:
    设 数据 为 解析(数据)
  如果 长(数据) == 0:
    返回 ""
  设 表头 为 []
  遍历 行 之 数据:
    遍历 k 之 行:
      如果 包含(表头, k) == 假:
        表头.追加(k)
  设 行列表 为 []
  行列表.追加(连接字符串(表头, ","))
  遍历 行 之 数据:
    设 单元格 为 []
    遍历 k 之 表头:
      设 v 为 字典获取(行, k, "")
      单元格.追加(转字符串(v))
    行列表.追加(连接字符串(单元格, ","))
  返回 连接字符串(行列表, "\n")

段落 CSV转JSON(文本):
  设 行列表 为 分割字符串(文本, "\n")
  设 表头 为 分割字符串(行列表[0], ",")
  设 结果 为 []
  设 i 为 1
  当 i < 长(行列表):
    设 单元格 为 分割字符串(行列表[i], ",")
    设 行 为 {}
    设 j 为 0
    当 j < 长(表头):
      行[表头[j]] 为 单元格[j]
      j 为 j + 1
    结果.追加(行)
    i 为 i + 1
  返回 结果

# ═══════════════════════════════════════════════════════════════════════════
# 22. JSON键列表 / 23. JSON值列表
# ═══════════════════════════════════════════════════════════════════════════
段落 JSON键列表(数据):
  如果 type(数据) == dict:
    返回 字典键列表(数据)
  如果 type(数据) == list:
    设 结果 为 []
    遍历 项 之 数据:
      结果.追加(JSON键列表(项))
    返回 结果
  返回 []

段落 JSON值列表(数据):
  如果 type(数据) == dict:
    设 结果 为 []
    遍历 k 之 数据:
      结果.追加(数据[k])
    返回 结果
  如果 type(数据) == list:
    设 结果 为 []
    遍历 项 之 数据:
      结果.追加(JSON值列表(项))
    返回 结果
  返回 []

# ═══════════════════════════════════════════════════════════════════════════
# 24. JSON长度 / 25. JSON类型
# ═══════════════════════════════════════════════════════════════════════════
段落 JSON长度(数据):
  如果 type(数据) == dict:
    返回 长(字典键列表(数据))
  如果 type(数据) == list:
    返回 长(数据)
  如果 type(数据) == str:
    返回 长(数据)
  返回 0

段落 JSON类型(数据):
  如果 type(数据) == dict:
    返回 "对象"
  如果 type(数据) == list:
    返回 "数组"
  如果 type(数据) == str:
    返回 "字符串"
  如果 type(数据) == int 或 type(数据) == float 或 type(数据) == bool:
    返回 "数字"
  如果 数据 == 空:
    返回 "空"
  返回 "未知"

# ═══════════════════════════════════════════════════════════════════════════
# 26. JSON转字符串 / 27. JSON格式化
# ═══════════════════════════════════════════════════════════════════════════
段落 JSON转字符串(数据, 缩进 等于 空):
  如果 缩进 == 空:
    设 缩进 为 2
  返回 序列化缩进(数据, 缩进)

段落 JSON格式化(文本, 缩进 等于 空):
  设 数据 为 解析(文本)
  如果 缩进 == 空:
    设 缩进 为 2
  返回 序列化JSON(数据, 缩进)

# ═══════════════════════════════════════════════════════════════════════════
# 28. JSON压缩
# ═══════════════════════════════════════════════════════════════════════════
段落 JSON压缩(文本):
  设 数据 为 解析(文本)
  返回 序列化(数据)

# ═══════════════════════════════════════════════════════════════════════════
# 29. JSON比较 / 30. JSON差异
# ═══════════════════════════════════════════════════════════════════════════
段落 JSON比较(甲, 乙):
  返回 深度相等(甲, 乙)

段落 深度相等(甲, 乙):
  如果 type(甲) != type(乙):
    返回 假
  如果 type(甲) == dict:
    如果 长(字典键列表(甲)) != 长(字典键列表(乙)):
      返回 假
    遍历 k 之 甲:
      如果 字典包含键(乙, k) == 假:
        返回 假
      如果 深度相等(甲[k], 乙[k]) == 假:
        返回 假
    返回 真
  如果 type(甲) == list:
    如果 长(甲) != 长(乙):
      返回 假
    设 i 为 0
    当 i < 长(甲):
      如果 深度相等(甲[i], 乙[i]) == 假:
        返回 假
      i 为 i + 1
    返回 真
  返回 甲 == 乙

段落 JSON差异(甲, 乙):
  设 差异 为 {}
  设 已处理 为 {}
  遍历 k 之 甲:
    已处理[k] 为 真
    如果 字典包含键(乙, k) == 假:
      差异[k] 为 {"类型": "删除", "值": 甲[k]}
    否则 如果 深度相等(甲[k], 乙[k]) == 假:
      差异[k] 为 {"类型": "修改", "原值": 甲[k], "新值": 乙[k]}
  遍历 k 之 乙:
    如果 字典包含键(已处理, k) == 假:
      差异[k] 为 {"类型": "新增", "值": 乙[k]}
  返回 差异

# ═══════════════════════════════════════════════════════════════════════════
# 31. _验证Schema（JSONSchema验证 内部实现）
# ═══════════════════════════════════════════════════════════════════════════
段落 _验证Schema(数据, schema):
  设 类型 为 ""
  如果 含键(schema, "type"):
    设 类型 为 schema["type"]
  如果 类型 == "object":
    如果 type(数据) != dict:
      返回 假
    如果 含键(schema, "properties"):
      设 属性表 为 schema["properties"]
      遍历 键 之 属性表:
        如果 含键(数据, 键):
          如果 _验证Schema(数据[键], 属性表[键]) == 假:
            返回 假
    如果 含键(schema, "required"):
      设 必填表 为 schema["required"]
      遍历 键 之 必填表:
        如果 含键(数据, 键) == 假:
          返回 假
    返回 真
  如果 类型 == "array":
    如果 type(数据) != list:
      返回 假
    如果 含键(schema, "items"):
      设 项模式 为 schema["items"]
      遍历 项 之 数据:
        如果 _验证Schema(项, 项模式) == 假:
          返回 假
    如果 含键(schema, "minItems") 且 长(数据) < schema["minItems"]:
      返回 假
    如果 含键(schema, "maxItems") 且 长(数据) > schema["maxItems"]:
      返回 假
    返回 真
  如果 类型 == "string":
    如果 type(数据) != str:
      返回 假
    如果 含键(schema, "minLength") 且 长(数据) < schema["minLength"]:
      返回 假
    如果 含键(schema, "maxLength") 且 长(数据) > schema["maxLength"]:
      返回 假
    返回 真
  如果 类型 == "number":
    返回 type(数据) == int 或 type(数据) == float
  如果 类型 == "integer":
    返回 type(数据) == int
  如果 类型 == "boolean":
    返回 type(数据) == bool
  如果 类型 == "null":
    返回 数据 == 空
  如果 类型 == "any":
    返回 真
  返回 真

# ═══════════════════════════════════════════════════════════════════════════
# 32. JSON转XML / 33. JSON转换XML
# ═══════════════════════════════════════════════════════════════════════════
段落 JSON转XML(数据, 根元素 等于 空):
  如果 根元素 == 空:
    设 根元素 为 "root"
  返回 "<?xml version='1.0' encoding='utf-8'?>" 加上 转XML递归(数据, 根元素)

段落 转XML递归(数据, 标签):
  如果 type(数据) == dict:
    设 内容 为 []
    遍历 k 之 数据:
      内容.追加(转XML递归(数据[k], k))
    返回 "<" 加上 标签 加上 ">" 加上 连接字符串(内容, "") 加上 "</" 加上 标签 加上 ">"
  否则 如果 type(数据) == list:
    设 内容 为 []
    遍历 项 之 数据:
      内容.追加(转XML递归(项, "item"))
    返回 "<" 加上 标签 加上 ">" 加上 连接字符串(内容, "") 加上 "</" 加上 标签 加上 ">"
  否则 如果 数据 == 空:
    返回 "<" 加上 标签 加上 "/>"
  否则:
    返回 "<" 加上 标签 加上 ">" 加上 转字符串(数据) 加上 "</" 加上 标签 加上 ">"

段落 JSON转换XML(s, 根节点 等于 空):
  如果 根节点 == 空:
    设 根节点 为 "root"
  设 对象 为 解析(s)
  设 体 为 转换XML递归(对象)
  返回 "<" 加上 根节点 加上 ">\n" 加上 体 加上 "\n</" 加上 根节点 加上 ">"

段落 转换XML递归(数据):
  如果 type(数据) == dict:
    设 行 为 []
    遍历 k 之 数据:
      行.追加("<" 加上 k 加上 ">")
      行.追加(转换XML递归(数据[k]))
      行.追加("</" 加上 k 加上 ">")
    返回 连接字符串(行, "\n")
  否则 如果 type(数据) == list:
    设 行 为 []
    遍历 项 之 数据:
      行.追加(转换XML递归(项))
    返回 连接字符串(行, "\n")
  否则 如果 数据 == 空:
    返回 ""
  否则:
    返回 转字符串(数据)

# ═══════════════════════════════════════════════════════════════════════════
# 34. 字典转JSON / 35. 列表转JSON
# ═══════════════════════════════════════════════════════════════════════════
段落 字典转JSON(字典):
  返回 序列化(字典)

段落 列表转JSON(列表):
  返回 序列化(列表)

# ═══════════════════════════════════════════════════════════════════════════
# 36. JSON深拷贝
# ═══════════════════════════════════════════════════════════════════════════
段落 JSON深拷贝(数据):
  如果 type(数据) == dict:
    设 结果 为 {}
    遍历 k 之 数据:
      结果[k] 为 JSON深拷贝(数据[k])
    返回 结果
  如果 type(数据) == list:
    设 结果 为 []
    遍历 项 之 数据:
      结果.追加(JSON深拷贝(项))
    返回 结果
  返回 数据

# ═══════════════════════════════════════════════════════════════════════════
# 37. JSON设置值 / 38. JSON删除键（按点路径）
# ═══════════════════════════════════════════════════════════════════════════
段落 JSON设置值(数据, 路径, 值):
  设 段表 为 路径.split(".")
  设 当前 为 数据
  设 i 为 0
  当 i < 长(段表) - 1:
    设 k 为 段表[i]
    如果 type(当前) == dict 且 含键(当前, k) == 假:
      当前[k] 为 {}
    设 当前 为 当前[k]
    i 为 i + 1
  当前[段表[长(段表) - 1]] 为 值
  返回 数据

段落 JSON删除键(数据, 路径):
  设 段表 为 路径.split(".")
  设 当前 为 数据
  设 i 为 0
  当 i < 长(段表) - 1:
    设 k 为 段表[i]
    如果 type(当前) == dict 且 含键(当前, k):
      设 当前 为 当前[k]
    否则:
      返回 数据
    i 为 i + 1
  设 末键 为 段表[长(段表) - 1]
  如果 type(当前) == dict 且 含键(当前, 末键):
    字典删除(当前, 末键)
  返回 数据

# ═══════════════════════════════════════════════════════════════════════════
# 39. JSON遍历 / 40. JSON计数
# ═══════════════════════════════════════════════════════════════════════════
段落 JSON遍历(数据, 处理器):
  遍历递归(数据, "", 处理器)

段落 遍历递归(当前, 路径, 处理器):
  如果 type(当前) == dict:
    遍历 k 之 当前:
      如果 路径 == "":
        设 新路径 为 k
      否则:
        设 新路径 为 路径 + "." + k
      处理器(新路径, 当前[k])
      遍历递归(当前[k], 新路径, 处理器)
  否则 如果 type(当前) == list:
    设 i 为 0
    当 i < 长(当前):
      设 新路径 为 路径 + "[" + 转字符串(i) + "]"
      处理器(新路径, 当前[i])
      遍历递归(当前[i], 新路径, 处理器)
      i 为 i + 1

段落 JSON计数(数据):
  返回 计数递归(数据)

段落 计数递归(数据):
  如果 type(数据) == dict:
    设 n 为 1
    遍历 k 之 数据:
      n 为 n + 计数递归(数据[k])
    返回 n
  如果 type(数据) == list:
    设 n 为 1
    遍历 项 之 数据:
      n 为 n + 计数递归(项)
    返回 n
  返回 1

# ═══════════════════════════════════════════════════════════════════════════
# 41. JSON格式化美化（彩色缩进输出；修正 .py 的 1-元组 bug）
# ═══════════════════════════════════════════════════════════════════════════
段落 JSON格式化美化(对象, 缩进 等于 空):
  如果 缩进 == 空:
    设 缩进 为 2
  返回 美化(对象, 缩进, 0)

段落 美化(对象, 缩进, 层级):
  设 前缀 为 重复空格(层级 * 缩进)
  设 子前缀 为 重复空格((层级 + 1) * 缩进)
  如果 type(对象) == dict:
    如果 长(字典键列表(对象)) == 0:
      返回 "{}"
    设 行 为 []
    遍历 k 之 对象:
      行.追加(子前缀 + "\"" + 转字符串(k) + "\": " + 美化(对象[k], 缩进, 层级 + 1))
    返回 "{" + "\n" + 连接字符串(行, ",\n") + "\n" + 前缀 + "}"
  如果 type(对象) == list:
    如果 长(对象) == 0:
      返回 "[]"
    设 行 为 []
    遍历 项 之 对象:
      行.追加(子前缀 + 美化(项, 缩进, 层级 + 1))
    返回 "[" + "\n" + 连接字符串(行, ",\n") + "\n" + 前缀 + "]"
  如果 type(对象) == str:
    返回 "\"" + 对象 + "\""
  返回 转字符串(对象)

段落 JSON获取大小(数据):
  返回 长(序列化(数据))

段落 JSON版本():
  # 对齐 JSON.py:1101 return json.__name__  （运行时该模块名为 "json"）
  返回 "json"

# ═══════════════════════════════════════════════════════════════════════════
# 44. JSON编码器 / 45. JSON解码器（ensure_ascii=True 等价）
# ═══════════════════════════════════════════════════════════════════════════
段落 JSON编码器(对象):
  返回 转义ASCII(序列化(对象))

# 对齐 JSON.py:1106 JSON编码器 = json.dumps（ensure_ascii=True 默认）。
# JSON核心.序列化 已产出合法 JSON（字符串内 " \ 控制符均已正确转义），
# 故此处只需把 ≥128 的非 ASCII 码点转成 \uXXXX，不得二次转义结构性引号/反斜杠。
段落 转义ASCII(文本):
  设 结果 为 []
  设 i 为 0
  当 i < 长(文本):
    设 c 为 文本[i]
    设 code 为 ord(c)
    如果 code >= 128:
      结果.追加(四位十六进制(code))
    否则:
      结果.追加(c)
    i 为 i + 1
  返回 连接字符串(结果, "")

段落 四位十六进制(code):
  设 h 为 ""
  设 n 为 code
  当 n > 0:
    设 r 为 n % 16
    如果 r < 10:
      设 h 为 转字符串(r) + h
    否则 如果 r == 10:
      h 为 "a" + h
    否则 如果 r == 11:
      h 为 "b" + h
    否则 如果 r == 12:
      h 为 "c" + h
    否则 如果 r == 13:
      h 为 "d" + h
    否则 如果 r == 14:
      h 为 "e" + h
    否则:
      h 为 "f" + h
    n 为 n // 16
  当 长(h) < 4:
    h 为 "0" + h
  返回 "\\u" + h

段落 JSON解码器(字符串):
  返回 解析(字符串)

段落 JSON查找(数据, 键):
  设 结果 为 []
  递归查找(数据, 键, 结果)
  返回 结果

段落 JSON过滤(数据, 条件):
  设 结果 为 []
  遍历 项 之 数据:
    设 命中 为 真
    遍历 k 之 条件:
      如果 字典获取(项, k, 空) != 条件[k]:
        设 命中 为 假
    如果 命中 == 真:
      结果.追加(项)
  返回 结果

段落 JSON映射(数据, 映射器):
  设 结果 为 []
  遍历 项 之 数据:
    结果.追加(映射器(项))
  返回 结果

段落 JSON聚合(数据, 键, 聚合器 等于 空):
  设 值列表 为 []
  遍历 项 之 数据:
    如果 字典包含键(项, 键):
      值列表.追加(字典获取(项, 键, 空))
  如果 聚合器 == 空:
    返回 求和(值列表)
  返回 聚合器(值列表)

段落 JSON分组(数据, 键):
  设 结果 为 {}
  遍历 项 之 数据:
    设 分组键 为 字典获取(项, 键, 空)
    如果 字典包含键(结果, 分组键) == 假:
      结果[分组键] 为 []
    结果[分组键].追加(项)
  返回 结果

段落 JSON排序(数据, 键, 反向 等于 假):
  设 结果 为 []
  遍历 项 之 数据:
    结果.追加(项)
  设 n 为 长(结果)
  设 i 为 0
  当 i 小于 n:
    设 j 为 0
    当 j 小于 n - 1:
      设 a 为 字典获取(结果[j], 键, 空)
      设 b 为 字典获取(结果[j + 1], 键, 空)
      设 交换 为 假
      如果 反向 == 假:
        如果 a 大于 b:
          设 交换 为 真
      否则:
        如果 a 小于 b:
          设 交换 为 真
      如果 交换 == 真:
        设 临时 为 结果[j]
        结果[j] 为 结果[j + 1]
        结果[j + 1] 为 临时
      j 为 j + 1
    i 为 i + 1
  返回 结果
