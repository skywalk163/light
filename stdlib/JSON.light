# ---- 以下四个为 test_stdlib_complete.py（任务书 §6 点名）真实使用的 JSON.py 高级能力 ----

# 字典是否含键（光明无 `键 in 字典` 语法，遍历比对）
段落 含键(字典, 键):
  遍历 k 之 字典:
    如果 k == 键:
      返回 真
  返回 假

# 浅合并两个字典（等价 JSON.py:230 族 JSON合并；任一非字典参数直接返回 其他）
段落 JSON合并(基础, 其他):
  如果 type(基础) == dict 且 type(其他) == dict:
    设 结果 为 {}
    遍历 k 之 基础:
      结果[k] 为 基础[k]
    遍历 k 之 其他:
      结果[k] 为 其他[k]
    返回 结果
  返回 其他

# 深合并（等价 JSON.py:240 族 JSON深合并；嵌套字典逐层递归，非字典叶子以 其他 为准）
段落 JSON深合并(基础, 其他):
  如果 type(基础) == dict 且 type(其他) == dict:
    设 结果 为 {}
    遍历 k 之 基础:
      结果[k] 为 基础[k]
    遍历 k 之 其他:
      如果 含键(结果, k) 且 type(结果[k]) == dict 且 type(其他[k]) == dict:
        结果[k] 为 JSON深合并(结果[k], 其他[k])
      否则:
        结果[k] 为 其他[k]
    返回 结果
  返回 其他

# 按点路径提取值（等价 JSON.py:260 族 JSON提取值(数据, "a.b.0", 默认值)；
# 段支持字典键与数组下标；任一环节缺失/错型返回 默认值）
段落 JSON提取值(数据, 路径, 默认值 等于 空):
  # 对齐 JSON.py:252：data 可为 JSON 字符串或已解析对象（dict/list）
  如果 type(数据) == str:
    设 数据 为 解析(数据)
  设 当前 为 数据
  设 段表 为 路径.split(".")
  遍历 段 之 段表:
    如果 type(当前) == dict:
      如果 含键(当前, 段):
        设 当前 为 当前[段]
      否则:
        返回 默认值
    否则 如果 type(当前) == list:
      设 索引 为 转整数(段)
      如果 索引 < 长(当前):
        设 当前 为 当前[索引]
      否则:
        返回 默认值
    否则:
      返回 默认值
  返回 当前

# JSON Schema 校验（等价 JSON.py:162 族 JSONSchema验证，实现 _验证Schema 子集：
# type/properties/required/items/minItems/maxItems/minLength/maxLength；pattern 因光明无 re 暂未实现）
段落 JSONSchema验证(数据, schema):
  设 类型 为 ""
  如果 含键(schema, "type"):
    设 类型 为 schema["type"]
  如果 类型 == "object":
    如果 type(数据) != dict:
      返回 假
    如果 含键(schema, "properties"):
      设 属性表 为 schema["properties"]
      遍历 键 之 属性表:
        如果 含键(数据, 键):
          如果 JSONSchema验证(数据[键], 属性表[键]) == 假:
            返回 假
    如果 含键(schema, "required"):
      设 必填表 为 schema["required"]
      遍历 键 之 必填表:
        如果 含键(数据, 键) == 假:
          返回 假
    返回 真
  如果 类型 == "array":
    如果 type(数据) != list:
      返回 假
    如果 含键(schema, "items"):
      设 项模式 为 schema["items"]
      遍历 项 之 数据:
        如果 JSONSchema验证(项, 项模式) == 假:
          返回 假
    如果 含键(schema, "minItems") 且 长(数据) < schema["minItems"]:
      返回 假
    如果 含键(schema, "maxItems") 且 长(数据) > schema["maxItems"]:
      返回 假
    返回 真
  如果 类型 == "string":
    如果 type(数据) != str:
      返回 假
    如果 含键(schema, "minLength") 且 长(数据) < schema["minLength"]:
      返回 假
    如果 含键(schema, "maxLength") 且 长(数据) > schema["maxLength"]:
      返回 假
    返回 真
  如果 类型 == "number":
    返回 type(数据) == int 或 type(数据) == float
  如果 类型 == "integer":
    返回 type(数据) == int
  如果 类型 == "boolean":
    返回 type(数据) == bool
  如果 类型 == "null":
    返回 数据 == 空
  返回 真
# R151-B：补齐 JSON.py 的其余 45 个导出函数（与 JSON.py 函数级对等）。
# 纯光明实现，零 src/；复用 JSON核心 的 解析/序列化/序列化缩进 与 light 内置。
# 语义对齐 JSON.py（黄金 oracle）。两处 .py 的明显 bug 在本文件按意图修正：
#   ① JSON转换XML 原 `str(data)` 应为 `str(数据)`（原对所有标量叶子崩 NameError）
#      → 此处用 转字符串(数据)；
#   ② JSON格式化美化 原 `结果.append(f'...}}}',)` 误把括号写成 1-元组，join 必崩
#      → 此处实现为正确的多行彩色输出。
# .py 的 isinstance(bool) 顺序怪异（bool 被 (int,float) 先命中）保留：
#   JSON类型(True)="数字"、JSON计数 的 bool 计入 "int"（按 oracle 原样）。
# 注：CSV转JSON / JSON转CSV / 读取文件内容 已实现为 段落，但刻意不列入 导出，
#   以免翻转 stdlib.* 中对 CSV读写器 / 文件系统 同名函数的既有命名空间解析。
# ═══════════════════════════════════════════════════════════════════════════

# ---------- 小工具 / 辅助段（不在 .py 顶层函数集合，纯内部复用） ----------

# 拼接点路径（字典键）
段落 拼路径(路径, 键):
  如果 路径 == "":
    返回 键
  返回 路径 加上 "." 加上 键

# 拼接索引路径（列表下标）
段落 拼路径索引(路径, i):
  如果 路径 == "":
    返回 "[" 加上 转字符串(i) 加上 "]"
  返回 路径 加上 "[" 加上 转字符串(i) 加上 "]"

# 等价 Python 的 str.isdigit()：全数字串判定
段落 是否数字串(串):
  如果 长(串) == 0:
    返回 假
  设 i 为 0
  当 i < 长(串):
    如果 是数字(串[i]) == 假:
      返回 假
    i 为 i + 1
  返回 真

# 重复 count 个空格（缩进用）
段落 重复空格(次数):
  设 s 为 ""
  设 i 为 0
  当 i < 次数:
    s 为 s 加上 " "
    i 为 i + 1
  返回 s

# 规范化：递归排序 dict 键，list 保持原序（用于 去重/比较 的规范化序列化）
段落 规范化(值):
  如果 type(值) == dict:
    设 结果 为 {}
    遍历 k 之 值:
      结果[k] 为 规范化(值[k])
    返回 结果
  否则 如果 type(值) == list:
    设 结果 为 []
    遍历 项 之 值:
      结果.追加(规范化(项))
    返回 结果
  返回 值

# 规范化序列化：先排序 dict 键再序列化（等价 json.dumps(..., sort_keys=True)）
段落 规范化序列化(值):
  返回 序列化(规范化(值))

