# 纯光明实现 —— stdlib/中国传统节日.py 的原生腿真实现
#
# 提供中国传统节日查询：节日列表、节日日期、节日判断、月度节日、倒计时。
# 农历节日日期通过 农历.light 的 农历转公历 精确计算（优于 .py 的简化估算）。
#
# 能力边界（详见 docs/known_issues.md R11C 章节）：
#   1. 农历节日日期依赖 农历.light 数据范围（2024-2030）；范围外返回空。
#   2. 节日倒计时() 依赖系统当前日期，原生腿无日期原语，返回 -1 并标注。
#   3. 与 .py 对拍说明：.py 用简化农历月长估算（正月30天/其余交替29/30），
#      本实现用 农历.light 精确数据表，农历节日日期可能与 .py 差 1-2 天（本实现更准）。
#      春节/公历节日与 .py 完全一致。
#
# 导出与 .py __all__ 对齐：获取节日列表 获取节日日期 判断节日 获取月份节日 节日倒计时

从 农历 导入 农历转公历 公历转儒略日

导出 获取节日列表 获取节日日期 判断节日 获取月份节日 节日倒计时。

# ── 数据表 ────────────────────────────────────────────────────────────────

# 春节公历日期 [月, 日]，索引 0=2024（与 农历.light 春节公历 同源）
设 春节表 为 [
  [2,10], [1,29], [2,17], [2,6], [1,26], [2,13], [2,3]
]
设 数据起始年 为 2024
设 数据结束年 为 2030

# 农历节日：[月, 日, 名称, 说明]
设 农历节日表 为 [
  [1, 1, "春节", "农历正月初一，中国传统新年"],
  [1, 15, "元宵节", "农历正月十五，又称上元节"],
  [5, 5, "端午节", "农历五月初五，纪念屈原"],
  [7, 7, "七夕节", "农历七月初七，中国传统情人节"],
  [8, 15, "中秋节", "农历八月十五，团圆节"],
  [9, 9, "重阳节", "农历九月初九，敬老节"],
  [12, 8, "腊八节", "农历十二月初八，喝腊八粥"],
  [12, 30, "除夕", "农历腊月三十（或廿九），除夕夜"]
]

# 公历节日：[月, 日, 名称, 说明]
设 公历节日表 为 [
  [1, 1, "元旦", "公历1月1日，新年伊始"],
  [4, 5, "清明节", "公历4月5日左右，扫墓祭祖"],
  [5, 1, "劳动节", "公历5月1日，国际劳动节"],
  [10, 1, "国庆节", "公历10月1日，中华人民共和国成立纪念日"]
]

# ── 工具函数 ───────────────────────────────────────────────────────────────

段落 是公历闰年 接收 年:
  如果 年 % 400 == 0:
    返回 真
  如果 年 % 100 == 0:
    返回 假
  返回 年 % 4 == 0

# 清明节日期：闰年4月4日，平年4月5日（与 .py _get_qingming_date 对齐）
段落 清明日期 接收 年:
  如果 是公历闰年(年):
    返回 [年, 4, 4]
  返回 [年, 4, 5]

# 日期转字符串 "YYYY-MM-DD"
段落 日期转字符串 接收 年, 月, 日:
  设 月串 为 转字符串(月)
  如果 月 < 10:
    设 月串 为 "0" 加上 月串
  设 日串 为 转字符串(日)
  如果 日 < 10:
    设 日串 为 "0" 加上 日串
  返回 转字符串(年) 加上 "-" 加上 月串 加上 "-" 加上 日串

# 解析日期字符串 "YYYY-MM-DD" 或 "YYYYMMDD" → [年,月,日] 或 空
段落 解析日期字符串 接收 日期串:
  # 去除分隔符
  设 净化 为 替换字符串(日期串, "-", "")
  设 净化 为 替换字符串(净化, "/", "")
  设 净化 为 替换字符串(净化, "年", "")
  设 净化 为 替换字符串(净化, "月", "")
  设 净化 为 替换字符串(净化, "日", "")
  如果 长(净化) != 8:
    返回 空
  # 手动解析8位数字
  设 年 为 0
  设 月 为 0
  设 日 为 0
  设 i 为 0
  当 i < 4:
    设 年 为 年 乘 10 加上 (字符转数字(净化[i]))
    设 i 为 i 加上 1
  当 i < 6:
    设 月 为 月 乘 10 加上 (字符转数字(净化[i]))
    设 i 为 i 加上 1
  当 i < 8:
    设 日 为 日 乘 10 加上 (字符转数字(净化[i]))
    设 i 为 i 加上 1
  如果 月 < 1 或 月 > 12 或 日 < 1 或 日 > 31:
    返回 空
  返回 [年, 月, 日]

# 字符转数字（'0'-'9' → 0-9）
段落 字符转数字 接收 字符:
  如果 字符 == "0": 返回 0
  如果 字符 == "1": 返回 1
  如果 字符 == "2": 返回 2
  如果 字符 == "3": 返回 3
  如果 字符 == "4": 返回 4
  如果 字符 == "5": 返回 5
  如果 字符 == "6": 返回 6
  如果 字符 == "7": 返回 7
  如果 字符 == "8": 返回 8
  如果 字符 == "9": 返回 9
  返回 0

# ── 核心：获取节日日期 ─────────────────────────────────────────────────────

# 获取特定节日的日期信息，返回字典或 空
段落 获取节日日期 接收 名称, 年:
  # 查农历节日
  设 i 为 0
  设 n 为 长(农历节日表)
  当 i < n:
    设 项 为 农历节日表[i]
    如果 项[2] == 名称:
      设 公历日期 为 空
      如果 名称 == "春节":
        # 春节直接查表
        如果 年 >= 数据起始年 且 年 <= 数据结束年:
          设 idx 为 年 减 数据起始年
          设 春 为 春节表[idx]
          设 公历日期 为 [年, 春[0], 春[1]]
      否则如果 名称 == "除夕":
        # 除夕：腊月三十，若不存在则腊月廿九
        设 公历日期 为 农历转公历(年, 12, 30, 假)
        如果 公历日期 等于 空:
          设 公历日期 为 农历转公历(年, 12, 29, 假)
      否则:
        设 公历日期 为 农历转公历(年, 项[0], 项[1], 假)
      如果 公历日期 不等于 空:
        返回 [
          "name": 项[2],
          "date_str": 日期转字符串(公历日期[0], 公历日期[1], 公历日期[2]),
          "type": "农历",
          "description": 项[3],
          "lunar_month": 项[0],
          "lunar_day": 项[1]
        ]
      返回 空
    设 i 为 i 加上 1
  # 查公历节日
  设 i 为 0
  设 n 为 长(公历节日表)
  当 i < n:
    设 项 为 公历节日表[i]
    如果 项[2] == 名称:
      设 公历日期 为 空
      如果 名称 == "清明节":
        设 公历日期 为 清明日期(年)
      否则:
        设 公历日期 为 [年, 项[0], 项[1]]
      返回 [
        "name": 项[2],
        "date_str": 日期转字符串(公历日期[0], 公历日期[1], 公历日期[2]),
        "type": "公历",
        "description": 项[3]
      ]
    设 i 为 i 加上 1
  返回 空

# ── 获取节日列表 ───────────────────────────────────────────────────────────

段落 获取节日列表 接收 年:
  设 结果 为 新建列表()
  # 农历节日
  设 i 为 0
  设 n 为 长(农历节日表)
  当 i < n:
    设 项 为 农历节日表[i]
    设 信息 为 获取节日日期(项[2], 年)
    如果 信息 不等于 空:
      追加(结果, 信息)
    设 i 为 i 加上 1
  # 公历节日
  设 i 为 0
  设 n 为 长(公历节日表)
  当 i < n:
    设 项 为 公历节日表[i]
    设 信息 为 获取节日日期(项[2], 年)
    如果 信息 不等于 空:
      追加(结果, 信息)
    设 i 为 i 加上 1
  # 按日期排序（简单冒泡，按儒略日）
  设 结果 为 按日期排序(结果)
  返回 结果

# 按日期排序（冒泡排序，按 date_str 对应的儒略日）
段落 按日期排序 接收 列表:
  设 n 为 长(列表)
  设 i 为 0
  当 i < n 减 1:
    设 j 为 0
    当 j < n 减 1 减 i:
      设 a 为 列表[j]
      设 b 为 列表[j 加上 1]
      设 da 为 日期字符串转儒略日(a["date_str"])
      设 db 为 日期字符串转儒略日(b["date_str"])
      如果 da > db:
        设 列表[j] 为 b
        设 列表[j 加上 1] 为 a
      设 j 为 j 加上 1
    设 i 为 i 加上 1
  返回 列表

段落 日期字符串转儒略日 接收 日期串:
  设 d 为 解析日期字符串(日期串)
  如果 d 等于 空:
    返回 0
  返回 公历转儒略日(d[0], d[1], d[2])

# ── 判断节日 ───────────────────────────────────────────────────────────────

段落 判断节日 接收 日期串:
  设 日期 为 解析日期字符串(日期串)
  如果 日期 等于 空:
    返回 空
  设 年 为 日期[0]
  如果 年 < 数据起始年 或 年 > 数据结束年:
    返回 空
  设 节日列表 为 获取节日列表(年)
  设 目标串 为 日期转字符串(日期[0], 日期[1], 日期[2])
  设 i 为 0
  设 n 为 长(节日列表)
  当 i < n:
    如果 节日列表[i]["date_str"] == 目标串:
      返回 节日列表[i]["name"]
    设 i 为 i 加上 1
  返回 空

# ── 获取月份节日 ───────────────────────────────────────────────────────────

段落 获取月份节日 接收 年, 月:
  设 全部 为 获取节日列表(年)
  设 结果 为 新建列表()
  设 i 为 0
  设 n 为 长(全部)
  当 i < n:
    设 d 为 解析日期字符串(全部[i]["date_str"])
    如果 d 不等于 空 且 d[1] == 月:
      追加(结果, 全部[i])
    设 i 为 i 加上 1
  返回 结果

# ── 节日倒计时（能力边界） ─────────────────────────────────────────────────
# 原生腿无系统当前日期原语，无法计算倒计时。
# 返回 -1 表示能力边界（与 .py 未找到节日时的返回值一致）。
段落 节日倒计时 接收 名称:
  返回 0 减 1
