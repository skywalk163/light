# 纯光明实现 —— 参数解析（取代同名 .py 壳）。
#
# 对齐 stdlib/参数解析.py 的能力：位置参数 / 选项参数（长 --x 与短 -x）/
# 默认值 / 类型转换 / 标志（store_true）/ 计数（count）。纯光明重写 argparse
# 核心，无标准库依赖（不 import argparse/sys；argv 用 runtime builtin 参数列表）。
#
# 原生腿无类可实例化，参数解析器以「字典」表示：
#   {"程序名": ..., "描述": ..., "版本": ..., "定义": [参数定义...], "子命令们": [...]}
# 类方法（添加参数 / 解析 / 获取 / 帮助 等）以独立段落等价提供（第一参为解析器）。
#
# 与 .py 的差异（见 docs/known_issues.md T6C 章节）：
#   - 类型参数传「类型名字符串」而非可调用对象："整数"/"浮点数"/空(=字符串)。
#   - 多值（nargs）仅消费一个值；取值列表（choices）不做强制校验。
#   - 未定义选项被忽略；重复查询键取最后一次；子命令不参与父级解析。

导出 参数解析器 简单解析 快速获取。
导出 添加参数 添加位置参数 添加子命令 解析 获取 打印帮助 帮助文本 用法文本。

段落 参数去横线 接收 名:
  设 真名 为 转字符串(名)
  设 起 为 0
  当 起 < 长(真名):
    如果 真名[起] != "-":
      返回 截取(真名, 起, 长(真名) - 起)
    设 起 为 起 + 1
  返回 真名

段落 参数目标名 接收 名:
  返回 替换(参数去横线(名), "-", "_")

段落 参数转类型 接收 值, 类型名:
  如果 类型名 == "整数":
    返回 转整数(去除空格(值))
  如果 类型名 == "浮点数":
    返回 转浮点(去除空格(值))
  返回 值

段落 参数找定义 接收 定义们, 词:
  设 i 为 0
  当 i < 长(定义们):
    设 定义项 为 定义们[i]
    设 名称 为 字典获取(定义项, "名称", "")
    设 短名 为 字典获取(定义项, "短名称", 空)
    如果 名称 == 词:
      返回 定义项
    如果 短名 != 空:
      如果 短名 == 词:
        返回 定义项
      如果 "-" + 短名 == 词:
        返回 定义项
    设 i 为 i + 1
  返回 空

段落 参数解析器 接收 程序名 = 空, 描述 = "", 版本 = 空:
  设 解析器 为 {}
  字典设置(解析器, "程序名", 程序名)
  字典设置(解析器, "描述", 描述)
  字典设置(解析器, "版本", 版本)
  字典设置(解析器, "定义", 新建列表())
  字典设置(解析器, "子命令们", 新建列表())
  返回 解析器

段落 添加参数 接收 解析器, 名称, 短名称 = 空, 值类型 = 空, 默认值 = 空, 描述 = "", 必需 = 假, 取值列表 = 空, 多值 = 假, 标志 = 假, 计数 = 假:
  设 定义项 为 {}
  字典设置(定义项, "名称", 名称)
  字典设置(定义项, "短名称", 短名称)
  字典设置(定义项, "类型", 值类型)
  字典设置(定义项, "默认值", 默认值)
  字典设置(定义项, "描述", 描述)
  字典设置(定义项, "必需", 必需)
  字典设置(定义项, "取值列表", 取值列表)
  字典设置(定义项, "多值", 多值)
  字典设置(定义项, "标志", 标志)
  字典设置(定义项, "计数", 计数)
  设 是位置 为 假
  如果 开头(名称, "-"):
    设 是位置 为 假
  否则:
    设 是位置 为 真
  字典设置(定义项, "位置", 是位置)
  字典设置(定义项, "可选", 假)
  设 定义们 为 字典获取(解析器, "定义", 新建列表())
  追加(定义们, 定义项)
  返回 空

段落 添加位置参数 接收 解析器, 名称, 值类型 = 空, 默认值 = 空, 描述 = "", 可选 = 假, 多值 = 假:
  设 定义项 为 {}
  字典设置(定义项, "名称", 名称)
  字典设置(定义项, "短名称", 空)
  字典设置(定义项, "类型", 值类型)
  字典设置(定义项, "默认值", 默认值)
  字典设置(定义项, "描述", 描述)
  字典设置(定义项, "必需", 假)
  字典设置(定义项, "取值列表", 空)
  字典设置(定义项, "多值", 多值)
  字典设置(定义项, "标志", 假)
  字典设置(定义项, "计数", 假)
  字典设置(定义项, "位置", 真)
  字典设置(定义项, "可选", 可选)
  设 定义们 为 字典获取(解析器, "定义", 新建列表())
  追加(定义们, 定义项)
  返回 空

段落 添加子命令 接收 解析器, 名称, 描述 = "":
  设 子 为 参数解析器(名称, 描述)
  字典设置(子, "子命令名", 名称)
  设 子们 为 字典获取(解析器, "子命令们", 新建列表())
  追加(子们, 子)
  返回 子

段落 解析 接收 解析器, 输入列表 = 空:
  设 列表 为 输入列表
  如果 列表 == 空:
    设 列表 为 参数列表()
  设 结果 为 {}
  设 定义们 为 字典获取(解析器, "定义", 新建列表())
  设 位置序号 为 0
  设 i 为 0
  当 i < 长(列表):
    设 词 为 转字符串(列表[i])
    如果 开头(词, "-"):
      如果 长(词) > 1:
        设 等号 为 0 - 1
        设 名 为 词
        设 值给 为 ""
        设 带值 为 假
        设 j2 为 0
        当 j2 < 长(词):
          如果 词[j2] == "=":
            设 等号 为 j2
          设 j2 为 j2 + 1
        如果 等号 >= 0:
          设 名 为 截取(词, 0, 等号)
          设 值给 为 截取(词, 等号 + 1, 长(词) - 等号 - 1)
          设 带值 为 真
        设 定义项 为 参数找定义(定义们, 名)
        如果 定义项 != 空:
          设 目标 为 参数目标名(字典获取(定义项, "名称", 名))
          设 是标志 为 字典获取(定义项, "标志", 假)
          设 是计数 为 字典获取(定义项, "计数", 假)
          如果 是标志:
            字典设置(结果, 目标, 真)
          否则如果 是计数:
            设 旧计 为 字典获取(结果, 目标, 0)
            字典设置(结果, 目标, 旧计 + 1)
          否则:
            如果 带值:
              设 类型名 为 字典获取(定义项, "类型", 空)
              字典设置(结果, 目标, 参数转类型(值给, 类型名))
            否则:
              设 有值 为 假
              设 下值 为 ""
              如果 i + 1 < 长(列表):
                设 下词 为 转字符串(列表[i + 1])
                如果 开头(下词, "-") == 假:
                  设 有值 为 真
                  设 下值 为 下词
              如果 有值:
                设 类型名 为 字典获取(定义项, "类型", 空)
                字典设置(结果, 目标, 参数转类型(下值, 类型名))
                设 i 为 i + 1
              否则:
                设 默认 为 字典获取(定义项, "默认值", 空)
                如果 默认 != 空:
                  字典设置(结果, 目标, 默认)
                否则:
                  字典设置(结果, 目标, "")
    否则:
      设 目标位置 为 ""
      设 已匹配 为 假
      设 j 为 0
      设 游标 为 0
      当 j < 长(定义们):
        设 定义项 为 定义们[j]
        如果 字典获取(定义项, "位置", 假):
          如果 游标 == 位置序号:
            设 目标位置 为 参数目标名(字典获取(定义项, "名称", ""))
            设 类型名 为 字典获取(定义项, "类型", 空)
            字典设置(结果, 目标位置, 参数转类型(词, 类型名))
            设 已匹配 为 真
            设 j 为 长(定义们)
          否则:
            设 游标 为 游标 + 1
        设 j 为 j + 1
      如果 已匹配:
        设 位置序号 为 位置序号 + 1
    设 i 为 i + 1
  设 k 为 0
  当 k < 长(定义们):
    设 定义项 为 定义们[k]
    设 名称 为 字典获取(定义项, "名称", "")
    设 目标 为 参数目标名(名称)
    如果 字典包含键(结果, 目标) == 假:
      如果 字典获取(定义项, "标志", 假):
        字典设置(结果, 目标, 假)
      否则如果 字典获取(定义项, "计数", 假):
        字典设置(结果, 目标, 0)
      否则:
        设 默认 为 字典获取(定义项, "默认值", 空)
        如果 默认 != 空:
          字典设置(结果, 目标, 默认)
        否则:
          字典设置(结果, 目标, "")
    设 k 为 k + 1
  返回 结果

段落 获取 接收 解析器, 参数名, 默认值 = 空:
  设 结果 为 字典获取(解析器, "结果", 空)
  如果 结果 == 空:
    设 结果 为 解析(解析器, 空)
    字典设置(解析器, "结果", 结果)
  返回 字典获取(结果, 参数目标名(参数名), 默认值)

段落 用法文本 接收 解析器:
  设 行 为 "用法: "
  设 程序名 为 字典获取(解析器, "程序名", 空)
  如果 程序名 == 空:
    设 行 为 行 + "程序"
  否则:
    设 行 为 行 + 程序名
  设 行 为 行 + " [选项] [参数...]"
  返回 行

段落 帮助文本 接收 解析器:
  设 文本 为 用法文本(解析器)
  设 描述 为 字典获取(解析器, "描述", "")
  如果 描述 != "":
    设 文本 为 文本 + "\n\n" + 描述
  设 定义们 为 字典获取(解析器, "定义", 新建列表())
  如果 长(定义们) > 0:
    设 文本 为 文本 + "\n\n参数:"
    设 i 为 0
    当 i < 长(定义们):
      设 定义项 为 定义们[i]
      设 名称 为 字典获取(定义项, "名称", "")
      设 短名 为 字典获取(定义项, "短名称", 空)
      设 描述2 为 字典获取(定义项, "描述", "")
      设 行 为 "\n  "
      如果 短名 != 空:
        设 行 为 行 + 短名 + ", "
      设 行 为 行 + 名称
      如果 描述2 != "":
        设 行 为 行 + "  " + 描述2
      设 文本 为 文本 + 行
      设 i 为 i + 1
  返回 文本

段落 打印帮助 接收 解析器:
  输出(帮助文本(解析器))

段落 简单解析 接收 参数定义, 输入参数 = 空:
  设 解析器 为 参数解析器()
  设 i 为 0
  当 i < 长(参数定义):
    设 定义项 为 参数定义[i]
    设 名 为 字典获取(定义项, "名称", "")
    设 是位置 为 字典获取(定义项, "位置", 假)
    如果 是位置:
      添加位置参数(解析器, 名, 字典获取(定义项, "类型", 空), 字典获取(定义项, "默认值", 空), 字典获取(定义项, "描述", ""), 字典获取(定义项, "可选", 假), 字典获取(定义项, "多值", 假))
    否则:
      添加参数(解析器, 名, 字典获取(定义项, "短名称", 空), 字典获取(定义项, "类型", 空), 字典获取(定义项, "默认值", 空), 字典获取(定义项, "描述", ""), 字典获取(定义项, "必需", 假), 字典获取(定义项, "取值列表", 空), 字典获取(定义项, "多值", 假), 字典获取(定义项, "标志", 假), 字典获取(定义项, "计数", 假))
    设 i 为 i + 1
  返回 解析(解析器, 输入参数)

段落 快速获取 接收 参数名, 默认值 = 空, 输入参数 = 空:
  设 解析器 为 参数解析器()
  如果 开头(参数名, "--"):
    添加参数(解析器, 参数名, 空, 空, 默认值)
  否则:
    添加位置参数(解析器, 参数名, 空, 默认值, "", 真)
  设 结果 为 解析(解析器, 输入参数)
  返回 字典获取(结果, 参数目标名(参数名), 默认值)
