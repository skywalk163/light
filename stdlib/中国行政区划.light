# ── 内部：在所有数据组中查找省份 ───────────────────────────────────────────

段落 查找省份 接收 名称:
  设 组 为 省级数据组1()
  设 r 为 查找省份在组(组, 名称)
  如果 r 不等于 空:
    返回 r
  设 组 为 省级数据组2()
  设 r 为 查找省份在组(组, 名称)
  如果 r 不等于 空:
    返回 r
  设 组 为 省级数据组3()
  设 r 为 查找省份在组(组, 名称)
  如果 r 不等于 空:
    返回 r
  设 组 为 省级数据组4()
  设 r 为 查找省份在组(组, 名称)
  如果 r 不等于 空:
    返回 r
  设 组 为 省级数据组5()
  设 r 为 查找省份在组(组, 名称)
  如果 r 不等于 空:
    返回 r
  设 组 为 省级数据组6()
  返回 查找省份在组(组, 名称)

段落 查找省份在组 接收 数据组, 名称:
  设 i 为 0
  设 n 为 长(数据组)
  当 i < n:
    如果 数据组[i][0] == 名称:
      返回 数据组[i]
    设 i 为 i 加上 1
  返回 空

# ── 查询函数 ───────────────────────────────────────────────────────────────

段落 获取省份列表:
  设 结果 为 新建列表()
  设 g 为 1
  当 g <= 6:
    设 组 为 省份组(g)
    设 i 为 0
    当 i < 长(组):
      追加(结果, 组[i][0])
      设 i 为 i 加上 1
    设 g 为 g 加上 1
  返回 结果

# 按组号取省级数据组（1-6）
段落 省份组 接收 g:
  如果 g == 1:
    返回 省级数据组1()
  如果 g == 2:
    返回 省级数据组2()
  如果 g == 3:
    返回 省级数据组3()
  如果 g == 4:
    返回 省级数据组4()
  如果 g == 5:
    返回 省级数据组5()
  返回 省级数据组6()

段落 获取城市列表 接收 省名:
  设 省 为 查找省份(省名)
  如果 省 等于 空:
    返回 新建列表()
  返回 省[2]

段落 获取区县列表 接收 省名, 市名:
  设 组 为 区县数据组1()
  设 i 为 0
  当 i < 长(组):
    如果 组[i][0] == 省名 且 组[i][1] == 市名:
      返回 组[i][2]
    设 i 为 i 加上 1
  设 组 为 区县数据组2()
  设 i 为 0
  当 i < 长(组):
    如果 组[i][0] == 省名 且 组[i][1] == 市名:
      返回 组[i][2]
    设 i 为 i 加上 1
  设 组 为 区县数据组3()
  设 i 为 0
  当 i < 长(组):
    如果 组[i][0] == 省名 且 组[i][1] == 市名:
      返回 组[i][2]
    设 i 为 i 加上 1
  返回 新建列表()

段落 验证省份 接收 名称:
  返回 查找省份(名称) 不等于 空

段落 验证城市 接收 省名, 市名:
  设 城市 为 获取城市列表(省名)
  设 i 为 0
  设 n 为 长(城市)
  当 i < n:
    如果 城市[i] == 市名:
      返回 真
    设 i 为 i 加上 1
  返回 假

# 查城市 4 位代码（在分段组中顺序查找）
段落 查城市代码 接收 名称:
  设 g 为 1
  当 g <= 9:
    设 组 为 城市代码组(g)
    设 i 为 0
    当 i < 长(组):
      如果 组[i][0] == 名称:
        返回 组[i][1]
      设 i 为 i 加上 1
    设 g 为 g 加上 1
  返回 ""

# 按组号取城市代码组（1-9）
段落 城市代码组 接收 g:
  如果 g == 1:
    返回 城市代码组1()
  如果 g == 2:
    返回 城市代码组2()
  如果 g == 3:
    返回 城市代码组3()
  如果 g == 4:
    返回 城市代码组4()
  如果 g == 5:
    返回 城市代码组5()
  如果 g == 6:
    返回 城市代码组6()
  如果 g == 7:
    返回 城市代码组7()
  如果 g == 8:
    返回 城市代码组8()
  返回 城市代码组9()

段落 获取行政区划代码 接收 名称:
  # 先查省级
  设 省 为 查找省份(名称)
  如果 省 不等于 空:
    返回 省[1] 加上 "0000"
  # 再查城市级（4 位码补 "00" 成 6 位，与 .py 格式一致）
  设 码 为 查城市代码(名称)
  如果 码 不等于 "":
    返回 码 加上 "00"
  返回 ""
