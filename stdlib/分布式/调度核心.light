# 纯光明实现 —— 分布式调度器（master）：注册 / 领任务 / 交结果 / 心跳 / 注销
#                         + 幂等去重表 + 结果汇聚 + 失联检测与重派
#
# 这是第九轮 S2「master/worker 最小闭环」的调度侧。传输层复用 stdlib/HTTP服务端.light
# （JSON-RPC over HTTP/1.1，线协议见 任务书/分布式线协议.json）。所有「系统边界」
# （socket/json/单调时钟/随机标识/异步并发原语/事件）都收口在 节点网络.py 与
# 并发.light（有界队列类，E9-S2 从 队列.py 提升、纯光明实现），本文件零直调。
#
# 九条判据里这一侧直接担：分发 / 心跳 / 重派 / 幂等 / 结果汇聚（S2 → done）；
# 背压 走 并发.light 有界队列类（S2 → done 判据见 tests/test_distributed_eval_light.py）；
# 限流 滑动窗口类 未接生产路径（全仓零调用点）→ 维持 partial，见交付报告_并发内核S2.md。
#
# 处理器契约：HTTP服务端 把每个连接交给「异步 段落 主控处理器 接收 请求」，请求字典
#   ["方法","路径","头","体"]；体是 JSON-RPC 请求字节。本处理器解析后分派，
#   返回 ["状态":200,"头":...,"体":<JSON-RPC 响应字符串>]。
#   光明类体已支持 异步 段落（src/parser_stmt.py:4423，本类就有 5 个），此处保留
#   模块级段落 + 单例绕法不动（签名兼容，不破消费侧）。

从 节点网络 导入 解析, 序列化, 单调, 墙钟, 生成任务ID, 生成幂等键, 生成令牌, 常量比较, 是节点ID, 取头值, 写文本, 读文本, 新建事件, 事件设置, 等待事件
从 并发 导入 有界队列类
从 HTTP服务端 导入 HTTP服务端, 处理循环


# ---------------------------------------------------------------------------
# 主控（调度器）
# ---------------------------------------------------------------------------
类 主控:
  设 状态文件 等于 ""
  设 报告文件 等于 ""
  设 任务表 等于 []
  设 总数 等于 0
  设 队列 等于 空
  设 工人 等于 {}
  设 结果表 等于 {}
  设 在跑 等于 {}
  设 失联 等于 []
  设 去重数 等于 0
  设 每节点 等于 {}
  设 心跳超时 等于 1.5
  设 完成事件 等于 空
  设 运行 等于 真

  段落 构造 接收:
    设 己.状态文件 为 ""
    设 己.报告文件 为 ""
    设 己.任务表 为 []
    设 己.总数 为 0
    设 己.队列 为 空
    设 己.工人 为 {}
    设 己.结果表 为 {}
    设 己.在跑 为 {}
    设 己.失联 为 []
    设 己.去重数 为 0
    设 己.每节点 为 {}
    设 己.心跳超时 为 1.5
    设 己.完成事件 为 空
    设 己.运行 为 真

  # 加载任务文件并建队列（容量 = 有界队列上界，背压语义见 并发.light 有界队列类）
  # S2 不做任务级超时重派：任务超时/截止时间 字段已随返工单 §3-2 删除，
  # 任务级超时是 M24 harness 层的语义（执行超时在 worker 侧掐），不在调度侧。
  异步 段落 配置 接收 自, 状态文件, 报告文件, 任务文件, 容量, 心跳超时:
    设 己.状态文件 为 状态文件
    设 己.报告文件 为 报告文件
    设 己.心跳超时 为 心跳超时
    设 原文 为 读文本(任务文件)
    设 数据 为 解析(原文)
    设 条目 为 数据["条目"]
    设 己.任务表 为 []
    遍历 项 之 条目:
      设 任务 为 ["任务ID": 生成任务ID(), "幂等键": 生成幂等键(), "输入": 项, "重派计数": 0, "创建时间": 墙钟()]
      己.任务表.追加(任务)
    设 己.总数 为 长(己.任务表)
    设 己.队列 为 有界队列类(容量)
    设 己.完成事件 为 新建事件()

  异步 段落 入队全部 接收 自:
    遍历 任务 之 己.任务表:
      等待 己.队列.入队(任务)

  # ---- 注册：签发会话令牌，S2 起 X-Auth-Token 强制 ----
  段落 处理注册 接收 自, 参数:
    设 节点ID 为 参数.get("节点ID", "")
    设 并发度 为 参数.get("并发度", 1)
    设 版本 为 参数.get("协议版本", "")
    如果 非 是节点ID(节点ID):
      返回 [空, ["码": 102, "消息": "节点ID 非法"]]
    如果 版本 != "1.0":
      返回 [空, ["码": 100, "消息": "协议版本不兼容"]]
    设 令牌 为 生成令牌()
    设 己.工人[节点ID] 为 ["会话令牌": 令牌, "并发度": 并发度, "最后心跳": 单调(), "在跑": []]
    返回 [["节点ID": 节点ID, "注册时间": 墙钟(), "会话令牌": 令牌], 空]

  # ---- 鉴权：取 worker 节点ID + 校验 X-Auth-Token（常量时间）----
  # 返回 [工人, 错误]；错误 为 空 表示通过，否则是 "未注册" / "未认证"
  段落 取工人 接收 自, 参数, 头:
    设 节点ID 为 参数.get("节点ID", "")
    # 注意：局部变量不能叫 `工人`（会与实例属性 己.工人 撞名，编译器把裸 `工人`
    # 当成 self.工人 导致每次调用把整个工人表覆盖成单条），这里用 工条目。
    设 工条目 为 己.工人.get(节点ID, 空)
    如果 工条目 == 空:
      返回 [空, "未注册"]
    设 令牌 为 取头值(头, "X-Auth-Token", "")
    如果 非 常量比较(令牌, 工条目["会话令牌"]):
      返回 [空, "未认证"]
    返回 [工条目, 空]

  # ---- 领任务：从有界队列取一条，登记在跑 + 当前幂等键 ----
  异步 段落 处理领任务 接收 自, 工人, 参数:
    设 节点ID 为 参数.get("节点ID", "")
    如果 己.队列.是否空():
      设 全部完成 为 (长(己.结果表) == 己.总数)
      返回 [["任务": 空, "全部完成": 全部完成], 空]
    设 任务 为 等待 己.队列.出队()
    设 己.在跑[任务["任务ID"]] 为 ["节点ID": 节点ID, "幂等键": 任务["幂等键"], "输入": 任务["输入"], "重派计数": 任务["重派计数"], "创建时间": 任务["创建时间"]]
    返回 [["任务": 任务, "全部完成": 假], 空]

  # ---- 交结果：幂等去重（按 任务ID），重派换键不影响「只计一次分」----
  段落 处理交结果 接收 自, 工人, 参数:
    设 节点ID 为 参数.get("节点ID", "")
    设 任务ID 为 参数.get("任务ID", "")
    设 幂等键 为 参数.get("幂等键", "")
    设 结果 为 参数.get("结果", {})
    如果 任务ID 不在 己.结果表:
      # 首次结算：校验 幂等键 是否匹配当前派发（防旧派发串号）
      设 派发 为 己.在跑.get(任务ID, 空)
      如果 派发 == 空:
        # 既不在结果表也不在在跑：可能已重派且新派发已完成，或从未派发 → 视为过期，去重记账
        设 己.去重数 为 己.去重数 + 1
        返回 [["已接受": 假, "去重数": 己.去重数], 空]
      如果 派发["幂等键"] != 幂等键:
        # 幂等键 与当前派发不匹配（拿到的是被重派顶掉的旧键）→ 拒绝
        返回 [["已接受": 假, "去重数": 己.去重数], ["码": 102, "消息": "幂等键不匹配当前派发"]]
      # 接受首次结算（只计一次分）
      设 己.结果表[任务ID] 为 结果
      设 己.每节点[节点ID] 为 己.每节点.get(节点ID, 0) + 1
      己.在跑.pop(任务ID, 空)
      返回 [["已接受": 真, "去重数": 己.去重数], 空]
    否则:
      # 重复上报：去重记账，丢弃且不二次计分
      设 己.去重数 为 己.去重数 + 1
      返回 [["已接受": 假, "去重数": 己.去重数], 空]

  # ---- 心跳：刷新最后心跳，返回心跳窗口内 master 要求中断的任务 ----
  段落 处理心跳 接收 自, 工人, 参数:
    设 节点ID 为 参数.get("节点ID", "")
    如果 节点ID 在 己.工人:
      设 己.工人[节点ID]["最后心跳"] 为 单调()
    返回 [["取消": [], "确认": 真], 空]

  # ---- 注销：优雅退出，在跑任务标记可重派 ----
  异步 段落 处理注销 接收 自, 工人, 参数:
    设 节点ID 为 参数.get("节点ID", "")
    如果 节点ID 在 己.工人:
      设 待重派 为 []
      遍历 任务ID 之 己.在跑:
        如果 己.在跑[任务ID]["节点ID"] == 节点ID:
          待重派.追加(任务ID)
      遍历 任务ID 之 待重派:
        设 任务 为 己.在跑[任务ID]
        设 新键 为 生成幂等键()
        设 新任务 为 ["任务ID": 任务ID, "幂等键": 新键, "输入": 任务["输入"], "重派计数": 任务["重派计数"] + 1, "创建时间": 任务["创建时间"]]
        等待 己.队列.入队(新任务)
        己.在跑.pop(任务ID, 空)
      己.工人.pop(节点ID, 空)
    返回 [["节点ID": 节点ID], 空]

  # ---- 监控循环：失联检测 + 重派 + 完成判定（每 0.1s 一轮）----
  # 注意两阶段：光明 `遍历 键 之 字典` 直接迭代 dict，循环体内 pop 会抛
  # RuntimeError(dictionary changed size during iteration)——第一遍只读收集
  # 过期节点，第二遍才做 重派/移除，绝不在遍历 己.工人/己.在跑 的同时改它们。
  异步 段落 监控循环 接收 自:
    当 己.运行:
      设 现在 为 单调()
      设 过期 为 []
      遍历 节点ID 之 己.工人:
        设 工 为 己.工人[节点ID]
        如果 现在 - 工["最后心跳"] > 己.心跳超时:
          过期.追加(节点ID)
      遍历 节点ID 之 过期:
        如果 节点ID 不在 己.失联:
          己.失联.追加(节点ID)
        设 待重派 为 []
        遍历 任务ID 之 己.在跑:
          如果 己.在跑[任务ID]["节点ID"] == 节点ID:
            待重派.追加(任务ID)
        遍历 任务ID 之 待重派:
          设 任务 为 己.在跑[任务ID]
          设 新键 为 生成幂等键()
          设 新任务 为 ["任务ID": 任务ID, "幂等键": 新键, "输入": 任务["输入"], "重派计数": 任务["重派计数"] + 1, "创建时间": 任务["创建时间"]]
          等待 己.队列.入队(新任务)
          己.在跑.pop(任务ID, 空)
        己.工人.pop(节点ID, 空)
      写文本(己.状态文件, 序列化(["失联节点": 己.失联, "已汇聚": 长(己.结果表), "总数": 己.总数, "队列剩余": 己.队列.大小(), "在跑": 长(己.在跑)]))
      如果 长(己.结果表) == 己.总数 且 己.队列.是否空() 且 长(己.在跑) == 0:
        事件设置(己.完成事件)
        跳出
      等待 异步睡眠(0.1)

  # ---- 报告 ----
  段落 报告 接收 自:
    返回 ["总数": 己.总数, "完成": 长(己.结果表), "条目": 己.结果表, "每节点": 己.每节点, "失联节点": 己.失联, "去重数": 己.去重数]


# 模块级单例：处理器（光明类体不能放 异步 段落）通过它拿到调度状态。
设 主控实例 为 新建 主控()


# ---------------------------------------------------------------------------
# RPC 处理器：HTTP 服务端每连接回调。请求体 = JSON-RPC 请求字节。
# ---------------------------------------------------------------------------
异步 段落 主控处理器 接收 请求:
  设 载荷 为 解析(请求["体"])
  设 方法名 为 载荷.get("方法", "")
  设 参数 为 载荷.get("参数", {})
  设 编号 为 载荷.get("id", 0)
  设 头 为 请求["头"]
  设 主控 为 主控实例
  设 结果 为 空
  设 错误 为 空
  如果 方法名 == "注册":
    设 对 为 主控.处理注册(参数)
    设 结果 为 对[0]
    设 错误 为 对[1]
  否则 如果 方法名 == "领任务":
    设 查 为 主控.取工人(参数, 头)
    如果 查[1] == "未注册":
      设 错误 为 ["码": 103, "消息": "未注册"]
    否则 如果 查[1] == "未认证":
      设 错误 为 ["码": 103, "消息": "未认证"]
    否则:
      设 对 为 等待 主控.处理领任务(查[0], 参数)
      设 结果 为 对[0]
      设 错误 为 对[1]
  否则 如果 方法名 == "交结果":
    设 查 为 主控.取工人(参数, 头)
    如果 查[1] == "未注册":
      设 错误 为 ["码": 103, "消息": "未注册"]
    否则 如果 查[1] == "未认证":
      设 错误 为 ["码": 103, "消息": "未认证"]
    否则:
      设 对 为 主控.处理交结果(查[0], 参数)
      设 结果 为 对[0]
      设 错误 为 对[1]
  否则 如果 方法名 == "心跳":
    设 查 为 主控.取工人(参数, 头)
    如果 查[1] == "未注册":
      设 错误 为 ["码": 103, "消息": "未注册"]
    否则 如果 查[1] == "未认证":
      设 错误 为 ["码": 103, "消息": "未认证"]
    否则:
      设 对 为 主控.处理心跳(查[0], 参数)
      设 结果 为 对[0]
      设 错误 为 对[1]
  否则 如果 方法名 == "注销":
    设 查 为 主控.取工人(参数, 头)
    如果 查[1] == "未注册":
      设 错误 为 ["码": 103, "消息": "未注册"]
    否则 如果 查[1] == "未认证":
      设 错误 为 ["码": 103, "消息": "未认证"]
    否则:
      设 对 为 等待 主控.处理注销(查[0], 参数)
      设 结果 为 对[0]
      设 错误 为 对[1]
  否则:
    设 错误 为 ["码": 104, "消息": "未知方法"]
  设 体 为 序列化(["jsonrpc": "2.0", "结果": 结果, "错误": 错误, "id": 编号])
  返回 ["状态": 200, "头": ["Content-Type": "application/json; charset=utf-8"], "体": 体]


# ---------------------------------------------------------------------------
# 主入口：起 HTTP 服务端（端口 0 内核分配，写回端口文件）+ 监控循环 + 入队生产者，
# 等到全部汇聚后写报告、停服。
# ---------------------------------------------------------------------------
异步 段落 主 接收 端口文件, 状态文件, 报告文件, 任务文件, 容量, 心跳超时:
  等待 主控实例.配置(状态文件, 报告文件, 任务文件, 容量, 心跳超时)
  设 服务端 为 HTTP服务端(主控处理器, 5.0)
  写文本(端口文件, 转字符串(服务端.端口()))
  设 循环任务 为 创建任务(处理循环(服务端))
  设 监控任务 为 创建任务(主控实例.监控循环())
  设 入队任务 为 创建任务(主控实例.入队全部())
  等待 等待事件(主控实例.完成事件)
  写文本(报告文件, 序列化(主控实例.报告()))
  # 优雅退出：先通知监控循环停（己.运行=假），再停服务端；两个循环都会自然退出，
  # 不靠 cancel 注入 CancelledError（光明 捕获 异常 不兜 BaseException，会漏成协程崩溃）。
  设 主控实例.运行 为 假
  服务端.停止()
  尝试:
    等待 循环任务
  捕获 异常 e:
    返回 空
  尝试:
    等待 监控任务
  捕获 异常 e:
    返回 空
  尝试:
    等待 入队任务
  捕获 异常 e:
    返回 空

导出 主控实例
导出 主控处理器
导出 主
