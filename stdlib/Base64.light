# 纯光明实现 —— Base64 / Base16 / Base32 编解码（取代同名 .py 壳）。
#
# 设计：
#   Base64 编解码       -> 走已注册 runtime builtin（_b64_encode / _b64_decode），字节级一致。
#   Base64URL 变体      -> runtime Base64 + 字符替换（+/ <-> -_）+ 填充补全。
#   Base16 / Base32     -> 纯光明查表实现（无专用 runtime）。
#   Base64验证          -> 纯光明字符集校验。
#   文件变体            -> 复用 读取文件 / 写入文件 builtin。
#
# 字节口径：所有编解码均对输入字符串的 UTF-8 字节操作，与 Python base64 / hashlib 一致。
#
# 方言约定（原生后端 O0 实测）：
#   - 取模 / 整除 一律用函数式（中缀形式对变量左操作数解析失败）。
#   - 字符串不可直接遍历，一律用 长(s) + s[i] 索引。
#   - 布尔链用顺序 如果，不用 且/或 组合（避免行内布尔求值差异）。

导出 Base64编码 Base64解码 Base64编码字节 Base64解码字节。
导出 Base64URL编码 Base64URL解码 Base16编码 Base16解码 Base32编码 Base32解码。
导出 Base64验证 Base64编码文件 Base64解码文件。

设 B16 为 "0123456789ABCDEF"
设 B32 为 "ABCDEFGHIJKLMNOPQRSTUVWXYZ234567"

# ── Base64（runtime）──
段落 Base64编码 接收 数据:
  返回 _b64_encode(数据)

段落 Base64解码 接收 数据:
  返回 _b64_decode(数据)

段落 Base64编码字节 接收 数据:
  返回 _b64_encode(数据)

段落 Base64解码字节 接收 数据:
  返回 _b64_decode(数据)

# ── Base64URL ──
段落 Base64URL编码 接收 数据:
  设 标准 为 _b64_encode(数据)
  设 改 为 替换(标准, "+", "-")
  返回 替换(改, "/", "_")

段落 Base64URL解码 接收 数据:
  设 补 为 数据
  设 blen 为 长(补)
  设 余 为 取模(blen, 4)
  设 缺 为 4 减去 余
  如果 缺 != 4:
    设 填充 为 重复("=", 缺)
    设 补 为 补 加上 填充
  设 改 为 替换(补, "-", "+")
  设 标准 为 替换(改, "_", "/")
  返回 _b64_decode(标准)

# ── Base16（纯光明查表）──
段落 _b16val 接收 c:
  设 o 为 码位(c)
  如果 o >= 48:
    如果 o <= 57:
      返回 o 减去 48
  如果 o >= 65:
    如果 o <= 70:
      返回 o 减去 55
  如果 o >= 97:
    如果 o <= 102:
      返回 o 减去 87
  返回 -1

# 字节口径说明：
#   原生后端字符串索引按「字符」而非 UTF-8 字节，故纯光明实现的 Base16/Base32
#   统一以「十六进制串」作字节中间表示（每字节 2 个 hex 字符），
#   从而与 Python base64（UTF-8 字节口径）逐字节对拍一致。

# 单字节 -> 2 位十六进制
段落 _hex2 接收 b:
  设 hi 为 整除(b, 16)
  设 lo 为 取模(b, 16)
  返回 B16[hi] 加上 B16[lo]

# 从十六进制串取第 k 个字节（0 基）
段落 _hexbyte 接收 hx, k:
  设 p 为 2 乘以 k
  设 hi 为 _b16val(hx[p])
  设 lo 为 _b16val(hx[p 加上 1])
  返回 hi 乘以 16 加上 lo

# 十六进制串 -> 字节 -> UTF-8 解码 -> 字符串
段落 _解UTF8 接收 hx:
  设 nb 为 整除(长(hx), 2)
  设 结果 为 ""
  设 k 为 0
  当 k < nb:
    设 b 为 _hexbyte(hx, k)
    如果 b < 128:
      设 结果 为 结果 加上 字符自码位(b)
      设 k 为 k 加上 1
    否则:
      如果 b < 224:
        设 b2 为 _hexbyte(hx, k 加上 1)
        设 结果 为 结果 加上 字符自码位(取模(b, 32) 乘以 64 加上 取模(b2, 64))
        设 k 为 k 加上 2
      否则:
        如果 b < 240:
          设 b2 为 _hexbyte(hx, k 加上 1)
          设 b3 为 _hexbyte(hx, k 加上 2)
          设 结果 为 结果 加上 字符自码位(取模(b, 16) 乘以 4096 加上 取模(b2, 64) 乘以 64 加上 取模(b3, 64))
          设 k 为 k 加上 3
        否则:
          设 b2 为 _hexbyte(hx, k 加上 1)
          设 b3 为 _hexbyte(hx, k 加上 2)
          设 b4 为 _hexbyte(hx, k 加上 3)
          设 结果 为 结果 加上 字符自码位(取模(b, 8) 乘以 262144 加上 取模(b2, 64) 乘以 4096 加上 取模(b3, 64) 乘以 64 加上 取模(b4, 64))
          设 k 为 k 加上 4
  返回 结果

段落 Base16编码 接收 数据:
  设 n 为 长(数据)
  设 结果 为 ""
  设 i 为 0
  当 i < n:
    设 o 为 码位(数据[i])
    如果 o < 128:
      设 结果 为 结果 加上 _hex2(o)
    否则:
      如果 o < 2048:
        设 结果 为 结果 加上 _hex2(192 加上 整除(o, 64)) 加上 _hex2(128 加上 取模(o, 64))
      否则:
        如果 o < 65536:
          设 结果 为 结果 加上 _hex2(224 加上 整除(o, 4096)) 加上 _hex2(128 加上 取模(整除(o, 64), 64)) 加上 _hex2(128 加上 取模(o, 64))
        否则:
          设 结果 为 结果 加上 _hex2(240 加上 整除(o, 262144)) 加上 _hex2(128 加上 取模(整除(o, 4096), 64)) 加上 _hex2(128 加上 取模(整除(o, 64), 64)) 加上 _hex2(128 加上 取模(o, 64))
    设 i 为 i 加上 1
  返回 结果

段落 Base16解码 接收 数据:
  返回 _解UTF8(大写(数据))

# ── Base32（纯光明查表 + 算术合并，无位运算符）──
段落 _b32val 接收 c:
  设 o 为 码位(c)
  如果 o >= 65:
    如果 o <= 90:
      返回 o 减去 65
  如果 o >= 97:
    如果 o <= 122:
      返回 o 减去 97
  如果 o >= 50:
    如果 o <= 55:
      返回 o 减去 24
  返回 -1

# 编码：5 字节 -> 40 位整数 -> 8 个 5 位组（整除 2^(35-5g) 再取模 32）
设 B32_GROUP 为 列(34359738368, 1073741824, 33554432, 1048576, 32768, 1024, 32, 1)

段落 Base32编码 接收 数据:
  设 hx 为 Base16编码(数据)
  设 nb 为 整除(长(hx), 2)
  # 总输出字符数 = 完整组数*8 + 末组有效字符数(0,2,4,5,7)
  设 q 为 整除(nb, 5)
  设 r 为 取模(nb, 5)
  设 tot 为 q 乘以 8
  如果 r == 1:
    设 tot 为 tot 加上 2
  如果 r == 2:
    设 tot 为 tot 加上 4
  如果 r == 3:
    设 tot 为 tot 加上 5
  如果 r == 4:
    设 tot 为 tot 加上 7
  设 结果 为 ""
  设 已 为 0
  设 i 为 0
  当 i < nb:
    设 b0 为 _hexbyte(hx, i)
    设 b1 为 0
    设 b2 为 0
    设 b3 为 0
    设 b4 为 0
    如果 i 加上 1 < nb:
      设 b1 为 _hexbyte(hx, i 加上 1)
    如果 i 加上 2 < nb:
      设 b2 为 _hexbyte(hx, i 加上 2)
    如果 i 加上 3 < nb:
      设 b3 为 _hexbyte(hx, i 加上 3)
    如果 i 加上 4 < nb:
      设 b4 为 _hexbyte(hx, i 加上 4)
    设 val 为 b0 乘以 4294967296 加上 b1 乘以 16777216 加上 b2 乘以 65536 加上 b3 乘以 256 加上 b4
    设 g 为 0
    当 g < 8:
      如果 已 < tot:
        设 组 为 取模(整除(val, B32_GROUP[g]), 32)
        设 结果 为 结果 加上 B32[组]
        设 已 为 已 加上 1
      设 g 为 g 加上 1
    设 i 为 i 加上 5
  如果 r == 1:
    返回 结果 加上 "======"
  如果 r == 2:
    返回 结果 加上 "===="
  如果 r == 3:
    返回 结果 加上 "==="
  如果 r == 4:
    返回 结果 加上 "="
  返回 结果

# 解码：8 个 5 位组 -> 40 位整数 -> 5 字节（整除 2^(32-8k) 再取模 256）
段落 Base32解码 接收 数据:
  设 u 为 大写(数据)
  设 去 为 ""
  设 i 为 0
  当 i < 长(u):
    如果 u[i] != "=":
      设 去 为 去 加上 u[i]
    设 i 为 i 加上 1
  设 n 为 长(去)
  # 总输出字节数 = 完整组数*5 + 末组有效字节数(r=2→1,4→2,5→3,7→4)
  设 full 为 整除(n, 8)
  设 r 为 取模(n, 8)
  设 totb 为 full 乘以 5
  如果 r == 2:
    设 totb 为 totb 加上 1
  如果 r == 4:
    设 totb 为 totb 加上 2
  如果 r == 5:
    设 totb 为 totb 加上 3
  如果 r == 7:
    设 totb 为 totb 加上 4
  设 结果 为 ""
  设 已 为 0
  设 j 为 0
  当 j < n:
    设 v0 为 _b32val(去[j])
    设 v1 为 0
    设 v2 为 0
    设 v3 为 0
    设 v4 为 0
    设 v5 为 0
    设 v6 为 0
    设 v7 为 0
    如果 j 加上 1 < n:
      设 v1 为 _b32val(去[j 加上 1])
    如果 j 加上 2 < n:
      设 v2 为 _b32val(去[j 加上 2])
    如果 j 加上 3 < n:
      设 v3 为 _b32val(去[j 加上 3])
    如果 j 加上 4 < n:
      设 v4 为 _b32val(去[j 加上 4])
    如果 j 加上 5 < n:
      设 v5 为 _b32val(去[j 加上 5])
    如果 j 加上 6 < n:
      设 v6 为 _b32val(去[j 加上 6])
    如果 j 加上 7 < n:
      设 v7 为 _b32val(去[j 加上 7])
    设 val 为 v0 乘以 34359738368 加上 v1 乘以 1073741824 加上 v2 乘以 33554432 加上 v3 乘以 1048576 加上 v4 乘以 32768 加上 v5 乘以 1024 加上 v6 乘以 32 加上 v7
    设 b0 为 取模(整除(val, 4294967296), 256)
    设 b1 为 取模(整除(val, 16777216), 256)
    设 b2 为 取模(整除(val, 65536), 256)
    设 b3 为 取模(整除(val, 256), 256)
    设 b4 为 取模(val, 256)
    如果 已 < totb:
      设 结果 为 结果 加上 _hex2(b0)
      设 已 为 已 加上 1
    如果 已 < totb:
      设 结果 为 结果 加上 _hex2(b1)
      设 已 为 已 加上 1
    如果 已 < totb:
      设 结果 为 结果 加上 _hex2(b2)
      设 已 为 已 加上 1
    如果 已 < totb:
      设 结果 为 结果 加上 _hex2(b3)
      设 已 为 已 加上 1
    如果 已 < totb:
      设 结果 为 结果 加上 _hex2(b4)
      设 已 为 已 加上 1
    设 j 为 j 加上 8
  返回 _解UTF8(结果)

# ── Base64 验证 ──
段落 Base64验证 接收 数据:
  设 n 为 长(数据)
  如果 取模(n, 4) != 0:
    返回 假
  设 i 为 0
  当 i < n:
    设 c 为 数据[i]
    设 o 为 码位(c)
    设 合法 为 0
    如果 o >= 65:
      如果 o <= 90:
        设 合法 为 1
    如果 o >= 97:
      如果 o <= 122:
        设 合法 为 1
    如果 o >= 48:
      如果 o <= 57:
        设 合法 为 1
    如果 o == 43:
      设 合法 为 1
    如果 o == 47:
      设 合法 为 1
    如果 o == 61:
      设 合法 为 1
    如果 合法 == 0:
      返回 假
    设 i 为 i 加上 1
  返回 真

# ── 文件变体 ──
段落 Base64编码文件 接收 输入文件, 输出文件:
  设 数据 为 读取文件(输入文件)
  设 结果 为 _b64_encode(数据)
  写入文件(输出文件, 结果)
  返回 结果

段落 Base64解码文件 接收 输入文件, 输出文件:
  设 数据 为 读取文件(输入文件)
  设 解码 为 _b64_decode(数据)
  写入文件(输出文件, 解码)
  返回 解码
