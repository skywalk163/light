# 纯光明实现（R115-SB 自举收尾）—— 对齐 stdlib/颜色处理.py 公开 API
# RGB/HEX/HSL/HSV/CMYK 互转、混合、亮度调整、随机色、渐变色全部纯算法重写。
# re 在 .py 中为未使用的死导入，十六进制解析以字符级扫描替代；random 委托《随机》随机整数。
# 全部只用光明内置原语与 _light_builtin（向下取整/绝对值），零 引 Python。
# O0 规避：不写负数字面量（用 0 - x）。

从 随机 导入 随机整数

导出 RGB转十六进制 十六进制转RGB RGB转HSL HSL转RGB RGB转HSV HSV转RGB。
导出 RGB转CMYK CMYK转RGB 混合颜色 亮度调整 随机颜色 获取颜色名称 生成渐变色。

设 _颜色表 为 "0123456789ABCDEF"

# ── 颜色名映射（对齐 颜色处理.py 常量表）──
设 _颜色名键 为 ["#FF0000", "#00FF00", "#0000FF", "#FFFF00", "#FF00FF", "#00FFFF", "#000000", "#FFFFFF", "#808080", "#FFC0CB", "#FFA500", "#800080", "#A52A2A", "#00FF7F", "#FF4500", "#708090", "#2E8B57", "#DAA520", "#8B4513", "#6A5ACD", "#FFD700", "#C0C0C0", "#F5F5DC", "#FFE4E1"]
设 _颜色名值 为 ["红色", "绿色", "蓝色", "黄色", "品红", "青色", "黑色", "白色", "灰色", "粉色", "橙色", "紫色", "棕色", "春绿", "橙红", "石板灰", "海洋绿", "金色", "马鞍棕", "板岩蓝", "金色", "银色", "米色", "薄雾玫瑰"]

# ── 私有辅助 ──

段落 _四舍五入(x, 位):
  设 因子 为 1.0
  设 i 为 0
  当 i < 位:
    设 因子 为 因子 * 10.0
    设 i 为 i + 1
  返回 _light_builtin.向下取整(x * 因子 + 0.5) / 因子

段落 _hex单值(c):
  设 o 为 码位(c)
  如果 o >= 48:
    如果 o <= 57:
      返回 o - 48
  如果 o >= 65:
    如果 o <= 70:
      返回 o - 55
  如果 o >= 97:
    如果 o <= 102:
      返回 o - 87
  返回 0 - 1

段落 _读hex(文本, 起, 位数):
  设 值 为 0
  设 k 为 0
  当 k < 位数:
    设 单 为 _hex单值(文本[起 + k])
    如果 单 < 0:
      返回 0 - 1
    设 值 为 值 * 16 + 单
    设 k 为 k + 1
  返回 值

段落 _字节2hex(b):
  设 高 为 整除(b, 16)
  设 低 为 b - 高 * 16
  返回 _颜色表[高] + _颜色表[低]

段落 _扩两位(体):
  设 结果 为 ""
  设 i 为 0
  当 i < 长(体):
    设 结果 为 结果 + 体[i] + 体[i]
    设 i 为 i + 1
  返回 结果

段落 _验证RGB(r, g, b):
  如果 r < 0:
    抛出 值错误("RGB 值超出范围 (0-255)")
  如果 r > 255:
    抛出 值错误("RGB 值超出范围 (0-255)")
  如果 g < 0:
    抛出 值错误("RGB 值超出范围 (0-255)")
  如果 g > 255:
    抛出 值错误("RGB 值超出范围 (0-255)")
  如果 b < 0:
    抛出 值错误("RGB 值超出范围 (0-255)")
  如果 b > 255:
    抛出 值错误("RGB 值超出范围 (0-255)")
  返回 0

段落 _夹紧(x):
  如果 x < 0:
    返回 0
  如果 x > 255:
    返回 255
  返回 x

段落 _最大3(a, b, c):
  设 结果 为 a
  如果 b > 结果:
    设 结果 为 b
  如果 c > 结果:
    设 结果 为 c
  返回 结果

段落 _最小3(a, b, c):
  设 结果 为 a
  如果 b < 结果:
    设 结果 为 b
  如果 c < 结果:
    设 结果 为 c
  返回 结果

段落 _下取模(x, m):
  设 商 为 _light_builtin.向下取整(x / m)
  返回 x - 商 * m

# ── HEX <-> RGB ──

段落 RGB转十六进制(r, g, b):
  _验证RGB(r, g, b)
  返回 "#" + _字节2hex(r) + _字节2hex(g) + _字节2hex(b)

段落 十六进制转RGB(十六进制):
  设 体 为 十六进制
  如果 开头(体, "#"):
    设 体 为 截取(体, 1, 长(体))
  设 体 为 去除空格(体)
  如果 长(体) == 3:
    设 体 为 _扩两位(体)
  如果 长(体) != 6:
    抛出 值错误("无效的十六进制颜色值")
  设 r 为 _读hex(体, 0, 2)
  设 g 为 _读hex(体, 2, 2)
  设 b 为 _读hex(体, 4, 2)
  如果 r < 0:
    抛出 值错误("十六进制格式无效")
  如果 g < 0:
    抛出 值错误("十六进制格式无效")
  如果 b < 0:
    抛出 值错误("十六进制格式无效")
  返回 [r, g, b]

# ── RGB <-> HSL ──

段落 RGB转HSL(r, g, b):
  设 rn 为 (r + 0.0) / 255.0
  设 gn 为 (g + 0.0) / 255.0
  设 bn 为 (b + 0.0) / 255.0
  设 最大 为 _最大3(rn, gn, bn)
  设 最小 为 _最小3(rn, gn, bn)
  设 差 为 最大 - 最小
  设 h 为 0.0
  如果 差 != 0.0:
    如果 最大 == rn:
      设 h 为 60.0 * _下取模((gn - bn) / 差, 6.0)
    否则如果 最大 == gn:
      设 h 为 60.0 * (((bn - rn) / 差) + 2.0)
    否则:
      设 h 为 60.0 * (((rn - gn) / 差) + 4.0)
  设 l 为 (最大 + 最小) / 2.0
  设 s 为 0.0
  如果 差 != 0.0:
    设 s 为 差 / (1.0 - _light_builtin.绝对值(2.0 * l - 1.0))
  返回 [_四舍五入(_下取模(h, 360.0), 1), _四舍五入(s * 100.0, 1), _四舍五入(l * 100.0, 1)]

段落 HSL转RGB(h, s, l):
  设 sn 为 s / 100.0
  设 ln 为 l / 100.0
  设 c 为 (1.0 - _light_builtin.绝对值(2.0 * ln - 1.0)) * sn
  设 x 为 c * (1.0 - _light_builtin.绝对值(_下取模(h / 60.0, 2.0) - 1.0))
  设 m 为 ln - c / 2.0
  设 r 为 0.0
  设 g 为 0.0
  设 b 为 0.0
  如果 h < 60.0:
    设 r 为 c
    设 g 为 x
  否则如果 h < 120.0:
    设 r 为 x
    设 g 为 c
  否则如果 h < 180.0:
    设 g 为 c
    设 b 为 x
  否则如果 h < 240.0:
    设 g 为 x
    设 b 为 c
  否则如果 h < 300.0:
    设 r 为 x
    设 b 为 c
  否则:
    设 r 为 c
    设 b 为 x
  返回 [整数((r + m) * 255.0), 整数((g + m) * 255.0), 整数((b + m) * 255.0)]

# ── RGB <-> HSV ──

段落 RGB转HSV(r, g, b):
  设 rn 为 (r + 0.0) / 255.0
  设 gn 为 (g + 0.0) / 255.0
  设 bn 为 (b + 0.0) / 255.0
  设 最大 为 _最大3(rn, gn, bn)
  设 最小 为 _最小3(rn, gn, bn)
  设 差 为 最大 - 最小
  设 h 为 0.0
  如果 差 != 0.0:
    如果 最大 == rn:
      设 h 为 60.0 * _下取模((gn - bn) / 差, 6.0)
    否则如果 最大 == gn:
      设 h 为 60.0 * (((bn - rn) / 差) + 2.0)
    否则:
      设 h 为 60.0 * (((rn - gn) / 差) + 4.0)
  设 s 为 0.0
  如果 最大 != 0.0:
    设 s 为 (差 / 最大) * 100.0
  设 v 为 最大 * 100.0
  返回 [_四舍五入(_下取模(h, 360.0), 1), _四舍五入(s, 1), _四舍五入(v, 1)]

段落 HSV转RGB(h, s, v):
  设 sn 为 s / 100.0
  设 vn 为 v / 100.0
  设 c 为 vn * sn
  设 x 为 c * (1.0 - _light_builtin.绝对值(_下取模(h / 60.0, 2.0) - 1.0))
  设 m 为 vn - c
  设 r 为 0.0
  设 g 为 0.0
  设 b 为 0.0
  如果 h < 60.0:
    设 r 为 c
    设 g 为 x
  否则如果 h < 120.0:
    设 r 为 x
    设 g 为 c
  否则如果 h < 180.0:
    设 g 为 c
    设 b 为 x
  否则如果 h < 240.0:
    设 g 为 x
    设 b 为 c
  否则如果 h < 300.0:
    设 r 为 x
    设 b 为 c
  否则:
    设 r 为 c
    设 b 为 x
  返回 [整数((r + m) * 255.0), 整数((g + m) * 255.0), 整数((b + m) * 255.0)]

# ── RGB <-> CMYK ──

段落 RGB转CMYK(r, g, b):
  设 rn 为 (r + 0.0) / 255.0
  设 gn 为 (g + 0.0) / 255.0
  设 bn 为 (b + 0.0) / 255.0
  设 k 为 1.0 - _最大3(rn, gn, bn)
  如果 k == 1.0:
    返回 [0.0, 0.0, 0.0, 100.0]
  设 c 为 (1.0 - rn - k) / (1.0 - k) * 100.0
  设 m 为 (1.0 - gn - k) / (1.0 - k) * 100.0
  设 y 为 (1.0 - bn - k) / (1.0 - k) * 100.0
  返回 [_四舍五入(c, 1), _四舍五入(m, 1), _四舍五入(y, 1), _四舍五入(k * 100.0, 1)]

段落 CMYK转RGB(c, m, y, k):
  设 cn 为 c / 100.0
  设 mn 为 m / 100.0
  设 yn 为 y / 100.0
  设 kn 为 k / 100.0
  设 r 为 整数(255.0 * (1.0 - cn) * (1.0 - kn))
  设 g 为 整数(255.0 * (1.0 - mn) * (1.0 - kn))
  设 b 为 整数(255.0 * (1.0 - yn) * (1.0 - kn))
  返回 [r, g, b]

# ── 颜色操作 ──

段落 混合颜色(颜色1, 颜色2, 比例 等于 0.5):
  如果 比例 < 0.0:
    抛出 值错误("混合比例超出范围 (0-1)")
  如果 比例 > 1.0:
    抛出 值错误("混合比例超出范围 (0-1)")
  设 a 为 十六进制转RGB(颜色1)
  设 b 为 十六进制转RGB(颜色2)
  设 r 为 整数(a[0] + (b[0] - a[0]) * 比例)
  设 g 为 整数(a[1] + (b[1] - a[1]) * 比例)
  设 bb 为 整数(a[2] + (b[2] - a[2]) * 比例)
  返回 RGB转十六进制(r, g, bb)

段落 亮度调整(十六进制, 百分比):
  设 a 为 十六进制转RGB(十六进制)
  设 比例 为 百分比 / 100.0
  设 r 为 a[0]
  设 g 为 a[1]
  设 b 为 a[2]
  如果 比例 >= 0.0:
    设 r 为 r + (255 - r) * 比例
    设 g 为 g + (255 - g) * 比例
    设 b 为 b + (255 - b) * 比例
  否则:
    设 r 为 r * (1.0 + 比例)
    设 g 为 g * (1.0 + 比例)
    设 b 为 b * (1.0 + 比例)
  返回 RGB转十六进制(_夹紧(整数(r)), _夹紧(整数(g)), _夹紧(整数(b)))

段落 随机颜色:
  返回 RGB转十六进制(随机整数(0, 255), 随机整数(0, 255), 随机整数(0, 255))

段落 获取颜色名称(十六进制):
  设 键 为 大写(十六进制)
  设 i 为 0
  当 i < 长(_颜色名键):
    如果 _颜色名键[i] == 键:
      返回 _颜色名值[i]
    设 i 为 i + 1
  返回 空

段落 生成渐变色(起始颜色, 结束颜色, 步数 等于 10):
  如果 步数 < 2:
    抛出 值错误("步数必须大于等于 2")
  设 结果 为 []
  设 i 为 0
  当 i < 步数:
    设 比例 为 i / (步数 - 1)
    结果.追加(混合颜色(起始颜色, 结束颜色, 比例))
    设 i 为 i + 1
  返回 结果
