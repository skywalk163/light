def左填充(文本,宽度,填充字符=' '):
    return文本.右对齐(宽度,填充字符)


def右填充(文本,宽度,填充字符=' '):
    return文本.左对齐(宽度,填充字符)


def居中填充(文本,宽度,填充字符=' '):
