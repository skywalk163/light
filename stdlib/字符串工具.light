def子串查找(文本,子串,起始位置=0,结束位置=无):
    return文本.查找(子串,起始位置,结束位置)


def子串查找最后(文本,子串,起始位置=0,结束位置=无):
    return文本.反向查找(子串,起始位置,结束位置)


def包含子串(文本,子串):
