def以子串开头(文本,前缀):
    return文本.以开头(前缀)


def以子串结尾(文本,后缀):
    return文本.以结尾(后缀)


def字符串对齐(文本,宽度,对齐方式='left'):
    如果对齐方式=='left':
        return文本.左对齐(宽度)
    否则如果对齐方式=='right':
        return文本.右对齐(宽度)
    否则如果对齐方式=='center':
        return文本.居中(宽度)
    否则:
        返回文本


def分词(文本,分隔符=无):
    return文本.分割(分隔符)


def中文分词(文本):
