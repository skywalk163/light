  "1322": "重庆", "1323": "上海", "1324": "上海", "1330": "重庆",
  "1331": "重庆", "1332": "重庆", "1333": "上海", "1340": "重庆",
  "1341": "重庆", "1342": "重庆", "1343": "广东", "1347": "上海",
  "1348": "上海", "1349": "上海", "1350": "重庆", "1351": "重庆",
