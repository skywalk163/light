  "1396": "重庆", "1397": "重庆", "1398": "重庆", "1399": "重庆"
}

# 私有：逐字符 ASCII 数字判断（字符 0-9 码位 48-57；空串返回假，对齐 isdigit）
段落 全数字 接收 文本:
  如果 长(文本) == 0:
    返回 假
  设 i 为 0
  当 i < 长(文本):
    设 码 为 码位(文本[i])
    如果 码 < 48:
      返回 假
    如果 码 > 57:
      返回 假
    设 i 为 i 加上 1
  返回 真

# 私有：按前 4 位查归属地（对齐 _lookup_region；未覆盖返回空串，不回退 3 位）
段落 查归属地 接收 号码:
  如果 长(号码) < 4:
    返回 ""
  设 键 为 截取(号码, 0, 4)
  返回 字典获取(归属地表, 键, "")

# 私有：错误结果字典（对齐 _make_error_result）
段落 错误结果 接收 错误:
  设 结果 为 {
    "valid": 假,
    "phone": "",
    "carrier": "",
    "region": "",
    "errors": 错误
  }
  返回 结果

# 校验手机号(号码) → dict
# 返回键：valid(真/假) phone(号码) carrier(运营商名或"") region(归属地或"未知"/"")
#         errors(错误信息列表)
段落 校验手机号 接收 号码:
  设 错误 为 新建列表()
  如果 号码 == "":
    追加(错误, "手机号码不能为空")
    返回 错误结果(错误)
  # 格式检查 ^1\d{10}$：长=11 且 全数字 且 首字符 '1'
  # （O0 下 非 对复合布尔条件/变量误判，这里用反转分支规避，不写 非）
  如果 长(号码) == 11 且 全数字(号码) 且 号码[0] == "1":
    设 占位 为 0
  否则:
    如果 长(号码) != 11:
      追加(错误, "手机号码必须为11位")
    否则:
      如果 全数字(号码):
        追加(错误, "手机号码格式不正确（必须以1开头）")
      否则:
        追加(错误, "手机号码只能包含数字")
    返回 错误结果(错误)
  设 运营商 为 获取运营商(号码)
  如果 运营商 == "":
    追加(错误, "未知号段: " 加上 截取(号码, 0, 3))
  设 归属地 为 查归属地(号码)
  如果 长(错误) > 0:
    设 结果 为 {
      "valid": 假,
      "phone": 号码,
      "carrier": 运营商,
      "region": 归属地,
      "errors": 错误
    }
    返回 结果
  设 区域 为 归属地
  如果 归属地 == "":
    设 区域 为 "未知"
  设 结果 为 {
    "valid": 真,
    "phone": 号码,
    "carrier": 运营商,
    "region": 区域,
    "errors": 错误
  }
  返回 结果

# 获取运营商(号码) → str；前 3 位查表，长度不足 3 或未覆盖返回 ""
段落 获取运营商 接收 号码:
  如果 长(号码) < 3:
    返回 ""
  设 前缀 为 截取(号码, 0, 3)
  返回 字典获取(运营商表, 前缀, "")

# 获取归属地(号码) → str；前 4 位查表，长度不足 4 或未覆盖返回 ""
段落 获取归属地 接收 号码:
  如果 长(号码) < 4:
    返回 ""
  返回 查归属地(号码)
