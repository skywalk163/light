# 光明标准库 —— 手机号校验模块（原生腿真身）
#
# 对齐 stdlib/手机号校验.py 的顶层便捷函数：校验手机号 / 获取运营商 / 获取归属地
# （.py 顶层是 ChinesePhoneValidator 类方法的薄包装，语义以类方法为准，已平铺复刻）。
# 类 ChinesePhoneValidator 不导出。模块自包含、零导入。
#
# 光明无 regex：格式校验 ^1\d{10}$ 用 长() + 码位 逐字符实现（字符 0-9 码位 48-57，
# 首字符 '1'，全长 11）。
#
# 数据表说明：
# - 运营商号段：.py 的 5 组号段列表原样嵌入（移动/联通/电信/广电/虚拟），
#   运营商表 为 5 组号段到运营商名的映射（56 键，组间无重叠；号段齐全，
#   与现行工信部号段分配一致，无需补充）。
# - 归属地表：.py 的 _REGION_PREFIX_MAP 是「同一 dict 字面量里重复键后覆盖前」的写法，
#   最终生效 = 每个键最后一次出现的值。本文件已按 Python dict 重复键后写覆盖语义
#   折叠为生效表（76 键，键序以 importlib 解析结果为准，后值覆盖前值）。

导出 校验手机号 获取运营商 获取归属地。

# ── 中国移动号段 ──
设 移动号段 为 ["134", "135", "136", "137", "138", "139", "147", "148", "150", "151", "152", "157", "158", "159", "172", "178", "182", "183", "184", "187", "188", "195", "197", "198"]
# ── 中国联通号段 ──
设 联通号段 为 ["130", "131", "132", "145", "146", "155", "156", "166", "167", "171", "175", "176", "185", "186", "196"]
# ── 中国电信号段 ──
设 电信号段 为 ["133", "149", "153", "173", "174", "177", "180", "181", "189", "190", "191", "193", "199"]
# ── 中国广电号段 ──
设 广电号段 为 ["192"]
# ── 虚拟运营商号段 ──
设 虚拟号段 为 ["162", "165", "170"]

# 前 3 位号段 → 运营商名（由上面 5 组号段构建，56 键）
设 运营商表 为 {
  "134": "中国移动", "135": "中国移动", "136": "中国移动", "137": "中国移动",
  "138": "中国移动", "139": "中国移动", "147": "中国移动", "148": "中国移动",
  "150": "中国移动", "151": "中国移动", "152": "中国移动", "157": "中国移动",
  "158": "中国移动", "159": "中国移动", "172": "中国移动", "178": "中国移动",
  "182": "中国移动", "183": "中国移动", "184": "中国移动", "187": "中国移动",
  "188": "中国移动", "195": "中国移动", "197": "中国移动", "198": "中国移动",
  "130": "中国联通", "131": "中国联通", "132": "中国联通", "145": "中国联通",
  "146": "中国联通", "155": "中国联通", "156": "中国联通", "166": "中国联通",
  "167": "中国联通", "171": "中国联通", "175": "中国联通", "176": "中国联通",
  "185": "中国联通", "186": "中国联通", "196": "中国联通",
  "133": "中国电信", "149": "中国电信", "153": "中国电信", "173": "中国电信",
  "174": "中国电信", "177": "中国电信", "180": "中国电信", "181": "中国电信",
  "189": "中国电信", "190": "中国电信", "191": "中国电信", "193": "中国电信",
  "199": "中国电信",
  "192": "中国广电",
  "162": "虚拟运营商", "165": "虚拟运营商", "170": "虚拟运营商"
}

# 前 4 位前缀 → 归属地省份（去重后最终生效表，76 键）
设 归属地表 为 {
  "1300": "重庆", "1301": "重庆", "1302": "重庆", "1303": "上海",
  "1304": "上海", "1310": "重庆", "1311": "重庆", "1312": "重庆",
