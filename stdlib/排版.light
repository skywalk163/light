# 纯光明实现 —— 光明标准库 —— 排版模块（原生腿真身，零 Python 标准库依赖）
#
# 本模块完全用光明内建（码位 / 字符自码位 / 字符串迭代 / 拼接 / 字典）重写，
# 不依赖 re / unicodedata，转译腿与原生腿均可用。对齐 stdlib/排版.py 的 7 个导出。

导出 插入中英文空格 转全角 转半角 规范化标点 规范化引号 检查排版。
导出 自动排版。

# ---------- 码点区间辅助 ----------

# 是否 CJK（中日韩统一表意文字 + 扩展 A/B/C + 兼容 + 假名 + 谚文）
段落 是CJK(c):
  设 cp 为 码位(c)
  如果 cp >= 0x4E00 且 cp <= 0x9FFF:
    返回 真
  如果 cp >= 0x3400 且 cp <= 0x4DBF:
    返回 真
  如果 cp >= 0xF900 且 cp <= 0xFAFF:
    返回 真
  如果 cp >= 0x3040 且 cp <= 0x30FF:
    返回 真
  如果 cp >= 0xAC00 且 cp <= 0xD7AF:
    返回 真
  如果 cp >= 0x20000 且 cp <= 0x2A6DF:
    返回 真
  如果 cp >= 0x2A700 且 cp <= 0x2B73F:
    返回 真
  返回 假

# 是否 ASCII 字母或数字
段落 是英数(c):
  设 cp 为 码位(c)
  如果 cp >= 0x30 且 cp <= 0x39:
    返回 真
  如果 cp >= 0x41 且 cp <= 0x5A:
    返回 真
  如果 cp >= 0x61 且 cp <= 0x7A:
    返回 真
  返回 假

# 英文标点 -> 中文标点 映射（仅返回新字符，非标点原样返回）
段落 标点映射(c):
  如果 c 等于 ",":
    返回 字符自码位(0xFF0C)
  如果 c 等于 ".":
    返回 字符自码位(0x3002)
  如果 c 等于 "!":
    返回 字符自码位(0xFF01)
  如果 c 等于 "?":
    返回 字符自码位(0xFF1F)
  如果 c 等于 ";":
    返回 字符自码位(0xFF1B)
  如果 c 等于 ":":
    返回 字符自码位(0xFF1A)
  如果 c 等于 "(":
    返回 字符自码位(0xFF08)
  如果 c 等于 ")":
    返回 字符自码位(0xFF09)
  如果 c 等于 "[":
    返回 字符自码位(0x3010)
  如果 c 等于 "]":
    返回 字符自码位(0x3011)
  如果 c 等于 "<":
    返回 字符自码位(0x300A)
  如果 c 等于 ">":
    返回 字符自码位(0x300B)
  返回 c

# 是否英文标点（参与映射集合）
段落 是英文标点(c):
  如果 c 等于 ",":
    返回 真
  如果 c 等于 ".":
    返回 真
  如果 c 等于 "!":
    返回 真
  如果 c 等于 "?":
    返回 真
  如果 c 等于 ";":
    返回 真
  如果 c 等于 ":":
    返回 真
  如果 c 等于 "(":
    返回 真
  如果 c 等于 ")":
    返回 真
  如果 c 等于 "[":
    返回 真
  如果 c 等于 "]":
    返回 真
  如果 c 等于 "<":
    返回 真
  如果 c 等于 ">":
    返回 真
  返回 假

# 是否中文标点（用于重复标点检测）
段落 是中文标点(c):
  如果 c 等于 "。":
    返回 真
  如果 c 等于 "！":
    返回 真
  如果 c 等于 "？":
    返回 真
  如果 c 等于 "，":
    返回 真
  如果 c 等于 "；":
    返回 真
  如果 c 等于 "：":
    返回 真
  返回 假

# ---------- 中英文混排空格 ----------

段落 插入中英文空格(文本):
  设 out 为 ""
  设 i 为 0
  当 i < 长(文本):
    设 c 为 文本[i]
    如果 i > 0:
      设 p 为 文本[i 减去 1]
      如果 (是CJK(p) 且 是英数(c)) 或 (是英数(p) 且 是CJK(c)):
        设 out 为 out 加上 " "
    设 out 为 out 加上 c
    设 i 为 i 加上 1
  返回 out

# ---------- 全半角转换 ----------

段落 转全角(文本):
  设 out 为 ""
  设 i 为 0
  当 i < 长(文本):
    设 c 为 文本[i]
    设 cp 为 码位(c)
    如果 cp == 0x20:
      设 out 为 out 加上 字符自码位(0x3000)
    否则 如果 cp >= 0x21 且 cp <= 0x7E:
      设 out 为 out 加上 字符自码位(cp 加上 0xFEE0)
    否则:
      设 out 为 out 加上 c
    设 i 为 i 加上 1
  返回 out

段落 转半角(文本):
  设 out 为 ""
  设 i 为 0
  当 i < 长(文本):
    设 c 为 文本[i]
    设 cp 为 码位(c)
    如果 cp == 0x3000:
      设 out 为 out 加上 " "
    否则 如果 cp >= 0xFF01 且 cp <= 0xFF5E:
      设 out 为 out 加上 字符自码位(cp 减去 0xFEE0)
    否则:
      设 out 为 out 加上 c
    设 i 为 i 加上 1
  返回 out

# ---------- 标点规范化 ----------

段落 规范化标点(文本):
  设 out 为 ""
  设 i 为 0
  当 i < 长(文本):
    设 c 为 文本[i]
    如果 是英文标点(c):
      设 有CJK 为 假
      如果 i > 0 且 是CJK(文本[i 减去 1]):
        设 有CJK 为 真
      如果 i < 长(文本) 减去 1 且 是CJK(文本[i 加上 1]):
        设 有CJK 为 真
      如果 有CJK:
        设 out 为 out 加上 标点映射(c)
      否则:
        设 out 为 out 加上 c
    否则:
      设 out 为 out 加上 c
    设 i 为 i 加上 1
  返回 out

# ---------- 引号规范化 ----------

段落 规范化引号(文本):
  设 out 为 ""
  设 in_double 为 假
  设 in_single 为 假
  设 i 为 0
  当 i < 长(文本):
    设 c 为 文本[i]
    如果 c 等于 '"':
      如果 in_double:
        设 out 为 out 加上 字符自码位(0x201D)
        设 in_double 为 假
      否则:
        设 out 为 out 加上 字符自码位(0x201C)
        设 in_double 为 真
    否则 如果 c 等于 "'":
      如果 in_single:
        设 out 为 out 加上 字符自码位(0x2019)
        设 in_single 为 假
      否则:
        设 out 为 out 加上 字符自码位(0x2018)
        设 in_single 为 真
    否则:
      设 out 为 out 加上 c
    设 i 为 i 加上 1
  返回 out

# ---------- 排版检查 ----------

段落 检查排版(文本):
  设 issues 为 新建列表()
  设 n 为 长(文本)
  # 1. 中英文缺空格
  设 i 为 1
  当 i < n:
    设 prev 为 文本[i 减去 1]
    设 cur 为 文本[i]
    如果 (是CJK(prev) 且 是英数(cur)) 或 (是英数(prev) 且 是CJK(cur)):
      设 it 为 {}
      字典设置(it, "类型", "缺少空格")
      字典设置(it, "位置", i 减去 1)
      字典设置(it, "描述", "中英文之间缺少空格")
      字典设置(it, "建议", "在中英文之间插入空格")
      列表追加(issues, it)
    设 i 为 i 加上 1
  # 2. 全角英数字
  设 i 为 0
  当 i < n:
    设 cp 为 码位(文本[i])
    如果 cp >= 0xFF01 且 cp <= 0xFF5E:
      设 half 为 字符自码位(cp 减去 0xFEE0)
      设 it 为 {}
      字典设置(it, "类型", "全角英数字")
      字典设置(it, "位置", i)
      字典设置(it, "描述", "使用了全角字符")
      字典设置(it, "建议", "替换为半角")
      列表追加(issues, it)
    设 i 为 i 加上 1
  # 3. 重复中文标点
  设 i 为 0
  当 i < n:
    设 c 为 文本[i]
    如果 是中文标点(c):
      设 j 为 i 加上 1
      当 j < n 且 文本[j] 等于 c:
        设 j 为 j 加上 1
      如果 j 减去 i >= 2:
        设 it 为 {}
        字典设置(it, "类型", "重复标点")
        字典设置(it, "位置", i)
        字典设置(it, "描述", "重复使用了标点")
        字典设置(it, "建议", "标点符号不应重复")
        列表追加(issues, it)
      设 i 为 j
    否则:
      设 i 为 i 加上 1
  # 4. 中文上下文中的英文标点
  设 i 为 0
  当 i < n:
    设 c 为 文本[i]
    如果 是英文标点(c):
      设 有CJK 为 假
      如果 i > 0 且 是CJK(文本[i 减去 1]):
        设 有CJK 为 真
      如果 i < n 减去 1 且 是CJK(文本[i 加上 1]):
        设 有CJK 为 真
      如果 有CJK:
        设 it 为 {}
        字典设置(it, "类型", "标点不一致")
        字典设置(it, "位置", i)
        字典设置(it, "描述", "中文上下文中使用了英文标点")
        字典设置(it, "建议", "替换为中文标点")
        列表追加(issues, it)
    设 i 为 i 加上 1
  # 5. 直引号
  设 有双 为 假
  设 有单 为 假
  设 i 为 0
  当 i < n:
    如果 文本[i] 等于 '"':
      设 有双 为 真
    如果 文本[i] 等于 "'":
      设 有单 为 真
    设 i 为 i 加上 1
  如果 有双 或 有单:
    设 it 为 {}
    字典设置(it, "类型", "引号不规范")
    字典设置(it, "位置", 0)
    字典设置(it, "描述", "使用了英文直引号")
    字典设置(it, "建议", "替换为中文弯引号")
    列表追加(issues, it)
  # 6. 连续空格
  设 i 为 0
  当 i < n:
    如果 文本[i] 等于 " ":
      设 j 为 i 加上 1
      当 j < n 且 文本[j] 等于 " ":
        设 j 为 j 加上 1
      如果 j 减去 i >= 2:
        设 it 为 {}
        字典设置(it, "类型", "连续空格")
        字典设置(it, "位置", i)
        字典设置(it, "描述", "连续空格")
        字典设置(it, "建议", "使用单个空格")
        列表追加(issues, it)
      设 i 为 j
    否则:
      设 i 为 i 加上 1
  返回 issues

# ---------- 一键自动排版 ----------

段落 自动排版(文本):
  设 r 为 转半角(文本)
  设 r 为 插入中英文空格(r)
  设 r 为 规范化标点(r)
  设 r 为 规范化引号(r)
  返回 r
