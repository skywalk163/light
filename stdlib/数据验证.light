# 纯光明实现 —— 数据验证（取代同名 .py 壳）
#
# 对齐 stdlib/数据验证.py。验证结果以字典承载（错误/警告列表）；格式校验复用
# 字符串工具.light 的正则实现（验证邮箱/验证手机号/验证URL/验证IP地址）。
#
# 原生腿能力边界（见 docs/known_issues.md）：
#   - 验证IP地址: .py 用 ipaddress 严格校验（拒绝 >255 / 前导零），原生腿退化为
#     四段数字正则近似（行为近似，非严格等价）。
#   - 验证JSON: .py 用 json 模块解析，原生腿无 json，降级为「非空 + 首尾空白检查」
#     的弱校验（仅判定非空白，不保证合法 JSON），标注能力边界。
#   - 验证类型/数据模式 的 期望类型 以字符串形式传入（"str"/"int"/"float" 等，
#     对齐 类型() 内建返回值），与 .py 的 type 对象语义不同但可对拍。

从 字符串工具 导入 验证邮箱 验证手机号 验证URL 验证IP地址 去除首尾空白。
从 正则表达式 导入 完全匹配。

# ---------------- 验证结果 ----------------

段落 创建验证结果:
  设 结果 为 {}
  字典设置(结果, "错误", [])
  字典设置(结果, "警告", [])
  返回 结果

段落 添加错误 接收 结果, 消息:
  设 列表 为 字典获取(结果, "错误")
  列表.追加(消息)
  返回 结果

段落 添加警告 接收 结果, 消息:
  设 列表 为 字典获取(结果, "警告")
  列表.追加(消息)
  返回 结果

段落 是否有效 接收 结果:
  返回 长(字典获取(结果, "错误")) == 0

段落 获取错误 接收 结果:
  返回 字典获取(结果, "错误")

段落 获取警告 接收 结果:
  返回 字典获取(结果, "警告")

段落 抛出异常 接收 结果:
  如果 长(字典获取(结果, "错误")) > 0:
    抛出 新建 异常("验证失败")
  返回 结果

# ---------------- 基础校验 ----------------

段落 字符串为空或空白 接收 文本:
  设 n 为 长(文本)
  如果 n == 0:
    返回 真
  设 i 为 0
  当 i < n:
    设 c 为 码位(文本[i])
    如果 c == 32:
      设 i 为 i 加上 1
      继续
    如果 c == 9:
      设 i 为 i 加上 1
      继续
    如果 c == 10:
      设 i 为 i 加上 1
      继续
    如果 c == 13:
      设 i 为 i 加上 1
      继续
    如果 c == 11:
      设 i 为 i 加上 1
      继续
    如果 c == 12:
      设 i 为 i 加上 1
      继续
    返回 假
  返回 真

段落 字段名或 接收 字段名:
  如果 字段名 == "":
    返回 "字段"
  返回 字段名

段落 验证必填 接收 值, 字段名 = "":
  设 结果 为 创建验证结果()
  如果 值 == 空:
    添加错误(结果, 字段名或(字段名) 加上 " 为必填项")
    返回 结果
  如果 类型(值) == "str":
    如果 字符串为空或空白(值):
      添加错误(结果, 字段名或(字段名) 加上 " 为必填项")
      返回 结果
  返回 结果

段落 验证类型 接收 值, 期望类型, 字段名 = "":
  设 结果 为 创建验证结果()
  设 实际 为 类型(值)
  如果 实际 != 期望类型:
    添加错误(结果, 字段名或(字段名) 加上 " 期望类型 " 加上 期望类型 加上 "，但得到 " 加上 实际)
  返回 结果

段落 验证长度 接收 值, 最小 = 0, 最大 = 空, 字段名 = "":
  设 结果 为 创建验证结果()
  如果 类型(值) != "str":
    添加错误(结果, 字段名或(字段名) 加上 " 不是字符串")
    返回 结果
  设 n 为 长(值)
  如果 n < 最小:
    添加错误(结果, 字段名或(字段名) 加上 " 长度 " 加上 转文本(n) 加上 " 小于最小值 " 加上 转文本(最小))
  如果 最大 != 空:
    如果 n > 最大:
      添加错误(结果, 字段名或(字段名) 加上 " 长度 " 加上 转文本(n) 加上 " 大于最大值 " 加上 转文本(最大))
  返回 结果

段落 验证范围 接收 值, 最小 = 空, 最大 = 空, 字段名 = "":
  设 结果 为 创建验证结果()
  如果 最小 != 空:
    如果 值 < 最小:
      添加错误(结果, 字段名或(字段名) 加上 " " 加上 转文本(值) 加上 " 小于最小值 " 加上 转文本(最小))
  如果 最大 != 空:
    如果 值 > 最大:
      添加错误(结果, 字段名或(字段名) 加上 " " 加上 转文本(值) 加上 " 大于最大值 " 加上 转文本(最大))
  返回 结果

段落 验证邮箱格式 接收 邮箱:
  返回 验证邮箱(邮箱)

段落 验证手机号格式 接收 手机号:
  返回 验证手机号(手机号)

段落 验证URL格式 接收 网址:
  返回 验证URL(网址)

段落 验证IP格式 接收 ip:
  返回 验证IP地址(ip)

段落 验证正则表达式 接收 值, 模式, 字段名 = "":
  设 结果 为 创建验证结果()
  如果 完全匹配(值, 模式) == 假:
    添加错误(结果, 字段名或(字段名) 加上 " 不匹配模式: " 加上 模式)
  返回 结果

段落 验证JSON 接收 字符串:
  设 结果 为 创建验证结果()
  如果 字符串为空或空白(字符串):
    添加错误(结果, "JSON 格式无效：空字符串")
  返回 结果

段落 验证枚举 接收 值, 可选值, 字段名 = "":
  设 结果 为 创建验证结果()
  如果 可选值.包含(值) == 假:
    添加错误(结果, 字段名或(字段名) 加上 " " 加上 转文本(值) 加上 " 不在可选值中")
  返回 结果

# ---------------- 集合校验（批量）----------------

段落 应用规则 接收 结果, 规则, 值, 字段名:
  设 规则名 为 规则[0]
  如果 规则名 == "必填":
    设 子 为 验证必填(值, 字段名)
    设 结果 为 合并错误(结果, 子)
  否则 如果 规则名 == "类型":
    设 子 为 验证类型(值, 规则[1], 字段名)
    设 结果 为 合并错误(结果, 子)
  否则 如果 规则名 == "长度":
    设 最大 为 空
    如果 长(规则) > 2:
      设 最大 为 规则[2]
    设 子 为 验证长度(值, 规则[1], 最大, 字段名)
    设 结果 为 合并错误(结果, 子)
  否则 如果 规则名 == "范围":
    设 最小 为 空
    设 最大 为 空
    如果 长(规则) > 1:
      设 最小 为 规则[1]
    如果 长(规则) > 2:
      设 最大 为 规则[2]
    设 子 为 验证范围(值, 最小, 最大, 字段名)
    设 结果 为 合并错误(结果, 子)
  否则 如果 规则名 == "邮箱":
    设 子 为 验证邮箱(值)
    设 结果 为 合并错误(结果, 子)
  否则 如果 规则名 == "手机号":
    设 子 为 验证手机号(值)
    设 结果 为 合并错误(结果, 子)
  否则 如果 规则名 == "URL":
    设 子 为 验证URL(值)
    设 结果 为 合并错误(结果, 子)
  否则 如果 规则名 == "IP":
    设 子 为 验证IP地址(值)
    设 结果 为 合并错误(结果, 子)
  否则 如果 规则名 == "正则":
    设 子 为 验证正则表达式(值, 规则[1], 字段名)
    设 结果 为 合并错误(结果, 子)
  否则 如果 规则名 == "枚举":
    设 子 为 验证枚举(值, 规则[1], 字段名)
    设 结果 为 合并错误(结果, 子)
  返回 结果

段落 合并错误 接收 目标, 源:
  设 错误们 为 获取错误(源)
  设 i 为 0
  当 i < 长(错误们):
    添加错误(目标, 错误们[i])
    设 i 为 i 加上 1
  返回 目标

段落 验证集合 接收 验证规则, 数据:
  设 结果 为 创建验证结果()
  设 字段们 为 字典键列表(验证规则)
  设 i 为 0
  当 i < 长(字段们):
    设 字段名 为 字段们[i]
    设 规则列表 为 字典获取(验证规则, 字段名)
    设 值 为 字典获取(数据, 字段名, 空)
    设 j 为 0
    当 j < 长(规则列表):
      设 结果 为 应用规则(结果, 规则列表[j], 值, 字段名)
      设 j 为 j 加上 1
    设 i 为 i 加上 1
  返回 结果

# ---------------- 数据模式 ----------------

段落 创建数据模式 接收 字段定义:
  设 模式 为 {}
  字典设置(模式, "定义", 字段定义)
  返回 模式

段落 模式验证 接收 模式, 数据:
  设 结果 为 创建验证结果()
  设 定义 为 字典获取(模式, "定义")
  设 字段们 为 字典键列表(定义)
  设 i 为 0
  当 i < 长(字段们):
    设 字段名 为 字段们[i]
    设 字段定义 为 字典获取(定义, 字段名)
    设 值 为 字典获取(数据, 字段名, 空)
    如果 字典包含键(字段定义, "必填"):
      如果 字典获取(字段定义, "必填", 空) == 真:
        如果 值 == 空:
          添加错误(结果, 字段名 加上 " 为必填项")
          设 i 为 i 加上 1
          继续
        如果 类型(值) == "str":
          如果 字符串为空或空白(值):
            添加错误(结果, 字段名 加上 " 为必填项")
            设 i 为 i 加上 1
            继续
    如果 值 == 空:
      设 i 为 i 加上 1
      继续
    设 期望类型 为 字典获取(字段定义, "类型", 空)
    如果 期望类型 != 空:
      如果 类型(值) != 期望类型:
        添加错误(结果, 字段名 加上 " 期望类型 " 加上 期望类型 加上 "，但得到 " 加上 类型(值))
        设 i 为 i 加上 1
        继续
    如果 类型(值) == "str":
      设 最小 为 字典获取(字段定义, "长度最小", 0)
      设 最大 为 字典获取(字段定义, "长度最大", 空)
      设 n 为 长(值)
      如果 n < 最小:
        添加错误(结果, 字段名 加上 " 长度 " 加上 转文本(n) 加上 " 小于最小值 " 加上 转文本(最小))
      如果 n > 最大:
        添加错误(结果, 字段名 加上 " 长度 " 加上 转文本(n) 加上 " 大于最大值 " 加上 转文本(最大))
      如果 字典包含键(字段定义, "邮箱"):
        如果 字典获取(字段定义, "邮箱", 空) == 真:
          设 子 为 验证邮箱(值)
          设 结果 为 合并错误(结果, 子)
      如果 字典包含键(字段定义, "手机号"):
        如果 字典获取(字段定义, "手机号", 空) == 真:
          设 子 为 验证手机号(值)
          设 结果 为 合并错误(结果, 子)
      如果 字典包含键(字段定义, "URL"):
        如果 字典获取(字段定义, "URL", 空) == 真:
          设 子 为 验证URL(值)
          设 结果 为 合并错误(结果, 子)
    设 是数 为 假
    如果 类型(值) == "int":
      设 是数 为 真
    如果 类型(值) == "float":
      设 是数 为 真
    如果 是数:
      设 最小 为 字典获取(字段定义, "范围最小", 空)
      设 最大 为 字典获取(字段定义, "范围最大", 空)
      如果 最小 != 空:
        如果 值 < 最小:
          添加错误(结果, 字段名 加上 " " 加上 转文本(值) 加上 " 小于最小值 " 加上 转文本(最小))
      如果 最大 != 空:
        如果 值 > 最大:
          添加错误(结果, 字段名 加上 " " 加上 转文本(值) 加上 " 大于最大值 " 加上 转文本(最大))
    设 i 为 i 加上 1
  返回 结果

导出 创建验证结果 添加错误 添加警告 是否有效 获取错误 获取警告 抛出异常。
导出 验证必填 验证类型 验证长度 验证范围 验证邮箱格式 验证手机号格式 验证URL格式 验证IP格式 验证正则表达式 验证JSON 验证枚举。
导出 验证集合 创建数据模式 模式验证 合并错误 应用规则 字符串为空或空白 字段名或。
