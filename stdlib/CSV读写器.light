def读取CSV(文件路径,编码='utf-8',分隔符=',',表头=真):
    打开(文件路径,'r',编码=编码)作为f:
        return_读取CSV字典(f,分隔符=分隔符)


def读取CSV列表(文件路径,编码='utf-8',分隔符=','):
    打开(文件路径,'r',编码=编码)作为f:
        return_读取CSV列表(f,分隔符=分隔符)


def写入CSV(文件路径,数据,编码='utf-8',分隔符=','):
    如果不是数据:
        返回
    
    表头=列表(数据[0].键())
    打开(文件路径,'w',编码=编码)作为f:
        _写入CSV字典(f,数据,表头,分隔符=分隔符)


def写入CSV列表(文件路径,数据,编码='utf-8',分隔符=','):
    打开(文件路径,'w',编码=编码)作为f:
        _写入CSV列表(f,数据,分隔符=分隔符)


defCSV转字典(文本,分隔符=','):
    行=文本.去除首尾().分割('\n')
    如果不是行:
        返回[]
    
    表头=行[0].分割(分隔符)
    结果=[]
    
    对于行内容在行[1:]:
        单元格=_解析CSV行(行内容,分隔符)
        结果.追加(字典(配对(表头,单元格)))
    
    返回结果


def字典转CSV(数据,分隔符=','):
    如果不是数据:
        返回''
    
    表头=列表(数据[0].键())
    行=[分隔符.连接(表头)]
    
    对于项在数据:
        单元格=[]
        对于列在表头:
            值=项.获取(列,'')
            如果是字符串(值)且(分隔符在值或'"'在值或'\n'在值):
                值=值.替换('"','""')
                单元格.追加(f'"{值}"')
            否则:
                单元格.追加(转字符串(值))
        行.追加(分隔符.连接(单元格))
    
    返回'\n'.连接(行)


defCSV转列表(文本,分隔符=','):
    行=文本.去除首尾().分割('\n')
    返回[_解析CSV行(行内容,分隔符)对于行内容在行如果行内容.去除首尾()]


def列表转CSV(数据,分隔符=','):
    行=[]
    对于行内容在数据:
        单元格=[]
        对于值在行内容:
            值=转字符串(值)
            如果分隔符在值或'"'在值或'\n'在值:
                值=值.替换('"','""')
                单元格.追加(f'"{值}"')
            否则:
                单元格.追加(值)
        行.追加(分隔符.连接(单元格))
    返回'\n'.连接(行)


def_解析CSV行(行,分隔符=','):
    结果=[]
    当前=''
    在引号内=假
    
    i=0
    当i<长度(行):
        字符=行[i]
        
        如果字符=='"':
            如果在引号内且i+1<长度(行)且行[i+1]=='"':
                当前+='"'.
                i+=2
                继续
            在引号内=不是在引号内
            i+=1
        否则如果字符==分隔符且不是在引号内:
            结果.追加(当前)
            当前=''
            i+=1
        否则:
            当前+=字符
            i+=1
    
    结果.追加(当前)
    返回结果


def获取CSV表头(文件路径,编码='utf-8',分隔符=','):
    打开(文件路径,'r',编码=编码)作为f:
        第一行=f.读取行()
        返回_解析CSV行(第一行.去除首尾(),分隔符)


def获取CSV行数(文件路径,编码='utf-8'):
    打开(文件路径,'r',编码=编码)作为f:
        返回总和(1对于_在f如果_.去除首尾())


def获取CSV列数(文件路径,编码='utf-8',分隔符=','):
    表头=获取CSV表头(文件路径,编码,分隔符)
    返回长度(表头)


defCSV添加行(文件路径,行,编码='utf-8',分隔符=','):
    打开(文件路径,'a',编码=编码)作为f:
        _写入CSV行(f,行,分隔符=分隔符)


defCSV添加字典行(文件路径,字典,编码='utf-8',分隔符=','):
    表头=获取CSV表头(文件路径,编码,分隔符)
    
    行=[]
    对于列在表头:
        行.追加(字典.获取(列,''))
    
    CSV添加行(文件路径,行,编码,分隔符)


defCSV筛选(文件路径,条件函数,编码='utf-8',分隔符=','):
    数据=读取CSV(文件路径,编码,分隔符)
    返回[行对于行在数据如果条件函数(行)]


defCSV排序(文件路径,键,升序=真,编码='utf-8',分隔符=','):
    数据=读取CSV(文件路径,编码,分隔符)
    返回排序(数据,键=lambda x:x.获取(键,''),反转=不是升序)


defCSV分组(文件路径,键,编码='utf-8',分隔符=','):
    数据=读取CSV(文件路径,编码,分隔符)
    结果={}
    
    对于行在数据:
        分组键=行.获取(键,'')
        如果分组键不在结果:
            结果[分组键]=[]
        结果[分组键].追加(行)
    
    返回结果


defCSV转JSON(文件路径,输出文件=无,编码='utf-8',分隔符=','):
    数据=读取CSV(文件路径,编码,分隔符)
    
    JSON内容=_生成JSON(数据,缩进=2,确保ASCII=假)
    
    如果输出文件:
        打开(输出文件,'w',编码='utf-8')作为f:
            f.写入(JSON内容)
    
    返回JSON内容


defJSON转CSV(文件路径,输出文件=无,编码='utf-8',分隔符=','):
    打开(文件路径,'r',编码='utf-8')作为f:
        数据=_解析JSON(f)
    
    如果不是列表(数据):
        抛出值错误('JSON必须是数组格式')
    
    CSV内容=字典转CSV(数据,分隔符)
    
    如果输出文件:
        打开(输出文件,'w',编码=编码)作为f:
            f.写入(CSV内容)
    
    返回CSV内容


defCSV合并(*文件路径列表,输出文件=无,编码='utf-8',分隔符=','):
    合并数据=[]
    表头=无
    
    对于文件路径在文件路径列表:
        数据=读取CSV(文件路径,编码,分隔符)
        如果不是表头:
            表头=列表(数据[0].键())如果数据否则[]
        合并数据.扩展(数据)
    
    如果不是合并数据:
        返回''
    
    CSV内容=字典转CSV(合并数据,分隔符)
    
    如果输出文件:
        打开(输出文件,'w',编码=编码)作为f:
            f.写入(CSV内容)
    
    返回CSV内容


defCSV分割(文件路径,每文件行数=1000,输出前缀='split_',编码='utf-8',分隔符=','):
    数据=读取CSV列表(文件路径,编码,分隔符)
    表头=数据[0]如果数据否则[]
    数据行=数据[1:]如果长度(数据)>1否则[]
    
    输出文件列表=[]
    文件索引=0
    
    对于i在范围(0,长度(数据行),每文件行数):
        分割数据=[表头]+数据行[i:i+每文件行数]
        输出文件=f'{输出前缀}{文件索引}.csv'
        写入CSV列表(输出文件,分割数据,编码,分隔符)
        输出文件列表.追加(输出文件)
        文件索引+=1
    
    返回输出文件列表


defCSV验证(文件路径,编码='utf-8',分隔符=','):
    尝试:
        数据=读取CSV(文件路径,编码,分隔符)
        返回长度(数据)>=0
    除异常:
        返回假


defCSV转HTML表格(文件路径,编码='utf-8',分隔符=','):
    数据=读取CSV(文件路径,编码,分隔符)
    
    如果不是数据:
        return'<table></table>'
    
    表头=列表(数据[0].键())
    表头行=_连接([f'<th>{列}</th>'对于列在表头])
    
    行内容=[]
    对于行在数据:
        单元格=_连接([f'<td>{行.获取(列,"")}</td>'对于列在表头])
        行内容.追加(f'<tr>{单元格}</tr>')
    
    return f'<table>\n<thead><tr>{表头行}</tr></thead>\n<tbody>\n{_连接(行内容)}\n</tbody>\n</table>'


defCSV转Markdown表格(文件路径,编码='utf-8',分隔符=','):
    数据=读取CSV(文件路径,编码,分隔符)
    
    如果不是数据:
        返回''
    
    表头=列表(数据[0].键())
    对齐线='|'+_连接(['---']*长度(表头),'|')+'|'
    
    行=[f"|{_连接(表头,'|')}|",对齐线]
    
    对于行内容在数据:
        单元格=[]
        对于列在表头:
            值=转字符串(行内容.获取(列,''))
            值=值.替换('|','\\|')
            单元格.追加(值)
        行.追加(f"|{_连接(单元格,'|')}|")
    
    返回'\n'.连接(行)