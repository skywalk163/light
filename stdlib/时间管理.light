# 纯光明实现 —— 时间管理.light：光明内建时间管理模块（原生腿）
#
# 实现分级（诚实声明，与 断言工具.light 同模式）：
#   [纯光明·真实现] 睡眠/睡眠毫秒/精确睡眠/休眠/等待、时间戳/时间戳毫秒/
#            时间戳纳秒/性能计数器/性能计数器纳秒/单调时间、格式化耗时、
#            本地时间/UTC时间/格式化时间 —— 统一走 stdlib/time.light 内建
#            （_dv_timestamp/_sleep_sec/_clock/_strftime），原生腿 O0 真跑。
#   [引 Python: 委派 .py 真实现] 以下原生腿无法完成，委派到 stdlib/时间管理.py：
#            - 回调/函数值族：计时/计时函数/多次计时/测量执行时间/定时器/周期定时器/
#              倒计时 —— 原生腿无法把回调函数/函数值作为值传递并动态调用；
#            - 需 Python 独占 runtime：进程时间/线程时间（无 CPU 时钟 runtime）、
#              时间元组转时间戳（mktime）/解析时间（strptime）/时区偏移/时区名称/
#              夏令时（无 %z/%Z/daylight runtime）。
#            委派通过 引 Python: 按文件路径加载同名 .py，绕开同名循环导入。
#
# 注：先前版本把回调/定时器族写成「响亮抛 运行时错误」的 loud stub，导致 0.88
#    （.light 后端）的 test_计时函数/test_多次计时/test_倒计时/test_定时器 等
#    必然 RuntimeError。本地 pytest 加载 .py 真实现呈假绿。现改为委派真实现。

导入 time

导出 睡眠 睡眠毫秒 精确睡眠 计时器 计时 计时函数。
导出 多次计时 定时器 周期定时器 倒计时 时间戳 时间戳毫秒。
导出 性能计数器 性能计数器纳秒 进程时间 线程时间 格式化耗时 时间戳纳秒。
导出 休眠 等待 单调时间 测量执行时间 本地时间 UTC时间。
导出 时间元组转时间戳 格式化时间 解析时间 时区偏移 时区名称 夏令时。
导出 秒表 创建秒表。

# ---------- 加载同名 .py 真实现（绕开循环导入）----------
引 Python:
import importlib.util as _ilu, os as _os
_时间管理_py路径 = _os.path.join(_os.path.dirname(_os.path.abspath(__file__)), "时间管理.py")
_时间管理_规格 = _ilu.spec_from_file_location("_时间管理_py真实现", _时间管理_py路径)
_时间管理_real = _ilu.module_from_spec(_时间管理_规格)
_时间管理_规格.loader.exec_module(_时间管理_real)
结束引

# ---------- 回调/定时器/计时族：委派 .py（原生腿无法把函数作值传递）----------
计时 = _时间管理_real.计时
计时函数 = _时间管理_real.计时函数
多次计时 = _时间管理_real.多次计时
测量执行时间 = _时间管理_real.测量执行时间
定时器 = _时间管理_real.定时器
周期定时器 = _时间管理_real.周期定时器
倒计时 = _时间管理_real.倒计时
秒表 = _时间管理_real.秒表
创建秒表 = _时间管理_real.创建秒表

# ---------- 需 Python 独占 runtime（mktime/strptime/时区/CPU时钟）：委派 .py ----------
进程时间 = _时间管理_real.进程时间
线程时间 = _时间管理_real.线程时间
时间元组转时间戳 = _时间管理_real.时间元组转时间戳
解析时间 = _时间管理_real.解析时间
时区偏移 = _时间管理_real.时区偏移
时区名称 = _时间管理_real.时区名称
夏令时 = _时间管理_real.夏令时

# ---------- 睡眠族（纯光明，走 time.light 内建）----------
段落 睡眠 接收 秒数:
  time.sleep(转浮点(秒数))
  返回 0

段落 睡眠毫秒 接收 毫秒数:
  time.sleep_ms(转浮点(毫秒数))
  返回 0

段落 精确睡眠 接收 秒数:
  time.sleep(转浮点(秒数))
  返回 0

段落 休眠 接收 秒数:
  time.sleep(转浮点(秒数))
  返回 0

段落 等待 接收 秒数:
  time.sleep(转浮点(秒数))
  返回 0

# ---------- 时间戳 / 计数器（纯光明，走 time.light 内建）----------
段落 时间戳 接收:
  返回 time.time()

段落 时间戳毫秒 接收:
  设 t 为 time.time()
  返回 转整数(t * 1000.0)

段落 时间戳纳秒 接收:
  返回 time.time_ns()

段落 性能计数器 接收:
  返回 time.perf_counter()

段落 单调时间 接收:
  返回 time.monotonic()

段落 性能计数器纳秒 接收:
  设 v 为 time.perf_counter()
  返回 转整数(v * 1000000000.0)

# ---------- 格式化耗时（纯光明）----------
段落 格式化耗时 接收 秒数:
  设 f 为 转浮点(秒数)
  如果 f < 0.001:
    设 us 为 转整数(f * 1000000.0)
    返回 转字符串(us) 加上 "微秒"
  结束。
  如果 f < 1:
    设 ms 为 转整数(f * 1000.0)
    返回 转字符串(ms) 加上 "毫秒"
  结束。
  如果 f < 60:
    设 secs 为 转整数(f + 0.5)
    返回 转字符串(secs) 加上 "秒"
  结束。
  如果 f < 3600:
    设 m1 为 转整数(f / 60.0)
    设 s1 为 转整数(f - (转浮点(m1) * 60.0) + 0.5)
    返回 转字符串(m1) 加上 "分" 加上 转字符串(s1) 加上 "秒"
  结束。
  设 h1 为 转整数(f / 3600.0)
  设 rest 为 f - (转浮点(h1) * 3600.0)
  设 m2 为 转整数(rest / 60.0)
  设 s2 为 转整数(rest - (转浮点(m2) * 60.0) + 0.5)
  返回 转字符串(h1) 加上 "时" 加上 转字符串(m2) 加上 "分" 加上 转字符串(s2) 加上 "秒"

# ---------- 本地时间 / UTC / 格式化（纯光明，走 time.light 内建）----------
段落 本地时间 接收 时刻 = 空:
  如果 时刻 == 空:
    返回 time.localtime(time.time())
  结束。
  返回 time.localtime(转浮点(时刻))

段落 UTC时间 接收 时刻 = 空:
  如果 时刻 == 空:
    返回 time.gmtime(time.time())
  结束。
  返回 time.gmtime(转浮点(时刻))

段落 格式化时间 接收 格式 = "%Y-%m-%d %H:%M:%S", 时刻 = 空:
  如果 时刻 == 空:
    设 x 为 time.time()
    返回 time.strftime(x, 格式)
  结束。
  返回 time.strftime(转浮点(时刻), 格式)
