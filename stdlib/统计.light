# 纯光明实现 —— 本模块由光明段言自写，纯光明统计函数，不依赖 统计.py
# 提供：均值/中位数/众数/多众数/标准差/样本标准差/方差/样本方差
#       /最小值/最大值/极差/求和/四分位数/百分位数/协方差/相关系数
#       /线性回归/累积和/频率分布/标准化
# 全部只用光明内置原语，零 导入、零 引 Python。

导出 均值。
导出 中位数。
导出 众数。
导出 多众数。
导出 标准差。
导出 样本标准差。
导出 方差。
导出 样本方差。
导出 数据最小值。
导出 数据最大值。
导出 极差。
导出 求和。
导出 四分位数。
导出 百分位数。
导出 协方差。
导出 相关系数。
导出 线性回归。
导出 累积和。
导出 频率分布。
导出 标准化。

段落 求和 接收 数据:
  设 n 为 长(数据)
  设 总计 为 0
  设 i 为 0
  当 i < n:
    设 总计 为 总计 + 数据[i]
    设 i 为 i + 1
  返回 总计

段落 均值 接收 数据:
  设 n 为 长(数据)
  如果 n == 0:
    返回 0.0
  设 总计 为 0
  设 i 为 0
  当 i < n:
    设 总计 为 总计 + 数据[i]
    设 i 为 i + 1
  返回 总计 / n

段落 数据最小值 接收 数据:
  设 n 为 长(数据)
  如果 n == 0:
    返回 0
  设 结果 为 数据[0]
  设 i 为 1
  当 i < n:
    如果 数据[i] < 结果:
      设 结果 为 数据[i]
    设 i 为 i + 1
  返回 结果

段落 数据最大值 接收 数据:
  设 n 为 长(数据)
  如果 n == 0:
    返回 0
  设 结果 为 数据[0]
  设 i 为 1
  当 i < n:
    如果 数据[i] > 结果:
      设 结果 为 数据[i]
    设 i 为 i + 1
  返回 结果

段落 极差 接收 数据:
  设 n 为 长(数据)
  如果 n == 0:
    返回 0
  设 lo 为 数据[0]
  设 hi 为 数据[0]
  设 i 为 1
  当 i < n:
    如果 数据[i] < lo:
      设 lo 为 数据[i]
    如果 数据[i] > hi:
      设 hi 为 数据[i]
    设 i 为 i + 1
  返回 hi - lo

段落 方差 接收 数据:
  设 n 为 长(数据)
  如果 n == 0:
    返回 0.0
  设 m 为 均值(数据)
  设 sq 为 0.0
  设 i 为 0
  当 i < n:
    设 差 为 数据[i] - m
    设 sq 为 sq + 差 * 差
    设 i 为 i + 1
  返回 sq / n

段落 样本方差 接收 数据:
  设 n 为 长(数据)
  如果 n <= 1:
    返回 0.0
  设 m 为 均值(数据)
  设 sq 为 0.0
  设 i 为 0
  当 i < n:
    设 差 为 数据[i] - m
    设 sq 为 sq + 差 * 差
    设 i 为 i + 1
  返回 sq / (n - 1)

段落 标准差 接收 数据:
  设 n 为 长(数据)
  如果 n == 0:
    返回 0.0
  设 m 为 均值(数据)
  设 sq 为 0.0
  设 i 为 0
  当 i < n:
    设 差 为 数据[i] - m
    设 sq 为 sq + 差 * 差
    设 i 为 i + 1
  返回 _light_builtin.平方根(sq / n)

段落 样本标准差 接收 数据:
  设 n 为 长(数据)
  如果 n <= 1:
    返回 0.0
  设 m 为 均值(数据)
  设 sq 为 0.0
  设 i 为 0
  当 i < n:
    设 差 为 数据[i] - m
    设 sq 为 sq + 差 * 差
    设 i 为 i + 1
  返回 _light_builtin.平方根(sq / (n - 1))

段落 中位数 接收 数据:
  设 n 为 长(数据)
  如果 n == 0:
    返回 0.0
  设 排好 为 _light_builtin.排序(数据)
  设 中 为 n // 2
  如果 n % 2 == 0:
    设 下 为 中 - 1
    返回 (排好[下] + 排好[中]) / 2.0
  返回 排好[中]

段落 百分位数 接收 数据, 百分位:
  设 n 为 长(数据)
  如果 n == 0:
    返回 0.0
  设 排好 为 _light_builtin.排序(数据)
  设 k 为 (n - 1) * 百分位 / 100.0
  设 下 为 _light_builtin.向下取整(k)
  设 上 为 _light_builtin.向上取整(k)
  如果 下 == 上:
    返回 排好[下]
  设 权 为 k - 下
  返回 排好[下] + (排好[上] - 排好[下]) * 权

段落 四分位数 接收 数据:
  设 q1 为 百分位数(数据, 25)
  设 q2 为 百分位数(数据, 50)
  设 q3 为 百分位数(数据, 75)
  返回 (q1, q2, q3)

段落 众数 接收 数据:
  设 n 为 长(数据)
  如果 n == 0:
    返回 0.0
  设 频次 为 字典创建()
  设 i 为 0
  当 i < n:
    设 v 为 数据[i]
    设 频次 为 字典设置(频次, v, 字典获取(频次, v) + 1)
    设 i 为 i + 1
  设 键表 为 字典键列表(频次)
  设 最高值 为 键表[0]
  设 最高次 为 字典获取(频次, 键表[0])
  设 j 为 1
  设 m 为 长(键表)
  当 j < m:
    设 次数 为 字典获取(频次, 键表[j])
    如果 次数 > 最高次:
      设 最高次 为 次数
      设 最高值 为 键表[j]
    设 j 为 j + 1
  返回 最高值

段落 多众数 接收 数据:
  设 n 为 长(数据)
  如果 n == 0:
    返回 []
  设 频次 为 字典创建()
  设 i 为 0
  当 i < n:
    设 v 为 数据[i]
    设 频次 为 字典设置(频次, v, 字典获取(频次, v) + 1)
    设 i 为 i + 1
  设 键表 为 字典键列表(频次)
  设 m 为 长(键表)
  设 最高次 为 0
  设 j 为 0
  当 j < m:
    设 次数 为 字典获取(频次, 键表[j])
    如果 次数 > 最高次:
      设 最高次 为 次数
    设 j 为 j + 1
  设 结果 为 []
  设 j 为 0
  当 j < m:
    设 次数 为 字典获取(频次, 键表[j])
    如果 次数 == 最高次:
      结果.追加(键表[j])
    设 j 为 j + 1
  返回 结果

段落 协方差 接收 数据1, 数据2:
  设 n 为 长(数据1)
  如果 n == 0:
    返回 0.0
  设 m1 为 均值(数据1)
  设 m2 为 均值(数据2)
  设 总计 为 0.0
  设 i 为 0
  当 i < n:
    设 总计 为 总计 + (数据1[i] - m1) * (数据2[i] - m2)
    设 i 为 i + 1
  返回 总计 / n

段落 相关系数 接收 数据1, 数据2:
  设 n 为 长(数据1)
  如果 n == 0:
    返回 0.0
  设 m1 为 均值(数据1)
  设 m2 为 均值(数据2)
  设 cov 为 0.0
  设 v1 为 0.0
  设 v2 为 0.0
  设 i 为 0
  当 i < n:
    设 d1 为 数据1[i] - m1
    设 d2 为 数据2[i] - m2
    设 cov 为 cov + d1 * d2
    设 v1 为 v1 + d1 * d1
    设 v2 为 v2 + d2 * d2
    设 i 为 i + 1
  如果 v1 == 0.0 或 v2 == 0.0:
    返回 0.0
  返回 cov / _light_builtin.平方根(v1 * v2)

段落 线性回归 接收 数据1, 数据2:
  设 n 为 长(数据1)
  如果 n == 0:
    返回 (0.0, 0.0)
  设 m1 为 均值(数据1)
  设 m2 为 均值(数据2)
  设 分子 为 0.0
  设 分母 为 0.0
  设 i 为 0
  当 i < n:
    设 d1 为 数据1[i] - m1
    设 d2 为 数据2[i] - m2
    设 分子 为 分子 + d1 * d2
    设 分母 为 分母 + d1 * d1
    设 i 为 i + 1
  如果 分母 == 0.0:
    返回 (0.0, m2)
  设 斜率 为 分子 / 分母
  设 截距 为 m2 - 斜率 * m1
  返回 (斜率, 截距)

段落 累积和 接收 数据:
  设 n 为 长(数据)
  设 结果 为 []
  设 总计 为 0
  设 i 为 0
  当 i < n:
    设 总计 为 总计 + 数据[i]
    结果.追加(总计)
    设 i 为 i + 1
  返回 结果

段落 频率分布 接收 数据:
  设 n 为 长(数据)
  设 频次 为 字典创建()
  设 i 为 0
  当 i < n:
    设 v 为 数据[i]
    设 频次 为 字典设置(频次, v, 字典获取(频次, v) + 1)
    设 i 为 i + 1
  返回 频次

段落 标准化 接收 数据:
  设 n 为 长(数据)
  如果 n == 0:
    返回 []
  设 m 为 均值(数据)
  设 sq 为 0.0
  设 i 为 0
  当 i < n:
    设 差 为 数据[i] - m
    设 sq 为 sq + 差 * 差
    设 i 为 i + 1
  设 s 为 _light_builtin.平方根(sq / n)
  设 结果 为 []
  设 i 为 0
  当 i < n:
    如果 s == 0.0:
      结果.追加(0.0)
    否则:
      结果.追加((数据[i] - m) / s)
    设 i 为 i + 1
  返回 结果
