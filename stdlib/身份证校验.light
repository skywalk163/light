}

# 校验码加权因子（.py _WEIGHT_FACTORS，17 个）
设 权重 为 [7, 9, 10, 5, 8, 4, 2, 1, 6, 3, 7, 9, 10, 5, 8, 4, 2]
# 校验码映射表（.py _CHECK_CODE_MAP：余数 0-10 → 校验字符）
设 校验码表 为 ["1", "0", "X", "9", "8", "7", "6", "5", "4", "3", "2"]

# ── 私有：整串是否全为 ASCII 数字（对齐 .py isdigit；空串返回假）──
段落 全数字 接收 文本:
  如果 长(文本) == 0:
    返回 假
  设 i 为 0
  当 i < 长(文本):
    设 码 为 码位(文本[i])
    如果 码 < 48:
      返回 假
    如果 码 > 57:
      返回 假
    设 i 为 i 加上 1
  返回 真

# ── 私有：末位校验字符是否合法（数字 / X / x；对齐正则 [\dXx]）──
段落 末位合法 接收 字符:
  如果 字符 == "X":
    返回 真
  如果 字符 == "x":
    返回 真
  设 码 为 码位(字符)
  如果 码 >= 48:
    如果 码 <= 57:
      返回 真
  返回 假

# ── 私有：18 位格式整体匹配（对齐 _ID_PATTERN 全串锚定）──
# 前 17 位全数字 + 末位 [\dXx]，长度天然须为 18
段落 匹配格式 接收 号码:
  如果 长(号码) != 18:
    返回 假
  如果 全数字(截取(号码, 0, 17)) == 假:
    返回 假
  返回 末位合法(号码[17])

# ── 私有：是否闰年（能被 400 整除；或能被 4 整除且不能被 100 整除）──
段落 是闰年 接收 年:
  如果 取模(年, 400) == 0:
    返回 真
  如果 取模(年, 100) == 0:
    返回 假
  如果 取模(年, 4) == 0:
    返回 真
  返回 假

# ── 私有：月份天数（闰 2 月 29；4/6/9/11 为 30；其余 31）──
段落 月天数 接收 月, 闰:
  如果 月 == 2:
    如果 闰:
      返回 29
    返回 28
  如果 月 == 4:
    返回 30
  如果 月 == 6:
    返回 30
  如果 月 == 9:
    返回 30
  如果 月 == 11:
    返回 30
  返回 31

# ── 私有：出生日期合法性（对齐 datetime.date 抛错判定）──
段落 验证生日合法 接收 年, 月, 日:
  如果 年 < 1:
    返回 假
  如果 月 < 1:
    返回 假
  如果 月 > 12:
    返回 假
  如果 日 < 1:
    返回 假
  如果 日 > 月天数(月, 是闰年(年)):
    返回 假
  返回 真

# ── 私有：顺序码 → 性别（末位奇男偶女；对齐 _get_gender_from_code）──
段落 性别自顺序码 接收 顺序码:
  如果 取模(顺序码, 2) == 1:
    返回 "男"
  返回 "女"

# ── 私有：6 位地区码 → 地区名（对齐 _lookup_region）──
# 先查 4 位市级表（命中则 省名+市名，.py 该分支两个 return 相同，照抄拼接），
# 再回退 2 位省级表；都未命中返回 空（对齐 .py 返回 None）
# O0 workaround：两个「直接来自字典读取」的字符串做 加上 会得 0（实测），
#   每个字典值先 加上 "" 归一化一次再拼接（任一侧经过字符串运算即恢复）。
段落 查询地区 接收 代码:
  设 市 为 字典获取(市表, 截取(代码, 0, 4), "") 加上 ""
  如果 市 != "":
    设 省 为 字典获取(省表, 截取(代码, 0, 2), "") 加上 ""
    返回 省 加上 市
  设 省 为 字典获取(省表, 截取(代码, 0, 2), "") 加上 ""
  如果 省 == "":
    返回 空
  返回 省

# ── 私有：错误结果字典（对齐 _make_error_result）──
段落 构建错误结果 接收 错误, 生日, 性别, 地区:
  设 结果 为 {
    "valid": 假,
    "birthday": 生日,
    "gender": 性别,
    "region": 地区,
    "errors": 错误
  }
  返回 结果

# ── 计算校验码(号码) → str ──
# 取前 17 位数字加权和 %11 查表；长度不足 17 或含非数字返回 ""
# （对齐 .py generate_check_digit；注意 .py 用 // 的地方本实现用 整除）
段落 计算校验码 接收 号码:
  如果 长(号码) < 17:
    返回 ""
  设 前17 为 截取(号码, 0, 17)
  如果 全数字(前17) == 假:
    返回 ""
  设 总和 为 0
  设 i 为 0
  当 i < 17:
    设 总和 为 总和 加上 (整数(前17[i]) 乘以 权重[i])
    设 i 为 i 加上 1
  返回 校验码表[取模(总和, 11)]

# ── 提取出生日期(号码) → str ──
# 对齐 .py get_birthday：格式不匹配返回 ""，匹配返回 "YYYY-MM-DD"
段落 提取出生日期 接收 号码:
  如果 匹配格式(号码) == 假:
    返回 ""
  设 年 为 截取(号码, 6, 4)
  设 月 为 截取(号码, 10, 2)
  设 日 为 截取(号码, 12, 2)
  返回 年 加上 "-" 加上 月 加上 "-" 加上 日

# ── 提取性别(号码) → str ──
# 对齐 .py get_gender：格式不匹配返回 ""
段落 提取性别 接收 号码:
  如果 匹配格式(号码) == 假:
    返回 ""
  返回 性别自顺序码(整数(截取(号码, 14, 3)))

# ── 提取地区(号码) → str ──
# 对齐 .py get_region：格式不匹配返回 ""；地区未命中（空）返回 ""
段落 提取地区 接收 号码:
  如果 匹配格式(号码) == 假:
    返回 ""
  设 地区 为 查询地区(截取(号码, 0, 6))
  如果 地区 == 空:
    返回 ""
  返回 地区

# ── 校验身份证(号码) → dict ──
# 返回键与 .py validate 一致：valid/birthday/gender/region/errors
段落 校验身份证 接收 号码:
  设 错误 为 新建列表()
  # 空串/None 与长度 != 18 同归「身份证号码必须为18位」（.py 首个 if）
  如果 长(号码) != 18:
    追加(错误, "身份证号码必须为18位")
    返回 构建错误结果(错误, "", "", "")
  如果 匹配格式(号码) == 假:
    追加(错误, "身份证号码格式不正确")
    返回 构建错误结果(错误, "", "", "")
  设 地区码 为 截取(号码, 0, 6)
  设 年 为 截取(号码, 6, 4)
  设 月 为 截取(号码, 10, 2)
  设 日 为 截取(号码, 12, 2)
  设 顺序码 为 截取(号码, 14, 3)
  设 校验位 为 号码[17]
  如果 校验位 == "x":
    设 校验位 为 "X"
  设 生日 为 年 加上 "-" 加上 月 加上 "-" 加上 日
  如果 验证生日合法(整数(年), 整数(月), 整数(日)) == 假:
    追加(错误, "出生日期无效: " 加上 生日)
  设 地区 为 查询地区(地区码)
  如果 地区 == 空:
    追加(错误, "地区代码无效: " 加上 地区码)
  设 期望 为 计算校验码(号码)
  如果 校验位 != 期望:
    追加(错误, "校验码不匹配: 期望 " 加上 期望 加上 ", 实际 " 加上 校验位)
  设 性别 为 性别自顺序码(整数(顺序码))
  如果 长(错误) > 0:
    返回 构建错误结果(错误, 生日, 性别, 地区)
  如果 地区 == 空:
    设 地区 为 "未知地区"
  设 结果 为 {
    "valid": 真,
    "birthday": 生日,
    "gender": 性别,
    "region": 地区,
    "errors": 错误
  }
  返回 结果
