  "15": "内蒙古自治区", "21": "辽宁省", "22": "吉林省", "23": "黑龙江省",
  "31": "上海市", "32": "江苏省", "33": "浙江省", "34": "安徽省",
  "35": "福建省", "36": "江西省", "37": "山东省", "41": "河南省",
  "42": "湖北省", "43": "湖南省", "44": "广东省", "45": "广西壮族自治区",
  "46": "海南省", "50": "重庆市", "51": "四川省", "52": "贵州省",
  "53": "云南省", "54": "西藏自治区", "61": "陕西省", "62": "甘肃省",
