# 纯光明实现 —— stdlib/农历.py 的原生腿真实现
#
# 提供公历转农历、农历转公历、农历节日查询、闰月判断、干支纪年、生肖等功能。
#
# R13B 数据范围扩展：1900-2098（199 年），数据源为 lunardate 权威表逐日推导
# （月长/闰月/春节公历），并经多组历史锚点交叉验证（开国大典/奥运开幕等）。
# 数据组织：每年一行 17 元素 [农历年, 春节月, 春节日, 12个月长, 闰月号, 闰月长]，
# 按 10 年一组分 20 个分段函数返回（每函数独立槽位作用域，O0 编译安全）。
#
# 能力边界（详见 docs/known_issues.md R11C/R13B 章节）：
#   1. 数据范围 1900-2098；范围外走近似降级（与 .py fallback 对齐）。
#      注：.py 的 2024-2030 数据表与真实日历存在月长偏差（R11C 已标注），
#      本实现自 R13B 起全范围采用精确农历数据（以真实日历为准）。
#   2. 节气算法未实现（.py 版本也未实现节气，仅做农历换算）。
#   3. 当前农历() 依赖系统日期，原生腿无日期原语，返回固定占位并标注。
#
# 导出与 .py __all__ 对齐：公历转农历 当前农历 查询节日 判断闰月
# 额外导出简单标量函数便于对拍：农历年 农历月 农历日 是否闰月 月名 日名 干支年 生肖
# 额外导出：取春节日期（供 中国传统节日.light 复用扩展范围数据）

导出 公历转农历 农历转公历 当前农历 查询节日 判断闰月 LunarCalendar。
导出 农历年 农历月 农历日 是否闰月 月名 日名 干支年 生肖。
导出 公历转儒略日 儒略日转公历 是公历闰年 农历月天数 取春节日期。

设 数据起始年 为 1900
设 数据结束年 为 2098

# 农历月份名称
设 农历月名表 为 ["正月","二月","三月","四月","五月","六月","七月","八月","九月","十月","冬月","腊月"]

# 农历日名称
设 农历日名表 为 [
  "初一","初二","初三","初四","初五","初六","初七","初八","初九","初十",
  "十一","十二","十三","十四","十五","十六","十七","十八","十九","二十",
  "廿一","廿二","廿三","廿四","廿五","廿六","廿七","廿八","廿九","三十"
]

# 天干地支
设 天干表 为 ["甲","乙","丙","丁","戊","己","庚","辛","壬","癸"]
设 地支表 为 ["子","丑","寅","卯","辰","巳","午","未","申","酉","戌","亥"]
设 生肖表 为 ["鼠","牛","虎","兔","龙","蛇","马","羊","猴","鸡","狗","猪"]

# 传统节日表：[农历月, 农历日, 名称]
设 传统节日表 为 [
  [1,1,"春节"], [1,15,"元宵节"], [2,2,"龙抬头"], [3,3,"上巳节"],
  [5,5,"端午节"], [6,6,"天贶节"], [7,7,"七夕节"], [7,15,"中元节"],
  [8,15,"中秋节"], [9,9,"重阳节"], [10,1,"寒衣节"], [10,15,"下元节"],
  [12,8,"腊八节"], [12,23,"小年（北方）"], [12,24,"小年（南方）"], [12,30,"除夕"]
]

