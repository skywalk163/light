# 纯光明实现 —— 通用数据结构（取代同名 .py 壳）
#
# 对齐 stdlib/数据结构.py 的全部导出。
#
# 原生腿实现说明（重要）：
#   原生腿列表为「直持引用 + 原地 .追加」语义，但 .弹出()/.清除()/.索引() 等
#   方法在原生后端失效（实测返回空、不修改），且「列表 加上 [x]」拼接返回空。
#   因此所有「弹出/删除/插入/清空/查找下标」均用手写拷贝循环或切片实现，
#   不使用拼接与原生失效方法。字典里的列表按值语义不持久化，故本模块统一用
#   「列表直持」表示结构（栈/队列/双端队列/链表即列表；优先队列为 [项,优先级]
#   二元列表的列表；二叉搜索树为 [值,左索引,右索引] 节点列表）。

# ============================================================
# 栈（Stack，后进先出）—— 列表直持
# ============================================================

段落 创建栈 接收 初始元素 = 空:
  设 栈 为 []
  如果 初始元素 == 空:
    返回 栈
  设 i 为 0
  当 i < 长(初始元素):
    栈.追加(初始元素[i])
    设 i 为 i 加上 1
  返回 栈

段落 压入 接收 栈, 元素:
  栈.追加(元素)
  返回 栈

段落 入栈 接收 栈, 元素:
  返回 压入(栈, 元素)

段落 弹出 接收 栈:
  如果 长(栈) == 0:
    抛出 新建 异常("栈为空")
  返回 栈[0:长(栈) 减去 1]

段落 出栈 接收 栈:
  返回 弹出(栈)

段落 顶部 接收 栈:
  如果 长(栈) == 0:
    抛出 新建 异常("栈为空")
  返回 栈[长(栈) 减去 1]

段落 查看栈顶 接收 栈:
  返回 顶部(栈)

段落 栈是否为空 接收 栈:
  返回 长(栈) == 0

段落 栈空 接收 栈:
  返回 长(栈) == 0

段落 栈大小 接收 栈:
  返回 长(栈)

段落 清空栈 接收 栈:
  返回 []

段落 栈转为列表 接收 栈:
  设 结果 为 []
  设 i 为 0
  当 i < 长(栈):
    结果.追加(栈[i])
    设 i 为 i 加上 1
  返回 结果

# ============================================================
# 队列（Queue，先进先出）—— 列表直持（队尾追加，队首出队）
# ============================================================

段落 创建队列 接收 初始元素 = 空:
  设 队列 为 []
  如果 初始元素 == 空:
    返回 队列
  设 i 为 0
  当 i < 长(初始元素):
    队列.追加(初始元素[i])
    设 i 为 i 加上 1
  返回 队列

段落 入队 接收 队列, 元素:
  队列.追加(元素)
  返回 队列

段落 出队 接收 队列:
  如果 长(队列) == 0:
    抛出 新建 异常("队列为空")
  返回 队列[1:长(队列)]

段落 队首 接收 队列:
  如果 长(队列) == 0:
    抛出 新建 异常("队列为空")
  返回 队列[0]

段落 查看队首 接收 队列:
  返回 队首(队列)

段落 队尾 接收 队列:
  如果 长(队列) == 0:
    抛出 新建 异常("队列为空")
  返回 队列[长(队列) 减去 1]

段落 查看队尾 接收 队列:
  返回 队尾(队列)

段落 队列是否为空 接收 队列:
  返回 长(队列) == 0

段落 队列空 接收 队列:
  返回 长(队列) == 0

段落 队列大小 接收 队列:
  返回 长(队列)

段落 清空队列 接收 队列:
  返回 []

段落 队列转为列表 接收 队列:
  设 结果 为 []
  设 i 为 0
  当 i < 长(队列):
    结果.追加(队列[i])
    设 i 为 i 加上 1
  返回 结果

# ============================================================
# 双端队列（Deque）—— 列表直持
# ============================================================

段落 创建双端队列 接收 初始元素 = 空:
  设 d 为 []
  如果 初始元素 == 空:
    返回 d
  设 i 为 0
  当 i < 长(初始元素):
    d.追加(初始元素[i])
    设 i 为 i 加上 1
  返回 d

段落 左入 接收 d, 元素:
  设 新 为 [元素]
  设 i 为 0
  当 i < 长(d):
    新.追加(d[i])
    设 i 为 i 加上 1
  返回 新

段落 左入队 接收 d, 元素:
  返回 左入(d, 元素)

段落 右入 接收 d, 元素:
  d.追加(元素)
  返回 d

段落 右入队 接收 d, 元素:
  返回 右入(d, 元素)

段落 左出 接收 d:
  如果 长(d) == 0:
    抛出 新建 异常("双端队列为空")
  返回 d[1:长(d)]

段落 左出队 接收 d:
  返回 左出(d)

段落 右出 接收 d:
  如果 长(d) == 0:
    抛出 新建 异常("双端队列为空")
  返回 d[0:长(d) 减去 1]

段落 右出队 接收 d:
  返回 右出(d)

段落 查看左端 接收 d:
  如果 长(d) == 0:
    抛出 新建 异常("双端队列为空")
  返回 d[0]

段落 查看右端 接收 d:
  如果 长(d) == 0:
    抛出 新建 异常("双端队列为空")
  返回 d[长(d) 减去 1]

段落 双端队列是否为空 接收 d:
  返回 长(d) == 0

段落 双端队列空 接收 d:
  返回 长(d) == 0

段落 双端队列大小 接收 d:
  返回 长(d)

段落 清空双端队列 接收 d:
  返回 []

段落 双端队列转为列表 接收 d:
  设 结果 为 []
  设 i 为 0
  当 i < 长(d):
    结果.追加(d[i])
    设 i 为 i 加上 1
  返回 结果

# ============================================================
# 优先队列（Priority Queue）—— 列表直持，元素为 [项, 优先级]
# 出队返回优先级最小的元素（Python heapq 默认最小堆语义）
# ============================================================

段落 创建优先队列 接收 初始元素 = 空:
  设 pq 为 []
  如果 初始元素 == 空:
    返回 pq
  设 i 为 0
  当 i < 长(初始元素):
    pq.追加(初始元素[i])
    设 i 为 i 加上 1
  返回 pq

段落 优先入队 接收 pq, 元素, 优先级 = 0:
  pq.追加([元素, 优先级])
  返回 pq

段落 优先出队 接收 pq:
  如果 长(pq) == 0:
    抛出 新建 异常("优先队列为空")
  设 最优位 为 0
  设 最优优先 为 pq[0][1]
  设 i 为 1
  当 i < 长(pq):
    如果 pq[i][1] < 最优优先:
      设 最优优先 为 pq[i][1]
      设 最优位 为 i
    设 i 为 i 加上 1
  设 最优元素 为 pq[最优位][0]
  设 新 为 []
  设 j 为 0
  当 j < 长(pq):
    如果 j != 最优位:
      新.追加(pq[j])
    设 j 为 j 加上 1
  返回 新

段落 优先队首 接收 pq:
  如果 长(pq) == 0:
    抛出 新建 异常("优先队列为空")
  设 最优优先 为 pq[0][1]
  设 i 为 1
  当 i < 长(pq):
    如果 pq[i][1] < 最优优先:
      设 最优优先 为 pq[i][1]
    设 i 为 i 加上 1
  返回 最优优先

段落 优先队首元素 接收 pq:
  设 最优位 为 0
  设 最优优先 为 pq[0][1]
  设 i 为 1
  当 i < 长(pq):
    如果 pq[i][1] < 最优优先:
      设 最优优先 为 pq[i][1]
      设 最优位 为 i
    设 i 为 i 加上 1
  返回 pq[最优位][0]

段落 优先队首优先级 接收 pq:
  返回 优先队首(pq)

段落 优先队列是否为空 接收 pq:
  返回 长(pq) == 0

段落 优先队列大小 接收 pq:
  返回 长(pq)

段落 清空优先队列 接收 pq:
  返回 []

段落 优先队列转为列表 接收 pq:
  设 结果 为 []
  设 i 为 0
  当 i < 长(pq):
    结果.追加(pq[i][0])
    设 i 为 i 加上 1
  返回 结果

# ============================================================
# 单链表（Singly Linked List）—— 列表直持（值列表），行为对齐 .py
# ============================================================

段落 创建链表 接收 初始元素 = 空:
  设 链表 为 []
  如果 初始元素 == 空:
    返回 链表
  设 i 为 0
  当 i < 长(初始元素):
    链表.追加(初始元素[i])
    设 i 为 i 加上 1
  返回 链表

段落 头部插入 接收 链表, 值:
  设 新 为 [值]
  设 i 为 0
  当 i < 长(链表):
    新.追加(链表[i])
    设 i 为 i 加上 1
  返回 新

段落 尾部插入 接收 链表, 值:
  链表.追加(值)
  返回 链表

段落 指定位置插入 接收 链表, 位置, 值:
  设 新 为 []
  设 i 为 0
  当 i < 长(链表):
    如果 i == 位置:
      新.追加(值)
    新.追加(链表[i])
    设 i 为 i 加上 1
  如果 位置 >= 长(链表):
    新.追加(值)
  返回 新

段落 删除头部 接收 链表:
  如果 长(链表) == 0:
    抛出 新建 异常("链表为空")
  返回 链表[1:长(链表)]

段落 删除尾部 接收 链表:
  如果 长(链表) == 0:
    抛出 新建 异常("链表为空")
  返回 链表[0:长(链表) 减去 1]

段落 删除指定值 接收 链表, 值:
  设 新 为 []
  设 i 为 0
  当 i < 长(链表):
    如果 链表[i] == 值:
      如果 假:
        新.追加(链表[i])
    否则:
      新.追加(链表[i])
    设 i 为 i 加上 1
  返回 新

段落 链表查找 接收 链表, 值:
  设 i 为 0
  当 i < 长(链表):
    如果 链表[i] == 值:
      返回 真
    设 i 为 i 加上 1
  返回 假

段落 链表获取 接收 链表, 位置:
  如果 位置 < 0 或 位置 >= 长(链表):
    抛出 新建 异常("索引越界")
  返回 链表[位置]

段落 链表修改 接收 链表, 位置, 值:
  设 新 为 []
  设 i 为 0
  当 i < 长(链表):
    如果 i == 位置:
      新.追加(值)
    否则:
      新.追加(链表[i])
    设 i 为 i 加上 1
  返回 新

段落 链表是否为空 接收 链表:
  返回 长(链表) == 0

段落 链表大小 接收 链表:
  返回 长(链表)

段落 清空链表 接收 链表:
  返回 []

段落 链表转为列表 接收 链表:
  设 结果 为 []
  设 i 为 0
  当 i < 长(链表):
    结果.追加(链表[i])
    设 i 为 i 加上 1
  返回 结果

# ============================================================
# 二叉搜索树（BST）—— 节点列表 [值, 左索引, 右索引]（索引 -1 表示空）
# 原生腿无递归深度保障风险，插入/查找用迭代；遍历用显式栈（列表）。
# ============================================================

段落 创建二叉搜索树:
  # 1-based 节点索引：索引 0 为哑元，真实节点从索引 1 起，
  # 规避原生腿「读下标 0 返回 []」缺陷。
  返回 [[0, -1, -1]]

段落 二叉插入 接收 树, 值:
  如果 长(树) == 1:
    树.追加([值, -1, -1])
    返回 树
  设 当前 为 1
  当 真:
    设 节点 为 树[当前]
    设 节点值 为 节点[0]
    如果 值 < 节点值:
      设 左 为 节点[1]
      如果 左 == -1:
        设 树[当前] 为 [节点值, 长(树), 节点[2]]
        树.追加([值, -1, -1])
        返回 树
      否则:
        设 当前 为 左
    否则 如果 值 > 节点值:
      设 右 为 节点[2]
      如果 右 == -1:
        设 树[当前] 为 [节点值, 节点[1], 长(树)]
        树.追加([值, -1, -1])
        返回 树
      否则:
        设 当前 为 右
    否则:
      返回 树

段落 二叉查找 接收 树, 值:
  设 当前 为 1
  当 当前 >= 1 且 当前 < 长(树):
    设 节点值 为 树[当前][0]
    如果 值 == 节点值:
      返回 真
    如果 值 < 节点值:
      设 当前 为 树[当前][1]
    否则:
      设 当前 为 树[当前][2]
  返回 假

段落 二叉中序遍历 接收 树:
  设 结果 为 []
  设 栈 为 []
  设 当前 为 1
  当 真:
    当 当前 >= 1 且 当前 < 长(树):
      栈.追加(当前)
      设 当前 为 树[当前][1]
    如果 长(栈) == 0:
      返回 结果
    设 节点 为 栈[长(栈) 减去 1]
    设 栈 为 栈[0:长(栈) 减去 1]
    结果.追加(树[节点][0])
    设 当前 为 树[节点][2]
  返回 结果

段落 二叉前序遍历 接收 树:
  设 结果 为 []
  如果 长(树) <= 1:
    返回 结果
  设 栈 为 [1]
  当 长(栈) > 0:
    设 节点 为 栈[长(栈) 减去 1]
    设 栈 为 栈[0:长(栈) 减去 1]
    结果.追加(树[节点][0])
    设 右 为 树[节点][2]
    设 左 为 树[节点][1]
    如果 右 >= 0:
      栈.追加(右)
    如果 左 >= 0:
      栈.追加(左)
  返回 结果

段落 二叉后序遍历 接收 树:
  设 结果 为 []
  如果 长(树) <= 1:
    返回 结果
  设 栈 为 [1]
  设 已访问 为 []
  当 长(栈) > 0:
    设 节点 为 栈[长(栈) 减去 1]
    设 栈 为 栈[0:长(栈) 减去 1]
    已访问.追加(节点)
    设 左 为 树[节点][1]
    设 右 为 树[节点][2]
    如果 左 >= 0:
      栈.追加(左)
    如果 右 >= 0:
      栈.追加(右)
  设 i 为 长(已访问) 减去 1
  当 i >= 0:
    结果.追加(树[已访问[i]][0])
    设 i 为 i 减去 1
  返回 结果

段落 二叉层序遍历 接收 树:
  设 结果 为 []
  如果 长(树) <= 1:
    返回 结果
  设 队列 为 [1]
  当 长(队列) > 0:
    设 节点 为 队列[0]
    设 队列 为 队列[1:长(队列)]
    结果.追加(树[节点][0])
    设 左 为 树[节点][1]
    设 右 为 树[节点][2]
    如果 左 >= 0:
      队列.追加(左)
    如果 右 >= 0:
      队列.追加(右)
  返回 结果

段落 二叉大小 接收 树:
  返回 长(树) 减去 1

段落 二叉高度 接收 树:
  如果 长(树) <= 1:
    返回 0
  设 栈 为 [[1, 1]]
  设 最大 为 1
  当 长(栈) > 0:
    设 帧 为 栈[长(栈) 减去 1]
    设 栈 为 栈[0:长(栈) 减去 1]
    设 节点 为 帧[0]
    设 深度 为 帧[1]
    如果 深度 > 最大:
      设 最大 为 深度
    设 左 为 树[节点][1]
    设 右 为 树[节点][2]
    如果 左 >= 0:
      栈.追加([左, 深度 加上 1])
    如果 右 >= 0:
      栈.追加([右, 深度 加上 1])
  返回 最大

段落 二叉是否为空 接收 树:
  返回 长(树) <= 1

段落 清空二叉搜索树 接收 树:
  返回 [[0, -1, -1]]

# ============================================================
# 模块级函数式包装（对齐 .py 顶层函数）
# ============================================================

段落 入栈顶层 接收 栈, 元素:
  返回 压入(栈, 元素)

导出 创建栈 压入 入栈 弹出 出栈 顶部 查看栈顶 栈是否为空 栈空 栈大小 清空栈 栈转为列表。
导出 创建队列 入队 出队 队首 查看队首 队尾 查看队尾 队列是否为空 队列空 队列大小 清空队列 队列转为列表。
导出 创建双端队列 左入 左入队 右入 右入队 左出 左出队 右出 右出队 查看左端 查看右端 双端队列是否为空 双端队列空 双端队列大小 清空双端队列 双端队列转为列表。
导出 创建优先队列 优先入队 优先出队 优先队首 优先队首元素 优先队首优先级 优先队列是否为空 优先队列大小 清空优先队列 优先队列转为列表。
导出 创建链表 头部插入 尾部插入 指定位置插入 删除头部 删除尾部 删除指定值 链表查找 链表获取 链表修改 链表是否为空 链表大小 清空链表 链表转为列表。
导出 创建二叉搜索树 二叉插入 二叉查找 二叉中序遍历 二叉前序遍历 二叉后序遍历 二叉层序遍历 二叉大小 二叉高度 二叉是否为空 清空二叉搜索树。
