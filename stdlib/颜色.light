# 纯光明实现 —— 颜色处理（取代同名 .py 壳）。
#
# 对齐 stdlib/颜色.py 的导出。colorsys（RGB↔HSV / RGB↔HLS）算法纯光明重写
# （colorsys 本身是纯 Python 算法，无标准库依赖）；十六进制解析纯实现
# （re 部分以字符级扫描替代，支持 #RRGGBB / #RGB / rgb(r,g,b) / r,g,b）。
#
# O0 已知规避：不写负数字面量（0 - x）、int/int 除法按需提升为浮点。

导出 RGB解析 RGB转十六进制 十六进制转RGB RGB转HSL HSL转RGB RGB转HSV HSV转RGB。
导出 颜色混合 颜色亮度 颜色反转 颜色变亮 颜色变暗 颜色透明 获取颜色名称。

设 颜色十六进制表 为 "0123456789ABCDEF"

# ── 颜色名映射（对齐 颜色.py 常量表）──
设 颜色键们 为 ["#FF0000", "#00FF00", "#0000FF", "#FFFFFF", "#000000", "#FFFF00", "#FF00FF", "#00FFFF", "#C0C0C0", "#808080", "#800000", "#808000", "#008000", "#800080", "#008080", "#000080", "#FFA500", "#FFC0CB", "#A52A2A", "#FFD700", "#F0F8FF", "#FAEBD7", "#7FFFD4", "#F0FFFF", "#F5F5DC", "#FFE4C4", "#FF7F50", "#6495ED", "#DC143C", "#00BFFF", "#696969", "#FF1493", "#FF4500", "#2E8B57", "#F0E68C", "#FFFACD", "#E6E6FA", "#FFE4E1", "#FFE4B5", "#FFDAB9", "#FFA07A", "#87CEEB", "#DDA0DD", "#F08080", "#FA8072", "#F4A460", "#D2B48C", "#FF6347", "#EE82EE", "#F5DEB3"]
设 颜色名们 为 ["红色", "绿色", "蓝色", "白色", "黑色", "黄色", "品红", "青色", "银色", "灰色", "栗色", "橄榄色", "深绿", "紫色", "青色", "深蓝", "橙色", "粉色", "棕色", "金色", "爱丽丝蓝", "古董白", "碧绿", "天蓝", "米色", "饼干色", "珊瑚色", "矢车菊蓝", "绯红", "深天蓝", "暗灰", "深粉", "橙红", "海绿", "卡其", "柠檬绸", "薰衣草", "薄雾玫瑰", "鹿皮色", "桃色", "亮鲑鱼", "天蓝", "李色", "亮珊瑚", "鲑鱼", "沙色", "黄褐", "番茄", "紫罗兰", "小麦色"]

# ── 十六进制辅助 ──

段落 颜色十六进制单值 接收 c:
  设 o 为 码位(c)
  如果 o >= 48:
    如果 o <= 57:
      返回 o - 48
  如果 o >= 65:
    如果 o <= 70:
      返回 o - 55
  如果 o >= 97:
    如果 o <= 102:
      返回 o - 87
  返回 0 - 1

段落 颜色读hex 接收 文本, 起, 位数:
  设 值 为 0
  设 k 为 0
  当 k < 位数:
    设 单 为 颜色十六进制单值(文本[起 + k])
    如果 单 < 0:
      返回 0 - 1
    设 值 为 值 * 16 + 单
    设 k 为 k + 1
  返回 值

段落 颜色hex2 接收 b:
  设 高 为 整除(b, 16)
  设 低 为 取模(b, 16)
  返回 颜色十六进制表[高] 加上 颜色十六进制表[低]

段落 颜色验证RGB 接收 r, g, b:
  如果 r < 0:
    抛出 运行时错误("RGB 分量超出范围 (0-255)")
  如果 r > 255:
    抛出 运行时错误("RGB 分量超出范围 (0-255)")
  如果 g < 0:
    抛出 运行时错误("RGB 分量超出范围 (0-255)")
  如果 g > 255:
    抛出 运行时错误("RGB 分量超出范围 (0-255)")
  如果 b < 0:
    抛出 运行时错误("RGB 分量超出范围 (0-255)")
  如果 b > 255:
    抛出 运行时错误("RGB 分量超出范围 (0-255)")
  返回 0

# ── colorsys 算法纯光明重写（输入输出均为 0-1 浮点）──

段落 颜色最大 接收 a, b, c:
  设 结果 为 a
  如果 b > 结果:
    设 结果 为 b
  如果 c > 结果:
    设 结果 为 c
  返回 结果

段落 颜色最小 接收 a, b, c:
  设 结果 为 a
  如果 b < 结果:
    设 结果 为 b
  如果 c < 结果:
    设 结果 为 c
  返回 结果

# 浮点取模：runtime 对负数为 fmod 语义（Python % 为下取整语义），
# 色相可为负（如 r==最大 时 h=bc-gc<0），需用下取整修正。
段落 颜色取模 接收 x, m:
  设 商 为 _light_builtin.向下取整(x / m)
  返回 x - 商 * m

段落 颜色rgb转hsv 接收 r, g, b:
  设 最大 为 颜色最大(r, g, b)
  设 最小 为 颜色最小(r, g, b)
  设 v 为 最大
  如果 最小 == 最大:
    返回 [0.0, 0.0, v]
  设 跨度 为 最大 - 最小
  设 s 为 跨度 / 最大
  设 rc 为 (最大 - r) / 跨度
  设 gc 为 (最大 - g) / 跨度
  设 bc 为 (最大 - b) / 跨度
  设 h 为 0.0
  如果 r == 最大:
    设 h 为 bc - gc
  否则如果 g == 最大:
    设 h 为 2.0 + rc - bc
  否则:
    设 h 为 4.0 + gc - rc
  设 h 为 颜色取模(h / 6.0, 1.0)
  返回 [h, s, v]

段落 颜色hsv转rgb 接收 h, s, v:
  如果 s == 0.0:
    返回 [v, v, v]
  设 i 为 整数(h * 6.0)
  设 f 为 h * 6.0 - i
  设 p 为 v * (1.0 - s)
  设 q 为 v * (1.0 - s * f)
  设 t 为 v * (1.0 - s * (1.0 - f))
  设 余 为 取模(i, 6)
  如果 余 == 0:
    返回 [v, t, p]
  如果 余 == 1:
    返回 [q, v, p]
  如果 余 == 2:
    返回 [p, v, t]
  如果 余 == 3:
    返回 [p, q, v]
  如果 余 == 4:
    返回 [t, p, v]
  返回 [v, p, q]

段落 颜色rgb转hls 接收 r, g, b:
  设 最大 为 颜色最大(r, g, b)
  设 最小 为 颜色最小(r, g, b)
  设 l 为 (最大 + 最小) / 2.0
  如果 最小 == 最大:
    返回 [0.0, l, 0.0]
  设 跨度 为 最大 - 最小
  设 s 为 跨度 / (最大 + 最小)
  如果 l > 0.5:
    设 s 为 跨度 / (2.0 - 最大 - 最小)
  设 rc 为 (最大 - r) / 跨度
  设 gc 为 (最大 - g) / 跨度
  设 bc 为 (最大 - b) / 跨度
  设 h 为 0.0
  如果 r == 最大:
    设 h 为 bc - gc
  否则如果 g == 最大:
    设 h 为 2.0 + rc - bc
  否则:
    设 h 为 4.0 + gc - rc
  设 h 为 颜色取模(h / 6.0, 1.0)
  返回 [h, l, s]

段落 颜色色相分量 接收 m1, m2, 色相:
  设 hue 为 颜色取模(色相, 1.0)
  如果 hue < 0.16666666666666666:
    返回 m1 + (m2 - m1) * hue * 6.0
  如果 hue < 0.5:
    返回 m2
  如果 hue < 0.6666666666666666:
    返回 m1 + (m2 - m1) * (0.6666666666666666 - hue) * 6.0
  返回 m1

段落 颜色hls转rgb 接收 h, l, s:
  如果 s == 0.0:
    返回 [l, l, l]
  设 m2 为 l * (1.0 + s)
  如果 l > 0.5:
    设 m2 为 l + s - l * s
  设 m1 为 2.0 * l - m2
  设 r 为 颜色色相分量(m1, m2, h + 0.3333333333333333)
  设 g 为 颜色色相分量(m1, m2, h)
  设 b 为 颜色色相分量(m1, m2, h - 0.3333333333333333)
  返回 [r, g, b]

# ── 公开转换（RGB 0-255，H 0-360，S/L/V 0-100）──

段落 RGB转HSL 接收 r, g, b:
  颜色验证RGB(r, g, b)
  设 结果 为 颜色rgb转hls((r + 0.0) / 255.0, (g + 0.0) / 255.0, (b + 0.0) / 255.0)
  返回 [结果[0] * 360.0, 结果[2] * 100.0, 结果[1] * 100.0]

段落 HSL转RGB 接收 h, s, l:
  设 结果 为 颜色hls转rgb(h / 360.0, l / 100.0, s / 100.0)
  返回 [整数(结果[0] * 255.0), 整数(结果[1] * 255.0), 整数(结果[2] * 255.0)]

段落 RGB转HSV 接收 r, g, b:
  颜色验证RGB(r, g, b)
  设 结果 为 颜色rgb转hsv((r + 0.0) / 255.0, (g + 0.0) / 255.0, (b + 0.0) / 255.0)
  返回 [结果[0] * 360.0, 结果[1] * 100.0, 结果[2] * 100.0]

段落 HSV转RGB 接收 h, s, v:
  设 结果 为 颜色hsv转rgb(h / 360.0, s / 100.0, v / 100.0)
  返回 [整数(结果[0] * 255.0), 整数(结果[1] * 255.0), 整数(结果[2] * 255.0)]

# ── 解析与格式化 ──

段落 RGB解析 接收 文本:
  设 干净 为 去除空格(文本)
  设 体 为 干净
  如果 开头(干净, "#"):
    设 体 为 截取(干净, 1, 长(干净) - 1)
  如果 长(体) == 6:
    设 r 为 颜色读hex(体, 0, 2)
    设 g 为 颜色读hex(体, 2, 2)
    设 b 为 颜色读hex(体, 4, 2)
    如果 r >= 0:
      如果 g >= 0:
        如果 b >= 0:
          返回 [r, g, b]
  如果 长(体) == 3:
    设 r1 为 颜色十六进制单值(体[0])
    设 g1 为 颜色十六进制单值(体[1])
    设 b1 为 颜色十六进制单值(体[2])
    如果 r1 >= 0:
      如果 g1 >= 0:
        如果 b1 >= 0:
          返回 [r1 * 17, g1 * 17, b1 * 17]
  设 左括 为 查找(干净, "(")
  如果 左括 >= 0:
    设 右括 为 查找(干净, ")")
    如果 右括 > 左括:
      设 内部 为 截取(干净, 左括 + 1, 右括 - 左括 - 1)
      设 部们 为 分割(内部, ",")
      如果 长(部们) == 3:
        返回 [转整数(去除空格(部们[0])), 转整数(去除空格(部们[1])), 转整数(去除空格(部们[2]))]
  设 部们 为 分割(干净, ",")
  如果 长(部们) == 3:
    返回 [转整数(去除空格(部们[0])), 转整数(去除空格(部们[1])), 转整数(去除空格(部们[2]))]
  抛出 运行时错误("无法解析颜色字符串: " + 干净)

段落 RGB转十六进制 接收 r, g, b:
  颜色验证RGB(r, g, b)
  返回 "#" + 颜色hex2(r) + 颜色hex2(g) + 颜色hex2(b)

段落 十六进制转RGB 接收 十六进制:
  返回 RGB解析(十六进制)

# ── 颜色操作 ──

段落 颜色混合 接收 颜色1, 颜色2, 比例 = 0.5:
  设 a 为 RGB解析(颜色1)
  设 b 为 RGB解析(颜色2)
  设 r 为 整数(a[0] + (b[0] - a[0]) * 比例)
  设 g 为 整数(a[1] + (b[1] - a[1]) * 比例)
  设 bv 为 整数(a[2] + (b[2] - a[2]) * 比例)
  返回 RGB转十六进制(r, g, bv)

段落 颜色亮度 接收 颜色:
  设 a 为 RGB解析(颜色)
  返回 (0.299 * a[0] + 0.587 * a[1] + 0.114 * a[2]) / 255.0

段落 颜色反转 接收 颜色:
  设 a 为 RGB解析(颜色)
  返回 RGB转十六进制(255 - a[0], 255 - a[1], 255 - a[2])

段落 颜色变亮 接收 颜色, 比例 = 0.2:
  设 a 为 RGB解析(颜色)
  设 r 为 a[0] + (255 - a[0]) * 比例
  如果 r > 255:
    设 r 为 255
  设 g 为 a[1] + (255 - a[1]) * 比例
  如果 g > 255:
    设 g 为 255
  设 b 为 a[2] + (255 - a[2]) * 比例
  如果 b > 255:
    设 b 为 255
  返回 RGB转十六进制(整数(r), 整数(g), 整数(b))

段落 颜色变暗 接收 颜色, 比例 = 0.2:
  设 a 为 RGB解析(颜色)
  设 r 为 a[0] * (1.0 - 比例)
  设 g 为 a[1] * (1.0 - 比例)
  设 b 为 a[2] * (1.0 - 比例)
  返回 RGB转十六进制(整数(r), 整数(g), 整数(b))

段落 颜色透明 接收 颜色, 透明度:
  设 a 为 RGB解析(颜色)
  返回 "rgba(" + 转字符串(a[0]) + ", " + 转字符串(a[1]) + ", " + 转字符串(a[2]) + ", " + 转字符串(透明度) + ")"

段落 获取颜色名称 接收 颜色:
  设 键 为 大写(颜色)
  设 i 为 0
  当 i < 长(颜色键们):
    如果 颜色键们[i] == 键:
      返回 颜色名们[i]
    设 i 为 i + 1
  返回 "未知"
