# 纯光明实现（R115-SB 自举收尾）—— 对齐 stdlib/数学统计.py 公开 API
# 全部只用光明内置原语与 _light_builtin（平方根/常用对数/向下取整/绝对值），
# 零 引 Python；Counter 以新建字典手写频次表替代，math.sqrt/log10 走 _light_builtin 纯光明腿。
# O0 规避：不写负数字面量（用 0 - x）；除法按需以浮点累加器保证真除。

导出 均值 中位数 众数 众数单个 方差 标准差 极差。
导出 四分位数 偏度 峰度 变异系数 协方差 相关系数 频率分布 数据汇总 加权均值。

# ── 私有辅助 ──

段落 _求和(数据):
  设 总计 为 0
  设 i 为 0
  当 i < 长(数据):
    设 总计 为 总计 + 数据[i]
    设 i 为 i + 1
  返回 总计

段落 _列表最大(数据):
  设 结果 为 数据[0]
  设 i 为 1
  当 i < 长(数据):
    如果 数据[i] > 结果:
      设 结果 为 数据[i]
    设 i 为 i + 1
  返回 结果

段落 _列表最小(数据):
  设 结果 为 数据[0]
  设 i 为 1
  当 i < 长(数据):
    如果 数据[i] < 结果:
      设 结果 为 数据[i]
    设 i 为 i + 1
  返回 结果

段落 _四舍五入(x, 位):
  设 因子 为 1.0
  设 i 为 0
  当 i < 位:
    设 因子 为 因子 * 10.0
    设 i 为 i + 1
  返回 _light_builtin.向下取整(x * 因子 + 0.5) / 因子

段落 _频次表(数据):
  设 频次 为 字典创建()
  设 i 为 0
  当 i < 长(数据):
    设 v 为 数据[i]
    如果 字典包含键(频次, v):
      字典设置(频次, v, 字典获取(频次, v) + 1)
    否则:
      字典设置(频次, v, 1)
    设 i 为 i + 1
  返回 频次

# ── 公开 API（对齐 数学统计.py 顶层 def）──

段落 均值(数据):
  如果 长(数据) == 0:
    抛出 值错误("数据列表不能为空")
  返回 _求和(数据) / 长(数据)

段落 中位数(数据):
  如果 长(数据) == 0:
    抛出 值错误("数据列表不能为空")
  设 排好 为 排序(数据)
  设 n 为 长(排好)
  设 中 为 n // 2
  如果 n % 2 == 1:
    返回 排好[中]
  返回 (排好[中 - 1] + 排好[中]) / 2.0

段落 众数(数据):
  如果 长(数据) == 0:
    抛出 值错误("数据列表不能为空")
  设 频次 为 _频次表(数据)
  设 键表 为 字典键列表(频次)
  设 最高次 为 字典获取(频次, 键表[0])
  设 j 为 1
  当 j < 长(键表):
    如果 字典获取(频次, 键表[j]) > 最高次:
      设 最高次 为 字典获取(频次, 键表[j])
    设 j 为 j + 1
  设 结果 为 []
  设 j 为 0
  当 j < 长(键表):
    如果 字典获取(频次, 键表[j]) == 最高次:
      结果.追加(键表[j])
    设 j 为 j + 1
  返回 结果

段落 众数单个(数据):
  如果 长(数据) == 0:
    返回 空
  设 结果 为 众数(数据)
  如果 长(结果) > 0:
    返回 结果[0]
  返回 空

段落 方差(数据, 总体 等于 假):
  如果 长(数据) == 0:
    抛出 值错误("数据列表不能为空")
  如果 长(数据) < 2:
    抛出 值错误("至少需要两个数据点")
  设 m 为 均值(数据)
  设 sq 为 0.0
  设 i 为 0
  当 i < 长(数据):
    设 差 为 数据[i] - m
    设 sq 为 sq + 差 * 差
    设 i 为 i + 1
  如果 总体:
    返回 sq / 长(数据)
  返回 sq / (长(数据) - 1)

段落 标准差(数据, 总体 等于 假):
  返回 _light_builtin.平方根(方差(数据, 总体))

段落 极差(数据):
  如果 长(数据) == 0:
    抛出 值错误("数据列表不能为空")
  返回 _列表最大(数据) - _列表最小(数据)

段落 _分位数线性(排好, 位置):
  设 n 为 长(排好)
  设 idx 为 位置 * (n - 1)
  设 整数部分 为 整数(idx)
  设 小数部分 为 idx - 整数部分
  如果 整数部分 + 1 < n:
    返回 排好[整数部分] * (1.0 - 小数部分) + 排好[整数部分 + 1] * 小数部分
  返回 排好[整数部分]

段落 四分位数(数据):
  如果 长(数据) == 0:
    抛出 值错误("数据列表不能为空")
  设 排好 为 排序(数据)
  设 q1 为 _分位数线性(排好, 0.25)
  设 q2 为 _分位数线性(排好, 0.5)
  设 q3 为 _分位数线性(排好, 0.75)
  返回 [q1, q2, q3]

段落 偏度(数据):
  如果 长(数据) < 3:
    抛出 值错误("至少需要三个数据点")
  设 m 为 均值(数据)
  设 n 为 长(数据)
  设 s 为 标准差(数据)
  如果 s == 0.0:
    返回 0.0
  设 矩 为 0.0
  设 i 为 0
  当 i < n:
    设 d 为 数据[i] - m
    设 矩 为 矩 + d * d * d
    设 i 为 i + 1
  设 三次矩 为 矩 / n
  返回 三次矩 / (s * s * s)

段落 峰度(数据):
  如果 长(数据) < 4:
    抛出 值错误("至少需要四个数据点")
  设 m 为 均值(数据)
  设 n 为 长(数据)
  设 s 为 标准差(数据)
  如果 s == 0.0:
    返回 0.0
  设 矩 为 0.0
  设 i 为 0
  当 i < n:
    设 d 为 数据[i] - m
    设 矩 为 矩 + d * d * d * d
    设 i 为 i + 1
  设 四次矩 为 矩 / n
  返回 四次矩 / (s * s * s * s) - 3.0

段落 变异系数(数据):
  设 m 为 均值(数据)
  如果 m == 0.0:
    抛出 值错误("均值为 0，无法计算变异系数")
  返回 标准差(数据) / m

段落 协方差(数据1, 数据2):
  如果 长(数据1) != 长(数据2):
    抛出 值错误("两个数据集长度必须相同")
  如果 长(数据1) < 2:
    抛出 值错误("至少需要两个数据点")
  设 m1 为 均值(数据1)
  设 m2 为 均值(数据2)
  设 n 为 长(数据1)
  设 总计 为 0.0
  设 i 为 0
  当 i < n:
    设 总计 为 总计 + (数据1[i] - m1) * (数据2[i] - m2)
    设 i 为 i + 1
  返回 总计 / (n - 1)

段落 相关系数(数据1, 数据2):
  设 cov 为 协方差(数据1, 数据2)
  设 s1 为 标准差(数据1)
  设 s2 为 标准差(数据2)
  如果 s1 == 0.0 或 s2 == 0.0:
    返回 0.0
  返回 cov / (s1 * s2)

段落 频率分布(数据, 组数 等于 空):
  如果 长(数据) == 0:
    返回 []
  设 n 为 长(数据)
  如果 组数 等于 空:
    设 自动 为 1.0 + 3.322 * _light_builtin.常用对数(n)
    设 组数 为 整数(_四舍五入(自动, 0))
    如果 组数 < 1:
      设 组数 为 1
  设 最小值 为 _列表最小(数据)
  设 最大值 为 _列表最大(数据)
  设 组距 为 1.0
  如果 组数 > 1:
    设 组距 为 (最大值 - 最小值) / 组数
  如果 组距 == 0.0:
    设 组距 为 1.0
  设 结果 为 []
  设 i 为 0
  当 i < 组数:
    设 下限 为 最小值 + i * 组距
    设 上限 为 下限 + 组距
    设 频数 为 0
    设 j 为 0
    当 j < n:
      如果 i < 组数 - 1:
        如果 数据[j] >= 下限:
          如果 数据[j] < 上限:
            设 频数 为 频数 + 1
      否则:
        如果 数据[j] >= 下限:
          如果 数据[j] <= 上限:
            设 频数 为 频数 + 1
      设 j 为 j + 1
    结果.追加([_四舍五入(下限, 4), _四舍五入(上限, 4), 频数])
    设 i 为 i + 1
  返回 结果

段落 数据汇总(数据):
  如果 长(数据) == 0:
    设 空表 为 字典创建()
    字典设置(空表, "错误", "数据为空")
    返回 空表
  设 q 为 四分位数(数据)
  设 结果 为 字典创建()
  字典设置(结果, "数量", 长(数据))
  字典设置(结果, "均值", _四舍五入(均值(数据), 4))
  字典设置(结果, "中位数", _四舍五入(q[1], 4))
  字典设置(结果, "众数", 众数单个(数据))
  字典设置(结果, "标准差", _四舍五入(标准差(数据), 4))
  字典设置(结果, "方差", _四舍五入(方差(数据), 4))
  字典设置(结果, "极差", _四舍五入(极差(数据), 4))
  字典设置(结果, "最小值", _列表最小(数据))
  字典设置(结果, "最大值", _列表最大(数据))
  字典设置(结果, "Q1", _四舍五入(q[0], 4))
  字典设置(结果, "Q3", _四舍五入(q[2], 4))
  字典设置(结果, "四分位距", _四舍五入(q[2] - q[0], 4))
  字典设置(结果, "偏度", _四舍五入(偏度(数据), 4))
  字典设置(结果, "峰度", _四舍五入(峰度(数据), 4))
  字典设置(结果, "变异系数", _四舍五入(变异系数(数据), 4))
  返回 结果

段落 加权均值(数据, 权重):
  如果 长(数据) != 长(权重):
    抛出 值错误("数据和权重长度必须相同")
  如果 长(数据) == 0:
    抛出 值错误("数据列表不能为空")
  设 权重和 为 _求和(权重)
  如果 权重和 == 0:
    抛出 值错误("权重和不能为 0")
  设 总计 为 0.0
  设 i 为 0
  当 i < 长(数据):
    设 总计 为 总计 + 数据[i] * 权重[i]
    设 i 为 i + 1
  返回 总计 / 权重和
