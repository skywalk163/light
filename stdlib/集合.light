# 光明标准库 —— 集合模块（原生腿真身）
#
# 对齐 stdlib/集合.py（36 个导出）。原生腿无 set 类型，集合用「字典 + 列表」模拟：
# 集合 = {"元素": [去重后的元素列表]}。元素判等走 dv_eq（整数/字符串/布尔可直接
# 判等；不支持需哈希的嵌套容器做元素）。
#
# 原生腿能力边界（详见 docs/known_issues.md T5C 章节）：
# 1. 集合转元组：原生腿无元组类型，返回列表（同构替代）。
# 2. 冻结集合：可变集合同构返回（冻结语义仅作 API 对齐标注）。
# 3. 移除元素 / 弹出元素：缺失时抛 值错误（对齐 Python KeyError）；原生腿
#    异常类型以 值错误 表示。
# 4. 弹出元素返回首个元素（插入序）；Python 小集合迭代序为哈希序，不对拍。

导出 创建集合 集合转列表 列表转集合 集合转元组 集合转字符串 并集。
导出 交集 差集 对称差 多个并集 多个交集 是否子集 是否真子集。
导出 是否超集 是否真超集 是否不相交 添加元素 移除元素 丢弃元素。
导出 弹出元素 清空集合 集合长度 集合包含 集合相等 集合不等。
导出 复制集合 冻结集合 集合的幂集 集合的笛卡尔积 集合的补集。
导出 集合差集的大小 集合交集的大小 集合并集的大小 杰卡德相似度。
导出 集合的唯一元素 集合的重复元素。

# ── 内部辅助（不导出） ────────────────────────────────────

# 取集合的底层元素列表（可能是 REF，仅用支持解引用的操作）
段落 集合_列表 接收 集合:
  返回 字典获取(集合, "元素", 新建列表())

# 列表成员判断（自实现：内置 包含 不解引用 REF）
段落 集合_含 接收 列表, 值:
  设 i 为 0
  当 i < 长(列表):
    如果 列表[i] 等于 值:
      返回 真
    设 i 为 i 加上 1
  返回 假

# 去重追加（原地改共享列表）
段落 集合_加 接收 列表, 值:
  如果 集合_含(列表, 值):
    返回 列表
  追加(列表, 值)
  返回 列表

# 新建空集合（含 元素 键）
段落 集合_新:
  设 集合 为 {}
  字典设置(集合, "元素", 新建列表())
  返回 集合

# 按值移除并重建列表（返回新列表；长度不变表示未找到）
段落 集合_去 接收 列表, 值:
  设 新 为 新建列表()
  设 找到 为 假
  设 i 为 0
  当 i < 长(列表):
    如果 找到:
      追加(新, 列表[i])
    否则:
      如果 列表[i] 等于 值:
        设 找到 为 真
      否则:
        追加(新, 列表[i])
    设 i 为 i 加上 1
  返回 新

# ── 公开函数 ─────────────────────────────────────────────

# 创建集合（可迭代对象=None）
段落 创建集合 接收 可迭代对象 = 空:
  设 集合 为 集合_新()
  如果 可迭代对象 不等于 空:
    设 i 为 0
    当 i < 长(可迭代对象):
      设 列表 为 集合_列表(集合)
      设 空值 为 集合_加(列表, 可迭代对象[i])
      设 i 为 i 加上 1
  返回 集合

# 集合转列表（复制）
段落 集合转列表 接收 集合:
  设 列表 为 集合_列表(集合)
  设 结果 为 新建列表()
  设 i 为 0
  当 i < 长(列表):
    追加(结果, 列表[i])
    设 i 为 i 加上 1
  返回 结果

# 列表转集合（去重）
段落 列表转集合 接收 列表:
  设 集合 为 集合_新()
  设 i 为 0
  当 i < 长(列表):
    设 元素 为 集合_列表(集合)
    设 空值 为 集合_加(元素, 列表[i])
    设 i 为 i 加上 1
  返回 集合

# 集合转元组 —— 原生腿无元组，返回列表（同构替代）
段落 集合转元组 接收 集合:
  返回 集合转列表(集合)

# 集合转字符串 —— "{a, b}" 形式
段落 集合转字符串 接收 集合:
  设 列表 为 集合_列表(集合)
  设 结果 为 "{"
  设 i 为 0
  当 i < 长(列表):
    如果 i > 0:
      设 结果 为 结果 加上 ", "
    设 结果 为 结果 加上 转文本(列表[i])
    设 i 为 i 加上 1
  设 结果 为 结果 加上 "}"
  返回 结果

# 并集（返回新集合）
段落 并集 接收 集合1, 集合2:
  设 结果 为 集合_新()
  设 列表1 为 集合_列表(集合1)
  设 列表2 为 集合_列表(集合2)
  设 元素 为 集合_列表(结果)
  设 i 为 0
  当 i < 长(列表1):
    设 空值 为 集合_加(元素, 列表1[i])
    设 i 为 i 加上 1
  设 i 为 0
  当 i < 长(列表2):
    设 空值 为 集合_加(元素, 列表2[i])
    设 i 为 i 加上 1
  返回 结果

# 交集（返回新集合）
段落 交集 接收 集合1, 集合2:
  设 结果 为 集合_新()
  设 列表1 为 集合_列表(集合1)
  设 列表2 为 集合_列表(集合2)
  设 元素 为 集合_列表(结果)
  设 i 为 0
  当 i < 长(列表1):
    如果 集合_含(列表2, 列表1[i]):
      设 空值 为 集合_加(元素, 列表1[i])
    设 i 为 i 加上 1
  返回 结果

# 差集（集合1 - 集合2）
段落 差集 接收 集合1, 集合2:
  设 结果 为 集合_新()
  设 列表1 为 集合_列表(集合1)
  设 列表2 为 集合_列表(集合2)
  设 元素 为 集合_列表(结果)
  设 i 为 0
  当 i < 长(列表1):
    如果 集合_含(列表2, 列表1[i]):
      设 i 为 i 加上 1
    否则:
      设 空值 为 集合_加(元素, 列表1[i])
      设 i 为 i 加上 1
  返回 结果

# 对称差（返回新集合）
段落 对称差 接收 集合1, 集合2:
  设 结果 为 集合_新()
  设 列表1 为 集合_列表(集合1)
  设 列表2 为 集合_列表(集合2)
  设 元素 为 集合_列表(结果)
  设 i 为 0
  当 i < 长(列表1):
    如果 集合_含(列表2, 列表1[i]):
      设 i 为 i 加上 1
    否则:
      设 空值 为 集合_加(元素, 列表1[i])
      设 i 为 i 加上 1
  设 i 为 0
  当 i < 长(列表2):
    如果 集合_含(列表1, 列表2[i]):
      设 i 为 i 加上 1
    否则:
      设 空值 为 集合_加(元素, 列表2[i])
      设 i 为 i 加上 1
  返回 结果

# 多个并集（*集合列表）
# 多个并集（甲, 乙）—— 原生腿变参不绑定（known_issues T5C），固定双参
段落 多个并集 接收 甲, 乙:
  设 结果 为 集合_新()
  设 元素 为 集合_列表(结果)
  设 列表 为 集合_列表(甲)
  设 i 为 0
  当 i < 长(列表):
    设 空值 为 集合_加(元素, 列表[i])
    设 i 为 i 加上 1
  设 列表 为 集合_列表(乙)
  设 i 为 0
  当 i < 长(列表):
    设 空值 为 集合_加(元素, 列表[i])
    设 i 为 i 加上 1
  返回 结果

# 多个交集（*集合列表）
# 多个交集（甲, 乙）—— 原生腿变参不绑定（known_issues T5C），固定双参
段落 多个交集 接收 甲, 乙:
  设 结果 为 集合_新()
  设 列表0 为 集合_列表(甲)
  设 元素 为 集合_列表(结果)
  设 i 为 0
  当 i < 长(列表0):
    设 空值 为 集合_加(元素, 列表0[i])
    设 i 为 i 加上 1
  设 候选 为 集合_列表(乙)
  设 新 为 新建列表()
  设 i 为 0
  当 i < 长(元素):
    如果 集合_含(候选, 元素[i]):
      追加(新, 元素[i])
    设 i 为 i 加上 1
  设 元素 为 新
  字典设置(结果, "元素", 元素)
  返回 结果

# 是否子集
段落 是否子集 接收 集合1, 集合2:
  设 列表1 为 集合_列表(集合1)
  设 列表2 为 集合_列表(集合2)
  设 i 为 0
  当 i < 长(列表1):
    如果 集合_含(列表2, 列表1[i]):
      设 i 为 i 加上 1
    否则:
      返回 假
  返回 真

# 是否真子集
段落 是否真子集 接收 集合1, 集合2:
  设 列表1 为 集合_列表(集合1)
  设 列表2 为 集合_列表(集合2)
  如果 长(列表1) >= 长(列表2):
    返回 假
  设 i 为 0
  当 i < 长(列表1):
    如果 集合_含(列表2, 列表1[i]):
      设 i 为 i 加上 1
    否则:
      返回 假
  返回 真

# 是否超集
段落 是否超集 接收 集合1, 集合2:
  返回 是否子集(集合2, 集合1)

# 是否真超集
段落 是否真超集 接收 集合1, 集合2:
  返回 是否真子集(集合2, 集合1)

# 是否不相交
段落 是否不相交 接收 集合1, 集合2:
  设 列表1 为 集合_列表(集合1)
  设 列表2 为 集合_列表(集合2)
  设 i 为 0
  当 i < 长(列表1):
    如果 集合_含(列表2, 列表1[i]):
      返回 假
    设 i 为 i 加上 1
  返回 真

# 添加元素（原地）
段落 添加元素 接收 集合, 值:
  设 列表 为 集合_列表(集合)
  设 空值 为 集合_加(列表, 值)
  返回 空

# 移除元素（缺失抛 值错误）
#
# 注意（known_issues T5C-07）：`字典设置` 会使「写回前取到的旧列表句柄」失效
# （底层缓冲被释放/重绑），写回之后再去 `长(列表)` 属未定义行为 —— Windows 上
# 侥幸读到 0（与新列表长度不同，不抛错，看似正常），POSIX/glibc 上该块内存被
# 复用后读到与新列表相同的长度，于是 `长(新) == 长(列表)` 成立而**误抛值错误**。
# 故必须在写回**之前**快照原长；比较前置还顺带保证「缺失时不产生半截写入」，
# 与 Python `set.remove` 抛 KeyError 且不改集合的语义一致。
段落 移除元素 接收 集合, 值:
  设 列表 为 集合_列表(集合)
  设 原长 为 长(列表)
  设 新 为 集合_去(列表, 值)
  如果 长(新) == 原长:
    抛出 值错误("元素不存在")
  字典设置(集合, "元素", 新)
  返回 空

# 丢弃元素（缺失静默）
段落 丢弃元素 接收 集合, 值:
  设 列表 为 集合_列表(集合)
  设 新 为 集合_去(列表, 值)
  字典设置(集合, "元素", 新)
  返回 空

# 弹出元素（空集合抛 值错误）
段落 弹出元素 接收 集合:
  设 列表 为 集合_列表(集合)
  如果 长(列表) == 0:
    抛出 值错误("空集合")
  设 首 为 列表[0]
  设 新 为 新建列表()
  设 i 为 1
  当 i < 长(列表):
    追加(新, 列表[i])
    设 i 为 i 加上 1
  字典设置(集合, "元素", 新)
  返回 首

# 清空集合
段落 清空集合 接收 集合:
  字典设置(集合, "元素", 新建列表())
  返回 空

# 集合长度
段落 集合长度 接收 集合:
  返回 长(集合_列表(集合))

# 集合包含
段落 集合包含 接收 集合, 值:
  返回 集合_含(集合_列表(集合), 值)

# 集合相等
段落 集合相等 接收 集合1, 集合2:
  设 列表1 为 集合_列表(集合1)
  设 列表2 为 集合_列表(集合2)
  如果 长(列表1) 不等于 长(列表2):
    返回 假
  设 i 为 0
  当 i < 长(列表1):
    如果 集合_含(列表2, 列表1[i]):
      设 i 为 i 加上 1
    否则:
      返回 假
  返回 真

# 集合不等
段落 集合不等 接收 集合1, 集合2:
  如果 集合相等(集合1, 集合2):
    返回 假
  返回 真

# 复制集合
段落 复制集合 接收 集合:
  设 结果 为 集合_新()
  设 列表 为 集合_列表(集合)
  设 元素 为 集合_列表(结果)
  设 i 为 0
  当 i < 长(列表):
    追加(元素, 列表[i])
    设 i 为 i 加上 1
  返回 结果

# 冻结集合 —— 可变集合同构返回（冻结语义仅作 API 对齐标注）
段落 冻结集合 接收 可迭代对象 = 空:
  返回 创建集合(可迭代对象)

# 集合的幂集（返回集合的列表）
段落 集合的幂集 接收 集合:
  设 列表 为 集合_列表(集合)
  设 结果 为 新建列表()
  设 总数 为 1
  设 幂次 为 0
  当 幂次 < 长(列表):
    设 总数 为 总数 乘 2
    设 幂次 为 幂次 加上 1
  设 掩码 为 0
  当 掩码 < 总数:
    设 子集 为 集合_新()
    设 元素 为 集合_列表(子集)
    设 掩码副本 为 掩码
    设 i 为 0
    当 i < 长(列表):
      设 位 为 掩码副本 模 2
      如果 位 == 1:
        追加(元素, 列表[i])
      设 掩码副本 为 掩码副本 整除 2
      设 i 为 i 加上 1
    追加(结果, 子集)
    设 掩码 为 掩码 加上 1
  返回 结果

# 集合的笛卡尔积（返回二元组列表；原生腿以双元素列表表示）
段落 集合的笛卡尔积 接收 集合1, 集合2:
  设 列表1 为 集合_列表(集合1)
  设 列表2 为 集合_列表(集合2)
  设 结果 为 新建列表()
  设 i 为 0
  当 i < 长(列表1):
    设 j 为 0
    当 j < 长(列表2):
      设 对 为 新建列表()
      追加(对, 列表1[i])
      追加(对, 列表2[j])
      追加(结果, 对)
      设 j 为 j 加上 1
    设 i 为 i 加上 1
  返回 结果

# 集合的补集（全集 - 集合）
段落 集合的补集 接收 集合, 全集:
  设 结果 为 集合_新()
  设 列表 为 集合_列表(集合)
  设 全部 为 集合_列表(全集)
  设 元素 为 集合_列表(结果)
  设 i 为 0
  当 i < 长(全部):
    如果 集合_含(列表, 全部[i]):
      设 i 为 i 加上 1
    否则:
      设 空值 为 集合_加(元素, 全部[i])
      设 i 为 i 加上 1
  返回 结果

# 集合差集的大小
段落 集合差集的大小 接收 集合1, 集合2:
  返回 集合长度(差集(集合1, 集合2))

# 集合交集的大小
段落 集合交集的大小 接收 集合1, 集合2:
  返回 集合长度(交集(集合1, 集合2))

# 集合并集的大小
段落 集合并集的大小 接收 集合1, 集合2:
  返回 集合长度(并集(集合1, 集合2))

# 杰卡德相似度 —— |交| / |并|（浮点指纹：整数(相似度 乘 2^53)）
段落 杰卡德相似度 接收 集合1, 集合2:
  设 交 为 集合长度(交集(集合1, 集合2))
  设 并 为 集合长度(并集(集合1, 集合2))
  如果 并 == 0:
    返回 0.0
  返回 整数(浮点数(交) 除以 浮点数(并) 乘 9007199254740992.0)

# 集合的唯一元素（保序去重）—— 结果用字典句柄承载（原生腿参数追加不可靠，
# 见 known_issues T5C：追加 对函数参数无效，对字典读出句柄有效）
段落 集合的唯一元素 接收 列表:
  设 集合 为 集合_新()
  设 元素 为 集合_列表(集合)
  设 i 为 0
  当 i < 长(列表):
    设 空值 为 集合_加(元素, 列表[i])
    设 i 为 i 加上 1
  返回 元素

# 集合的重复元素（出现次数 >= 2 的元素，每个一次）
段落 集合的重复元素 接收 列表:
  设 计数 为 {}
  设 结果 为 新建列表()
  设 i 为 0
  当 i < 长(列表):
    设 当前 为 列表[i]
    设 次数 为 字典获取(计数, 当前, 0)
    如果 次数 == 1:
      追加(结果, 当前)
    字典设置(计数, 当前, 次数 加上 1)
    设 i 为 i 加上 1
  返回 结果

