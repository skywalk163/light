# 纯光明实现 —— 编码解码（取代同名 .py 壳）。
#
# 对齐 stdlib/编码解码.py 的 47 个导出。依赖拆解：
#   - Base64 编码解码：runtime builtin _b64_encode / _b64_decode（已注册）。
#   - Base32 / Base16 / Hex / URL / UTF8 / HTML 实体 / Unicode 转义：纯光明实现。
#   - codecs 字符集（GBK/GB2312/GB18030/BIG5）：原生腿无 codecs，且缺乏可移植的
#     码表，按能力边界返回空串占位（见 docs/known_issues.md T6C 章节）。
#   - 导出名「字符集转换为字符串」含关键字「为」会被词法切分（字符集转换 == 字符串(...)），
#     原生腿以「字符集转字符串」提供（能力边界，见 known_issues）。
#   - ISO-8859-1（latin-1，码位==字节）为纯光明真实现。
#
# 光明无 bytes 类型，字节序列以「十六进制串」表示（与《编码》模块口径一致）。
# O0 已知规避：不写负数字面量（0 - x）、字符串包含用 字符串包含。

导出 Base64编码 Base64解码 Base64编码二进制 Base64解码二进制。
导出 Base64URL编码 Base64URL解码 Base32编码 Base32解码。
导出 Base16编码 Base16解码 十六进制编码 十六进制解码 十六进制编码大写。
导出 二进制转十六进制 十六进制转二进制。
导出 URL编码 URL解码 URL编码全字符 URL查询串编码 URL查询串解码。
导出 Unicode转ASCII ASCII转Unicode。
导出 GBK转UTF8 UTF8转GBK GB2312转UTF8 UTF8转GB2312。
导出 GB18030转UTF8 UTF8转GB18030 BIG5转UTF8 UTF8转BIG5。
导出 ISO8859_1转UTF8 UTF8转ISO8859_1 字符集转换 字符集转字符串 检测编码。
导出 HTML实体编码 HTML实体解码 Unicode转中文 中文转Unicode。
导出 字节转字符串 字符串转字节 文本转十六进制 十六进制转文本。
导出 二进制转字符串 字符串转二进制。

设 编码HEXP 为 "0123456789ABCDEF"
设 编码B32表 为 "ABCDEFGHIJKLMNOPQRSTUVWXYZ234567"

# ── 十六进制 / UTF-8 辅助（与《编码》模块同算法，独立命名）──

段落 编码hex2 接收 b:
  设 高 为 整除(b, 16)
  设 低 为 取模(b, 16)
  返回 编码HEXP[高] 加上 编码HEXP[低]

段落 编码hex值 接收 c:
  设 o 为 码位(c)
  如果 o >= 48:
    如果 o <= 57:
      返回 o - 48
  如果 o >= 65:
    如果 o <= 70:
      返回 o - 55
  如果 o >= 97:
    如果 o <= 102:
      返回 o - 87
  返回 0 - 1

段落 编码hex字节 接收 hx, k:
  设 p 为 2 * k
  设 高 为 编码hex值(hx[p])
  设 低 为 编码hex值(hx[p + 1])
  返回 高 * 16 + 低

段落 编码读hex 接收 文本, 起, 位数:
  设 值 为 0
  设 k 为 0
  当 k < 位数:
    设 单 为 编码hex值(文本[起 + k])
    如果 单 < 0:
      返回 0 - 1
    设 值 为 值 * 16 + 单
    设 k 为 k + 1
  返回 值

# 十六进制串 -> UTF-8 解码 -> 字符串
段落 编码解UTF8 接收 hx:
  设 nb 为 整除(长(hx), 2)
  设 结果 为 ""
  设 k 为 0
  当 k < nb:
    设 b 为 编码hex字节(hx, k)
    如果 b < 128:
      设 结果 为 结果 加上 字符自码位(b)
      设 k 为 k + 1
    否则:
      如果 b < 224:
        设 b2 为 编码hex字节(hx, k + 1)
        设 结果 为 结果 加上 字符自码位(取模(b, 32) * 64 + 取模(b2, 64))
        设 k 为 k + 2
      否则:
        如果 b < 240:
          设 b2 为 编码hex字节(hx, k + 1)
          设 b3 为 编码hex字节(hx, k + 2)
          设 结果 为 结果 加上 字符自码位(取模(b, 16) * 4096 + 取模(b2, 64) * 64 + 取模(b3, 64))
          设 k 为 k + 3
        否则:
          设 b2 为 编码hex字节(hx, k + 1)
          设 b3 为 编码hex字节(hx, k + 2)
          设 b4 为 编码hex字节(hx, k + 3)
          设 结果 为 结果 加上 字符自码位(取模(b, 8) * 262144 + 取模(b2, 64) * 4096 + 取模(b3, 64) * 64 + 取模(b4, 64))
          设 k 为 k + 4
  返回 结果

# 字符串 -> UTF-8 字节的十六进制串（大写）
段落 编码编UTF8 接收 数据:
  设 n 为 长(数据)
  设 结果 为 ""
  设 i 为 0
  当 i < n:
    设 o 为 码位(数据[i])
    如果 o < 128:
      设 结果 为 结果 加上 编码hex2(o)
    否则:
      如果 o < 2048:
        设 结果 为 结果 加上 编码hex2(192 + 整除(o, 64)) 加上 编码hex2(128 + 取模(o, 64))
      否则:
        如果 o < 65536:
          设 结果 为 结果 加上 编码hex2(224 + 整除(o, 4096)) 加上 编码hex2(128 + 取模(整除(o, 64), 64)) 加上 编码hex2(128 + 取模(o, 64))
        否则:
          设 结果 为 结果 加上 编码hex2(240 + 整除(o, 262144)) 加上 编码hex2(128 + 取模(整除(o, 4096), 64)) 加上 编码hex2(128 + 取模(整除(o, 64), 64)) 加上 编码hex2(128 + 取模(o, 64))
    设 i 为 i + 1
  返回 结果

# ── Base64（runtime builtin）──

段落 Base64编码 接收 数据, 编码 = "utf-8":
  返回 _b64_encode(数据)

段落 Base64解码 接收 数据, 编码 = "utf-8":
  返回 _b64_decode(数据)

段落 Base64编码二进制 接收 数据:
  返回 _b64_encode(数据)

段落 Base64解码二进制 接收 数据:
  返回 _b64_decode(数据)

段落 Base64URL编码 接收 数据, 编码 = "utf-8":
  设 改 为 替换(_b64_encode(数据), "+", "-")
  返回 替换(改, "/", "_")

段落 Base64URL解码 接收 数据, 编码 = "utf-8":
  设 补 为 数据
  设 余 为 取模(长(补), 4)
  如果 余 != 0:
    设 缺 为 4 - 余
    设 补 为 补 加上 重复("=", 缺)
  设 改 为 替换(补, "-", "+")
  设 标准 为 替换(改, "_", "/")
  返回 _b64_decode(标准)

# ── Base32（纯光明，ASCII 字节口径：码位==字节）──

段落 编码B32值 接收 c:
  设 o 为 码位(c)
  如果 o >= 65:
    如果 o <= 90:
      返回 o - 65
  如果 o >= 50:
    如果 o <= 55:
      返回 o - 24
  返回 0 - 1

段落 编码去填充 接收 数据:
  设 尾 为 长(数据)
  设 还在去 为 真
  当 还在去:
    如果 尾 > 0:
      如果 数据[尾 - 1] == "=":
        设 尾 为 尾 - 1
      否则:
        设 还在去 为 假
    否则:
      设 还在去 为 假
  返回 截取(数据, 0, 尾)

段落 编码Base32编码 接收 数据:
  设 n 为 长(数据)
  设 结果 为 ""
  设 i 为 0
  当 i < n:
    设 剩余 为 n - i
    设 组字节 为 剩余
    如果 组字节 > 5:
      设 组字节 为 5
    设 b0 为 码位(数据[i])
    设 b1 为 0
    设 b2 为 0
    设 b3 为 0
    设 b4 为 0
    如果 组字节 > 1:
      设 b1 为 码位(数据[i + 1])
    如果 组字节 > 2:
      设 b2 为 码位(数据[i + 2])
    如果 组字节 > 3:
      设 b3 为 码位(数据[i + 3])
    如果 组字节 > 4:
      设 b4 为 码位(数据[i + 4])
    设 缓冲 为 b0 * 4294967296 + b1 * 16777216 + b2 * 65536 + b3 * 256 + b4
    设 m 为 整除(8 * 组字节 + 4, 5)
    设 j 为 0
    当 j < m:
      设 位移 为 35 - 5 * j
      设 组 为 取模(转整数(缓冲 / 幂(2, 位移)), 32)
      设 结果 为 结果 加上 编码B32表[组]
      设 j 为 j + 1
    设 p 为 0
    当 p < 8 - m:
      设 结果 为 结果 加上 "="
      设 p 为 p + 1
    设 i 为 i + 组字节
  返回 结果

段落 编码Base32解码 接收 数据:
  设 体 为 编码去填充(数据)
  设 n 为 长(体)
  设 结果 为 ""
  设 i 为 0
  当 i < n:
    设 组 为 n - i
    如果 组 > 8:
      设 组 为 8
    设 缓冲 为 0
    设 j 为 0
    当 j < 组:
      设 值 为 编码B32值(体[i + j])
      设 位移 为 35 - 5 * j
      设 缓冲 为 缓冲 + 值 * 幂(2, 位移)
      设 j 为 j + 1
    设 nb 为 整除(5 * 组, 8)
    设 k 为 0
    当 k < nb:
      设 位移 为 32 - 8 * k
      设 字节 为 取模(转整数(缓冲 / 幂(2, 位移)), 256)
      设 结果 为 结果 加上 字符自码位(字节)
      设 k 为 k + 1
    设 i 为 i + 组
  返回 结果

段落 Base32编码 接收 数据, 编码 = "utf-8":
  返回 编码Base32编码(数据)

段落 Base32解码 接收 数据, 编码 = "utf-8":
  返回 编码Base32解码(数据)

# ── Base16 / Hex ──

段落 Base16编码 接收 数据, 编码 = "utf-8":
  返回 大写(编码编UTF8(数据))

段落 Base16解码 接收 数据, 编码 = "utf-8":
  返回 编码解UTF8(大写(数据))

段落 十六进制编码 接收 数据, 编码 = "utf-8":
  返回 转小写(编码编UTF8(数据))

段落 十六进制解码 接收 数据, 编码 = "utf-8":
  返回 编码解UTF8(大写(数据))

段落 十六进制编码大写 接收 数据, 编码 = "utf-8":
  返回 编码编UTF8(数据)

段落 二进制转十六进制 接收 数据:
  返回 转小写(编码编UTF8(数据))

段落 十六进制转二进制 接收 数据:
  返回 编码解UTF8(大写(数据))

# ── URL（urllib.parse.quote / unquote 纯光明实现）──

段落 编码URL编码核心 接收 文本, 全字符:
  设 n 为 长(文本)
  设 结果 为 ""
  设 i 为 0
  当 i < n:
    设 c 为 文本[i]
    设 o 为 码位(c)
    设 安全 为 假
    如果 o >= 48:
      如果 o <= 57:
        设 安全 为 真
    如果 安全 == 假:
      如果 o >= 65:
        如果 o <= 90:
          设 安全 为 真
    如果 安全 == 假:
      如果 o >= 97:
        如果 o <= 122:
          设 安全 为 真
    如果 安全 == 假:
      如果 c == "_":
        设 安全 为 真
    如果 安全 == 假:
      如果 c == ".":
        设 安全 为 真
    如果 安全 == 假:
      如果 c == "-":
        设 安全 为 真
    如果 安全 == 假:
      如果 c == "~":
        设 安全 为 真
    如果 安全 == 假:
      如果 全字符 == 假:
        如果 c == "/":
          设 安全 为 真
    如果 安全:
      设 结果 为 结果 加上 c
    否则:
      设 hx 为 编码编UTF8(c)
      设 nb 为 整除(长(hx), 2)
      设 k 为 0
      当 k < nb:
        设 结果 为 结果 加上 "%" 加上 截取(hx, k * 2, 2)
        设 k 为 k + 1
    设 i 为 i + 1
  返回 结果

段落 编码URL解码 接收 文本:
  设 n 为 长(文本)
  设 字节hex 为 ""
  设 i 为 0
  当 i < n:
    设 c 为 文本[i]
    设 已处理 为 假
    如果 c == "%":
      如果 i + 2 < n:
        设 高 为 编码hex值(文本[i + 1])
        设 低 为 编码hex值(文本[i + 2])
        如果 高 >= 0:
          如果 低 >= 0:
            设 字节hex 为 字节hex 加上 编码hex2(高 * 16 + 低)
            设 i 为 i + 3
            设 已处理 为 真
    如果 已处理 == 假:
      设 字节hex 为 字节hex 加上 编码编UTF8(c)
      设 i 为 i + 1
  返回 编码解UTF8(字节hex)

段落 URL编码 接收 文本, 编码 = "utf-8":
  返回 编码URL编码核心(文本, 假)

段落 URL解码 接收 文本, 编码 = "utf-8":
  返回 编码URL解码(文本)

段落 URL编码全字符 接收 文本, 编码 = "utf-8":
  返回 编码URL编码核心(文本, 真)

段落 编码URL查询值 接收 文本:
  设 全 为 编码URL编码核心(文本, 真)
  返回 替换(全, "%20", "+")

# urllib.parse.unquote_plus：先把 + 还原为空格，再做 % 解码
段落 编码URL查询解码 接收 文本:
  设 加号 为 替换(文本, "+", " ")
  返回 编码URL解码(加号)

段落 URL查询串编码 接收 参数, 编码 = "utf-8":
  设 键们 为 字典键列表(参数)
  设 结果 为 ""
  设 i 为 0
  当 i < 长(键们):
    设 键 为 键们[i]
    设 值 为 转字符串(字典获取(参数, 键, ""))
    如果 i > 0:
      设 结果 为 结果 加上 "&"
    设 结果 为 结果 加上 编码URL查询值(键) 加上 "=" 加上 编码URL查询值(值)
    设 i 为 i + 1
  返回 结果

段落 URL查询串解码 接收 查询串, 编码 = "utf-8":
  设 结果 为 {}
  设 对们 为 分割(查询串, "&")
  设 i 为 0
  当 i < 长(对们):
    设 对 为 对们[i]
    设 等号 为 查找(对, "=")
    如果 等号 >= 0:
      设 键 为 编码URL查询解码(截取(对, 0, 等号))
      设 值 为 编码URL查询解码(截取(对, 等号 + 1, 长(对) - 等号 - 1))
      字典设置(结果, 键, 值)
    否则:
      设 键 为 编码URL查询解码(对)
      字典设置(结果, 键, "")
    设 i 为 i + 1
  返回 结果

# ── Unicode 转义（对齐 Python backslashreplace / unicode_escape）──

段落 编码hex4 接收 o:
  设 结果 为 ""
  设 k 为 3
  当 k >= 0:
    设 组 为 取模(转整数(o / 幂(16, k)), 16)
    设 结果 为 结果 加上 编码HEXP[组]
    设 k 为 k - 1
  返回 结果

段落 编码hex8 接收 o:
  设 结果 为 ""
  设 k 为 7
  当 k >= 0:
    设 组 为 取模(转整数(o / 幂(16, k)), 16)
    设 结果 为 结果 加上 编码HEXP[组]
    设 k 为 k - 1
  返回 结果

段落 编码Unicode转ASCII 接收 文本:
  设 n 为 长(文本)
  设 结果 为 ""
  设 i 为 0
  当 i < n:
    设 o 为 码位(文本[i])
    如果 o < 128:
      设 结果 为 结果 加上 文本[i]
    否则:
      如果 o < 256:
        设 结果 为 结果 加上 "\\x" 加上 转小写(编码hex2(o))
      否则:
        如果 o < 65536:
          设 结果 为 结果 加上 "\\u" 加上 转小写(编码hex4(o))
        否则:
          设 结果 为 结果 加上 "\\U" 加上 转小写(编码hex8(o))
    设 i 为 i + 1
  返回 结果

段落 编码ASCII转Unicode 接收 文本:
  设 n 为 长(文本)
  设 结果 为 ""
  设 i 为 0
  当 i < n:
    设 c 为 文本[i]
    设 已处理 为 假
    如果 c == "\\":
      如果 i + 1 < n:
        设 后 为 文本[i + 1]
        如果 后 == "u":
          如果 i + 5 < n:
            设 码 为 编码读hex(文本, i + 2, 4)
            如果 码 >= 0:
              设 结果 为 结果 加上 字符自码位(码)
              设 i 为 i + 6
              设 已处理 为 真
        如果 后 == "U":
          如果 i + 9 < n:
            设 码 为 编码读hex(文本, i + 2, 8)
            如果 码 >= 0:
              设 结果 为 结果 加上 字符自码位(码)
              设 i 为 i + 10
              设 已处理 为 真
        如果 后 == "x":
          如果 i + 3 < n:
            设 码 为 编码读hex(文本, i + 2, 2)
            如果 码 >= 0:
              设 结果 为 结果 加上 字符自码位(码)
              设 i 为 i + 4
              设 已处理 为 真
    如果 已处理 == 假:
      设 结果 为 结果 加上 c
      设 i 为 i + 1
  返回 结果

段落 Unicode转ASCII 接收 文本:
  返回 编码Unicode转ASCII(文本)

段落 ASCII转Unicode 接收 文本:
  返回 编码ASCII转Unicode(文本)

段落 Unicode转中文 接收 文本:
  返回 编码ASCII转Unicode(文本)

段落 中文转Unicode 接收 文本:
  返回 编码Unicode转ASCII(文本)

# ── 字符集转换（codecs 依赖 → 能力边界）──

段落 GBK转UTF8 接收 数据:
  返回 ""

段落 UTF8转GBK 接收 数据:
  返回 ""

段落 GB2312转UTF8 接收 数据:
  返回 ""

段落 UTF8转GB2312 接收 数据:
  返回 ""

段落 GB18030转UTF8 接收 数据:
  返回 ""

段落 UTF8转GB18030 接收 数据:
  返回 ""

段落 BIG5转UTF8 接收 数据:
  返回 ""

段落 UTF8转BIG5 接收 数据:
  返回 ""

段落 ISO8859_1转UTF8 接收 数据:
  设 nb 为 整除(长(数据), 2)
  设 结果 为 ""
  设 k 为 0
  当 k < nb:
    设 b 为 编码hex字节(数据, k)
    设 结果 为 结果 加上 字符自码位(b)
    设 k 为 k + 1
  返回 结果

段落 UTF8转ISO8859_1 接收 数据:
  设 n 为 长(数据)
  设 结果 为 ""
  设 i 为 0
  当 i < n:
    设 o 为 码位(数据[i])
    如果 o > 255:
      返回 ""
    设 结果 为 结果 加上 编码hex2(o)
    设 i 为 i + 1
  返回 转小写(结果)

段落 字符集转换 接收 数据, 源编码, 目标编码:
  如果 源编码 == 目标编码:
    返回 数据
  返回 ""

段落 字符集转字符串 接收 数据, 源编码, 目标编码:
  如果 源编码 == 目标编码:
    如果 源编码 == "utf-8":
      返回 编码解UTF8(大写(数据))
    返回 数据
  返回 ""

段落 检测编码 接收 数据, 候选编码 = 空:
  返回 "utf-8"

# ── HTML 实体（顺序替换，对齐 .py 映射）──

段落 HTML实体编码 接收 文本:
  设 结果 为 文本
  设 键们 为 ["&", "<", ">", "\"", "'"]
  设 值们 为 ["&amp;", "&lt;", "&gt;", "&quot;", "&#39;"]
  设 i 为 0
  当 i < 5:
    设 结果 为 替换(结果, 键们[i], 值们[i])
    设 i 为 i + 1
  返回 结果

段落 HTML实体解码 接收 文本:
  设 结果 为 文本
  设 键们 为 ["&amp;", "&lt;", "&gt;", "&quot;", "&#39;", "&nbsp;"]
  设 值们 为 ["&", "<", ">", "\"", "'", " "]
  设 i 为 0
  当 i < 6:
    设 结果 为 替换(结果, 键们[i], 值们[i])
    设 i 为 i + 1
  返回 结果

# ── 字节 / 字符串 / 十六进制 互转（hex 串 = 字节序列）──

段落 字节转字符串 接收 数据, 编码 = "utf-8":
  如果 编码 != "utf-8":
    返回 ""
  返回 编码解UTF8(大写(数据))

段落 字符串转字节 接收 数据, 编码 = "utf-8":
  返回 转小写(编码编UTF8(数据))

段落 文本转十六进制 接收 文本, 编码 = "utf-8":
  返回 转小写(编码编UTF8(文本))

段落 十六进制转文本 接收 数据, 编码 = "utf-8":
  如果 编码 != "utf-8":
    返回 ""
  返回 编码解UTF8(大写(数据))

段落 二进制转字符串 接收 数据, 编码 = "utf-8":
  如果 编码 != "utf-8":
    返回 ""
  返回 编码解UTF8(大写(数据))

段落 字符串转二进制 接收 数据, 编码 = "utf-8":
  返回 转小写(编码编UTF8(数据))
