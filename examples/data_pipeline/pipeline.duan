# 段言 - 数据处理管道示例
# 读取 CSV → 清洗数据 → 聚合分析 → 存储 SQLite → 导出 JSON
# 用法: duan run examples/data_pipeline/pipeline.duan [样本数据文件]
# 示例: duan run examples/data_pipeline/pipeline.duan sample_data.csv

导入 文件系统。
导入 JSON。
导入 数据库。

# ===== 配置 =====
设 默认数据文件 为 "sample_data.csv"。
设 数据库文件 为 "pipeline.db"。
设 输出JSON文件 为 "output.json"。

# ===== 第一步：读取 CSV 文件 =====

# 解析 CSV 字符串为字典列表
段落 解析CSV 接收 文本：
  如果 文本 等于 空 或 文本 等于 ""：
    返回 [], []。

  设 行列表 为 分割字符串(文本, "\n")。
  如果 列表长度(行列表) 小于 2：
    返回 [], []。

  # 解析表头
  设 原始表头 为 分割字符串(行列表[0], ",")。
  设 表头 为 []。
  遍历 字段 于 原始表头：
    列表追加(表头, 去除空格(字段))。

  设 结果 为 []。
  设 行号 为 0。

  设 i 为 1。
  当 i 小于 列表长度(行列表)：
    设 行 为 去除空格(行列表[i])。
    如果 行 等于 ""：
      i 为 i + 1。
      跳过。

    设 字段 为 分割字符串(行, ",")。
    设 记录 为 {}。

    设 j 为 0。
    当 j 小于 列表长度(表头)：
      如果 j 小于 列表长度(字段)：
        设 值 为 去除空格(字段[j])。
        字典设置(记录, 表头[j], 值)。
      否则：
        字典设置(记录, 表头[j], "")。
      j 为 j + 1。

    列表追加(结果, 记录)。
    i 为 i + 1。

  返回 表头, 结果。

# 读取 CSV 文件
段落 读取CSV文件 接收 文件路径：
  如果 非 文件存在(文件路径)：
    打印("错误: 文件不存在 - " + 文件路径)。
    返回 [], []。

  设 内容 为 读取文件(文件路径)。
  打印("已读取文件: " + 文件路径 + " (" + 转字符串(字符串长度(内容)) + " 字节)")。

  返回 解析CSV(内容)。

# ===== 第二步：数据清洗 =====

# 去除重复记录
段落 去除重复 接收 数据, 关键字段：
  设 已见 为 {}。
  设 结果 为 []。
  设 重复数 为 0。

  遍历 记录 于 数据：
    设 键 为 记录[关键字段]。
    如果 字典包含键(已见, 键) 等于 假：
      字典设置(已见, 键, 真)。
      列表追加(结果, 记录)。
    否则：
      重复数 为 重复数 + 1。

  如果 重复数 大于 0：
    打印("  已去除 " + 转字符串(重复数) + " 条重复记录")。

  返回 结果。

# 清洗数值字段
段落 清洗数值 接收 值：
  设 清洗后 为 替换字符串(值, ",", "")。
  清洗后 为 替换字符串(清洗后, "¥", "")。
  清洗后 为 替换字符串(清洗后, "$", "")。
  清洗后 为 去除空格(清洗后)。

  如果 清洗后 等于 ""：
    返回 0。

  返回 转浮点数(清洗后)。

# 清洗日期字段
段落 清洗日期 接收 值：
  设 清洗后 为 去除空格(值)。
  返回 清洗后。

# 清洗文本字段
段落 清洗文本 接收 值：
  设 清洗后 为 去除空格(值)。
  清洗后 为 替换字符串(清洗后, "\"", "")。
  清洗后 为 替换字符串(清洗后, "'", "")。
  返回 清洗后。

# 标准化字段名
段落 标准化字段名 接收 字段名：
  设 小写 为 转小写(字段名)。
  设 映射 为 {
    "name": "姓名",
    "姓名": "姓名",
    "age": "年龄",
    "年龄": "年龄",
    "city": "城市",
    "城市": "城市",
    "department": "部门",
    "部门": "部门",
    "salary": "薪资",
    "薪资": "薪资",
    "金额": "薪资",
    "date": "日期",
    "日期": "日期",
    "hiredate": "日期",
    "入职日期": "日期",
    "email": "邮箱",
    "邮箱": "邮箱",
    "phone": "电话",
    "电话": "电话",
    "product": "产品",
    "产品": "产品",
    "category": "类别",
    "类别": "类别",
    "quantity": "数量",
    "数量": "数量",
    "price": "单价",
    "单价": "单价",
    "total": "总额",
    "总额": "总额",
    "status": "状态",
    "状态": "状态",
    "region": "地区",
    "地区": "地区"
  }。

  如果 字典包含键(映射, 小写)：
    返回 字典获取(映射, 小写, 字段名)。

  返回 字段名。

# 执行数据清洗
段落 清洗数据 接收 表头, 数据：
  打印("正在清洗数据...")。

  # 标准化字段名
  设 标准表头 为 []。
  遍历 字段 于 表头：
    列表追加(标准表头, 标准化字段名(字段))。

  打印("  字段映射: " + 连接字符串(表头, ", ") + " -> " + 连接字符串(标准表头, ", "))。

  # 转换数据字段
  设 清洗后数据 为 []。
  设 记录数 为 0。
  遍历 记录 于 数据：
    设 新记录 为 {}。

    设 i 为 0。
    当 i 小于 列表长度(标准表头)：
      设 字段名 为 标准表头[i]。
      设 原始值 为 记录[表头[i]]。
      设 清洗值 为 原始值。

      # 根据字段名智能清洗
      如果 字段名 等于 "年龄" 或 字段名 等于 "数量" 或 字段名 等于 "薪资" 或 字段名 等于 "单价" 或 字段名 等于 "总额"：
        清洗值 为 清洗数值(原始值)。
      否则如果 字段名 等于 "日期"：
        清洗值 为 清洗日期(原始值)。
      否则：
        清洗值 为 清洗文本(原始值)。

      字典设置(新记录, 字段名, 清洗值)。
      i 为 i + 1。

    列表追加(清洗后数据, 新记录)。
    记录数 为 记录数 + 1。

  打印("  已清洗 " + 转字符串(记录数) + " 条记录")。

  返回 标准表头, 清洗后数据。

# 去除空记录和无效记录
段落 过滤无效记录 接收 数据, 必需字段：
  设 结果 为 []。
  设 无效数 为 0。

  遍历 记录 于 数据：
    设 有效 为 真。
    遍历 字段 于 必需字段：
      如果 字典包含键(记录, 字段) 等于 假 或 记录[字段] 等于 空 或 记录[字段] 等于 ""：
        有效 为 假。
        跳出。

    如果 有效：
      列表追加(结果, 记录)。
    否则：
      无效数 为 无效数 + 1。

  如果 无效数 大于 0：
    打印("  已过滤 " + 转字符串(无效数) + " 条无效记录")。

  返回 结果。

# ===== 第三步：数据聚合 =====

# 计算汇总统计
段落 计算聚合 接收 数据, 分组字段, 数值字段：
  设 分组聚合 为 {}。
  设 总体统计 为 {
    "总计": 列表长度(数据),
    "总和": 0,
    "计数": 0,
    "最大值": 空,
    "最小值": 空
  }。

  遍历 记录 于 数据：
    设 分组键 为 记录[分组字段]。
    设 数值 为 记录[数值字段]。

    如果 数值 不等于 空：
      如果 数值 等于 空：
        数值 为 0。

      设 数值 为 转浮点数(数值)。

      # 更新总体统计
      总体统计["总和"] 为 总体统计["总和"] + 数值。
      总体统计["计数"] 为 总体统计["计数"] + 1。

      如果 总体统计["最大值"] 等于 空 或 数值 大于 总体统计["最大值"]：
        总体统计["最大值"] 为 数值。

      如果 总体统计["最小值"] 等于 空 或 数值 小于 总体统计["最小值"]：
        总体统计["最小值"] 为 数值。

      # 更新分组统计
      如果 字典包含键(分组聚合, 分组键) 等于 假：
        字典设置(分组聚合, 分组键, {
          "条目": 分组键,
          "计数": 0,
          "总和": 0,
          "平均值": 0,
          "最大值": 空,
          "最小值": 空
        })。

      设 组 为 分组聚合[分组键]。
      组["计数"] 为 组["计数"] + 1。
      组["总和"] 为 组["总和"] + 数值。

      如果 组["最大值"] 等于 空 或 数值 大于 组["最大值"]：
        组["最大值"] 为 数值。

      如果 组["最小值"] 等于 空 或 数值 小于 组["最小值"]：
        组["最小值"] 为 数值。

  # 计算平均值
  如果 总体统计["计数"] 大于 0：
    总体统计["平均值"] 为 总体统计["总和"] / 总体统计["计数"]。

  遍历 条目 于 分组聚合：
    设 组 为 分组聚合[条目]。
    如果 组["计数"] 大于 0：
      组["平均值"] 为 组["总和"] / 组["计数"]。

  返回 总体统计, 分组聚合。

# 打印聚合结果
段落 打印聚合结果 接收 总体统计, 分组聚合, 分组字段, 数值字段：
  打印("\n===== 聚合分析结果 =====")。
  打印("分组字段: " + 分组字段 + " | 数值字段: " + 数值字段)。
  打印("-" * 40)。

  打印("总体统计:")。
  打印("  记录总数: " + 转字符串(总体统计["总计"]))。
  打印("  有效数值数: " + 转字符串(总体统计["计数"]))。
  打印("  总和: " + 转字符串(总体统计["总和"]))。
  打印("  平均值: " + 转字符串(总体统计["平均值"]))。
  打印("  最大值: " + 转字符串(总体统计["最大值"]))。
  打印("  最小值: " + 转字符串(总体统计["最小值"]))。

  打印("\n分组统计:")。
  遍历 条目 于 分组聚合：
    设 组 为 分组聚合[条目]。
    打印("  [" + 条目 + "]")。
    打印("    数量: " + 转字符串(组["计数"]) + " | 总和: " + 转字符串(组["总和"]))。
    打印("    平均: " + 转字符串(组["平均值"]) + " | 最大: " + 转字符串(组["最大值"]) + " | 最小: " + 转字符串(组["最小值"]))。

# ===== 第四步：存储到 SQLite =====

段落 存储到数据库 接收 数据, 表名, 字段列表：
  如果 列表长度(数据) 等于 0：
    打印("警告: 无数据可存储")。
    返回。

  打印("\n正在存储到数据库: " + 数据库文件)。

  尝试：
    设 数据库 为 打开数据库(数据库文件)。

    # 构建字段定义
    设 字段定义 为 {}。
    遍历 字段 于 字段列表：
      设 字段类型 为 "TEXT"。
      如果 字段 等于 "年龄" 或 字段 等于 "数量" 或 字段 等于 "薪资" 或 字段 等于 "单价" 或 字段 等于 "总额"：
        字段类型 为 "REAL"。
      否则如果 字段 等于 "日期"：
        字段类型 为 "TEXT"。
      字典设置(字段定义, 字段, 字段类型)。

    # 创建表
    数据库.创建表(表名, 字段定义, [])。
    打印("  已创建表: " + 表名)。

    # 插入数据
    设 插入数 为 0。
    遍历 记录 于 数据：
      数据库.插入(表名, 记录)。
      插入数 为 插入数 + 1。

    数据库.关闭()。
    打印("  已插入 " + 转字符串(插入数) + " 条记录到 " + 表名)。

  捕获 错误 为 e：
    打印("数据库错误: " + 转字符串(e))。

# 从数据库查询并显示
段落 查询并显示 接收 表名：
  尝试：
    设 数据库 为 打开数据库(数据库文件)。

    打印("\n===== 数据库查询结果: " + 表名 + " =====")。
    设 所有记录 为 数据库.查询("SELECT * FROM " + 表名)。

    如果 列表长度(所有记录) 等于 0：
      打印("  表中无数据")。
      数据库.关闭()。
      返回。

    # 打印表头
    设 表头 为 数据库.获取字段名(表名)。
    打印("  字段: " + 连接字符串(表头, " | "))。

    # 打印数据行
    遍历 记录 于 所有记录：
      设 行文本 为 ""。
      设 首次 为 真。
      遍历 字段 于 表头：
        如果 非 首次：
          行文本 为 行文本 + " | "。
        行文本 为 行文本 + 转字符串(记录[字段])。
        首次 为 假。
      打印("  " + 行文本)。

    数据库.关闭()。

  捕获 错误 为 e：
    打印("查询错误: " + 转字符串(e))。

# ===== 第五步：导出 JSON =====

段落 导出为JSON 接收 数据, 文件路径, 是否格式化：
  设 缩进 为 2 如果 是否格式化 否则 空。
  设 JSON字符串 为 序列化JSON(数据, 缩进)。
  写入文件(文件路径, JSON字符串)。
  打印("已导出 " + 转字符串(列表长度(数据)) + " 条记录到 " + 文件路径)。

# ===== 主程序 =====

段落 主程序：
  导入 sys。

  设 参数 为 sys.argv。
  设 参数数量 为 列表长度(参数)。

  设 数据文件 为 默认数据文件。
  如果 参数数量 大于等于 2：
    数据文件 为 参数[1]。

  打印("=" * 50)。
  打印("  段言数据管道 v1.0")。
  打印("=" * 50)。
  打印("数据文件: " + 数据文件)。
  打印("=" * 50)。

  # 第一步：读取 CSV
  打印("\n[1/6] 读取 CSV 文件...")。
  设 表头, 数据 为 读取CSV文件(数据文件)。
  如果 列表长度(数据) 等于 0：
    打印("错误: 未读取到任何数据")。
    返回。

  打印("  原始字段: " + 连接字符串(表头, ", "))。
  打印("  原始记录数: " + 转字符串(列表长度(数据)))。

  # 第二步：数据清洗
  打印("\n[2/6] 清洗数据...")。
  设 标准表头, 清洗后数据 为 清洗数据(表头, 数据)。

  # 过滤无效记录
  设 必需字段 为 标准表头。
  设 有效数据 为 过滤无效记录(清洗后数据, 必需字段)。

  # 去除重复（假设第一个字段为主键）
  设 去重数据 为 去除重复(有效数据, 标准表头[0])。
  打印("  最终有效记录数: " + 转字符串(列表长度(去重数据)))。

  # 第三步：数据聚合
  打印("\n[3/6] 执行聚合分析...")。

  # 查找适合分组的字段（文本类型字段）
  设 分组字段 为 标准表头[0]。
  如果 列表长度(标准表头) 大于 1：
    分组字段 为 标准表头[1]。

  # 查找适合聚合的数值字段
  设 数值字段 为 标准表头[列表长度(标准表头) - 1]。
  遍历 字段 于 标准表头：
    如果 字段 等于 "薪资" 或 字段 等于 "数量" 或 字段 等于 "总额" 或 字段 等于 "年龄"：
      数值字段 为 字段。
      跳出。

  设 总体统计, 分组聚合 为 计算聚合(去重数据, 分组字段, 数值字段)。
  打印聚合结果(总体统计, 分组聚合, 分组字段, 数值字段)。

  # 第四步：存储到 SQLite
  打印("\n[4/6] 存储到 SQLite 数据库...")。
  存储到数据库(去重数据, "cleaned_data", 标准表头)。

  # 第五步：查询验证
  打印("\n[5/6] 查询数据库验证...")。
  查询并显示("cleaned_data")。

  # 第六步：导出 JSON
  打印("\n[6/6] 导出 JSON 文件...")。
  导出为JSON(去重数据, 输出JSON文件, 真)。
  导出为JSON({
    "summary": {
      "total_records": 列表长度(数据),
      "valid_records": 列表长度(去重数据),
      "duplicates_removed": 列表长度(数据) - 列表长度(去重数据),
      "fields": 标准表头
    },
    "aggregation": {
      "group_by": 分组字段,
      "value_field": 数值字段,
      "overall": 总体统计,
      "groups": 分组聚合
    },
    "data": 去重数据
  }, "pipeline_report.json", 真)。

  打印("\n" + "=" * 50)。
  打印("  数据处理管道执行完成！")。
  打印("  输出文件: " + 输出JSON文件 + ", pipeline_report.json, " + 数据库文件)。
  打印("=" * 50)。

主程序()。