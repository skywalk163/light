# 光明自举示例 - 简单词法分析器
# 演示如何用光明编写编译器组件

打印 "=== 光明自举示例：简单词法分析器 ==="

# 定义 Token 类型
段落 分词 接收 源码：
    """简单词法分析器：将源码字符串拆分为 token"""
    设 tokens 为 []
    设 位置 为 0
    设 长度 为 长度(源码)
    
    当 位置 < 长度：
        设 字符 为 源码[位置]
        
        # 跳过空白
        如果 字符 在 [' ', '\t', '\n', '\r']：
            位置 等于 位置 加 1
            跳过
        
        # 数字
        如果 字符.isdigit()：
            设 数字串 为 ""
            当 位置 < 长度 且 源码[位置].isdigit()：
                数字串 等于 数字串 加 源码[位置]
                位置 等于 位置 加 1
            列表追加(tokens, {'类型': '数字', '值': 转整数(数字串)})
            跳过
        
        # 字母/标识符
        如果 字符.isalpha() 或 字符 == '_'：
            设 标识符 为 ""
            当 位置 < 长度 且 (源码[位置].isalnum() 或 源码[位置] == '_')：
                标识符 等于 标识符 加 源码[位置]
                位置 等于 位置 加 1
            
            # 关键字判断
            如果 标识符 在 ['设', '为', '等于', '打印', '段落', '返回', '如果', '否则']：
                列表追加(tokens, {'类型': '关键字', '值': 标识符})
            否则：
                列表追加(tokens, {'类型': '标识符', '值': 标识符})
            跳过
        
        # 运算符
        如果 字符 在 ['+', '-', '*', '/', '=']：
            列表追加(tokens, {'类型': '运算符', '值': 字符})
            位置 等于 位置 加 1
            跳过
        
        # 括号
        如果 字符 在 ['(', ')', '[', ']']：
            列表追加(tokens, {'类型': '括号', '值': 字符})
            位置 等于 位置 加 1
            跳过
        
        # 其他字符
        列表追加(tokens, {'类型': '未知', '值': 字符})
        位置 等于 位置 加 1
    
    返回 tokens

# 测试词法分析器
设 测试代码 为 "设 x 为 42\n打印(x 加 10)"
打印 "测试源码："
打印(测试代码)
打印 ""

设 结果 为 分词(测试代码)
打印 "分词结果："
遍历 token 于 结果：
    打印(f"  [{token['类型']}] '{token['值']}'")

打印 ""
打印 "=== 词法分析完成 ==="
