# 评测驱动.light —— 用光明写的 deepseek-harness 主入口（M14 / M18 判据锚点）
#
# 一条命令端到端：读 JSONL 评测集 → 异步并发跑（任务池+速率限制+重试，编排全委托
# stdlib/并发.light 与 重试.light）→ 打分（精确/集合/正则，委托 stdlib/度量.light）→
# 出 Markdown + JSON 报告。报告数字可手算对账。
#
# 第七轮 C7 两链合流（M18 收口）：本文件在既有「单轮零工具」评测链之上新增 **agent 模式**，
# 一条命令从 examples/harness/评测集_agent.jsonl 驱动**带工具的多轮** 代理循环（代理循环）
# 跑完，把 agent 链的 轮数/工具调用次数/错误分类 收进同一份报告。三件题意：
#   1. 功能：HARNESS_MODE=agent 时每条评测跑一个 代理循环（多轮 + 工具），
#      报告含 轮数/工具调用次数；评测集含 2 条须调工具才答对的条目，mock 通道能发出
#      finish_reason == tool_calls。
#   2. 韧性：TimeoutError / HTTP 401 / OSError / 工具抛异常 各注入一条，整场跑完、
#      报告落盘、失败条目带 错误分类（六类：超时/连接/HTTP状态/解析/工具/未分类）。
#   3. 反跑：评测一条_agent 里的单条兜底 捕获（异常在协程内部吃掉、绝不向上抛），
#      摘掉后 Timeout/401/OSError 会冒泡到 asyncio.gather（无 return_exceptions）→
#      整场崩溃、报告不落盘、rc=1 —— 韧性用例立红。
#
# 并发模型（agent 模式）：
#   代理循环.运行 是**同步**的（阻塞 socket + time.sleep），语言层又不许类体放 异步 段落。
#   故 agent 模式走「丢线程再 await」：每个条目在 worker 线程里同步跑完 代理循环.运行，
#   主事件循环 `等待 asyncio.to_thread(...)` 收结果。多条目并发 = 多线程并行，事件循环不卡；
#   每个条目各自新建独立客户端与独立 事件总线，规避「一客户端=socket 10038」与并发互串。
#   这正是任务书「工具并行留线程侧、跨界只走丢线程再 await」的口径，且没有新建异步副本——
#   代理循环 仍是那唯一一份同步实现。
#
# LLM 消费形态（2026-08-23 A5 口径变更，覆盖总纲 §4.1 冻结示例）：
#   异步 遍历 块 之 通道对象.流式对话2(消息列表)   # 类同步方法，返回 async 生成器
#   （同步版 `流式对话` 签名冻结、无同名重载，二者异名共存）
#
# 运行（mock 场景，零 key 零发网；默认）：
#   python -m cli.light_unified run examples/harness/评测驱动.light
# agent 模式（mock，零 key 零发网）：
#   $env:HARNESS_MODE="agent"
#   python -m cli.light_unified run examples/harness/评测驱动.light
# 真实 DeepSeek 场景：
#   $env:HARNESS_CHANNEL="real" ; $env:DEEPSEEK_API_KEY="..."
#   python cli/light.py harness run --channel real --concurrency 2 --report %TEMP%\harness_real\评测报告
#
# 环境变量（全部可选，均有确定性默认值）：
#   HARNESS_MODE             single（默认，第六轮逐字节等价）/ agent（带工具多轮）
#   HARNESS_TOOLS            off（默认）/ on。**当前只进报告元信息与控制台摘要，不 gate 任何
#                            工具注册**：agent 模式下 造agent配置 → 初始化工具 无条件注册两个工具，
#                            HARNESS_TOOLS=off 也照样发 tool_calls。合并期核出的实情，先如实写清，
#                            要么让它真 gate、要么改名成纯标注，归后续轮次。

#   HARNESS_CHANNEL          mock（默认，确定性桩零发网）/ real（真实 DeepSeek，需 key）
#   HARNESS_EVAL_SET         评测集 JSONL 路径（默认 single→评测集.jsonl / agent→评测集_agent.jsonl）
#   HARNESS_REPORT           报告输出前缀（默认 examples/harness/评测报告）
#   HARNESS_CONCURRENCY      并发上限（默认 2）
#   HARNESS_RATE             每秒请求上限（默认 10）
#   HARNESS_RETRIES          重试次数（默认 3）
#   HARNESS_DELAY_SEC        mock 通道每请求延迟秒（默认 0.2；real 忽略）
#   HARNESS_TIMEOUT_SEC      单条挂钟超时秒（默认空 = 不限时）。超了记「超时」类失败、
#                            整场继续；agent 模式下只能取消等待、掐不掉已起的 worker 线程
#                            （见 限时等待 的诚实边界注记）
#   HARNESS_FAULT_TIMEOUT_PROMPTS  逗号分隔，命中即注入超时（仅 mock）
#   HARNESS_FAULT_ERROR_PROMPTS    逗号分隔，命中即注入连接错误（仅 mock）
#   HARNESS_PRICE_IN / HARNESS_PRICE_OUT   每千词元单价（成本估算用；两个都给才生效）
#   DEEPSEEK_API_KEY / DEEPSEEK_BASE_URL / DEEPSEEK_MODEL   仅 real 通道读
#
# 用量/成本/p50/p95 的现状（第八轮：用量透传已兑现）：
#   p50/p95 走 D7 的 stdlib/度量.分位（线性插值，见下方导入与 补扩展汇总）。
#   用量/成本 **已接真值**，链路是：
#     块上的「用量」（mock 通道发字符数替身、真实通道发服务端 usage）
#     → stdlib/代理循环.累计用量（agent 链，逐轮相加）或 编排.带重试对话（单模链）
#     → 条目的 输入词元/输出词元
#     → 打分.批量汇总 透传给 stdlib/度量.批量汇总(评分表, 单价)
#     → 补扩展汇总 装成 汇总["用量"] / 汇总["成本"]。
#   一条都没采到时这两个字段**仍是空字典**（不许拿 0 冒充）；单价未配时
#   成本说明 写「未配置单价」、成本估算 是空串。

#
# e2e 处置（task书 §4.4）：本文件在 tests/e2e/test_e2e_chain.py 标注 e2e 排除，真覆盖放
#   tests/test_harness_e2e_light.py 与 tests/test_harness_agent_light.py。
导入 os
导入 sys
导入 time
导入 asyncio
从 LLM通道 导入 LLM通道, MockAgentClient
从 真实通道 导入 真实通道
从 代理循环 导入 代理循环
从 大模型客户端 导入 大模型客户端
导入 错误分类
从 编排 导入 任务池运行, 等令牌, 带重试对话
# 第八轮：单条挂钟超时走 stdlib/并发.超时运行（= asyncio.wait_for），不自己写计时。
从 并发 导入 超时运行
从 打分 导入 单条打分, 批量汇总
# p50/p95 走 D7 的 stdlib/度量.分位（线性插值口径，百分位取 0-100）；本文件原先的
# 本地 求分位数 用「取整下标」，与项目口径不一致，合并期已删除。
从 度量 导入 分位
从 行流 导入 读取评测集, 取坏行
从 JSON 导入 序列化JSON, 写入JSON文件
从 文件系统 导入 写入文件

# ---- 内置确定性答案表（与 评测集.jsonl 一一对应；mock 通道消费，**不许改**）----
设 内置答案表 为 ["列出中国的首都": "北京", "太阳从哪边升起": "西方", "列举三种水果": "苹果、香蕉、橙子", "列举两种编程语言": "Python、Java", "给出一个邮箱地址": "user@example.com", "给出一个手机号": "12345"]

# ---- C7：agent 模式的内置表格（与 评测集_agent.jsonl 一一对应；mock agent 消费）----
# 工具题表：prompt → 该调的工具与参数。命中且会话里尚无 tool 结果 → mock 发 tool_calls；
# 工具结果回喂后 mock 读末条 tool 消息当最终答。故 2 条须工具条目（查首都）**结构性**必须
# 调工具才能答对。第 3 条 查故障 的工具实现会抛，用于「工具抛异常」错误分类。
设 agent答案表 为 ["一加一等于几": "2"]
设 工具首都表 为 ["中国": "北京", "法国": "巴黎"]
设 agent工具题表 为 {}
agent工具题表["中国的首都是哪个城市"] 为 ["工具": "lookup_capital", "参数": ["国家": "中国"]]
agent工具题表["法国的首都是哪个城市"] 为 ["工具": "lookup_capital", "参数": ["国家": "法国"]]
agent工具题表["查询故障的东西"] 为 ["工具": "inject_fault", "参数": ["触发": 真]]

# ---- agent 模式工具实现（查首都 / 查故障）----
段落 工具查首都 接收 参数:
  设 国家 为 参数["国家"]
  如果 国家 在 工具首都表:
    返回 工具首都表[国家]
  返回 "未知国家"

段落 工具查故障 接收 参数:
  抛出 新建 ValueError("agent 工具「查故障」注入异常")

# 工具 JSON Schema（一步一步构建，光明无多行字典字面量）
段落 查首都模式 接收:
  设 属性 为 ["国家": ["type": "string"]]
  返回 ["type": "object", "properties": 属性, "required": ["国家"]]

段落 查故障模式 接收:
  设 属性 为 ["触发": ["type": "boolean"]]
  返回 ["type": "object", "properties": 属性, "required": []]

# 注册 agent 模式的两个工具：查首都（只读，可并行）/ 查故障（写，降级串行）
段落 初始化工具 接收 代理:
  代理.注册工具("lookup_capital", "查一个国家的首都", 查首都模式(), 工具查首都, "只读")
  代理.注册工具("inject_fault", "注入一个工具异常（供错误分类演示，始终抛）", 查故障模式(), 工具查故障, "写")
  返回 真

# 客户端工厂（零参闭包）：真实模式新建 大模型客户端，mock 模式新建 MockAgentClient。
# 每个 agent 一个独立客户端，规避「一客户端=socket 10038」。
段落 造客户端工厂 接收 客户端配置:
  段落 干:
    如果 客户端配置["真实"]:
      返回 新建 大模型客户端(客户端配置["端点"], 客户端配置["模型"], 客户端配置["密钥"])
    返回 新建 MockAgentClient(客户端配置["mock配置"])
  返回 干

# agent 运行任务（零参同步闭包，交给 asyncio.to_thread 丢线程跑）。
# 内部故障（Timeout/401/OSError）会被 代理循环 重试耗尽后抛出，经 to_thread 向上抛，
# 由 评测一条_agent 的单条兜底接住分类。工具异常不会抛出来（代理循环 内部隔离），
# 而是记进 工具错误表，供本任务在成功返回里带出。
段落 造agent运行 接收 条目, agent配置:
  段落 干:
    设 客户端工厂 为 造客户端工厂(agent配置["客户端配置"])
    设 代理 为 新建 代理循环("", "", "", agent配置["最大轮数"], agent配置["消息上限"], 客户端工厂)
    初始化工具(代理)
    设 回复 为 代理.运行(条目["prompt"])
    返回 ["回复": 回复, "完成轮数": 代理.完成轮数, "工具执行次数": 代理.工具执行次数, "工具错误表": 代理.工具错误表, "输入词元": 代理.总输入词元, "输出词元": 代理.总输出词元]
  返回 干

# 读环境变量（带默认值）
段落 取环境 接收 名, 默认值:
  设 值 为 os.environ.get(名, "")
  如果 值 == "":
    返回 默认值
  返回 值

# 解析逗号分隔的环境变量为提示词表（故障注入用）
段落 取提示词表 接收 名:
  设 原始 为 os.environ.get(名, "")
  设 结果 为 []
  如果 原始 == "":
    返回 结果
  设 分表 为 原始.split(",")
  遍历 项 之 分表:
    设 干净 为 项.strip()
    如果 干净 != "":
      结果.追加(干净)
  返回 结果

# 列表是否包含某元素（光明无 `值 in 列表`；字典键探测用）
段落 列表含键 接收 字典, 键:
  遍历 键名 之 字典.keys():
    如果 键名 == 键:
      返回 真
  返回 假

# ---- 第八轮：单条挂钟超时（接 stdlib/并发.超时运行 = asyncio.wait_for）----
# 超时秒 == 空 → 不限时，直接 await 原协程（默认，与第七轮行为逐字节等价）。
# 数字 → 交给 超时运行；超了抛 TimeoutError，由调用方的单条兜底 捕获 接住，经
# 错误分类.分类 落到「超时」类（asyncio.TimeoutError 自 3.11 起即内置 TimeoutError
# 的别名，本机 3.14 实测 `asyncio.TimeoutError is TimeoutError` 为真，故
# 错误分类.light:37 那条 isinstance 天然覆盖，不用加分支）。
#
# ⚠️ 诚实边界：agent 模式被限时的对象是 asyncio.to_thread(...)，wait_for 能取消的只是
# **等待**，取消不了已经跑起来的 worker 线程 —— 那个线程会继续跑到 代理循环 自己收尾。
# 也就是说这里兑现的是「整场不被一条卡死」，不是「把远端请求真掐断」。真掐断要靠
# 代理循环 侧的 取消令牌（事件总线.取消令牌），本轮不动它。
异步 段落 限时等待 接收 协程, 超时秒:
  如果 超时秒 == 空:
    设 结果 为 等待 协程
    返回 结果
  设 结果 为 等待 超时运行(协程, 超时秒)
  返回 结果

# 解析 HARNESS_TIMEOUT_SEC：空串 / 非正数 → 空（不限时）。
# 不给默认秒数：凭空定一个上限会把「慢但正常」的真实请求判成超时。
段落 造超时秒 接收 原始:
  如果 原始 == "":
    返回 空
  设 秒 为 转浮点(原始)
  如果 秒 <= 0:
    返回 空
  返回 秒

# 从起点算已过秒数。抽成一处的理由不只是去重：单条兜底要求 尝试/捕获 两分支各自
# 提前 return，耗时表达式因此要在两个分支各写一遍，写成裸 time.time() 会让
# Python 直调门禁的行数只涨不降。
段落 已过秒 接收 起点:
  返回 time.time() - 起点


# ---- agent 模式单条评测（协程）：丢线程跑同步 agent → 单条兜底错误分类 → 打分 ----
# C7 M18 判据 2/3 核心：**异常在协程内部就吃掉**——to_thread 抛上来的任何异常都被
# 这里的 捕获 接住并转成「失败条目 + 错误分类」，协程绝不向上抛（asyncio.gather 无
# return_exceptions，正解是协程内自保，不许改 src/）。摘掉这个 捕获 就是 M18 判据 3 的
# 反跑：Timeout/401/OSError 冒泡 → 整场崩、报告不落盘。
#
# ⚠️ 语言约束（实测实录）：光明编译器的 捕获 子句会把**其后同级全部语句**折叠进 except
# 主体（生成代码把整段 else 逻辑塞进 except）。故本函数**必须在 尝试 与 捕获 两分支内各自
# 提前 return**，函数体不允许出现 try/catch 之外的兄弟语句；组装逻辑抽成下方同步 段落。
异步 段落 评测一条_agent 接收 序号, 条目, 评测配置:
  等待 等令牌(评测配置["速率上限"])
  设 起点 为 time.time()
  设 运行任务 为 造agent运行(条目, 评测配置["agent"])
  尝试:
    设 运行结果 为 等待 限时等待(asyncio.to_thread(运行任务), 评测配置["超时秒"])
    设 耗时 为 已过秒(起点)
    返回 组装agent成功(序号, 条目, 运行结果, 耗时)
  捕获 异常 e:
    设 异常分类结果 为 错误分类.分类(e)
    设 耗时 为 已过秒(起点)
    返回 组装agent失败(序号, 条目, 异常分类结果, 耗时, 评测配置["重试次数"])

# 组装 agent 成功路径：工具抛异常→分类 工具；否则按打分器判对错。
段落 组装agent成功 接收 序号, 条目, 运行结果, 耗时:
  设 输出 为 运行结果["回复"]
  设 完成轮数 为 运行结果["完成轮数"]
  设 工具次数 为 运行结果["工具执行次数"]
  设 得分 为 0
  设 分类 为 ""
  设 错误消息 为 ""
  设 尝试次数 为 1
  如果 长(运行结果["工具错误表"]) > 0:
    # 工具抛异常 → 分类 工具；取首条工具错误当 错误消息（结构信息，不靠字符串判据）
    设 分类 为 "工具"
    设 错误消息 为 运行结果["工具错误表"][0]
  否则 如果 单条打分(输出, 条目["期望答案"], 条目["打分器"]):
    设 得分 为 1
  返回 ["序号": 序号, "prompt": 条目["prompt"], "期望答案": 条目["期望答案"], "打分器": 条目["打分器"], "输出": 输出, "得分": 得分, "耗时": 耗时, "尝试次数": 尝试次数, "完成轮数": 完成轮数, "工具调用次数": 工具次数, "错误分类": 分类, "错误消息": 错误消息, "输入词元": 运行结果["输入词元"], "输出词元": 运行结果["输出词元"]]

# 组装 agent 失败路径：单条兜底——异常已分类，协程不向上抛。
# 用量留空（空）而不是 0：这条根本没跑完，没有可报的词元数。
段落 组装agent失败 接收 序号, 条目, 异常分类结果, 耗时, 尝试次数上限:
  设 分类 为 异常分类结果["类"]
  设 错误消息 为 异常分类结果["名"] 加上 ": " 加上 异常分类结果["消息"]
  返回 ["序号": 序号, "prompt": 条目["prompt"], "期望答案": 条目["期望答案"], "打分器": 条目["打分器"], "输出": "", "得分": 0, "耗时": 耗时, "尝试次数": 尝试次数上限, "完成轮数": 0, "工具调用次数": 0, "错误分类": 分类, "错误消息": 错误消息, "输入词元": 空, "输出词元": 空]

# 组装 agent 模式客户端配置（真实 / mock 两套）
段落 造agent配置 接收 通道模式, 在线端点, 在线模型, 在线密钥, 延迟秒:
  设 故障表 为 ["超时": ["注入超时"], "HTTP401": ["注入HTTP401"], "OSError": ["注入OSError"]]
  设 mock配置 为 ["答案表": agent答案表, "默认回答": "（agent未命中）", "延迟秒": 延迟秒, "故障表": 故障表, "工具题表": agent工具题表]
  设 客户端配置 为 ["真实": 假, "端点": "", "模型": "", "密钥": "", "mock配置": mock配置]
  如果 通道模式 == "real":
    设 客户端配置["真实"] 为 真
    设 客户端配置["端点"] 为 在线端点
    设 客户端配置["模型"] 为 在线模型
    设 客户端配置["密钥"] 为 在线密钥
  返回 ["客户端配置": 客户端配置, "最大轮数": 5, "消息上限": 40]

# ---- 单条评测（协程）：限速 → 带重试对话 → 打分 → 组装条目 ----
# 注意：协程对象会进入 任务池运行 的列表，所以这里是 异步 段落（协程工厂）。
异步 段落 评测一条 接收 序号, 条目, 评测配置, 通道对象, 模式:
  如果 模式 == "agent":
    返回 等待 评测一条_agent(序号, 条目, 评测配置)
  等待 等令牌(评测配置["速率上限"])
  设 起点 为 time.time()
  设 消息 为 [["role": "user", "content": 条目["prompt"]]]
  尝试:
    设 结果 为 等待 限时等待(带重试对话(通道对象, 消息, 评测配置["重试次数"]), 评测配置["超时秒"])
    返回 组装单模成功(序号, 条目, 结果, 已过秒(起点))
  捕获 异常 e:
    # 第八轮：单模链现在也有单条兜底了 —— 限时等待 抛的 TimeoutError 在协程内部就被吃掉、
    # 转成带 错误分类 的失败条目，与 agent 链同构（协程绝不向上抛）。
    # 【第九轮 E9-S1 订正】任务池 现在有 失败模式：两参调用走默认 "逐条收集"（等价
    # return_exceptions=True），漏抛的异常会变成结果表里的错误对象占位而不是当场炸；
    # 本条兜底照旧必需 —— 报告要的是带 错误分类 的失败条目，不是一个裸异常对象。
    # ⚠️ 同一条语言约束：捕获 会把其后同级语句折进 except 体，故两分支各自 return，
    # 组装逻辑抽成下面两个同步段落。
    设 异常分类结果 为 错误分类.分类(e)
    返回 组装单模失败(序号, 条目, 异常分类结果, 已过秒(起点), 评测配置["重试次数"])

# 组装单模成功路径（原 评测一条 的尾部逻辑，为规避 捕获 折叠 bug 抽成同步段落）
段落 组装单模成功 接收 序号, 条目, 结果, 耗时:
  设 得分 为 0
  如果 结果["成功"]:
    如果 单条打分(结果["输出"], 条目["期望答案"], 条目["打分器"]):
      设 得分 为 1
  返回 ["序号": 序号, "prompt": 条目["prompt"], "期望答案": 条目["期望答案"], "打分器": 条目["打分器"], "输出": 结果["输出"], "得分": 得分, "耗时": 耗时, "尝试次数": 结果["尝试次数"], "完成轮数": 0, "工具调用次数": 0, "错误分类": "", "错误": 结果["错误"], "输入词元": 结果["输入词元"], "输出词元": 结果["输出词元"]]

# 组装单模失败路径（第八轮新增）：异常已分类，协程不向上抛。
# 键集与成功路径逐键一致（报告逐条明细按同一套键取值），只是值全是失败态：
# 输出空串、得分 0、尝试次数记重试上限、词元留空（这条没跑完，没有可报的词元数）。
段落 组装单模失败 接收 序号, 条目, 异常分类结果, 耗时, 尝试次数上限:
  设 错误消息 为 异常分类结果["名"] 加上 ": " 加上 异常分类结果["消息"]
  返回 ["序号": 序号, "prompt": 条目["prompt"], "期望答案": 条目["期望答案"], "打分器": 条目["打分器"], "输出": "", "得分": 0, "耗时": 耗时, "尝试次数": 尝试次数上限, "完成轮数": 0, "工具调用次数": 0, "错误分类": 异常分类结果["类"], "错误": 错误消息, "输入词元": 空, "输出词元": 空]

# 零参异步任务闭包：把「评测一条(序号, 条目, …)」包成任务池要的零参异步段落。
# 参数在 造评测任务 的形参里绑定，天然规避了闭包按名捕获的 late-binding（见 探针5b）。
段落 造评测任务 接收 序号, 条目, 评测配置, 通道对象, 模式:
  异步 段落 干:
    返回 等待 评测一条(序号, 条目, 评测配置, 通道对象, 模式)
  返回 干

# 并发评测：构造零参异步任务表 → stdlib 任务池（经 编排；最多 N 路并行、结果按提交顺序）
异步 段落 并发评测 接收 条目表, 评测配置, 通道对象, 模式:
  设 任务表 为 []
  设 序号 为 1
  遍历 条目 之 条目表:
    设 任务 为 造评测任务(序号, 条目, 评测配置, 通道对象, 模式)
    任务表.追加(任务)
    设 序号 为 序号 + 1
  设 结果 为 等待 任务池运行(任务表, 评测配置["并发上限"])
  返回 结果

# ---- 失败分类计数（报告规格）：六类各计几条失败 ----
段落 计失败分类 接收 条目表:
  设 计数 为 ["超时": 0, "连接": 0, "HTTP状态": 0, "解析": 0, "工具": 0, "未分类": 0]
  遍历 条目 之 条目表:
    设 分类 为 条目["错误分类"]
    如果 分类 != "" 且 列表含键(计数, 分类):
      设 计数[分类] 为 计数[分类] + 1
  返回 计数

# ---- p50 / p95 分位数：走 D7 的 stdlib/度量.分位（合并期把 C7 的本地兜底换掉）----
# C7 的本地 求分位数 用 `转整数(百分位 * (n-1))` 取整下标，与 stdlib/度量.分位 的
# **线性插值**口径不同——那正是 D7 反跑用来打红的那处变异形态。留着就是第二份实现
# 且算法还不一样，故删掉本地版、直接吃 度量.分位（百分位口径 0-100）。
段落 补扩展汇总 接收 汇总, 条目表:
  设 汇总["失败分类计数"] 为 计失败分类(条目表)
  设 耗时表 为 []
  遍历 条目 之 条目表:
    耗时表.追加(条目["耗时"])
  设 汇总["p50"] 为 分位(耗时表, 50)
  设 汇总["p95"] 为 分位(耗时表, 95)
  # ---- 用量 / 成本：第八轮接上真值（原「留空字典」的占位已兑现）----
  # 整条链：块上的「用量」→ stdlib/代理循环.累计用量（agent 链）或
  #   编排.带重试对话（单模链）把英文键翻成 输入词元/输出词元 → 条目带上它们
  #   → 打分.批量汇总 透传给 stdlib/度量.批量汇总(评分表, 单价)
  #   → 这里取 总输入词元/总输出词元/成本估算/成本说明 装成两个字典。
  # 一条都没采到用量时（总输入/总输出 都是 空）**仍然留空字典**：不许拿 0 冒充，
  # 那会让「没采到」和「真的是 0」不可区分。未配单价时 成本说明 会写「未配置单价」，
  # 成本估算 是空串 —— 也是同一条口径（度量.light:129-130）。
  设 汇总["用量"] 为 {}
  设 汇总["成本"] 为 {}
  如果 汇总["总输入词元"] != 空 或 汇总["总输出词元"] != 空:
    设 汇总["用量"] 为 ["总输入词元": 汇总["总输入词元"], "总输出词元": 汇总["总输出词元"]]
    设 汇总["成本"] 为 ["成本估算": 汇总["成本估算"], "成本说明": 汇总["成本说明"]]
  返回 汇总

# 造单价：两个都给才算配置了单价。只给一个就当没配置——拿 0 当另一半会算出
# 一个看着像真的、其实少了一半的成本，比不算更坏。
段落 造单价 接收 入价, 出价:
  如果 入价 == "" 或 出价 == "":
    返回 空
  返回 ["输入": 转浮点(入价), "输出": 转浮点(出价)]


# 生成 Markdown 报告
段落 生成Markdown 接收 条目表, 汇总, 元信息:
  设 行表 为 []
  行表.追加("# DeepSeek Harness 评测报告")
  行表.追加("")
  行表.追加("- 评测集：" 加上 元信息["评测集路径"])
  行表.追加("- 模式：" 加上 元信息["模式"] 加上 "（ agent=带工具多轮 / single=单轮零工具）")
  行表.追加("- 工具：" 加上 元信息["工具"])
  行表.追加("- 通道：" 加上 元信息["通道"] 加上 "（mock=确定性桩零发网 / real=真实 DeepSeek）")
  行表.追加("- 并发上限：" 加上 转字符串(元信息["并发上限"]))
  行表.追加("- 速率上限：" 加上 转字符串(元信息["速率上限"]) 加上 " 次/秒")
  行表.追加("- 重试次数：" 加上 转字符串(元信息["重试次数"]))
  行表.追加("- 总耗时：" 加上 转字符串(元信息["总耗时"]) 加上 " 秒")
  行表.追加("- 通过率：" 加上 转字符串(汇总["通过率"]))
  行表.追加("")
  行表.追加("## 汇总")
  行表.追加("")
  行表.追加("| 指标 | 数值 |")
  行表.追加("|---|---|")
  行表.追加("| 总条数 | " 加上 转字符串(汇总["总条数"]) 加上 " |")
  行表.追加("| 通过数 | " 加上 转字符串(汇总["通过数"]) 加上 " |")
  行表.追加("| 未通过数 | " 加上 转字符串(汇总["未通过数"]) 加上 " |")
  行表.追加("| 通过率 | " 加上 转字符串(汇总["通过率"]) 加上 " |")
  行表.追加("| 失败分类计数 | " 加上 转字符串(汇总["失败分类计数"]) 加上 " |")
  行表.追加("| p50 耗时 | " 加上 转字符串(汇总["p50"]) 加上 " 秒 |")
  行表.追加("| p95 耗时 | " 加上 转字符串(汇总["p95"]) 加上 " 秒 |")
  行表.追加("| 用量 | " 加上 转字符串(汇总["用量"]) 加上 " |")
  行表.追加("| 成本 | " 加上 转字符串(汇总["成本"]) 加上 " |")
  行表.追加("")
  行表.追加("## 子集统计")
  行表.追加("")
  行表.追加("| 打分器 | 总条数 | 通过数 | 通过率 |")
  行表.追加("|---|---|---|---|")
  遍历 子集 之 汇总["子集"]:
    行表.追加("| " 加上 子集["打分器"] 加上 " | " 加上 转字符串(子集["总条数"]) 加上 " | " 加上 转字符串(子集["通过数"]) 加上 " | " 加上 转字符串(子集["通过率"]) 加上 " |")
  行表.追加("")
  行表.追加("## 逐条明细（含 尝试次数 与 错误分类）")
  行表.追加("")
  行表.追加("| 序号 | prompt | 打分器 | 输出 | 期望 | 得分 | 耗时(秒) | 尝试 | 轮数 | 工具调用 | 错误分类 |")
  行表.追加("|---|---|---|---|---|---|---|---|---|---|---|")
  遍历 条目 之 条目表:
    # 输出可能含换行/Markdown 元字符，表格里折叠成单行
    设 输出行 为 条目["输出"].replace("\n", " ")
    行表.追加("| " 加上 转字符串(条目["序号"]) 加上 " | " 加上 条目["prompt"] 加上 " | " 加上 条目["打分器"] 加上 " | " 加上 输出行 加上 " | " 加上 转字符串(条目["期望答案"]) 加上 " | " 加上 转字符串(条目["得分"]) 加上 " | " 加上 转字符串(条目["耗时"]) 加上 " | " 加上 转字符串(条目["尝试次数"]) 加上 " | " 加上 转字符串(条目["完成轮数"]) 加上 " | " 加上 转字符串(条目["工具调用次数"]) 加上 " | " 加上 条目["错误分类"] 加上 " |")
  行表.追加("")
  返回 "\n".join(行表)

# 主流程
异步 段落 主 接收:
  # C7：HARNESS_MODE / HARNESS_TOOLS 由 A7 在 cli 侧落地，这里读 .light 侧
  设 模式 为 取环境("HARNESS_MODE", "single")
  设 工具开关 为 取环境("HARNESS_TOOLS", "off")
  设 通道模式 为 取环境("HARNESS_CHANNEL", "mock")
  # 默认评测集：single→评测集.jsonl / agent→评测集_agent.jsonl
  设 默认评测集 为 "examples/harness/评测集.jsonl"
  如果 模式 == "agent":
    设 默认评测集 为 "examples/harness/评测集_agent.jsonl"
  设 评测集路径 为 取环境("HARNESS_EVAL_SET", 默认评测集)
  设 报告前缀 为 取环境("HARNESS_REPORT", "examples/harness/评测报告")
  设 并发上限 为 转整数(取环境("HARNESS_CONCURRENCY", "2"))
  设 速率上限 为 转整数(取环境("HARNESS_RATE", "10"))
  设 重试次数 为 转整数(取环境("HARNESS_RETRIES", "3"))
  设 延迟秒 为 转浮点(取环境("HARNESS_DELAY_SEC", "0.2"))
  # 第八轮：单条挂钟超时（空 = 不限时；见 限时等待 / 造超时秒）
  设 超时秒 为 造超时秒(取环境("HARNESS_TIMEOUT_SEC", ""))
  如果 非 os.path.exists(评测集路径):
    打印("评测集不存在：" 加上 评测集路径)
    sys.exit(2)
  # 通道：默认 mock（确定性 + 故障注入，零发网）；HARNESS_CHANNEL=real 走真实 DeepSeek。
  # 真实通道做成**常驻可选后端**；缺 key 直接退（不许静默降级回 mock）。
  设 在线端点 为 取环境("DEEPSEEK_BASE_URL", "https://api.deepseek.com")
  设 在线模型 为 取环境("DEEPSEEK_MODEL", "deepseek-chat")
  设 在线密钥 为 os.environ.get("DEEPSEEK_API_KEY", "")
  设 通道 为 空
  设 agent配置 为 空
  设 模式_通道 为 通道模式
  如果 通道模式 == "real":
    如果 在线密钥 == "":
      打印("HARNESS_CHANNEL=real 需要 DEEPSEEK_API_KEY（不降级回 mock）")
      sys.exit(2)
    打印("通道=real 端点=" 加上 在线端点 加上 " 模型=" 加上 在线模型)
    如果 模式 == "agent":
      # agent 模式真实通道：客户端工厂会 新建 大模型客户端 真连接
      设 agent配置 为 造agent配置(通道模式, 在线端点, 在线模型, 在线密钥, 延迟秒)
    否则:
      设 通道 为 新建 真实通道(在线端点, 在线模型, "")
  否则:
    如果 模式 == "agent":
      # agent 模式 mock 通道：造agent配置 产出 MockAgentClient 客户端配置
      设 agent配置 为 造agent配置(通道模式, "", "", "", 延迟秒)
    否则:
      设 超时表 为 取提示词表("HARNESS_FAULT_TIMEOUT_PROMPTS")
      设 错误表 为 取提示词表("HARNESS_FAULT_ERROR_PROMPTS")
      设 通道 为 新建 LLM通道(["答案表": 内置答案表, "默认回答": "（未命中）", "延迟秒": 延迟秒, "故障表": ["超时": 超时表, "错误": 错误表]])

  # 加载评测集
  设 条目表 为 读取评测集(评测集路径)
  设 坏行 为 取坏行()
  如果 长(坏行) > 0:
    打印("警告：评测集有 " 加上 转字符串(长(坏行)) 加上 " 行解析失败（已跳过）")
  # 并发评测
  设 评测配置 为 ["并发上限": 并发上限, "速率上限": 速率上限, "重试次数": 重试次数, "agent": agent配置, "超时秒": 超时秒]
  设 起点 为 time.time()
  设 结果表 为 等待 并发评测(条目表, 评测配置, 通道, 模式)
  设 总耗时 为 time.time() - 起点
  # 汇总与报告
  # 单价（每千词元）：A7 已把 cli 的 --price-in/--price-out 转成这两个环境变量，
  # 但此前 .light 侧没有任何地方读它们 —— 用户传了价，报告里成本照样是空的。
  # 这里把那条悬空参数接上（两个都给才算配置，见 造单价）。
  设 单价 为 造单价(取环境("HARNESS_PRICE_IN", ""), 取环境("HARNESS_PRICE_OUT", ""))
  设 汇总 为 批量汇总(结果表, 单价)
  设 汇总 为 补扩展汇总(汇总, 结果表)
  设 元信息 为 ["通道": 通道模式, "评测集路径": 评测集路径, "并发上限": 并发上限, "速率上限": 速率上限, "重试次数": 重试次数, "总耗时": 总耗时, "模式": 模式, "工具": 工具开关]
  设 报告体 为 ["元信息": 元信息, "条目": 结果表, "汇总": 汇总]
  # 报告父目录不存在时先建出来（mock 测试把报告指进临时目录）
  设 报告目录 为 os.path.dirname(报告前缀)
  如果 报告目录 != "":
    os.makedirs(报告目录, exist_ok=True)
  写入JSON文件(报告前缀 加上 ".json", 报告体, 真)
  设 文档 为 生成Markdown(结果表, 汇总, 元信息)
  写入文件(报告前缀 加上 ".md", 文档)
  # 控制台摘要（锚点行：e2e / agent 测试断言用）
  打印("=== harness 评测完成 ===")
  打印("模式=" 加上 模式 加上 " 工具=" 加上 工具开关 加上 " 通道=" 加上 通道模式)
  打印("总条数=" 加上 转字符串(汇总["总条数"]) 加上 " 通过=" 加上 转字符串(汇总["通过数"]) 加上 " 未通过=" 加上 转字符串(汇总["未通过数"]))
  打印("通过率=" 加上 转字符串(汇总["通过率"]))
  打印("总耗时=" 加上 转字符串(总耗时) 加上 " 秒（并发上限 " 加上 转字符串(并发上限) 加上 "）")
  打印("报告已写出：" 加上 报告前缀 加上 ".json / " 加上 报告前缀 加上 ".md")
  返回 0

异步 运行 主()