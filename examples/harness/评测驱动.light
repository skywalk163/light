# 评测驱动.light —— 用光明写的 deepseek-harness MVP 主入口（M14 判据锚点）
#
# 一条命令端到端：读 JSONL 评测集 → 异步并发跑 LLM（任务池+速率限制+重试）→
# 打分（精确/集合/正则）→ 出 Markdown + JSON 报告。报告数字可手算对账。
#
# LLM 消费形态（2026-08-23 A5 口径变更，覆盖总纲 §4.1 冻结示例）：
#   异步 遍历 块 之 通道对象.流式对话2(消息列表)   # 类同步方法，返回 async 生成器
#   （同步版 `流式对话` 签名冻结、无同名重载，二者异名共存；增量块字段与同步版
#     逐字一致：角色/内容增量/工具调用增量/累积内容/完成原因/结束）
#
# 运行（mock 场景，零 key 零发网）：
#   python -m cli.light_unified run examples/harness/评测驱动.light
# 真实 DeepSeek 场景（A5 合入后替换 LLM通道 为 stdlib 大模型客户端）：
#   $env:DEEPSEEK_API_KEY="..." ; python -m cli.light_unified run examples/harness/评测驱动.light
#
# 环境变量（全部可选，均有确定性默认值）：
#   HARNESS_EVAL_SET       评测集 JSONL 路径（默认 examples/harness/评测集.jsonl）
#   HARNESS_REPORT         报告输出前缀（默认 examples/harness/评测报告）
#   HARNESS_CONCURRENCY    并发上限（默认 2）
#   HARNESS_RATE           每秒请求上限（默认 10）
#   HARNESS_RETRIES        重试次数（默认 3）
#   HARNESS_DELAY_SEC      mock 通道每请求延迟秒（默认 0.2；真实通道忽略）
#   HARNESS_FAULT_TIMEOUT_PROMPTS  逗号分隔，命中即注入超时（打红/重试测试用）
#   HARNESS_FAULT_ERROR_PROMPTS    逗号分隔，命中即注入连接错误（打红/重试测试用）
#
# e2e 处置（交付报告必答项，任务书 §4.4）：
#   本文件选 **(b)：加进 tests/e2e/test_e2e_chain.py 的 E2E_EXCLUDED，真覆盖放
#   在 tests/test_harness_e2e_light.py**（照 examples/harness/主程序.light 先例）。
#   理由：e2e 子进程环境继承 DEEPSEEK_API_KEY，有 key 时 run 本文件会真发网到
#   api.deepseek.com（总纲 §4.4 警告）；排除 + 专属 mock 测试才既零发网又有真覆盖。
#   LLM通道.light/编排.light/打分.light/行流.light 四个支撑模块选 **(a)**：纯定义
#   文件（零副作用、零网络），e2e 零环境跑它们 rc=0，天然满足「无 key 早退且不发网」。
#
# ⚠️ 并发模型边界（总纲 §4.3 契约）：评测编排全在 loop 内（asyncio 语义）；
# 不在 loop 里跑阻塞调用；重试/限速/任务池全部 await 化。
导入 os
导入 sys
导入 time
从 LLM通道 导入 LLM通道
从 编排 导入 任务池运行, 等令牌, 带重试对话
从 打分 导入 单条打分, 批量汇总
从 行流 导入 读取评测集, 取坏行
从 JSON 导入 序列化JSON, 写入JSON文件
从 文件系统 导入 写入文件

# ---- 内置确定性答案表（与 评测集.jsonl 一一对应；mock 通道消费）----
设 内置答案表 为 ["列出中国的首都": "北京", "太阳从哪边升起": "西方", "列举三种水果": "苹果、香蕉、橙子", "列举两种编程语言": "Python、Java", "给出一个邮箱地址": "user@example.com", "给出一个手机号": "12345"]

# 读环境变量（带默认值）
段落 取环境 接收 名, 默认值:
  设 值 为 os.environ.get(名, "")
  如果 值 == "":
    返回 默认值
  返回 值

# 解析逗号分隔的环境变量为提示词表（故障注入用）
段落 取提示词表 接收 名:
  设 原始 为 os.environ.get(名, "")
  设 结果 为 []
  如果 原始 == "":
    返回 结果
  设 分表 为 原始.split(",")
  遍历 项 之 分表:
    设 干净 为 项.strip()
    如果 干净 != "":
      结果.append(干净)
  返回 结果

# 单条评测（协程）：限速 → 带重试对话 → 打分 → 组装条目
# 注意：协程对象会进入 任务池运行 的列表，所以这里是 异步 段落（协程工厂）。
异步 段落 评测一条 接收 序号, 条目, 评测配置, 通道对象:
  等待 等令牌(评测配置["速率上限"])
  设 起点 为 time.time()
  设 消息 为 [["role": "user", "content": 条目["prompt"]]]
  设 结果 为 等待 带重试对话(通道对象, 消息, 评测配置["重试次数"])
  设 耗时 为 time.time() - 起点
  设 得分 为 0
  如果 结果["成功"]:
    如果 单条打分(结果["输出"], 条目["期望答案"], 条目["打分器"]):
      设 得分 为 1
  返回 ["序号": 序号, "prompt": 条目["prompt"], "期望答案": 条目["期望答案"], "打分器": 条目["打分器"], "输出": 结果["输出"], "得分": 得分, "耗时": 耗时, "尝试次数": 结果["尝试次数"], "错误": 结果["错误"]]

# 并发评测：构造协程表 → 任务池（最多 N 路并行）
异步 段落 并发评测 接收 条目表, 评测配置, 通道对象:
  设 协程表 为 []
  设 序号 为 1
  遍历 条目 之 条目表:
    协程表.append(评测一条(序号, 条目, 评测配置, 通道对象))
    设 序号 为 序号 + 1
  设 结果 为 等待 任务池运行(协程表, 评测配置["并发上限"])
  返回 结果

# 生成 Markdown 报告
段落 生成Markdown 接收 条目表, 汇总, 元信息:
  设 行表 为 []
  行表.append("# DeepSeek Harness 评测报告")
  行表.append("")
  行表.append("- 评测集：" 加上 元信息["评测集路径"])
  行表.append("- 并发上限：" 加上 转字符串(元信息["并发上限"]))
  行表.append("- 速率上限：" 加上 转字符串(元信息["速率上限"]) 加上 " 次/秒")
  行表.append("- 重试次数：" 加上 转字符串(元信息["重试次数"]))
  行表.append("- 总耗时：" 加上 转字符串(元信息["总耗时"]) 加上 " 秒")
  行表.append("- 通过率：" 加上 转字符串(汇总["通过率"]))
  行表.append("")
  行表.append("## 汇总")
  行表.append("")
  行表.append("| 指标 | 数值 |")
  行表.append("|---|---|")
  行表.append("| 总条数 | " 加上 转字符串(汇总["总条数"]) 加上 " |")
  行表.append("| 通过数 | " 加上 转字符串(汇总["通过数"]) 加上 " |")
  行表.append("| 未通过数 | " 加上 转字符串(汇总["未通过数"]) 加上 " |")
  行表.append("| 通过率 | " 加上 转字符串(汇总["通过率"]) 加上 " |")
  行表.append("")
  行表.append("## 子集统计")
  行表.append("")
  行表.append("| 打分器 | 总条数 | 通过数 | 通过率 |")
  行表.append("|---|---|---|---|")
  遍历 子集 之 汇总["子集"]:
    行表.append("| " 加上 子集["打分器"] 加上 " | " 加上 转字符串(子集["总条数"]) 加上 " | " 加上 转字符串(子集["通过数"]) 加上 " | " 加上 转字符串(子集["通过率"]) 加上 " |")
  行表.append("")
  行表.append("## 逐条明细")
  行表.append("")
  行表.append("| 序号 | prompt | 打分器 | 输出 | 期望 | 得分 | 耗时(秒) |")
  行表.append("|---|---|---|---|---|---|---|")
  遍历 条目 之 条目表:
    行表.append("| " 加上 转字符串(条目["序号"]) 加上 " | " 加上 条目["prompt"] 加上 " | " 加上 条目["打分器"] 加上 " | " 加上 条目["输出"] 加上 " | " 加上 转字符串(条目["期望答案"]) 加上 " | " 加上 转字符串(条目["得分"]) 加上 " | " 加上 转字符串(条目["耗时"]) 加上 " |")
  行表.append("")
  返回 "\n".join(行表)

# 主流程
异步 段落 主 接收:
  设 评测集路径 为 取环境("HARNESS_EVAL_SET", "examples/harness/评测集.jsonl")
  设 报告前缀 为 取环境("HARNESS_REPORT", "examples/harness/评测报告")
  设 并发上限 为 转整数(取环境("HARNESS_CONCURRENCY", "2"))
  设 速率上限 为 转整数(取环境("HARNESS_RATE", "10"))
  设 重试次数 为 转整数(取环境("HARNESS_RETRIES", "3"))
  设 延迟秒 为 转浮点(取环境("HARNESS_DELAY_SEC", "0.2"))
  如果 非 os.path.exists(评测集路径):
    打印("评测集不存在：" 加上 评测集路径)
    sys.exit(2)
  # 通道配置：确定性答案表 + 故障注入（来自环境变量，默认空）
  设 超时表 为 取提示词表("HARNESS_FAULT_TIMEOUT_PROMPTS")
  设 错误表 为 取提示词表("HARNESS_FAULT_ERROR_PROMPTS")
  设 通道 为 新建 LLM通道(["答案表": 内置答案表, "默认回答": "（未命中）", "延迟秒": 延迟秒, "故障表": ["超时": 超时表, "错误": 错误表]])
  # 加载评测集
  设 条目表 为 读取评测集(评测集路径)
  设 坏行 为 取坏行()
  如果 长度(坏行) > 0:
    打印("警告：评测集有 " 加上 转字符串(长度(坏行)) 加上 " 行解析失败（已跳过）")
  # 并发评测
  设 评测配置 为 ["并发上限": 并发上限, "速率上限": 速率上限, "重试次数": 重试次数]
  设 起点 为 time.time()
  设 结果表 为 等待 并发评测(条目表, 评测配置, 通道)
  设 总耗时 为 time.time() - 起点
  # 汇总与报告
  设 汇总 为 批量汇总(结果表)
  设 元信息 为 ["评测集路径": 评测集路径, "并发上限": 并发上限, "速率上限": 速率上限, "重试次数": 重试次数, "总耗时": 总耗时]
  设 报告体 为 ["元信息": 元信息, "条目": 结果表, "汇总": 汇总]
  # 报告父目录不存在时先建出来（mock 测试把报告指进临时目录）
  设 报告目录 为 os.path.dirname(报告前缀)
  如果 报告目录 != "":
    os.makedirs(报告目录, exist_ok=True)
  写入JSON文件(报告前缀 加上 ".json", 报告体, 真)
  设 文档 为 生成Markdown(结果表, 汇总, 元信息)
  写入文件(报告前缀 加上 ".md", 文档)
  # 控制台摘要（锚点行：e2e/mock 测试断言用）
  打印("=== harness 评测完成 ===")
  打印("总条数=" 加上 转字符串(汇总["总条数"]) 加上 " 通过=" 加上 转字符串(汇总["通过数"]) 加上 " 未通过=" 加上 转字符串(汇总["未通过数"]))
  打印("通过率=" 加上 转字符串(汇总["通过率"]))
  打印("总耗时=" 加上 转字符串(总耗时) 加上 " 秒（并发上限 " 加上 转字符串(并发上限) 加上 "）")
  打印("报告已写出：" 加上 报告前缀 加上 ".json / " 加上 报告前缀 加上 ".md")
  返回 0

异步 运行 主()
