# 段言少儿编程 - 图形绘制
# 用 ASCII 艺术画各种形状！
# 运行: duan run examples/kids/draw_shapes.duan

# =============================================
# 画三角形
# =============================================
段落 画三角形 接收 大小:
    打印 "🔺 三角形：" + 转字符串(大小) + "x" + 转字符串(大小)
    设 i 为 1
    当 i <= 大小:
        设 行 为 ""
        设 j 为 0
        当 j < 大小 - i:
            设 行 为 行 + " "
            设 j 为 j + 1
        设 k 为 0
        当 k < i * 2 - 1:
            设 行 为 行 + "*"
            设 k 为 k + 1
        打印 行
        设 i 为 i + 1
    打印 ""

# =============================================
# 画正方形
# =============================================
段落 画正方形 接收 大小:
    打印 "⬜ 正方形：" + 转字符串(大小) + "x" + 转字符串(大小)
    设 i 为 0
    当 i < 大小:
        设 行 为 ""
        设 j 为 0
        当 j < 大小:
            如果 i == 0 或 i == 大小 - 1 或 j == 0 或 j == 大小 - 1:
                设 行 为 行 + "█"
            否则:
                设 行 为 行 + " "
            设 j 为 j + 1
        打印 行
        设 i 为 i + 1
    打印 ""

# =============================================
# 画圆形（ASCII 近似）
# =============================================
段落 画圆形 接收 半径:
    打印 "⭕ 圆形（半径=" + 转字符串(半径) + "）："
    设 i 为 -半径
    当 i <= 半径:
        设 行 为 ""
        设 j 为 -半径
        当 j <= 半径:
            如果 i * i + j * j <= 半径 * 半径:
                设 行 为 行 + "██"
            否则:
                设 行 为 行 + "  "
            设 j 为 j + 1
        打印 行
        设 i 为 i + 1
    打印 ""

# =============================================
# 画菱形
# =============================================
段落 画菱形 接收 大小:
    打印 "🔷 菱形：" + 转字符串(大小)
    设 i 为 0
    当 i < 大小 * 2:
        设 行 为 ""
        设 空格数 为 大小 - i 如果 i < 大小 否则 i - 大小
        设 星数 为 i * 2 + 1 如果 i < 大小 否则 (大小 * 2 - i - 1) * 2 + 1
        
        如果 空格数 >= 0 且 星数 > 0:
            设 j 为 0
            当 j < 空格数:
                设 行 为 行 + " "
                设 j 为 j + 1
            设 k 为 0
            当 k < 星数:
                设 行 为 行 + "*"
                设 k 为 k + 1
            打印 行
        设 i 为 i + 1
    打印 ""

# =============================================
# 彩色图案（使用 ANSI 颜色代码）
# =============================================
段落 画彩虹 接收:
    打印 "🌈 彩虹图案："
    设 颜色们 为 ["\033[31m", "\033[33m", "\033[32m", "\033[34m", "\033[35m"]
    设 颜色名们 为 ["红", "橙", "绿", "蓝", "紫"]
    设 重置 为 "\033[0m"
    
    设 索引 为 0
    遍历 颜色 于 颜色们:
        设 行 为 ""
        设 j 为 0
        当 j < 10 - 索引:
            设 行 为 行 + 颜色 + "█" + 重置
            设 j 为 j + 1
        打印 颜色名们[索引] + "：" + 行
        设 索引 为 索引 + 1
    打印 ""

# =============================================
# 用循环创建图案
# =============================================
段落 画棋盘 接收 大小:
    打印 "♟️ 棋盘图案：" + 转字符串(大小) + "x" + 转字符串(大小)
    设 i 为 0
    当 i < 大小:
        设 行 为 ""
        设 j 为 0
        当 j < 大小:
            如果 (i + j) % 2 == 0:
                设 行 为 行 + "■"
            否则:
                设 行 为 行 + "□"
            设 j 为 j + 1
        打印 行
        设 i 为 i + 1
    打印 ""

段落 画波浪 接收 长度, 高度:
    打印 "🌊 波浪图案："
    设 i 为 0
    当 i < 高度:
        设 行 为 ""
        设 j 为 0
        当 j < 长度:
            设 位置 为 (j + i) % (高度 * 2)
            如果 位置 < 高度 - i:
                设 行 为 行 + " "
            否则若 位置 < 高度 * 2 - i:
                设 行 为 行 + "~"
            否则:
                设 行 为 行 + " "
            设 j 为 j + 1
        打印 行
        设 i 为 i + 1
    打印 ""

# =============================================
# 动画效果
# =============================================
段落 旋转动画 接收 次数:
    打印 "🌀 旋转动画（" + 转字符串(次数) + " 帧）："
    设 帧们 为 ["|", "/", "-", "\\"]
    设 i 为 0
    当 i < 次数:
        设 帧索引 为 i % 4
        打印 "\r  旋转中 " + 帧们[帧索引] + "  " + 转字符串(i + 1) + "/" + 转字符串(次数)
        设 i 为 i + 1
    打印 "\r  旋转完成！            "
    打印 ""

# =============================================
# 主程序 - 绘制所有形状
# =============================================
段落 主程序 接收:
    打印 "╔══════════════════════════════════════╗"
    打印 "║     🎨 段言图形绘制乐园 🎨          ║"
    打印 "║     用代码画出各种形状！             ║"
    打印 "╚══════════════════════════════════════╝"
    打印 ""
    
    画三角形(5)
    画正方形(6)
    画菱形(4)
    画圆形(5)
    画棋盘(8)
    画彩虹()
    画波浪(20, 4)
    旋转动画(8)
    
    打印 "📝 试试修改这些数字，看看形状会怎么变化！"
    打印 "💡 提示：画三角形(5) → 画三角形(10) 会变大"
    打印 ""

# 运行主程序
主程序()