# 段言 - 文件整理器 CLI 工具
# 按文件扩展名自动分类整理文件到对应文件夹
# 用法: duan run examples/cli_tool/file_organizer.duan [目录] [选项]
# 示例: duan run examples/cli_tool/file_organizer.duan ./ --dry-run

导入 文件系统。
导入 JSON。

# ===== 配置 =====

# 默认分类规则
设 默认规则 为 {
  "Images": {
    "extensions": [".jpg", ".jpeg", ".png", ".gif", ".bmp", ".svg", ".webp", ".ico", ".tiff", ".psd"],
    "description": "图片文件"
  },
  "Documents": {
    "extensions": [".pdf", ".doc", ".docx", ".xls", ".xlsx", ".ppt", ".pptx", ".txt", ".md", ".csv", ".json", ".xml", ".yaml", ".yml"],
    "description": "文档文件"
  },
  "Archives": {
    "extensions": [".zip", ".rar", ".tar", ".gz", ".7z", ".bz2", ".xz", ".tgz"],
    "description": "压缩包文件"
  },
  "Audio": {
    "extensions": [".mp3", ".wav", ".flac", ".aac", ".ogg", ".wma", ".m4a"],
    "description": "音频文件"
  },
  "Video": {
    "extensions": [".mp4", ".avi", ".mkv", ".mov", ".wmv", ".flv", ".webm", ".m4v"],
    "description": "视频文件"
  },
  "Code": {
    "extensions": [".py", ".js", ".ts", ".java", ".c", ".cpp", ".h", ".hpp", ".go", ".rs", ".rb", ".php", ".swift", ".kt", ".scala", ".duan"],
    "description": "代码文件"
  },
  "Executables": {
    "extensions": [".exe", ".msi", ".bat", ".sh", ".cmd", ".app", ".dmg", ".dll", ".so", ".dylib"],
    "description": "可执行文件"
  }
}。

设 默认配置目录 为 "organizer_config.json"。

# ===== 全局状态 =====
设 统计信息 为 {
  "总文件数": 0,
  "已移动文件": 0,
  "已跳过文件": 0,
  "错误数": 0,
  "分类统计": {}
}。

# ===== 配置管理 =====

# 加载配置规则
段落 加载规则 接收 配置路径:
  如果 配置路径 不等于 空 且 文件存在(配置路径):
    尝试:
      设 内容 为 读取文件(配置路径)。
      设 规则 为 解析JSON(内容)。
      打印("已加载自定义规则: " + 配置路径)。
      返回 规则。
    捕获 错误 为 e:
      打印("警告: 配置文件解析失败，使用默认规则 - " + 转字符串(e))。

  打印("使用默认分类规则")。
  返回 默认规则。

# 保存默认配置到文件
段落 保存配置示例 接收 文件路径:
  如果 文件存在(文件路径):
    返回。

  设 示例配置 为 序列化JSON(默认规则, 2)。
  写入文件(文件路径, 示例配置)。
  打印("已生成配置示例: " + 文件路径 + " (可编辑此文件自定义规则)")。

# ===== 文件操作 =====

# 获取文件扩展名
段落 获取扩展名 接收 文件名:
  设 点位置 为 最后索引(文件名, ".")。
  如果 点位置 等于 -1:
    返回 ""。
  返回 转小写(字符串获取(文件名, 点位置))。

# 判断文件是否应被忽略
段落 应忽略 接收 文件名:
  设 忽略列表 为 [".", "organizer_config.json", "desktop.ini", "thumbs.db", ".ds_store", ".gitkeep", ".gitignore"]。

  遍历 忽略项 于 忽略列表:
    如果 开头(文件名, 忽略项):
      返回 真。

  返回 假。

# 查找文件归属的分类
段落 查找分类 接收 扩展名, 规则:
  如果 扩展名 等于 "":
    返回 "Other"。

  遍历 分类名 于 规则:
    设 分类 为 规则[分类名]。
    设 扩展名列表 为 分类["extensions"]。
    遍历 允许扩展名 于 扩展名列表:
      如果 允许扩展名 等于 扩展名:
        返回 分类名。

  返回 "Other"。

# 扫描目录中的文件
段落 扫描目录 接收 目录路径:
  如果 非 目录存在(目录路径):
    打印("错误: 目录不存在 - " + 目录路径)。
    返回 []。

  设 文件列表 为 列出文件(目录路径)。
  设 结果 为 []。

  遍历 文件名 于 文件列表:
    如果 应忽略(文件名):
      跳过。

    设 完整路径 为 目录路径 + "/" + 文件名。
    如果 是文件(完整路径):
      设 扩展名 为 获取扩展名(文件名)。
      列表追加(结果, {
        "name": 文件名,
        "path": 完整路径,
        "extension": 扩展名,
        "size": 文件大小(完整路径)
      })。

  返回 结果。

# 确保目标目录存在
段落 确保目录 接收 目录路径:
  如果 非 目录存在(目录路径):
    创建目录(目录路径)。
    返回 假。
  返回 真。

# 移动文件
段落 移动文件 接收 源路径, 目标路径, 是预览:
  如果 是预览:
    打印("  [预览] 将移动: " + 源路径 + " -> " + 目标路径)。
    返回 真。

  尝试:
    如果 文件存在(目标路径):
      打印("  [跳过] 目标文件已存在: " + 目标路径)。
      统计信息["已跳过文件"] 为 统计信息["已跳过文件"] + 1。
      返回 假。

    移动文件系统(源路径, 目标路径)。
    打印("  [已移动] " + 目标路径)。
    统计信息["已移动文件"] 为 统计信息["已移动文件"] + 1。
    返回 真。

  捕获 错误 为 e:
    打印("  [错误] 移动失败: " + 转字符串(e))。
    统计信息["错误数"] 为 统计信息["错误数"] + 1。
    返回 假。

# ===== 进度显示 =====

# 显示进度条
段落 显示进度 接收 当前, 总数:
  如果 总数 等于 0:
    返回。

  设 百分比 为 (当前 * 100) / 总数。
  设 进度条长度 为 30。
  设 已完成长度 为 (当前 * 进度条长度) / 总数。

  设 进度条 为 "["。
  设 i 为 0。
  当 i 小于 进度条长度:
    如果 i 小于 已完成长度:
      进度条 为 进度条 + "="。
    否则若 i 等于 已完成长度:
      进度条 为 进度条 + ">"。
    否则:
      进度条 为 进度条 + " "。
    i 为 i + 1。
  进度条 为 进度条 + "]"。

  打印("\r  进度: " + 进度条 + " " + 转字符串(百分比) + "% (" + 转字符串(当前) + "/" + 转字符串(总数) + ")")。

# ===== 分类执行 =====

# 按规则整理文件
段落 整理文件 接收 文件列表, 规则, 目标根目录, 是预览:
  如果 列表长度(文件列表) 等于 0:
    打印("  没有需要整理的文件")。
    返回。

  设 总数 为 列表长度(文件列表)。
  统计信息["总文件数"] 为 总数。

  打印("开始整理 " + 转字符串(总数) + " 个文件...")。
  如果 是预览:
    打印("（预览模式 - 不会实际移动文件）")。

  # 首次遍历:按分类分组
  设 分类映射 为 {}。
  遍历 文件 于 文件列表:
    设 分类名 为 查找分类(文件["extension"], 规则)。
    如果 字典包含键(分类映射, 分类名) 等于 假:
      字典设置(分类映射, 分类名, [])。
      如果 字典包含键(统计信息["分类统计"], 分类名) 等于 假:
        统计信息["分类统计"][分类名] 为 0。

    列表追加(分类映射[分类名], 文件)。
    统计信息["分类统计"][分类名] 为 统计信息["分类统计"][分类名] + 1。

  # 显示分类统计
  打印("\n文件分类统计:")。
  遍历 分类名 于 分类映射:
    设 分类文件 为 分类映射[分类名]。
    如果 分类名 等于 "Other":
      打印("  📁 其他: " + 转字符串(列表长度(分类文件)) + " 个文件")。
    否则若 分类名 等于 "Images":
      打印("  🖼 " + 分类名 + ": " + 转字符串(列表长度(分类文件)) + " 个文件")。
    否则若 分类名 等于 "Documents":
      打印("  📄 " + 分类名 + ": " + 转字符串(列表长度(分类文件)) + " 个文件")。
    否则若 分类名 等于 "Archives":
      打印("  📦 " + 分类名 + ": " + 转字符串(列表长度(分类文件)) + " 个文件")。
    否则若 分类名 等于 "Audio":
      打印("  🎵 " + 分类名 + ": " + 转字符串(列表长度(分类文件)) + " 个文件")。
    否则若 分类名 等于 "Video":
      打印("  🎬 " + 分类名 + ": " + 转字符串(列表长度(分类文件)) + " 个文件")。
    否则若 分类名 等于 "Code":
      打印("  💻 " + 分类名 + ": " + 转字符串(列表长度(分类文件)) + " 个文件")。
    否则若 分类名 等于 "Executables":
      打印("  ⚙ " + 分类名 + ": " + 转字符串(列表长度(分类文件)) + " 个文件")。
    否则:
      打印("  📁 " + 分类名 + ": " + 转字符串(列表长度(分类文件)) + " 个文件")。

  # 第二次遍历:执行移动
  打印("\n开始移动文件...")。
  设 已处理 为 0。

  遍历 分类名 于 分类映射:
    设 分类文件列表 为 分类映射[分类名]。
    设 目标目录 为 目标根目录 + "/" + 分类名。

    确保目录(目标目录)。

    遍历 文件 于 分类文件列表:
      设 目标路径 为 目标目录 + "/" + 文件["name"]。
      移动文件(文件["path"], 目标路径, 是预览)。
      已处理 为 已处理 + 1。
      显示进度(已处理, 总数)。

  打印("")。

# 显示汇总信息
段落 显示汇总 接收 目录路径, 是预览, 耗时:
  打印("\n" + "=" * 50)。
  打印("  整理完成汇总")。
  打印("=" * 50)。
  打印("扫描目录: " + 目录路径)。
  打印("操作模式: " + ("预览模式" 如果 是预览 否则 "实际执行"))。
  打印("消耗时间: " + 转字符串(耗时) + " 秒")。
  打印("-" * 50)。
  打印("总文件数: " + 转字符串(统计信息["总文件数"]))。
  打印("已移动文件: " + 转字符串(统计信息["已移动文件"]))。
  打印("已跳过文件: " + 转字符串(统计信息["已跳过文件"]))。
  打印("错误数: " + 转字符串(统计信息["错误数"]))。

  如果 统计信息["总文件数"] 大于 0 且 非 是预览:
    设 成功率 为 (统计信息["已移动文件"] * 100) / 统计信息["总文件数"]。
    打印("成功率: " + 转字符串(成功率) + "%")。

  打印("-" * 50)。
  打印("分类统计:")。
  遍历 分类名 于 统计信息["分类统计"]:
    设 文件数 为 统计信息["分类统计"][分类名]。
    如果 文件数 大于 0:
      打印("  " + 分类名 + ": " + 转字符串(文件数) + " 个文件")。

  打印("=" * 50)。

# ===== 命令行参数解析 =====

段落 解析参数 接收 参数列表:
  # 安全默认：不带参数运行时只做预览，绝不真的搬动文件。
  # （此前默认是"实际执行 + 当前目录"，直接 duan run 就会就地整理仓库。）
  # 必须显式传 --execute / -x 才会落盘。
  设 结果 为 {
    "directory": ".",
    "dry_run": 真,
    "config": 空,
    "output": 空,
    "help": 假
  }。

  设 长度 为 列表长度(参数列表)。
  设 i 为 1。

  当 i 小于 长度:
    设 参数 为 参数列表[i]。

    如果 参数 等于 "--help" 或 参数 等于 "-h":
      结果["help"] 为 真。
      返回 结果。

    否则若 参数 等于 "--dry-run" 或 参数 等于 "-n":
      结果["dry_run"] 为 真。

    否则若 参数 等于 "--execute" 或 参数 等于 "-x":
      结果["dry_run"] 为 假。

    否则若 参数 等于 "--config" 或 参数 等于 "-c":
      如果 i + 1 小于 长度:
        结果["config"] 为 参数列表[i + 1]。
        i 为 i + 1。
      否则:
        打印("错误: --config 需要指定配置文件路径")。

    否则若 参数 等于 "--output" 或 参数 等于 "-o":
      如果 i + 1 小于 长度:
        结果["output"] 为 参数列表[i + 1]。
        i 为 i + 1。
      否则:
        打印("错误: --output 需要指定输出目录")。

    否则若 开头(参数, "-"):
      打印("未知选项: " + 参数)。

    否则:
      结果["directory"] 为 参数。

    i 为 i + 1。

  返回 结果。

# 显示帮助信息
段落 显示帮助:
  打印("")。
  打印("段言文件整理器 - 按类型自动分类整理文件")。
  打印("")。
  打印("用法:")。
  打印("  duan run examples/cli_tool/file_organizer.duan [目录] [选项]")。
  打印("")。
  打印("参数:")。
  打印("  目录       要整理的目录路径（默认: 当前目录）")。
  打印("")。
  打印("选项:")。
  打印("  -n, --dry-run     预览模式，不实际移动文件（默认）")。
  打印("  -x, --execute     真正执行移动（不加此项只预览）")。
  打印("  -c, --config <文件>  指定自定义规则配置文件")。
  打印("  -o, --output <目录>  指定输出目录（默认: 当前目录）")。
  打印("  -h, --help         显示此帮助信息")。
  打印("")。
  打印("示例:")。
  打印("  duan run examples/cli_tool/file_organizer.duan                        # 预览当前目录（不会改动）")。
  打印("  duan run examples/cli_tool/file_organizer.duan ./下载 -x               # 真正整理下载目录")。
  打印("  duan run examples/cli_tool/file_organizer.duan ./桌面 -c my_rules.json # 使用自定义规则")。
  打印("  duan run examples/cli_tool/file_organizer.duan ./文档 -o ./整理后       # 输出到指定目录")。
  打印("")。
  打印("分类规则:")。
  打印("  Images/       .jpg .jpeg .png .gif .bmp .svg .webp 等")。
  打印("  Documents/   .pdf .doc .docx .xls .xlsx .txt .md 等")。
  打印("  Archives/    .zip .rar .tar .gz .7z .bz2 等")。
  打印("  Audio/       .mp3 .wav .flac .aac .ogg 等")。
  打印("  Video/       .mp4 .avi .mkv .mov .wmv .webm 等")。
  打印("  Code/        .py .js .ts .java .c .cpp .go .rs .duan 等")。
  打印("  Executables/ .exe .msi .bat .sh .app .dll 等")。
  打印("  Other/       其他未分类文件")。
  打印("")。
  打印("提示: 首次运行会自动生成 organizer_config.json 配置文件，可自定义规则。")。
  打印("")。

# ===== 主程序 =====

段落 主程序:
  导入 sys。

  设 参数 为 sys.argv。
  设 选项 为 解析参数(参数)。

  如果 选项["help"]:
    显示帮助()。
    返回。

  设 目录路径 为 选项["directory"]。
  如果 非 目录存在(目录路径):
    打印("错误: 目录不存在 - " + 目录路径)。
    返回。

  设 是预览 为 选项["dry_run"]。
  设 配置文件 为 选项["config"]。

  # 确定输出目录
  设 输出目录 为 目录路径。
  如果 选项["output"] 不等于 空:
    输出目录 为 选项["output"]。

  # 打印起始信息
  打印("=" * 50)。
  打印("  段言文件整理器 v1.0")。
  打印("=" * 50)。
  打印("扫描目录: " + 目录路径)。
  打印("输出目录: " + 输出目录)。
  打印("操作模式: " + ("预览模式" 如果 是预览 否则 "实际执行"))。
  如果 配置文件 不等于 空:
    打印("自定义规则: " + 配置文件)。
  打印("=" * 50)。
  打印("")。

  # 加载规则
  设 规则 为 加载规则(配置文件)。

  # 生成配置示例（如果不存在）
  保存配置示例(默认配置目录)。

  # 记录开始时间
  设 开始时间 为 时间戳()。

  # 扫描目录
  打印("正在扫描目录...")。
  设 文件列表 为 扫描目录(目录路径)。
  打印("发现 " + 转字符串(列表长度(文件列表)) + " 个文件")。

  # 执行整理
  整理文件(文件列表, 规则, 输出目录, 是预览)。

  # 计算耗时
  设 结束时间 为 时间戳()。
  设 耗时 为 结束时间 - 开始时间。

  # 显示汇总
  显示汇总(目录路径, 是预览, 耗时)。

  打印("\n文件整理完成！")。

主程序()。