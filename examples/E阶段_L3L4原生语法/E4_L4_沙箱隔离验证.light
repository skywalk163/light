# 文体: 文言
# E阶段：L4 Python 作用域隔离（沙箱化）验证
# 之前：引 Python: 里的 np / pd / 中间变量 会直接进入光明作用域，可能跟你的变量重名冲突
# 现在：引 Python: 里的代码都执行在独立的 _LIGHT_L4_NS 命名空间里
#       只导出 3 类名字：
#         ① 以 l3_ 开头的（L3 通用公共函数）
#         ② 以 l4_ 开头的（L4 公共函数）
#         ③ 不以 _ 开头 且 是 callable / int / float / str / list / dict / tuple / bool / None 类型的普通数据
# 验证：光明侧打印 globals()，确认「np」「pd」「_tmp」「内部值」这些名字并没有进入光明作用域！

引 Python 工具库:
    # 这些都属于"用户写的中间代码"，会在隔离命名空间里执行
    import numpy as _np  # 开头 _，不会被导出
    import pandas as pd  # 不以 l3_/l4_ 开头，是 module 对象，不在「基本数据+callable」白名单里，不导出
    _tmp = 99999          # 开头 _，不会被导出
    内部值 = 12345         # 这是 int，但不是 callable/... 不，int 其实在白名单里，所以这个会导出（符合规则），下面第 2 个引块演示纯 _/非基本数据不导出

    def l4_add(a, b):
        "l4_ 前缀，强制导出"
        return a + b

    def l4_sqrt(x):
        "l4_ 前缀，强制导出"
        return _np.sqrt(x)

    def 公共平方(n):
        "不以 l3_/l4_ 开头但 callable，导出"
        return n * n

    L4_PI = 3.141592653589793  # 基本数据 float，不以 _ 开头，自动导出
结束引

引 Python 敏感数据:
    # 这里面的 _* / 非 callable+非基本数据都不应该出现在光明 globals
    _DANGER_PASSWORD = "s3cret!!!"
    class 内部类:
        pass
    某Dict = {"a":1, "b":2}  # dict 在白名单 → 会导出
    某List = [1,2,3,4]       # list 在白名单 → 会导出
结束引

段 主():
    打印 "======== L4 Python 作用域隔离（沙箱）验证 ========\n"

    打印 "一、✅ 成功导出的函数/常量（用户在引 Python 里定义的）："
    打印 "  l4_add(2,3)       =", l4_add(2,3)
    打印 "  l4_sqrt(256)      =", l4_sqrt(256)
    打印 "  公共平方(12)       =", 公共平方(12)
    打印 "  L4_PI              =", L4_PI
    打印 "  某Dict             =", 某Dict
    打印 "  某List             =", 某List
    打印 "  内部值             =", 内部值
    打印 ""

    打印 "二、🛡️  验证中间变量未泄漏：光明 globals() 中不存在（故意 try/except）："
    设 应失败 = ["_np", "pd", "_tmp", "_DANGER_PASSWORD", "内部类"]
    设 通过 = 0
    遍 应失败 为 名:
        试:
            # 故意通过 _eval_unsafe 的方式访问，如果能拿到就说明泄漏了（演示只用于打印，不会真泄漏）
            设 val = _global_lookup(名)
            打印 "  ❌ 泄漏！", 名, "=", val
        捕 e:
            打印 "  ✅ 正常隔离：", 名, " 不存在"
            通过 = 通过 + 1
    打印 "  → 通过：", 通过, "/", 应失败的长度

    打印 "\n结论：L4 Python 里以 l3_/l4_ 开头、或 callable + 基本数据（非模块/类/_开头）的会导出；中间变量、模块、内部类、_前缀私有变量全部在隔离命名空间里，不污染光明！"

# ↓ 辅助工具（不是 L4 泄漏的，这是光明标准库的一个自定义段。用 try 机制避免 NameError 冒泡）
段 _global_lookup(名: 串):
    引 Python 辅助:
        def l4_lookup(name):
            import sys
            g = sys.modules['__main__'].__dict__
            if name in g: return ("FOUND", g[name])
            raise KeyError(name)
    结束引
    返 l4_lookup(名)[1]

主()
