# 文体: 文言
# E阶段：L3 公式/数学 原生语法 Hello World
# 写法：引 公式 名: 一行一个公式（支持 #注释，末尾句号/感叹号可省）
# 支持 5 种形式（光明侧自动生成 l3_math_* 函数）：
#   形式1：解 2x^2+5x-3=0            → 解代数方程（返回解列表/字典）
#   形式2：d/dx (x**3 + 2*x**2)      → 求导（返回字符串表达式）
#   形式3：积分 sin(x) 从 0 到 3.14159  或  ∫(0→3.14159) sin(x) dx → 定积分（返回数值）
#   形式4：矩阵乘 [[1,2],[3,4]] * [[5,6],[7,8]] → 矩阵乘法（返回 list[list]）
#   形式5：其他 → 代数化简（返回字符串化简结果）

引 公式 例1:
    # 形式1：解方程
    解 2x^2+5x-3=0

    # 形式2：求导
    d/dx (x**3 + 2*x**2 - 5*x + 7)

    # 形式3：积分（中文写法）
    积分 sin(x) 从 0 到 3.141592653589793

    # 形式4：矩阵乘法
    矩阵乘 [[1,2],[3,4]] * [[5,6],[7,8]]

    # 形式5：化简
    (x+1)*(x-1) + (x-2)**2
结束引

段 主():
    打印 "======== L3 公式/数学 原生语法 ========"

    打印 "\n--- 形式1：解方程 2x^2+5x-3=0 ---"
    试:
        设 解 = l3_math_solve_例1_2()
        打印 "解列表 → ", 解
    捕 e:
        打印 "sympy 未装？→ ", e

    打印 "\n--- 形式2：求导 d/dx(x^3+2x^2-5x+7) ---"
    试:
        打印 l3_math_diff_例1_x_5()
    捕 e:
        打印 "sympy 未装？→ ", e

    打印 "\n--- 形式3：∫₀^π sin(x) dx  （答案=2.0 正好）---"
    试:
        打印 l3_math_int_例1_x_8()
    捕 e:
        打印 "sympy 未装？→ ", e

    打印 "\n--- 形式4：[[1,2],[3,4]] * [[5,6],[7,8]] ---"
    试:
        设 结果 = l3_math_mat_例1_11()
        遍 结果 为 行:
            打印 "  ", 行
    捕 e:
        打印 "sympy 未装？→ ", e

    打印 "\n--- 形式5：化简 (x+1)(x-1)+(x-2)^2 ---"
    试:
        打印 l3_math_simp_例1_14()
    捕 e:
        打印 "sympy 未装？→ ", e

主()
