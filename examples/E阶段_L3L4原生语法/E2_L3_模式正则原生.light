# 文体: 文言
# E阶段：L3 模式/正则 原生语法 Hello World
# 写法：引 模式 模式名: 第一行写正则（命名捕获组），其他行 #注释说明
# 光明侧自动获得：模式名 类，三个中文类方法
#   模式名.匹配(文本) → 全串匹配 fullmatch
#   模式名.搜索(文本) → 第一个匹配 search
#   模式名.查找全部(文本) → 所有匹配 finditer → list
# 返回对象：obj.hit（bool）、obj.年/月/日...（按命名组直接点成员访问）、bool(obj)、printable

引 模式 日期:
    # 命名捕获组：年、月、日
    (?P<年>\d{4})-(?P<月>\d{2})-(?P<日>\d{2})
结束引

引 模式 中文名:
    # 中文姓名：2~6 个汉字
    (?P<姓>[\u4e00-\u9fa5]{1,2})(?P<名>[\u4e00-\u9fa5]{1,6})
结束引

段 主():
    打印 "======== L3 模式/正则 原生语法（命名组 → 点成员访问） ========"

    打印 "\n--- 日期模式：.匹配() ---"
    设 d = 日期.匹配("2026-08-04")
    若 d:
        打印 "命中！d.年=", d.年, "  d.月=", d.月, "  d.日=", d.日
        打印 "直接 print 对象 → ", d
    否:
        打印 "未命中"

    打印 "\n--- 日期模式：.搜索() （从长文本里扒一个日期出来）---"
    设 txt = "提交日期：2026-08-04 截止日期：2026-12-31"
    设 first = 日期.搜索(txt)
    打印 "第一个日期 → 年=", first.年, " 月=", first.月, " 日=", first.日

    打印 "\n--- 日期模式：.查找全部() ---"
    设 all = 日期.查找全部(txt)
    遍 all 为 x:
        打印 "  找到一个:", x

    打印 "\n--- 中文名模式 ---"
    设 n = 中文名.匹配("张三丰")
    若 n:
        打印 "n.姓=", n.姓, "  n.名=", n.名
        打印 "完整对象 →", n

主()
