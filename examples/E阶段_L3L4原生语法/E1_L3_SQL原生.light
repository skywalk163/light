# 文体: 文言
# E阶段：L3 SQL 原生语法 Hello World
# 写法：引 SQL 库标签: 然后里面写 SQL（CREATE/INSERT/SELECT 等，支持 -- 注释、;分语句）
# 光明侧自动获得：l3_sql_{标签}_e{序号}  —— DDL/DML 返回影响行数
#                 l3_sql_{标签}_q{序号}  —— 查询类返回 list[dict]

引 SQL 成绩:
    CREATE TABLE students (
        id    INTEGER PRIMARY KEY AUTOINCREMENT,
        name  TEXT    NOT NULL,
        age   INTEGER,
        score REAL
    );

    INSERT INTO students(name, age, score) VALUES (?, ?, ?);
    INSERT INTO students(name, age, score) VALUES (?, ?, ?);
    INSERT INTO students(name, age, score) VALUES (?, ?, ?);

    -- 下面这条 q3 查询：分数>? 的学生（用 ? 占位，天然防注入！）
    SELECT name, age, score FROM students WHERE score > ? ORDER BY score DESC;

    SELECT AVG(score) AS avg, MAX(score) AS mx, MIN(score) AS mn, COUNT(*) AS n FROM students;
结束引

段 主():
    打印 "======== L3 SQL 原生语法（自动参数化，防注入） ========"
    打印 ""

    # 3 条 DDL/DML：e0建表 / e1插入1 / e2插入2 / e3插入3
    设 r0 = l3_sql_成绩_e0()
    打印 "建表：返回影响行（CREATE TABLE 常为 -1）=", r0

    设 r1 = l3_sql_成绩_e1(["张三", 22, 88.5])
    设 r2 = l3_sql_成绩_e2(["李四", 25, 92.0])
    设 r3 = l3_sql_成绩_e3(["王五", 31, 76.3])
    打印 "3 条 INSERT 各返回 1 条（真的话=全成功）:", r1, r2, r3

    打印 ""
    打印 "--- 查询 q4: 分数 > 85 分的学生（参数化查！）---"
    设 好成绩 = l3_sql_成绩_q4([85])
    遍 好成绩 为 行:
        打印 "  ", 行

    打印 ""
    打印 "--- 查询 q5: 聚合 AVG/MAX/MIN/COUNT ---"
    设 统计 = l3_sql_成绩_q5()
    设 s = 统计[0]
    打印 "  共 ", s["n"], " 人, 平均分=", s["avg"], " 最高=", s["mx"], " 最低=", s["mn"]

主()
