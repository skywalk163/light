# 文体: 白话
# 第 8 课：函数（段）——把常用的小工具打包起来
# 目标：定义「段」（函数）+ 传参数 + 返回值

打印 "======== 小工具1：求圆的面积 ========"
# 定义：段 名字(参数列表)
段 圆面积(半径):
    设 圆周率 = 3.14159
    返 圆周率 * 半径 * 半径   # 「返」= 返回结果

打印 "半径 = 3 的圆面积：", 圆面积(3)
打印 "半径 = 5 的圆面积：", 圆面积(5)
打印 "半径 = 10 的圆面积：", 圆面积(10)

打印 ""
打印 "======== 小工具2：判断某一年是不是闰年 ========"
段 是闰年(年):
    # 闰年规则：能被4整除但不能被100整除，或者能被400整除
    若 (年 % 4 == 0 且 年 % 100 != 0) 或 (年 % 400 == 0):
        返 真
    返 假

设 年份列表 = [2000, 2020, 2023, 2024, 1900, 2100]
遍 年份列表 为 y:
    若 是闰年(y):
        打印 y, " → 是闰年 ✓ 2月有29天"
    否:
        打印 y, " → 不是闰年 ✗ 2月有28天"

打印 ""
打印 "======== 小工具3：打印一条漂亮的分隔线 ========"
段 分隔线(标题 = "分隔线"):   # 带默认值
    设 线 = "=============================="
    打印 线, " ", 标题, " ", 线

分隔线("程序开始")
打印 "这里是中间的内容"
分隔线("程序结束")
