# 文体: 白话
# 第 3 课：如果和否则——让电脑自己做判断
# 目标：掌握「若」「否」+ 因果链语法

打印 "======== 判断奇偶数 ========"
设 数 = 17
若 数 % 2 == 0:
    打印 数, " 是 偶数。"
否:
    打印 数, " 是 奇数。"

打印 ""
打印 "======== 成绩等级 ========"
设 分数 = 86
若 分数 >= 90:
    打印 "你的分数 ", 分数, " → 等级 A（太棒了！）"
否:
    若 分数 >= 80:
        打印 "你的分数 ", 分数, " → 等级 B（很不错！）"
    否:
        若 分数 >= 60:
            打印 "你的分数 ", 分数, " → 等级 C（及格了，继续加油）"
        否:
            打印 "你的分数 ", 分数, " → 等级 D（要加油哦！）"

打印 ""
打印 "======== 因果链语法（可以不用缩进行，像说话一样写） ========"
设 温度 = 33
温度大于30, 打印 "今天好热！记得开空调。"
温度小于10, 打印 "今天好冷！多穿一件。"
温度在10到30之间, 打印 "今天气温刚刚好。"
