# 文体: 白话
# 第 10 课：引 Python 画一个小笑脸（炫技！）
# 目标：用「引 Python:」调用 Python 的 turtle 库，画完点击窗口关闭即可
# 依赖：turtle 是 Python 标准库，通常自带。如果没有窗口则会跳过。

打印 "准备画笑脸啦，请稍等……"
打印 "（会弹出一个小窗口，画完之后点窗口 × 关闭即可继续）"
打印 "如果在无图形界面的电脑上运行，这一步会被跳过，不会崩溃。"

引 Python:
    def l1_画笑脸():
        try:
            import turtle
            t = turtle.Turtle()
            s = turtle.Screen()
            s.title("光明 L1 第10课：画笑脸")
            s.setup(500, 500)
            t.speed(3)

            # 脸（黄色圆）
            t.penup(); t.goto(0, -150); t.pendown()
            t.color("#f1c40f"); t.begin_fill(); t.circle(150); t.end_fill()

            # 左眼
            t.penup(); t.goto(-50, 40); t.pendown()
            t.color("#2c3e50"); t.begin_fill(); t.circle(20); t.end_fill()

            # 右眼
            t.penup(); t.goto(50, 40); t.pendown()
            t.begin_fill(); t.circle(20); t.end_fill()

            # 嘴（微笑弧线）
            t.penup(); t.goto(-80, -30); t.pendown()
            t.pensize(8); t.color("#c0392b")
            t.setheading(-30); t.circle(90, 240)

            t.hideturtle()
            s.title("光明 L1 第10课：画笑脸（点击窗口关闭）")
            try:
                s.exitonclick()
            except Exception:
                pass
            return "笑脸画完啦！"
        except Exception as e:
            return "画图跳过（可能没有图形界面）：" + str(e)
结束引

设 结果 = l1_画笑脸()
打印 结果
打印 ""
打印 "🎉 L1 入门 10 课全部完成！你已经入门啦！"
打印 "接下来可以挑战 L2 文言体，学习类型、类、模块、大项目开发！"
