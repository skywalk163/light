# 文体: 白话
# 第 7 课：字典（典）——每个东西都有自己的名字和标签
# 目标：创建/按键取值/修改/添加/遍历键值对

打印 "======== 学生信息卡片 ========"
设 小明 = {
    "姓名": "王小明",
    "年龄": 12,
    "年级": 6,
    "爱好": ["看书", "踢足球", "编程"]
}
打印 小明
打印 "姓名：", 小明["姓名"]
打印 "年龄：", 小明["年龄"]

打印 ""
打印 "======== 修改和添加字段 ========"
小明["年龄"] = 13
小明["身高厘米"] = 156
打印 "更新后的小明信息卡："
遍 小明 的键 为 k:
    打印 "  ", k, " → ", 小明[k]

打印 ""
打印 "======== 同时遍历 键 和 值 ========"
设 成绩 = {"语文": 88, "数学": 92, "英语": 85, "科学": 90}
打印 "期末成绩单："
遍 成绩 的项 为 项:
    打印 "  科目:", 项[0], " → 分数:", 项[1]
设 总分 = 0
遍 成绩 的值 为 分:
    总分 = 总分 + 分
打印 "总分：", 总分
打印 "平均分：", 总分 / 成绩的长度
