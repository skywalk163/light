# 文体: 白话
# 第 2 课：做一台计算器——算术运算
# 目标：掌握加减乘除 + 温度转换应用题

打印 "======== 小计算器登场 ========"

设 甲 = 15
设 乙 = 4
打印 "甲=15, 乙=4"
打印 "甲 + 乙 = ", 甲 + 乙
打印 "甲 - 乙 = ", 甲 - 乙
打印 "甲 × 乙 = ", 甲 * 乙
打印 "甲 ÷ 乙 = ", 甲 / 乙
打印 "甲 模 乙 = ", 甲 % 乙, "  （也就是余数）"
打印 "甲 的 乙 次方 = ", 甲 ** 乙
打印 ""

打印 "======== 应用题：华氏度转摄氏度 ========"
# 公式: C = (F - 32) * 5/9
设 华氏 = 98.6  # 人的体温
设 摄氏 = (华氏 - 32) * 5 / 9
打印 "华氏 ", 华氏, " 度 = 摄氏 ", 摄氏, " 度"

设 华氏2 = 32
打印 "华氏 32 度（冰点） = 摄氏 ", (华氏2 - 32) * 5 / 9, " 度"
