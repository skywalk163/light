# 文体: 白话
# 第 6 课：列表（列）——把很多东西放在一个篮子里
# 目标：掌握创建/添加/删除/按下标/长度/排序/反转

打印 "======== 创建列表并查看 ========"
设 宠物 = ["小猫", "小狗", "小兔子"]
打印 "我的宠物：", 宠物
打印 "第 1 只宠物（注意：第0个就是小猫哦）：", 宠物[0]
打印 "第 2 只：", 宠物[1]
打印 "最后 1 只：", 宠物[宠物的长度 - 1]
打印 "一共有多少只宠物？", 宠物的长度

打印 ""
打印 "======== 添加新宠物 ========"
宠物的 添加 "小仓鼠"
宠物的 添加 "小金鱼"
打印 "新宠物列表：", 宠物

打印 ""
打印 "======== 排序和反转 ========"
设 数 = [9, 2, 7, 1, 5, 3]
打印 "原数：", 数
数的 排序
打印 "排序后：", 数
数的 反转
打印 "再反转：", 数

打印 ""
打印 "======== 删除元素 ========"
设 食物 = ["汉堡", "薯条", "可乐", "炸鸡", "沙拉"]
打印 "我爱吃的：", 食物
食物的 删除 "可乐"
打印 "把可乐去掉（少糖更健康）：", 食物
设 最后一个 = 食物的 弹出
打印 "把最后一个 「", 最后一个, "」 先拿走，剩下：", 食物
