# 文体: 白话
# 第 5 课：遍循环——把列表里的东西一个一个拿出来
# 目标：掌握「遍 列表 为 元素」、带索引的遍历

打印 "======== 遍历水果篮 ========"
设 水果 = ["苹果", "香蕉", "橘子", "葡萄", "西瓜"]
遍 水果 为 f:
    打印 "我喜欢吃：", f

打印 ""
打印 "======== 带序号的遍历（第几个） ========"
设 科目 = ["语文", "数学", "英语", "科学", "音乐"]
设 i = 0
遍 科目 为 k:
    i = i + 1
    打印 "第 ", i, " 门课：", k

打印 ""
打印 "======== 遍 之为 同时拿到 索引 和 元素 ========"
设 学生 = ["小明", "小红", "小刚", "小丽"]
遍 学生 之 为 项:
    打印 "座位号 ", 项[0], " → ", 项[1]

打印 ""
打印 "======== 求和（遍列表累加） ========"
设 成绩 = [88, 92, 76, 85, 90]
设 总分 = 0
遍 成绩 为 分:
    总分 = 总分 + 分
打印 "总分 = ", 总分
打印 "平均分 = ", 总分 / 成绩的长度
