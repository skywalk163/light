# 文体: 白话
# 第 4 课：当循环——让同一件事重复做
# 目标：掌握「当」做循环，配合「跳」跳出、「过」跳过

打印 "======== 从 1 数到 10 ========"
设 i = 1
当 i <= 10:
    打印 "数到：", i
    i = i + 1

打印 ""
打印 "======== 1 加到 100 的和 ========"
设 总和 = 0
设 n = 1
当 n <= 100:
    总和 = 总和 + n
    n = n + 1
打印 "1+2+3+…+100 = ", 总和, "  （小高斯的答案是 5050，对吗？）"

打印 ""
打印 "======== 跳：遇到 7 就结束（break） ========"
设 k = 1
当 真:  # 「真」就是无限循环，配合「跳」结束
    若 k % 7 == 0:
        打印 "遇到 7 的倍数了，k = ", k, " → 跳出循环"
        跳
    打印 "k = ", k
    k = k + 1

打印 ""
打印 "======== 过：跳过偶数，只打印奇数（continue） ========"
设 m = 0
当 m < 10:
    m = m + 1
    若 m % 2 == 0:
        过
    打印 "奇数：", m
