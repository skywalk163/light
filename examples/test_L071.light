# L-071 测试：字典/列表安全访问原语 .获取()
# 验证：1) 字典.获取(key, default) 返回默认值不抛异常
#       2) 列表.获取(index, default) 返回默认值不抛异常
#       3) 字典[key] 仍抛 KeyError（不破坏原有行为）

段落 主：
  设 d 为 {"a": 1, "b": 2}
  设 l 为 [10, 20, 30]

  # 字典.获取 — 存在的键
  打印(d.获取("a", 空))
  # 字典.获取 — 不存在的键，返回默认值
  打印(d.获取("z", 空))

  # 列表.获取 — 有效索引
  打印(l.获取(0, 空))
  # 列表.获取 — 无效索引，返回默认值不抛异常
  打印(l.获取(5, 空))
  # 列表.获取 — 负索引越界
  打印(l.获取(99, "不存在"))

  打印("通过：安全获取原语全部正常")
