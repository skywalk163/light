# 文体: 文言
# L2 文言体工程 Demo：主程序
# 演示：导（import）、试/捕/抛/终（异常）、配（模式匹配）、列表排序

# ===== 导（import）同目录的「学生模块」=====
导 学生模块 出 人, 学生, 可打印

段 主():
    打印 "========= 光明 L2 文言体 学生成绩管理系统 =========\n"

    # 1. 构造学生 + 录入成绩
    设 s1 = 学生("张三", 22, "2026001")
    s1之录入成绩("语文", 88)
    s1之录入成绩("数学", 92)
    s1之录入成绩("英语", 85)
    s1之录入成绩("科学", 90)

    设 s2 = 学生("李四", 25, "2026002")
    s2之录入成绩("语文", 76)
    s2之录入成绩("数学", 65)
    s2之录入成绩("英语", 80)

    设 s3 = 学生("王五", 21, "2026003")
    s3之录入成绩("语文", 95)
    s3之录入成绩("数学", 98)
    s3之录入成绩("英语", 93)
    s3之录入成绩("科学", 97)

    设 学生列表 = [s1, s2, s3]

    # 2. 全体名册（通过「可打印」接口调用字符串化）
    打印 "--- 全体学生名册 ---"
    遍 学生列表 为 s:
        打印 s之字符串化(), "  → 等级:", s之取等级()

    # 3. 等级分布（用「配」模式匹配）
    打印 "\n--- 等级分布 ---"
    设 统计 = {"A（优秀）": 0, "B（良好）": 0, "C（及格）": 0, "D（待提高）": 0}
    遍 学生列表 为 s:
        配 s之取等级():
            情况 "A（优秀）": 统计["A（优秀）"] = 统计["A（优秀）"] + 1
            情况 "B（良好）": 统计["B（良好）"] = 统计["B（良好）"] + 1
            情况 "C（及格）": 统计["C（及格）"] = 统计["C（及格）"] + 1
            其他:           统计["D（待提高）"] = 统计["D（待提高）"] + 1
    打印 统计

    # 4. 异常演示：录入分数 105（越界）→ 捕 住后友好提示 → 终 收尾
    打印 "\n--- 异常处理（试/捕/抛/终 四部曲）---"
    试:
        s1之录入成绩("艺术", 105)
    捕 e:
        打印 "✓ 捕获异常，提示信息: ", e
    终:
        打印 "✓ 最终：无论成功失败，收尾一定会被执行。\n"

    # 5. 按平均分降序排名（L2 工程化排序写法）
    打印 "--- 学生排名（按平均分降序） ---"
    设 排名 = 排序(学生列表, 依据 = 段(x) 返 -x之取平均分())
    设 名次 = 0
    遍 排名 为 s:
        名次 = 名次 + 1
        打印 名次, ". ", s之姓名, "  平均分=", s之取平均分(), "  等级=", s之取等级()

    打印 "\n========= L2 Demo 结束 =========\n"
    打印 "提示：把「学生模块.light」和「主程序.light」放在同一目录，"
    打印 "      运行  python -m cli.light run 主程序.light   即可。"

主()
