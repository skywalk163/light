# L-072 验证：转字符串 对字典/列表输出 JSON 格式（方案A 全链路）
#
# 缺陷：转字符串 原本是裸 str()，Python 的 repr 直接漏进光明程序——
#       转字符串(真) 给出 "True"、转字符串({"名字": "张三"}) 给出单引号的
#       Python 字典 repr。用户看到的是 Python 相，不是光明相。
#
# 方案A 口径（三条腿一致：stdlib/内置核心转换.light、
#            bootstrap/release/stdlib/builtins.py、antlrparser/light_builtins.py）：
#   转字符串(真)      -> "真"          （光明字面，非 Python 的 True）
#   转字符串(假)      -> "假"
#   转字符串(空)      -> "空"
#   转字符串("abc")   -> abc           （原样，不加引号——日志/错误消息拼接依赖）
#   转字符串(25)      -> 25
#   转字符串(3.14)    -> 3.14
#   转字符串(字典)    -> JSON：双引号、中文不转义、紧凑无缩进
#   转字符串(列表)    -> JSON，同上
#   嵌套递归；容器内的布尔/空按 JSON 口径发 true/false/null（不是 真/假/空）
#
# 运行：python light6.py examples/test_L072.light
# 期望：最后一行 "L-072 全部通过"。

设 失败清单 为 []

段落 校验 接收 标号, 实得, 应得:
  如果 实得 == 应得:
    打印("通过 " 加上 标号 加上 "  -> " 加上 实得)
  否则:
    打印("失败 " 加上 标号 加上 "  实得=" 加上 实得 加上 "  应得=" 加上 应得)
    失败清单.追加(标号)

# ---------- 标量：光明字面而非 Python repr ----------
校验("布尔真", 转字符串(真), "真")
校验("布尔假", 转字符串(假), "假")
校验("空值", 转字符串(空), "空")

# ---------- 字符串：原样返回，不加引号 ----------
校验("英文串不加引号", 转字符串("abc"), "abc")
校验("中文串不加引号", 转字符串("张三"), "张三")
校验("空串", 转字符串(""), "")
校验("含引号的串原样", 转字符串("他说\"好\""), "他说\"好\"")

# ---------- 数字：字面量 ----------
校验("整数", 转字符串(25), "25")
校验("负整数", 转字符串(0 减去 7), "-7")
校验("浮点", 转字符串(3.14), "3.14")
校验("零", 转字符串(0), "0")

# ---------- 字典 → JSON（中文不转义、双引号、紧凑） ----------
校验("空字典", 转字符串({}), "{}")
校验("单键字典", 转字符串({"名字": "张三"}), "{\"名字\": \"张三\"}")
校验("混合字典", 转字符串({"名字": "张三", "年龄": 25}), "{\"名字\": \"张三\", \"年龄\": 25}")

# ---------- 列表 → JSON ----------
校验("空列表", 转字符串([]), "[]")
校验("数字列表", 转字符串([1, 2, 3]), "[1, 2, 3]")
校验("中文列表", 转字符串(["开发者", "测试"]), "[\"开发者\", \"测试\"]")

# ---------- 嵌套递归 ----------
设 任务书 为 {"名字": "张三", "年龄": 25, "标签": ["开发者", "测试"]}
校验("字典套列表", 转字符串(任务书), "{\"名字\": \"张三\", \"年龄\": 25, \"标签\": [\"开发者\", \"测试\"]}")

设 深层 为 {"外": {"内": {"底": [1, ["二层"]]}}}
校验("三层嵌套", 转字符串(深层), "{\"外\": {\"内\": {\"底\": [1, [\"二层\"]]}}}")

设 列表套字典 为 [{"a": 1}, {"b": 2}]
校验("列表套字典", 转字符串(列表套字典), "[{\"a\": 1}, {\"b\": 2}]")

# 容器内的 真/假/空 走 JSON 口径（true/false/null），只有顶层标量才发 真/假/空
校验("容器内布尔空", 转字符串({"开": 真, "关": 假, "无": 空}), "{\"开\": true, \"关\": false, \"无\": null}")
校验("列表内布尔", 转字符串([真, 假, 空]), "[true, false, null]")

# ---------- 中文不转义（ensure_ascii=False）：不许出现 \u ----------
设 纯中文 为 转字符串({"城市": "济宁", "省份": "山东"})
校验("中文不转义", 纯中文, "{\"城市\": \"济宁\", \"省份\": \"山东\"}")
如果 包含(纯中文, "\\u"):
  打印("失败 中文被转义成了 \\uXXXX")
  失败清单.追加("中文不转义")

# ---------- 容器内的字符串必须带引号（与顶层裸串区分） ----------
校验("顶层裸串 vs 容器内带引号", 转字符串(["abc"]), "[\"abc\"]")

# ---------- 错误消息拼接场景（本缺陷最常见的落地点） ----------
设 上下文 为 {"文件": "配置.json", "行号": 12}
校验("错误消息拼接", "解析失败: " 加上 转字符串(上下文), "解析失败: {\"文件\": \"配置.json\", \"行号\": 12}")

# ---------- 收口 ----------
如果 长(失败清单) == 0:
  打印("L-072 全部通过")
否则:
  打印("L-072 有 " 加上 转字符串(长(失败清单)) 加上 " 项失败: " 加上 转字符串(失败清单))
