# 文体: 文言
# 示例5: 用 sklearn 做鸢尾花 KNN 分类

引 Python:
    from sklearn.datasets import load_iris
    from sklearn.neighbors import KNeighborsClassifier
    from sklearn.metrics import accuracy_score
    import numpy as np

    _L4_IRIS = None

    def _l4_iris_ensure():
        global _L4_IRIS
        if _L4_IRIS is None:
            iris = load_iris()
            clf = KNeighborsClassifier(n_neighbors=3)
            clf.fit(iris.data, iris.target)
            _L4_IRIS = (clf, iris.target_names, iris)
        return _L4_IRIS

    def l4_iris_predict(sepal_length, sepal_width, petal_length, petal_width):
        """4 个特征（cm） -> 预测中文名"""
        clf, names, _ = _l4_iris_ensure()
        x = np.array([[sepal_length, sepal_width, petal_length, petal_width]], dtype=float)
        idx = int(clf.predict(x)[0])
        zh = {'setosa':'山鸢尾 (setosa)','versicolor':'变色鸢尾 (versicolor)','virginica':'维吉尼亚鸢尾 (virginica)'}
        return zh.get(names[idx], str(names[idx]))

    def l4_iris_accuracy():
        """训练集准确率"""
        clf, _, iris = _l4_iris_ensure()
        pred = clf.predict(iris.data)
        return float(accuracy_score(iris.target, pred))
结束引

段 主():
    设 准确率 = l4_iris_accuracy()
    打印 "KNN 模型在 Iris 训练集上的准确率: ", 准确率

    设 预测1 = l4_iris_predict(5.1, 3.5, 1.4, 0.2)
    打印 "花(5.1, 3.5, 1.4, 0.2) 预测为: ", 预测1

    设 预测2 = l4_iris_predict(6.3, 3.3, 6.0, 2.5)
    打印 "花(6.3, 3.3, 6.0, 2.5) 预测为: ", 预测2

主()
