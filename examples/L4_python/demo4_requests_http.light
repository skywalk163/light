# 文体: 文言
# 示例4: 用 requests 抓 HTTP

引 Python:
    def l4_http_get(url, timeout=10):
        """返回 (status_code, text[:200], error_note)"""
        try:
            import requests
            r = requests.get(url, timeout=timeout)
            return r.status_code, r.text[:200], ""
        except Exception as e:
            return 0, "", str(e)
结束引

段 主():
    设 测试URL = "https://httpbin.org/get?name=lightlang&v=4.0"
    打印 "正在请求:", 测试URL

    设 三元组 = l4_http_get(测试URL, 8)
    设 状态码 = 三元组[0]
    设 内容片段 = 三元组[1]
    设 错误信息 = 三元组[2]

    若 状态码 > 0:
        打印 "HTTP 状态码:", 状态码
        打印 "响应内容前 200 字:"
        打印 内容片段
    否:
        打印 "请求失败（可能未联网？）:", 错误信息
        打印 "没关系，这个 demo 展示了「引 Python:」调 requests 的写法。"

主()
