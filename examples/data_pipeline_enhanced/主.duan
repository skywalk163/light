# 段言 - 数据管道增强版
# CSV → JSON → SQLite 数据流水线，含数据验证、错误处理与日志
# 用法: duan run examples/data_pipeline_enhanced/主.duan

导入 文件系统。
导入 JSON。

# ===== 日志模块 =====
段落 记录日志 接收 级别, 消息:
  设 时间戳文本 为 时间戳()。
  设 日志行 为 "[" + 时间戳文本 + "] [" + 级别 + "] " + 消息。
  打印(日志行)。
  追加文件("pipeline.log", 日志行 + "\n")。

段落 日志信息 接收 消息:
  记录日志("INFO", 消息)。

段落 日志警告 接收 消息:
  记录日志("WARN", 消息)。

段落 日志错误 接收 消息:
  记录日志("ERROR", 消息)。

# ===== 数据验证 =====
段落 验证薪资 接收 薪资文本:
  设 薪资 为 转整数(薪资文本)。
  如果 薪资 小于 0:
    返回 -1。
  如果 薪资 大于 1000000:
    返回 -1。
  返回 薪资。

段落 验证年龄 接收 年龄文本:
  设 年龄 为 转整数(年龄文本)。
  如果 年龄 小于 0 或 年龄 大于 150:
    返回 -1。
  返回 年龄。

段落 验证记录 接收 记录:
  设 错误信息 为 ""。

  如果 字典包含键(记录, "姓名") 等于 假 或 记录["姓名"] 等于 "":
    错误信息 为 错误信息 + "缺少姓名; "。

  如果 字典包含键(记录, "年龄") 等于 假:
    错误信息 为 错误信息 + "缺少年龄; "。
  否则:
    设 年龄 为 验证年龄(记录["年龄"])。
    如果 年龄 等于 -1:
      错误信息 为 错误信息 + "无效年龄(" + 记录["年龄"] + "); "。

  如果 字典包含键(记录, "薪资") 等于 假:
    错误信息 为 错误信息 + "缺少薪资; "。
  否则:
    设 薪资 为 验证薪资(记录["薪资"])。
    如果 薪资 等于 -1:
      错误信息 为 错误信息 + "无效薪资(" + 记录["薪资"] + "); "。

  如果 错误信息 不等于 "":
    返回 假, 错误信息。
  返回 真, ""。

# ===== 硬编码的 CSV 数据 =====
设 CSV数据 为 "姓名,年龄,城市,职业,薪资,部门
张三,28,北京,工程师,15000,技术部
李四,32,上海,设计师,18000,设计部
王五,25,广州,产品经理,16000,产品部
赵六,35,深圳,架构师,25000,技术部
钱七,29,杭州,数据分析师,14000,数据部
孙八,31,成都,前端开发,13000,技术部
周九,27,武汉,后端开发,13500,技术部
吴十,33,南京,运维工程师,14500,运维部
郑十一,26,西安,测试工程师,12000,质量部
陈十二,30,重庆,DevOps工程师,17000,技术部"

# ===== 1. 解析 CSV 数据 =====
段落 解析CSV 接收 文本:
  设 行列表 为 分割字符串(文本, "\n")。
  如果 列表长度(行列表) 小于 2:
    返回 [], "CSV 数据为空或只有表头"。

  设 表头 为 分割字符串(行列表[0], ",")。
  设 结果 为 []。
  设 错误行数 为 0。

  设 i 为 1。
  当 i 小于 列表长度(行列表):
    设 行 为 行列表[i]。
    设 字段 为 分割字符串(行, ",")。
    设 记录 为 {}。

    如果 列表长度(字段) 不等于 列表长度(表头):
      错误行数 为 错误行数 + 1。
      i 为 i + 1。
      继续。

    设 j 为 0。
    当 j 小于 列表长度(表头):
      设 键 为 表头[j]。
      设 值 为 字段[j]。
      字典设置(记录, 键, 值)。
      j 为 j + 1。

    列表追加(结果, 记录)。
    i 为 i + 1。

  如果 错误行数 大于 0:
    日志警告("CSV 解析中发现 " + 转字符串(错误行数) + " 行格式错误，已跳过。")。

  返回 结果, "成功解析 " + 转字符串(列表长度(结果)) + " 条记录。"。

# ===== 2. 数据清洗与转换 =====
段落 清洗数据 接收 数据:
  设 结果 为 []。
  设 验证通过 为 0。
  设 验证失败 为 0。

  遍历 记录 于 数据:
    设 有效, 错误信息 为 验证记录(记录)。

    如果 有效:
      记录["薪资"] 为 转整数(记录["薪资"])。
      记录["年龄"] 为 转整数(记录["年龄"])。
      列表追加(结果, 记录)。
      验证通过 为 验证通过 + 1。
    否则:
      日志警告("数据验证失败: " + 记录["姓名"] + " - " + 错误信息)。
      验证失败 为 验证失败 + 1。

  日志信息("数据清洗完成: " + 转字符串(验证通过) + " 条通过, " + 转字符串(验证失败) + " 条失败。")。
  返回 结果。

# ===== 3. 统计计算 =====
段落 计算统计 接收 数据:
  如果 列表长度(数据) 等于 0:
    返回 {}。

  设 总薪资 为 0。
  设 总年龄 为 0。
  设 最高薪资 为 0。
  设 最低薪资 为 数据[0]["薪资"]。
  设 最高年龄 为 0。
  设 最低年龄 为 数据[0]["年龄"]。
  设 部门统计 为 {}。
  设 城市统计 为 {}。

  遍历 记录 于 数据:
    设 薪资 为 记录["薪资"]。
    设 年龄 为 记录["年龄"]。

    总薪资 为 总薪资 + 薪资。
    总年龄 为 总年龄 + 年龄。

    如果 薪资 大于 最高薪资:
      最高薪资 为 薪资。
    如果 薪资 小于 最低薪资:
      最低薪资 为 薪资。

    如果 年龄 大于 最高年龄:
      最高年龄 为 年龄。
    如果 年龄 小于 最低年龄:
      最低年龄 为 年龄。

    # 部门统计
    设 部门 为 字典获取(记录, "部门", "未知")。
    如果 字典包含键(部门统计, 部门) 等于 假:
      字典设置(部门统计, 部门, 0)。
    字典设置(部门统计, 部门, 部门统计[部门] + 1)。

    # 城市统计
    设 城市 为 记录["城市"]。
    如果 字典包含键(城市统计, 城市) 等于 假:
      字典设置(城市统计, 城市, 0)。
    字典设置(城市统计, 城市, 城市统计[城市] + 1)。

  设 人数 为 列表长度(数据)。
  设 统计 为 {
    "人数": 人数,
    "平均薪资": 总薪资 / 人数,
    "最高薪资": 最高薪资,
    "最低薪资": 最低薪资,
    "平均年龄": 总年龄 / 人数,
    "最高年龄": 最高年龄,
    "最低年龄": 最低年龄,
    "部门分布": 部门统计,
    "城市分布": 城市统计
  }。
  返回 统计。

# ===== 4. 筛选高薪人员 =====
段落 筛选高薪 接收 数据, 阈值:
  设 结果 为 []。
  遍历 记录 于 数据:
    如果 记录["薪资"] 大于等于 阈值:
      列表追加(结果, 记录)。
  返回 结果。

# ===== 5. 按部门分组 =====
段落 按部门分组 接收 数据:
  设 部门分组 为 {}。
  遍历 记录 于 数据:
    设 部门 为 字典获取(记录, "部门", "未知")。
    如果 字典包含键(部门分组, 部门) 等于 假:
      字典设置(部门分组, 部门, [])。
    设 组 为 部门分组[部门]。
    列表追加(组, 记录)。
  返回 部门分组。

# ===== 6. 导出为 JSON 文件 =====
段落 导出JSON 接收 数据, 文件路径:
  设 JSON字符串 为 序列化JSON(数据, 2)。
  写入文件(文件路径, JSON字符串)。
  日志信息("已导出 JSON 文件: " + 文件路径 + " (" + 转字符串(列表长度(数据)) + " 条记录)")。

# ===== 7. 存储到 SQLite 数据库 =====
段落 存储到SQLite 接收 数据:
  设 数据库 为 打开数据库("pipeline_enhanced.db")。
  数据库.创建表("employees", {
    "姓名": "TEXT",
    "年龄": "INTEGER",
    "城市": "TEXT",
    "职业": "TEXT",
    "薪资": "INTEGER",
    "部门": "TEXT"
  }, ["姓名"])。

  设 成功数 为 0。
  遍历 记录 于 数据:
    数据库.插入("employees", 记录)。
    成功数 为 成功数 + 1。

  日志信息("已存储 " + 转字符串(成功数) + " 条记录到 SQLite 数据库 (pipeline_enhanced.db)。")。
  数据库.关闭()。

# ===== 8. 查询数据库并显示 =====
段落 查询并显示 接收 数据库:
  打印("\n" + "=" * 60)。
  打印("  数据库查询结果")。
  打印("=" * 60)。

  打印("\n--- 所有员工数据 ---")。
  设 所有员工 为 数据库.查询("SELECT * FROM employees ORDER BY 薪资 DESC")。
  遍历 员工 于 所有员工:
    打印("  " + 员工["姓名"] + " | " + 转字符串(员工["年龄"]) + "岁 | " + 员工["城市"] + " | " + 员工["职业"] + " | " + 员工["部门"] + " | " + 转字符串(员工["薪资"]) + "元")。

  打印("\n--- 薪资统计 ---")。
  设 薪资统计 为 数据库.查询("SELECT AVG(薪资) as 平均薪资, MAX(薪资) as 最高薪资, MIN(薪资) as 最低薪资, SUM(薪资) as 薪资总额, COUNT(*) as 人数 FROM employees")。
  如果 列表长度(薪资统计) 大于 0:
    设 统计 为 薪资统计[0]。
    打印("  人数: " + 转字符串(统计["人数"]))。
    打印("  平均薪资: " + 转字符串(统计["平均薪资"]) + "元")。
    打印("  最高薪资: " + 转字符串(统计["最高薪资"]) + "元")。
    打印("  最低薪资: " + 转字符串(统计["最低薪资"]) + "元")。
    打印("  薪资总额: " + 转字符串(统计["薪资总额"]) + "元")。

  # 按部门统计
  打印("\n--- 按部门统计 ---")。
  设 部门数据 为 数据库.查询("SELECT 部门, COUNT(*) as 人数, AVG(薪资) as 平均薪资, MAX(薪资) as 最高薪资 FROM employees GROUP BY 部门 ORDER BY 平均薪资 DESC")。
  遍历 行 于 部门数据:
    打印("  " + 行["部门"] + ": " + 转字符串(行["人数"]) + "人, 平均薪资 " + 转字符串(行["平均薪资"]) + "元, 最高薪资 " + 转字符串(行["最高薪资"]) + "元")。

  # 按城市统计
  打印("\n--- 按城市统计 ---")。
  设 城市数据 为 数据库.查询("SELECT 城市, COUNT(*) as 人数, AVG(薪资) as 平均薪资 FROM employees GROUP BY 城市 ORDER BY 平均薪资 DESC")。
  遍历 行 于 城市数据:
    打印("  " + 行["城市"] + ": " + 转字符串(行["人数"]) + "人, 平均薪资 " + 转字符串(行["平均薪资"]) + "元")。

  数据库.关闭()。

# ===== 9. 打印统计报告 =====
段落 打印统计报告 接收 统计:
  打印("\n" + "=" * 60)。
  打印("  数据统计报告")。
  打印("=" * 60)。
  打印("  总人数: " + 转字符串(统计["人数"]))。
  打印("  平均薪资: " + 转字符串(统计["平均薪资"]) + "元")。
  打印("  最高薪资: " + 转字符串(统计["最高薪资"]) + "元")。
  打印("  最低薪资: " + 转字符串(统计["最低薪资"]) + "元")。
  打印("  平均年龄: " + 转字符串(统计["平均年龄"]) + "岁")。
  打印("  最高年龄: " + 转字符串(统计["最高年龄"]) + "岁")。
  打印("  最低年龄: " + 转字符串(统计["最低年龄"]) + "岁")。

  打印("\n--- 部门分布 ---")。
  设 部门分布 为 统计["部门分布"]。
  设 部门键 为 字典键列表(部门分布)。
  遍历 部门 于 部门键:
    打印("  " + 部门 + ": " + 转字符串(部门分布[部门]) + "人")。

  打印("\n--- 城市分布 ---")。
  设 城市分布 为 统计["城市分布"]。
  设 城市键 为 字典键列表(城市分布)。
  遍历 城市 于 城市键:
    打印("  " + 城市 + ": " + 转字符串(城市分布[城市]) + "人")。

# ===== 主程序 =====
段落 主程序:
  打印("=" * 60)。
  打印("  数据管道增强版: CSV → JSON → SQLite")。
  打印("=" * 60)。
  日志信息("数据管道开始执行。")。

  # 步骤 1: 解析 CSV
  打印("\n[1/6] 解析 CSV 数据...")。
  设 数据, 消息 为 解析CSV(CSV数据)。
  日志信息("CSV 解析: " + 消息)。
  打印("  " + 消息)。

  # 步骤 2: 数据清洗与验证
  打印("\n[2/6] 数据清洗与验证...")。
  设 清洗后数据 为 清洗数据(数据)。
  打印("  " + "清洗完成，有效数据: " + 转字符串(列表长度(清洗后数据)) + " 条。")。

  # 步骤 3: 计算统计
  打印("\n[3/6] 计算统计信息...")。
  设 统计 为 计算统计(清洗后数据)。
  打印统计报告(统计)。

  # 步骤 4: 导出为 JSON
  打印("\n[4/6] 导出为 JSON 格式...")。
  导出JSON(清洗后数据, "employees_enhanced.json")。
  导出JSON(统计, "statistics.json")。
  打印("  已导出 employees_enhanced.json 和 statistics.json。")。

  # 步骤 5: 存储到 SQLite
  打印("\n[5/6] 存储到 SQLite 数据库...")。
  存储到SQLite(清洗后数据)。

  # 步骤 6: 查询数据库
  打印("\n[6/6] 查询数据库并显示结果...")。
  设 数据库 为 打开数据库("pipeline_enhanced.db")。
  查询并显示(数据库)。

  # 额外: 筛选高薪人员
  打印("\n" + "=" * 60)。
  打印("  高薪人员 (薪资 >= 16000元)")。
  打印("=" * 60)。
  设 高薪人员 为 筛选高薪(清洗后数据, 16000)。
  遍历 高薪 于 高薪人员:
    打印("  " + 高薪["姓名"] + " | " + 高薪["职业"] + " | " + 高薪["部门"] + " | " + 转字符串(高薪["薪资"]) + "元")。

  # 按部门分组
  打印("\n" + "=" * 60)。
  打印("  按部门分组")。
  打印("=" * 60)。
  设 部门分组 为 按部门分组(清洗后数据)。
  设 部门键 为 字典键列表(部门分组)。
  遍历 部门 于 部门键:
    打印("  " + 部门 + " (" + 转字符串(列表长度(部门分组[部门])) + "人):")。
    遍历 员工 于 部门分组[部门]:
      打印("    - " + 员工["姓名"] + " (" + 员工["职业"] + ")")。

  打印("\n" + "=" * 60)。
  打印("  数据管道执行完成！")。
  打印("  生成文件: pipeline.log, employees_enhanced.json, statistics.json, pipeline_enhanced.db")。
  打印("=" * 60)。
  日志信息("数据管道执行完成。")。

主程序()。