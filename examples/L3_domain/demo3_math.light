# 文体: 文言
# L3 领域嵌入示例3：数学公式（解代数方程/微积分/矩阵乘法/化简）
# 注意：需要安装 sympy → pip install sympy

引 Python:
    import sympy as sp
    from sympy import symbols, Eq, solve, diff, integrate, Matrix, simplify, expand, latex

    # 通用符号
    _x, _y, _z, _a, _b, _c = symbols('x y z a b c')

    def l3_math_solve_quadratic(a, b, c_val):
        """解一元二次方程 a*x^2 + b*x + c = 0，返回 list[float]"""
        sol = solve(Eq(a*_x**2 + b*_x + c_val, 0), _x)
        return [complex(s).real if abs(complex(s).imag) < 1e-9 else complex(s) for s in sol]

    def l3_math_derivative(expr_str, var='x'):
        """求导（传入字符串表达式，如 "x**3 + 2*x"）"""
        expr = sp.sympify(expr_str)
        v = symbols(var)
        d = diff(expr, v)
        return str(d)

    def l3_math_integrate(expr_str, var='x', a=None, b=None):
        """积分：若 a/b=None 返回不定积分表达式字符串，否则返回数值"""
        expr = sp.sympify(expr_str)
        v = symbols(var)
        if a is None or b is None:
            return str(integrate(expr, v))
        res = integrate(expr, (v, a, b))
        return float(res.evalf()) if hasattr(res, 'evalf') else str(res)

    def l3_math_matrix_mult(A, B):
        """矩阵乘法：A 和 B 都是 list[list]，返回 list[list]"""
        MA = Matrix(A); MB = Matrix(B)
        R = MA * MB
        return [list(row) for row in R.tolist()]

    def l3_math_simplify(expr_str):
        """代数化简，返回字符串"""
        return str(simplify(sp.sympify(expr_str)))
结束引

段 主():
    打印 "→ 1. 解一元二次方程: 2x^2 + 5x - 3 = 0"
    设 解 = l3_math_solve_quadratic(2, 5, -3)
    打印 "   x = ", 解

    打印 ""
    打印 "→ 2. 求导: d/dx (x^3 + 2x^2 - 5x + 7)"
    打印 "   结果 = ", l3_math_derivative("x**3 + 2*x**2 - 5*x + 7")

    打印 ""
    打印 "→ 3. 定积分: ∫(0→π) sin(x) dx"
    打印 "   数值 = ", l3_math_integrate("sin(x)", "x", 0, "3.141592653589793")

    打印 ""
    打印 "→ 4. 矩阵乘法  A(2x3) * B(3x2)"
    设 A = [[1, 2, 3], [4, 5, 6]]
    设 B = [[7, 8], [9, 10], [11, 12]]
    设 C = l3_math_matrix_mult(A, B)
    打印 "   A * B = "
    遍 C 为 行:
        打印 "       ", 行

    打印 ""
    打印 "→ 5. 代数化简: (x+1)*(x-1) + (x-2)^2"
    打印 "   化简 = ", l3_math_simplify("(x+1)*(x-1) + (x-2)**2")

主()
