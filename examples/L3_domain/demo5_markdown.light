# 文体: 文言
# L3 领域嵌入示例5：Markdown 文档生成（标题/段落/列表/表格/代码块）
# 使用 l3_markdown 模块生成 Markdown 文档

引 Python:
    from l3_markdown import L3Markdown
    l3_md = L3Markdown()
结束引

段 主():
    打印 "→ 1. 创建文档"
    l3_md.文档("项目报告", 1)
    打印 "   文档标题: 项目报告"

    打印 ""
    打印 "→ 2. 添加一级标题"
    l3_md.标题("概述", 1)
    打印 "   已添加标题: 概述"

    打印 ""
    打印 "→ 3. 添加段落"
    l3_md.段落("本项目旨在使用光明编程语言开发一套完整的文档生成系统。")
    打印 "   已添加段落"

    打印 ""
    打印 "→ 4. 添加二级标题"
    l3_md.标题("功能清单", 2)

    打印 ""
    打印 "→ 5. 添加无序列表"
    l3_md.列表([
        "Markdown 文档生成",
        "ECharts 可视化图表",
        "数据报表导出",
        "模板引擎支持",
    ])
    打印 "   已添加 4 项列表"

    打印 ""
    打印 "→ 6. 添加有序列表"
    l3_md.列表(["第一阶段：需求分析", "第二阶段：系统设计", "第三阶段：编码实现"], 有序=True)
    打印 "   已添加有序列表"

    打印 ""
    打印 "→ 7. 添加表格"
    l3_md.表格(
        ["模块名", "状态", "负责人"],
        [
            ["文档生成", "已完成", "张三"],
            ["图表引擎", "开发中", "李四"],
            ["导出模块", "待开始", "王五"],
        ]
    )
    打印 "   已添加 3 行 3 列表格"

    打印 ""
    打印 "→ 8. 添加代码块"
    l3_md.代码块("""段 主():
    打印 "Hello, 光明!"
    打印 "世界，你好！"

主()""", "light")
    打印 "   已添加代码块"

    打印 ""
    打印 "→ 9. 添加引用"
    l3_md.引用("光明（LightLang）是一款面向中文编程爱好者的编程语言。")
    打印 "   已添加引用"

    打印 ""
    打印 "→ 10. 添加分隔线"
    l3_md.分隔线()
    打印 "   已添加分隔线"

    打印 ""
    打印 "→ 11. 内联样式"
    设 粗体文本 = l3_md.粗体("重要提示")
    设 斜体文本 = l3_md.斜体("备注信息")
    设 链接文本 = l3_md.链接("光明官网", "https://light-lang.org")
    打印 "   粗体: ", 粗体文本
    打印 "   斜体: ", 斜体文本
    打印 "   链接: ", 链接文本

    打印 ""
    打印 "→ 12. 导出完整文档"
    设 文档内容 = l3_md.导出()
    打印 "=== 生成的 Markdown 文档 ==="
    打印 ""
    打印 文档内容
    打印 "============================"
    打印 "文档长度: ", len(文档内容), " 字符"
    打印 ""
    打印 "完成。"

主()