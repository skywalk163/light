# 文体: 文言
# L3 领域嵌入示例4：ECharts 可视化（柱状图/折线图/饼图/散点图）
# 使用 l3_echarts 模块生成 ECharts 兼容的图表配置

引 Python:
    from l3_echarts import L3ECharts
    l3_chart = L3ECharts()
结束引

段 主():
    打印 "→ 1. 柱状图：月销售数据"
    设 柱状图配置 = l3_chart.图表配置(
        "柱状图",
        标题="月销售数据",
        数据=[120, 200, 150, 80, 70, 110, 130],
        标签=["一月", "二月", "三月", "四月", "五月", "六月", "七月"],
        系列名="销售额"
    )
    打印 "   标题: ", 柱状图配置["title"]["text"]
    打印 "   类型: ", 柱状图配置["series"][0]["type"]
    打印 "   数据: ", 柱状图配置["series"][0]["data"]
    打印 "   颜色数: ", len(柱状图配置["color"])

    打印 ""
    打印 "→ 2. 折线图：温度变化趋势"
    设 折线图配置 = l3_chart.折线图(
        数据=[22, 28, 35, 30, 25, 20],
        标题="周温度变化",
        标签=["周一", "周二", "周三", "周四", "周五", "周六"]
    )
    打印 "   标题: ", 折线图配置["title"]["text"]
    打印 "   平滑: ", 折线图配置["series"][0]["smooth"]

    打印 ""
    打印 "→ 3. 饼图：市场份额分布"
    设 饼图配置 = l3_chart.饼图(
        数据=[
            {"name": "产品A", "value": 335},
            {"name": "产品B", "value": 310},
            {"name": "产品C", "value": 234},
            {"name": "产品D", "value": 135},
            {"name": "产品E", "value": 98},
        ],
        标题="市场份额"
    )
    打印 "   标题: ", 饼图配置["title"]["text"]
    打印 "   数据项数: ", len(饼图配置["series"][0]["data"])

    打印 ""
    打印 "→ 4. 散点图：身高体重分布"
    设 散点图配置 = l3_chart.散点图(
        数据=[
            [160, 55], [170, 65], [175, 70],
            [180, 80], [165, 58], [172, 68],
        ],
        标题="身高体重分布",
        系列名="样本"
    )
    打印 "   标题: ", 散点图配置["title"]["text"]
    打印 "   数据点数: ", len(散点图配置["series"][0]["data"])

    打印 ""
    打印 "→ 5. 导出柱状图为 JSON"
    设 json输出 = l3_chart.导出JSON()
    打印 "   JSON 长度: ", len(json输出), " 字符"

    打印 ""
    打印 "→ 6. 导出折线图为 HTML"
    设 html输出 = l3_chart.导出HTML("光明图表演示")
    打印 "   HTML 长度: ", len(html输出), " 字符"

    打印 ""
    打印 "完成。以上配置可直接用于 ECharts 渲染。"

主()