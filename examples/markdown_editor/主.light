# 段言 Markdown 到 HTML 转换器
# 将 Markdown 文本转换为 HTML 格式

段落 转义HTML 接收 文本 :
    设 结果 为 文本
    结果 为 结果.替换("&", "&amp;")
    结果 为 结果.替换("<", "&lt;")
    结果 为 结果.替换(">", "&gt;")
    结果 为 结果.替换('"', "&quot;")
    返回 结果

段落 解析标题 接收 行 :
    设 计数 为 0
    遍历 字符 于 行:
        如果 字符 等于 "#":
            计数 为 计数 加 1
        否则:
            跳出
    如果 计数 大于 0 且 计数 小于等于 6:
        设 内容 为 行.切片(计数).去空白()
        返回 "<h" 加 计数 加 ">" 加 转义HTML(内容) 加 "</h" 加 计数 加 ">"
    返回 空

段落 解析列表 接收 行 :
    如果 行.去空白().开始于("- ") 或 行.去空白().开始于("* "):
        设 内容 为 行.去空白().切片(2).去空白()
        返回 "<li>" 加 转义HTML(内容) 加 "</li>"
    如果 行.去空白().匹配(r"^\d+\. "):
        设 内容 为 行.去空白().分割(".")[1] 如果 行.包含(".") 否则 行.去空白()
        返回 "<li>" 加 转义HTML(内容) 加 "</li>"
    返回 空

段落 解析内联格式 接收 行 :
    设 结果 为 转义HTML(行)
    # 粗体 **text**
    结果 为 结果.替换("**", "<strong>")
    结果 为 结果.替换("**", "</strong>")
    # 斜体 *text*
    结果 为 结果.替换("*", "<em>")
    结果 为 结果.替换("*", "</em>")
    # 代码 `code`
    结果 为 结果.替换("`", "<code>")
    结果 为 结果.替换("`", "</code>")
    # 链接 [text](url)
    设 正则 为 导入《正则表达式》
    如果 行 包含 "[" 且 行 包含 "](":
        设 链接匹配 为 正则.查找(r"\[([^\]]+)\]\(([^)]+)\)", 行)
        如果 链接匹配:
            设 链接文本 为 链接匹配.组(1)
            设 链接URL 为 链接匹配.组(2)
            结果 为 结果.替换(
                "[" 加 链接文本 加 "](" 加 链接URL 加 ")",
                "<a href=\"" 加 链接URL 加 "\">" 加 链接文本 加 "</a>"
            )
    返回 结果

段落 解析代码块 接收 行 :
    如果 行.去空白().开始于("```"):
        返回 真
    返回 假

段落 Markdown转HTML 接收 内容 :
    设 行列表 为 内容.分割("\n")
    设 HTML 为 []
    HTML.追加("<!DOCTYPE html>")
    HTML.追加("<html>")
    HTML.追加("<head>")
    HTML.追加("<meta charset=\"UTF-8\">")
    HTML.追加("<title>Markdown 转换结果</title>")
    HTML.追加("<style>")
    HTML.追加("body { max-width: 800px; margin: 0 auto; padding: 20px; font-family: sans-serif; }")
    HTML.追加("code { background: #f4f4f4; padding: 2px 6px; border-radius: 3px; }")
    HTML.追加("pre { background: #f4f4f4; padding: 12px; border-radius: 6px; overflow-x: auto; }")
    HTML.追加("</style>")
    HTML.追加("</head>")
    HTML.追加("<body>")

    设 代码块标志 为 假
    设 列表标志 为 假
    设 本段落 为 ""

    段落 刷新段落 接收 :
        如果 本段落 不等于 "":
            HTML.追加("<p>" 加 解析内联格式(本段落.去空白()) 加 "</p>")
            设 本段落 为 ""

    遍历 原始行 于 行列表:
        设 行 为 原始行

        # 代码块处理
        如果 解析代码块(行):
            如果 代码块标志:
                HTML.追加("</pre>")
                代码块标志 为 假
            否则:
                如果 列表标志:
                    HTML.追加("</ul>")
                    列表标志 为 假
                刷新段落()
                HTML.追加("<pre><code>")
                代码块标志 为 真
            跳过

        如果 代码块标志:
            HTML.追加(行 加 "\n")
            跳过

        # 空行
        如果 非 行.去空白():
            如果 列表标志:
                HTML.追加("</ul>")
                列表标志 为 假
            刷新段落()
            跳过

        # 标题
        设 标题 为 解析标题(行)
        如果 标题:
            如果 列表标志:
                HTML.追加("</ul>")
                列表标志 为 假
            刷新段落()
            HTML.追加(标题)
            HTML.追加("\n")
            跳过

        # 列表项
        设 列表项 为 解析列表(行)
        如果 列表项:
            刷新段落()
            如果 非 列表标志:
                HTML.追加("<ul>\n")
                列表标志 为 真
            HTML.追加(列表项 加 "\n")
            跳过

        # 普通段落
        如果 非 本段落:
            设 本段落 为 行
        否则:
            设 本段落 为 本段落 加 " " 加 行

    # 刷新剩余内容
    如果 代码块标志:
        HTML.追加("</pre>")
    如果 列表标志:
        HTML.追加("</ul>")
    刷新段落()

    HTML.追加("</body>")
    HTML.追加("</html>")
    返回 HTML.连接("\n")

段落 主函数 接收 :
    打印("段言 Markdown 编辑器")
    打印("=" * 40)
    打印("请输入 Markdown 内容（输入 'END' 单独一行结束）:")
    打印("=" * 40)

    设 行列表 为 []
    当 真:
        设 行 为 输入()
        如果 行 等于 "END":
            跳出
        行列表.追加(行)

    设 内容 为 行列表.连接("\n")
    设 HTML 为 Markdown转HTML(内容)

    打印("=" * 40)
    打印("转换结果:")
    打印("=" * 40)
    打印(HTML)

    # 保存到文件
    尝试:
        使用 打开("output.html", "w", 编码 为 "utf-8") 为 文件:
            文件.写入(HTML)
        打印("=" * 40)
        打印("HTML 已保存到 output.html")
    捕获 异常 为 错误:
        打印("保存文件失败: " 加 错误)

# 启动
主函数()