段fact接收n整数返回整数
    如果n小于等于1:返回1
    返回n乘fact(n减1)

段主函数
    # 1. 运算符符号别名
    输出("=== 运算符符号 ===")
    设x为10加20乘3
    输出("10+20*3=", x)
    输出("100/4=", 100/4)
    输出("10%3=", 10%3)

    # 2. 单行块 (多行if无否则)
    输出("=== 单行块 ===")
    设score为85
    如果score大于等于90:输出("优秀")
    如果score大于等于80:输出("良好")
    如果score大于等于60且score小于80:输出("及格")
    如果score小于60:输出("不及格")

    # 3. 反引号转义标识符
    输出("=== 反引号标识符 ===")
    设`类`为"class"
    设`返回`为"return"
    设`如果`为"if"
    输出(`类`, `返回`, `如果`)

    # 4. 递归函数
    输出("=== 递归 ===")
    设结果为fact(5)
    输出("fact(5)=", 结果)