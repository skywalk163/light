{
    "设变量": {
        "prefix": "设",
        "body": "设 ${1:变量名} 为 ${2:值}",
        "description": "变量赋值"
    },
    "如果语句": {
        "prefix": "如果",
        "body": [
            "如果 ${1:条件}:",
            "    ${2:代码}",
            "结束"
        ],
        "description": "条件判断语句"
    },
    "如果否则": {
        "prefix": "如果否则",
        "body": [
            "如果 ${1:条件}:",
            "    ${2:代码}",
            "否则:",
            "    ${0:代码}",
            "结束"
        ],
        "description": "条件判断语句（带否则分支）"
    },
    "如果否则如果链": {
        "prefix": "如果否则如果",
        "body": [
            "如果 ${1:条件1}:",
            "    ${2:代码1}",
            "否则如果 ${3:条件2}:",
            "    ${4:代码2}",
            "否则:",
            "    ${0:代码3}",
            "结束"
        ],
        "description": "多条件判断语句（如果/否则如果/否则）"
    },
    "遍历循环": {
        "prefix": "遍历",
        "body": [
            "遍历 ${1:项} 于 ${2:列表}:",
            "    ${0:代码}",
            "结束"
        ],
        "description": "遍历循环语句"
    },
    "当循环": {
        "prefix": "当",
        "body": [
            "当 ${1:条件}:",
            "    ${0:代码}",
            "结束"
        ],
        "description": "当（while）循环语句"
    },
    "循环从到": {
        "prefix": "循环",
        "body": [
            "循环 ${1:变量} 从 ${2:开始} 到 ${3:结束}:",
            "    ${0:代码}",
            "结束"
        ],
        "description": "循环语句（从开始到结束）"
    },
    "循环步长": {
        "prefix": "循环步长",
        "body": [
            "循环 ${1:变量} 从 ${2:开始} 到 ${3:结束} 步长 ${4:步长}:",
            "    ${0:代码}",
            "结束"
        ],
        "description": "循环语句（带步长）"
    },
    "段落定义": {
        "prefix": "段落",
        "body": [
            "段落 ${1:名} 接收 ${2:参数}:",
            "    ${0:代码}",
            "结束"
        ],
        "description": "段落（函数）定义"
    },
    "段落定义带返回": {
        "prefix": "段落返回",
        "body": [
            "段落 ${1:名} 接收 ${2:参数} 返回 ${3:类型}:",
            "    ${0:代码}",
            "结束"
        ],
        "description": "段落（函数）定义，带返回类型"
    },
    "函数定义": {
        "prefix": "函数",
        "body": [
            "函数 ${1:函数名}(${2:参数}) -> ${3:返回类型}:",
            "    ${0:代码}",
            "结束"
        ],
        "description": "函数定义"
    },
    "类定义": {
        "prefix": "类",
        "body": [
            "类 ${1:名}:",
            "    属性 ${2:属性名}",
            "",
            "    构造 接收 ${3:参数}:",
            "        己${2:属性名} 为 ${3:参数}",
            "",
            "    段落 ${4:方法名}(${5:参数}):",
            "        ${0:代码}",
            "结束"
        ],
        "description": "类定义"
    },
    "类继承": {
        "prefix": "类继承",
        "body": [
            "类 ${1:子类名} 继承 ${2:父类名}:",
            "    构造 接收 ${3:参数}:",
            "        父.构造(${3:参数})",
            "",
            "    段落 ${4:方法名}(${5:参数}):",
            "        ${0:代码}",
            "结束"
        ],
        "description": "类继承定义"
    },
    "尝试捕获": {
        "prefix": "尝试",
        "body": [
            "尝试:",
            "    ${1:代码}",
            "捕获 ${2:错误}:",
            "    ${0:处理代码}",
            "结束"
        ],
        "description": "异常处理语句（尝试/捕获）"
    },
    "尝试捕获最终": {
        "prefix": "尝试捕获",
        "body": [
            "尝试:",
            "    ${1:代码}",
            "捕获 ${2:错误}:",
            "    ${3:处理代码}",
            "最终:",
            "    ${0:清理代码}",
            "结束"
        ],
        "description": "异常处理语句（尝试/捕获/最终）"
    },
    "导入模块": {
        "prefix": "导入",
        "body": "导入 ${1:模块名}",
        "description": "导入模块"
    },
    "从导入": {
        "prefix": "从导入",
        "body": "从 ${1:模块名} 导入 ${2:符号}",
        "description": "从模块导入指定符号"
    },
    "打印": {
        "prefix": "打印",
        "body": "打印(${1:内容})",
        "description": "打印输出到控制台"
    },
    "返回语句": {
        "prefix": "返回",
        "body": "返回 ${0:值}",
        "description": "返回语句"
    },
    "抛出异常": {
        "prefix": "抛出",
        "body": "抛出 ${0:异常}",
        "description": "抛出异常"
    },
    "主程序": {
        "prefix": "主程序",
        "body": [
            "段落 主程序 接收 参数:",
            "    ${0:代码}",
            "结束",
            "",
            "主程序()"
        ],
        "description": "主程序入口"
    },
    "模式匹配": {
        "prefix": "匹配",
        "body": [
            "匹配 ${1:表达式}:",
            "    情况 ${2:模式1}:",
            "        ${3:代码1}",
            "    情况 ${4:模式2}:",
            "        ${5:代码2}",
            "    默认:",
            "        ${0:默认代码}",
            "结束"
        ],
        "description": "模式匹配语句"
    },
    "异步函数": {
        "prefix": "异步",
        "body": [
            "异步 段落 ${1:函数名}(${2:参数}) -> ${3:返回类型}:",
            "    等待 ${0:操作}",
            "结束"
        ],
        "description": "异步函数定义"
    },
    "使用语句": {
        "prefix": "使用",
        "body": [
            "使用 ${1:表达式} 为 ${2:变量}:",
            "    ${0:代码}",
            "结束"
        ],
        "description": "上下文管理器语句（with）"
    },
    "枚举定义": {
        "prefix": "枚举",
        "body": [
            "枚举 ${1:枚举名}:",
            "    ${2:变体1}",
            "    ${3:变体2}",
            "    ${0:变体3}",
            "结束"
        ],
        "description": "枚举类型定义"
    },
    "接口定义": {
        "prefix": "接口",
        "body": [
            "接口 ${1:接口名}:",
            "    段落 ${2:方法名}(${3:参数}) -> ${4:返回类型}",
            "    ${0:其他方法}",
            "结束"
        ],
        "description": "接口定义"
    },
    "结构体定义": {
        "prefix": "结构体",
        "body": [
            "结构体 ${1:结构体名}:",
            "    ${2:字段1}: ${3:类型1}",
            "    ${4:字段2}: ${5:类型2}",
            "    ${0:字段3}: ${6:类型3}",
            "结束"
        ],
        "description": "结构体定义"
    },
    "标注装饰器": {
        "prefix": "标注",
        "body": [
            "标注 ${1:装饰器名}",
            "段落 ${2:函数名}(${3:参数}) -> ${4:返回类型}:",
            "    ${0:代码}",
            "结束"
        ],
        "description": "装饰器标注"
    },
    "静态方法": {
        "prefix": "静态",
        "body": [
            "静态 段落 ${1:方法名}(${2:参数}) -> ${3:返回类型}:",
            "    ${0:代码}",
            "结束"
        ],
        "description": "静态方法定义"
    },
    "嵌入代码": {
        "prefix": "嵌入",
        "body": [
            "嵌入 ${1:Python}:",
            "    ${0:代码}",
            "结束嵌入"
        ],
        "description": "嵌入代码块"
    },
    "数据定义": {
        "prefix": "数据",
        "body": [
            "数据 ${1:名称}:",
            "    ${2:字段}: ${3:类型}",
            "结束"
        ],
        "description": "数据/记录类型定义"
    },
    "外部FFI": {
        "prefix": "外部",
        "body": "外部 段落 ${1:函数名} 接收 ${2:参数} 返回 ${3:类型} 在 ${4:库}",
        "description": "FFI 外部声明"
    },
    "推迟执行": {
        "prefix": "推迟",
        "body": [
            "推迟:",
            "    ${0:代码}",
            "结束"
        ],
        "description": "推迟执行（作用域退出时运行）"
    },
    "并行作用域": {
        "prefix": "并行",
        "body": [
            "并行 {",
            "    ${1:任务1}",
            "    ${2:任务2}",
            "}"
        ],
        "description": "并行作用域（结构化并发）"
    }
}