{
    "name": "light-lang",
    "displayName": "光明 (Light Language)",
    "description": "光明中文编程语言支持 - 语法高亮、代码补全、LSP、格式化、调试",
    "version": "7.0.0",
    "publisher": "light-lang",
    "license": "MIT",
    "icon": "icon.png",
    "repository": {
        "type": "git",
        "url": "https://github.com/skywalk163/light.git"
    },
    "homepage": "https://skywalk163.github.io/light",
    "bugs": {
        "url": "https://github.com/skywalk163/light/issues"
    },
    "engines": {
        "vscode": "^1.80.0"
    },
    "categories": [
        "Programming Languages",
        "Snippets",
        "LSP"
    ],
    "activationEvents": [
        "onLanguage:light",
        "onCommand:light.welcome"
    ],
    "main": "./extension.js",
    "contributes": {
        "languages": [
            {
                "id": "light",
                "aliases": ["光明", "Light"],
                "extensions": [".light"],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "light",
                "scopeName": "source.light",
                "path": "./syntaxes/light.tmLanguage.json"
            }
        ],
        "snippets": [
            {
                "language": "light",
                "path": "./snippets/light.json"
            }
        ],
        "commands": [
            {
                "command": "light.welcome",
                "title": "光明: 显示欢迎页",
                "category": "光明"
            },
            {
                "command": "light.run",
                "title": "光明: 运行文件",
                "category": "光明"
            },
            {
                "command": "light.compile",
                "title": "光明: 编译为Python",
                "category": "光明"
            },
            {
                "command": "light.build",
                "title": "光明: 构建当前文件",
                "category": "光明"
            },
            {
                "command": "light.format",
                "title": "光明: 格式化当前文件",
                "category": "光明"
            },
            {
                "command": "light.check",
                "title": "光明: 检查语法",
                "category": "光明"
            },
            {
                "command": "light.compileLLVM",
                "title": "光明: 编译当前文件 (LLVM-Typed 原生)",
                "category": "光明"
            },
            {
                "command": "light.typeCheck",
                "title": "光明: 类型检查当前文件",
                "category": "光明"
            },
            {
                "command": "light.repl",
                "title": "光明: 打开 REPL",
                "category": "光明"
            },
            {
                "command": "light.restartLSP",
                "title": "光明: 重启语言服务器",
                "category": "光明"
            },
            {
                "command": "light.translate",
                "title": "光明: Python↔光明双向翻译",
                "category": "光明"
            },
            {
                "command": "light.ai",
                "title": "光明: AI辅助代码生成",
                "category": "光明"
            }
        ],
        "keybindings": [
            {
                "command": "light.run",
                "key": "ctrl+shift+r",
                "mac": "cmd+shift+r",
                "when": "editorTextFocus && resourceLangId == light"
            },
            {
                "command": "light.build",
                "key": "ctrl+shift+b",
                "mac": "cmd+shift+b",
                "when": "editorTextFocus && resourceLangId == light"
            },
            {
                "command": "light.format",
                "key": "shift+alt+f",
                "mac": "shift+alt+f",
                "when": "editorTextFocus && resourceLangId == light"
            },
            {
                "command": "light.check",
                "key": "ctrl+shift+c",
                "mac": "cmd+shift+c",
                "when": "editorTextFocus && resourceLangId == light"
            },
            {
                "command": "light.compile",
                "key": "ctrl+shift+e",
                "mac": "cmd+shift+e",
                "when": "editorTextFocus && resourceLangId == light"
            },
            {
                "command": "light.typeCheck",
                "key": "ctrl+shift+t",
                "mac": "cmd+shift+t",
                "when": "editorTextFocus && resourceLangId == light"
            },
            {
                "command": "light.repl",
                "key": "ctrl+shift+i",
                "mac": "cmd+shift+i",
                "when": "resourceLangId == light"
            }
        ],
        "configuration": {
            "title": "光明",
            "properties": {
                "light.serverPath": {
                    "type": "string",
                    "default": "",
                    "description": "光明 LSP 服务器路径（留空则自动查找）"
                },
                "light.pythonPath": {
                    "type": "string",
                    "default": "",
                    "description": "Python 解释器路径（留空则使用系统默认 python/python3）"
                },
                "light.trace.server": {
                    "type": "string",
                    "enum": ["off", "messages", "verbose"],
                    "default": "off",
                    "description": "LSP 通信日志级别"
                },
                "light.format.enable": {
                    "type": "boolean",
                    "default": true,
                    "description": "启用光明代码格式化提供器"
                },
                "light.format.indentSize": {
                    "type": "number",
                    "default": 4,
                    "minimum": 1,
                    "maximum": 8,
                    "description": "缩进空格数（制表符将转换为此数量的空格）"
                },
                "light.format.trimTrailingWhitespace": {
                    "type": "boolean",
                    "default": true,
                    "description": "格式化时去除行尾空白字符"
                },
                "light.format.insertFinalNewline": {
                    "type": "boolean",
                    "default": true,
                    "description": "确保文件以换行符结尾"
                },
                "light.welcome.alwaysShow": {
                    "type": "boolean",
                    "default": false,
                    "description": "每次启动 VS Code 时自动显示光明欢迎页"
                },
                "light.version": {
                    "type": "string",
                    "default": "7.0.0",
                    "readOnly": true,
                    "description": "光明扩展版本号"
                }
            }
        },
        "breakpoints": [
            {
                "language": "light"
            }
        ],
        "taskDefinitions": [
            {
                "type": "light",
                "required": ["task"],
                "properties": {
                    "task": {
                        "type": "string",
                        "description": "光明任务类型: build / run / check / compile / compile-llvm",
                        "enum": ["build", "run", "check", "compile", "compile-llvm"]
                    },
                    "file": {
                        "type": "string",
                        "description": "目标文件路径（默认: 当前文件）"
                    }
                }
            }
        ],
        "problemMatchers": [
            {
                "name": "light",
                "label": "光明错误",
                "owner": "light",
                "fileLocation": "absolute",
                "pattern": {
                    "regexp": "^(.*?):(\\d+):(\\d+):\\s*(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "message": 4
                }
            }
        ]
    },
    "scripts": {
        "compile": "echo No compilation needed",
        "watch": "echo No watch needed",
        "package": "vsce package"
    },
    "devDependencies": {
        "@types/vscode": "^1.80.0"
    }
}