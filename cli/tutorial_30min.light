#  第 10 节：异常处理（~3 分钟）
# ============================================================
打印("【第 10 节】异常处理")
print("")
打印("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")
print("  异常处理让程序在出错时不会崩溃，而是优雅地处理错误。")
print("  就像生活中「试试看，如果出错了就补救」。")
print("")
print("  语法格式：")
print("    尝试：")
print("        可能出错的代码")
print("    捕获 异常类型 为 变量：")
print("        处理错误的代码")
print("    最终：")
print("        无论是否出错都执行（可选）")
print("")

打印("──── 基本异常处理 ────")
print("")

尝试：
    设 结果 为 10 除以 0
捕获 Exception 为 错误：
    打印("出错了！")
    打印("错误信息：" 加上 转字符串(错误))
print("")

打印("──── 主动抛出异常 ────")
print("  用「抛出」可以主动抛出异常：")
print("")

段落 检查年龄 接收 年龄：
    如果 年龄 小于 0：
        抛出 Exception("年龄不能为负数")
    打印(f"年龄是{年龄}")

尝试：
    检查年龄(-5)
捕获 Exception 为 e：
    打印("捕获到异常：" 加上 转字符串(e))
print("")

打印("关键概念：")
print("  • 尝试：                — 包裹可能出错的代码")
print("  • 捕获 类型 为 变量：   — 捕获并处理异常")
print("  • 抛出 异常(\"消息\")    — 主动抛出异常")
print("  • 最终：                — 无论是否出错都执行（可选）")
print("")

打印("常见错误：")
print("  • 忘记写「为 变量」→ 捕获 异常： 少了「为 e」")
print("  • 捕获范围太大 → 尽量捕获具体的异常类型")
print("  • 吞掉异常 → 捕获后至少打印错误信息，不要什么都不做")
print("")

