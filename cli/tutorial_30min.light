# ============================================================
#  30 分钟入门段言 — 交互式教程
#  用段言写的段言教程！运行命令：duan tutorial
#  版本：2.0  |  10 节完整版
# ============================================================

# ============================================================
#  第 1 节：你好，段言！（~2 分钟）
# ============================================================
打印("")
打印("╔══════════════════════════════════════════════════════════╗")
打印("║       殴  30 分钟入门段言  殴                          ║")
打印("║       用中文写代码，让编程回归直觉                       ║")
打印("╚══════════════════════════════════════════════════════════╝")
打印("")

打印("【第 1 节】你好，段言！")
打印("")
打印("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")
打印("  段言（Duan）是一门基于中文的编程语言。")
打印("  语法完全使用中文，让你像说话一样写代码。")
打印("")
打印("  为什么选择段言？")
打印("    用中文思考，用中文编写 — 不用在两种语言间切换")
打印("    语法直观，读起来就像自然语言")
打印("    适合编程初学者、中文教育、快速原型开发")
print("")
打印("  最简短的段言程序只需要一行：")
打印("    打印(\"你好，世界！\")")
打印("")
打印("  现在，让我们来运行它：")
打印("  ──────────────────────────────────")
打印("你好，世界！")
print("")

打印("关键概念：")
打印("  • 打印() — 在屏幕上输出内容")
打印("  • # 开头 — 注释（不会被执行的说明文字）")
print("  • 语句末尾的句号可以省略")
print("  • 字符串用双引号 \"...\" 括起来")
print("")

打印("常见错误：")
print("  • 忘记写引号 → 打印(你好) 会报错，应该是 打印(\"你好\")")
print("  • 用了中文引号 → \"你好\" 才对，不是 \"你好\"")
print("  • 括号不匹配 → 打印(\"你好\"  漏了右括号")
print("")

# ── 本节小结 ──
打印("─── 第 1 节小结 ───")
打印("  学会了：打印() 输出内容")
打印("  学会了：# 开头写注释")
打印("  学会了：字符串用双引号")
print("")

# ============================================================
#  第 2 节：变量与赋值（~3 分钟）
# ============================================================
打印("【第 2 节】变量与赋值")
print("")
打印("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")
print("  变量就像一个「贴了标签的盒子」，用来存放数据。")
print("  在段言中，用「设」来声明变量，用「为」来赋值。")
print("")
print("  语法格式：")
print("    设 变量名 为 值")
print("")
print("  段言支持的数据类型：")
print("    • 字符串（文本）  — \"张三\"")
print("    • 数字（整数）    — 25")
print("    • 数字（小数）    — 1.75")
print("    • 布尔值          — 真 / 假")
print("    • 空值            — 空")
print("")

设 姓名 为 "张三"
设 年龄 为 25
设 身高 为 1.75
设 是学生 为 真

打印("──────────────────────────────────")
打印("姓名：")
打印(姓名)
打印("年龄：")
打印(年龄)
打印("身高：")
打印(身高)
打印("是学生：")
打印(是学生)
print("")

打印("关键概念：")
print("  • 设 变量名 为 值         — 声明并赋值")
print("  • 变量名 等于 值          — 重新赋值")
print("  • 支持中文变量名！（如「姓名」「年龄」）")
print("  • 也可以用「定义」替代「设」，含义相同")
print("")

# 重新赋值演示
设 年龄 为 26
打印("──────────────────────────────────")
打印("一年后，年龄变为：")
打印(年龄)
print("")

# f-string 字符串插值
打印("──── f-string 字符串插值 ────")
print("  在字符串前面加 f，就可以用花括号把变量嵌入文字中：")
print("  语法：f 加上引号，在引号内用 花括号 包裹变量名")
print("")

设 版本 为 1.11
打印("──────────────────────────────────")
打印(f"语言：{姓名}，版本：{版本}")
print("")
print("  f-string 让你不用反复用「加上」拼接字符串，")
print("  直接在字符串里用花括号包裹变量名就能嵌入值。")
print("")

打印("常见错误：")
print("  • 忘记「设」→ 直接写 姓名 = \"张三\" 会报错")
print("  • 变量名有空格 → 「我的 名字」不行，用「我的名字」")
print("  • 数字加了引号 → \"25\" 是字符串，不是数字，不能做数学运算")
print("")

# ── 本节小结 ──
打印("─── 第 2 节小结 ───")
print("  用「设」声明变量，用「为」赋值")
print("  支持数字、字符串、布尔值、空值")
print("  变量名可以用中文")
print("  f-string：f 加引号，花括号内写变量名，直接嵌入")
print("")

# ============================================================
#  第 3 节：算术运算（~3 分钟）
# ============================================================
打印("【第 3 节】算术运算")
print("")
打印("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")
print("  段言使用中文运算符，读起来就像数学公式：")
print("")

设 甲 为 10
设 乙 为 3

打印("──────────────────────────────────")
打印("甲 = 10, 乙 = 3")
print("")

设 和 为 甲 加上 乙
打印("甲 加上 乙  = ")
打印(和)

设 差 为 甲 减去 乙
打印("甲 减去 乙  = ")
打印(差)

设 积 为 甲 乘以 乙
打印("甲 乘以 乙  = ")
打印(积)

设 商 为 甲 除以 乙
打印("甲 除以 乙  = ")
打印(商)

设 余数 为 甲 取余 乙
打印("甲 取余 乙  = ")
打印(余数)

设 幂运算 为 甲 幂 乙
打印("甲 幂 乙   = ")
打印(幂运算)

设 整除结果 为 甲 整除 乙
打印("甲 整除 乙  = ")
打印(整除结果)
print("")

# 中文数字字面量
打印("──── 中文数字字面量 ────")
print("  段言支持直接用中文数字书写：")
print("")

设 结果 为 三 加 五
打印("三 加 五 = ")
打印(结果)
print("")
print("  支持的中文数字：零 一 二 三 四 五 六 七 八 九 十")
print("  也可以组合使用，如 十二 = 12")
print("")

打印("运算符速查表：")
print("  ┌────────┬──────────────────────┐")
print("  │  类别  │  运算符              │")
print("  ├────────┼──────────────────────┤")
print("  │  算术  │ 加上 减去 乘以 除以  │")
print("  │        │ 整除 取余 幂         │")
print("  ├────────┼──────────────────────┤")
print("  │  比较  │ 大于 小于 等于       │")
print("  │        │ 不等于 大于等于      │")
print("  │        │ 小于等于             │")
print("  ├────────┼──────────────────────┤")
print("  │  逻辑  │ 且 或 非             │")
print("  └────────┴──────────────────────┘")
print("")

# 比较运算演示
打印("──── 比较运算 ────")
打印("10 大于 3 →")
打印(甲 大于 乙)
打印("10 等于 3 →")
打印(甲 等于 乙)
print("")

打印("常见错误：")
print("  • 除以 和 整除 的区别：")
print("    10 除以 3  = 3.333...（小数）")
print("    10 整除 3  = 3（整数，丢掉小数部分）")
print("  • 优先级：乘除 > 加减，有括号先算括号")
print("  • 比较相等用「等于」，不是「=」")
print("")

# ── 本节小结 ──
打印("─── 第 3 节小结 ───")
print("  算术：加上 减去 乘以 除以 整除 取余 幂")
print("  比较：大于 小于 等于 不等于 大于等于 小于等于")
print("  逻辑：且 或 非")
print("  除以 得到小数，整除 得到整数")
print("  支持中文数字字面量：三 加 五 = 8")
print("")

# ============================================================
#  第 4 节：条件判断（~3 分钟）
# ============================================================
打印("【第 4 节】条件判断")
print("")
打印("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")
print("  条件判断让程序根据不同的情况做不同的事。")
print("  就像生活中的「如果...就...」一样自然。")
print("")
print("  语法格式：")
print("    如果 条件：")
print("        执行代码（4 个空格缩进）")
print("    否则如果 条件：")
print("        执行代码")
print("    否则：")
print("        执行代码")
print("")

设 分数 为 85
打印("──────────────────────────────────")
打印("分数 = 85")
print("")

如果 分数 大于等于 90：
    打印("成绩等级：优秀")
否则如果 分数 大于等于 80：
    打印("成绩等级：良好")
否则如果 分数 大于等于 70：
    打印("成绩等级：中等")
否则如果 分数 大于等于 60：
    打印("成绩等级：及格")
否则：
    打印("成绩等级：不及格")
print("")

# 逻辑运算演示
打印("──── 逻辑运算 ────")
设 甲 为 10
设 乙 为 5
设 丙 为 3
如果 甲 大于 乙 且 乙 大于 丙：
    打印("甲>乙>丙，条件链成立")

设 开关 为 假
如果 非 开关：
    打印("开关是关闭的")
print("")

打印("关键概念：")
print("  • 如果 条件：          — 条件判断")
print("  • 否则如果 条件：      — 多分支（可以有多个）")
print("  • 否则：              — 以上都不满足时执行")
print("  • 且 — 两个条件都满足")
print("  • 或 — 满足其中一个即可")
print("  • 非 — 取反")
print("  • 冒号「：」必须写！漏掉会报语法错误")
print("  • 缩进必须是 4 个空格，不能混用 Tab")
print("")

# 三元表达式
设 结果 为 "通过" 如果 分数 大于等于 60 否则 "未通过"
打印("──────────────────────────────────")
打印("单行写法（三元表达式）：")
打印(结果)
print("  语法：值1 如果 条件 否则 值2")
print("")

打印("常见错误：")
print("  • 漏写冒号「：」→ 如果 分数 大于 60 ← 忘了冒号！")
print("  • 缩进不对 → 必须 4 个空格，不是 2 个或 3 个")
print("  • 条件写反了 → 如果 60 大于 分数 ← 意思是「60 > 分数」")
print("  • 比较相等用「等于」→ 如果 分数 等于 100，不是 如果 分数 = 100")
print("")

# ── 本节小结 ──
打印("─── 第 4 节小结 ───")
print("  如果...否则如果...否则 做分支判断")
print("  且/或/非 连接多个条件")
print("  冒号后必须换行缩进 4 个空格")
print("  三元表达式：值1 如果 条件 否则 值2")
print("")

# ============================================================
#  第 5 节：循环（~3 分钟）
# ============================================================
打印("【第 5 节】循环")
print("")
打印("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")
print("  循环让程序重复执行一段代码，省去反复写相同语句的麻烦。")
print("  段言支持两种循环：「当」循环和「遍历」循环。")
print("")

# 当循环
打印("──── 当循环（while）────")
print("  当循环在条件满足时一直重复执行。")
print("  语法：当 条件：")
print("           执行代码")
print("")
设 计数 为 1
打印("从 1 数到 5：")
当 计数 小于等于 5：
    打印(计数)
    设 计数 为 计数 加上 1
print("")

# 遍历循环
打印("──── 遍历循环（for）────")
print("  遍历循环用于逐个处理列表中的每个元素。")
print("  语法：遍历 变量 于 列表：")
print("           执行代码")
print("")
打印("遍历列表 [10, 20, 30]：")
设 列表 为 [10, 20, 30]
遍历 项 于 列表：
    打印(项)
print("")

# 范围遍历
打印("──── 范围遍历（1至N）────")
print("  遍历 数 于 1至5：        → 输出 1, 2, 3, 4, 5")
print("  遍历 数 于 1到10步2：    → 输出 1, 3, 5, 7, 9")
print("")
遍历 数 于 1至5：
    打印(数)
print("")

# 跳过和跳出
打印("──── 跳过和跳出 ────")
print("  • 跳过 = continue — 跳过本次循环，继续下一次")
print("  • 跳出 = break    — 立即退出整个循环")
print("")
打印("跳过偶数，只打印奇数：")
遍历 项 于 1至10：
    如果 项 取余 2 等于 0：
        跳过
    打印(项)
print("")

打印("到 5 就停止：")
遍历 项 于 1至10：
    如果 项 大于 5：
        跳出
    打印(项)
print("")

打印("关键概念：")
print("  • 当 条件：           — while 循环（条件满足时循环）")
print("  • 遍历 项 于 列表：   — for 循环（遍历每个元素）")
print("  • 遍历 项 于 1至N：   — 范围遍历（从 1 到 N）")
print("  • 遍历 项 于 A到B步C： — 范围带步长")
print("  • 「跳出」= break     — 立即退出循环")
print("  • 「跳过」= continue  — 跳过本次循环，继续下一次")
print("")

打印("常见错误：")
print("  • 当循环条件永远为真 → 死循环！记得在循环体内改变条件")
print("  • 遍历空列表 → 循环体不会执行，这是正常的")
print("  • 循环体忘记缩进 → 代码不在循环内，只会执行一次")
print("")

# ── 本节小结 ──
打印("─── 第 5 节小结 ───")
print("  当循环：条件满足时重复执行")
print("  遍历循环：逐个处理列表元素")
print("  范围遍历：1至N 或 A到B步C")
print("  跳出 和 跳过 控制循环流程")
print("")

# ============================================================
#  第 6 节：段落（函数）（~3 分钟）
# ============================================================
打印("【第 6 节】段落（函数）")
print("")
打印("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")
print("  函数在段言中叫「段落」。")
print("  段落是一段可以重复使用的代码，把常用的操作封装起来。")
print("")
print("  语法格式：")
print("    段落 函数名 接收 参数1, 参数2：")
print("        执行代码")
print("        返回 结果     （可选）")
print("")
print("  调用：函数名(参数1, 参数2)")
print("")

# 声明段落
段落 加法 接收 甲, 乙：
    返回 甲 加上 乙

段落 阶乘 接收 数：
    如果 数 小于等于 1：
        返回 1
    返回 数 乘以 阶乘(数 减去 1)

段落 问候 接收 名字：
    打印(f"你好，{名字}！")

打印("──────────────────────────────────")
打印("定义并调用段落：")
print("")
打印("加法(3, 5) = ")
打印(加法(3, 5))
print("")
打印("阶乘(5) = 5x4x3x2x1 = ")
打印(阶乘(5))
print("")
问候("段言")
print("")

# 高阶函数演示
段落 应用 接收 函数, 值：
    返回 函数(值)

段落 平方 接收 甲：
    返回 甲 乘以 甲

打印("──────────────────────────────────")
打印("高阶函数：把函数当作参数传递")
打印("应用(平方, 6) = ")
打印(应用(平方, 6))
print("")

打印("关键概念：")
print("  • 段落 名称 接收 参数1, 参数2：")
print("  • 返回 值                  — 返回结果给调用者")
print("  • 支持递归调用（函数自己调用自己）")
print("  • 段落是「一等公民」，可以当参数传递给其他段落")
print("  • 没有参数时，可以省略「接收」")
print("")

打印("常见错误：")
print("  • 忘记写「返回」→ 段落不返回值，调用结果是空")
print("  • 参数数量不匹配 → 定义 2 个参数，调用时只传了 1 个")
print("  • 函数名和变量名冲突 → 不要用相同的名字")
print("  • 递归没有终止条件 → 会无限递归导致崩溃")
print("")

# ── 本节小结 ──
打印("─── 第 6 节小结 ───")
print("  段落 名称 接收 参数： 定义函数")
print("  返回 值 返回结果")
print("  支持递归和高阶函数")
print("  段落可当作参数传递")
print("")

