# 字典操作
打印("──── 字典操作 ────")
设 学生 为 {"姓名": "小明", "年龄": 20, "分数": 95}
打印("学生 = {\"姓名\": \"小明\", \"年龄\": 20, \"分数\": 95}")
print("")
打印("学生[\"姓名\"]：")
打印(学生["姓名"])
print("学生[\"年龄\"]：")
打印(学生["年龄"])
print("")

打印("遍历字典：")
遍历 键 于 学生：
    打印(f"  {键}: {学生[键]}")
print("")

打印("关键概念：")
print("  • 列表：[1, 2, 3]               — 用方括号")
print("  • 字典：{\"键\": \"值\"}             — 用花括号")
print("  • 切片：列表[起始:结束]          — 左闭右开")
print("  • 列表长度(列表)                — 获取元素个数")
print("  • 列表追加(列表, 元素)          — 末尾添加元素")
print("  • 列表弹出(列表, 索引)          — 移除并返回元素")
print("  • 列表推导：[表达式 遍历 变量 之 范围]")
print("  • 字符串用「加上」拼接，用「乘以」重复")
print("  • 索引从 0 开始！不是从 1！")
print("")

打印("常见错误：")
print("  • 索引越界 → 列表只有 5 个元素，却访问了 数列[5]")
print("  • 字典键不存在 → 字典里没有这个键")
print("  • 切片顺序 → 数列[3:0] 是空的，应该用 数列[0:3]")
print("  • 数字和字符串不能直接拼接 → 用 转字符串() 转换")
print("")

