# 数据分析模块
# 文体: 白话 (L1)

段落 加载数据 接收 文件路径:
    """从CSV文件加载数据"""
    设 数据 = []
    若 文件存在(文件路径):
        设 内容 = 读取文件(文件路径)
        设 行列表 = 分割字符串(内容, "\n")
        若 列表长度(行列表) > 1:
            设 表头 = 分割字符串(列表获取(行列表, 0), ",")
            设 索引 = 1
            当 索引 < 列表长度(行列表):
                设 行 = 列表获取(行列表, 索引)
                若 去除空白(行) != "":
                    设 值列表 = 分割字符串(行, ",")
                    设 记录 = 字典创建()
                    设 字段索引 = 0
                    当 字段索引 < 列表长度(表头):
                        字典设置(记录, 列表获取(表头, 字段索引), 列表获取(值列表, 字段索引))
                        字段索引 = 字段索引 + 1
                    列表追加(数据, 记录)
                索引 = 索引 + 1
    返回 数据

段落 计算统计量 接收 数据:
    """计算数据集的基本统计量"""
    若 列表长度(数据) == 0:
        返回 字典创建()
    设 统计结果 = 字典创建()
    设 样本 = 列表获取(数据, 0)
    遍历 字段, 值 于 样本:
        设 数值列表 = []
        遍历 行 于 数据:
            设 字段值 = 字典获取(行, 字段)
            若 字段值 != 空:
                设 数值 = 转浮点(字段值)
                列表追加(数值列表, 数值)
        若 列表长度(数值列表) > 0:
            设 总和 = 0
            设 最大值 = 列表获取(数值列表, 0)
            设 最小值 = 列表获取(数值列表, 0)
            遍历 数 于 数值列表:
                总和 = 总和 + 数
                若 数 > 最大值:
                    最大值 = 数
                若 数 < 最小值:
                    最小值 = 数
            设 平均值 = 总和 / 列表长度(数值列表)
            字典设置(统计结果, 字段, 字典创建(
                "平均值", 平均值,
                "最大值", 最大值,
                "最小值", 最小值,
                "总和", 总和,
                "数量", 列表长度(数值列表)
            ))
    返回 统计结果

段落 筛选数据 接收 数据, 字段, 条件, 阈值:
    """按条件筛选数据"""
    设 结果 = []
    遍历 行 于 数据:
        设 值 = 字典获取(行, 字段)
        若 值 != 空:
            设 数值 = 转浮点(值)
            若 条件(数值, 阈值):
                列表追加(结果, 行)
    返回 结果

段落 大于等于 接收 甲, 乙:
    返回 甲 >= 乙

段落 小于等于 接收 甲, 乙:
    返回 甲 <= 乙

段落 大于 接收 甲, 乙:
    返回 甲 > 乙

段落 小于 接收 甲, 乙:
    返回 甲 < 乙

段落 排序数据 接收 数据, 字段, 顺序:
    """排序数据"""
    设 结果 = 列表复制(数据)
    设 列表长度 = 列表长度(结果)
    设 外层 = 0
    当 外层 < 列表长度:
        设 内层 = 0
        当 内层 < 列表长度 - 外层 - 1:
            设 甲 = 转浮点(字典获取(列表获取(结果, 内层), 字段))
            设 乙 = 转浮点(字典获取(列表获取(结果, 内层 + 1), 字段))
            若 顺序 == "降序":
                若 甲 < 乙:
                    设 临时 = 列表获取(结果, 内层)
                    列表设置(结果, 内层, 列表获取(结果, 内层 + 1))
                    列表设置(结果, 内层 + 1, 临时)
            否则:
                若 甲 > 乙:
                    设 临时 = 列表获取(结果, 内层)
                    列表设置(结果, 内层, 列表获取(结果, 内层 + 1))
                    列表设置(结果, 内层 + 1, 临时)
            内层 = 内层 + 1
        外层 = 外层 + 1
    返回 结果

段落 生成报告 接收 统计结果, 输出路径:
    """生成分析报告"""
    设 报告行 = []
    列表追加(报告行, "===== 数据分析报告 =====")
    列表追加(报告行, "生成时间: " + 当前时间())
    列表追加(报告行, "")
    遍历 字段, 统计 于 统计结果:
        列表追加(报告行, "[" + 字段 + "]")
        列表追加(报告行, "  平均值: " + 转串(字典获取(统计, "平均值")))
        列表追加(报告行, "  最大值: " + 转串(字典获取(统计, "最大值")))
        列表追加(报告行, "  最小值: " + 转串(字典获取(统计, "最小值")))
        列表追加(报告行, "  数量: " + 转串(字典获取(统计, "数量")))
        列表追加(报告行, "")
    列表追加(报告行, "===== 报告结束 =====")
    写入文件(输出路径, 连接字符串(报告行, "\n"))