# 数据分析示例 - 主入口
# 文体: 白话 (L1)

从 分析 导入 加载数据, 计算统计量, 筛选数据, 排序数据, 生成报告

打印 "===== 光明数据分析工具 ====="
打印 ""

# 加载示例数据
设 原始数据 = 加载数据("data.csv")
打印 "已加载", 列表长度(原始数据), "条数据记录"

# 计算基本统计量
设 统计结果 = 计算统计量(原始数据)
打印 ""
打印 "===== 基本统计量 ====="
遍历 字段, 统计 于 统计结果:
    打印 字段, ":"
    打印 "  平均值:", 字典获取(统计, "平均值")
    打印 "  最大值:", 字典获取(统计, "最大值")
    打印 "  最小值:", 字典获取(统计, "最小值")
    打印 "  总和:", 字典获取(统计, "总和")

# 数据筛选
打印 ""
打印 "===== 数据筛选 ====="
设 筛选结果 = 筛选数据(原始数据, "年龄", 大于等于, 18)
打印 "年龄 >= 18 的记录数:", 列表长度(筛选结果)

# 数据排序
打印 ""
打印 "===== 数据排序 ====="
设 排序结果 = 排序数据(原始数据, "分数", 降序)
打印 "按分数降序排列前三名:"
设 前3 = 列表截取(排序结果, 0, 3)
遍历 行 于 前3:
    打印 "  ", 字典获取(行, "姓名"), ":", 字典获取(行, "分数")

# 生成报告
打印 ""
打印 "===== 分析报告 ====="
生成报告(统计结果, "report.txt")
打印 "报告已生成: report.txt"

打印 ""
打印 "===== 分析完成 ====="