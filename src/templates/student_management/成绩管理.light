# 成绩管理模块
# 文体: 白话 (L1)

# 全局成绩字典: 学生 -> {科目: 分数}
设 成绩字典 = 字典创建()

段落 添加成绩 接收 学生, 科目, 分数:
    """为学生添加一门成绩"""
    设 姓名 = 字典获取(学生, "姓名")
    设 学生成绩 = 字典获取(成绩字典, 姓名)
    若 学生成绩 == 空:
        学生成绩 = 字典创建()
        字典设置(成绩字典, 姓名, 学生成绩)
    字典设置(学生成绩, 科目, 分数)

段落 获取成绩 接收 学生, 科目:
    """获取学生某科成绩"""
    设 姓名 = 字典获取(学生, "姓名")
    设 学生成绩 = 字典获取(成绩字典, 姓名)
    若 学生成绩 != 空:
        返回 字典获取(学生成绩, 科目)
    返回 空

段落 计算平均分 接收 学生:
    """计算学生的平均分"""
    设 姓名 = 字典获取(学生, "姓名")
    设 学生成绩 = 字典获取(成绩字典, 姓名)
    若 学生成绩 == 空:
        返回 0
    设 总分 = 0
    设 科目数 = 0
    遍历 科目, 分数 于 学生成绩:
        总分 = 总分 + 分数
        科目数 = 科目数 + 1
    若 科目数 > 0:
        返回 总分 / 科目数
    返回 0

段落 成绩等级 接收 平均分:
    """根据平均分返回等级"""
    若 平均分 >= 90:
        返回 "优秀"
    若 平均分 >= 80:
        返回 "良好"
    若 平均分 >= 70:
        返回 "中等"
    若 平均分 >= 60:
        返回 "及格"
    返回 "不及格"