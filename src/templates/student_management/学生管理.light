# 学生管理模块
# 文体: 白话 (L1)

# 全局学生列表
设 学生列表 = []

段落 添加学生 接收 姓名, 年龄, 班级:
    """添加一名新学生"""
    设 学生 = 字典创建()
    字典设置(学生, "姓名", 姓名)
    字典设置(学生, "年龄", 年龄)
    字典设置(学生, "班级", 班级)
    字典设置(学生, "学号", 列表长度(学生列表) + 1)
    列表追加(学生列表, 学生)
    返回 学生

段落 查找学生 接收 姓名:
    """按姓名查找学生"""
    遍历 学生 于 学生列表:
        若 字典获取(学生, "姓名") == 姓名:
            返回 学生
    返回 空

段落 列出所有学生 接收:
    """列出所有学生"""
    返回 学生列表

段落 获取学生总数 接收:
    """获取学生总数"""
    返回 列表长度(学生列表)