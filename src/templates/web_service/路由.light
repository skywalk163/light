# 路由模块
# 文体: 白话 (L1)

设 路由表 = 字典创建()

段落 注册路由 接收 方法, 路径, 处理函数:
    """注册一个路由"""
    设 键 = 方法 + ":" + 路径
    字典设置(路由表, 键, 处理函数)
    打印 "已注册路由:", 方法, 路径

段落 处理请求 接收 请求:
    """处理HTTP请求并返回响应"""
    设 方法 = 字典获取(请求, "method", "GET")
    设 路径 = 字典获取(请求, "path", "/")
    设 键 = 方法 + ":" + 路径
    设 处理函数 = 字典获取(路由表, 键)
    若 处理函数 != 空:
        返回 处理函数(请求)
    返回 字典创建(
        "status", 404,
        "body", "{\"error\": \"未找到路由\"}"
    )

段落 启动服务 接收 端口:
    """启动HTTP服务"""
    打印 "服务已启动，监听端口:", 端口
    打印 "请在浏览器中访问 http://localhost:" + 转串(端口) + "/hello"
    打印 "按 Ctrl+C 停止服务"
    # 实际项目中会使用 HTTP 模块启动真实服务器
    打印 ""
    打印 "===== 服务运行中 ====="