# Web 服务示例 - 主入口
# 文体: 白话 (L1)
# 引用 HTTP contrib 模块处理网络请求

从 路由 导入 注册路由, 处理请求, 启动服务

打印 "===== 光明 Web 服务 ====="
打印 ""

# 注册路由：GET /hello
段落 处理问候 接收 请求:
    返回 字典创建(
        "status", 200,
        "body", "{\"message\": \"你好，世界！\", \"code\": \"light-lang\"}"
    )

注册路由("GET", "/hello", 处理问候)

# 注册路由：GET /api/status
段落 处理状态 接收 请求:
    返回 字典创建(
        "status", 200,
        "body", "{\"status\": \"running\", \"version\": \"1.0.0\"}"
    )

注册路由("GET", "/api/status", 处理状态)

# 注册路由：POST /api/echo
段落 处理回显 接收 请求:
    设 请求体 = 字典获取(请求, "body", "{}")
    返回 字典创建(
        "status", 200,
        "body", "{\"echo\": " + 请求体 + "}"
    )

注册路由("POST", "/api/echo", 处理回显)

打印 "路由注册完成："
打印 "  GET  /hello"
打印 "  GET  /api/status"
打印 "  POST /api/echo"
打印 ""

# 启动服务
打印 "正在启动服务..."
启动服务(8080)