# CLI记事本 - 光明开源项目示例
# 文体: 白话 (L1)
# 功能：命令行记事本，支持新建、查看、编辑、删除、搜索笔记

# === 数据存储 ===
设 笔记列表 = []
设 数据文件 = "notes.json"

# === 核心功能 ===

段 显示菜单():
    打印 ""
    打印 "================================="
    打印 "        光明 CLI 记事本"
    打印 "================================="
    打印 "1. 新建笔记"
    打印 "2. 查看所有笔记"
    打印 "3. 查看笔记详情"
    打印 "4. 删除笔记"
    打印 "5. 搜索笔记"
    打印 "6. 保存到文件"
    打印 "7. 从文件读取"
    打印 "0. 退出"
    打印 "================================="

段 新建笔记():
    打印 ""
    打印 "--- 新建笔记 ---"
    设 标题 = 读取("请输入标题：")
    如果 标题 等于 "":
        打印 "标题不能为空！"
        返回
    设 内容 = 读取("请输入内容：")
    设 标签 = 读取("请输入标签（逗号分隔，可选）：")

    设 笔记 = {
        "标题": 标题,
        "内容": 内容,
        "标签": 标签,
        "编号": 笔记列表的长度 + 1
    }
    笔记列表的 添加 笔记
    打印 "笔记「", 标题, "」已创建！"

段 查看所有():
    打印 ""
    打印 "--- 所有笔记 ---"
    如果 笔记列表的长度 等于 0:
        打印 "暂无笔记"
        返回

    打印 "编号\t标题\t\t标签"
    打印 "--------------------------------"
    遍 笔记列表 为 n:
        打印 n["编号"], "\t", n["标题"], "\t\t", n["标签"]

段 查看详情():
    打印 ""
    打印 "--- 查看笔记详情 ---"
    设 编号 = 读取("请输入笔记编号：")
    设 编号 = 整数(编号)
    设 找到 = 假

    遍 笔记列表 为 n:
        如果 n["编号"] 等于 编号:
            打印 "标题：", n["标题"]
            打印 "内容：", n["内容"]
            打印 "标签：", n["标签"]
            设 找到 = 真

    如果 找到 等于 假:
        打印 "未找到编号为", 编号, "的笔记"

段 删除笔记():
    打印 ""
    打印 "--- 删除笔记 ---"
    设 编号 = 读取("请输入要删除的笔记编号：")
    设 编号 = 整数(编号)
    设 新列表 = []
    设 删除的 = 假

    遍 笔记列表 为 n:
        如果 n["编号"] 等于 编号:
            打印 "已删除笔记：", n["标题"]
            设 删除的 = 真
        否则:
            新列表的 添加 n

    如果 删除的:
        设 笔记列表 = 新列表
        # 重新编号
        设 索引 = 1
        遍 笔记列表 为 n:
            n["编号"] = 索引
            设 索引 = 索引 + 1
    否则:
        打印 "未找到编号为", 编号, "的笔记"

段 搜索笔记():
    打印 ""
    打印 "--- 搜索笔记 ---"
    设 关键词 = 读取("请输入搜索关键词：")
    设 结果 = []
    设 计数 = 0

    遍 笔记列表 为 n:
        如果 n["标题"] 包含 关键词 或 n["内容"] 包含 关键词:
            结果的 添加 n
            设 计数 = 计数 + 1

    如果 计数 等于 0:
        打印 "未找到包含「", 关键词, "」的笔记"
    否则:
        打印 "找到", 计数, "条匹配结果："
        遍 结果 为 r:
            打印 "  [", r["编号"], "] ", r["标题"]

段 保存到文件():
    打印 ""
    打印 "--- 保存到文件 ---"
    设 文件 = 打开(数据文件, "w")
    文件的 写入 "[\n"
    遍 笔记列表 为 i:
        设 笔记 = 笔记列表[i - 1]  # i 从1开始
        文件的 写入 "  {\n"
        文件的 写入 "    \"编号\": " + 串(笔记["编号"]) + ",\n"
        文件的 写入 "    \"标题\": \"" + 笔记["标题"] + "\",\n"
        文件的 写入 "    \"内容\": \"" + 笔记["内容"] + "\",\n"
        文件的 写入 "    \"标签\": \"" + 笔记["标签"] + "\"\n"
        如果 i < 笔记列表的长度:
            文件的 写入 "  },\n"
        否则:
            文件的 写入 "  }\n"
    文件的 写入 "]\n"
    文件的 关闭
    打印 "已保存", 笔记列表的长度, "条笔记到", 数据文件

段 从文件读取():
    打印 ""
    打印 "--- 从文件读取 ---"
    试:
        设 文件 = 打开(数据文件, "r")
        设 内容 = 文件的 读取
        文件的 关闭
        打印 "已读取", 内容的长度, "字符"
        打印 "提示：请先通过「新建笔记」添加数据后再保存"
    捕 错误:
        打印 "读取失败：", 错误

# === 主程序 ===
打印 "欢迎使用光明 CLI 记事本！"
设 运行中 = 真
当 运行中:
    显示菜单()
    设 选择 = 读取("请选择操作（0-7）：")
    设 选择 = 整数(选择)

    如果 选择 等于 1:
        新建笔记()
    如果 选择 等于 2:
        查看所有()
    如果 选择 等于 3:
        查看详情()
    如果 选择 等于 4:
        删除笔记()
    如果 选择 等于 5:
        搜索笔记()
    如果 选择 等于 6:
        保存到文件()
    如果 选择 等于 7:
        从文件读取()
    如果 选择 等于 0:
        设 运行中 = 假
        打印 "感谢使用，再见！"