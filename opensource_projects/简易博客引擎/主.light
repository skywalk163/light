# 简易博客引擎 - 光明开源项目示例
# 文体: 白话 (L1)
# 功能：支持文章管理、分类、标签、评论的简易博客引擎

# === 数据存储 ===
设 文章列表 = []
设 分类列表 = ["技术", "生活", "学习", "其他"]
设 下一个文章编号 = 1

# === 文章管理模块 ===

段 创建文章(标题, 内容, 作者, 分类, 标签):
    设 文章 = {
        "编号": 下一个文章编号,
        "标题": 标题,
        "内容": 内容,
        "作者": 作者,
        "分类": 分类,
        "标签": 标签,
        "评论": []
    }
    文章列表的 添加 文章
    设 下一个文章编号 = 下一个文章编号 + 1
    打印 "文章「", 标题, "」已发布！编号：", 文章["编号"]
    返回 文章

段 获取文章(编号):
    遍 文章列表 为 a:
        如果 a["编号"] 等于 编号:
            返回 a
    返回 空

段 删除文章(编号):
    设 新列表 = []
    设 找到 = 假
    遍 文章列表 为 a:
        如果 a["编号"] 等于 编号:
            打印 "已删除文章：", a["标题"]
            设 找到 = 真
        否则:
            新列表的 添加 a
    如果 找到:
        设 文章列表 = 新列表
    返回 找到

段 按分类查询(分类):
    设 结果 = []
    遍 文章列表 为 a:
        如果 a["分类"] 等于 分类:
            结果的 添加 a
    返回 结果

段 按标签查询(标签):
    设 结果 = []
    遍 文章列表 为 a:
        如果 a["标签"] 包含 标签:
            结果的 添加 a
    返回 结果

# === 评论模块 ===

段 添加评论(文章编号, 评论者, 内容):
    设 文章 = 获取文章(文章编号)
    如果 文章 等于 空:
        打印 "文章不存在！"
        返回 假
    设 评论 = {
        "评论者": 评论者,
        "内容": 内容,
        "编号": 文章["评论"].长度 + 1
    }
    文章["评论"]的 添加 评论
    打印 "评论已添加！"
    返回 真

# === 显示模块 ===

段 显示文章列表():
    打印 ""
    打印 "================================="
    打印 "        光明博客引擎"
    打印 "================================="
    如果 文章列表的长度 等于 0:
        打印 "暂无文章，快来发布第一篇吧！"
        返回

    打印 "共", 文章列表的长度, "篇文章"
    打印 ""
    遍 文章列表 为 a:
        打印 "[", a["编号"], "] ", a["标题"]
        打印 "    作者：", a["作者"], "  分类：", a["分类"], "  标签：", a["标签"]
        打印 "    评论数：", a["评论"].长度
        打印 ""

段 显示文章详情(编号):
    设 文章 = 获取文章(编号)
    如果 文章 等于 空:
        打印 "文章不存在！"
        返回

    打印 ""
    打印 "================================="
    打印 "标题：", 文章["标题"]
    打印 "作者：", 文章["作者"]
    打印 "分类：", 文章["分类"]
    打印 "标签：", 文章["标签"]
    打印 "================================="
    打印 文章["内容"]
    打印 "================================="
    打印 "评论（", 文章["评论"].长度, "条）："
    如果 文章["评论"].长度 等于 0:
        打印 "暂无评论"
    遍 文章["评论"] 为 c:
        打印 "  [", c["编号"], "] ", c["评论者"], "：", c["内容"]

段 显示分类列表():
    打印 ""
    打印 "--- 分类列表 ---"
    遍 分类列表 为 c:
        设 计数 = 按分类查询(c).长度
        打印 c, "（", 计数, "篇）"

# === 主程序 ===

打印 "光明简易博客引擎 v1.0"
打印 ""

# 创建示例数据
设 文章1 = 创建文章(
    "光明编程语言入门指南",
    "光明（LightLang）是一款面向中文用户的编程语言，支持白话体和文言体两种风格。本文介绍了光明的基本语法和特性。",
    "张三",
    "技术",
    "光明,入门,教程"
)

设 文章2 = 创建文章(
    "我的编程学习心得",
    "学习编程是一件有趣的事情。从最初的Hello World到现在的项目开发，每一步都充满了挑战和收获。",
    "李四",
    "学习",
    "编程,学习,心得"
)

设 文章3 = 创建文章(
    "用光明写一个记事本应用",
    "本文将介绍如何用光明开发一个命令行记事本应用，涵盖文件IO、列表操作、用户交互等知识点。",
    "张三",
    "技术",
    "光明,记事本,教程"
)

# 添加评论
添加评论(1, "王五", "好文章！学习了！")
添加评论(1, "赵六", "期待更多光明教程")
添加评论(2, "张三", "很有共鸣，加油！")

# 显示内容
显示文章列表()
显示文章详情(1)
显示分类列表()

# 按分类查询
打印 ""
打印 "--- 技术类文章 ---"
设 技术文章 = 按分类查询("技术")
遍 技术文章 为 t:
    打印 "  - ", t["标题"]

打印 ""
打印 "程序运行完成！"