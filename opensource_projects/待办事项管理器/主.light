# 待办事项管理器 - 光明开源项目示例
# 文体: 白话 (L1)
# 功能：支持添加、完成、筛选、排序待办事项的命令行工具

# === 数据存储 ===
设 待办列表 = []
设 下一个编号 = 1

# === 待办事项管理 ===

段 添加待办(标题, 优先级, 分类):
    设 待办 = {
        "编号": 下一个编号,
        "标题": 标题,
        "优先级": 优先级,
        "分类": 分类,
        "已完成": 假,
        "创建时间": "2026-08-08"
    }
    待办列表的 添加 待办
    设 下一个编号 = 下一个编号 + 1
    打印 "已添加待办：", 标题

段 完成待办(编号):
    遍 待办列表 为 t:
        如果 t["编号"] 等于 编号:
            t["已完成"] = 真
            打印 "已完成：", t["标题"]
            返回 真
    打印 "未找到编号为", 编号, "的待办"
    返回 假

段 删除待办(编号):
    设 新列表 = []
    设 找到 = 假
    遍 待办列表 为 t:
        如果 t["编号"] 等于 编号:
            打印 "已删除：", t["标题"]
            设 找到 = 真
        否则:
            新列表的 添加 t
    如果 找到:
        设 待办列表 = 新列表
    返回 找到

段 获取待办(编号):
    遍 待办列表 为 t:
        如果 t["编号"] 等于 编号:
            返回 t
    返回 空

# === 显示与筛选 ===

段 显示所有(显示已完成):
    打印 ""
    打印 "================================="
    打印 "        待办事项列表"
    打印 "================================="
    如果 待办列表的长度 等于 0:
        打印 "暂无待办事项"
        返回

    设 计数 = 0
    遍 待办列表 为 t:
        如果 显示已完成 等于 假 且 t["已完成"]:
            跳过
        设 状态 = "✓"
        如果 t["已完成"] 等于 假:
            设 状态 = " "
        打印 "[", 状态, "] [", t["编号"], "] ", t["标题"]
        打印 "    优先级：", t["优先级"], "  分类：", t["分类"]
        设 计数 = 计数 + 1

    如果 计数 等于 0:
        打印 "没有符合条件的待办事项"

段 按优先级筛选(级别):
    打印 ""
    打印 "--- 优先级为「", 级别, "」的待办 ---"
    遍 待办列表 为 t:
        如果 t["优先级"] 等于 级别:
            设 状态 = "✓"
            如果 t["已完成"] 等于 假:
                设 状态 = " "
            打印 "[", 状态, "] ", t["标题"]

段 按分类筛选(类别):
    打印 ""
    打印 "--- 分类为「", 类别, "」的待办 ---"
    遍 待办列表 为 t:
        如果 t["分类"] 等于 类别:
            设 状态 = "✓"
            如果 t["已完成"] 等于 假:
                设 状态 = " "
            打印 "[", 状态, "] ", t["标题"]

段 统计信息():
    打印 ""
    打印 "--- 统计信息 ---"
    设 总数 = 待办列表的长度
    设 已完成数 = 0
    设 未完成数 = 0
    遍 待办列表 为 t:
        如果 t["已完成"]:
            设 已完成数 = 已完成数 + 1
        否则:
            设 未完成数 = 未完成数 + 1

    打印 "总待办：", 总数
    打印 "已完成：", 已完成数
    打印 "未完成：", 未完成数
    如果 总数 > 0:
        打印 "完成率：", 串(已完成数 * 100 / 总数) + "%"

# === 菜单交互 ===

段 显示菜单():
    打印 ""
    打印 "================================="
    打印 "        待办事项管理器"
    打印 "================================="
    打印 "1. 添加待办"
    打印 "2. 完成待办"
    打印 "3. 删除待办"
    打印 "4. 显示所有待办"
    打印 "5. 显示未完成待办"
    打印 "6. 按优先级筛选"
    打印 "7. 按分类筛选"
    打印 "8. 统计信息"
    打印 "0. 退出"
    打印 "================================="

# === 主程序 ===

# 创建示例数据
添加待办("学习光明列表操作", "高", "学习")
添加待办("完成K12课程教案", "高", "工作")
添加待办("购买日用品", "低", "生活")
添加待办("整理读书笔记", "中", "学习")
添加待办("提交项目报告", "高", "工作")

打印 ""
打印 "欢迎使用待办事项管理器！"
设 运行中 = 真
当 运行中:
    显示菜单()
    设 选择 = 读取("请选择操作（0-8）：")
    设 选择 = 整数(选择)

    如果 选择 等于 1:
        设 标题 = 读取("请输入标题：")
        设 优先级 = 读取("请输入优先级（高/中/低）：")
        设 分类 = 读取("请输入分类（学习/工作/生活）：")
        添加待办(标题, 优先级, 分类)
    如果 选择 等于 2:
        设 编号 = 读取("请输入待办编号：")
        完成待办(整数(编号))
    如果 选择 等于 3:
        设 编号 = 读取("请输入待办编号：")
        删除待办(整数(编号))
    如果 选择 等于 4:
        显示所有(真)
    如果 选择 等于 5:
        显示所有(假)
    如果 选择 等于 6:
        设 级别 = 读取("请输入优先级（高/中/低）：")
        按优先级筛选(级别)
    如果 选择 等于 7:
        设 类别 = 读取("请输入分类（学习/工作/生活）：")
        按分类筛选(类别)
    如果 选择 等于 8:
        统计信息()
    如果 选择 等于 0:
        设 运行中 = 假
        打印 "感谢使用，再见！"