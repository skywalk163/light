class进程锁:
    def__init__(self):
        self._锁=_创建进程锁()
    
    def加锁(self,阻塞=真,超时=无):
        返回_进程锁加锁(self._锁,阻塞,超时)
    
    def解锁(self):
        _进程锁解锁(self._锁)