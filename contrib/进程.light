class进程:
    def__init__(self,函数,*参数,名称=无,守护进程=假,**关键字参数):
        self._函数=函数
        self._参数=参数
        self._关键字参数=关键字参数
        self._结果=无
        self._异常=无
        self._已完成=假
        self._进程=无
    
    def开始(self):
        self._进程=_创建进程(self._函数,self._参数,self._关键字参数,self)
    
    def等待(self,超时=无):
        返回_等待进程(self._进程,超时)
    
    def是否存活(self):
        返回_进程是否存活(self._进程)
    
    def获取结果(self,超时=无):
        返回_进程获取结果(self._进程,超时)
    
    def终止(self):
        _终止进程(self._进程)
    
    def强制终止(self):
        _强制终止进程(self._进程)


class进程池:
    def__init__(self,进程数=无):
        self._进程数=进程数或CPU核心数()
        self._池=无
    
    def启动(self):
        self._池=_创建进程池(self._进程数)
    
    def应用(self,函数,*参数,**关键字参数):
        如果self._池是无:
            self.启动()
        返回_进程池应用(self._池,函数,参数,关键字参数)
    
    def异步应用(self,函数,*参数,回调=无,错误回调=无,**关键字参数):
        如果self._池是无:
            self.启动()
        返回_进程池异步应用(self._池,函数,参数,关键字参数,回调,错误回调)
    
    def映射(self,函数,可迭代对象,分块大小=无):
        如果self._池是无:
            self.启动()
        返回_进程池映射(self._池,函数,可迭代对象,分块大小)
    
    def关闭(self,等待=真):
        如果self._池不是无:
            _进程池关闭(self._池,等待)
            self._池=无
    
    def取进程数(self):
        返回self._进程数


class进程队列:
    def__init__(self,最大容量=0):
        self._队列=_创建进程队列(最大容量)
    
    def入队(self,项目,阻塞=真,超时=无):
        _进程队列入队(self._队列,项目,阻塞,超时)
    
    def出队(self,阻塞=真,超时=无):
        返回_进程队列出队(self._队列,阻塞,超时)
    
    def空(self):
        返回_进程队列空(self._队列)
    
    def满(self):
        返回_进程队列满(self._队列)
    
    def关闭(self):
        _进程队列关闭(self._队列)


class管道:
    def__init__(self,双工=真):
        self._父端=无
        self._子端=无
        self._本端=无
        self._对端=无
        self._管道=_创建管道(双工)
    
    def标记父端(self):
        self._本端=_管道父端(self._管道)
        self._对端=_管道子端(self._管道)
    
    def标记子端(self):
        self._本端=_管道子端(self._管道)
        self._对端=_管道父端(self._管道)
    
    def发送(self,数据):
        如果self._本端是无:
            抛出错误("请先标记使用哪一端")
        _管道发送(self._本端,数据)
    
    def接收(self):
        如果self._本端是无:
            抛出错误("请先标记使用哪一端")
        返回_管道接收(self._本端)
    
    def可接收(self,超时=0.0):
        如果self._本端是无:
            抛出错误("请先标记使用哪一端")
        返回_管道可接收(self._本端,超时)
    
    def关闭本端(self):
        如果self._本端不是无:
            _管道关闭(self._本端)
            self._本端=无
    
    def关闭对端(self):
        如果self._对端不是无:
            _管道关闭(self._对端)
            self._对端=无


