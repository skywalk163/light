# class进程:
#     def__init__(self,函数,*参数,名称=无,守护进程=假,**关键字参数):
#
#     def开始(self):
#
#     def等待(self,超时=无):
#
#     def是否存活(self):
#
#     def获取结果(self,超时=无):
#
#     def终止(self):
#
#     def强制终止(self):
#
# class进程池:
#     def__init__(self,进程数=无):
#
#     def启动(self):
#
#     def应用(self,函数,*参数,**关键字参数):
#
#     def异步应用(self,函数,*参数,回调=无,错误回调=无,**关键字参数):
#
#     def映射(self,函数,可迭代对象,分块大小=无):
#
#     def关闭(self,等待=真):
#
#     def取进程数(self):
#         返回self._进程数
#
# class进程队列:
#     def__init__(self,最大容量=0):
#
#     def入队(self,项目,阻塞=真,超时=无):
#
#     def出队(self,阻塞=真,超时=无):
#
#     def空(self):
#
#     def满(self):
#
#     def关闭(self):
#
# class管道:
#     def__init__(self,双工=真):
#
#     def标记父端(self):
#
#     def标记子端(self):
#
#     def发送(self,数据):
#             抛出错误("请先标记使用哪一端")
