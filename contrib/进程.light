# class共享值:
#     def__init__(self,类型码,初始值=无):
#
#     def获取(self):
#
#     def设置(self,值):
#
# class共享数组:
#     def__init__(self,类型码,大小或初始值):
#
#     def获取(self,索引):
#
#     def设置(self,索引,值):
#
#     def长度(self):
