class 插件异常(异常):
    pass


class 插件加载异常(插件异常):
    pass


class 插件未找到异常(插件异常):
    pass


class 插件:
    名称=''
    版本='1.0.0'
    描述=''
    作者=''
    
    def初始化():
        self._已启用=假
    
    def初始化插件():
        pass
    
    def启动():
        pass
    
    def停止():
        pass
    
    def销毁():
        pass
    
    def是否已启用():
        return self._已启用


class 插件管理器:
    def初始化():
        self._插件字典={}
        self._插件类字典={}
        self._插件路径列表=[]
        self._扩展点字典={}
    
    def添加插件路径(路径):
        如果路径不在self._插件路径列表:
            self._插件路径列表.追加(路径)
    
    def加载插件(插件名):
        如果插件名在self._插件字典:
            return self._插件字典[插件名]
        
        插件类=self._查找插件类(插件名)
        如果不是插件类:
            抛出插件未找到异常('插件'+插件名+'未找到')
        
        插件实例=插件类()
        插件实例.初始化插件()
        插件实例._已启用=真
        插件实例.启动()
        
        self._插件字典[插件名]=插件实例
        self._插件类字典[插件名]=插件类
        
        return插件实例
    
    def卸载插件(插件名):
        如果插件名不在self._插件字典:
            抛出插件未找到异常('插件'+插件名+'未找到')
        
        插件实例=self._插件字典[插件名]
        插件实例.停止()
        插件实例.销毁()
        插件实例._已启用=假
        
        删除self._插件字典[插件名]
    
    def重新加载插件(插件名):
        如果插件名在self._插件字典:
            self.卸载插件(插件名)
        
        return self.加载插件(插件名)
    
    def获取插件(插件名):
        return self._插件字典.获取(插件名)
    
    def获取所有插件():
        return self._插件字典.复制()
    
    def插件列表():
        return列表(self._插件字典.键())
    
    def已加载(插件名):
        return插件名在self._插件字典
    
    def启用插件(插件名):
        插件=self.获取插件(插件名)
        如果插件且不是插件.是否已启用():
            插件.启动()
            插件._已启用=真
    
    def禁用插件(插件名):
        插件=self.获取插件(插件名)
        如果插件且插件.是否已启用():
            插件.停止()
            插件._已启用=假
    
    def注册扩展点(扩展点名,回调函数):
        如果扩展点名不在self._扩展点字典:
            self._扩展点字典[扩展点名]=[]
        self._扩展点字典[扩展点名].追加(回调函数)
    
    def触发扩展点(扩展点名,*参数,**关键字参数):
        结果列表=[]
        如果扩展点名在self._扩展点字典:
            对于回调在self._扩展点字典[扩展点名]:
                结果=回调(*参数,**关键字参数)
                结果列表.追加(结果)
        return结果列表
    
    def加载目录(目录路径):
        已加载插件=[]
        如果不是_目录存在(目录路径):
            return已加载插件
        
        self.添加插件路径(目录路径)
        
        对于文件名在_列出目录(目录路径):
            如果文件名.以结尾('.py')且不是文件名.以开头('_'):
                插件名=文件名[:-3]
                尝试:
                    self.加载插件(插件名)
                    已加载插件.追加(插件名)
                除异常:
                    跳过
        
        return已加载插件
    
    def销毁所有():
        对于插件名在列表(self._插件字典.键()):
            尝试:
                self.卸载插件(插件名)
            除异常:
                跳过


class 插件装饰器:
    def初始化(名称='',版本='1.0.0',描述=''):
        self.名称=名称
        self.版本=版本
        self.描述=描述
    
    def__调用__(类):
        类.名称=self.名称或类.__名称__
        类.版本=self.版本
        类.描述=self.描述
        return类


class 动态模块加载器:
    @静态方法
    def从文件加载(文件路径,模块名=无):
        如果不是_文件存在(文件路径):
            抛出插件加载异常('文件不存在:'+文件路径)
        
        模块名=模块名或_文件名(文件路径)
        
        return_从文件加载模块(文件路径,模块名)
    
    @静态方法
    def从字符串加载(代码,模块名='动态模块'):
        return_从字符串加载模块(代码,模块名)
    
    @静态方法
    def重新加载模块(模块名):
        return_重新加载模块(模块名)


class 热更新管理器:
    def初始化():
        self._模块列表=[]
        self._文件时间戳={}
    
    def监控模块(模块名,文件路径):
        self._模块列表.追加(模块名)
        self._文件时间戳[文件路径]=_获取文件修改时间(文件路径)
    
    def检查更新():
        更新列表=[]
        
        对于文件路径,旧时间戳在self._文件时间戳.项():
            尝试:
                新时间戳=_获取文件修改时间(文件路径)
                如果新时间戳>旧时间戳:
                    self._文件时间戳[文件路径]=新时间戳
                    模块名=_文件名(文件路径)
                    更新列表.追加(模块名)
            除异常:
                跳过
        
        return更新列表
    
    def自动更新():
        结果={}
        更新的模块=self.检查更新()
        
        对于模块名在更新的模块:
            尝试:
                动态模块加载器.重新加载模块(模块名)
                结果[模块名]=真
            除异常:
                结果[模块名]=假
        
        return结果


def创建插件管理器():
    return插件管理器()


def创建热更新管理器():
    return热更新管理器()


def动态加载文件(文件路径,模块名=无):
    return动态模块加载器.从文件加载(文件路径,模块名)


def动态加载代码(代码,模块名='动态模块'):
    return动态模块加载器.从字符串加载(代码,模块名)