class工作流节点:
    def__init__(self,名称,函数=无,描述=""):
        self.名称=名称
        self.函数=函数
        self.描述=描述
        self.状态="待执行"
        self.结果=无
        self.异常=无
        self.依赖=[]
        self.下游节点=[]
        self.开始时间=无
        self.结束时间=无
        self.重试次数=0
        self.最大重试次数=0
        self.条件函数=无

    def添加依赖(self,*节点):
        对于n在节点:
            如果n不在self.依赖:
                self.依赖.追加(n)
                如果self不在n.下游节点:
                    n.下游节点.追加(self)

    def设置条件(self,条件函数):
        self.条件函数=条件函数

    def可执行(self,上下文):
        对于依赖节点在self.依赖:
            如果依赖节点.状态!="已完成"并且依赖节点.状态!="已跳过":
                返回假
        返回真

    def应执行(self,上下文):
        如果self.条件函数:
            尝试:
                返回布尔值(self.条件函数(上下文))
            捕获错误:
                返回假
        返回真

    def执行(self,上下文):
        self.状态="执行中"
        self.开始时间=_当前时间()

        尝试:
            如果self.函数:
                self.结果=self.函数(上下文)
            self.状态="已完成"
            上下文[self.名称]=self.结果
        捕获错误e:
            self.异常=e
            如果self.重试次数<self.最大重试次数:
                self.重试次数+=1
                self.状态="待执行"
                抛出错误(e)
            self.状态="失败"
            抛出错误(e)
        最后:
            self.结束时间=_当前时间()

        返回self.结果

    def耗时(self):
        如果self.开始时间并且self.结束时间:
            返回self.结束时间-self.开始时间
        返回无

class工作流:
    def__init__(self,名称="工作流",描述=""):
        self.名称=名称
        self.描述=描述
        self.工作流标识=_生成标识()
        self._节点={}
        self._上下文={}
        self.状态="待运行"
        self.开始时间=无
        self.结束时间=无
        self._锁=_创建互斥锁()
        self._运行线程=无
        self._执行线程数=4

    def添加节点(self,节点):
        如果节点.名称在self._节点:
            抛出错误("节点"+节点.名称+"已存在")
        self._节点[节点.名称]=节点
        返回节点

    def创建节点(self,名称,函数=无,描述="",依赖=无):
        节点=工作流节点(名称,函数,描述)

        如果依赖:
            对于依赖名在依赖:
                如果依赖名在self._节点:
                    节点.添加依赖(self._节点[依赖名])
                否则:
                    抛出错误("依赖节点"+依赖名+"不存在")

        返回self.添加节点(节点)

    def添加依赖(self,节点名称,*依赖名称):
        如果节点名称不在self._节点:
            抛出错误("节点"+节点名称+"不存在")

        节点=self._节点[节点名称]
        对于依赖名在依赖名称:
            如果依赖名不在self._节点:
                抛出错误("依赖节点"+依赖名+"不存在")
            节点.添加依赖(self._节点[依赖名])

    def验证(self):
        访问状态={}

        defDFS(节点名称):
            访问状态[节点名称]=1
            节点=self._节点[节点名称]

            对于下游在节点.下游节点:
                如果下游.名称不在访问状态:
                    如果不DFS(下游.名称):
                        返回假
                否则如果访问状态[下游.名称]==1:
                    返回假

            访问状态[节点名称]=2
            返回真

        对于名称在self._节点:
            如果名称不在访问状态:
                如果不DFS(名称):
                    返回假

        返回真

    def获取入度节点(self):
        入度={名称:长度(节点.依赖)对于名称,节点在self._节点.项()}
        返回[名称对于名称,度在入度.项()如果度==0]

    def拓扑排序(self):
        入度={名称:长度(节点.依赖)对于名称,节点在self._节点.项()}
        队列=_创建双端队列([名称对于名称,度在入度.项()如果度==0])
        结果=[]

        当队列:
            节点名称=队列.左侧弹出()
            结果.追加(节点名称)

            对于下游在self._节点[节点名称].下游节点:
                入度[下游.名称]-=1
                如果入度[下游.名称]==0:
                    队列.追加(下游.名称)

        如果长度(结果)!=长度(self._节点):
            抛出错误("工作流中存在环")

        返回结果

    def执行(self,初始上下文=无):
        如果self.状态=="运行中":
            抛出错误("工作流正在运行")

        如果不self.验证():
            抛出错误("工作流验证失败，可能存在环")

        self.状态="运行中"
        self.开始时间=_当前时间()
        self._上下文=初始上下文.复制()如果初始上下文否则{}

        对于节点在self._节点.值():
            节点.状态="待执行"
            节点.结果=无
            节点.异常=无
            节点.开始时间=无
            节点.结束时间=无

        尝试:
            self._并行执行()
            self.状态="已完成"
        捕获错误:
            self.状态="失败"
            抛出
        最后:
            self.结束时间=_当前时间()

        返回self._上下文

    def_并行执行(self):
        线程池=[]
        完成事件=_创建事件()
        错误=[无]

        def工作线程():
            当不完成事件.是否已设置():
                _加锁(self._锁)
                尝试:
                    待执行节点=无
                    对于节点在self._节点.值():
                        如果节点.状态=="待执行"并且节点.可执行(self._上下文):
                            待执行节点=节点
                            断开

                    如果待执行节点:
                        如果待执行节点.应执行(self._上下文):
                            待执行节点.状态="执行中"
                        否则:
                            待执行节点.状态="已跳过"
                            继续
                最后:
                    _解锁(self._锁)

                如果待执行节点:
                    尝试:
                        待执行节点.执行(self._上下文)
                    捕获错误:
                        跳过

                _加锁(self._锁)
                尝试:
                    全部完成=所有(
                        n.状态在["已完成","失败","已跳过"]
                        对于n在self._节点.值()
                    )
                    如果全部完成:
                        完成事件.设置()
                最后:
                    _解锁(self._锁)

        对于i在范围(self._执行线程数):
            t=_创建线程(工作线程)
            线程池.追加(t)

        完成事件.等待()

        对于t在线程池:
            _等待线程(t,超时=1.0)

        失败节点=[n对于n在self._节点.值()如果n.状态=="失败"]
        如果失败节点:
            抛出错误("工作流执行失败，失败节点:"+字符串([n.名称对于n在失败节点]))

    def异步执行(self,初始上下文=无):
        def运行():
            尝试:
                self.执行(初始上下文)
            捕获错误:
                跳过

        self._运行线程=_创建线程(运行)
        返回self.工作流标识

    def等待完成(self,超时=无):
        开始时间=_当前时间()

        当self.状态=="运行中":
            _睡眠(0.01)
            如果超时不是无并且_当前时间()-开始时间>超时:
                返回假

        返回self.状态在["已完成","失败"]

    def获取节点状态(self,节点名称):
        节点=self._节点.获取(节点名称)
        如果节点:
            返回节点.状态
        返回无

    def获取节点结果(self,节点名称):
        节点=self._节点.获取(节点名称)
        如果节点:
            返回节点.结果
        返回无

    def获取统计(self):
        统计={
            "工作流":self.名称,
            "状态":self.状态,
            "总节点数":长度(self._节点),
            "已完成":0,
            "执行中":0,
            "待执行":0,
            "失败":0,
            "已跳过":0
        }

        对于节点在self._节点.值():
            如果节点.状态=="已完成":
                统计["已完成"]+=1
            否则如果节点.状态=="执行中":
                统计["执行中"]+=1
            否则如果节点.状态=="待执行":
                统计["待执行"]+=1
            否则如果节点.状态=="失败":
                统计["失败"]+=1
            否则如果节点.状态=="已跳过":
                统计["已跳过"]+=1

        如果self.开始时间:
            统计["开始时间"]=self.开始时间
            如果self.结束时间:
                统计["总耗时"]=self.结束时间-self.开始时间
            否则:
                统计["已耗时"]=_当前时间()-self.开始时间

        返回统计

class工作流构建器:
    def__init__(self,名称="工作流"):
        self._工作流=工作流(名称)

    def节点(self,名称,函数=无,描述="",依赖=无):
        self._工作流.创建节点(名称,函数,描述,依赖)
        返回self

    def构建(self):
        返回self._工作流

def创建工作流(名称="工作流"):
    返回工作流(名称)

def创建工作流构建器(名称="工作流"):
    返回工作流构建器(名称)

def顺序执行(函数列表,初始上下文=无):
    wf=工作流("顺序执行")

    上一个节点=无
    对于i,func在枚举(函数列表):
        节点名称="步骤_"+字符串(i)
        节点=wf.创建节点(节点名称,lambda ctx,f=func:f(ctx))
        如果上一个节点:
            节点.添加依赖(上一个节点)
        上一个节点=节点

    返回wf.执行(初始上下文)
