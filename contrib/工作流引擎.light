# class工作流构建器:
#     def__init__(self,名称="工作流"):
#
#     def节点(self,名称,函数=无,描述="",依赖=无):
#         返回self
#
#     def构建(self):
#         返回self._工作流
#
# def创建工作流(名称="工作流"):
#     返回工作流(名称)
#
# def创建工作流构建器(名称="工作流"):
#     返回工作流构建器(名称)
#
# def顺序执行(函数列表,初始上下文=无):
#     wf=工作流("顺序执行")
#
#     上一个节点=无
#         节点名称="步骤_"+字符串(i)
#         节点=wf.创建节点(节点名称,lambda ctx,f=func:f(ctx))
#             节点.添加依赖(上一个节点)
#         上一个节点=节点
#
#     返回wf.执行(初始上下文)
#
# 用法：
#   从《工作流引擎》导入《节点状态》。

导出 节点状态 工作流状态 工作流节点 工作流 工作流构建器 创建工作流。
导出 创建工作流构建器 顺序执行。
