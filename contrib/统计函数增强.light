# 文体: 文言
# 统计函数增强 — 对 contrib/统计函数.light 的数理统计补充
# 提供：百分位/Z分数/T分数/线性回归/异常值检测

导 统计函数 出 均值, 标准差, 方差, 中位数, 分位数

引 Python 统计增强_后端:
    from contrib.统计函数增强 import (
        百分位数 as _lp_p, 百分等级 as _lp_pr,
        Z分数 as _lp_z, T分数 as _lp_t,
        线性回归 as _lp_reg, 线性预测 as _lp_pred,
        异常值检测 as _lp_outlier,
    )
    # 直接导出（l3_ 前缀 = E4 沙箱里强制导出）
    def l3_stat_percentile(data, p): return _lp_p(data, p)
    def l3_stat_percent_rank(data, v): return _lp_pr(data, v)
    def l3_stat_zscore(data, population=False): return _lp_z(data, population)
    def l3_stat_tscore(data, population=False): return _lp_t(data, population)
    def l3_stat_regression(X, Y):
        r = _lp_reg(X, Y)
        # 把「预测函数」替换成 None （可序列化），然后通过单独的 predict 函数间接调用
        fn = r.pop('预测')
        r['_预测_fn_'] = fn
        return r
    def l3_stat_predict(reg_result, x0):
        return _lp_pred({'预测': reg_result['_预测_fn_']}, x0)
    def l3_stat_outliers(data, k=1.5): return _lp_outlier(data, k)
结束引

段 百分位数(数据: 列, p: 数) -> 数:
    """百分位 p ∈ [0,100]"""
    返 l3_stat_percentile(数据, p)

段 百分等级(数据: 列, 数值: 数) -> 数:
    """返回有多少比例(%)的数据 ≤ 数值"""
    返 l3_stat_percent_rank(数据, 数值)

段 Z分数(数据: 列, 总体: 逻辑 = 假) -> 列:
    返 l3_stat_zscore(数据, 总体)

段 T分数(数据: 列, 总体: 逻辑 = 假) -> 列:
    返 l3_stat_tscore(数据, 总体)

段 线性回归(X: 列, Y: 列) -> 典:
    """返回 典：斜率/截距/R²/SST/SSE/相关系数r"""
    返 l3_stat_regression(X, Y)

段 线性预测(回归结果: 典, x0: 数) -> 数:
    返 l3_stat_predict(回归结果, x0)

段 异常值检测(数据: 列, 阈值倍IQR: 数 = 1.5) -> 典:
    """返回 典：下界/上界/IQR/Q1/Q3/异常值索引/异常值/正常值"""
    返 l3_stat_outliers(数据, 阈值倍IQR)

出 百分位数, 百分等级, Z分数, T分数, 线性回归, 线性预测, 异常值检测
