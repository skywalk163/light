def均值(数据):
    如果不是数据:
        抛出值错误('数据不能为空')
    返回总和(数据)/长度(数据)


def中位数(数据):
    如果不是数据:
        抛出值错误('数据不能为空')
    排序数据=排序(数据)
    n=长度(排序数据)
    如果n%2==0:
        返回(排序数据[n//2-1]+排序数据[n//2])/2
    返回排序数据[n//2]


def众数(数据):
    如果不是数据:
        抛出值错误('数据不能为空')
    频率={}
    对于值在数据:
        频率[值]=频率.获取(值,0)+1
    最大频率=最大值(频率.值())
    返回[值对于值,次数在频率.项()如果次数==最大频率]


def求和(数据):
    返回总和(数据)


def最小值(数据):
    如果不是数据:
        抛出值错误('数据不能为空')
    返回最小值(数据)


def最大值(数据):
    如果不是数据:
        抛出值错误('数据不能为空')
    返回最大值(数据)


def极差(数据):
    如果不是数据:
        抛出值错误('数据不能为空')
    返回最大值(数据)-最小值(数据)


def方差(数据,总体=真):
    如果不是数据:
        抛出值错误('数据不能为空')
    n=长度(数据)
    如果n==1:
        返回0.0
    均值=总和(数据)/n
    平方差之和=总和((x-均值)**2对于x在数据)
    如果总体:
        返回平方差之和/n
    返回平方差之和/(n-1)


def标准差(数据,总体=真):
    返回_平方根(方差(数据,总体))


def标准差系数(数据,总体=真):
    均值=总和(数据)/长度(数据)
    如果均值==0:
        返回0.0
    返回标准差(数据,总体)/均值


def协方差(数据1,数据2):
    如果长度(数据1)!=长度(数据2):
        抛出值错误('数据长度必须相同')
    n=长度(数据1)
    如果n==0:
        抛出值错误('数据不能为空')
    
    均值1=总和(数据1)/n
    均值2=总和(数据2)/n
    
    返回总和((数据1[i]-均值1)*(数据2[i]-均值2)对于i在范围(n))/n


def皮尔逊相关系数(数据1,数据2):
    如果长度(数据1)!=长度(数据2):
        抛出值错误('数据长度必须相同')
    n=长度(数据1)
    如果n==0:
        抛出值错误('数据不能为空')
    
    均值1=总和(数据1)/n
    均值2=总和(数据2)/n
    
    协方差=总和((数据1[i]-均值1)*(数据2[i]-均值2)对于i在范围(n))/n
    标准差1=_平方根(总和((x-均值1)**2对于x在数据1)/n)
    标准差2=_平方根(总和((x-均值2)**2对于x在数据2)/n)
    
    如果标准差1==0或标准差2==0:
        返回0.0
    
    返回协方差/(标准差1*标准差2)


def偏度(数据):
    如果长度(数据)<3:
        抛出值错误('数据至少需要3个元素')
    n=长度(数据)
    均值=总和(数据)/n
    标准差=_平方根(总和((x-均值)**2对于x在数据)/n)
    
    如果标准差==0:
        返回0.0
    
    三阶矩=总和((x-均值)**3对于x在数据)/n
    返回三阶矩/(标准差**3)


def峰度(数据):
    如果长度(数据)<4:
        抛出值错误('数据至少需要4个元素')
    n=长度(数据)
    均值=总和(数据)/n
    标准差=_平方根(总和((x-均值)**2对于x在数据)/n)
    
    如果标准差==0:
        返回0.0
    
    四阶矩=总和((x-均值)**4对于x在数据)/n
    返回四阶矩/(标准差**4)-3


def分位数(数据,分位=0.5):
    如果不是数据:
        抛出值错误('数据不能为空')
    如果分位<0或分位>1:
        抛出值错误('分位值必须在0到1之间')
    
    排序数据=排序(数据)
    n=长度(排序数据)
    位置=(n-1)*分位
    整数部分=整数(位置)
    小数部分=位置-整数部分
    
    如果整数部分>=n-1:
        返回排序数据[-1]
    
    返回排序数据[整数部分]*(1-小数部分)+排序数据[整数部分+1]*小数部分


def四分位数(数据):
    返回分位数(数据,0.25),分位数(数据,0.5),分位数(数据,0.75)


def四分位距(数据):
    q1,_,q3=四分位数(数据)
    返回q3-q1


def箱线图数据(数据):
    q1,中位数,q3=四分位数(数据)
    返回最小值(数据),q1,中位数,q3,最大值(数据)


def几何均值(数据):
    如果不是数据:
        抛出值错误('数据不能为空')
    乘积=1.0
    对于值在数据:
        如果值<=0:
            抛出值错误('几何均值要求所有数据必须大于0')
        乘积*=值
    返回乘积**(1.0/长度(数据))


def调和均值(数据):
    如果不是数据:
        抛出值错误('数据不能为空')
    倒数之和=总和(1.0/x对于x在数据)
    如果倒数之和==0:
        返回0.0
    返回长度(数据)/倒数之和


def加权均值(数据,权重):
    如果长度(数据)!=长度(权重):
        抛出值错误('数据和权重长度必须相同')
    总权重=总和(权重)
    如果总权重==0:
        抛出值错误('权重总和不能为0')
    返回总和(数据[i]*权重[i]对于i在范围(长度(数据)))/总权重


def变异系数(数据):
    均值=总和(数据)/长度(数据)
    如果均值==0:
        返回0.0
    返回标准差(数据)/均值


def数据范围(数据):
    如果不是数据:
        抛出值错误('数据不能为空')
    返回最小值(数据),最大值(数据)


def计数(数据):
    返回长度(数据)


def唯一值数量(数据):
    返回长度(集合(数据))


def频率表(数据):
    频率={}
    对于值在数据:
        频率[值]=频率.获取(值,0)+1
    返回频率


def累计频率(数据):
    排序数据=排序(数据)
    n=长度(排序数据)
    返回[(i+1)/n对于i在范围(n)]


def归一化(数据,方法='minmax'):
    如果不是数据:
        抛出值错误('数据不能为空')
    
    如果方法=='minmax':
        最小值=最小值(数据)
        最大值=最大值(数据)
        范围=最大值-最小值
        如果范围==0:
            返回[0.0]*长度(数据)
        返回[(x-最小值)/范围对于x在数据]
    
    否则如果方法=='zscore':
        均值=总和(数据)/长度(数据)
        标准差=_平方根(总和((x-均值)**2对于x在数据)/长度(数据))
        如果标准差==0:
            返回[0.0]*长度(数据)
        返回[(x-均值)/标准差对于x在数据]
    
    否则:
        抛出值错误('未知方法')