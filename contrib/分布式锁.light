class内存分布式锁:
    _全局锁存储={}
    _全局锁=_创建互斥锁()

    def__init__(self,锁名称,超时时间=30.0,等待超时=10.0):
        self.锁名称=锁名称
        self.超时时间=超时时间
        self.等待超时=等待超时
        self._持有者=无
        self._锁定时间=无
        self._重入计数=0
        self._续期线程=无
        self._续期运行=假

    def获取(self,阻塞=真):
        开始时间=_当前时间()

        当真:
            _加锁(内存分布式锁._全局锁)
            尝试:
                锁信息=内存分布式锁._全局锁存储.获取(self.锁名称)
                现在=_当前时间()

                如果锁信息是无或者现在-锁信息["时间"]>锁信息["超时"]:
                    锁值=_生成标识()
                    内存分布式锁._全局锁存储[self.锁名称]={
                        "值":锁值,
                        "时间":现在,
                        "超时":self.超时时间
                    }
                    self._持有者=锁值
                    self._锁定时间=现在
                    self._重入计数=1
                    self._启动续期()
                    返回真

                如果不阻塞:
                    返回假

                如果_当前时间()-开始时间>self.等待超时:
                    返回假
            最后:
                _解锁(内存分布式锁._全局锁)

            _睡眠(0.01)

    def释放(self):
        _加锁(内存分布式锁._全局锁)
        尝试:
            锁信息=内存分布式锁._全局锁存储.获取(self.锁名称)

            如果锁信息是无:
                返回假

            如果锁信息["值"]!=self._持有者:
                返回假

            删除内存分布式锁._全局锁存储[self.锁名称]
            self._持有者=无
            self._锁定时间=无
            self._重入计数=0
            self._停止续期()
            返回真
        最后:
            _解锁(内存分布式锁._全局锁)

    def_启动续期(self):
        如果self.超时时间<=0:
            返回

        self._续期运行=真

        def续期线程():
            当self._续期运行:
                _睡眠(self.超时时间/3)
                _加锁(内存分布式锁._全局锁)
                尝试:
                    锁信息=内存分布式锁._全局锁存储.获取(self.锁名称)
                    如果锁信息并且锁信息["值"]==self._持有者:
                        锁信息["时间"]=_当前时间()
                最后:
                    _解锁(内存分布式锁._全局锁)

        self._续期线程=_创建线程(续期线程)

    def_停止续期(self):
        self._续期运行=假
        如果self._续期线程:
            _等待线程(self._续期线程,超时=1.0)
            self._续期线程=无

    def检查状态(self):
        _加锁(内存分布式锁._全局锁)
        尝试:
            锁信息=内存分布式锁._全局锁存储.获取(self.锁名称)

            如果锁信息是无:
                返回"未锁定"

            现在=_当前时间()
            如果现在-锁信息["时间"]>锁信息["超时"]:
                返回"已过期"

            返回"已锁定"
        最后:
            _解锁(内存分布式锁._全局锁)

    def剩余时间(self):
        _加锁(内存分布式锁._全局锁)
        尝试:
            锁信息=内存分布式锁._全局锁存储.获取(self.锁名称)

            如果锁信息是无:
                返回0.0

            已过时间=_当前时间()-锁信息["时间"]
            返回最大值(0.0,锁信息["超时"]-已过时间)
        最后:
            _解锁(内存分布式锁._全局锁)

    def__enter__(self):
        如果不self.获取():
            抛出错误("获取锁失败:"+self.锁名称)
        返回self

    def__exit__(self,exc_type,exc_val,exc_tb):
        self.释放()
        返回假

class可重入内存锁:
    def__init__(self,锁名称,超时时间=30.0,等待超时=10.0):
        self.锁名称=锁名称
        self.超时时间=超时时间
        self.等待超时=等待超时
        self._线程本地={}

    def获取(self,阻塞=真):
        线程标识=_线程标识()

        如果线程标识在self._线程本地并且self._线程本地[线程标识]["锁"]:
            self._线程本地[线程标识]["重入计数"]+=1
            返回真

        锁=内存分布式锁(self.锁名称,self.超时时间,self.等待超时)
        如果锁.获取(阻塞):
            self._线程本地[线程标识]={
                "锁":锁,
                "重入计数":1
            }
            返回真

        返回假

    def释放(self):
        线程标识=_线程标识()

        如果线程标识不在self._线程本地或者不self._线程本地[线程标识]["锁"]:
            返回假

        self._线程本地[线程标识]["重入计数"]-=1

        如果self._线程本地[线程标识]["重入计数"]<=0:
            结果=self._线程本地[线程标识]["锁"].释放()
            删除self._线程本地[线程标识]
            返回结果

        返回真

    def__enter__(self):
        如果不self.获取():
            抛出错误("获取锁失败:"+self.锁名称)
        返回self

    def__exit__(self,exc_type,exc_val,exc_tb):
        self.释放()
        返回假

class读写锁:
    def__init__(self,锁名称,超时时间=30.0):
        self.锁名称=锁名称
        self.超时时间=超时时间
        self._读锁=内存分布式锁(锁名称+"_读",超时时间)
        self._写锁=内存分布式锁(锁名称+"_写",超时时间)
        self._读计数=0
        self._计数锁=_创建互斥锁()

    def获取读锁(self):
        _加锁(self._计数锁)
        尝试:
            如果self._读计数==0:
                如果不self._读锁.获取():
                    返回假
            self._读计数+=1
            返回真
        最后:
            _解锁(self._计数锁)

    def释放读锁(self):
        _加锁(self._计数锁)
        尝试:
            如果self._读计数<=0:
                返回假
            self._读计数-=1
            如果self._读计数==0:
                返回self._读锁.释放()
            返回真
        最后:
            _解锁(self._计数锁)

    def获取写锁(self):
        返回self._写锁.获取()

    def释放写锁(self):
        返回self._写锁.释放()

    class读锁上下文:
        def__init__(self,父):
            self.父=父

        def__enter__(self):
            如果不self.父.获取读锁():
                抛出错误("获取读锁失败")
            返回self

        def__exit__(self,exc_type,exc_val,exc_tb):
            self.父.释放读锁()
            返回假

    class写锁上下文:
        def__init__(self,父):
            self.父=父

        def__enter__(self):
            如果不self.父.获取写锁():
                抛出错误("获取写锁失败")
            返回self

        def__exit__(self,exc_type,exc_val,exc_tb):
            self.父.释放写锁()
            返回假

    @property
    def读锁(self):
        返回读写锁.读锁上下文(self)

    @property
    def写锁(self):
        返回读写锁.写锁上下文(self)

class信号量锁:
    def__init__(self,名称,许可数=1,超时时间=30.0):
        self.名称=名称
        self.许可数=许可数
        self.超时时间=超时时间
        self._当前计数=0
        self._条件变量=_创建条件变量()

    def获取(self,阻塞=真):
        开始时间=_当前时间()

        当真:
            _条件变量等待(self._条件变量)
            尝试:
                如果self._当前计数<self.许可数:
                    self._当前计数+=1
                    返回真

                如果不阻塞:
                    返回假

                如果_当前时间()-开始时间>self.超时时间:
                    返回假
            最后:
                _条件变量释放(self._条件变量)

            _睡眠(0.01)

    def释放(self):
        _条件变量等待(self._条件变量)
        尝试:
            如果self._当前计数>0:
                self._当前计数-=1
                _条件变量通知(self._条件变量)
        最后:
            _条件变量释放(self._条件变量)

    def__enter__(self):
        如果不self.获取():
            抛出错误("获取信号量失败:"+self.名称)
        返回self

    def__exit__(self,exc_type,exc_val,exc_tb):
        self.释放()
        返回假

def创建分布式锁(锁名称,超时时间=30.0,等待超时=10.0,类型="互斥锁"):
    如果类型=="互斥锁":
        返回内存分布式锁(锁名称,超时时间,等待超时)
    否则如果类型=="可重入锁":
        返回可重入内存锁(锁名称,超时时间,等待超时)
    否则如果类型=="读写锁":
        返回读写锁(锁名称,超时时间)
    否则:
        返回内存分布式锁(锁名称,超时时间,等待超时)

def带锁执行(锁名称,函数,*参数,**关键字参数):
    用内存分布式锁(锁名称):
        返回函数(*参数,**关键字参数)
