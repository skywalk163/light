# class内存分布式锁:
#     _全局锁存储={}
#     _全局锁=_创建互斥锁()
#
#     def__init__(self,锁名称,超时时间=30.0,等待超时=10.0):
#
#     def获取(self,阻塞=真):
#         开始时间=_当前时间()
#
#             _加锁(内存分布式锁._全局锁)
#             尝试:
#                 现在=_当前时间()
#
#                     锁值=_生成标识()
#                         "值":锁值,
#                         "时间":现在,
#                     }
#                     返回真
#
#                     返回假
#
#                     返回假
#             最后:
#                 _解锁(内存分布式锁._全局锁)
#
#             _睡眠(0.01)
#
#     def释放(self):
#         _加锁(内存分布式锁._全局锁)
#         尝试:
#
#                 返回假
#
#                 返回假
#
#             返回真
#         最后:
#             _解锁(内存分布式锁._全局锁)
#
#     def_启动续期(self):
#             返回
#
#         def续期线程():
#                 _加锁(内存分布式锁._全局锁)
#                 尝试:
#                         锁信息["时间"]=_当前时间()
#                 最后:
#                     _解锁(内存分布式锁._全局锁)
#
#     def_停止续期(self):
#
#     def检查状态(self):
#         _加锁(内存分布式锁._全局锁)
#         尝试:
#
#                 返回"未锁定"
#
#             现在=_当前时间()
#                 返回"已过期"
#
#             返回"已锁定"
#         最后:
#             _解锁(内存分布式锁._全局锁)
#
#     def剩余时间(self):
#         _加锁(内存分布式锁._全局锁)
#         尝试:
#
#                 返回0.0
#
#             已过时间=_当前时间()-锁信息["时间"]
#             返回最大值(0.0,锁信息["超时"]-已过时间)
#         最后:
#             _解锁(内存分布式锁._全局锁)
#
#     def__enter__(self):
#         返回self
#
#     def__exit__(self,exc_type,exc_val,exc_tb):
#         返回假
#
# class可重入内存锁:
#     def__init__(self,锁名称,超时时间=30.0,等待超时=10.0):
#
#     def获取(self,阻塞=真):
#         线程标识=_线程标识()
#
#             返回真
#
#                 "锁":锁,
#                 "重入计数":1
#             }
#             返回真
#
#         返回假
#
#     def释放(self):
#         线程标识=_线程标识()
#
#             返回假
#
#             删除self._线程本地[线程标识]
#             返回结果
#
#         返回真
#
#     def__enter__(self):
#         返回self
#
#     def__exit__(self,exc_type,exc_val,exc_tb):
#         返回假
#
# class读写锁:
#     def__init__(self,锁名称,超时时间=30.0):
#
#     def获取读锁(self):
#         尝试:
#                     返回假
#             返回真
#         最后:
#
#     def释放读锁(self):
#         尝试:
#                 返回假
#                 返回self._读锁.释放()
#             返回真
#         最后:
#
#     def获取写锁(self):
#         返回self._写锁.获取()
#
#     def释放写锁(self):
#         返回self._写锁.释放()
#
#     class读锁上下文:
#         def__init__(self,父):
#
#         def__enter__(self):
#                 抛出错误("获取读锁失败")
#             返回self
#
#         def__exit__(self,exc_type,exc_val,exc_tb):
#             返回假
#
#     class写锁上下文:
#         def__init__(self,父):
#
#         def__enter__(self):
#                 抛出错误("获取写锁失败")
#             返回self
#
#         def__exit__(self,exc_type,exc_val,exc_tb):
#             返回假
#
#     @property
#     def读锁(self):
#         返回读写锁.读锁上下文(self)
#
#     @property
#     def写锁(self):
#         返回读写锁.写锁上下文(self)
#
# class信号量锁:
#     def__init__(self,名称,许可数=1,超时时间=30.0):
#
#     def获取(self,阻塞=真):
#         开始时间=_当前时间()
#
#             尝试:
#                     返回真
#
#                     返回假
#
#                     返回假
#             最后:
#
#             _睡眠(0.01)
#
#     def释放(self):
#         尝试:
#         最后:
#
#     def__enter__(self):
#         返回self
#
#     def__exit__(self,exc_type,exc_val,exc_tb):
#         返回假
#
# def创建分布式锁(锁名称,超时时间=30.0,等待超时=10.0,类型="互斥锁"):
#         返回内存分布式锁(锁名称,超时时间,等待超时)
#     否则如果类型=="可重入锁":
#         返回可重入内存锁(锁名称,超时时间,等待超时)
#     否则如果类型=="读写锁":
#         返回读写锁(锁名称,超时时间)
#     否则:
#         返回内存分布式锁(锁名称,超时时间,等待超时)
#
# def带锁执行(锁名称,函数,*参数,**关键字参数):
#     用内存分布式锁(锁名称):
#         返回函数(*参数,**关键字参数)
#
# 用法：
#   从《分布式锁》导入《锁类型》。

导出 锁类型 锁状态 分布式锁错误 获取锁失败 锁已过期 内存分布式锁。
导出 可重入内存锁 读写锁 信号量锁 创建分布式锁 带锁执行。
