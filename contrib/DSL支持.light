class DSL解析异常(异常):
    pass


class 词法分析器:
    def初始化():
        self._token规则列表=[]
    
    def添加规则(类型,模式):
        self._token规则列表.追加((类型,模式))
    
    def分词(代码):
        token列表=[]
        位置=0
        行号=1
        列号=1
        
        当位置<长度(代码):
            匹配=无
            
            对于类型,模式在self._token规则列表:
                结果=_正则匹配(模式,代码,位置)
                如果结果:
                    值=结果
                    token列表.追加({
                        '类型':类型,
                        '值':值,
                        '行号':行号,
                        '列号':列号
                    })
                    
                    位置+=长度(值)
                    打破
            
            如果不是匹配:
                抛出DSL解析异常('无法识别的字符')
        
        return token列表
    
    @静态方法
    def创建默认词法分析器():
        分析器=词法分析器()
        分析器.添加规则('数字',r'\d+(\.\d+)?')
        分析器.添加规则('字符串',r'"[^"]*"')
        分析器.添加规则('标识符',r'[a-zA-Z_][a-zA-Z0-9_]*')
        分析器.添加规则('运算符',r'[+\-*/=<>!&|]')
        分析器.添加规则('括号',r'[()\[\]{}]')
        分析器.添加规则('逗号',r',')
        分析器.添加规则('点号',r'\.')
        分析器.添加规则('空白',r'\s+')
        return分析器


class 语法节点:
    def初始化(类型,值=无,子节点=无):
        self.类型=类型
        self.值=值
        self.子节点=子节点或[]
    
    def__表示__():
        如果self.子节点:
            return self.类型+'('+字符串(self.值)+')['+字符串(长度(self.子节点))+'个子节点]'
        return self.类型+'('+字符串(self.值)+')'


class 语法分析器:
    def初始化():
        self._token列表=[]
        self._当前位置=0
    
    def分析(token列表):
        self._token列表=[t对于t在token列表如果t['类型']!='空白']
        self._当前位置=0
        
        return self._解析表达式()
    
    def_当前token():
        如果self._当前位置<长度(self._token列表):
            return self._token列表[self._当前位置]
        return无
    
    def_消费token(期望类型=无):
        token=self._当前token()
        如果不是token:
            抛出DSL解析异常('意外的结束')
        如果期望类型且token['类型']!=期望类型:
            抛出DSL解析异常('期望'+期望类型+',实际'+token['类型'])
        self._当前位置+=1
        return token
    
    def_解析表达式():
        return self._解析加减()
    
    def_解析加减():
        左节点=self._解析乘除()
        
        当self._当前token()且self._当前token()['类型']=='运算符'且self._当前token()['值']在'+-':
            运算符=self._消费token('运算符')
            右节点=self._解析乘除()
            左节点=语法节点('二元运算',运算符['值'],[左节点,右节点])
        
        return左节点
    
    def_解析乘除():
        左节点=self._解析基础表达式()
        
        当self._当前token()且self._当前token()['类型']=='运算符'且self._当前token()['值']在'*/':
            运算符=self._消费token('运算符')
            右节点=self._解析基础表达式()
            左节点=语法节点('二元运算',运算符['值'],[左节点,右节点])
        
        return左节点
    
    def_解析基础表达式():
        token=self._当前token()
        
        如果不是token:
            抛出DSL解析异常('意外的结束')
        
        如果token['类型']=='数字':
            self._消费token()
            return语法节点('数字',浮点型(token['值']))
        
        如果token['类型']=='字符串':
            self._消费token()
            return语法节点('字符串',token['值'][1:-1])
        
        如果token['类型']=='标识符':
            self._消费token()
            
            如果self._当前token()且self._当前token()['类型']=='括号'且self._当前token()['值']=='(':
                self._消费token()
                参数列表=[]
                
                当self._当前token()且不是(self._当前token()['类型']=='括号'且self._当前token()['值']==')'):
                    参数列表.追加(self._解析表达式())
                    如果self._当前token()且self._当前token()['类型']=='逗号':
                        self._消费token()
                
                self._消费token()
                return语法节点('函数调用',token['值'],参数列表)
            
            return语法节点('变量',token['值'])
        
        如果token['类型']=='括号'且token['值']=='(':
            self._消费token()
            表达式=self._解析表达式()
            self._消费token()
            return表达式
        
        抛出DSL解析异常('意外的token')


class 解释器:
    def初始化():
        self._变量字典={}
        self._函数字典={}
    
    def设置变量(名称,值):
        self._变量字典[名称]=值
    
    def获取变量(名称):
        如果名称不在self._变量字典:
            抛出DSL解析异常('未定义的变量:'+名称)
        return self._变量字典[名称]
    
    def注册函数(名称,函数):
        self._函数字典[名称]=函数
    
    def求值(ast):
        如果ast.类型=='数字':
            return ast.值
        
        如果ast.类型=='字符串':
            return ast.值
        
        如果ast.类型=='变量':
            return self.获取变量(ast.值)
        
        如果ast.类型=='二元运算':
            左值=self.求值(ast.子节点[0])
            右值=self.求值(ast.子节点[1])
            运算符=ast.值
            
            如果运算符=='+':
                return左值+右值
            如果运算符=='-':
                return左值-右值
            如果运算符=='*':
                return左值*右值
            如果运算符=='/':
                return左值/右值
            
            抛出DSL解析异常('未知的运算符:'+运算符)
        
        如果ast.类型=='函数调用':
            如果ast.值不在self._函数字典:
                抛出DSL解析异常('未定义的函数:'+ast.值)
            参数值=[self.求值(p)对于p在ast.子节点]
            return self._函数字典[ast.值](*参数值)
        
        抛出DSL解析异常('未知的节点类型:'+ast.类型)
    
    def执行(代码):
        词法分析器实例=词法分析器.创建默认词法分析器()
        token列表=词法分析器实例.分词(代码)
        
        语法分析器实例=语法分析器()
        ast=语法分析器实例.分析(token列表)
        
        return self.求值(ast)


class 表达式求值器:
    def初始化():
        self._变量={}
        self._函数={}
        self._初始化默认函数()
    
    def_初始化默认函数():
        self._函数['max']=最大
        self._函数['min']=最小
        self._函数['abs']=绝对值
        self._函数['int']=整数
        self._函数['float']=浮点型
        self._函数['str']=字符串
        self._函数['len']=长度
        self._函数['sum']=总和
        self._函数['round']=四舍五入
    
    def设置变量(名称,值):
        self._变量[名称]=值
    
    def注册函数(名称,函数):
        self._函数[名称]=函数
    
    def求值(表达式):
        解释器实例=解释器()
        对于名称,值在self._变量.项():
            解释器实例.设置变量(名称,值)
        对于名称,函数在self._函数.项():
            解释器实例.注册函数(名称,函数)
        return解释器实例.执行(表达式)


class 模板引擎DSL:
    def初始化():
        self._变量={}
    
    def设置变量(名称,值):
        self._变量[名称]=值
    
    def渲染(模板,变量字典=无):
        上下文=self._变量.复制()
        如果变量字典:
            上下文.更新(变量字典)
        
        def替换变量(匹配):
            表达式=匹配.组(1).去除空白()
            尝试:
                求值器=表达式求值器()
                对于名称,值在上下文.项():
                    求值器.设置变量(名称,值)
                return字符串(求值器.求值(表达式))
            除异常:
                return匹配.组(0)
        
        结果=_正则替换(r'\{\{(.+?)\}\}',替换变量,模板)
        return结果


class 简单DSL:
    def初始化():
        self._解释器=解释器()
        self._注册内置函数()
    
    def_注册内置函数():
        self._解释器.注册函数('max',最大)
        self._解释器.注册函数('min',最小)
        self._解释器.注册函数('abs',绝对值)
        self._解释器.注册函数('round',四舍五入)
        self._解释器.注册函数('print',打印)
    
    def设置变量(名称,值):
        self._解释器.设置变量(名称,值)
    
    def注册函数(名称,函数):
        self._解释器.注册函数(名称,函数)
    
    def执行(代码):
        return self._解释器.执行(代码)
    
    def求值(表达式):
        return self._解释器.执行(表达式)


def求值表达式(表达式,变量字典=无):
    求值器=表达式求值器()
    如果变量字典:
        对于名称,值在变量字典.项():
            求值器.设置变量(名称,值)
    return求值器.求值(表达式)


def渲染模板(模板,变量字典=无):
    引擎=模板引擎DSL()
    return引擎.渲染(模板,变量字典)


def创建DSL():
    return简单DSL()


def创建表达式求值器():
    return表达式求值器()


def创建模板引擎():
    return模板引擎DSL()


def分词(代码):
    分析器=词法分析器.创建默认词法分析器()
    return分析器.分词(代码)