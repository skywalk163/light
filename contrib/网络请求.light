# class会话:
#     def__init__(self):
#
#     def设置请求头(self,请求头):
#
#     def设置超时(self,超时):
#
#     defGET(self,地址,参数=无,请求头=无,超时=无):
#
#     defPOST(self,地址,数据=无,JSON数据=无,参数=无,请求头=无,超时=无):
#
#     defPUT(self,地址,数据=无,JSON数据=无,参数=无,请求头=无,超时=无):
#
#     defDELETE(self,地址,参数=无,请求头=无,超时=无):
