class 测试结果:
    def初始化(名称,通过,耗时=0,错误=''):
        self.名称=名称
        self.通过=通过
        self.耗时=耗时
        self.错误=错误


class 测试用例:
    def初始化(名称,函数):
        self.名称=名称
        self.函数=函数
    
    def运行():
        开始时间=_获取当前时间()
        尝试:
            self.函数()
            耗时=_获取当前时间()-开始时间
            return 测试结果(self.名称,真,耗时)
        除断言错误(e):
            耗时=_获取当前时间()-开始时间
            return 测试结果(self.名称,假,耗时,字符串(e))
        除异常(e):
            耗时=_获取当前时间()-开始时间
            return 测试结果(self.名称,假,耗时,_获取堆栈信息())


class 测试套件:
    def初始化(名称=''):
        self.名称=名称
        self._测试用例列表=[]
        self._前置夹具=无
        self._后置夹具=无
        self._测试类列表=[]
    
    def添加测试(名称,函数):
        self._测试用例列表.追加(测试用例(名称,函数))
    
    def添加测试类(测试类):
        self._测试类列表.追加(测试类)
    
    def设置前置夹具(函数):
        self._前置夹具=函数
    
    def设置后置夹具(函数):
        self._后置夹具=函数
    
    def运行():
        结果列表=[]
        
        如果self._前置夹具:
            self._前置夹具()
        
        对于测试类在self._测试类列表:
            实例=测试类()
            如果有属性(实例,'设置'):
                实例.设置()
            
            对于方法名在_获取属性列表(实例):
                如果方法名.以开头('测试_'):
                    方法=_获取属性(实例,方法名)
                    开始时间=_获取当前时间()
                    尝试:
                        如果有属性(实例,'设置每测试'):
                            实例.设置每测试()
                        方法()
                        耗时=_获取当前时间()-开始时间
                        结果列表.追加(测试结果(测试类.__名称__+'.'+方法名,真,耗时))
                    除断言错误(e):
                        耗时=_获取当前时间()-开始时间
                        结果列表.追加(测试结果(测试类.__名称__+'.'+方法名,假,耗时,字符串(e)))
                    除异常(e):
                        耗时=_获取当前时间()-开始时间
                        结果列表.追加(测试结果(测试类.__名称__+'.'+方法名,假,耗时,_获取堆栈信息()))
            
            如果有属性(实例,'清理'):
                实例.清理()
        
        对于测试在self._测试用例列表:
            结果列表.追加(测试.运行())
        
        如果self._后置夹具:
            self._后置夹具()
        
        return 结果列表


class 测试运行器:
    def初始化():
        self._套件列表=[]
    
    def添加套件(套件):
        self._套件列表.追加(套件)
    
    def运行():
        开始时间=_获取当前时间()
        所有结果=[]
        
        对于套件在self._套件列表:
            所有结果.扩展(套件.运行())
        
        总耗时=_获取当前时间()-开始时间
        通过数=总和(1对于r在所有结果如果r.通过)
        失败数=长度(所有结果)-通过数
        
        return{
            '总测试数':长度(所有结果),
            '通过数':通过数,
            '失败数':失败数,
            '总耗时':总耗时,
            '结果列表':所有结果,
            '通过率':通过数/长度(所有结果)如果所有结果否则0
        }
    
    def打印报告():
        结果=self.运行()
        
        打印('\n'+'='*60)
        打印('测试报告')
        打印('='*60)
        打印('总测试数:'+字符串(结果['总测试数']))
        打印('通过:'+字符串(结果['通过数']))
        打印('失败:'+字符串(结果['失败数']))
        打印('通过率:'+字符串(结果['通过率']*100)+'%')
        打印('总耗时:'+字符串(结果['总耗时'])+'秒')
        打印('='*60)
        
        对于测试结果在结果['结果列表']:
            状态='✓'如果测试结果.通过否则'✗'
            打印(状态+' '+测试结果.名称)
            如果不是测试结果.通过:
                打印('   错误:'+测试结果.错误)
        
        打印('='*60)
        
        return 结果['失败数']==0


def断言为真(条件,消息=''):
    如果不是条件:
        抛出断言错误(消息或'断言失败:条件不为真')


def断言为假(条件,消息=''):
    如果条件:
        抛出断言错误(消息或'断言失败:条件不为假')


def断言相等(实际值,期望值,消息=''):
    如果实际值!=期望值:
        抛出断言错误(消息或'断言失败:'+字符串(实际值)+'!='+字符串(期望值))


def断言不相等(实际值,期望值,消息=''):
    如果实际值==期望值:
        抛出断言错误(消息或'断言失败:'+字符串(实际值)+'=='+字符串(期望值))


def断言接近(实际值,期望值,公差=0.0001,消息=''):
    如果绝对值(实际值-期望值)>公差:
        抛出断言错误(消息或'断言失败:两个值的差超过'+字符串(公差))


def断言包含(容器,元素,消息=''):
    如果元素不在容器:
        抛出断言错误(消息或'断言失败:容器不包含元素')


def断言不包含(容器,元素,消息=''):
    如果元素在容器:
        抛出断言错误(消息或'断言失败:容器包含元素')


def断言为无(值,消息=''):
    如果值不是无:
        抛出断言错误(消息或'断言失败:值不为None')


def断言不为无(值,消息=''):
    如果值是无:
        抛出断言错误(消息或'断言失败:值为None')


def断言抛出异常(函数,异常类型=异常,消息=''):
    尝试:
        函数()
        抛出断言错误(消息或'断言失败:未抛出预期异常')
    除异常类型:
        跳过
    除异常(e):
        抛出断言错误(消息或'断言失败:抛出了错误的异常类型')


def断言不抛出异常(函数,消息=''):
    尝试:
        函数()
    除异常(e):
        抛出断言错误(消息或'断言失败:意外抛出异常')


def断言实例(对象,类型,消息=''):
    如果不是实例(对象,类型):
        抛出断言错误(消息或'断言失败:对象不是指定类型的实例')


def断言长度(序列,期望长度,消息=''):
    如果长度(序列)!=期望长度:
        抛出断言错误(消息或'断言失败:长度不符')


def断言为空(序列,消息=''):
    如果长度(序列)!=0:
        抛出断言错误(消息或'断言失败:序列不为空')


def断言不为空(序列,消息=''):
    如果长度(序列)==0:
        抛出断言错误(消息或'断言失败:序列为空')


def测试(名称=''):
    def包装(函数):
        函数._测试名称=名称或函数.__名称__
        返回函数
    return包装


def夹具(类型='前置'):
    def包装(函数):
        函数._夹具类型=类型
        返回函数
    return包装


def创建测试套件(名称=''):
    return测试套件(名称)


def创建测试运行器():
    return测试运行器()


def运行测试(套件):
    运行器=创建测试运行器()
    运行器.添加套件(套件)
    return运行器.打印报告()