#     def初始化(名称,通过,耗时=0,错误=''):
#
#     def初始化(名称,函数):
#
#     def运行():
#         开始时间=_获取当前时间()
#         尝试:
#             耗时=_获取当前时间()-开始时间
#         除断言错误(e):
#             耗时=_获取当前时间()-开始时间
#         除异常(e):
#             耗时=_获取当前时间()-开始时间
#
#     def初始化(名称=''):
#
#     def添加测试(名称,函数):
#
#     def添加测试类(测试类):
#
#     def设置前置夹具(函数):
#
#     def设置后置夹具(函数):
#
#     def运行():
#         结果列表=[]
#
#             实例=测试类()
#                 实例.设置()
#
#                     方法=_获取属性(实例,方法名)
#                     开始时间=_获取当前时间()
#                     尝试:
#                             实例.设置每测试()
#                         方法()
#                         耗时=_获取当前时间()-开始时间
#                         结果列表.追加(测试结果(测试类.__名称__+'.'+方法名,真,耗时))
#                     除断言错误(e):
#                         耗时=_获取当前时间()-开始时间
#                         结果列表.追加(测试结果(测试类.__名称__+'.'+方法名,假,耗时,字符串(e)))
#                     除异常(e):
#                         耗时=_获取当前时间()-开始时间
#                         结果列表.追加(测试结果(测试类.__名称__+'.'+方法名,假,耗时,_获取堆栈信息()))
#
#                 实例.清理()
#
#             结果列表.追加(测试.运行())
#
#     def初始化():
#
#     def添加套件(套件):
#
#     def运行():
#         开始时间=_获取当前时间()
#         所有结果=[]
#
#             所有结果.扩展(套件.运行())
#
#         总耗时=_获取当前时间()-开始时间
#         通过数=总和(1对于r在所有结果如果r.通过)
#         失败数=长度(所有结果)-通过数
#
#             '总测试数':长度(所有结果),
#             '通过数':通过数,
#             '失败数':失败数,
#             '总耗时':总耗时,
#             '结果列表':所有结果,
#             '通过率':通过数/长度(所有结果)如果所有结果否则0
#         }
#
