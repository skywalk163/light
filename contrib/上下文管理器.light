# class临时文件:
#     def__init__(self,前缀='',后缀='',目录=无,删除=真):
#
#     def__enter__(self):
#         返回self._文件路径
#
#     def__exit__(self,异常类型,异常值,追溯):
#         返回假
#
#     def取文件路径(self):
#         返回self._文件路径
#
# class临时目录:
#     def__init__(self,前缀='',后缀='',目录=无,删除=真):
#
#     def__enter__(self):
#         返回self._目录路径
#
#     def__exit__(self,异常类型,异常值,追溯):
#         返回假
#
#     def取目录路径(self):
#         返回self._目录路径
#
# class自动关闭:
#     def__init__(self,资源,关闭方法='close',*关闭参数,**关闭关键字参数):
#
#     def__enter__(self):
#         返回self._资源
#
#     def__exit__(self,异常类型,异常值,追溯):
#         返回假
#
# class计时器上下文:
#     def__init__(self,日志函数=无,名称=无):
#
#     def__enter__(self):
#         返回self
#
#     def__exit__(self,异常类型,异常值,追溯):
#         返回假
#
#     def取耗时(self):
#         返回self._耗时
#
# class锁上下文:
#     def__init__(self,锁=无,超时=无):
#
#     def__enter__(self):
#         否则:
#         返回self._获取成功
#
#     def__exit__(self,异常类型,异常值,追溯):
#         返回假
#
#     def取获取成功(self):
#         返回self._获取成功
#
# class事务:
#     def__init__(self,提交函数,回滚函数=无):
#
#     def__enter__(self):
#         返回self
#
#     def__exit__(self,异常类型,异常值,追溯):
#         否则:
#         返回假
#
#     def取已提交(self):
#         返回self._已提交
#
# class变更恢复:
#     def__init__(self,对象,属性名,新值):
#
#     def__enter__(self):
#         返回self
#
#     def__exit__(self,异常类型,异常值,追溯):
#         返回假
#
# class环境变量上下文:
#     def__init__(self,**变量):
#
#     def__enter__(self):
#             _设置环境变量(名称,值)
#         返回self
#
#     def__exit__(self,异常类型,异常值,追溯):
#                 _删除环境变量(名称)
#             否则:
#                 _设置环境变量(名称,旧值)
#         返回假
#
# class工作目录:
#     def__init__(self,目录):
#
#     def__enter__(self):
#         返回self._目录
#
#     def__exit__(self,异常类型,异常值,追溯):
#         返回假
#
# class静默异常:
#     def__init__(self,捕获异常=无,日志函数=无):
#
#     def__enter__(self):
#         返回self
#
#     def__exit__(self,异常类型,异常值,追溯):
#             返回真
#         返回假
#
# 用法：
#   从《上下文管理器》导入《临时文件》。

导出 临时文件 临时目录 自动关闭 计时器上下文 锁上下文 事务。
导出 变更恢复 环境变量上下文 工作目录 静默异常 重试上下文 信号处理器。
导出 创建临时文件 创建临时目录 删除临时文件 删除临时目录。
