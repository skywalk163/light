class临时文件:
    def__init__(self,前缀='',后缀='',目录=无,删除=真):
        self._前缀=前缀
        self._后缀=后缀
        self._目录=目录
        self._删除=删除
        self._文件路径=无
    
    def__enter__(self):
        self._文件路径=_创建临时文件(self._前缀,self._后缀,self._目录)
        返回self._文件路径
    
    def__exit__(self,异常类型,异常值,追溯):
        如果self._文件路径且self._删除:
            _删除临时文件(self._文件路径)
        返回假
    
    def取文件路径(self):
        返回self._文件路径


class临时目录:
    def__init__(self,前缀='',后缀='',目录=无,删除=真):
        self._前缀=前缀
        self._后缀=后缀
        self._目录=目录
        self._删除=删除
        self._目录路径=无
    
    def__enter__(self):
        self._目录路径=_创建临时目录(self._前缀,self._后缀,self._目录)
        返回self._目录路径
    
    def__exit__(self,异常类型,异常值,追溯):
        如果self._目录路径且self._删除:
            _删除临时目录(self._目录路径)
        返回假
    
    def取目录路径(self):
        返回self._目录路径


class自动关闭:
    def__init__(self,资源,关闭方法='close',*关闭参数,**关闭关键字参数):
        self._资源=资源
        self._关闭方法=关闭方法
        self._关闭参数=关闭参数
        self._关闭关键字参数=关闭关键字参数
    
    def__enter__(self):
        返回self._资源
    
    def__exit__(self,异常类型,异常值,追溯):
        如果_有属性(self._资源,self._关闭方法):
            _调用方法(self._资源,self._关闭方法,self._关闭参数,self._关闭关键字参数)
        返回假


class计时器上下文:
    def__init__(self,日志函数=无,名称=无):
        self._日志函数=日志函数
        self._名称=名称
        self._耗时=无
    
    def__enter__(self):
        self._开始=_性能计数器()
        返回self
    
    def__exit__(self,异常类型,异常值,追溯):
        self._耗时=_性能计数器()-self._开始
        如果self._日志函数:
            名称=self._名称或'操作'
            self._日志函数(名称+' 耗时: '+_转字符串(self._耗时)+'秒')
        返回假
    
    def取耗时(self):
        返回self._耗时


class锁上下文:
    def__init__(self,锁=无,超时=无):
        self._锁=锁或_创建互斥锁(假)
        self._超时=超时
        self._获取成功=假
    
    def__enter__(self):
        如果self._超时是无:
            self._锁.加锁()
            self._获取成功=真
        否则:
            self._获取成功=self._锁.加锁(超时=self._超时)
        返回self._获取成功
    
    def__exit__(self,异常类型,异常值,追溯):
        如果self._获取成功:
            self._锁.解锁()
        返回假
    
    def取获取成功(self):
        返回self._获取成功


class事务:
    def__init__(self,提交函数,回滚函数=无):
        self._提交函数=提交函数
        self._回滚函数=回滚函数
        self._已提交=假
    
    def__enter__(self):
        返回self
    
    def__exit__(self,异常类型,异常值,追溯):
        如果异常类型是无且异常值是无:
            self._提交函数()
            self._已提交=真
        否则:
            如果self._回滚函数:
                self._回滚函数()
        返回假
    
    def取已提交(self):
        返回self._已提交


class变更恢复:
    def__init__(self,对象,属性名,新值):
        self._对象=对象
        self._属性名=属性名
        self._新值=新值
        self._旧值=无
    
    def__enter__(self):
        self._旧值=_取属性(self._对象,self._属性名,无)
        _设属性(self._对象,self._属性名,self._新值)
        返回self
    
    def__exit__(self,异常类型,异常值,追溯):
        _设属性(self._对象,self._属性名,self._旧值)
        返回假


class环境变量上下文:
    def__init__(self,**变量):
        self._变量=变量
        self._旧值={}
    
    def__enter__(self):
        对于名称,值在self._变量:
            self._旧值[名称]=_获取环境变量(名称,无)
            _设置环境变量(名称,值)
        返回self
    
    def__exit__(self,异常类型,异常值,追溯):
        对于名称,旧值在self._旧值:
            如果旧值是无:
                _删除环境变量(名称)
            否则:
                _设置环境变量(名称,旧值)
        返回假


class工作目录:
    def__init__(self,目录):
        self._目录=目录
        self._旧目录=无
    
    def__enter__(self):
        self._旧目录=_获取工作目录()
        _设置工作目录(self._目录)
        返回self._目录
    
    def__exit__(self,异常类型,异常值,追溯):
        如果self._旧目录:
            _设置工作目录(self._旧目录)
        返回假


class静默异常:
    def__init__(self,捕获异常=无,日志函数=无):
        self._捕获异常=捕获异常
        self._日志函数=日志函数
    
    def__enter__(self):
        返回self
    
    def__exit__(self,异常类型,异常值,追溯):
        如果异常类型不是无:
            如果self._日志函数:
                self._日志函数('静默异常: '+_转字符串(异常值))
            返回真
        返回假