class数组:
    def__init__(self,数据,形状=无):
        如果形状是无:
            self._数据=列表(数据)
            self._形状=self._计算形状(self._数据)
        否则:
            self._数据=self._扁平化(数据)
            self._形状=形状
            self._数据=self._重塑(self._扁平化(数据),形状)
    
    def_计算形状(self,数据):
        如果是列表或元组(数据):
            返回(长度(数据),)+self._计算形状(数据[0])如果数据否则()
        返回()
    
    def_扁平化(self,数据):
        结果=[]
        如果是列表或元组(数据):
            对于元素在数据:
                结果.扩展(self._扁平化(元素))
        否则:
            结果.追加(数据)
        返回结果
    
    def_重塑(self,扁平数据,形状):
        如果长度(形状)==1:
            返回列表(扁平数据[:形状[0]])
        尺寸=形状[0]
        剩余形状=形状[1:]
        每个部分大小=_乘积(剩余形状)
        返回[自._重塑(扁平数据[i*每个部分大小:(i+1)*每个部分大小],剩余形状)对于i在范围(尺寸)]
    
    def__getitem__(self,索引):
        如果是元组(索引):
            数据=self._数据
            对于i在索引:
                数据=数据[i]
            返回数据
        返回self._数据[索引]
    
    def__setitem__(self,索引,值):
        如果是元组(索引):
            数据=self._数据
            对于i在索引[:-1]:
                数据=数据[i]
            数据[索引[-1]]=值
        否则:
            self._数据[索引]=值
    
    def__len__(self):
        返回长度(self._数据)
    
    def__repr__(self):
        返回'数组('+转字符串(self._数据)+', 形状='+转字符串(self._形状)+')'
    
    def__add__(self,其他):
        返回self._逐元素运算(其他,lambda a,b:a+b)
    
    def__sub__(self,其他):
        返回self._逐元素运算(其他,lambda a,b:a-b)
    
    def__mul__(self,其他):
        返回self._逐元素运算(其他,lambda a,b:a*b)
    
    def__truediv__(self,其他):
        返回self._逐元素运算(其他,lambda a,b:a/b)
    
    def__pow__(self,其他):
        返回self._逐元素运算(其他,lambda a,b:a**b)
    
    def__neg__(self):
        返回self._逐元素运算(0,lambda a,b:-a)
    
    def_逐元素运算(self,其他,运算):
        扁平数据=self._扁平化(self._数据)
        如果是数组(其他):
            如果self._形状!=其他._形状:
                抛出值错误('形状不匹配')
            其他扁平=其他._扁平化(其他._数据)
            结果=[运算(a,b)对于a,b在配对(扁平数据,其他扁平)]
        否则:
            结果=[运算(a,其他)对于a在扁平数据]
        返回数组(结果,self._形状)
    
    def形状(self):
        返回self._形状
    
    def维度(self):
        返回长度(self._形状)
    
    def大小(self):
        返回_乘积(self._形状)
    
    def重塑(self,新形状):
        如果_乘积(新形状)!=self.大小():
            抛出值错误('无法重塑')
        返回数组(self._扁平化(self._数据),新形状)
    
    def转置(self):
        如果self.维度()!=2:
            抛出值错误('转置仅支持二维数组')
        行数,列数=self._形状
        结果=[[0对于_在范围(行数)]对于_在范围(列数)]
        对于i在范围(行数):
            对于j在范围(列数):
                结果[j][i]=self[i,j]
        返回数组(结果)
    
    def扁平化(self):
        返回self._扁平化(self._数据)
    
    def求和(self,轴=无):
        如果轴是无:
            返回总和(self._扁平化(self._数据))
        返回self._沿轴运算(轴,总和)
    
    def均值(self,轴=无):
        如果轴是无:
            返回总和(self._扁平化(self._数据))/self.大小()
        返回self._沿轴运算(轴,lambda x:总和(x)/长度(x))
    
    def最大值(self,轴=无):
        如果轴是无:
            返回最大值(self._扁平化(self._数据))
        返回self._沿轴运算(轴,最大值)
    
    def最小值(self,轴=无):
        如果轴是无:
            返回最小值(self._扁平化(self._数据))
        返回self._沿轴运算(轴,最小值)
    
    def_沿轴运算(self,轴,运算):
        如果轴<0:
            轴+=self.维度()
        如果轴>=self.维度():
            抛出值错误('轴索引超出范围')
        
        def递归处理(数据,当前轴):
            如果当前轴==轴:
                返回运算(self._扁平化数据)如果是列表或元组(数据[0])否则运算(数据)
            返回[递归处理(子数据,当前轴+1)对于子数据在数据]
        
        结果=递归处理(self._数据,0)
        返回数组(结果)


def创建数组(数据,形状=无):
    返回数组(数据,形状)


def全零(形状):
    大小=_乘积(形状)
    返回数组([0]*大小,形状)


def全一(形状):
    大小=_乘积(形状)
    返回数组([1]*大小,形状)


def随机数组(形状,最小值=0,最大值=1):
    大小=_乘积(形状)
    返回数组([_随机均匀(最小值,最大值)对于_在范围(大小)],形状)


def范围数组(开始=0,结束=无,步长=1):
    如果结束是无:
        开始,结束=0,开始
    返回数组(列表(范围(开始,结束,步长)))


def矩阵乘法(a,b):
    如果a.维度()!=2或b.维度()!=2:
        抛出值错误('矩阵乘法仅支持二维数组')
    a_rows,a_cols=a.形状()
    b_rows,b_cols=b.形状()
    如果a_cols!=b_rows:
        抛出值错误('矩阵维度不匹配')
    
    结果=[[0对于_在范围(b_cols)]对于_在范围(a_rows)]
    对于i在范围(a_rows):
        对于j在范围(b_cols):
            对于k在范围(a_cols):
                结果[i][j]+=a[i,k]*b[k,j]
    返回数组(结果)


def点积(a,b):
    如果a.维度()!=1或b.维度()!=1:
        抛出值错误('点积仅支持一维数组')
    如果a.大小()!=b.大小():
        抛出值错误('向量长度不匹配')
    返回总和(x*y对于x,y在配对(a.扁平化(),b.扁平化()))


def外积(a,b):
    如果a.维度()!=1或b.维度()!=1:
        抛出值错误('外积仅支持一维数组')
    a_len=a.大小()
    b_len=b.大小()
    结果=[[0对于_在范围(b_len)]对于_在范围(a_len)]
    对于i在范围(a_len):
        对于j在范围(b_len):
            结果[i][j]=a[i]*b[j]
    返回数组(结果)


def连接(数组列表,轴=0):
    如果不是数组列表:
        抛出值错误('数组列表不能为空')
    
    第一个=数组列表[0]
    形状=列表(第一个.形状())
    
    对于arr在数组列表[1:]:
        如果arr.维度()!=第一个.维度():
            抛出值错误('所有数组必须具有相同维度')
    
    形状[轴]=总和(arr.形状()[轴]对于arr在数组列表)
    
    def递归连接(数组列表,当前轴):
        如果当前轴==轴:
            结果=[]
            对于arr在数组列表:
                结果.扩展(arr._数据)
            返回结果
        否则:
            子数组列表=[]
            对于i在范围(长度(数组列表[0]._数据)):
                子数组列表.append([arr._数据[i]对于arr在数组列表])
            返回[递归连接(sl,当前轴+1)对于sl在子数组列表]
    
    返回数组(递归连接(数组列表,0))


def切片(数组,起始=无,结束=无,步长=无):
    如果数组.维度()!=1:
        抛出值错误('切片仅支持一维数组')
    数据=数组.扁平化()
    返回数组(数据[起始:结束:步长])