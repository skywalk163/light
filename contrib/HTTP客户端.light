class HTTP客户端:
    def初始化(超时=30,最大重定向=5):
        self._超时=超时
        self._最大重定向=最大重定向
        self._cookie容器=[]
        self._headers={'User-Agent':'LightLang/1.0','Accept':'*/*'}
    
    def设置超时(秒数):
        self._超时=秒数
    
    def设置用户代理(UA):
        self._headers['User-Agent']=UA
    
    def设置请求头(名称,值):
        self._headers[名称]=值
    
    def设置多个请求头(headers):
        self._headers.更新(headers)
    
    defGET(URL,参数=无,headers=无):
        完整URL=self._构建URL(URL,参数)
        请求=self._创建请求(完整URL,'GET')
        self._添加请求头(请求,headers)
        返回self._执行请求(请求)
    
    defPOST(URL,数据=无,JSON数据=无,headers=无):
        请求=self._创建请求(URL,'POST')
        self._添加请求头(请求,headers)
        
        如果JSON数据:
            请求.添加头('Content-Type','application/json')
            请求数据=_编码JSON(JSON数据)
        否则如果数据:
            请求数据=_编码URL(数据)
        否则:
            请求数据=b''
        
        返回self._执行请求(请求,请求数据)
    
    defPUT(URL,数据=无,headers=无):
        请求=self._创建请求(URL,'PUT')
        self._添加请求头(请求,headers)
        
        如果数据:
            如果是字典(数据)或者是列表(数据):
                请求.添加头('Content-Type','application/json')
                请求数据=_编码JSON(数据)
            否则:
                请求数据=_编码字符串(数据)
        否则:
            请求数据=b''
        
        返回self._执行请求(请求,请求数据)
    
    defDELETE(URL,headers=无):
        请求=self._创建请求(URL,'DELETE')
        self._添加请求头(请求,headers)
        返回self._执行请求(请求)
    
    def上传文件(URL,文件路径,字段名='file',其他数据=无):
        文件内容=_读取文件(文件路径,'rb')
        文件名=_提取文件名(文件路径)
        boundary='----LightLangFormBoundary'+字符串(哈希(文件名)%10000)
        
        body部分=[]
        如果其他数据:
            对于键,值在其他数据.项():
                body部分.追加(_格式化字段(boundary,键,值))
        
        body部分.追加(_格式化文件(boundary,字段名,文件名,文件内容))
        body部分.追加(_结束边界(boundary))
        
        body=_连接字节(body部分)
        
        请求=self._创建请求(URL,'POST')
        请求.添加头('Content-Type',f'multipart/form-data; boundary={boundary}')
        self._添加请求头(请求)
        
        返回self._执行请求(请求,body)
    
    def下载文件(URL,保存路径):
        请求=self._创建请求(URL,'GET')
        self._添加请求头(请求)
        
        响应=self._执行请求原始(请求)
        内容=响应.读取()
        
        _写入文件(保存路径,内容)
        
        返回{
            '成功':真,
            '状态码':响应.获取状态码(),
            '文件大小':长度(内容),
            '保存路径':保存路径
        }
    
    def获取Cookies():
        返回self._cookie容器
    
    def清除Cookies():
        self._cookie容器=[]
    
    def_构建URL(URL,参数):
        如果参数:
            查询字符串=_编码URL参数(参数)
            如果'?'在URL:
                return URL+'&'+查询字符串
            否则:
                return URL+'?'+查询字符串
        返回URL
    
    def_创建请求(URL,方法):
        返回_创建HTTP请求(URL,方法)
    
    def_添加请求头(请求,额外headers):
        对于名称,值在self._headers.项():
            请求.添加头(名称,值)
        如果额外headers:
            对于名称,值在额外headers.项():
                请求.添加头(名称,值)
    
    def_执行请求(请求,数据=b''):
        尝试:
            响应=_执行HTTP请求(请求,数据,self._超时)
            返回self._解析响应(响应)
        除网络错误(e):
            返回{'成功':假,'错误':字符串(e),'状态码':无}
        除超时错误:
            返回{'成功':假,'错误':'请求超时','状态码':无}
    
    def_解析响应(响应):
        内容=响应.读取()
        编码=响应.获取编码()或'utf-8'
        
        尝试:
            文本内容=_解码字节(内容,编码)
            尝试:
                JSON数据=_解析JSON(文本内容)
                返回{
                    '成功':真,
                    '状态码':响应.获取状态码(),
                    '内容':JSON数据,
                    '文本':文本内容,
                    '响应头':响应.获取所有头(),
                    'URL':响应.获取URL()
                }
            除JSON解析错误:
                返回{
                    '成功':真,
                    '状态码':响应.获取状态码(),
                    '内容':无,
                    '文本':文本内容,
                    '响应头':响应.获取所有头(),
                    'URL':响应.获取URL()
                }
        除解码错误:
            返回{
                '成功':真,
                '状态码':响应.获取状态码(),
                '内容':无,
                '二进制':内容,
                '响应头':响应.获取所有头(),
                'URL':响应.获取URL()
            }


defHTTPGET(URL,参数=无,headers=无):
    客户端=HTTP客户端()
    return客户端.GET(URL,参数,headers)


defHTTPPOST(URL,数据=无,JSON数据=无):
    客户端=HTTP客户端()
    return客户端.POST(URL,数据,JSON数据)


defHTTPPUT(URL,数据=无):
    客户端=HTTP客户端()
    return客户端.PUT(URL,数据)


defHTTPDELETE(URL):
    客户端=HTTP客户端()
    return客户端.DELETE(URL)


def上传文件(URL,文件路径,字段名='file'):
    客户端=HTTP客户端()
    return客户端.上传文件(URL,文件路径,字段名)


def下载文件(URL,保存路径):
    客户端=HTTP客户端()
    return客户端.下载文件(URL,保存路径)


def创建HTTP客户端(超时=30):
    returnHTTP客户端(超时)


def获取网页内容(URL):
    结果=HTTPGET(URL)
    return结果.获取('文本','')如果结果['成功']否则''


def获取JSON数据(URL):
    客户端=HTTP客户端()
    客户端.设置请求头('Accept','application/json')
    结果=客户端.GET(URL)
    return结果.获取('内容')如果结果['成功']否则无


def发送表单数据(URL,数据):
    returnHTTPPOST(URL,数据=数据)


def发送JSON数据(URL,数据):
    returnHTTPPOST(URL,JSON数据=数据)


def检查URL可达(URL,超时=5):
    尝试:
        客户端=HTTP客户端(超时=超时)
        结果=客户端.GET(URL)
        return结果['成功']且结果['状态码']<400
    除异常:
        return假


def获取URL状态码(URL):
    客户端=HTTP客户端()
    结果=客户端.GET(URL)
    return结果.获取('状态码')


def批量GET请求(URL列表,并发数=5):
    客户端=HTTP客户端()
    结果列表=[]
    
    对于URL在URL列表:
        结果列表.追加(客户端.GET(URL))
    
    返回结果列表


def解析响应JSON(响应数据):
    return响应数据.获取('内容')


def获取响应头(响应数据,名称):
    响应头=响应数据.获取('响应头',{})
    return响应头.获取(名称)


def设置基础认证(用户名,密码):
    认证字符串=_编码Base64(用户名+':'+密码)
    return{'Authorization':f'Basic {认证字符串}'}


def设置Bearer认证(token):
    return{'Authorization':f'Bearer {token}'}


def流式下载(URL,保存路径,进度回调=无):
    请求=_创建HTTP请求(URL,'GET')
    
    尝试:
        响应=_执行HTTP请求(请求,b'',30)
        文件大小=转换整数(响应.获取头('Content-Length')或'0')
        已下载=0
        
        打开(保存路径,'wb')作为f:
            当真:
                块=响应.读取(8192)
                如果不是块:
                    中断
                f.写入(块)
                已下载+=长度(块)
                如果进度回调且文件大小>0:
                    进度=已下载/文件大小*100
                    进度回调(进度,已下载,文件大小)
        
        返回{
            '成功':真,
            '文件大小':文件大小,
            '保存路径':保存路径
        }
    除异常(e):
        返回{'成功':假,'错误':字符串(e)}