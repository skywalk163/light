class 审计记录:
    def初始化(操作者,操作,目标,详情=无,结果='成功',IP地址='',时间戳=无):
        self.操作者=操作者
        self.操作=操作
        self.目标=目标
        self.详情=详情或{}
        self.结果=结果
        self.IP地址=IP地址
        self.时间戳=时间戳或_当前时间戳()
        self.记录ID=_SHA256哈希(操作者+操作+目标+字符串(self.时间戳))[:16]
    
    def到字典():
        return{
            '记录ID':self.记录ID,
            '操作者':self.操作者,
            '操作':self.操作,
            '目标':self.目标,
            '详情':self.详情,
            '结果':self.结果,
            'IP地址':self.IP地址,
            '时间戳':self.时间戳
        }


class 审计日志:
    def初始化(存储路径=无):
        self._记录列表=[]
        self._存储路径=存储路径
        self._变更追踪={}
        self._回调列表=[]
    
    def记录(操作者,操作,目标,详情=无,结果='成功',IP地址=''):
        记录=审计记录(操作者,操作,目标,详情,结果,IP地址)
        self._记录列表.追加(记录)
        
        对于回调在self._回调列表:
            尝试:
                回调(记录)
            除异常:
                跳过
        
        return记录
    
    def追踪变更(目标,字段,旧值,新值,操作者=''):
        变更记录={
            '字段':字段,
            '旧值':旧值,
            '新值':新值,
            '操作者':操作者,
            '时间戳':_当前时间戳()
        }
        
        如果目标不在self._变更追踪:
            self._变更追踪[目标]=[]
        self._变更追踪[目标].追加(变更记录)
        
        self.记录(操作者,'变更',目标,变更记录)
    
    def获取变更历史(目标):
        return self._变更追踪.获取(目标,[]).复制()
    
    def查询(操作者=无,操作=无,目标=无,结果=无):
        过滤结果=self._记录列表
        
        如果操作者:
            过滤结果=[r对于r在过滤结果如果r.操作者==操作者]
        如果操作:
            过滤结果=[r对于r在过滤结果如果r.操作==操作]
        如果目标:
            过滤结果=[r对于r在过滤结果如果r.目标==目标]
        如果结果:
            过滤结果=[r对于r在过滤结果如果r.结果==结果]
        
        return过滤结果
    
    def获取操作者活动(操作者):
        return[r对于r在self._记录列表如果r.操作者==操作者]
    
    def获取目标历史(目标):
        return[r对于r在self._记录列表如果r.目标==目标]
    
    def获取失败操作():
        return[r对于r在self._记录列表如果r.结果!='成功']
    
    def统计操作次数():
        统计={}
        对于记录在self._记录列表:
            统计[记录.操作]=统计.获取(记录.操作,0)+1
        return统计
    
    def总记录数():
        return长度(self._记录列表)
    
    def清空():
        self._记录列表=[]
        self._变更追踪={}
    
    def注册回调(回调函数):
        self._回调列表.追加(回调函数)


class 合规报告生成器:
    def初始化(审计日志实例):
        self._审计日志=审计日志实例
    
    def生成操作统计报告():
        return{
            '总操作数':self._审计日志.总记录数(),
            '操作统计':self._审计日志.统计操作次数(),
            '失败操作数':长度(self._审计日志.获取失败操作())
        }
    
    def生成安全审计报告():
        失败操作=self._审计日志.获取失败操作()
        
        return{
            '总操作数':self._审计日志.总记录数(),
            '失败操作数':长度(失败操作),
            '失败率':长度(失败操作)/最大(self._审计日志.总记录数(),1)*100
        }


def创建审计日志(存储路径=无):
    return审计日志(存储路径)

def创建合规报告生成器(审计日志实例):
    return合规报告生成器(审计日志实例)