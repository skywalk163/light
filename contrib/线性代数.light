def行列式(矩阵):
    n=长度(矩阵)
    如果n==0:
        返回1.0
    如果n==1:
        返回矩阵[0][0]
    如果n==2:
        返回矩阵[0][0]*矩阵[1][1]-矩阵[0][1]*矩阵[1][0]
    
    结果=0.0
    对于j在范围(n):
        符号=(-1)**j
        子矩阵=[]
        对于i在范围(1,n):
            子行=[]
            对于k在范围(n):
                如果k!=j:
                    子行.追加(矩阵[i][k])
            子矩阵.追加(子行)
        结果+=符号*矩阵[0][j]*行列式(子矩阵)
    
    返回结果


def转置(矩阵):
    行数=长度(矩阵)
    列数=长度(矩阵[0])如果矩阵否则0
    返回[[矩阵[i][j]对于i在范围(行数)]对于j在范围(列数)]


def矩阵乘法(a,b):
    a_rows=长度(a)
    a_cols=长度(a[0])如果a否则0
    b_rows=长度(b)
    b_cols=长度(b[0])如果b否则0
    
    如果a_cols!=b_rows:
        抛出值错误('矩阵维度不匹配')
    
    结果=[[0.0对于_在范围(b_cols)]对于_在范围(a_rows)]
    对于i在范围(a_rows):
        对于j在范围(b_cols):
            对于k在范围(a_cols):
                结果[i][j]+=a[i][k]*b[k][j]
    返回结果


def矩阵加法(a,b):
    如果长度(a)!=长度(b)或(a和b和长度(a[0])!=长度(b[0])):
        抛出值错误('矩阵形状必须相同')
    
    返回[[a[i][j]+b[i][j]对于j在范围(长度(a[0]))]对于i在范围(长度(a))]


def矩阵减法(a,b):
    如果长度(a)!=长度(b)或(a和b和长度(a[0])!=长度(b[0])):
        抛出值错误('矩阵形状必须相同')
    
    返回[[a[i][j]-b[i][j]对于j在范围(长度(a[0]))]对于i在范围(长度(a))]


def标量乘法(矩阵,标量):
    返回[[矩阵[i][j]*标量对于j在范围(长度(矩阵[0]))]对于i在范围(长度(矩阵))]


def单位矩阵(n):
    返回[[1.0如果i==j否则0.0对于j在范围(n)]对于i在范围(n)]


def零矩阵(行数,列数):
    返回[[0.0对于_在范围(列数)]对于_在范围(行数)]


def逆矩阵(矩阵):
    n=长度(矩阵)
    如果n==0:
        抛出值错误('矩阵不能为空')
    如果任意(长度(row)!=n对于row在矩阵):
        抛出值错误('必须是方阵')
    
    增广矩阵=[]
    对于i在范围(n):
        行=列表(矩阵[i])+[1.0如果j==i否则0.0对于j在范围(n)]
        增广矩阵.追加(行)
    
    对于主元列在范围(n):
        最大值=绝对值(增广矩阵[主元列][主元列])
        主元行=主元列
        对于i在范围(主元列+1,n):
            如果绝对值(增广矩阵[i][主元列])>最大值:
                最大值=绝对值(增广矩阵[i][主元列])
                主元行=i
        
        增广矩阵[主元列],增广矩阵[主元行]=增广矩阵[主元行],增广矩阵[主元列]
        
        主元值=增广矩阵[主元列][主元列]
        如果绝对值(主元值)<1e-10:
            抛出值错误('矩阵不可逆')
        
        对于j在范围(2*n):
            增广矩阵[主元列][j]/=主元值
        
        对于i在范围(n):
            如果i!=主元列:
                因子=增广矩阵[i][主元列]
                对于j在范围(2*n):
                    增广矩阵[i][j]-=因子*增广矩阵[主元列][j]
    
    逆矩阵=[row[n:]对于row在增广矩阵]
    返回逆矩阵


def高斯消元(系数矩阵,常数向量):
    n=长度(系数矩阵)
    如果长度(常数向量)!=n:
        抛出值错误('系数矩阵和常数向量长度不匹配')
    
    增广矩阵=[]
    对于i在范围(n):
        行=列表(系数矩阵[i])+[常数向量[i]]
        增广矩阵.追加(行)
    
    对于主元列在范围(n):
        最大值=绝对值(增广矩阵[主元列][主元列])
        主元行=主元列
        对于i在范围(主元列+1,n):
            如果绝对值(增广矩阵[i][主元列])>最大值:
                最大值=绝对值(增广矩阵[i][主元列])
                主元行=i
        
        增广矩阵[主元列],增广矩阵[主元行]=增广矩阵[主元行],增广矩阵[主元列]
        
        主元值=增广矩阵[主元列][主元列]
        如果绝对值(主元值)<1e-10:
            抛出值错误('系数矩阵奇异')
        
        对于i在范围(主元列+1,n):
            因子=增广矩阵[i][主元列]/主元值
            对于j在范围(主元列,n+1):
                增广矩阵[i][j]-=因子*增广矩阵[主元列][j]
    
    x=[0.0]*n
    对于i在范围(n-1,-1,-1):
        x[i]=增广矩阵[i][n]
        对于j在范围(i+1,n):
            x[i]-=增广矩阵[i][j]*x[j]
        x[i]/=增广矩阵[i][i]
    
    返回x


def求解线性方程组(系数矩阵,常数向量):
    返回高斯消元(系数矩阵,常数向量)


defLU分解(矩阵):
    n=长度(矩阵)
    L=零矩阵(n,n)
    U=[列表(row)对于row在矩阵]
    
    对于i在范围(n):
        L[i][i]=1.0
    
    对于主元列在范围(n):
        对于i在范围(主元列+1,n):
            因子=U[i][主元列]/U[主元列][主元列]
            L[i][主元列]=因子
            对于j在范围(主元列,n):
                U[i][j]-=因子*U[主元列][j]
    
    返回L,U


defQR分解(矩阵):
    n=长度(矩阵)
    列数=长度(矩阵[0])如果矩阵否则0
    
    Q=零矩阵(n,列数)
    R=零矩阵(列数,列数)
    
    对于j在范围(列数):
        v=[矩阵[i][j]对于i在范围(n)]
        
        对于i在范围(j):
            投影=总和(Q[k][i]*v[k]对于k在范围(n))
            R[i][j]=投影
            对于k在范围(n):
                v[k]-=投影*Q[k][i]
        
        范数=_平方根(总和(x**2对于x在v))
        R[j][j]=范数
        
        对于i在范围(n):
            Q[i][j]=v[i]/范数
    
    返回Q,R


def特征值(矩阵,迭代次数=100):
    n=长度(矩阵)
    
    x=[1.0]*n
    对于_在范围(迭代次数):
        y=[0.0]*n
        对于i在范围(n):
            对于j在范围(n):
                y[i]+=矩阵[i][j]*x[j]
        
        范数=_平方根(总和(v**2对于v在y))
        如果范数<1e-10:
            中断
        x=[v/范数对于v在y]
    
    特征值=总和(总和(矩阵[i][j]*x[j]对于j在范围(n))*x[i]对于i在范围(n))
    返回[特征值]


def向量范数(向量,阶数=2):
    如果阶数==_无穷大():
        返回最大值(绝对值(x)对于x在向量)
    如果阶数==1:
        返回总和(绝对值(x)对于x在向量)
    返回_幂(总和(绝对值(x)**阶数对于x在向量),1.0/阶数)


def矩阵范数(矩阵,类型='Frobenius'):
    如果类型=='Frobenius':
        返回_平方根(总和(总和(x**2对于x在row)对于row在矩阵))
    否则如果类型=='行和':
        返回最大值(总和(绝对值(x)对于x在row)对于row在矩阵)
    否则如果类型=='列和':
        列数=长度(矩阵[0])如果矩阵否则0
        返回最大值(总和(绝对值(矩阵[i][j])对于i在范围(长度(矩阵)))对于j在范围(列数))
    否则:
        抛出值错误('未知范数类型')


def向量内积(a,b):
    如果长度(a)!=长度(b):
        抛出值错误('向量长度必须相同')
    返回总和(x*y对于x,y在配对(a,b))


def向量正交化(向量列表):
    结果=[]
    对于v在向量列表:
        新向量=列表(v)
        对于u在结果:
            投影=向量内积(v,u)/向量内积(u,u)
            对于i在范围(长度(新向量)):
                新向量[i]-=投影*u[i]
        结果.追加(新向量)
    返回结果


def向量单位化(向量):
    范数=向量范数(向量)
    如果范数<1e-10:
        抛出值错误('零向量无法单位化')
    返回[x/范数对于x在向量]


def条件数(矩阵):
    尝试:
        逆=逆矩阵(矩阵)
        返回矩阵范数(矩阵)*矩阵范数(逆)
    除值错误:
        返回_无穷大()


def秩(矩阵):
    n=长度(矩阵)
    m=长度(矩阵[0])如果矩阵否则0
    
    副本=[列表(row)对于row在矩阵]
    秩=0
    
    对于主元列在范围(最小(n,m)):
        最大值=绝对值(副本[秩][主元列])
        主元行=秩
        对于i在范围(秩+1,n):
            如果绝对值(副本[i][主元列])>最大值:
                最大值=绝对值(副本[i][主元列])
                主元行=i
        
        如果绝对值(最大值)<1e-10:
            继续
        
        副本[秩],副本[主元行]=副本[主元行],副本[秩]
        
        对于i在范围(n):
            如果i!=秩和绝对值(副本[i][主元列])>1e-10:
                因子=副本[i][主元列]/副本[秩][主元列]
                对于j在范围(m):
                    副本[i][j]-=因子*副本[秩][j]
        
        秩+=1
    
    返回秩


def迹(矩阵):
    n=长度(矩阵)
    返回总和(矩阵[i][i]对于i在范围(n))


def对角化(矩阵):
    n=长度(矩阵)
    对角矩阵=零矩阵(n,n)
    
    特征值列表=[]
    对于_在范围(n):
        特征值列表.追加(特征值(矩阵)[0])
    
    对于i在范围(n):
        对角矩阵[i][i]=特征值列表[i]
    
    返回对角矩阵,对角矩阵