# class线程:
#     def__init__(self,函数,*参数,名称=无,守护线程=假,**关键字参数):
#
#     def开始(self):
#
#     def等待(self,超时=无):
#
#     def是否存活(self):
#
#     def是否完成(self):
#         返回self._已完成
#
#     def获取结果(self,超时=无):
#             抛出错误("线程执行超时")
#         返回self._结果
#
#     def获取异常(self):
#         返回self._异常
#
# class互斥锁:
#     def__init__(self,可重入=假):
#
#     def加锁(self,阻塞=真,超时=-1):
#
#     def解锁(self):
#
#     def已锁定(self):
#
# class信号量:
#     def__init__(self,初始值=1):
#
#     def获取(self,阻塞=真,超时=无):
#
#     def释放(self,n=1):
#
# class事件:
#     def__init__(self):
#
#     def设置(self):
#
#     def清除(self):
#
#     def是否已设置(self):
#
#     def等待(self,超时=无):
#
# class线程安全队列:
#     def__init__(self,最大容量=0):
#
#     def入队(self,项目,阻塞=真,超时=无):
#
#     def出队(self,阻塞=真,超时=无):
#
#     def大小(self):
#
#     def空(self):
#
#     def满(self):
#
#     def清空(self):
#
# class线程池:
#     def__init__(self,最大线程数=4):
#
#     def启动(self):
#
#     def提交(self,函数,*参数,结果回调=无,**关键字参数):
#
#     def等待完成(self):
#
#     def关闭(self,等待=真):
#
#     def取活跃任务数(self):
#
#     def取待处理任务数(self):
#
#     def取最大线程数(self):
#         返回self._最大线程数
#
# 用法：
#   从《线程》导入《创建线程》。

导出 创建线程 当前线程 当前线程标识 活跃线程数 主线程 枚举线程。
导出 线程 互斥锁 信号量 事件 条件变量 栅栏。
导出 线程安全队列 线程池 并发执行 并发执行带参数。
