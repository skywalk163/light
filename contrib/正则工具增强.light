# 文体: 文言
# 正则工具增强 — 对 stdlib/正则表达式.light 的中文场景补充
# 提供：身份证GB11643校验/中国车牌/银行卡Luhn/文本批量抽取

导 正则表达式 出 正则, 匹配, 搜索

引 Python 正则增强_后端:
    from contrib.正则工具增强 import (
        校验身份证 as _l2re_id_check, 升级15位到18位 as _l2re_id15_18,
        校验车牌 as _l2re_plate_check,
        校验银行卡 as _l2re_bank_check,
        抽取手机号 as _l2re_ext_mobile, 抽取邮箱 as _l2re_ext_email,
        抽取身份证 as _l2re_ext_id, 抽取URL as _l2re_ext_url,
        抽取姓名 as _l2re_ext_name, 抽取车牌 as _l2re_ext_plate,
        抽取银行卡 as _l2re_ext_bank,
    )
    # 沙箱隔离里强制暴露
    def l3_re_id_check(s, strict=True): return _l2re_id_check(s, 严格地区=strict)
    def l3_re_id_upgrade(s): return _l2re_id15_18(s)
    def l3_re_plate_check(s): return _l2re_plate_check(s)
    def l3_re_bank_check(s): return _l2re_bank_check(s)
    def l3_re_ext_mobile(t): return _l2re_ext_mobile(t)
    def l3_re_ext_email(t): return _l2re_ext_email(t)
    def l3_re_ext_id(t, v=True): return _l2re_ext_id(t, 校验位=v)
    def l3_re_ext_url(t): return _l2re_ext_url(t)
    def l3_re_ext_name(t, stop=None): return _l2re_ext_name(t, 排除停用词=stop or [])
    def l3_re_ext_plate(t, must_ok=True): return _l2re_ext_plate(t, 必须合法=must_ok)
    def l3_re_ext_bank(t, must_ok=True): return _l2re_ext_bank(t, 必须Luhn合法=must_ok)
结束引

段 校验身份证(号: 串, 严格地区: 逻辑 = 真) -> 典:
    """返回 典：是否合法/原因/版本/地区前缀/生日/性别/校验位"""
    返 l3_re_id_check(号, 严格地区)

段 升级15位身份证到18位(号: 串) -> 串:
    返 l3_re_id_upgrade(号)

段 校验车牌(号: 串) -> 典:
    """返回 典：是否合法/类型/省份简称/字母/号码/原因"""
    返 l3_re_plate_check(号)

段 校验银行卡(号: 串) -> 典:
    """返回 典：是否合法/长度/校验和通过/品牌/原因"""
    返 l3_re_bank_check(号)

段 抽取手机号(文本: 串) -> 列: 返 l3_re_ext_mobile(文本)
段 抽取邮箱(文本: 串) -> 列: 返 l3_re_ext_email(文本)
段 抽取身份证(文本: 串, 需校验: 逻辑 = 真) -> 列: 返 l3_re_ext_id(文本, 需校验)
段 抽取URL(文本: 串) -> 列: 返 l3_re_ext_url(文本)
段 抽取姓名(文本: 串, 停用词: 列 = []) -> 列: 返 l3_re_ext_name(文本, 停用词)
段 抽取车牌(文本: 串, 需合法: 逻辑 = 真) -> 列: 返 l3_re_ext_plate(文本, 需合法)
段 抽取银行卡(文本: 串, 需校验和: 逻辑 = 真) -> 列: 返 l3_re_ext_bank(文本, 需校验和)

出 校验身份证, 升级15位身份证到18位, 校验车牌, 校验银行卡,
   抽取手机号, 抽取邮箱, 抽取身份证, 抽取URL, 抽取姓名, 抽取车牌, 抽取银行卡
