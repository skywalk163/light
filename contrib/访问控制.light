class 权限:
    def初始化(名称,描述=''):
        self.名称=名称
        self.描述=描述

class 角色:
    def初始化(名称,描述=''):
        self.名称=名称
        self.描述=描述
        self._权限集合=集合()
        self._父角色集合=集合()
    
    def添加权限(权限名):
        self._权限集合.添加(权限名)
    
    def移除权限(权限名):
        self._权限集合.丢弃(权限名)
    
    def获取权限():
        return self._权限集合.复制()
    
    def添加父角色(角色名):
        self._父角色集合.添加(角色名)
    
    def获取父角色():
        return self._父角色集合.复制()
    
    def包含权限(权限名):
        return权限名在self._权限集合


class RBAC管理器:
    def初始化():
        self._角色字典={}
        self._用户角色映射={}
    
    def创建角色(名称,描述=''):
        新角色=角色(名称,描述)
        self._角色字典[名称]=新角色
        return新角色
    
    def获取角色(名称):
        return self._角色字典.获取(名称)
    
    def删除角色(名称):
        如果名称在self._角色字典:
            删除self._角色字典[名称]
            return真
        return假
    
    def给角色授权(角色名,权限名):
        角色=self.获取角色(角色名)
        如果角色:
            角色.添加权限(权限名)
            return真
        return假
    
    def撤销角色权限(角色名,权限名):
        角色=self.获取角色(角色名)
        如果角色:
            return角色.移除权限(权限名)
        return假
    
    def添加角色继承(子角色名,父角色名):
        子角色=self.获取角色(子角色名)
        如果子角色:
            子角色.添加父角色(父角色名)
            return真
        return假
    
    def获取角色所有权限(角色名,已访问=无):
        如果已访问是无:
            已访问=集合()
        
        如果角色名在已访问:
            return集合()
        已访问.添加(角色名)
        
        角色=self.获取角色(角色名)
        如果不是角色:
            return集合()
        
        权限集合=角色.获取权限()
        
        对于父角色名在角色.获取父角色():
            权限集合.更新(self.获取角色所有权限(父角色名,已访问))
        
        return权限集合
    
    def分配用户角色(用户ID,角色名):
        如果用户ID不在self._用户角色映射:
            self._用户角色映射[用户ID]=集合()
        self._用户角色映射[用户ID].添加(角色名)
    
    def移除用户角色(用户ID,角色名):
        如果用户ID在self._用户角色映射:
            self._用户角色映射[用户ID].丢弃(角色名)
            return真
        return假
    
    def获取用户角色(用户ID):
        return self._用户角色映射.获取(用户ID,集合()).复制()
    
    def获取用户权限(用户ID):
        权限集合=集合()
        对于角色名在self.获取用户角色(用户ID):
            权限集合.更新(self.获取角色所有权限(角色名))
        return权限集合
    
    def检查用户权限(用户ID,权限名):
        return权限名在self.获取用户权限(用户ID)
    
    def检查用户角色(用户ID,角色名):
        return角色名在self.获取用户角色(用户ID)


class ACL规则:
    def初始化(主体,资源,操作,允许=真):
        self.主体=主体
        self.资源=资源
        self.操作=操作
        self.允许=允许
    
    def匹配(主体,资源,操作):
        return(self.主体==主体或self.主体=='*')且(self.资源==资源或self.资源=='*')且(self.操作==操作或self.操作=='*')


class ACL管理器:
    def初始化():
        self._规则列表=[]
        self._默认允许=假
    
    def设置默认策略(允许):
        self._默认允许=允许
    
    def添加规则(主体,资源,操作,允许=真):
        self._规则列表.追加(ACL规则(主体,资源,操作,允许))
    
    def移除规则(主体,资源,操作):
        对于i,规则在枚举(self._规则列表):
            如果规则.主体==主体且规则.资源==资源且规则.操作==操作:
                删除self._规则列表[i]
                return真
        return假
    
    def检查权限(主体,资源,操作):
        对于规则在self._规则列表:
            如果规则.匹配(主体,资源,操作):
                return规则.允许
        return self._默认允许
    
    def清空规则():
        self._规则列表=[]


def创建RBAC管理器():
    return RBAC管理器()

def创建ACL管理器(默认允许=假):
    管理器=ACL管理器()
    管理器.设置默认策略(默认允许)
    return管理器