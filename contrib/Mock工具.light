class Mock调用记录:
    def初始化(方法名,参数,关键字参数,返回值=无,异常=无):
        self.方法名=方法名
        self.参数=参数
        self.关键字参数=关键字参数
        self.返回值=返回值
        self.异常=异常
        self.调用次数=1


class Mock对象:
    def初始化(目标类型=无):
        self._目标类型=目标类型
        self._调用记录=[]
        self._返回值映射={}
        self._副作用映射={}
        self._属性映射={}
        self._方法存根={}
    
    def设置返回值(方法名,返回值):
        self._返回值映射[方法名]=返回值
    
    def设置副作用(方法名,函数):
        self._副作用映射[方法名]=函数
    
    def设置属性(名称,值):
        self._属性映射[名称]=值
    
    def设置方法存根(方法名,函数):
        self._方法存根[方法名]=函数
    
    def获取调用记录(方法名=无):
        如果方法名:
            return[r对于r在self._调用记录如果r.方法名==方法名]
        return self._调用记录
    
    def获取调用次数(方法名=无):
        如果方法名:
            return长度(self.获取调用记录(方法名))
        return长度(self._调用记录)
    
    def重置调用记录():
        self._调用记录=[]
    
    def断言被调用(方法名=无,最少次数=1):
        次数=self.获取调用次数(方法名)
        如果次数<最少次数:
            方法描述=f"'{方法名}' "如果方法名否则''
            抛出断言错误(f"断言失败:方法{方法描述}调用次数{次数}<{最少次数}")
    
    def断言未被调用(方法名=无):
        次数=self.获取调用次数(方法名)
        如果次数>0:
            方法描述=f"'{方法名}' "如果方法名否则''
            抛出断言错误(f"断言失败:方法{方法描述}被调用了{次数}次")
    
    def断言被调用次数(方法名=无,期望次数=1):
        次数=self.获取调用次数(方法名)
        如果次数!=期望次数:
            方法描述=f"'{方法名}' "如果方法名否则''
            抛出断言错误(f"断言失败:方法{方法描述}调用次数{次数}!={期望次数}")
    
    def断言以参数调用(方法名,*期望参数,**期望关键字参数):
        记录=self.获取调用记录(方法名)
        对于r在记录:
            如果r.参数==期望参数且r.关键字参数==期望关键字参数:
                返回
        抛出断言错误(f"断言失败:方法'{方法名}'未以指定参数调用")
    
    def__获取属性__(名称):
        如果名称在self._属性映射:
            return self._属性映射[名称]
        
        如果名称在self._方法存根:
            def包装(*参数,**关键字参数):
                记录=Mock调用记录(名称,参数,关键字参数)
                
                尝试:
                    返回值=self._方法存根[名称](*参数,**关键字参数)
                    记录.返回值=返回值
                    self._调用记录.追加(记录)
                    return 返回值
                除异常(e):
                    记录.异常=e
                    self._调用记录.追加(记录)
                    抛出e
            
            return包装
        
        def模拟方法(*参数,**关键字参数):
            记录=Mock调用记录(名称,参数,关键字参数)
            
            如果名称在self._副作用映射:
                self._副作用映射[名称](*参数,**关键字参数)
            
            如果名称在self._返回值映射:
                返回值=self._返回值映射[名称]
                如果可调用(返回值):
                    返回值=返回值(*参数,**关键字参数)
                记录.返回值=返回值
            否则:
                返回值=Mock对象()
                记录.返回值=返回值
            
            self._调用记录.追加(记录)
            return 返回值
        
        return模拟方法


class Stub对象:
    def初始化():
        self._方法存根={}
        self._属性值={}
    
    def设置方法(方法名,函数):
        self._方法存根[方法名]=函数
    
    def设置属性(名称,值):
        self._属性值[名称]=值
    
    def__获取属性__(名称):
        如果名称在self._属性值:
            return self._属性值[名称]
        
        如果名称在self._方法存根:
            return self._方法存根[名称]
        
        return Stub对象()


class 打桩器:
    def初始化():
        self._原始对象={}
        self._原始方法={}
    
    def打桩对象(模块,对象名,替代对象):
        self._原始对象[(模块,对象名)]=_获取属性(模块,对象名)
        _设置属性(模块,对象名,替代对象)
    
    def打桩方法(对象,方法名,替代方法):
        self._原始方法[(对象,方法名)]=_获取属性(对象,方法名)
        _设置属性(对象,方法名,替代方法)
    
    def打桩属性(对象,属性名,替代值):
        self._原始方法[(对象,属性名)]=_获取属性(对象,属性名)
        _设置属性(对象,属性名,替代值)
    
    def恢复所有():
        对于(模块,对象名),原始对象在self._原始对象.项():
            _设置属性(模块,对象名,原始对象)
        
        对于(对象,方法名),原始方法在self._原始方法.项():
            _设置属性(对象,方法名,原始方法)


def创建Mock(目标类型=无):
    return Mock对象(目标类型)


def创建Stub():
    return Stub对象()


def创建打桩器():
    return打桩器()


defMock(目标类型=无):
    return Mock对象(目标类型)


defStub():
    return Stub对象()


def打桩(模块,对象名,替代对象):
    打桩器=创建打桩器()
    打桩器.打桩对象(模块,对象名,替代对象)
    return打桩器


def模拟返回(对象,方法名,返回值):
    如果是实例(对象,Mock对象):
        对象.设置返回值(方法名,返回值)
    否则:
        原始方法=_获取属性(对象,方法名)
        
        def包装(*参数,**关键字参数):
            return 返回值
        
        _设置属性(对象,方法名,包装)
        return原始方法


def模拟异常(对象,方法名,异常):
    如果是实例(对象,Mock对象):
        def抛出异常(*参数,**关键字参数):
            抛出异常
        
        对象.设置返回值(方法名,抛出异常)
    否则:
        原始方法=_获取属性(对象,方法名)
        
        def包装(*参数,**关键字参数):
            抛出异常
        
        _设置属性(对象,方法名,包装)
        return原始方法


def模拟副作用(对象,方法名,函数):
    如果是实例(对象,Mock对象):
        对象.设置副作用(方法名,函数)
    否则:
        原始方法=_获取属性(对象,方法名)
        
        def包装(*参数,**关键字参数):
            函数(*参数,**关键字参数)
            return原始方法(*参数,**关键字参数)
        
        _设置属性(对象,方法名,包装)
        return原始方法


def验证调用(对象,方法名,期望次数=1):
    如果是实例(对象,Mock对象):
        对象.断言被调用次数(方法名,期望次数)
    否则:
        抛出值错误('对象必须是Mock对象')


def验证未调用(对象,方法名=无):
    如果是实例(对象,Mock对象):
        对象.断言未被调用(方法名)
    否则:
        抛出值错误('对象必须是Mock对象')


class Mock上下文管理器:
    def初始化(模块,对象名,替代对象):
        self._模块=模块
        self._对象名=对象名
        self._替代对象=替代对象
        self._原始对象=无
    
    def__进入__():
        self._原始对象=_获取属性(self._模块,self._对象名)
        _设置属性(self._模块,self._对象名,self._替代对象)
        return self._替代对象
    
    def__退出__(exc_type,exc_val,exc_tb):
        _设置属性(self._模块,self._对象名,self._原始对象)


defMock上下文(模块,对象名,替代对象):
    return Mock上下文管理器(模块,对象名,替代对象)