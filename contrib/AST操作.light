class AST工具:
    @静态方法
    def解析代码(代码):
        return_解析AST(代码)
    
    @静态方法
    def解析文件(文件路径):
        文件=_打开文件(文件路径,'r')
        代码=文件.读取()
        文件.关闭()
        return_解析AST(代码)
    
    @静态方法
    def生成代码(树):
        return_AST转代码(树)
    
    @静态方法
    def美化输出(树):
        return_AST转字符串(树)
    
    @静态方法
    def获取函数节点(树,函数名):
        对于节点在_遍历AST(树):
            如果节点.类型=='FunctionDef'且节点.名称==函数名:
                return节点
        return无
    
    @静态方法
    def获取类节点(树,类名):
        对于节点在_遍历AST(树):
            如果节点.类型=='ClassDef'且节点.名称==类名:
                return节点
        return无
    
    @静态方法
    def获取所有函数(树):
        return[节点对于节点在_遍历AST(树)如果节点.类型=='FunctionDef']
    
    @静态方法
    def获取所有类(树):
        return[节点对于节点在_遍历AST(树)如果节点.类型=='ClassDef']


class AST转换器:
    def初始化():
        self.修改计数=0
    
    def替换函数名(树,旧名称,新名称):
        对于节点在_遍历AST(树):
            如果节点.类型=='FunctionDef'且节点.名称==旧名称:
                节点.名称=新名称
                self.修改计数+=1
            如果节点.类型=='Call'且节点.函数名==旧名称:
                节点.函数名=新名称
                self.修改计数+=1
        return树
    
    def重命名变量(树,旧名称,新名称):
        对于节点在_遍历AST(树):
            如果节点.类型=='Name'且节点.标识==旧名称:
                节点.标识=新名称
                self.修改计数+=1
        return树


class 代码生成器:
    @静态方法
    def生成函数(函数名,参数列表=无,函数体='跳过'):
        参数=', '.连接(参数列表)如果参数列表否则''
        函数体缩进='    '.函数体.分割('\n').连接('\n    ')
        
        return'def '+函数名+'('+参数+'):\n    '+函数体缩进+'\n'
    
    @静态方法
    def生成类(类名,父类列表=无,属性字典=无,方法字典=无):
        父类=', '.连接(父类列表)如果父类列表否则''
        类头部='class '+类名+'('+父类+'):'如果父类否则'class '+类名+':'
        
        类体=[]
        
        如果属性字典:
            对于属性名,属性值在属性字典.项():
                类体.追加('    '+属性名+' = '+字符串(属性值))
        
        如果方法字典:
            对于方法名,方法体在方法字典.项():
                缩进方法体='        '.方法体.分割('\n').连接('\n        ')
                类体.追加('    def '+方法名+'(self):\n        '+缩进方法体)
        
        如果不是类体:
            类体.追加('    跳过')
        
        return类头部+'\n'+'\n'.连接(类体)+'\n'
    
    @静态方法
    def生成单例(类名):
        return'class '+类名+':\n    _实例 = 无\n\n    def __新建__(cls):\n        如果cls._实例是无:\n            cls._实例 = 超级().__新建__(cls)\n        return cls._实例\n'


class 代码分析器:
    def初始化(代码=无,文件路径=无):
        如果代码:
            self.AST=AST工具.解析代码(代码)
        否则如果文件路径:
            self.AST=AST工具.解析文件(文件路径)
        否则:
            抛出值错误('必须提供代码或文件路径')
    
    def函数数量():
        return长度(AST工具.获取所有函数(self.AST))
    
    def类数量():
        return长度(AST工具.获取所有类(self.AST))
    
    def行数量(代码):
        return长度(代码.去除空白().分割('\n'))
    
    def生成报告():
        return{
            '函数数量':self.函数数量(),
            '类数量':self.类数量(),
        }


class 模式匹配器:
    @静态方法
    def查找模式(树,模式函数):
        return[节点对于节点在_遍历AST(树)如果模式函数(节点)]
    
    @静态方法
    def查找空函数(树):
        def是空函数(节点):
            如果节点.类型!='FunctionDef':
                return假
            如果长度(节点.体)==0:
                return真
            如果长度(节点.体)==1且节点.体[0].类型=='Pass':
                return真
            return假
        
        return模式匹配器.查找模式(树,是空函数)


def解析代码(代码):
    return AST工具.解析代码(代码)


def生成代码(树):
    return AST工具.生成代码(树)


def分析代码(代码):
    分析器=代码分析器(代码)
    return分析器.生成报告()


def生成函数(函数名,参数列表=无,函数体='跳过'):
    return代码生成器.生成函数(函数名,参数列表,函数体)


def生成类(类名,父类列表=无,属性字典=无,方法字典=无):
    return代码生成器.生成类(类名,父类列表,属性字典,方法字典)