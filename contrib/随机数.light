def随机日期(开始年份=1970,结束年份=2030):
    年=随机整数(开始年份,结束年份)
    月=随机整数(1,12)
    
    如果月在[4,6,9,11]:
        最大日=30
    否则如果月==2:
        如果(年%4==0且年%100!=0)或年%400==0:
            最大日=29
        否则:
            最大日=28
    否则:
        最大日=31
    
    日=随机整数(1,最大日)
    返回(年,月,日)


def生成随机序列(长度,分布='uniform',**参数):
    分布函数={
        'uniform':均匀分布,
        'normal':正态分布,
        'exponential':指数分布,
        'poisson':泊松分布,
        'binomial':二项分布,
        'gamma':伽马分布,
        'beta':贝塔分布,
        'weibull':威布尔分布,
        'triangular':三角分布,
        'lognormal':对数正态分布,
    }
    
    如果分布不在分布函数:
        抛出值错误('未知分布')
    
    返回[分布函数[分布](**参数)对于_在范围(长度)]


def随机排列(n):
