class模板引擎:
    def__init__(self):
        self._过滤器={}
        self._全局变量={}
        self._模板缓存={}
    
    def注册过滤器(self,名称,函数):
        self._过滤器[名称]=函数
    
    def设置全局变量(self,**变量):
        self._全局变量.更新(变量)
    
    def渲染(self,模板内容,**变量):
        上下文=字典(self._全局变量)
        上下文.更新(变量)
        return self._解析模板(模板内容,上下文)
    
    def渲染文件(self,文件路径,**变量):
        如果文件路径不在self._模板缓存:
            打开(文件路径,'r',编码='utf-8')作为f:
                self._模板缓存[文件路径]=f.读取()
        return self.渲染(self._模板缓存[文件路径],**变量)
    
    def_解析模板(self,内容,上下文):
        内容=self._处理变量替换(内容,上下文)
        内容=self._处理条件判断(内容,上下文)
        内容=self._处理循环(内容,上下文)
        内容=self._处理过滤器(内容,上下文)
        返回内容
    
    def_处理变量替换(self,内容,上下文):
        模式=r'\{\{(\w+)\}\}'
        
        def替换(match):
            变量名=match.获取分组(1)
            如果变量名在上下文:
                返回转字符串(上下文[变量名])
            返回''
        
        return_替换正则表达式(_编译正则表达式(模式),内容,替换)
    
    def_处理条件判断(self,内容,上下文):
        模式=r'\{% if (\w+) %%\}(.*?)\{% endif %\}'
        
        def替换(match):
            变量名=match.获取分组(1)
            内容块=match.获取分组(2)
            如果变量名在上下文且上下文[变量名]:
                return self._解析模板(内容块,上下文)
            返回''
        
        return_替换正则表达式(_编译正则表达式(模式),内容,替换)
    
    def_处理循环(self,内容,上下文):
        模式=r'\{% for (\w+) in (\w+) %%\}(.*?)\{% endfor %\}'
        
        def替换(match):
            元素名=match.获取分组(1)
            列表名=match.获取分组(2)
            内容块=match.获取分组(3)
            
            如果列表名不在上下文:
                返回''
            
            列表=上下文[列表名]
            如果不是列表或元组(列表):
                返回''
            
            结果=[]
            对于元素在列表:
                新上下文=字典(上下文)
                新上下文[元素名]=元素
                结果.追加(self._解析模板(内容块,新上下文))
            返回_连接(结果)
        
        return_替换正则表达式(_编译正则表达式(模式),内容,替换)
    
    def_处理过滤器(self,内容,上下文):
        模式=r'\{\{(\w+)\|(\w+)\}\}'
        
        def替换(match):
            变量名=match.获取分组(1)
            过滤器名=match.获取分组(2)
            
            如果变量名不在上下文:
                返回''
            
            值=上下文[变量名]
            
            如果过滤器名在self._过滤器:
                return转字符串(self._过滤器[过滤器名](值))
            
            如果有属性(self,f'_过滤器_{过滤器名}'):
                return转字符串(获取属性(self,f'_过滤器_{过滤器名}')(值))
            
            返回转字符串(值)
        
        return_替换正则表达式(_编译正则表达式(模式),内容,替换)


def渲染模板(模板内容,**变量):
    引擎=模板引擎()
    return引擎.渲染(模板内容,**变量)


def渲染模板文件(文件路径,**变量):
    引擎=模板引擎()
    return引擎.渲染文件(文件路径,**变量)


def创建模板引擎():
    return模板引擎()


def变量替换(文本,**变量):
    引擎=模板引擎()
    return引擎._处理变量替换(文本,变量)


def条件渲染(文本,**变量):
    引擎=模板引擎()
    return引擎._处理条件判断(文本,变量)


def循环渲染(文本,**变量):
    引擎=模板引擎()
    return引擎._处理循环(文本,变量)


class简单模板:
    def__init__(self,模板内容):
        self._模板内容=模板内容
        self._变量={}
    
    def设置变量(self,**变量):
        self._变量.更新(变量)
    
    def渲染(self):
        结果=self._模板内容
        对于名称,值在self._变量.项():
            结果=结果.替换(f'{{{{{名称}}}}}',转字符串(值))
        返回结果
    
    def__str__(self):
        返回self._模板内容


class字符串模板:
    def__init__(self,模板):
        self._模板=模板
    
    def格式化(self,**变量):
        return self._模板.格式化(**变量)
    
    def安全格式化(self,**变量):
        转义变量={k:转字符串(v).替换('{','{{').replace('}','}}')对于k,v在变量.项()}
        return self._模板.格式化(**转义变量)


def格式化字符串(模板,**变量):
    return模板.格式化(**变量)


def安全格式化(模板,**变量):
    转义变量={k:转字符串(v).替换('{','{{').replace('}','}}')对于k,v在变量.项()}
    return模板.格式化(**转义变量)


defHTML转义(文本):
    映射={
        '&':'&amp;',
        '<':'&lt;',
        '>':'&gt;',
        '"':'&quot;',
        "'":'&#39;',
    }
    返回_连接([映射.获取(c,c)对于c在文本])


defHTML反转义(文本):
    映射={
        '&amp;':'&',
        '&lt;':'<',
        '&gt;':'>',
        '&quot;':'"',
        '&#39;':"'",
    }
    对于转义,原始在映射.项():
        文本=文本.替换(转义,原始)
    返回文本


def模板替换(文本,变量):
    对于名称,值在变量.项():
        文本=文本.替换(f'${名称}',转字符串(值))
    返回文本


def模板替换花括号(文本,变量):
    对于名称,值在变量.项():
        文本=文本.替换(f'{{{名称}}}',转字符串(值))
    返回文本


def生成HTML列表(项目列表,有序=假):
    标签='ol'如果有序否则'ul'
    项目=_连接([f'  <li>{HTML转义(item)}</li>'对于item在项目列表])
    返回f'<{标签}>\n{项目}\n</{标签}>'


def生成HTML表格(数据,表头=无):
    表头行=''
    如果表头:
        表头单元格=_连接([f'<th>{HTML转义(h)}</th>'对于h在表头])
        表头行=f'<thead><tr>{表头单元格}</tr></thead>\n'
    
    行内容=[]
    对于行在数据:
        单元格=_连接([f'<td>{HTML转义(转字符串(cell))}</td>'对于cell在行])
        行内容.追加(f'<tr>{单元格}</tr>')
    
    返回f'<table>\n{表头行}<tbody>\n{_连接(行内容)}\n</tbody>\n</table>'


def生成邮件模板(收件人,主题,内容):
    返回f"""To: {收件人}
Subject: {主题}

{内容}"""