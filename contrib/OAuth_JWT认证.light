class JWT异常(异常):
    pass

class 令牌过期异常(JWT异常):
    pass

class 令牌无效异常(JWT异常):
    pass


class 密码工具:
    @静态方法
    def哈希密码(密码,盐值=无,迭代次数=100000):
        如果盐值是无:
            盐值=_生成随机令牌(16)
        
        哈希值=_PBKDF2哈希(密码,盐值,迭代次数)
        
        return哈希值,盐值
    
    @静态方法
    def验证密码(密码,哈希值,盐值,迭代次数=100000):
        新哈希,_=密码工具.哈希密码(密码,盐值,迭代次数)
        return_安全比较(新哈希,哈希值)
    
    @静态方法
    def生成随机密码(长度=16):
        字符集='abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789!@#$%^&*'
        return''.连接(_安全选择(字符集)对于_在范围(长度))


class JWT令牌:
    def初始化(密钥,算法='HS256',过期时间=3600):
        self._密钥=密钥
        self._算法=算法
        self._过期时间=过期时间
    
    def生成令牌(载荷):
        头部={
            'alg':self._算法,
            'typ':'JWT'
        }
        
        当前时间=int(_当前时间戳())
        载荷['iat']=当前时间
        载荷['exp']=当前时间+self._过期时间
        载荷['jti']=_生成随机令牌(8)
        
        编码头=_Base64URL编码(字符串转字节(JSON字符串(头部)))
        编码载荷=_Base64URL编码(字符串转字节(JSON字符串(载荷)))
        
        签名输入=编码头+'.'+编码载荷
        签名=_HMAC签名(self._密钥,签名输入,self._算法)
        
        编码签名=_Base64URL编码(签名)
        
        return编码头+'.'+编码载荷+'.'+编码签名
    
    def验证令牌(令牌):
        部分=令牌.分割('.')
        如果长度(部分)!=3:
            抛出令牌无效异常('令牌格式无效')
        
        编码头,编码载荷,编码签名=部分
        
        签名输入=编码头+'.'+编码载荷
        期望签名=_HMAC签名(self._密钥,签名输入,self._算法)
        
        实际签名=_Base64URL解码(编码签名)
        
        如果不是_安全比较(期望签名,实际签名):
            抛出令牌无效异常('令牌签名无效')
        
        载荷=JSON解析(_字节转字符串(_Base64URL解码(编码载荷)))
        
        如果'exp'在载荷:
            如果_当前时间戳()>载荷['exp']:
                抛出令牌过期异常('令牌已过期')
        
        return载荷
    
    def刷新令牌(令牌,新过期时间=无):
        尝试:
            载荷=self.验证令牌(令牌)
        除令牌过期异常:
            部分=令牌.分割('.')
            载荷=JSON解析(_字节转字符串(_Base64URL解码(部分[1])))
        
        如果'exp'在载荷:
            删除载荷['exp']
        如果'iat'在载荷:
            删除载荷['iat']
        如果'jti'在载荷:
            删除载荷['jti']
        
        原过期时间=self._过期时间
        如果新过期时间:
            self._过期时间=新过期时间
        
        新令牌=self.生成令牌(载荷)
        self._过期时间=原过期时间
        
        return新令牌
    
    def解码令牌(令牌):
        部分=令牌.分割('.')
        如果长度(部分)!=3:
            抛出令牌无效异常('令牌格式无效')
        
        头部=JSON解析(_字节转字符串(_Base64URL解码(部分[0])))
        载荷=JSON解析(_字节转字符串(_Base64URL解码(部分[1])))
        
        return{'头部':头部,'载荷':载荷}


class OAuth2简化流程:
    def初始化(客户端ID,客户端密钥,授权服务器=''):
        self._客户端ID=客户端ID
        self._客户端密钥=客户端密钥
        self._授权服务器=授权服务器
        self._授权码存储={}
        self._访问令牌存储={}
    
    def生成授权码(用户ID,重定向URI,作用域=''):
        授权码=_生成随机令牌(32)
        self._授权码存储[授权码]={
            '用户ID':用户ID,
            '重定向URI':重定向URI,
            '作用域':作用域,
            '创建时间':_当前时间戳(),
            '已使用':假
        }
        return授权码
    
    def交换令牌(授权码,重定向URI):
        如果授权码不在self._授权码存储:
            return无
        
        授权信息=self._授权码存储[授权码]
        
        如果授权信息['已使用']:
            return无
        
        如果授权信息['重定向URI']!=重定向URI:
            return无
        
        授权信息['已使用']=真
        
        访问令牌=_生成随机令牌(32)
        刷新令牌值=_生成随机令牌(32)
        
        令牌信息={
            '访问令牌':访问令牌,
            '刷新令牌':刷新令牌值,
            '令牌类型':'Bearer',
            '过期时间':3600,
            '作用域':授权信息['作用域'],
            '用户ID':授权信息['用户ID']
        }
        
        self._访问令牌存储[访问令牌]=令牌信息
        
        return令牌信息
    
    def验证访问令牌(访问令牌):
        如果访问令牌不在self._访问令牌存储:
            return无
        return self._访问令牌存储[访问令牌]
    
    def撤销令牌(访问令牌):
        如果访问令牌在self._访问令牌存储:
            删除self._访问令牌存储[访问令牌]
            return真
        return假


class 会话管理器:
    def初始化(过期时间=1800):
        self._会话字典={}
        self._过期时间=过期时间
    
    def创建会话(用户ID,数据=无):
        会话ID=_生成随机令牌(32)
        self._会话字典[会话ID]={
            '用户ID':用户ID,
            '数据':数据或{},
            '创建时间':_当前时间戳(),
            '最后活动时间':_当前时间戳()
        }
        return会话ID
    
    def获取会话(会话ID):
        如果会话ID不在self._会话字典:
            return无
        
        会话=self._会话字典[会话ID]
        
        如果_当前时间戳()-会话['最后活动时间']>self._过期时间:
            删除self._会话字典[会话ID]
            return无
        
        会话['最后活动时间']=_当前时间戳()
        return会话
    
    def更新会话(会话ID,数据):
        会话=self.获取会话(会话ID)
        如果会话:
            会话['数据'].更新(数据)
    
    def销毁会话(会话ID):
        如果会话ID在self._会话字典:
            删除self._会话字典[会话ID]
            return真
        return假
    
    def清理过期会话():
        当前时间=_当前时间戳()
        过期列表=[sid对于sid,会话在self._会话字典.项()如果当前时间-会话['最后活动时间']>self._过期时间]
        对于sid在过期列表:
            删除self._会话字典[sid]
    
    def活跃会话数():
        self.清理过期会话()
        return长度(self._会话字典)


class API密钥管理:
    def初始化():
        self._密钥字典={}
    
    def生成密钥(名称,权限列表=无,过期时间=无):
        密钥='sk_'+_生成随机令牌(32)
        
        self._密钥字典[密钥]={
            '名称':名称,
            '权限列表':权限列表或[],
            '创建时间':_当前时间戳(),
            '过期时间':_当前时间戳()+过期时间如果过期时间否则无
        }
        
        return密钥
    
    def验证密钥(密钥):
        如果密钥不在self._密钥字典:
            return无
        
        信息=self._密钥字典[密钥]
        
        如果信息['过期时间']且_当前时间戳()>信息['过期时间']:
            删除self._密钥字典[密钥]
            return无
        
        return信息
    
    def撤销密钥(密钥):
        如果密钥在self._密钥字典:
            删除self._密钥字典[密钥]
            return真
        return假
    
    def检查权限(密钥,权限):
        信息=self.验证密钥(密钥)
        如果不是信息:
            return假
        return权限在信息['权限列表']


def生成JWT(密钥,载荷,过期时间=3600):
    jwt=JWT令牌(密钥,过期时间=过期时间)
    return jwt.生成令牌(载荷)

def验证JWT(密钥,令牌):
    jwt=JWT令牌(密钥)
    return jwt.验证令牌(令牌)

def哈希密码(密码):
    return密码工具.哈希密码(密码)

def验证密码(密码,哈希值,盐值):
    return密码工具.验证密码(密码,哈希值,盐值)