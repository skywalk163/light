class任务:
    def__init__(self,函数,*参数,任务标识=无,优先级=0,最大重试次数=0,重试延迟=1.0,**关键字参数):
        self.任务标识=任务标识或者_生成标识()
        self.函数=函数
        self.参数=参数
        self.关键字参数=关键字参数
        self.优先级=优先级
        self.最大重试次数=最大重试次数
        self.重试延迟=重试延迟
        self.当前重试次数=0
        self.状态="待执行"
        self.结果=无
        self.异常=无
        self.创建时间=_当前时间()
        self.开始时间=无
        self.结束时间=无
        self.调度时间=无
        self._回调=[]

    def执行(self):
        self.状态="执行中"
        self.开始时间=_当前时间()

        尝试:
            self.结果=self.函数(*self.参数,**self.关键字参数)
            self.状态="已完成"
        捕获错误e:
            self.异常=e
            如果self.当前重试次数<self.最大重试次数:
                self.状态="已重试"
                self.当前重试次数+=1
            否则:
                self.状态="失败"
        最后:
            self.结束时间=_当前时间()

        对于回调在self._回调:
            尝试:
                回调(self)
            捕获错误:
                跳过

    def添加回调(self,回调):
        self._回调.追加(回调)

    def耗时(self):
        如果self.开始时间并且self.结束时间:
            返回self.结束时间-self.开始时间
        返回无

    def__lt__(self,其他):
        如果self.调度时间并且其他.调度时间:
            如果self.调度时间!=其他.调度时间:
                返回self.调度时间<其他.调度时间
        返回self.优先级>其他.优先级

class任务队列:
    def__init__(self,工作线程数=4,最大队列大小=10000):
        self.工作线程数=工作线程数
        self.最大队列大小=最大队列大小
        self._队列=[]
        self._锁=_创建互斥锁()
        self._条件变量=_创建条件变量()
        self._工作线程=[]
        self._运行中=假
        self._任务映射={}
        self._已完成任务={}
        self._最大已完成数=1000

    def启动(self):
        如果self._运行中:
            返回

        self._运行中=真
        对于i在范围(self.工作线程数):
            t=_创建线程(self._工作循环)
            self._工作线程.追加(t)

    def_工作循环(self):
        当self._运行中:
            _条件变量获取(self._条件变量)
            尝试:
                当不self._队列:
                    如果不self._运行中:
                        返回
                    _条件变量等待(self._条件变量)

                任务=_堆弹出(self._队列)
            最后:
                _条件变量释放(self._条件变量)

            如果任务.调度时间并且任务.调度时间>_当前时间():
                _睡眠(最小值(任务.调度时间-_当前时间(),0.1))
                _条件变量获取(self._条件变量)
                尝试:
                    _堆推入(self._队列,任务)
                    _条件变量通知(self._条件变量)
                最后:
                    _条件变量释放(self._条件变量)
                继续

            如果任务.状态=="已取消":
                继续

            任务.执行()

            如果任务.状态=="已重试":
                任务.调度时间=_当前时间()+任务.重试延迟
                _条件变量获取(self._条件变量)
                尝试:
                    _堆推入(self._队列,任务)
                最后:
                    _条件变量释放(self._条件变量)
            否则:
                _加锁(self._锁)
                尝试:
                    如果长度(self._已完成任务)>=self._最大已完成数:
                        旧任务标识=下一个(迭代器(self._已完成任务.键()))
                        删除self._已完成任务[旧任务标识]
                    self._已完成任务[任务.任务标识]=任务
                最后:
                    _解锁(self._锁)

    def提交(self,函数,*参数,优先级=0,延迟=0.0,最大重试次数=0,重试延迟=1.0,回调=无,**关键字参数):
        任务对象=任务(函数,*参数,优先级=优先级,最大重试次数=最大重试次数,重试延迟=重试延迟,**关键字参数)

        如果回调:
            任务对象.添加回调(回调)

        如果延迟>0:
            任务对象.调度时间=_当前时间()+延迟

        _条件变量获取(self._条件变量)
        尝试:
            当长度(self._队列)>=self.最大队列大小:
                _条件变量等待(self._条件变量)

            _堆推入(self._队列,任务对象)
            self._任务映射[任务对象.任务标识]=任务对象
            _条件变量通知(self._条件变量)
        最后:
            _条件变量释放(self._条件变量)

        返回任务对象.任务标识

    def获取任务状态(self,任务标识):
        _加锁(self._锁)
        尝试:
            如果任务标识在self._已完成任务:
                返回self._已完成任务[任务标识].状态
            如果任务标识在self._任务映射:
                返回self._任务映射[任务标识].状态
        最后:
            _解锁(self._锁)
        返回无

    def获取任务结果(self,任务标识,等待=假,超时=无):
        开始时间=_当前时间()

        当真:
            _加锁(self._锁)
            尝试:
                如果任务标识在self._已完成任务:
                    任务=self._已完成任务[任务标识]
                    如果任务.状态=="失败":
                        抛出任务.异常
                    返回任务.结果
            最后:
                _解锁(self._锁)

            如果不等待:
                返回无

            如果超时不是无并且_当前时间()-开始时间>超时:
                抛出错误("等待任务结果超时")

            _睡眠(0.01)

    def取消任务(self,任务标识):
        _加锁(self._锁)
        尝试:
            任务对象=self._任务映射.获取(任务标识)
            如果任务对象并且任务对象.状态=="待执行":
                任务对象.状态="已取消"
                返回真
            返回假
        最后:
            _解锁(self._锁)

    def等待完成(self,超时=无):
        开始时间=_当前时间()

        当真:
            _加锁(self._锁)
            尝试:
                如果不self._队列:
                    返回真
            最后:
                _解锁(self._锁)

            如果超时不是无并且_当前时间()-开始时间>超时:
                返回假

            _睡眠(0.01)

    def停止(self,等待=真):
        如果等待:
            self.等待完成()

        self._运行中=假
        _条件变量获取(self._条件变量)
        尝试:
            _条件变量通知所有(self._条件变量)
        最后:
            _条件变量释放(self._条件变量)

        对于t在self._工作线程:
            _等待线程(t,超时=2.0)
        self._工作线程.清空()

    def队列大小(self):
        _加锁(self._锁)
        尝试:
            返回长度(self._队列)
        最后:
            _解锁(self._锁)

    def__enter__(self):
        self.启动()
        返回self

    def__exit__(self,exc_type,exc_val,exc_tb):
        self.停止()
        返回假

class定时调度器:
    def__init__(self):
        self._任务列表=[]
        self._锁=_创建互斥锁()
        self._运行中=假
        self._调度线程=无
        self._任务标识计数=0
        self._任务映射={}

    def添加间隔任务(self,间隔,函数,*参数,立即执行=假,**关键字参数):
        self._任务标识计数+=1
        任务标识="间隔任务_"+字符串(self._任务标识计数)

        下次执行=_当前时间()如果立即执行否则_当前时间()+间隔

        任务信息={
            "标识":任务标识,
            "类型":"间隔",
            "函数":函数,
            "参数":参数,
            "关键字参数":关键字参数,
            "间隔":间隔,
            "下次执行":下次执行,
            "运行中":假,
            "启用":真
        }

        _加锁(self._锁)
        尝试:
            _堆推入(self._任务列表,(下次执行,任务标识))
            self._任务映射[任务标识]=任务信息
        最后:
            _解锁(self._锁)

        返回任务标识

    def添加定时任务(self,执行时间,函数,*参数,**关键字参数):
        self._任务标识计数+=1
        任务标识="定时任务_"+字符串(self._任务标识计数)

        任务信息={
            "标识":任务标识,
            "类型":"单次",
            "函数":函数,
            "参数":参数,
            "关键字参数":关键字参数,
            "下次执行":执行时间,
            "运行中":假,
            "启用":真
        }

        _加锁(self._锁)
        尝试:
            _堆推入(self._任务列表,(执行时间,任务标识))
            self._任务映射[任务标识]=任务信息
        最后:
            _解锁(self._锁)

        返回任务标识

    def取消任务(self,任务标识):
        _加锁(self._锁)
        尝试:
            如果任务标识在self._任务映射:
                self._任务映射[任务标识]["启用"]=假
                返回真
            返回假
        最后:
            _解锁(self._锁)

    def启动(self):
        如果self._运行中:
            返回

        self._运行中=真
        self._调度线程=_创建线程(self._调度循环)

    def_调度循环(self):
        当self._运行中:
            _加锁(self._锁)
            尝试:
                如果不self._任务列表:
                    _睡眠(0.5)
                    继续

                下次执行时间,任务标识=self._任务列表[0]
                现在=_当前时间()

                如果下次执行时间>现在:
                    _睡眠(最小值(下次执行时间-现在,0.5))
                    继续

                _堆弹出(self._任务列表)
                任务信息=self._任务映射.获取(任务标识)

                如果不任务信息或者不任务信息["启用"]:
                    继续

                如果任务信息["运行中"]:
                    继续
            最后:
                _解锁(self._锁)

            def执行任务():
                尝试:
                    任务信息["函数"](*任务信息["参数"],**任务信息["关键字参数"])
                捕获错误:
                    跳过
                最后:
                    任务信息["运行中"]=假

                    如果任务信息["类型"]=="间隔":
                        任务信息["下次执行"]=_当前时间()+任务信息["间隔"]
                        _加锁(self._锁)
                        尝试:
                            _堆推入(self._任务列表,(任务信息["下次执行"],任务信息["标识"]))
                        最后:
                            _解锁(self._锁)
                    否则如果任务信息["类型"]=="单次":
                        _加锁(self._锁)
                        尝试:
                            如果任务信息["标识"]在self._任务映射:
                                删除self._任务映射[任务信息["标识"]]
                        最后:
                            _解锁(self._锁)

            任务信息["运行中"]=真
            _创建线程(执行任务)

    def停止(self):
        self._运行中=假
        如果self._调度线程:
            _等待线程(self._调度线程,超时=2.0)
            self._调度线程=无

    def获取任务列表(self):
        _加锁(self._锁)
        尝试:
            返回[
                {
                    "标识":info["标识"],
                    "类型":info["类型"],
                    "下次执行":info["下次执行"],
                    "启用":info["启用"],
                    "运行中":info["运行中"]
                }
                对于info在self._任务映射.值()
            ]
        最后:
            _解锁(self._锁)

    def__enter__(self):
        self.启动()
        返回self

    def__exit__(self,exc_type,exc_val,exc_tb):
        self.停止()
        返回假

def创建任务队列(工作线程数=4):
    tq=任务队列(工作线程数)
    tq.启动()
    返回tq

def创建调度器():
    返回定时调度器()
