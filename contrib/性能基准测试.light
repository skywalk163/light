class 计时结果:
    def初始化(名称,耗时,调用次数=1):
        self.名称=名称
        self.耗时=耗时
        self.调用次数=调用次数
        self.平均耗时=耗时/调用次数


class 内存测量结果:
    def初始化(名称,峰值内存,当前内存,分配数=0):
        self.名称=名称
        self.峰值内存=峰值内存
        self.当前内存=当前内存
        self.分配数=分配数


class 基准测试结果:
    def初始化(名称,计时结果=无,内存结果=无):
        self.名称=名称
        self.计时结果=计时结果
        self.内存结果=内存结果


def计时(函数,*参数,**关键字参数):
    开始时间=_获取当前时间()
    函数(*参数,**关键字参数)
    结束时间=_获取当前时间()
    耗时=结束时间-开始时间
    return 计时结果(函数.__名称__,耗时)


def多次计时(函数,次数=1000,*参数,**关键字参数):
    开始时间=_获取当前时间()
    对于_在范围(次数):
        函数(*参数,**关键字参数)
    结束时间=_获取当前时间()
    耗时=结束时间-开始时间
    return 计时结果(函数.__名称__,耗时,次数)


def测量内存(函数,*参数,**关键字参数):
    _开始内存追踪()
    函数(*参数,**关键字参数)
    当前内存,峰值内存=_获取追踪内存()
    _停止内存追踪()
    
    return 内存测量结果(函数.__名称__,峰值内存,当前内存)


def测量内存详细(函数,*参数,**关键字参数):
    _开始内存追踪()
    快照1=_拍摄内存快照()
    
    函数(*参数,**关键字参数)
    
    快照2=_拍摄内存快照()
    当前内存,峰值内存=_获取追踪内存()
    _停止内存追踪()
    
    分配数=长度(快照2)-长度(快照1)
    
    return 内存测量结果(函数.__名称__,峰值内存,当前内存,分配数)


def基准测试(函数,次数=1000,测量内存=假,*参数,**关键字参数):
    计时结果=多次计时(函数,次数,*参数,**关键字参数)
    
    内存结果=无
    如果测量内存:
        内存结果=测量内存详细(函数,*参数,**关键字参数)
    
    return 基准测试结果(函数.__名称__,计时结果,内存结果)


class 基准测试套件:
    def初始化(名称=''):
        self.名称=名称
        self._测试列表=[]
        self._结果列表=[]
    
    def添加测试(名称,函数,次数=1000,测量内存=假):
        self._测试列表.追加({
            '名称':名称,
            '函数':函数,
            '次数':次数,
            '测量内存':测量内存
        })
    
    def添加对比测试(名称1,函数1,名称2,函数2,次数=1000):
        self.添加测试(名称1,函数1,次数)
        self.添加测试(名称2,函数2,次数)
    
    def运行():
        self._结果列表=[]
        
        对于测试在self._测试列表:
            函数=测试['函数']
            次数=测试['次数']
            测量内存=测试['测量内存']
            
            开始时间=_获取当前时间()
            对于_在范围(次数):
                函数()
            耗时=_获取当前时间()-开始时间
            
            计时结果=计时结果(测试['名称'],耗时,次数)
            
            内存结果=无
            如果测量内存:
                _开始内存追踪()
                函数()
                当前内存,峰值内存=_获取追踪内存()
                _停止内存追踪()
                内存结果=内存测量结果(测试['名称'],峰值内存,当前内存)
            
            self._结果列表.追加(基准测试结果(测试['名称'],计时结果,内存结果))
        
        return self._结果列表
    
    def打印报告():
        结果=self.运行()
        
        打印('\n'+'='*60)
        打印('基准测试报告 - '+self.名称)
        打印('='*60)
        
        对于结果在结果:
            打印('\n测试: '+结果.名称)
            如果结果.计时结果:
                计时=结果.计时结果
                打印('  总耗时: '+字符串(计时.耗时)+'秒')
                打印('  调用次数: '+字符串(计时.调用次数))
                打印('  平均耗时: '+字符串(计时.平均耗时*1000000)+'微秒')
                打印('  每秒调用: '+字符串(int(1/计时.平均耗时))+'次/秒')
            
            如果结果.内存结果:
                内存=结果.内存结果
                打印('  峰值内存: '+字符串(内存.峰值内存/1024)+' KB')
                打印('  当前内存: '+字符串(内存.当前内存/1024)+' KB')
        
        打印('\n'+'='*60)


class 性能计数器:
    def初始化():
        self._计数器={}
        self._开始时间={}
    
    def开始(名称):
        self._开始时间[名称]=_获取当前时间()
    
    def结束(名称):
        如果名称不在self._开始时间:
            return 0
        
        耗时=_获取当前时间()-self._开始时间[名称]
        
        如果名称不在self._计数器:
            self._计数器[名称]=[]
        self._计数器[名称].追加(耗时)
        
        return 耗时
    
    def获取平均耗时(名称):
        记录=self._计数器.获取(名称,[])
        如果不是记录:
            return 0
        return总和(记录)/长度(记录)
    
    def获取最大耗时(名称):
        记录=self._计数器.获取(名称,[])
        如果不是记录:
            return 0
        return最大(记录)
    
    def获取最小耗时(名称):
        记录=self._计数器.获取(名称,[])
        如果不是记录:
            return 0
        return最小(记录)
    
    def获取调用次数(名称):
        return长度(self._计数器.获取(名称,[]))
    
    def打印统计():
        打印('\n'+'='*60)
        打印('性能计数器统计')
        打印('='*60)
        
        对于名称,记录在self._计数器.项():
            平均=总和(记录)/长度(记录)如果记录否则0
            最大=最大(记录)如果记录否则0
            最小=最小(记录)如果记录否则0
            
            打印('\n'+名称+':')
            打印('  调用次数: '+字符串(长度(记录)))
            打印('  平均耗时: '+字符串(平均*1000000)+'微秒')
            打印('  最大耗时: '+字符串(最大*1000000)+'微秒')
            打印('  最小耗时: '+字符串(最小*1000000)+'微秒')
    
    def重置(名称=无):
        如果名称:
            如果名称在self._计数器:
                删除self._计数器[名称]
            如果名称在self._开始时间:
                删除self._开始时间[名称]
        否则:
            self._计数器={}
            self._开始时间={}


class 内存监控器:
    def初始化():
        self._快照列表=[]
        self._启用=假
    
    def开始监控():
        _开始内存追踪()
        self._启用=真
    
    def停止监控():
        _停止内存追踪()
        self._启用=假
    
    def拍摄快照(标签=''):
        如果不是self._启用:
            返回
        
        当前内存,峰值内存=_获取追踪内存()
        self._快照列表.追加({
            '标签':标签,
            '时间':_获取当前时间(),
            '当前内存':当前内存,
            '峰值内存':峰值内存
        })
    
    def获取快照列表():
        return self._快照列表
    
    def打印快照():
        打印('\n'+'='*60)
        打印('内存监控快照')
        打印('='*60)
        
        对于快照在self._快照列表:
            打印('\n标签: '+快照['标签'])
            打印('  当前内存: '+字符串(快照['当前内存']/1024)+' KB')
            打印('  峰值内存: '+字符串(快照['峰值内存']/1024)+' KB')
    
    def生成对比报告(快照1=0,快照2=-1):
        如果长度(self._快照列表)<2:
            return{}
        
        前快照=self._快照列表[快照1]
        后快照=self._快照列表[快照2]
        
        return{
            '内存增长':(后快照['当前内存']-前快照['当前内存'])/1024,
            '峰值增长':(后快照['峰值内存']-前快照['峰值内存'])/1024,
            '时间差':后快照['时间']-前快照['时间']
        }


def计算复杂度(函数,输入大小列表,*参数):
    结果=[]
    
    对于大小在输入大小列表:
        计时结果=多次计时(函数,100,大小,*参数)
        结果.追加({
            '输入大小':大小,
            '平均耗时':计时结果.平均耗时,
            '总耗时':计时结果.耗时
        })
    
    return 结果


def对比性能(函数列表,次数=1000):
    结果=[]
    
    对于函数在函数列表:
        计时结果=多次计时(函数,次数)
        结果.追加({
            '函数名':函数.__名称__,
            '总耗时':计时结果.耗时,
            '平均耗时':计时结果.平均耗时,
            '每秒调用':1/计时结果.平均耗时
        })
    
    return排序(结果,键=lambda x:x['平均耗时'])


def性能装饰器(次数=1000):
    def包装(函数):
        def内部(*参数,**关键字参数):
            开始时间=_获取当前时间()
            对于_在范围(次数):
                结果=函数(*参数,**关键字参数)
            耗时=_获取当前时间()-开始时间
            
            打印('性能测试 - '+函数.__名称__+':')
            打印('  总耗时: '+字符串(耗时)+'秒')
            打印('  平均耗时: '+字符串((耗时/次数)*1000000)+'微秒')
            打印('  每秒调用: '+字符串(int(次数/耗时))+'次/秒')
            
            return结果
        
        return内部
    
    return包装