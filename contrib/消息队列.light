class消息:
    def__init__(self,内容,消息标识=无,优先级=0,延迟=0.0):
        self.内容=内容
        self.消息标识=消息标识或者_生成标识()
        self.优先级=优先级
        self.延迟=延迟
        self.创建时间=_当前时间()
        self.可执行时间=self.创建时间+延迟
        self.状态="待处理"
        self.重试次数=0
        self.最大重试次数=3

    def__lt__(self,其他):
        如果self.可执行时间!=其他.可执行时间:
            返回self.可执行时间<其他.可执行时间
        返回self.优先级>其他.优先级

class内存消息队列:
    def__init__(self,名称="默认队列",最大容量=10000):
        self.名称=名称
        self.最大容量=最大容量
        self._队列=_创建双端队列()
        self._延迟队列=[]
        self._死信队列=_创建双端队列()
        self._锁=_创建互斥锁()
        self._条件变量=_创建条件变量()
        self._消费者=[]
        self._运行中=真
        self._已发送计数=0
        self._已接收计数=0
        self._已确认计数=0

    def发送(self,内容,优先级=0,延迟=0.0):
        msg=消息(内容,优先级=优先级,延迟=延迟)

        _条件变量获取(self._条件变量)
        尝试:
            当长度(self._队列)>=self.最大容量:
                _条件变量等待(self._条件变量)

            如果延迟>0:
                _堆推入(self._延迟队列,msg)
            否则:
                self._队列.追加(msg)

            self._已发送计数+=1
            _条件变量通知所有(self._条件变量)
        最后:
            _条件变量释放(self._条件变量)

        返回msg.消息标识

    def接收(self,超时=无):
        开始时间=_当前时间()

        _条件变量获取(self._条件变量)
        尝试:
            当真:
                self._检查延迟队列()

                如果self._队列:
                    msg=self._队列.左侧弹出()
                    msg.状态="处理中"
                    self._已接收计数+=1
                    _条件变量通知所有(self._条件变量)
                    返回msg

                如果不self._运行中:
                    返回无

                如果超时不是无:
                    剩余时间=超时-(_当前时间()-开始时间)
                    如果剩余时间<=0:
                        返回无
                    _条件变量等待超时(self._条件变量,剩余时间)
                否则:
                    _条件变量等待(self._条件变量)
        最后:
            _条件变量释放(self._条件变量)

    def_检查延迟队列(self):
        现在=_当前时间()
        当self._延迟队列:
            最早消息=self._延迟队列[0]
            如果最早消息.可执行时间<=现在:
                _堆弹出(self._延迟队列)
                最早消息.可执行时间=最早消息.创建时间
                self._队列.左侧追加(最早消息)
            否则:
                断开

    def确认(self,消息标识,成功=真):
        _加锁(self._锁)
        尝试:
            如果成功:
                self._已确认计数+=1
        最后:
            _解锁(self._锁)

    def失败(self,消息):
        _条件变量获取(self._条件变量)
        尝试:
            消息.重试次数+=1

            如果消息.重试次数>=消息.最大重试次数:
                消息.状态="已死信"
                self._死信队列.追加(消息)
            否则:
                消息.状态="待处理"
                消息.延迟=最小值(2**消息.重试次数*0.1,10.0)
                消息.可执行时间=_当前时间()+消息.延迟
                _堆推入(self._延迟队列,消息)

            _条件变量通知所有(self._条件变量)
        最后:
            _条件变量释放(self._条件变量)

    def大小(self):
        _加锁(self._锁)
        尝试:
            返回长度(self._队列)+长度(self._延迟队列)
        最后:
            _解锁(self._锁)

    def死信队列大小(self):
        _加锁(self._锁)
        尝试:
            返回长度(self._死信队列)
        最后:
            _解锁(self._锁)

    def获取统计(self):
        _加锁(self._锁)
        尝试:
            返回{
                "已发送":self._已发送计数,
                "已接收":self._已接收计数,
                "已确认":self._已确认计数,
                "待处理":长度(self._队列),
                "延迟中":长度(self._延迟队列),
                "死信":长度(self._死信队列)
            }
        最后:
            _解锁(self._锁)

    def清空(self):
        _条件变量获取(self._条件变量)
        尝试:
            self._队列.清空()
            self._延迟队列.清空()
            _条件变量通知所有(self._条件变量)
        最后:
            _条件变量释放(self._条件变量)

    def关闭(self):
        _条件变量获取(self._条件变量)
        尝试:
            self._运行中=假
            _条件变量通知所有(self._条件变量)
        最后:
            _条件变量释放(self._条件变量)

    def__len__(self):
        返回self.大小()

class发布订阅:
    def__init__(self):
        self._主题订阅者={}
        self._锁=_创建互斥锁()

    def订阅(self,主题,回调):
        订阅标识=_生成标识()

        _加锁(self._锁)
        尝试:
            如果主题不在self._主题订阅者:
                self._主题订阅者[主题]={}
            self._主题订阅者[主题][订阅标识]=回调
        最后:
            _解锁(self._锁)

        返回订阅标识

    def取消订阅(self,主题,订阅标识):
        _加锁(self._锁)
        尝试:
            如果主题在self._主题订阅者并且订阅标识在self._主题订阅者[主题]:
                删除self._主题订阅者[主题][订阅标识]
                如果不self._主题订阅者[主题]:
                    删除self._主题订阅者[主题]
                返回真
            返回假
        最后:
            _解锁(self._锁)

    def发布(self,主题,消息):
        _加锁(self._锁)
        尝试:
            订阅者=列表(self._主题订阅者.获取(主题,{}).值())
        最后:
            _解锁(self._锁)

        对于回调在订阅者:
            尝试:
                回调(消息)
            捕获错误:
                跳过

        返回长度(订阅者)

    def获取主题列表(self):
        _加锁(self._锁)
        尝试:
            返回列表(self._主题订阅者.键())
        最后:
            _解锁(self._锁)

    def获取订阅者数量(self,主题):
        _加锁(self._锁)
        尝试:
            返回长度(self._主题订阅者.获取(主题,{}))
        最后:
            _解锁(self._锁)

class工作队列:
    def__init__(self,名称="工作队列",工作线程数=4,最大容量=10000):
        self.名称=名称
        self.工作线程数=工作线程数
        self._队列=内存消息队列(名称,最大容量)
        self._工作线程=[]
        self._运行中=假
        self._处理函数=无
        self._错误处理函数=无

    def启动(self,处理函数,错误处理函数=无):
        如果self._运行中:
            返回

        self._处理函数=处理函数
        self._错误处理函数=错误处理函数
        self._运行中=真

        对于i在范围(self.工作线程数):
            t=_创建线程(self._工作循环)
            self._工作线程.追加(t)

    def_工作循环(self):
        当self._运行中:
            尝试:
                msg=self._队列.接收(超时=0.5)
                如果msg是无:
                    继续

                尝试:
                    结果=self._处理函数(msg.内容)
                    self._队列.确认(msg.消息标识,真)
                捕获错误e:
                    如果self._错误处理函数:
                        尝试:
                            self._错误处理函数(msg.内容,e)
                        捕获错误:
                            跳过
                    self._队列.失败(msg)
            捕获错误:
                断开

    def提交(self,任务,优先级=0,延迟=0.0):
        返回self._队列.发送(任务,优先级,延迟)

    def等待完成(self,超时=无):
        开始时间=_当前时间()

        当self._队列.大小()>0:
            _睡眠(0.01)
            如果超时不是无并且_当前时间()-开始时间>超时:
                返回假

        返回真

    def停止(self):
        self._运行中=假
        对于t在self._工作线程:
            _等待线程(t,超时=2.0)
        self._工作线程.清空()
        self._队列.关闭()

    def获取统计(self):
        返回self._队列.获取统计()

    def__enter__(self):
        返回self

    def__exit__(self,exc_type,exc_val,exc_tb):
        self.停止()
        返回假

def创建消息队列(名称="默认队列",最大容量=10000):
    返回内存消息队列(名称,最大容量)

def创建工作队列(处理函数,工作线程数=4,名称="工作队列"):
    wq=工作队列(名称,工作线程数)
    wq.启动(处理函数)
    返回wq

def创建发布订阅():
    返回发布订阅()
