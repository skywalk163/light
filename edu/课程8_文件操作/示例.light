# 课程8：文件操作 - 示例代码

# === 写入文件 ===
打印 "=== 写入文件 ==="
设 文件 = 打开("我的日记.txt", "w")
文件的 写入 "2026年8月8日 晴\n"
文件的 写入 "今天学习了光明的文件操作，感觉很有趣！\n"
文件的 写入 "我可以用程序保存我的日记了。\n"
文件的 关闭
打印 "日记已保存到文件「我的日记.txt」"

# === 读取文件 ===
打印 ""
打印 "=== 读取文件 ==="
设 文件2 = 打开("我的日记.txt", "r")
设 内容 = 文件2的 读取
打印 "文件内容："
打印 内容
文件2的 关闭

# === 追加内容 ===
打印 ""
打印 "=== 追加内容 ==="
设 文件3 = 打开("我的日记.txt", "a")
文件3的 写入 "晚上和朋友们一起编程很开心！\n"
文件3的 关闭

# 读取验证
设 文件4 = 打开("我的日记.txt", "r")
打印 "追加后的内容："
打印 文件4的 读取
文件4的 关闭

# === 按行读取 ===
打印 ""
打印 "=== 按行读取 ==="
设 文件5 = 打开("我的日记.txt", "r")
遍 文件5 的 行 为 行:
    打印 "行：", 行
文件5的 关闭

# === CSV成绩处理 ===
打印 ""
打印 "=== CSV成绩处理 ==="
# 创建成绩文件
设 成绩文件 = 打开("成绩.csv", "w")
成绩文件的 写入 "姓名,语文,数学,英语\n"
成绩文件的 写入 "小明,88,92,85\n"
成绩文件的 写入 "小红,95,90,93\n"
成绩文件的 写入 "小刚,78,85,80\n"
成绩文件的 关闭

# 读取并计算总分
设 读成绩 = 打开("成绩.csv", "r")
设 标题行 = 读成绩的 读取  # 第一行跳过
打印 "成绩单："
遍 读成绩 的 行 为 行:
    设 数据 = 行的 分割 ","
    设 姓名 = 数据[0]
    设 语文 = 整数(数据[1])
    设 数学 = 整数(数据[2])
    设 英语 = 整数(数据[3])
    设 总分 = 语文 + 数学 + 英语
    打印 姓名, "：语文", 语文, "数学", 数学, "英语", 英语, "总分", 总分
读成绩的 关闭

# === 带异常处理的文件操作 ===
打印 ""
打印 "=== 安全文件操作 ==="
段 安全读取(路径):
    试:
        设 f = 打开(路径, "r")
        设 数据 = f的 读取
        f的 关闭
        返回 数据
    捕 错误:
        返回 "读取失败：" + 串(错误)

打印 安全读取("存在的文件.txt")
打印 安全读取("不存在的文件.txt")