# 课程10：综合项目 - 学生管理系统

# 光明学生管理系统
# 综合运用：列表、字典、函数、循环、条件、文件操作

# === 数据存储 ===
设 学生列表 = []

# === 辅助函数 ===
段 显示菜单():
    打印 ""
    打印 "================================="
    打印 "        学生管理系统"
    打印 "================================="
    打印 "1. 添加学生"
    打印 "2. 查看所有学生"
    打印 "3. 查询学生"
    打印 "4. 修改学生成绩"
    打印 "5. 删除学生"
    打印 "6. 保存到文件"
    打印 "7. 从文件读取"
    打印 "8. 按成绩排名"
    打印 "9. 统计信息"
    打印 "0. 退出"
    打印 "================================="

段 添加学生():
    打印 ""
    打印 "--- 添加学生 ---"
    设 姓名 = 读取("请输入姓名：")
    设 年龄 = 读取("请输入年龄：")
    设 年龄 = 整数(年龄)
    设 语文 = 读取("请输入语文成绩：")
    设 语文 = 整数(语文)
    设 数学 = 读取("请输入数学成绩：")
    设 数学 = 整数(数学)
    设 英语 = 读取("请输入英语成绩：")
    设 英语 = 整数(英语)

    设 学生 = {
        "姓名": 姓名,
        "年龄": 年龄,
        "语文": 语文,
        "数学": 数学,
        "英语": 英语,
        "总分": 语文 + 数学 + 英语
    }
    学生列表的 添加 学生
    打印 "添加成功！"

段 查看所有():
    打印 ""
    打印 "--- 所有学生 ---"
    如果 学生列表的长度 等于 0:
        打印 "暂无学生信息"
        返回

    打印 "姓名\t年龄\t语文\t数学\t英语\t总分"
    遍 学生列表 为 s:
        打印 s["姓名"], "\t", s["年龄"], "\t", s["语文"], "\t", s["数学"], "\t", s["英语"], "\t", s["总分"]

段 查询学生():
    打印 ""
    打印 "--- 查询学生 ---"
    设 关键词 = 读取("请输入要查询的姓名：")
    设 找到 = 假
    遍 学生列表 为 s:
        如果 s["姓名"] 等于 关键词:
            打印 "姓名：", s["姓名"]
            打印 "年龄：", s["年龄"]
            打印 "语文：", s["语文"]
            打印 "数学：", s["数学"]
            打印 "英语：", s["英语"]
            打印 "总分：", s["总分"]
            设 找到 = 真
    如果 找到 等于 假:
        打印 "未找到学生：", 关键词

段 修改成绩():
    打印 ""
    打印 "--- 修改成绩 ---"
    设 关键词 = 读取("请输入要修改的学生姓名：")
    遍 学生列表 为 s:
        如果 s["姓名"] 等于 关键词:
            设 科目 = 读取("请输入科目（语文/数学/英语）：")
            设 新成绩 = 读取("请输入新成绩：")
            设 新成绩 = 整数(新成绩)
            s[科目] = 新成绩
            s["总分"] = s["语文"] + s["数学"] + s["英语"]
            打印 "修改成功！"
            返回
    打印 "未找到学生：", 关键词

段 删除学生():
    打印 ""
    打印 "--- 删除学生 ---"
    设 关键词 = 读取("请输入要删除的学生姓名：")
    设 找到 = 假
    设 索引 = 0
    当 索引 < 学生列表的长度:
        如果 学生列表[索引]["姓名"] 等于 关键词:
            学生列表的 删除 学生列表[索引]
            打印 "删除成功！"
            设 找到 = 真
            设 索引 = 索引 - 1  # 调整索引
        设 索引 = 索引 + 1
    如果 找到 等于 假:
        打印 "未找到学生：", 关键词

段 保存到文件():
    打印 ""
    打印 "--- 保存到文件 ---"
    设 文件名 = 读取("请输入文件名（默认 students.csv）：")
    如果 文件名 等于 "":
        设 文件名 = "students.csv"

    设 文件 = 打开(文件名, "w")
    文件的 写入 "姓名,年龄,语文,数学,英语,总分\n"
    遍 学生列表 为 s:
        文件的 写入 s["姓名"] + "," + 串(s["年龄"]) + "," + 串(s["语文"]) + "," + 串(s["数学"]) + "," + 串(s["英语"]) + "," + 串(s["总分"]) + "\n"
    文件的 关闭
    打印 "已保存", 学生列表的长度, "条记录到", 文件名

段 从文件读取():
    打印 ""
    打印 "--- 从文件读取 ---"
    设 文件名 = 读取("请输入文件名（默认 students.csv）：")
    如果 文件名 等于 "":
        设 文件名 = "students.csv"

    试:
        设 文件 = 打开(文件名, "r")
        设 首行 = 文件 的 读取  # 跳过标题行
        遍 文件 的 行 为 行:
            设 数据 = 行的 分割 ","
            如果 数据的长度 >= 6:
                设 学生 = {
                    "姓名": 数据[0],
                    "年龄": 整数(数据[1]),
                    "语文": 整数(数据[2]),
                    "数学": 整数(数据[3]),
                    "英语": 整数(数据[4]),
                    "总分": 整数(数据[5])
                }
                学生列表的 添加 学生
        文件的 关闭
        打印 "已读取", 学生列表的长度, "条记录"
    捕 错误:
        打印 "读取失败：", 错误

段 按成绩排名():
    打印 ""
    打印 "--- 按总分排名 ---"
    如果 学生列表的长度 小于 2:
        打印 "学生数量不足，无需排名"
        返回

    设 排序列表 = 学生列表的 复制
    排序列表的 排序
    打印 "排名\t姓名\t总分"
    设 排名 = 1
    遍 排序列表 为 s:
        打印 排名, "\t", s["姓名"], "\t", s["总分"]
        设 排名 = 排名 + 1

段 统计信息():
    打印 ""
    打印 "--- 统计信息 ---"
    如果 学生列表的长度 等于 0:
        打印 "暂无学生信息"
        返回

    设 总人数 = 学生列表的长度
    设 语文总分 = 0
    设 数学总分 = 0
    设 英语总分 = 0
    设 最高分 = 0
    设 最高分学生 = ""

    遍 学生列表 为 s:
        设 语文总分 = 语文总分 + s["语文"]
        设 数学总分 = 数学总分 + s["数学"]
        设 英语总分 = 英语总分 + s["英语"]
        如果 s["总分"] > 最高分:
            设 最高分 = s["总分"]
            设 最高分学生 = s["姓名"]

    打印 "总人数：", 总人数
    打印 "语文平均分：", 语文总分 / 总人数
    打印 "数学平均分：", 数学总分 / 总人数
    打印 "英语平均分：", 英语总分 / 总人数
    打印 "最高分：", 最高分学生, "（", 最高分, "分）"

# === 主程序 ===
打印 "欢迎使用光明学生管理系统！"
设 运行中 = 真
当 运行中:
    显示菜单()
    设 选择 = 读取("请选择操作（0-9）：")
    设 选择 = 整数(选择)

    如果 选择 等于 1:
        添加学生()
    如果 选择 等于 2:
        查看所有()
    如果 选择 等于 3:
        查询学生()
    如果 选择 等于 4:
        修改成绩()
    如果 选择 等于 5:
        删除学生()
    如果 选择 等于 6:
        保存到文件()
    如果 选择 等于 7:
        从文件读取()
    如果 选择 等于 8:
        按成绩排名()
    如果 选择 等于 9:
        统计信息()
    如果 选择 等于 0:
        设 运行中 = 假
        打印 "感谢使用学生管理系统，再见！"

# 程序结束