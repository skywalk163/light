# 课程9：小游戏 - 示例代码

# === 猜数字游戏 ===
打印 "================================="
打印 "         欢迎来到猜数字游戏！"
打印 "================================="
打印 "电脑已想好一个1到100之间的数字。"
打印 ""

设 答案 = 随机(1, 100)
设 尝试次数 = 0
设 猜中 = 假

当 猜中 等于 假:
    设 猜测 = 读取("请输入你的猜测（1-100）：")
    设 猜测 = 整数(猜测)
    设 尝试次数 = 尝试次数 + 1

    如果 猜测 等于 答案:
        打印 "恭喜你猜对了！答案就是", 答案
        打印 "你一共猜了", 尝试次数, "次"
        设 猜中 = 真
    如果 猜测 小于 答案:
        打印 "猜小了，再大一点！"
    如果 猜测 大于 答案:
        打印 "猜大了，再小一点！"

打印 ""
打印 "感谢游玩！"

# === 石头剪刀布游戏 ===
打印 ""
打印 "================================="
打印 "         石头剪刀布游戏！"
打印 "================================="
打印 "规则：石头赢剪刀，剪刀赢布，布赢石头"
打印 "输入 1=石头, 2=剪刀, 3=布"
打印 ""

设 选择 = ["石头", "剪刀", "布"]
设 玩家胜 = 0
设 电脑胜 = 0
设 平局 = 0

段 判断胜负(玩家, 电脑):
    如果 玩家 等于 电脑:
        返回 "平局"
    如果 (玩家 等于 1 且 电脑 等于 2) 或 (玩家 等于 2 且 电脑 等于 3) 或 (玩家 等于 3 且 电脑 等于 1):
        返回 "玩家胜"
    返回 "电脑胜"

设 继续玩 = 真
当 继续玩:
    打印 "（当前比分：玩家", 玩家胜, "- 电脑", 电脑胜, "，平局", 平局, "）"
    设 玩家选择 = 读取("你的选择（1=石头, 2=剪刀, 3=布，0=退出）：")
    设 玩家选择 = 整数(玩家选择)

    如果 玩家选择 等于 0:
        设 继续玩 = 假
        打印 "游戏结束！"
        打印 "最终比分：玩家", 玩家胜, "- 电脑", 电脑胜, "，平局", 平局

    如果 玩家选择 大于等于 1 且 玩家选择 小于等于 3:
        设 电脑选择 = 随机(1, 3)
        打印 "你出了：", 选择[玩家选择 - 1]
        打印 "电脑出了：", 选择[电脑选择 - 1]

        设 结果 = 判断胜负(玩家选择, 电脑选择)
        如果 结果 等于 "玩家胜":
            打印 "你赢了！"
            设 玩家胜 = 玩家胜 + 1
        如果 结果 等于 "电脑胜":
            打印 "电脑赢了！"
            设 电脑胜 = 电脑胜 + 1
        如果 结果 等于 "平局":
            打印 "平局！"
            设 平局 = 平局 + 1

    打印 ""