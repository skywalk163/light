# 课程7：字符串 - 示例代码

# === 字符串基本操作 ===
打印 "=== 字符串拼接 ==="
设 名字 = "小明"
设 问候 = "你好，" + 名字 + "！欢迎学习编程！"
打印 问候

打印 ""
打印 "=== 字符串长度 ==="
设 文本 = "床前明月光，疑是地上霜。"
打印 "文本内容：", 文本
打印 "文本长度：", 文本的长度

打印 ""
打印 "=== 字符串截取 ==="
设 诗句 = "举头望明月，低头思故乡。"
打印 "前四个字：", 诗句[0:4]
打印 "后三个字：", 诗句[6:9]
打印 "从第3个到第7个：", 诗句[2:7]

# === 字符串方法 ===
打印 ""
打印 "=== 字符串查找 ==="
设 句子 = "今天天气真好，适合出去玩耍！"
设 位置 = 句子的 查找 "天气"
打印 "在句子中「天气」的位置：", 位置
设 位置2 = 句子的 查找 "下雨"
打印 "「下雨」的位置（不存在时）：", 位置2

打印 ""
打印 "=== 字符串替换 ==="
设 原句 = "我喜欢吃苹果。"
设 新句 = 原句的 替换 "苹果" "香蕉"
打印 "替换前：", 原句
打印 "替换后：", 新句

# === 格式化 ===
打印 ""
打印 "=== 字符串格式化 ==="
设 姓名 = "小红"
设 年龄 = 11
设 年级 = 5
设 介绍 = "我叫" + 姓名 + "，今年" + 串(年龄) + "岁，读" + 串(年级) + "年级。"
打印 介绍

# === 综合示例 ===
打印 ""
打印 "=== 综合：电子名片 ==="
段 生成名片(姓名, 电话, 邮箱):
    设 分割线 = "================================"
    设 名片 = 分割线 + "\n"
    设 名片 = 名片 + "姓名：" + 姓名 + "\n"
    设 名片 = 名片 + "电话：" + 电话 + "\n"
    设 名片 = 名片 + "邮箱：" + 邮箱 + "\n"
    设 名片 = 名片 + 分割线
    返回 名片

设 名片信息 = 生成名片("张三", "13800138000", "zhangsan@example.com")
打印 名片信息