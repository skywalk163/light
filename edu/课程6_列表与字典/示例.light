# 课程6：列表与字典 - 示例代码

# === 列表操作 ===
打印 "=== 列表创建和访问 ==="
设 水果 = ["苹果", "香蕉", "橘子", "葡萄"]
打印 "水果列表：", 水果
打印 "第一种水果：", 水果[0]
打印 "第三种水果：", 水果[2]
打印 "水果数量：", 水果的长度

打印 ""
打印 "=== 添加和删除 ==="
水果的 添加 "西瓜"
打印 "添加西瓜后：", 水果
水果的 删除 "香蕉"
打印 "删除香蕉后：", 水果
设 拿走 = 水果的 弹出
打印 "弹出了：", 拿走
打印 "剩余水果：", 水果

打印 ""
打印 "=== 排序和反转 ==="
设 数字 = [8, 3, 6, 1, 9, 2]
打印 "原始数字：", 数字
数字的 排序
打印 "排序后：", 数字
数字的 反转
打印 "反转后：", 数字

打印 ""
打印 "=== 遍历列表 ==="
遍 水果 为 f:
    打印 "我喜欢吃：", f

# === 字典操作 ===
打印 ""
打印 "=== 字典创建和访问 ==="
设 学生 = {
    "姓名": "小红",
    "年龄": 12,
    "班级": "六年级一班",
    "爱好": ["画画", "跳舞", "编程"]
}
打印 "学生信息：", 学生
打印 "姓名：", 学生["姓名"]
打印 "年龄：", 学生["年龄"]

打印 ""
打印 "=== 修改和添加字段 ==="
学生["年龄"] = 13
学生["电话"] = "13800001234"
打印 "更新后的信息："
遍 学生 的键 为 k:
    打印 "  ", k, "→", 学生[k]

打印 ""
打印 "=== 字典统计 ==="
设 成绩 = {"语文": 88, "数学": 95, "英语": 90, "科学": 87}
打印 "期末成绩单："
遍 成绩 的项 为 项:
    打印 "  科目：", 项[0], "  分数：", 项[1]

设 总分 = 0
遍 成绩 的值 为 分:
    总分 = 总分 + 分
打印 "总分：", 总分
打印 "平均分：", 总分 / 成绩的长度