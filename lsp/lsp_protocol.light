# 光明 LSP 服务器 - 协议层
#
# 实现 Language Server Protocol 的 JSON-RPC over stdio
#
# 协议格式：
#   Content-Length: <字节数>\r\n
#   Content-Type: application/vscode-jsonrpc; charset=utf-8\r\n
#   \r\n
#   {"jsonrpc":"2.0","id":<id>,"method":"<name>","params":{...}}
#
# 响应格式：
#   Content-Length: <字节数>\r\n
#   \r\n
#   {"jsonrpc":"2.0","id":<id>,"result":{...}}
#
# 说明：D07 旧语法清理迁移（2026-08-06）
#   - 定义 X 等于 Y → 设 X 为 Y
#   - "a" 连接 "b" → "a" + "b"
#   - X 以 Y 开始 → 开头(X, Y)
#   - 块结束标记「结束。」→ 纯缩进风格（与 examples/student_management.light 一致）

段落 读取LSP消息():
    设 content_length 为 -1。
    设 继续读取 为 真。
    当 继续读取 为 真:
        设 行 为 读取行()。
        若 行 等于 "":
            继续读取 为 假。
        否则若 开头(行, "Content-Length:"):
            设 值字符串 为 截取(行, 16, 字符串长度(行))。
            content_length 等于 转整数(值字符串)。

    若 content_length 小于 0:
        返回 字典创建()。

    设 body 为 读取N字节(content_length)。
    返回 解析JSON(body)。

段落 发送LSP消息(id, result):
    设 响应字典 为 字典创建()。
    字典设置(响应字典, "jsonrpc", "2.0")。
    字典设置(响应字典, "id", id)。
    字典设置(响应字典, "result", result)。

    设 响应字符串 为 序列化JSON(响应字典)。
    设 长度 为 字符串长度(响应字符串)。

    设 header 为 "Content-Length: " + 转字符串(长度) + "\r\n\r\n"。
    写入输出(header)。
    写入输出(响应字符串)。

段落 发送错误(id, 错误码, 错误消息):
    设 响应字典 为 字典创建()。
    字典设置(响应字典, "jsonrpc", "2.0")。
    字典设置(响应字典, "id", id)。

    设 错误字典 为 字典创建()。
    字典设置(错误字典, "code", 错误码)。
    字典设置(错误字典, "message", 错误消息)。
    字典设置(响应字典, "error", 错误字典)。

    设 响应字符串 为 序列化JSON(响应字典)。
    设 长度 为 字符串长度(响应字符串)。

    设 header 为 "Content-Length: " + 转字符串(长度) + "\r\n\r\n"。
    写入输出(header)。
    写入输出(响应字符串)。

段落 发送通知(方法名, 参数值):
    设 响应字典 为 字典创建()。
    字典设置(响应字典, "jsonrpc", "2.0")。
    字典设置(响应字典, "method", 方法名)。
    字典设置(响应字典, "params", 参数值)。

    设 响应字符串 为 序列化JSON(响应字典)。
    设 长度 为 字符串长度(响应字符串)。

    设 header 为 "Content-Length: " + 转字符串(长度) + "\r\n\r\n"。
    写入输出(header)。
    写入输出(响应字符串)。

# 中文关键字文档字典
段落 获取关键字文档(关键字):
    定义 文档字典 等于 字典创建()。
    字典设置(文档字典, "设", "**用法**: `设 变量名 = 值。`\\n\\n**说明**: 声明变量并赋值。")。
    字典设置(文档字典, "若", "**用法**: `若 条件 则：\\n    代码块\\n否：\\n    代码块`\\n\\n**说明**: 条件判断。")。
    字典设置(文档字典, "否", "**用法**: `否：\\n    代码块`\\n\\n**说明**: else 分支。")。
    字典设置(文档字典, "当", "**用法**: `当 条件：\\n    代码块`\\n\\n**说明**: 条件循环。")。
    字典设置(文档字典, "遍", "**用法**: `遍 变量 之 列表：\\n    代码块`\\n\\n**说明**: 遍历循环。")。
    字典设置(文档字典, "段", "**用法**: `段 函数名(参数)：\\n    代码块`\\n\\n**说明**: 函数定义。")。
    字典设置(文档字典, "返", "**用法**: `返 表达式。`\\n\\n**说明**: 返回语句。")。
    字典设置(文档字典, "跳", "**用法**: `跳。`\\n\\n**说明**: 跳出循环。")。
    字典设置(文档字典, "过", "**用法**: `过。`\\n\\n**说明**: 跳过本次迭代。")。
    字典设置(文档字典, "类", "**用法**: `类 类名：\\n    代码块`\\n\\n**说明**: 类定义。")。
    字典设置(文档字典, "承", "**用法**: `类 子类 承 父类：\\n    代码块`\\n\\n**说明**: 类继承。")。
    字典设置(文档字典, "接", "**用法**: `接 接口名：\\n    代码块`\\n\\n**说明**: 接口定义。")。
    字典设置(文档字典, "配", "**用法**: `配 表达式：\\n    情况 模式：\\n        代码块`\\n\\n**说明**: 模式匹配。")。
    字典设置(文档字典, "试", "**用法**: `试：\\n    代码块\\n捕 异常：\\n    代码块\\n终：\\n    代码块`\\n\\n**说明**: 异常处理。")。
    字典设置(文档字典, "捕", "**用法**: `捕 异常类型：\\n    代码块`\\n\\n**说明**: 捕获异常。")。
    字典设置(文档字典, "抛", "**用法**: `抛 异常对象。`\\n\\n**说明**: 抛出异常。")。
    字典设置(文档字典, "终", "**用法**: `终：\\n    代码块`\\n\\n**说明**: 最终执行块。")。
    字典设置(文档字典, "导", "**用法**: `导 模块名。`\\n\\n**说明**: 导入模块。")。
    字典设置(文档字典, "出", "**用法**: `出 模块名。`\\n\\n**说明**: 导出模块。")。
    字典设置(文档字典, "自", "**用法**: `自.属性` 或 `自.方法()`\\n\\n**说明**: 自引用 (self)。")。
    字典设置(文档字典, "之", "**用法**: `对象之属性`\\n\\n**说明**: 属性提取符。")。
    字典设置(文档字典, "并", "**用法**: `数据 并 处理函数`\\n\\n**说明**: 管道连接符。")。
    字典设置(文档字典, "是", "**用法**: `甲 是 乙`\\n\\n**说明**: 判断相等。")。
    字典设置(文档字典, "且", "**说明**: 逻辑与 (AND)。")。
    字典设置(文档字典, "或", "**说明**: 逻辑或 (OR)。")。
    字典设置(文档字典, "非", "**说明**: 逻辑非 (NOT)。")。
    字典设置(文档字典, "真", "**说明**: 布尔值真 (True)。")。
    字典设置(文档字典, "假", "**说明**: 布尔值假 (False)。")。
    字典设置(文档字典, "空", "**说明**: 空值 (None)。")。
    返回 字典获取(文档字典, 关键字, "").

# 获取中文补全项
段落 获取中文补全(前缀):
    定义 关键词列表 等于 列表创建()。
    列表追加(关键词列表, "设")。
    列表追加(关键词列表, "若")。
    列表追加(关键词列表, "否")。
    列表追加(关键词列表, "当")。
    列表追加(关键词列表, "遍")。
    列表追加(关键词列表, "段")。
    列表追加(关键词列表, "返")。
    列表追加(关键词列表, "类")。
    列表追加(关键词列表, "承")。
    列表追加(关键词列表, "接")。
    列表追加(关键词列表, "配")。
    列表追加(关键词列表, "试")。
    列表追加(关键词列表, "捕")。
    列表追加(关键词列表, "抛")。
    列表追加(关键词列表, "终")。
    列表追加(关键词列表, "导")。
    列表追加(关键词列表, "出")。
    列表追加(关键词列表, "自")。
    列表追加(关键词列表, "之")。
    列表追加(关键词列表, "并")。
    列表追加(关键词列表, "且")。
    列表追加(关键词列表, "或")。
    列表追加(关键词列表, "非")。
    列表追加(关键词列表, "真")。
    列表追加(关键词列表, "假")。
    列表追加(关键词列表, "空")。
    列表追加(关键词列表, "定义")。
    列表追加(关键词列表, "如果")。
    列表追加(关键词列表, "那么")。
    列表追加(关键词列表, "否则")。
    列表追加(关键词列表, "遍历")。
    列表追加(关键词列表, "跳出")。
    列表追加(关键词列表, "跳过")。
    列表追加(关键词列表, "返回")。
    列表追加(关键词列表, "段落")。
    列表追加(关键词列表, "函数")。
    列表追加(关键词列表, "导入")。
    列表追加(关键词列表, "导出")。
    列表追加(关键词列表, "打印")。
    列表追加(关键词列表, "输出")。

    定义 结果 等于 列表创建()。
    定义 索引 等于 0。
    当 索引 < 列表长度(关键词列表):
        定义 关键词 等于 列表获取(关键词列表, 索引)。
        若 前缀 等于 "" 或 关键词 以 前缀 开始:
            定义 项 等于 字典创建()。
            字典设置(项, "label", 关键词)。
            字典设置(项, "kind", 14)。
            定义 文档 等于 获取关键字文档(关键词)。
            若 字符串长度(文档) > 0:
                字典设置(项, "documentation", 文档)。
            列表追加(结果, 项)。
        索引 等于 索引 加 1。
    返回 结果。

# 主循环：测试协议层
段落 主():
    打印错误("光明 LSP 服务器启动")。
    定义 请求计数 等于 0。

    设 测试结果 为 字典创建()。
    字典设置(测试结果, "status", "ready")。
    字典设置(测试结果, "message", "光明LSP协议层就绪，支持中文补全和悬停提示")。
    发送LSP消息(1, 测试结果)。

    打印错误("测试响应已发送，准备接收请求...")。

    当 真:
        设 请求 为 读取LSP消息()。

        若 字典包含键(请求, "method"):
            设 方法 为 字典获取(请求, "method")。
            请求计数 等于 请求计数 加 1。

            打印错误("收到方法: " + 方法)。

            若 方法 等于 "initialize":
                # LSP initialize 响应（含中文补全和悬停能力）
                定义 初始化结果 等于 字典创建()。
                定义 能力 等于 字典创建()。
                字典设置(能力, "textDocumentSync", 1)。
                定义 补全配置 等于 字典创建()。
                字典设置(补全配置, "triggerCharacters", 列表创建())。
                字典设置(能力, "completionProvider", 补全配置)。
                字典设置(能力, "hoverProvider", 真)。
                字典设置(初始化结果, "capabilities", 能力)。
                定义 服务器信息 等于 字典创建()。
                字典设置(服务器信息, "name", "light-lsp")。
                字典设置(服务器信息, "version", "2.0.0")。
                字典设置(初始化结果, "serverInfo", 服务器信息)。
                发送LSP消息(字典获取(请求, "id"), 初始化结果)。
            否则 若 方法 等于 "textDocument/completion":
                # 处理补全请求
                定义 参数 等于 字典获取(请求, "params", 字典创建())。
                定义 文档 等于 字典获取(参数, "textDocument", 字典创建())。
                定义 位置 等于 字典获取(参数, "position", 字典创建())。
                定义 行 等于 字典获取(位置, "line", 0)。
                定义 字符 等于 字典获取(位置, "character", 0)。
                定义 补全结果 等于 获取中文补全("")。
                发送LSP消息(字典获取(请求, "id"), 补全结果)。
            否则 若 方法 等于 "textDocument/hover":
                # 处理悬停请求
                定义 参数 等于 字典获取(请求, "params", 字典创建())。
                定义 文档 等于 字典获取(参数, "textDocument", 字典创建())。
                定义 位置 等于 字典获取(参数, "position", 字典创建())。
                定义 行 等于 字典获取(位置, "line", 0)。
                定义 字符 等于 字典获取(位置, "character", 0)。
                定义 悬停结果 等于 字典创建()。
                字典设置(悬停结果, "contents", "光明 LSP 服务器 - 悬停提示就绪")。
                发送LSP消息(字典获取(请求, "id"), 悬停结果)。
            否则 若 方法 等于 "shutdown":
                发送LSP消息(字典获取(请求, "id"), 空)。
                退出程序(0)。
            否则:
                设 默认结果 为 字典创建()。
                字典设置(默认结果, "received", 方法)。
                字典设置(默认结果, "count", 请求计数)。
                发送LSP消息(字典获取(请求, "id"), 默认结果)。

# 运行主循环
主()。
