# =============================================================================
# Match statement nodes
# =============================================================================
段落 make_match_stmt 接收 subject, cases：
  设 node 为 列表创建()
  列表追加(node, "match_stmt")
  列表追加(node, subject)
  列表追加(node, cases)
  返回 node

段落 make_match_case 接收 pattern, guard, body：
  设 node 为 列表创建()
  列表追加(node, "match_case")
  列表追加(node, pattern)
  列表追加(node, guard)
  列表追加(node, body)
  返回 node

段落 make_match_pattern 接收 kind, value, elements, type_name, binding：
  设 node 为 列表创建()
  列表追加(node, "match_pattern")
  列表追加(node, kind)
  列表追加(node, value)
  列表追加(node, elements)
  列表追加(node, type_name)
  列表追加(node, binding)
  返回 node

# =============================================================================
# With statement (context manager) node
# =============================================================================
段落 make_with_stmt 接收 context_expr, variable, body：
  设 node 为 列表创建()
  列表追加(node, "with_stmt")
  列表追加(node, context_expr)
  列表追加(node, variable)
  列表追加(node, body)
  返回 node

# =============================================================================
# Try / Throw statement nodes
# =============================================================================
段落 make_try_stmt 接收 try_body, catch_clauses, finally_body：
  设 node 为 列表创建()
  列表追加(node, "try_stmt")
  列表追加(node, try_body)
  列表追加(node, catch_clauses)
  列表追加(node, finally_body)
  返回 node

段落 make_throw_stmt 接收 value, from_expr：
  设 node 为 列表创建()
  列表追加(node, "throw_stmt")
  列表追加(node, value)
  列表追加(node, from_expr)
  返回 node

# =============================================================================
# Node access utilities
# =============================================================================
段落 node_type 接收 node：
  返回 列表获取(node, 0)

段落 node_data 接收 node, index：
  返回 列表获取(node, index)


# ===== lexer.duan =====

# 段言（Duan）自举词法分析器
# Bootstrap 词法分析器 — 最大兼容版本
# 使用 v3.2 语法标准：段落 段名 接收 参数：body（缩进控制块结束）
#
# 功能说明：
# - 支持汉字标识符、英文字母标识符、数字和关键字
# - 支持基本符号（+ - * / % ^ ( ) [ ] { } 《 》 , . : ； 、）
# - 支持中英文标点（句号。、逗号，、冒号：、分号；、顿号、）
# - 支持注释（# 行注释）
# - 支持字符串字面量（单引号和双引号）
# - 基于缩进的块结构（INDENT/DEDENT 令牌）
# - 先匹配长关键字的智能关键字识别



段落 创建关键字列表：
  设 列表 为 列表创建()
  列表追加(列表, "定义")
  列表追加(列表, "设")
  列表追加(列表, "为")
  列表追加(列表, "等于")
  列表追加(列表, "返回")
  列表追加(列表, "如果")
  列表追加(列表, "否则")
  列表追加(列表, "那么")
  列表追加(列表, "当")
  列表追加(列表, "遍历")
  列表追加(列表, "中的")
  列表追加(列表, "段落")
  列表追加(列表, "段")
  列表追加(列表, "接收")
  列表追加(列表, "类")
  列表追加(列表, "接口")
  列表追加(列表, "跳出")
  列表追加(列表, "跳过")
  列表追加(列表, "导入")
  列表追加(列表, "导出")
  列表追加(列表, "从")
  列表追加(列表, "真")
  列表追加(列表, "假")
  列表追加(列表, "空")
  列表追加(列表, "打印")
  列表追加(列表, "尝试")
  列表追加(列表, "捕获")
  列表追加(列表, "抛出")
  列表追加(列表, "且")
  列表追加(列表, "与")
  列表追加(列表, "或")
  列表追加(列表, "非")
  列表追加(列表, "加")
  列表追加(列表, "减")
  列表追加(列表, "乘")
  列表追加(列表, "除")
  列表追加(列表, "模")
  列表追加(列表, "幂")
  列表追加(列表, "加上")
  列表追加(列表, "减去")
  列表追加(列表, "乘以")
  列表追加(列表, "除以")
  列表追加(列表, "模以")
  列表追加(列表, "幂以")
  列表追加(列表, "大于等于")
  列表追加(列表, "小于等于")
  列表追加(列表, "不等于")
  列表追加(列表, "大于")
  列表追加(列表, "小于")
  列表追加(列表, "使用")
  列表追加(列表, "标注")
  列表追加(列表, "的")
  列表追加(列表, "常量")
  列表追加(列表, "匹配")
  列表追加(列表, "情况")
  列表追加(列表, "协议")
  列表追加(列表, "最终")
  返回 列表

段落 创建符号映射：
  设 映射 为 字典创建()
  字典设置(映射, "。", "句号")
  字典设置(映射, ",", "逗号")
  字典设置(映射, "，", "逗号")
  字典设置(映射, ":", "冒号")
  字典设置(映射, "：", "冒号")
  字典设置(映射, ";", "分号")
  字典设置(映射, "；", "分号")
  字典设置(映射, "、", "顿号")
  字典设置(映射, "(", "左括号")
  字典设置(映射, "（", "左括号")
  字典设置(映射, ")", "右括号")
  字典设置(映射, "）", "右括号")
  字典设置(映射, "[", "左中括号")
  字典设置(映射, "【", "左中括号")
  字典设置(映射, "]", "右中括号")
  字典设置(映射, "】", "右中括号")
  字典设置(映射, "{", "左花括号")
  字典设置(映射, "}", "右花括号")
  字典设置(映射, "《", "左书名号")
  字典设置(映射, "》", "右书名号")
  字典设置(映射, "+", "加")
  字典设置(映射, "-", "减")
  字典设置(映射, "*", "乘")
  字典设置(映射, "×", "乘")
  字典设置(映射, "/", "除")
  字典设置(映射, "÷", "除")
  字典设置(映射, "%", "模")
  字典设置(映射, "^", "幂")
  字典设置(映射, "=", "赋值")
  字典设置(映射, "!", "非")
  字典设置(映射, "@", "标注")
  字典设置(映射, "->", "箭头")
  字典设置(映射, ">", "大于")
  字典设置(映射, "<", "小于")
  字典设置(映射, "#", "注释")
  字典设置(映射, "\\", "反斜线")
  字典设置(映射, "\n", "换行")
  字典设置(映射, " ", "空白")
  字典设置(映射, "\t", "制表")
  返回 映射

段落 是空白 接收 字符：
  如果 字符 等于 " " 或 字符 等于 "\t" 或 字符 等于 "\r":
    返回 真
  返回 假

段落 是数字 接收 字符：
  设 码 为 字符串获取(字符, 0)
  如果 码 大于等于 "0" 且 码 小于等于 "9":
    返回 真
  返回 假

段落 是字母 接收 字符：
  设 码 为 字符串获取(字符, 0)
  如果 码 大于等于 "a" 且 码 小于等于 "z":
    返回 真
  如果 码 大于等于 "A" 且 码 小于等于 "Z":
    返回 真
  如果 码 等于 "_":
    返回 真
  返回 假

段落 是标识符字符 接收 字符, 符号字典：
  如果 字典包含键(符号字典, 字符):
    返回 假
  如果 是字母(字符):
    返回 真
  如果 是数字(字符):
    返回 真
  如果 字符 等于 "_":
    返回 真
  如果 字符 大于 "\x7F":
    返回 真
  返回 假

段落 匹配关键字 接收 文本, 关键字列表：
  设 最佳关键字 为 空
  设 索引 为 0
  设 列表总长 为 列表长度(关键字列表)
  当 索引 小于 列表总长:
    设 关键字 为 列表获取(关键字列表, 索引)
    设 关键字长度 为 字符串长度(关键字)
    设 文本长度 为 字符串长度(文本)
    如果 关键字长度 大于 0 且 关键字长度 小于等于 文本长度:
      如果 截取(文本, 0, 关键字长度) 等于 关键字:
        如果 最佳关键字 等于 空 或 关键字长度 大于 字符串长度(最佳关键字):
          设 最佳关键字 为 关键字
    索引 加上 1
  返回 最佳关键字

段落 含插值模式 接收 文本：
  # 检测字符串内是否含 {标识符} 模式（不嵌套花括号）
  设 长度 为 字符串长度(文本)
  设 i 为 0
  当 i 小于 长度:
    设 ch 为 字符串获取(文本, i)
    如果 ch 等于 "{":
      # 检查花括号后是否为合法标识符字符
      如果 i 加 1 小于 长度:
        设 后字符 为 字符串获取(文本, i 加 1)
        如果 是字母(后字符) 或 是数字(后字符) 或 后字符 等于 "_":
          # 找匹配的右花括号
          设 j 为 i 加 1
          当 j 小于 长度:
            设 c 为 字符串获取(文本, j)
            如果 c 等于 "}":
              返回 真
            否则 如果 c 等于 "{":
              跳出
            j 加上 1
    i 加上 1
  返回 假

段落 收集标识符文本 接收 源码, 位置, 符号字典：
  设 结果 为 ""
  设 源码长度 为 字符串长度(源码)
  当 位置 小于 源码长度:
    设 字符 为 字符串获取(源码, 位置)
    如果 是标识符字符(字符, 符号字典):
      设 结果 为 结果 加 字符
      位置 加上 1
    否则:
      跳出
  返回 结果

段落 标识符分词 接收 文本, 关键字列表, 行, 列：
  设 结果 为 列表创建()
  设 剩余文本 为 文本
  设 当前列 为 列
  当 字符串长度(剩余文本) 大于 0:
    设 找到关键字 为 匹配关键字(剩余文本, 关键字列表)
    如果 找到关键字 不等于 空:
      设 找到长度 为 字符串长度(找到关键字)
      设 剩余长度 为 字符串长度(剩余文本)
      # 单字关键字边界检查：如果后面跟着汉字，说明是复合词的一部分
      设 需跳过 为 假
      如果 找到长度 等于 1 且 找到长度 小于 剩余长度:
        设 下一个字符 为 字符串获取(剩余文本, 找到长度)
        如果 下一个字符 大于 "\x7F":
          设 需跳过 为 真
      如果 需跳过:
        # 单字关键字后面跟着汉字，整个剩余作为标识符
        列表追加(结果, 创建令牌("标识符", 剩余文本, 行, 当前列))
        设 剩余文本 为 ""
      否则:
        列表追加(结果, 创建令牌("关键字", 找到关键字, 行, 当前列))
        当前列 加上 找到长度
        设 剩余文本 为 截取(剩余文本, 找到长度, 剩余长度)
    否则:
      # 未匹配到关键字，整个剩余作为标识符
      列表追加(结果, 创建令牌("标识符", 剩余文本, 行, 当前列))
      设 剩余文本 为 ""
  返回 结果

段落 跳到行尾 接收 源码, 位置：
  设 源码长度 为 字符串长度(源码)
  当 位置 小于 源码长度:
    设 字符 为 字符串获取(源码, 位置)
    如果 字符 等于 "\n":
      返回 位置
    位置 加上 1
  返回 位置

段落 词法分析 接收 源码：
  设 令牌列表 为 列表创建()
  设 源码长度 为 字符串长度(源码)
  设 关键字列表 为 创建关键字列表()
  设 符号映射 为 创建符号映射()
  设 位置 为 0
  设 行 为 1
  设 列 为 1
  # 缩进栈：栈底为 0（顶层缩进）
  设 缩进栈 为 列表创建()
  列表追加(缩进栈, 0)
  当 位置 小于 源码长度:
    设 字符 为 字符串获取(源码, 位置)
    # ── 空白处理 ──
    如果 字符 等于 " " 或 字符 等于 "\t":
      位置 加上 1
      列 加上 1
      跳过
    # ── 换行处理（含缩进计算）──
    如果 字符 等于 "\n":
      列表追加(令牌列表, 创建令牌("换行", "\n", 行, 列))
      行 加上 1
      设 列 为 1
      位置 加上 1
      # 计算下一行的缩进级别
      设 缩进 为 0
      当 位置 小于 源码长度:
        设 下一个 为 字符串获取(源码, 位置)
        如果 下一个 等于 " ":
          缩进 加上 1
          位置 加上 1
        否则 如果 下一个 等于 "\t":
          缩进 加上 4
          位置 加上 1
        否则:
          跳出
      设 列 为 缩进 加 1
      # 处理缩进变化
      设 栈顶 为 列表获取(缩进栈, 列表长度(缩进栈) 减 1)
      如果 缩进 大于 栈顶:
        列表追加(缩进栈, 缩进)
        列表追加(令牌列表, 创建令牌("缩进", 缩进, 行, 1))
      否则 如果 缩进 小于 栈顶:
        当 列表获取(缩进栈, 列表长度(缩进栈) 减 1) 大于 缩进:
          列表弹出(缩进栈)
          列表追加(令牌列表, 创建令牌("反缩进", 列表获取(缩进栈, 列表长度(缩进栈) 减 1), 行, 1))
      否则:
        # 缩进不变，不做处理
        跳过
      跳过
    # ── 换行检查（\r）──
    如果 字符 等于 "\r":
      位置 加上 1
      跳过
    # ── 行注释处理 ──
    如果 字符 等于 "#":
      设 注释结束 为 跳到行尾(源码, 位置 加 1)
      列表追加(令牌列表, 创建令牌("注释", 截取(源码, 位置, 注释结束), 行, 列))
      设 位置 为 注释结束
      跳过
    # ── 符号处理 ──
    如果 字典包含键(符号映射, 字符):
      设 符号名 为 字典获取(符号映射, 字符)
      列表追加(令牌列表, 创建令牌(符号名, 字符, 行, 列))
      位置 加上 1
      列 加上 1
      跳过
    # ── 字符串处理 ──
    如果 字符 等于 "\"" 或 字符 等于 "'":
      设 字符串结果 为 ""
      设 分隔符 为 字符
      位置 加上 1
      当 位置 小于 源码长度:
        设 字符串字符 为 字符串获取(源码, 位置)
        如果 字符串字符 等于 分隔符:
          位置 加上 1
          跳出
        否则 如果 字符串字符 等于 "\\":
          位置 加上 1
          如果 位置 小于 源码长度:
            设 转义字符 为 字符串获取(源码, 位置)
            如果 转义字符 等于 "n":
              设 字符串结果 为 字符串结果 加 "\n"
            否则 如果 转义字符 等于 "t":
              设 字符串结果 为 字符串结果 加 "\t"
            否则:
              设 字符串结果 为 字符串结果 加 转义字符
            位置 加上 1
        否则:
          设 字符串结果 为 字符串结果 加 字符串字符
          位置 加上 1
      # 检查是否含 {标识符} 模式，若是则转为模板字符串
      如果 含插值模式(字符串结果):
        列表追加(令牌列表, 创建令牌("模板字符串", 字符串结果, 行, 列))
      否则:
        列表追加(令牌列表, 创建令牌("字符串", 字符串结果, 行, 列))
      设 列 为 列 加 字符串长度(字符串结果) 加 2
      跳过
    # ── f-string 模板字符串处理 ──
    如果 字符 等于 "f" 且 位置 加 1 小于 源码长度:
      设 下一个字符 为 字符串获取(源码, 位置 加 1)
      如果 下一个字符 等于 "\"" 或 下一个字符 等于 "'":
        设 模板内容 为 ""
        设 分隔符 为 下一个字符
        位置 加上 2
        当 位置 小于 源码长度:
          设 字符串字符 为 字符串获取(源码, 位置)
          如果 字符串字符 等于 分隔符:
            位置 加上 1
            跳出
          否则 如果 字符串字符 等于 "\\":
            位置 加上 1
            如果 位置 小于 源码长度:
              设 转义字符 为 字符串获取(源码, 位置)
              如果 转义字符 等于 "n":
                设 模板内容 为 模板内容 加 "\n"
              否则 如果 转义字符 等于 "t":
                设 模板内容 为 模板内容 加 "\t"
              否则 如果 转义字符 等于 "{":
                设 模板内容 为 模板内容 加 "{"
              否则 如果 转义字符 等于 "}":
                设 模板内容 为 模板内容 加 "}"
              否则:
                设 模板内容 为 模板内容 加 转义字符
              位置 加上 1
          否则:
            设 模板内容 为 模板内容 加 字符串字符
            位置 加上 1
        列表追加(令牌列表, 创建令牌("模板字符串", 模板内容, 行, 列))
        设 列 为 列 加 字符串长度(模板内容) 加 3
        跳过
    # ── 数字处理 ──
    如果 是数字(字符):
      设 数字字符串 为 ""
      当 位置 小于 源码长度:
        设 数字字符 为 字符串获取(源码, 位置)
        如果 是数字(数字字符):
          设 数字字符串 为 数字字符串 加 数字字符
          位置 加上 1
        否则:
          跳出
      # 检查是否有小数部分
      如果 位置 小于 源码长度 且 字符串获取(源码, 位置) 等于 ".":
        设 数字字符串 为 数字字符串 加 "."
        位置 加上 1
        当 位置 小于 源码长度:
          设 小数数字 为 字符串获取(源码, 位置)
          如果 是数字(小数数字):
            设 数字字符串 为 数字字符串 加 小数数字
            位置 加上 1
          否则:
            跳出
      列表追加(令牌列表, 创建令牌("数字", 数字字符串, 行, 列))
      设 列 为 列 加 字符串长度(数字字符串)
      跳过
    # ── 汉字/标识符/关键字处理 ──
    如果 字符 大于 "\x7F" 或 是字母(字符):
      设 标识符文本 为 收集标识符文本(源码, 位置, 符号映射)
      设 标识符长度 为 字符串长度(标识符文本)
      如果 标识符长度 大于 0:
        设 分词结果 为 标识符分词(标识符文本, 关键字列表, 行, 列)
        设 分词索引 为 0
        当 分词索引 小于 列表长度(分词结果):
          列表追加(令牌列表, 列表获取(分词结果, 分词索引))
          分词索引 加上 1
        位置 加上 标识符长度
        列 加上 标识符长度
      跳过
    # ── 未知字符 ──
    设 错误消息 为 "未知字符"
    列表追加(令牌列表, 创建令牌("错误", 错误消息, 行, 列))
    位置 加上 1
    列 加上 1
  # 文件结束，处理剩余的反缩进
  当 列表长度(缩进栈) 大于 1:
    列表弹出(缩进栈)
    列表追加(令牌列表, 创建令牌("反缩进", 列表获取(缩进栈, 列表长度(缩进栈) 减 1), 行, 列))
  # 添加 EOF 标记
  返回 令牌列表


# ===== parser.duan =====

# parser.duan - Recursive descent parser for bootstrap compiler
# Uses v3.2 语法标准: 段落 段名 接收 参数：body
#
# Takes token list from lexer, produces AST using ast.duan constructors
# All identifiers use English to avoid ANTLR keyword conflicts



# =============================================================================
# Token type constants (match lexer output)
# =============================================================================
段落 tok_kw：
  返回 "关键字"

段落 tok_id：
  返回 "标识符"

段落 tok_num：
  返回 "数字"

段落 tok_str：
  返回 "字符串"

段落 tok_indent：
  返回 "缩进"

段落 tok_dedent：
  返回 "反缩进"

段落 tok_newline：
  返回 "换行"

段落 tok_eof：
  返回 "结束"

段落 tok_comment：
  返回 "注释"

段落 sym_period：
  返回 "句号"

段落 sym_colon：
  返回 "冒号"

段落 sym_comma：
  返回 "逗号"

段落 sym_lparen：
  返回 "左括号"

段落 sym_rparen：
  返回 "右括号"

段落 sym_lbook：
  返回 "左书名号"

段落 sym_rbook：
  返回 "右书名号"

# =============================================================================
# Parser helpers
# =============================================================================
段落 token_type 接收 tok：
  返回 字典获取(tok, "种别")

段落 token_value 接收 tok：
  返回 字典获取(tok, "值")

段落 is_kw 接收 tok, expected：
  如果 字典获取(tok, "种别") 等于 "关键字" 且 字典获取(tok, "值") 等于 expected：
    返回 真
  返回 假

段落 is_sym 接收 tok, expected：
  如果 字典获取(tok, "种别") 等于 expected：
    返回 真
  返回 假

段落 is_eof 接收 tok：
  返回 字典获取(tok, "种别") 等于 "结束"

段落 skip_newlines 接收 tokens, pos：
  设 p 为 pos
  当 p 小于 列表长度(tokens)：
    设 tok 为 列表获取(tokens, p)
    设 ttype 为 字典获取(tok, "种别")
    如果 ttype 等于 "换行" 或 ttype 等于 "注释"：
      p 加上 1
    否则：
      跳出
  返回 p

# =============================================================================
# Expression parsing (with operator precedence)
# =============================================================================
段落 is_binary_op 接收 ttype, tval：
  如果 ttype 等于 "关键字"：
    如果 tval 等于 "加" 或 tval 等于 "减" 或 tval 等于 "乘" 或 tval 等于 "除"：
      返回 真
    如果 tval 等于 "模" 或 tval 等于 "幂"：
      返回 真
    如果 tval 等于 "加上" 或 tval 等于 "减去" 或 tval 等于 "乘以" 或 tval 等于 "除以"：
      返回 真
    如果 tval 等于 "等于" 或 tval 等于 "不等于"：
      返回 真
    如果 tval 等于 "大于" 或 tval 等于 "小于" 或 tval 等于 "大于等于" 或 tval 等于 "小于等于"：
      返回 真
    如果 tval 等于 "且" 或 tval 等于 "与" 或 tval 等于 "或"：
      返回 真
  返回 假

段落 parse_expr 接收 tokens, pos：
  设 result 为 parse_or_expr(tokens, pos)
  返回 result

段落 parse_or_expr 接收 tokens, pos：
  设 left_result 为 parse_and_expr(tokens, pos)
  设 left 为 列表获取(left_result, 0)
  设 p 为 列表获取(left_result, 1)
  当 p 小于 列表长度(tokens)：
    设 tok 为 列表获取(tokens, p)
    设 ttype 为 字典获取(tok, "种别")
    设 tval 为 字典获取(tok, "值")
    如果 ttype 等于 "关键字" 且 (tval 等于 "或")：
      p 加上 1
      设 right_result 为 parse_and_expr(tokens, p)
      设 right 为 列表获取(right_result, 0)
      p 等于 列表获取(right_result, 1)
      设 left 为 make_binary_op(tval, left, right)
    否则：
      跳出
  返回 [left, p]

段落 parse_and_expr 接收 tokens, pos：
  设 left_result 为 parse_compare_expr(tokens, pos)
  设 left 为 列表获取(left_result, 0)
  设 p 为 列表获取(left_result, 1)
  当 p 小于 列表长度(tokens)：
    设 tok 为 列表获取(tokens, p)
    设 ttype 为 字典获取(tok, "种别")
    设 tval 为 字典获取(tok, "值")
    如果 ttype 等于 "关键字" 且 (tval 等于 "且" 或 tval 等于 "与")：
      p 加上 1
      设 right_result 为 parse_compare_expr(tokens, p)
      设 right 为 列表获取(right_result, 0)
      p 等于 列表获取(right_result, 1)
      设 left 为 make_binary_op(tval, left, right)
    否则：
      跳出
  返回 [left, p]

段落 parse_compare_expr 接收 tokens, pos：
  设 left_result 为 parse_add_expr(tokens, pos)
  设 left 为 列表获取(left_result, 0)
  设 p 为 列表获取(left_result, 1)
  如果 p 小于 列表长度(tokens)：
    设 tok 为 列表获取(tokens, p)
    设 ttype 为 字典获取(tok, "种别")
    设 tval 为 字典获取(tok, "值")
    如果 ttype 等于 "关键字"：
      如果 tval 等于 "等于" 或 tval 等于 "不等于" 或 tval 等于 "大于" 或 tval 等于 "小于" 或 tval 等于 "大于等于" 或 tval 等于 "小于等于"：
        p 加上 1
        设 right_result 为 parse_add_expr(tokens, p)
        设 right 为 列表获取(right_result, 0)
        p 等于 列表获取(right_result, 1)
        设 left 为 make_binary_op(tval, left, right)
  返回 [left, p]

段落 parse_add_expr 接收 tokens, pos：
  设 left_result 为 parse_mul_expr(tokens, pos)
  设 left 为 列表获取(left_result, 0)
  设 p 为 列表获取(left_result, 1)
  当 p 小于 列表长度(tokens)：
    设 tok 为 列表获取(tokens, p)
    设 ttype 为 字典获取(tok, "种别")
    设 tval 为 字典获取(tok, "值")
    设 is_add_op 为 假
    设 op_name 为 ""
    # 关键字形式：加、加上、减、减去
    如果 ttype 等于 "关键字"：
      如果 tval 等于 "加" 或 tval 等于 "加上"：
        设 is_add_op 为 真
        设 op_name 为 "加"
      否则 如果 tval 等于 "减" 或 tval 等于 "减去"：
        设 is_add_op 为 真
        设 op_name 为 "减"
    # 符号形式：+、-
    否则 如果 ttype 等于 "加"：
      设 is_add_op 为 真
      设 op_name 为 "加"
    否则 如果 ttype 等于 "减"：
      设 is_add_op 为 真
      设 op_name 为 "减"
    如果 is_add_op：
      p 加上 1
      设 right_result 为 parse_mul_expr(tokens, p)
      设 right 为 列表获取(right_result, 0)
      p 等于 列表获取(right_result, 1)
      设 left 为 make_binary_op(op_name, left, right)
    否则：
      跳出
  返回 [left, p]

段落 parse_mul_expr 接收 tokens, pos：
  设 left_result 为 parse_unary_expr(tokens, pos)
  设 left 为 列表获取(left_result, 0)
  设 p 为 列表获取(left_result, 1)
  当 p 小于 列表长度(tokens)：
    设 tok 为 列表获取(tokens, p)
    设 ttype 为 字典获取(tok, "种别")
    设 tval 为 字典获取(tok, "值")
    设 is_mul_op 为 假
    设 op_name 为 ""
    # 关键字形式：乘、乘以、除、除以、模、幂
    如果 ttype 等于 "关键字"：
      如果 tval 等于 "乘" 或 tval 等于 "乘以"：
        设 is_mul_op 为 真
        设 op_name 为 "乘"
      否则 如果 tval 等于 "除" 或 tval 等于 "除以"：
        设 is_mul_op 为 真
        设 op_name 为 "除"
      否则 如果 tval 等于 "模"：
        设 is_mul_op 为 真
        设 op_name 为 "模"
      否则 如果 tval 等于 "幂"：
        设 is_mul_op 为 真
        设 op_name 为 "幂"
    # 符号形式：*、/、%、^
    否则 如果 ttype 等于 "乘"：
      设 is_mul_op 为 真
      设 op_name 为 "乘"
    否则 如果 ttype 等于 "除"：
      设 is_mul_op 为 真
      设 op_name 为 "除"
    否则 如果 ttype 等于 "模"：
      设 is_mul_op 为 真
      设 op_name 为 "模"
    否则 如果 ttype 等于 "幂"：
      设 is_mul_op 为 真
      设 op_name 为 "幂"
    如果 is_mul_op：
      p 加上 1
      设 right_result 为 parse_unary_expr(tokens, p)
      设 right 为 列表获取(right_result, 0)
      p 等于 列表获取(right_result, 1)
      设 left 为 make_binary_op(op_name, left, right)
    否则：
      跳出
  返回 [left, p]

段落 parse_unary_expr 接收 tokens, pos：
  设 tok 为 列表获取(tokens, pos)
  设 ttype 为 字典获取(tok, "种别")
  设 tval 为 字典获取(tok, "值")
  # Unary operators: 非, 减 (negative)
  如果 ttype 等于 "关键字" 且 (tval 等于 "非" 或 tval 等于 "不是")：
    设 operand_result 为 parse_unary_expr(tokens, pos 加 1)
    设 operand 为 列表获取(operand_result, 0)
    设 node 为 make_unary_op(tval, operand)
    返回 [node, 列表获取(operand_result, 1)]
  # Primary expression
  设 result 为 parse_primary(tokens, pos)
  返回 result

段落 parse_primary 接收 tokens, pos：
  设 tok 为 列表获取(tokens, pos)
  设 ttype 为 字典获取(tok, "种别")
  设 tval 为 字典获取(tok, "值")
  # Number literal
  如果 ttype 等于 "数字"：
    设 node 为 make_number(tval)
    返回 [node, pos 加 1]
  # String literal
  如果 ttype 等于 "字符串"：
    设 node 为 make_string(tval)
    返回 [node, pos 加 1]
  # Template string (f-string)
  如果 ttype 等于 "模板字符串"：
    设 node 为 make_template_string(tval)
    返回 [node, pos 加 1]
  # Keyword literals (真, 假, 空)
  如果 ttype 等于 "关键字" 且 (tval 等于 "真" 或 tval 等于 "假")：
    设 node 为 make_boolean(tval)
    返回 [node, pos 加 1]
  如果 ttype 等于 "关键字" 且 tval 等于 "空"：
    设 node 为 make_null()
    返回 [node, pos 加 1]
  # Identifier
  如果 ttype 等于 "标识符"：
    设 p 为 pos 加 1
    如果 p 小于 列表长度(tokens)：
      设 next_t 为 列表获取(tokens, p)
      如果 字典获取(next_t, "种别") 等于 "左括号"：
        设 name 为 tval
        设 args 为 列表创建()
        p 加上 1
        如果 p 小于 列表长度(tokens)：
          设 rp_tok 为 列表获取(tokens, p)
          如果 字典获取(rp_tok, "种别") 不等于 "右括号"：
            当 真：
              设 arg_result 为 parse_expr(tokens, p)
              设 arg 为 列表获取(arg_result, 0)
              设 p 为 列表获取(arg_result, 1)
              列表追加(args, arg)
              如果 p 小于 列表长度(tokens)：
                设 sep 为 列表获取(tokens, p)
                如果 字典获取(sep, "种别") 等于 "逗号"：
                  p 加上 1
                  跳过
              跳出
        如果 p 小于 列表长度(tokens)：
          设 rp 为 列表获取(tokens, p)
          如果 字典获取(rp, "种别") 等于 "右括号"：
            p 加上 1
        设 node 为 make_func_call(name, args)
        返回 [node, p]
    设 node 为 make_identifier(tval)
    返回 [node, pos 加 1]
  # Function call: 《name》(args)
  如果 ttype 等于 "左书名号"：
    设 name_tok 为 列表获取(tokens, pos 加 1)
    设 name 为 字典获取(name_tok, "值")
    设 rbook 为 列表获取(tokens, pos 加 2)
    设 lparen 为 列表获取(tokens, pos 加 3)
    设 args 为 列表创建()
    设 p 为 pos 加 4
    设 rp_tok 为 列表获取(tokens, p)
    如果 字典获取(rp_tok, "种别") 不等于 "右括号"：
      当 真：
        设 arg_result 为 parse_expr(tokens, p)
        设 arg 为 列表获取(arg_result, 0)
        设 p 为 列表获取(arg_result, 1)
        列表追加(args, arg)
        设 sep 为 列表获取(tokens, p)
        如果 字典获取(sep, "种别") 等于 "逗号"：
          p 加上 1
          跳过
        跳出
    设 rp 为 列表获取(tokens, p)
    如果 字典获取(rp, "种别") 等于 "右括号"：
      p 加上 1
    设 node 为 make_func_call(name, args)
    返回 [node, p]
  # List or Dict literal: [...] or ["a": 1, ...]
  # 先 peek 看是否为字典（首元素后紧跟冒号）
  如果 ttype 等于 "左中括号"：
    设 首元素后位置 为 pos 加 1
    设 是不是字典 为 假
    如果 首元素后位置 小于 列表长度(tokens)：
      设 peek_t 为 列表获取(tokens, 首元素后位置)
      如果 字典获取(peek_t, "种别") 不等于 "右中括号"：
        # 跳过首元素
        设 first_result 为 parse_expr(tokens, 首元素后位置)
        设 after_first 为 列表获取(first_result, 1)
        如果 after_first 小于 列表长度(tokens)：
          设 next_after 为 列表获取(tokens, after_first)
          如果 字典获取(next_after, "种别") 等于 "冒号"：
            设 是不是字典 为 真
    如果 是不是字典：
      # 字典字面量：["k1": v1, "k2": v2, ...]
      设 pairs 为 列表创建()
      设 p 为 pos 加 1
      当 p 小于 列表长度(tokens)：
        设 next_t 为 列表获取(tokens, p)
        如果 字典获取(next_t, "种别") 等于 "右中括号"：
          p 加上 1
          跳出
        设 key_result 为 parse_expr(tokens, p)
        设 key_node 为 列表获取(key_result, 0)
        设 p 为 列表获取(key_result, 1)
        # 跳过冒号
        如果 p 小于 列表长度(tokens)：
          设 colon_t 为 列表获取(tokens, p)
          如果 字典获取(colon_t, "种别") 等于 "冒号"：
            p 加上 1
        设 val_result 为 parse_expr(tokens, p)
        设 val_node 为 列表获取(val_result, 0)
        设 p 为 列表获取(val_result, 1)
        设 pair 为 列表创建()
        列表追加(pair, key_node)
        列表追加(pair, val_node)
        列表追加(pairs, pair)
        如果 p 小于 列表长度(tokens)：
          设 sep 为 列表获取(tokens, p)
          如果 字典获取(sep, "种别") 等于 "逗号"：
            p 加上 1
          否则：
            如果 字典获取(sep, "种别") 等于 "右中括号"：
              p 加上 1
            跳出
      设 node 为 make_dict_literal(pairs)
      返回 [node, p]
    # 否则是列表字面量
    设 elems 为 列表创建()
    设 p 为 pos 加 1
    当 p 小于 列表长度(tokens)：
      设 next_t 为 列表获取(tokens, p)
      如果 字典获取(next_t, "种别") 等于 "右中括号"：
        p 加上 1
        跳出
      设 elem_result 为 parse_expr(tokens, p)
      列表追加(elems, 列表获取(elem_result, 0))
      设 p 为 列表获取(elem_result, 1)
      如果 p 小于 列表长度(tokens)：
        设 sep 为 列表获取(tokens, p)
        如果 字典获取(sep, "种别") 等于 "逗号"：
          p 加上 1
        否则：
          如果 字典获取(sep, "种别") 等于 "右中括号"：
            p 加上 1
          跳出
    设 node 为 make_list_literal(elems)
    返回 [node, p]
  # Dict literal: {key1: val1, key2: val2, ...}
  如果 ttype 等于 "左花括号"：
    设 pairs 为 列表创建()
    设 p 为 pos 加 1
    当 p 小于 列表长度(tokens)：
      设 next_t 为 列表获取(tokens, p)
      如果 字典获取(next_t, "种别") 等于 "右花括号"：
        p 加上 1
        跳出
      设 key_result 为 parse_expr(tokens, p)
      设 key_node 为 列表获取(key_result, 0)
      设 p 为 列表获取(key_result, 1)
      # Skip colon
      如果 p 小于 列表长度(tokens)：
        设 colon_t 为 列表获取(tokens, p)
        如果 字典获取(colon_t, "种别") 等于 "冒号"：
          p 加上 1
      设 val_result 为 parse_expr(tokens, p)
      设 val_node 为 列表获取(val_result, 0)
      设 p 为 列表获取(val_result, 1)
      设 pair 为 列表创建()
      列表追加(pair, key_node)
      列表追加(pair, val_node)
      列表追加(pairs, pair)
      如果 p 小于 列表长度(tokens)：
        设 sep 为 列表获取(tokens, p)
        如果 字典获取(sep, "种别") 等于 "逗号"：
          p 加上 1
        否则：
          如果 字典获取(sep, "种别") 等于 "右花括号"：
            p 加上 1
          跳出
    设 node 为 make_dict_literal(pairs)
    返回 [node, p]
  # Parenthesized expression: (expr)
  如果 ttype 等于 "左括号"：
    设 p 为 pos 加 1
    设 expr_result 为 parse_expr(tokens, p)
    设 expr 为 列表获取(expr_result, 0)
    设 p 为 列表获取(expr_result, 1)
    如果 p 小于 列表长度(tokens)：
      设 rp 为 列表获取(tokens, p)
      如果 字典获取(rp, "种别") 等于 "右括号"：
        p 加上 1
    返回 [expr, p]
  # Default: return identifier (fallback)
  设 node 为 make_identifier(tval)
  返回 [node, pos 加 1]

# =============================================================================
# Statement parsing
# =============================================================================
段落 parse_return_stmt 接收 tokens, pos：
  设 tok 为 列表获取(tokens, pos)  # 返回
  设 p 为 pos 加 1
  # Skip newlines
  设 p 为 skip_newlines(tokens, p)
  # Check if there's a value expression
  如果 p 小于 列表长度(tokens)：
    设 next_tok 为 列表获取(tokens, p)
    设 ttype 为 字典获取(next_tok, "种别")
    如果 ttype 等于 "句号"：
      设 node 为 make_return(空)
      返回 [node, p 加 1]
    如果 ttype 等于 "反缩进" 或 ttype 等于 "结束"：
      设 node 为 make_return(空)
      返回 [node, p]
    设 result 为 parse_expr(tokens, p)
    设 node 为 make_return(列表获取(result, 0))
    p 等于 列表获取(result, 1)
    返回 [node, p]
  设 node 为 make_return(空)
  返回 [node, p]

段落 parse_var_decl 接收 tokens, pos：
  设 tok 为 列表获取(tokens, pos)  # 定义
  设 p 为 pos 加 1
  设 name_tok 为 列表获取(tokens, p)
  设 var_name 为 字典获取(name_tok, "值")
  p 加上 1
  # Skip "等于" or "为" keyword
  如果 p 小于 列表长度(tokens)：
    设 eq_tok 为 列表获取(tokens, p)
    如果 字典获取(eq_tok, "种别") 等于 "关键字"：
      如果 字典获取(eq_tok, "值") 等于 "等于" 或 字典获取(eq_tok, "值") 等于 "为"：
        p 加上 1
  设 result 为 parse_expr(tokens, p)
  设 node 为 make_var_decl(var_name, 列表获取(result, 0))
  返回 [node, 列表获取(result, 1)]

段落 parse_assign 接收 tokens, pos：
  设 tok 为 列表获取(tokens, pos)  # 设
  设 p 为 pos 加 1
  设 name_tok 为 列表获取(tokens, p)
  设 var_name 为 字典获取(name_tok, "值")
  p 加上 1
  # Skip "为" keyword
  如果 p 小于 列表长度(tokens)：
    设 as_tok 为 列表获取(tokens, p)
    如果 字典获取(as_tok, "种别") 等于 "关键字" 且 字典获取(as_tok, "值") 等于 "为"：
      p 加上 1
  设 result 为 parse_expr(tokens, p)
  设 node 为 make_assign(var_name, 列表获取(result, 0))
  返回 [node, 列表获取(result, 1)]

段落 parse_compound_assign 接收 tokens, pos, op：
  设 tok 为 列表获取(tokens, pos)  # identifier
  设 var_name 为 字典获取(tok, "值")
  设 p 为 pos 加 1
  设 result 为 parse_expr(tokens, p 加 1)  # skip operator
  设 node 为 make_compound_assign(var_name, op, 列表获取(result, 0))
  返回 [node, 列表获取(result, 1)]

段落 parse_block 接收 tokens, pos：
  # Parse a block after indent, return after dedent
  设 body 为 列表创建()
  设 p 为 pos
  当 p 小于 列表长度(tokens)：
    设 stmt_tok 为 列表获取(tokens, p)
    设 stype 为 字典获取(stmt_tok, "种别")
    如果 stype 等于 "反缩进" 或 stype 等于 "结束"：
      跳出
    设 stmt_result 为 parse_stmt(tokens, p)
    列表追加(body, 列表获取(stmt_result, 0))
    p 等于 列表获取(stmt_result, 1)
    设 p 为 skip_newlines(tokens, p)
  返回 [body, p]

段落 parse_while 接收 tokens, pos：
  设 tok 为 列表获取(tokens, pos)  # 当
  设 p 为 pos 加 1
  设 cond_result 为 parse_expr(tokens, p)
  设 cond 为 列表获取(cond_result, 0)
  p 等于 列表获取(cond_result, 1)
  # Skip colon
  如果 p 小于 列表长度(tokens)：
    设 col_tok 为 列表获取(tokens, p)
    如果 字典获取(col_tok, "种别") 等于 "冒号"：
      p 加上 1
  # Parse body block
  设 p 为 skip_newlines(tokens, p)
  如果 p 小于 列表长度(tokens)：
    设 indent_tok 为 列表获取(tokens, p)
    如果 字典获取(indent_tok, "种别") 等于 "缩进"：
      p 加上 1
      设 block_result 为 parse_block(tokens, p)
      设 body 为 列表获取(block_result, 0)
      p 等于 列表获取(block_result, 1)
      # Skip one dedent
      如果 p 小于 列表长度(tokens)：
        设 dedent_tok 为 列表获取(tokens, p)
        如果 字典获取(dedent_tok, "种别") 等于 "反缩进"：
          p 加上 1
      设 node 为 make_while_loop(cond, body)
      返回 [node, p]
  设 node 为 make_while_loop(cond, 列表创建())
  返回 [node, p]

段落 parse_if 接收 tokens, pos：
  设 tok 为 列表获取(tokens, pos)  # 如果
  设 p 为 pos 加 1
  设 cond_result 为 parse_expr(tokens, p)
  设 cond 为 列表获取(cond_result, 0)
  p 等于 列表获取(cond_result, 1)
  # Skip colon
  如果 p 小于 列表长度(tokens)：
    设 col_tok 为 列表获取(tokens, p)
    如果 字典获取(col_tok, "种别") 等于 "冒号"：
      p 加上 1
  # Parse if body
  设 p 为 skip_newlines(tokens, p)
  设 body 为 列表创建()
  如果 p 小于 列表长度(tokens)：
    设 indent_tok 为 列表获取(tokens, p)
    如果 字典获取(indent_tok, "种别") 等于 "缩进"：
      p 加上 1
      设 block_result 为 parse_block(tokens, p)
      设 body 为 列表获取(block_result, 0)
      p 等于 列表获取(block_result, 1)
      # Skip one dedent
      如果 p 小于 列表长度(tokens)：
        设 dedent_tok 为 列表获取(tokens, p)
        如果 字典获取(dedent_tok, "种别") 等于 "反缩进"：
          p 加上 1
  # Parse elif branches (否则若 / 否则 如果)
  设 elif_branches 为 列表创建()
  当 p 小于 列表长度(tokens)：
    设 p 为 skip_newlines(tokens, p)
    如果 p 大于等于 列表长度(tokens)：
      跳出
    设 elif_tok 为 列表获取(tokens, p)
    设 is_elif 为 假
    设 elif_p 为 p
    # 检查 "否则若" 形式
    如果 字典获取(elif_tok, "种别") 等于 "关键字" 且 字典获取(elif_tok, "值") 等于 "否则若"：
      设 is_elif 为 真
      设 elif_p 为 p 加 1
    # 检查 "否则 如果" 形式
    否则 如果 字典获取(elif_tok, "种别") 等于 "关键字" 且 字典获取(elif_tok, "值") 等于 "否则"：
      如果 p 加 1 小于 列表长度(tokens)：
        设 next_tok 为 列表获取(tokens, p 加 1)
        如果 字典获取(next_tok, "种别") 等于 "关键字" 且 字典获取(next_tok, "值") 等于 "如果"：
          设 is_elif 为 真
          设 elif_p 为 p 加 2
    如果 is_elif:
      设 p 为 elif_p
      设 elif_cond 为 parse_expr(tokens, p)
      设 elif_cond_node 为 列表获取(elif_cond, 0)
      p 等于 列表获取(elif_cond, 1)
      # Skip colon
      如果 p 小于 列表长度(tokens)：
        设 col 为 列表获取(tokens, p)
        如果 字典获取(col, "种别") 等于 "冒号"：
          p 加上 1
      # Parse elif body
      设 p 为 skip_newlines(tokens, p)
      设 elif_body 为 列表创建()
      如果 p 小于 列表长度(tokens)：
        设 indent 为 列表获取(tokens, p)
        如果 字典获取(indent, "种别") 等于 "缩进"：
          p 加上 1
          设 br 为 parse_block(tokens, p)
          设 elif_body 为 列表获取(br, 0)
          p 等于 列表获取(br, 1)
          # Skip one dedent
          如果 p 小于 列表长度(tokens)：
            设 de 为 列表获取(tokens, p)
            如果 字典获取(de, "种别") 等于 "反缩进"：
              p 加上 1
      设 branch_pair 为 列表创建()
      列表追加(branch_pair, elif_cond_node)
      列表追加(branch_pair, elif_body)
      列表追加(elif_branches, branch_pair)
      跳过
    跳出
  # Parse else body
  设 else_body 为 空
  设 p 为 skip_newlines(tokens, p)
  如果 p 小于 列表长度(tokens)：
    设 else_tok 为 列表获取(tokens, p)
    如果 字典获取(else_tok, "种别") 等于 "关键字" 且 字典获取(else_tok, "值") 等于 "否则"：
      p 加上 1
      # Skip colon
      如果 p 小于 列表长度(tokens)：
        设 col 为 列表获取(tokens, p)
        如果 字典获取(col, "种别") 等于 "冒号"：
          p 加上 1
      设 p 为 skip_newlines(tokens, p)
      设 eb 为 列表创建()
      如果 p 小于 列表长度(tokens)：
        设 indent 为 列表获取(tokens, p)
        如果 字典获取(indent, "种别") 等于 "缩进"：
          p 加上 1
          设 br 为 parse_block(tokens, p)
          设 eb 为 列表获取(br, 0)
          p 等于 列表获取(br, 1)
          # Skip one dedent
          如果 p 小于 列表长度(tokens)：
            设 de 为 列表获取(tokens, p)
            如果 字典获取(de, "种别") 等于 "反缩进"：
              p 加上 1
      设 else_body 为 eb
  设 node 为 make_if_stmt(cond, body, elif_branches, else_body)
  返回 [node, p]

段落 parse_paragraph_def 接收 tokens, pos：
  设 kw 为 列表获取(tokens, pos)  # 段 or 段落
  设 p 为 pos 加 1
  # Get function name
  设 name_tok 为 列表获取(tokens, p)
  设 name 为 字典获取(name_tok, "值")
  p 加上 1
  # Check for parameters
  设 params 为 列表创建()
  如果 p 小于 列表长度(tokens)：
    设 next_tok 为 列表获取(tokens, p)
    如果 字典获取(next_tok, "种别") 等于 "关键字" 且 字典获取(next_tok, "值") 等于 "接收"：
      p 加上 1
      # Parse parameter list
      当 p 小于 列表长度(tokens)：
        设 pt 为 列表获取(tokens, p)
        设 pt_type 为 字典获取(pt, "种别")
        如果 pt_type 等于 "冒号"：
          跳出
        如果 pt_type 等于 "标识符"：
          设 param_name 为 字典获取(pt, "值")
          p 加上 1
          # Check for default value: = expr
          设 default_val 为 空
          如果 p 小于 列表长度(tokens)：
            设 eq_tok 为 列表获取(tokens, p)
            设 eq_type 为 字典获取(eq_tok, "种别")
            设 eq_val 为 字典获取(eq_tok, "值")
            设 has_default 为 假
            如果 eq_type 等于 "赋值" 且 eq_val 等于 "="：
              设 has_default 为 真
            否则 如果 eq_type 等于 "关键字" 且 eq_val 等于 "等于"：
              设 has_default 为 真
            如果 has_default：
              p 加上 1
              设 default_result 为 parse_expr(tokens, p)
              设 default_val 为 列表获取(default_result, 0)
              设 p 为 列表获取(default_result, 1)
          设 param_pair 为 列表创建()
          列表追加(param_pair, param_name)
          列表追加(param_pair, default_val)
          列表追加(params, param_pair)
        否则：
          跳出
        # Check for comma separator
        如果 p 小于 列表长度(tokens)：
          设 sep 为 列表获取(tokens, p)
          如果 字典获取(sep, "种别") 等于 "逗号"：
            p 加上 1
          否则：
            跳出
  # Skip colon
  如果 p 小于 列表长度(tokens)：
    设 col_tok 为 列表获取(tokens, p)
    如果 字典获取(col_tok, "种别") 等于 "冒号"：
      p 加上 1
  # Parse body block
  设 p 为 skip_newlines(tokens, p)
  设 body 为 列表创建()
  如果 p 小于 列表长度(tokens)：
    设 indent_tok 为 列表获取(tokens, p)
    如果 字典获取(indent_tok, "种别") 等于 "缩进"：
      p 加上 1
      设 block_result 为 parse_block(tokens, p)
      设 body 为 列表获取(block_result, 0)
      p 等于 列表获取(block_result, 1)
      # Skip one dedent
      如果 p 小于 列表长度(tokens)：
        设 dedent_tok 为 列表获取(tokens, p)
        如果 字典获取(dedent_tok, "种别") 等于 "反缩进"：
          p 加上 1
  设 node 为 make_paragraph_def(name, params, body)
  返回 [node, p]

# =============================================================================
# Interface definition parsing
# =============================================================================
段落 parse_interface_body 接收 tokens, pos：
  设 methods 为 列表创建()
  设 p 为 pos
  当 p 小于 列表长度(tokens)：
    设 tok 为 列表获取(tokens, p)
    设 ttype 为 字典获取(tok, "种别")
    设 tval 为 字典获取(tok, "值")
    # 遇到 DEDENT 或 EOF 结束
    如果 ttype 等于 "反缩进" 或 ttype 等于 "结束"：
      跳出
    # 跳过空行
    如果 ttype 等于 "换行"：
      p 加上 1
      跳过
    # 方法签名：段落 方法名 接收 参数 返回 类型。
    如果 ttype 等于 "关键字" 且 (tval 等于 "段落" 或 tval 等于 "函数")：
      p 加上 1
      # 方法名
      设 name_tok 为 列表获取(tokens, p)
      设 method_name 为 字典获取(name_tok, "值")
      p 加上 1
      # 参数
      设 params 为 列表创建()
      如果 p 小于 列表长度(tokens)：
        设 next_tok 为 列表获取(tokens, p)
        如果 字典获取(next_tok, "种别") 等于 "关键字" 且 字典获取(next_tok, "值") 等于 "接收"：
          p 加上 1
          当 p 小于 列表长度(tokens)：
            设 pt 为 列表获取(tokens, p)
            设 pt_type 为 字典获取(pt, "种别")
            如果 pt_type 等于 "标识符"：
              设 param_name 为 字典获取(pt, "值")
              p 加上 1
              # 可选类型注解
              设 param_type 为 空
              如果 p 小于 列表长度(tokens)：
                设 col_tok 为 列表获取(tokens, p)
                如果 字典获取(col_tok, "种别") 等于 "冒号"：
                  p 加上 1
                  设 type_tok 为 列表获取(tokens, p)
                  如果 字典获取(type_tok, "种别") 等于 "标识符"：
                    设 param_type 为 字典获取(type_tok, "值")
                    p 加上 1
              设 param_pair 为 列表创建()
              列表追加(param_pair, param_name)
              列表追加(param_pair, param_type)
              列表追加(params, param_pair)
              如果 p 小于 列表长度(tokens)：
                设 sep 为 列表获取(tokens, p)
                如果 字典获取(sep, "种别") 等于 "逗号"：
                  p 加上 1
                否则：
                  跳出
            否则：
              跳出
      # 返回类型（可选）
      设 return_type 为 空
      如果 p 小于 列表长度(tokens)：
        设 next_tok 为 列表获取(tokens, p)
        如果 字典获取(next_tok, "种别") 等于 "关键字" 且 字典获取(next_tok, "值") 等于 "返回"：
          p 加上 1
          设 ret_tok 为 列表获取(tokens, p)
          如果 字典获取(ret_tok, "种别") 等于 "标识符"：
            设 return_type 为 字典获取(ret_tok, "值")
            p 加上 1
      # 跳过句号
      如果 p 小于 列表长度(tokens)：
        设 per_tok 为 列表获取(tokens, p)
        如果 字典获取(per_tok, "种别") 等于 "句号"：
          p 加上 1
      设 sig 为 make_method_signature(method_name, params, return_type)
      列表追加(methods, sig)
      跳过
    # 其他未知 token，跳过
    p 加上 1
  返回 [methods, p]

段落 parse_interface_def 接收 tokens, pos：
  设 kw 为 列表获取(tokens, pos)  # 接口 or 协议
  设 p 为 pos 加 1
  # 接口名
  设 name_tok 为 列表获取(tokens, p)
  设 name 为 字典获取(name_tok, "值")
  p 加上 1
  # 基接口（可选）
  设 super_interfaces 为 列表创建()
  如果 p 小于 列表长度(tokens)：
    设 next_tok 为 列表获取(tokens, p)
    如果 字典获取(next_tok, "种别") 等于 "关键字" 且 字典获取(next_tok, "值") 等于 "继承"：
      p 加上 1
      当 真：
        如果 p 小于 列表长度(tokens)：
          设 si_tok 为 列表获取(tokens, p)
          设 si_type 为 字典获取(si_tok, "种别")
          如果 si_type 等于 "标识符"：
            列表追加(super_interfaces, 字典获取(si_tok, "值"))
            p 加上 1
          否则：
            跳出
          如果 p 小于 列表长度(tokens)：
            设 sep 为 列表获取(tokens, p)
            如果 字典获取(sep, "种别") 等于 "逗号"：
              p 加上 1
            否则：
              跳出
        否则：
          跳出
  # 跳过冒号
  如果 p 小于 列表长度(tokens)：
    设 col_tok 为 列表获取(tokens, p)
    如果 字典获取(col_tok, "种别") 等于 "冒号"：
      p 加上 1
  # 解析接口体
  设 p 为 skip_newlines(tokens, p)
  设 methods 为 列表创建()
  如果 p 小于 列表长度(tokens)：
    设 indent_tok 为 列表获取(tokens, p)
    如果 字典获取(indent_tok, "种别") 等于 "缩进"：
      p 加上 1
      设 body_result 为 parse_interface_body(tokens, p)
      设 methods 为 列表获取(body_result, 0)
      p 等于 列表获取(body_result, 1)
      # 跳过反缩进
      如果 p 小于 列表长度(tokens)：
        设 dedent_tok 为 列表获取(tokens, p)
        如果 字典获取(dedent_tok, "种别") 等于 "反缩进"：
          p 加上 1
  设 node 为 make_interface_def(name, methods, super_interfaces)
  返回 [node, p]

# =============================================================================
# Match statement parsing
# =============================================================================
段落 parse_match_pattern 接收 tokens, pos：
  设 tok 为 列表获取(tokens, pos)
  设 ttype 为 字典获取(tok, "种别")
  设 tval 为 字典获取(tok, "值")
  # 通配符：_
  如果 ttype 等于 "标识符" 且 tval 等于 "_"：
    返回 [make_match_pattern("wildcard", 空, 列表创建(), "", ""), pos 加 1]
  # 数字模式
  如果 ttype 等于 "数字"：
    返回 [make_match_pattern("number", tval, 列表创建(), "", ""), pos 加 1]
  # 字符串模式
  如果 ttype 等于 "字符串"：
    返回 [make_match_pattern("string", tval, 列表创建(), "", ""), pos 加 1]
  # 关键字字面量
  如果 ttype 等于 "关键字"：
    如果 tval 等于 "真" 或 tval 等于 "假"：
      返回 [make_match_pattern("bool", tval, 列表创建(), "", ""), pos 加 1]
    如果 tval 等于 "空"：
      返回 [make_match_pattern("null", 空, 列表创建(), "", ""), pos 加 1]
    # 关键字作为变量绑定
    返回 [make_match_pattern("variable", 空, 列表创建(), "", tval), pos 加 1]
  # 标识符作为变量绑定或类型检查
  如果 ttype 等于 "标识符"：
    设 name 为 tval
    设 p 为 pos 加 1
    如果 p 小于 列表长度(tokens)：
      设 next_tok 为 列表获取(tokens, p)
      设 nttype 为 字典获取(next_tok, "种别")
      设 ntval 为 字典获取(next_tok, "值")
      # 类型检查：类型 变量名
      如果 nttype 等于 "标识符" 且 ntval 不等于 "_"：
        返回 [make_match_pattern("type_check", 空, 列表创建(), name, ntval), p 加 1]
    返回 [make_match_pattern("variable", 空, 列表创建(), "", name), pos 加 1]
  # 默认通配符
  返回 [make_match_pattern("wildcard", 空, 列表创建(), "", ""), pos 加 1]

段落 parse_match_case 接收 tokens, pos：
  设 p 为 pos  # 当前 token 是 "情况"
  设 tok 为 列表获取(tokens, p)
  # 消耗 "情况"
  如果 字典获取(tok, "种别") 等于 "关键字" 且 字典获取(tok, "值") 等于 "情况"：
    p 加上 1
  # 解析模式
  设 pattern_result 为 parse_match_pattern(tokens, p)
  设 pattern 为 列表获取(pattern_result, 0)
  p 等于 列表获取(pattern_result, 1)
  # 守卫条件（可选）：若 expr
  设 guard 为 空
  如果 p 小于 列表长度(tokens)：
    设 guard_tok 为 列表获取(tokens, p)
    如果 字典获取(guard_tok, "种别") 等于 "关键字" 且 (字典获取(guard_tok, "值") 等于 "若" 或 字典获取(guard_tok, "值") 等于 "如果")：
      p 加上 1
      设 guard_result 为 parse_expr(tokens, p)
      设 guard 为 列表获取(guard_result, 0)
      p 等于 列表获取(guard_result, 1)
  # 跳过冒号
  如果 p 小于 列表长度(tokens)：
    设 col_tok 为 列表获取(tokens, p)
    如果 字典获取(col_tok, "种别") 等于 "冒号"：
      p 加上 1
  # 解析分支体
  设 p 为 skip_newlines(tokens, p)
  设 body 为 列表创建()
  如果 p 小于 列表长度(tokens)：
    设 indent_tok 为 列表获取(tokens, p)
    如果 字典获取(indent_tok, "种别") 等于 "缩进"：
      p 加上 1
      当 p 小于 列表长度(tokens)：
        设 stmt_tok 为 列表获取(tokens, p)
        设 stype 为 字典获取(stmt_tok, "种别")
        如果 stype 等于 "反缩进" 或 stype 等于 "结束"：
          跳出
        # 遇到下一个"情况"时停止
        如果 stype 等于 "关键字" 且 字典获取(stmt_tok, "值") 等于 "情况"：
          跳出
        设 stmt_result 为 parse_stmt(tokens, p)
        如果 列表获取(stmt_result, 0) 不等于 空：
          列表追加(body, 列表获取(stmt_result, 0))
        p 等于 列表获取(stmt_result, 1)
        设 p 为 skip_newlines(tokens, p)
      # 跳过反缩进
      如果 p 小于 列表长度(tokens)：
        设 dedent_tok 为 列表获取(tokens, p)
        如果 字典获取(dedent_tok, "种别") 等于 "反缩进"：
          p 加上 1
  设 node 为 make_match_case(pattern, guard, body)
  返回 [node, p]

段落 parse_match_stmt 接收 tokens, pos：
  设 tok 为 列表获取(tokens, pos)  # 匹配
  设 p 为 pos 加 1
  # 解析匹配的值
  设 subject_result 为 parse_expr(tokens, p)
  设 subject 为 列表获取(subject_result, 0)
  p 等于 列表获取(subject_result, 1)
  # 跳过冒号
  如果 p 小于 列表长度(tokens)：
    设 col_tok 为 列表获取(tokens, p)
    如果 字典获取(col_tok, "种别") 等于 "冒号"：
      p 加上 1
  # 解析各个情况分支
  设 p 为 skip_newlines(tokens, p)
  设 cases 为 列表创建()
  如果 p 小于 列表长度(tokens)：
    设 indent_tok 为 列表获取(tokens, p)
    如果 字典获取(indent_tok, "种别") 等于 "缩进"：
      p 加上 1
      当 p 小于 列表长度(tokens)：
        设 case_tok 为 列表获取(tokens, p)
        设 ctype 为 字典获取(case_tok, "种别")
        如果 ctype 等于 "反缩进" 或 ctype 等于 "结束"：
          跳出
        如果 ctype 等于 "关键字" 且 字典获取(case_tok, "值") 等于 "情况"：
          设 case_result 为 parse_match_case(tokens, p)
          如果 列表获取(case_result, 0) 不等于 空：
            列表追加(cases, 列表获取(case_result, 0))
          p 等于 列表获取(case_result, 1)
          设 p 为 skip_newlines(tokens, p)
          跳过
        # 跳过空行
        如果 ctype 等于 "换行"：
          p 加上 1
          跳过
        # 其他情况停止
        跳出
      # 跳过反缩进
      如果 p 小于 列表长度(tokens)：
        设 dedent_tok 为 列表获取(tokens, p)
        如果 字典获取(dedent_tok, "种别") 等于 "反缩进"：
          p 加上 1
  设 node 为 make_match_stmt(subject, cases)
  返回 [node, p]

# =============================================================================
# With statement parsing
# =============================================================================
段落 parse_with_stmt 接收 tokens, pos：
  设 tok 为 列表获取(tokens, pos)  # 使用
  设 p 为 pos 加 1
  # 解析上下文表达式
  设 expr_result 为 parse_expr(tokens, p)
  设 context_expr 为 列表获取(expr_result, 0)
  p 等于 列表获取(expr_result, 1)
  # 解析 "为 变量"（可选）
  设 variable 为 空
  如果 p 小于 列表长度(tokens)：
    设 as_tok 为 列表获取(tokens, p)
    如果 字典获取(as_tok, "种别") 等于 "关键字" 且 字典获取(as_tok, "值") 等于 "为"：
      p 加上 1
      如果 p 小于 列表长度(tokens)：
        设 var_tok 为 列表获取(tokens, p)
        设 var_type 为 字典获取(var_tok, "种别")
        如果 var_type 等于 "标识符" 或 var_type 等于 "关键字"：
          设 variable 为 字典获取(var_tok, "值")
          p 加上 1
  # 跳过冒号
  如果 p 小于 列表长度(tokens)：
    设 col_tok 为 列表获取(tokens, p)
    如果 字典获取(col_tok, "种别") 等于 "冒号"：
      p 加上 1
  # 解析体
  设 p 为 skip_newlines(tokens, p)
  设 body 为 列表创建()
  如果 p 小于 列表长度(tokens)：
    设 indent_tok 为 列表获取(tokens, p)
    如果 字典获取(indent_tok, "种别") 等于 "缩进"：
      p 加上 1
      设 block_result 为 parse_block(tokens, p)
      设 body 为 列表获取(block_result, 0)
      p 等于 列表获取(block_result, 1)
      # 跳过反缩进
      如果 p 小于 列表长度(tokens)：
        设 dedent_tok 为 列表获取(tokens, p)
        如果 字典获取(dedent_tok, "种别") 等于 "反缩进"：
          p 加上 1
  设 node 为 make_with_stmt(context_expr, variable, body)
  返回 [node, p]

# =============================================================================
# Try / Throw statement parsing
# =============================================================================
段落 parse_try_stmt 接收 tokens, pos：
  设 tok 为 列表获取(tokens, pos)  # 尝试
  设 p 为 pos 加 1
  # 跳过冒号
  如果 p 小于 列表长度(tokens)：
    设 col_tok 为 列表获取(tokens, p)
    如果 字典获取(col_tok, "种别") 等于 "冒号"：
      p 加上 1
  # 解析 try 体
  设 p 为 skip_newlines(tokens, p)
  设 try_body 为 列表创建()
  如果 p 小于 列表长度(tokens)：
    设 indent_tok 为 列表获取(tokens, p)
    如果 字典获取(indent_tok, "种别") 等于 "缩进"：
      p 加上 1
      设 block_result 为 parse_block(tokens, p)
      设 try_body 为 列表获取(block_result, 0)
      p 等于 列表获取(block_result, 1)
      # 跳过反缩进
      如果 p 小于 列表长度(tokens)：
        设 dedent_tok 为 列表获取(tokens, p)
        如果 字典获取(dedent_tok, "种别") 等于 "反缩进"：
          p 加上 1
  # 解析捕获子句
  设 catch_clauses 为 列表创建()
  当 p 小于 列表长度(tokens)：
    设 p 为 skip_newlines(tokens, p)
    如果 p 大于等于 列表长度(tokens)：
      跳出
    设 catch_tok 为 列表获取(tokens, p)
    如果 字典获取(catch_tok, "种别") 等于 "关键字" 且 字典获取(catch_tok, "值") 等于 "捕获"：
      p 加上 1
      # 解析捕获类型和变量
      设 catch_type 为 空
      设 catch_var 为 空
      如果 p 小于 列表长度(tokens)：
        设 type_tok 为 列表获取(tokens, p)
        设 tt 为 字典获取(type_tok, "种别")
        如果 tt 等于 "标识符" 或 tt 等于 "关键字"：
          设 first_val 为 字典获取(type_tok, "值")
          p 加上 1
          # 检查下一个 token 是否也是标识符（类型 + 变量名）
          如果 p 小于 列表长度(tokens)：
            设 next_tok 为 列表获取(tokens, p)
            设 nt 为 字典获取(next_tok, "种别")
            设 nv 为 字典获取(next_tok, "值")
            如果 nt 等于 "标识符" 或 (nt 等于 "关键字" 且 nv 不等于 "冒号" 且 nv 不等于 "：" 且 nv 不等于 "："):
              设 catch_type 为 first_val
              设 catch_var 为 nv
              p 加上 1
            否则：
              设 catch_var 为 first_val
          否则：
            设 catch_var 为 first_val
      # 跳过冒号
      如果 p 小于 列表长度(tokens)：
        设 col_tok 为 列表获取(tokens, p)
        如果 字典获取(col_tok, "种别") 等于 "冒号"：
          p 加上 1
      # 解析捕获体
      设 p 为 skip_newlines(tokens, p)
      设 catch_body 为 列表创建()
      如果 p 小于 列表长度(tokens)：
        设 indent_tok 为 列表获取(tokens, p)
        如果 字典获取(indent_tok, "种别") 等于 "缩进"：
          p 加上 1
          设 block_result 为 parse_block(tokens, p)
          设 catch_body 为 列表获取(block_result, 0)
          p 等于 列表获取(block_result, 1)
          # 跳过反缩进
          如果 p 小于 列表长度(tokens)：
            设 dedent_tok 为 列表获取(tokens, p)
            如果 字典获取(dedent_tok, "种别") 等于 "反缩进"：
              p 加上 1
      设 clause 为 列表创建()
      列表追加(clause, catch_type)
      列表追加(clause, catch_var)
      列表追加(clause, catch_body)
      列表追加(catch_clauses, clause)
      跳过
    否则：
      跳出
  # 解析最终子句（可选）
  设 finally_body 为 空
  设 p 为 skip_newlines(tokens, p)
  如果 p 小于 列表长度(tokens)：
    设 finally_tok 为 列表获取(tokens, p)
    如果 字典获取(finally_tok, "种别") 等于 "关键字" 且 字典获取(finally_tok, "值") 等于 "最终"：
      p 加上 1
      # 跳过冒号
      如果 p 小于 列表长度(tokens)：
        设 col_tok 为 列表获取(tokens, p)
        如果 字典获取(col_tok, "种别") 等于 "冒号"：
          p 加上 1
      # 解析最终体
      设 p 为 skip_newlines(tokens, p)
      设 fb 为 列表创建()
      如果 p 小于 列表长度(tokens)：
        设 indent_tok 为 列表获取(tokens, p)
        如果 字典获取(indent_tok, "种别") 等于 "缩进"：
          p 加上 1
          设 block_result 为 parse_block(tokens, p)
          设 fb 为 列表获取(block_result, 0)
          p 等于 列表获取(block_result, 1)
          # 跳过反缩进
          如果 p 小于 列表长度(tokens)：
            设 dedent_tok 为 列表获取(tokens, p)
            如果 字典获取(dedent_tok, "种别") 等于 "反缩进"：
              p 加上 1
      设 finally_body 为 fb
  设 node 为 make_try_stmt(try_body, catch_clauses, finally_body)
  返回 [node, p]

段落 parse_throw_stmt 接收 tokens, pos：
  设 tok 为 列表获取(tokens, pos)  # 抛出
  设 p 为 pos 加 1
  # 跳过空行
  设 p 为 skip_newlines(tokens, p)
  # 检查是否有值
  如果 p 小于 列表长度(tokens)：
    设 next_tok 为 列表获取(tokens, p)
    设 ttype 为 字典获取(next_tok, "种别")
    如果 ttype 等于 "句号" 或 ttype 等于 "反缩进" 或 ttype 等于 "结束"：
      设 node 为 make_throw_stmt(空, 空)
      返回 [node, p 加 1]
    设 result 为 parse_expr(tokens, p)
    设 value 为 列表获取(result, 0)
    p 等于 列表获取(result, 1)
    # 检查 "from" 子句
    设 from_expr 为 空
    如果 p 小于 列表长度(tokens)：
      设 from_tok 为 列表获取(tokens, p)
      如果 字典获取(from_tok, "种别") 等于 "关键字" 且 字典获取(from_tok, "值") 等于 "从"：
        p 加上 1
        设 from_result 为 parse_expr(tokens, p)
        设 from_expr 为 列表获取(from_result, 0)
        p 等于 列表获取(from_result, 1)
    设 node 为 make_throw_stmt(value, from_expr)
    返回 [node, p]
  设 node 为 make_throw_stmt(空, 空)
  返回 [node, p]

# =============================================================================
# Statement dispatcher
# =============================================================================
段落 parse_stmt 接收 tokens, pos：
  # Boundary check
  如果 pos 大于等于 列表长度(tokens)：
    返回 [空, pos]
  设 tok 为 列表获取(tokens, pos)
  设 ttype 为 字典获取(tok, "种别")
  设 tval 为 字典获取(tok, "值")
  # Skip EOF
  如果 ttype 等于 "结束"：
    返回 [空, pos 加 1]
  # Skip period if at start
  如果 ttype 等于 "句号"：
    返回 parse_stmt(tokens, pos 加 1)
  # Paragraph definition: 段 name ... or 段落 name ...
  如果 ttype 等于 "关键字" 且 tval 等于 "段落"：
    设 result 为 parse_paragraph_def(tokens, pos)
    返回 result
  # Variable declaration: 定义 name 等于 expr。
  如果 ttype 等于 "关键字" 且 tval 等于 "定义"：
    设 result 为 parse_var_decl(tokens, pos)
    返回 result
  # Assignment: 设 name 为 expr。
  如果 ttype 等于 "关键字" 且 tval 等于 "设"：
    设 result 为 parse_assign(tokens, pos)
    返回 result
  # Return: 返回 expr。
  如果 ttype 等于 "关键字" 且 tval 等于 "返回"：
    设 result 为 parse_return_stmt(tokens, pos)
    返回 result
  # If: 如果 cond： body 结束。
  如果 ttype 等于 "关键字" 且 tval 等于 "如果"：
    设 result 为 parse_if(tokens, pos)
    返回 result
  # Interface/Protocol: 接口 Name：... 或 协议 Name：...
  如果 ttype 等于 "关键字" 且 (tval 等于 "接口" 或 tval 等于 "协议")：
    设 result 为 parse_interface_def(tokens, pos)
    返回 result
  # Match: 匹配 expr：情况 pattern：body...
  如果 ttype 等于 "关键字" 且 tval 等于 "匹配"：
    设 result 为 parse_match_stmt(tokens, pos)
    返回 result
  # With: 使用 expr 为 var：body...
  如果 ttype 等于 "关键字" 且 tval 等于 "使用"：
    设 result 为 parse_with_stmt(tokens, pos)
    返回 result
  # Try: 尝试：body... 捕获 type：body... 最终：body...
  如果 ttype 等于 "关键字" 且 tval 等于 "尝试"：
    设 result 为 parse_try_stmt(tokens, pos)
    返回 result
  # Throw: 抛出 expr 从 expr。
  如果 ttype 等于 "关键字" 且 tval 等于 "抛出"：
    设 result 为 parse_throw_stmt(tokens, pos)
    返回 result
  # While: 当 cond： body 结束。
  如果 ttype 等于 "关键字" 且 tval 等于 "当"：
    设 result 为 parse_while(tokens, pos)
    返回 result
  # Print: 打印 expr。 或 打印(arg1, arg2, ...)。
  如果 ttype 等于 "关键字" 且 (tval 等于 "打印" 或 tval 等于 "输出")：
    设 p 为 pos 加 1
    如果 p 小于 列表长度(tokens)：
      设 next_tok 为 列表获取(tokens, p)
      如果 字典获取(next_tok, "种别") 等于 "左括号"：
        设 name 为 tval
        设 args 为 列表创建()
        p 加上 1
        如果 p 小于 列表长度(tokens)：
          设 rp_tok 为 列表获取(tokens, p)
          如果 字典获取(rp_tok, "种别") 不等于 "右括号"：
            当 真：
              设 arg_result 为 parse_expr(tokens, p)
              设 arg 为 列表获取(arg_result, 0)
              设 p 为 列表获取(arg_result, 1)
              列表追加(args, arg)
              如果 p 小于 列表长度(tokens)：
                设 sep 为 列表获取(tokens, p)
                如果 字典获取(sep, "种别") 等于 "逗号"：
                  p 加上 1
                  跳过
              跳出
        如果 p 小于 列表长度(tokens)：
          设 rp 为 列表获取(tokens, p)
          如果 字典获取(rp, "种别") 等于 "右括号"：
            p 加上 1
        设 node 为 make_func_call(name, args)
        返回 [node, p]
    设 val_result 为 parse_expr(tokens, p)
    设 val 为 列表获取(val_result, 0)
    设 p 为 列表获取(val_result, 1)
    设 node 为 make_print(val)
    返回 [node, p]
  # Break / Continue
  如果 ttype 等于 "关键字" 且 tval 等于 "跳出"：
    设 node 为 make_break()
    返回 [node, pos 加 1]
  如果 ttype 等于 "关键字" 且 tval 等于 "跳过"：
    设 node 为 make_continue()
    返回 [node, pos 加 1]
  # Compound assignment: identifier 加上 expr。
  如果 ttype 等于 "标识符"：
    如果 pos 加 1 小于 列表长度(tokens)：
      设 next_tok 为 列表获取(tokens, pos 加 1)
      设 nttype 为 字典获取(next_tok, "种别")
      设 ntval 为 字典获取(next_tok, "值")
      如果 nttype 等于 "关键字"：
        如果 ntval 等于 "加上" 或 ntval 等于 "减去" 或 ntval 等于 "乘以" 或 ntval 等于 "除以" 或 ntval 等于 "模以" 或 ntval 等于 "幂以"：
          返回 parse_compound_assign(tokens, pos, ntval)
        # 隐式变量声明: identifier 等于 expr。
        如果 ntval 等于 "等于"：
          设 var_name 为 tval
          设 p 为 pos 加 2
          设 result 为 parse_expr(tokens, p)
          设 node 为 make_var_decl(var_name, 列表获取(result, 0))
          返回 [node, 列表获取(result, 1)]
    # 无括号函数调用: identifier expr1 expr2 ... 。
    如果 pos 加 1 小于 列表长度(tokens)：
      设 next_tok 为 列表获取(tokens, pos 加 1)
      设 nttype 为 字典获取(next_tok, "种别")
      # 如果下一个 token 是表达式起始 token（字符串/数字/标识符/左中括号/左书名号/模板字符串）
      如果 nttype 等于 "字符串" 或 nttype 等于 "数字" 或 nttype 等于 "标识符" 或 nttype 等于 "左中括号" 或 nttype 等于 "左书名号" 或 nttype 等于 "模板字符串"：
        设 name 为 tval
        设 args 为 列表创建()
        设 p 为 pos 加 1
        当 真：
          设 arg_result 为 parse_expr(tokens, p)
          设 arg 为 列表获取(arg_result, 0)
          设 p 为 列表获取(arg_result, 1)
          列表追加(args, arg)
          # 检查是否还有更多参数（必须也是表达式起始 token）
          如果 p 小于 列表长度(tokens)：
            设 peek_tok 为 列表获取(tokens, p)
            设 pt 为 字典获取(peek_tok, "种别")
            如果 pt 等于 "字符串" 或 pt 等于 "数字" 或 pt 等于 "标识符" 或 pt 等于 "左中括号" 或 pt 等于 "左书名号" 或 pt 等于 "模板字符串"：
              跳过
          跳出
        设 node 为 make_func_call(name, args)
        返回 [node, p]
  # Expression statement (function call, etc.)
  设 result 为 parse_expr(tokens, pos)
  设 node 为 make_expr_stmt(列表获取(result, 0))
  返回 [node, 列表获取(result, 1)]

# =============================================================================
# Main parse entry point
# =============================================================================
段落 parse 接收 tokens：
  设 stmts 为 列表创建()
  设 pos 为 0
  设 tok_count 为 列表长度(tokens)
  当 pos 小于 tok_count：
    设 p 为 skip_newlines(tokens, pos)
    如果 p 大于等于 tok_count：
      跳出
    设 tok 为 列表获取(tokens, p)
    设 ttype 为 字典获取(tok, "种别")
    设 tval 为 字典获取(tok, "值")
    # Skip EOF
    如果 ttype 等于 "结束"：
      跳出
    # Skip comments
    如果 ttype 等于 "注释"：
      设 pos 为 p 加 1
      跳过
    # Parse export statement: 导出 name1, name2, ...。
    如果 ttype 等于 "关键字" 且 tval 等于 "导出"：
      # Skip the whole export statement
      当 p 小于 tok_count：
        设 t 为 列表获取(tokens, p)
        如果 字典获取(t, "种别") 等于 "换行" 或 字典获取(t, "种别") 等于 "句号"：
          设 pos 为 p 加 1
          跳出
        p 加上 1
      跳过
    # Parse import statement: 导入 name。
    如果 ttype 等于 "关键字" 且 tval 等于 "导入"：
      设 pos 为 p 加 1
      跳过
    # Parse "从《module》导入《name》" style import
    如果 ttype 等于 "关键字" 且 tval 等于 "从"：
      # Skip the whole import statement
      当 p 小于 tok_count：
        设 t 为 列表获取(tokens, p)
        如果 字典获取(t, "种别") 等于 "换行" 或 字典获取(t, "种别") 等于 "句号"：
          设 pos 为 p 加 1
          跳出
        p 加上 1
      跳过
    设 result 为 parse_stmt(tokens, p)
    设 stmt 为 列表获取(result, 0)
    如果 stmt 不等于 空：
      列表追加(stmts, stmt)
    设 pos 为 列表获取(result, 1)
  设 program 为 make_program(stmts)
  返回 program


# ===== codegen.duan =====

# codegen.duan - Python code generator for bootstrap compiler
# Uses v3.2 语法标准: 段落 段名 接收 参数：body
#
# Takes AST from parser, produces Python source code
# All identifiers use English to avoid ANTLR keyword conflicts



# =============================================================================
# Generator state
# =============================================================================
# Global state for code generation
段落 init_generator：
  设 state 为 字典创建()
  字典设置(state, "lines", 列表创建())
  字典设置(state, "indent", 0)
  字典设置(state, "indent_str", "    ")
  返回 state

段落 add_line 接收 state, line：
  设 lines 为 字典获取(state, "lines")
  设 indent 为 字典获取(state, "indent")
  设 indent_str 为 字典获取(state, "indent_str")
  设 line_str 为 转字符串(line)
  设 prefix 为 ""
  设 i 为 0
  当 i 小于 indent：
    设 prefix 为 prefix 加 indent_str
    i 加上 1
  列表追加(lines, prefix 加 line_str)

段落 indent_push 接收 state：
  设 indent 为 字典获取(state, "indent")
  字典设置(state, "indent", indent 加 1)

段落 indent_pop 接收 state：
  设 indent 为 字典获取(state, "indent")
  如果 indent 大于 0：
    字典设置(state, "indent", indent 减 1)

段落 get_output 接收 state：
  设 lines 为 字典获取(state, "lines")
  设 result 为 ""
  设 i 为 0
  当 i 小于 列表长度(lines)：
    如果 i 大于 0：
      设 result 为 result 加 "\n"
    设 result 为 result 加 列表获取(lines, i)
    i 加上 1
  返回 result

# =============================================================================
# Builtin function name mapping
# =============================================================================
段落 map_builtin 接收 name：
  # Standard library functions mapped to _duan_builtin
  如果 name 等于 "打印"：
    返回 "_duan_builtin.打印"
  如果 name 等于 "输出"：
    返回 "_duan_builtin.打印"
  如果 name 等于 "输入" 或 name 等于 "读取"：
    返回 "_duan_builtin.读取"
  如果 name 等于 "转字符串"：
    返回 "_duan_builtin.转字符串"
  如果 name 等于 "转整数"：
    返回 "_duan_builtin.转整数"
  如果 name 等于 "转浮点"：
    返回 "_duan_builtin.转浮点"
  如果 name 等于 "列表创建" 或 name 等于 "列"：
    返回 "_duan_builtin.列表创建"
  如果 name 等于 "列表长度"：
    返回 "_duan_builtin.列表长度"
  如果 name 等于 "列表获取"：
    返回 "_duan_builtin.列表获取"
  如果 name 等于 "列表追加"：
    返回 "_duan_builtin.列表追加"
  如果 name 等于 "列表弹出"：
    返回 "_duan_builtin.列表弹出"
  如果 name 等于 "列表包含"：
    返回 "_duan_builtin.列表包含"
  如果 name 等于 "字典创建" 或 name 等于 "字典"：
    返回 "_duan_builtin.字典创建"
  如果 name 等于 "字典设置"：
    返回 "_duan_builtin.字典设置"
  如果 name 等于 "字典获取"：
    返回 "_duan_builtin.字典获取"
  如果 name 等于 "字典包含键"：
    返回 "_duan_builtin.字典包含键"
  如果 name 等于 "字典键列表"：
    返回 "_duan_builtin.字典键列表"
  如果 name 等于 "字典值列表" 或 name 等于 "字典值"：
    返回 "_duan_builtin.字典值列表"
  如果 name 等于 "字典项列表" 或 name 等于 "字典项"：
    返回 "_duan_builtin.字典项列表"
  如果 name 等于 "字典删除"：
    返回 "_duan_builtin.字典删除"
  如果 name 等于 "字符串长度"：
    返回 "_duan_builtin.字符串长度"
  如果 name 等于 "字符串获取"：
    返回 "_duan_builtin.字符串获取"
  如果 name 等于 "截取"：
    返回 "_duan_builtin.截取"
  如果 name 等于 "分割字符串" 或 name 等于 "分割"：
    返回 "_duan_builtin.分割字符串"
  如果 name 等于 "连接字符串" 或 name 等于 "连接"：
    返回 "_duan_builtin.连接字符串"
  如果 name 等于 "替换字符串" 或 name 等于 "替换"：
    返回 "_duan_builtin.替换字符串"
  如果 name 等于 "去除空白" 或 name 等于 "去空格"：
    返回 "_duan_builtin.去除空白"
  如果 name 等于 "列表排序" 或 name 等于 "排序"：
    返回 "_duan_builtin.列表排序"
  如果 name 等于 "列表反转" 或 name 等于 "反转"：
    返回 "_duan_builtin.列表反转"
  如果 name 等于 "列表创建" 或 name 等于 "列"：
    返回 "_duan_builtin.列表创建"
  如果 name 等于 "是整数"：
    返回 "_duan_builtin.是整数"
  如果 name 等于 "是浮点"：
    返回 "_duan_builtin.是浮点"
  如果 name 等于 "是字符串"：
    返回 "_duan_builtin.是字符串"
  如果 name 等于 "是列表"：
    返回 "_duan_builtin.是列表"
  如果 name 等于 "是字典"：
    返回 "_duan_builtin.是字典"
  如果 name 等于 "是空"：
    返回 "_duan_builtin.是空"
  如果 name 等于 "随机整数"：
    返回 "_duan_builtin.随机整数"
  如果 name 等于 "随机浮点"：
    返回 "_duan_builtin.随机浮点"
  如果 name 等于 "随机选择"：
    返回 "_duan_builtin.随机选择"
  如果 name 等于 "阶乘"：
    返回 "_duan_builtin.阶乘"
  如果 name 等于 "平均数"：
    返回 "_duan_builtin.平均数"
  如果 name 等于 "求和"：
    返回 "_duan_builtin.求和"
  如果 name 等于 "时间戳"：
    返回 "_duan_builtin.时间戳"
  如果 name 等于 "格式化时间"：
    返回 "_duan_builtin.格式化时间"
  如果 name 等于 "读取文件"：
    返回 "_duan_builtin.读取文件"
  如果 name 等于 "写入文件"：
    返回 "_duan_builtin.写入文件"
  如果 name 等于 "追加文件"：
    返回 "_duan_builtin.追加文件"
  如果 name 等于 "文件存在"：
    返回 "_duan_builtin.文件存在"
  如果 name 等于 "目录存在"：
    返回 "_duan_builtin.目录存在"
  如果 name 等于 "创建目录"：
    返回 "_duan_builtin.创建目录"
  如果 name 等于 "圆周率"：
    返回 "_duan_builtin.圆周率"
  如果 name 等于 "自然常数"：
    返回 "_duan_builtin.自然常数"
  如果 name 等于 "创建令牌"：
    返回 "创建令牌"
  如果 name 等于 "_读文件":
    返回 "_duan_builtin._读文件"
  如果 name 等于 "参数列表":
    返回 "sys.argv"
  # Default: use Chinese name directly
  返回 name

# =============================================================================
# Expression code generation
# =============================================================================
段落 gen_expr 接收 state, node：
  设 node_type 为 列表获取(node, 0)
  # Number: ["number", value]
  如果 node_type 等于 "number"：
    返回 列表获取(node, 1)
  # String: ["string", value]
  如果 node_type 等于 "string"：
    设 引号 为 "'"
    设 原始值 为 列表获取(node, 1)
    # 转义字符串中的特殊字符
    设 转义值 为 ""
    设 k 为 0
    当 k 小于 字符串长度(原始值)：
      设 ch 为 字符串获取(原始值, k)
      如果 ch 等于 "\\"：
        设 转义值 为 转义值 加 "\\\\"
      否则 如果 ch 等于 "\n"：
        设 转义值 为 转义值 加 "\\n"
      否则 如果 ch 等于 "\t"：
        设 转义值 为 转义值 加 "\\t"
      否则 如果 ch 等于 "'"：
        设 转义值 为 转义值 加 "\\'"
      否则：
        设 转义值 为 转义值 加 ch
      k 加上 1
    返回 引号 加 转义值 加 引号
  # Template string (f-string): ["template_string", value]
  如果 node_type 等于 "template_string"：
    设 原始值 为 列表获取(node, 1)
    # 使用双引号包装 f-string，转义双引号和特殊字符
    设 转义值 为 ""
    设 k 为 0
    当 k 小于 字符串长度(原始值)：
      设 ch 为 字符串获取(原始值, k)
      如果 ch 等于 "\\"：
        设 转义值 为 转义值 加 "\\\\"
      否则 如果 ch 等于 "\n"：
        设 转义值 为 转义值 加 "\\n"
      否则 如果 ch 等于 "\t"：
        设 转义值 为 转义值 加 "\\t"
      否则 如果 ch 等于 '"':
        设 转义值 为 转义值 加 '\\"'
      否则：
        设 转义值 为 转义值 加 ch
      k 加上 1
    返回 'f"' 加 转义值 加 '"'
  # Boolean: ["boolean", value]
  如果 node_type 等于 "boolean"：
    设 val 为 列表获取(node, 1)
    如果 val 等于 "真"：
      返回 "True"
    返回 "False"
  # Null: ["null"]
  如果 node_type 等于 "null"：
    返回 "None"
  # Identifier: ["identifier", name]
  如果 node_type 等于 "identifier"：
    返回 列表获取(node, 1)
  # Function call: ["func_call", name, args]
  如果 node_type 等于 "func_call"：
    设 name 为 列表获取(node, 1)
    设 mapped 为 map_builtin(name)
    设 args 为 列表获取(node, 2)
    设 result 为 mapped 加 "("
    设 i 为 0
    当 i 小于 列表长度(args)：
      如果 i 大于 0：
        设 result 为 result 加 ", "
      设 arg_node 为 列表获取(args, i)
      设 arg_code 为 gen_expr(state, arg_node)
      设 result 为 result 加 arg_code
      i 加上 1
    设 result 为 result 加 ")"
    返回 result
  # Binary op: ["binary_op", op, left, right]
  如果 node_type 等于 "binary_op"：
    设 op 为 列表获取(node, 1)
    设 left 为 gen_expr(state, 列表获取(node, 2))
    设 right 为 gen_expr(state, 列表获取(node, 3))
    设 py_op 为 op
    如果 op 等于 "加" 或 op 等于 "+"：
      设 py_op 为 "+"
    否则 如果 op 等于 "减" 或 op 等于 "-"：
      设 py_op 为 "-"
    否则 如果 op 等于 "乘" 或 op 等于 "*"：
      设 py_op 为 "*"
    否则 如果 op 等于 "除" 或 op 等于 "/"：
      设 py_op 为 "/"
    否则 如果 op 等于 "模" 或 op 等于 "%"：
      设 py_op 为 "%"
    否则 如果 op 等于 "幂" 或 op 等于 "^"：
      设 py_op 为 "**"
    否则 如果 op 等于 "大于"：
      设 py_op 为 ">"
    否则 如果 op 等于 "小于"：
      设 py_op 为 "<"
    否则 如果 op 等于 "等于" 或 op 等于 "=="：
      设 py_op 为 "=="
    否则 如果 op 等于 "不等于"：
      设 py_op 为 "!="
    否则 如果 op 等于 "大于等于"：
      设 py_op 为 ">="
    否则 如果 op 等于 "小于等于"：
      设 py_op 为 "<="
    否则 如果 op 等于 "且" 或 op 等于 "与"：
      设 py_op 为 "and"
    否则 如果 op 等于 "或"：
      设 py_op 为 "or"
    返回 "(" 加 left 加 " " 加 py_op 加 " " 加 right 加 ")"
  # Unary op
  如果 node_type 等于 "unary_op"：
    设 op 为 列表获取(node, 1)
    设 operand 为 gen_expr(state, 列表获取(node, 2))
    如果 op 等于 "非" 或 op 等于 "!"：
      返回 "not " 加 operand
    返回 op 加 operand
  # List literal: ["list_literal", elements]
  如果 node_type 等于 "list_literal"：
    设 elems 为 列表获取(node, 1)
    设 result 为 "["
    设 i 为 0
    当 i 小于 列表长度(elems)：
      如果 i 大于 0：
        设 result 为 result 加 ", "
      设 elem_code 为 gen_expr(state, 列表获取(elems, i))
      设 result 为 result 加 elem_code
      i 加上 1
    返回 result 加 "]"
  # Dict literal: ["dict_literal", pairs]
  如果 node_type 等于 "dict_literal"：
    设 pairs 为 列表获取(node, 1)
    设 result 为 "{"
    设 i 为 0
    当 i 小于 列表长度(pairs)：
      如果 i 大于 0：
        设 result 为 result 加 ", "
      设 pair 为 列表获取(pairs, i)
      设 key_code 为 gen_expr(state, 列表获取(pair, 0))
      设 val_code 为 gen_expr(state, 列表获取(pair, 1))
      设 result 为 result 加 key_code 加 ": " 加 val_code
      i 加上 1
    返回 result 加 "}"
  # Member access: ["member_access", object, prop]
  如果 node_type 等于 "member_access"：
    设 obj 为 gen_expr(state, 列表获取(node, 1))
    设 prop 为 列表获取(node, 2)
    返回 obj 加 "." 加 prop
  # Default
  返回 "None"

# =============================================================================
# Match pattern code generation
# =============================================================================
段落 gen_match_pattern 接收 state, pattern：
  设 kind 为 列表获取(pattern, 1)
  设 value 为 列表获取(pattern, 2)
  设 elements 为 列表获取(pattern, 3)
  设 type_name 为 列表获取(pattern, 4)
  设 binding 为 列表获取(pattern, 5)
  # 通配符
  如果 kind 等于 "wildcard"：
    返回 "_"
  # 数字模式
  如果 kind 等于 "number"：
    返回 value
  # 字符串模式
  如果 kind 等于 "string"：
    返回 "'" 加 value 加 "'"
  # 布尔模式
  如果 kind 等于 "bool"：
    如果 value 等于 "真"：
      返回 "True"
    返回 "False"
  # 空模式
  如果 kind 等于 "null"：
    返回 "None"
  # 变量绑定
  如果 kind 等于 "variable"：
    返回 binding
  # 类型检查模式
  如果 kind 等于 "type_check"：
    返回 type_name 加 "() as " 加 binding
  # 默认通配符
  返回 "_"

# =============================================================================
# Statement code generation
# =============================================================================
段落 gen_stmt 接收 state, node：
  设 node_type 为 列表获取(node, 0)
  # Variable declaration: ["var_decl", name, value]
  如果 node_type 等于 "var_decl"：
    设 name 为 列表获取(node, 1)
    设 value 为 gen_expr(state, 列表获取(node, 2))
    add_line(state, name 加 " = " 加 value)
    返回
  # Assignment: ["assign", name, value]
  如果 node_type 等于 "assign"：
    设 name 为 列表获取(node, 1)
    设 value 为 gen_expr(state, 列表获取(node, 2))
    add_line(state, name 加 " = " 加 value)
    返回
  # Compound assignment: ["compound_assign", name, op, value]
  如果 node_type 等于 "compound_assign"：
    设 name 为 列表获取(node, 1)
    设 op 为 列表获取(node, 2)
    设 value 为 gen_expr(state, 列表获取(node, 3))
    设 py_op 为 "+"
    如果 op 等于 "加上"：
      设 py_op 为 "+"
    否则 如果 op 等于 "减去"：
      设 py_op 为 "-"
    否则 如果 op 等于 "乘以"：
      设 py_op 为 "*"
    否则 如果 op 等于 "除以"：
      设 py_op 为 "/"
    否则 如果 op 等于 "模以"：
      设 py_op 为 "%"
    否则 如果 op 等于 "幂以"：
      设 py_op 为 "**"
    add_line(state, name 加 " " 加 py_op 加 "= " 加 value)
    返回
  # Return statement: ["return", value]
  如果 node_type 等于 "return"：
    设 value 为 列表获取(node, 1)
    如果 value 等于 空：
      add_line(state, "return")
    否则：
      add_line(state, "return " 加 gen_expr(state, value))
    返回
  # If statement: ["if_stmt", cond, body, elif_branches, else_body]
  如果 node_type 等于 "if_stmt"：
    设 cond 为 gen_expr(state, 列表获取(node, 1))
    设 body 为 列表获取(node, 2)
    设 elif_branches 为 列表获取(node, 3)
    设 else_body 为 列表获取(node, 4)
    add_line(state, "if " 加 cond 加 ":")
    indent_push(state)
    设 i 为 0
    当 i 小于 列表长度(body)：
      gen_stmt(state, 列表获取(body, i))
      i 加上 1
    indent_pop(state)
    # Elif branches
    设 j 为 0
    当 j 小于 列表长度(elif_branches)：
      设 branch 为 列表获取(elif_branches, j)
      设 elif_cond 为 gen_expr(state, 列表获取(branch, 0))
      设 elif_body 为 列表获取(branch, 1)
      add_line(state, "elif " 加 elif_cond 加 ":")
      indent_push(state)
      设 k 为 0
      当 k 小于 列表长度(elif_body)：
        gen_stmt(state, 列表获取(elif_body, k))
        k 加上 1
      indent_pop(state)
      j 加上 1
    # Else body
    如果 else_body 不等于 空：
      add_line(state, "else:")
      indent_push(state)
      设 m 为 0
      当 m 小于 列表长度(else_body)：
        gen_stmt(state, 列表获取(else_body, m))
        m 加上 1
      indent_pop(state)
    返回
  # While loop: ["while_loop", cond, body]
  如果 node_type 等于 "while_loop"：
    设 cond 为 gen_expr(state, 列表获取(node, 1))
    设 body 为 列表获取(node, 2)
    add_line(state, "while " 加 cond 加 ":")
    indent_push(state)
    设 i 为 0
    当 i 小于 列表长度(body)：
      gen_stmt(state, 列表获取(body, i))
      i 加上 1
    indent_pop(state)
    返回
  # For each loop: ["for_each", var_name, collection, body]
  如果 node_type 等于 "for_each"：
    设 var_name 为 列表获取(node, 1)
    设 collection 为 gen_expr(state, 列表获取(node, 2))
    设 body 为 列表获取(node, 3)
    add_line(state, "for " 加 var_name 加 " in " 加 collection 加 ":")
    indent_push(state)
    设 i 为 0
    当 i 小于 列表长度(body)：
      gen_stmt(state, 列表获取(body, i))
      i 加上 1
    indent_pop(state)
    返回
  # Print statement: ["print", value]
  如果 node_type 等于 "print"：
    设 value 为 列表获取(node, 1)
    设 val_code 为 gen_expr(state, value)
    add_line(state, "print(" 加 val_code 加 ")")
    返回
  # Function call as statement: ["func_call", name, args]
  如果 node_type 等于 "func_call"：
    设 code 为 gen_expr(state, node)
    add_line(state, code)
    返回
  # Break statement: ["break"]
  如果 node_type 等于 "break"：
    add_line(state, "break")
    返回
  # Continue statement: ["continue"]
  如果 node_type 等于 "continue"：
    add_line(state, "continue")
    返回
  # Paragraph (function) definition: ["paragraph_def", name, params, body]
  # params 是 [name, default_expr] 对的列表，default_expr 为空表示无默认值
  如果 node_type 等于 "paragraph_def"：
    设 name 为 列表获取(node, 1)
    设 params 为 列表获取(node, 2)
    设 body 为 列表获取(node, 3)
    设 param_str 为 ""
    设 i 为 0
    当 i 小于 列表长度(params)：
      如果 i 大于 0：
        设 param_str 为 param_str 加 ", "
      设 param_pair 为 列表获取(params, i)
      设 pname 为 列表获取(param_pair, 0)
      设 pdefault 为 列表获取(param_pair, 1)
      设 param_str 为 param_str 加 pname
      如果 pdefault 不等于 空：
        设 default_code 为 gen_expr(state, pdefault)
        设 param_str 为 param_str 加 "=" 加 default_code
      i 加上 1
    add_line(state, "def " 加 name 加 "(" 加 param_str 加 "):")
    indent_push(state)
    设 j 为 0
    当 j 小于 列表长度(body)：
      gen_stmt(state, 列表获取(body, j))
      j 加上 1
    indent_pop(state)
    add_line(state, "")
    返回
  # Expression statement: ["expr_stmt", expr]
  如果 node_type 等于 "expr_stmt"：
    设 expr 为 列表获取(node, 1)
    设 code 为 gen_expr(state, expr)
    add_line(state, code)
    返回
  # Interface definition: ["interface_def", name, methods, super_interfaces]
  如果 node_type 等于 "interface_def"：
    设 name 为 列表获取(node, 1)
    设 methods 为 列表获取(node, 2)
    设 super_interfaces 为 列表获取(node, 3)
    设 bases 为 "ABC"
    设 i 为 0
    当 i 小于 列表长度(super_interfaces)：
      设 bases 为 bases 加 ", " 加 列表获取(super_interfaces, i)
      i 加上 1
    add_line(state, "class " 加 name 加 "(" 加 bases 加 "):")
    indent_push(state)
    设 j 为 0
    当 j 小于 列表长度(methods)：
      设 method 为 列表获取(methods, j)
      设 method_name 为 列表获取(method, 1)
      设 params 为 列表获取(method, 2)
      设 return_type 为 列表获取(method, 3)
      add_line(state, "@abstractmethod")
      设 param_str 为 "self"
      设 k 为 0
      当 k 小于 列表长度(params)：
        设 param_pair 为 列表获取(params, k)
        设 param_str 为 param_str 加 ", " 加 列表获取(param_pair, 0)
        k 加上 1
      如果 return_type 不等于 空 且 return_type 不等于 ""：
        add_line(state, "def " 加 method_name 加 "(" 加 param_str 加 ") -> " 加 return_type 加 ":")
      否则：
        add_line(state, "def " 加 method_name 加 "(" 加 param_str 加 "):")
      indent_push(state)
      add_line(state, "pass")
      indent_pop(state)
      j 加上 1
    如果 列表长度(methods) 等于 0：
      add_line(state, "pass")
    indent_pop(state)
    add_line(state, "")
    返回
  # Match statement: ["match_stmt", subject, cases]
  如果 node_type 等于 "match_stmt"：
    设 subject 为 gen_expr(state, 列表获取(node, 1))
    设 cases 为 列表获取(node, 2)
    add_line(state, "match " 加 subject 加 ":")
    indent_push(state)
    设 i 为 0
    当 i 小于 列表长度(cases)：
      设 case_node 为 列表获取(cases, i)
      设 pattern 为 列表获取(case_node, 1)
      设 guard 为 列表获取(case_node, 2)
      设 body 为 列表获取(case_node, 3)
      # 生成模式代码
      设 pattern_code 为 gen_match_pattern(state, pattern)
      设 guard_str 为 ""
      如果 guard 不等于 空：
        设 guard_str 为 " if " 加 gen_expr(state, guard)
      add_line(state, "case " 加 pattern_code 加 guard_str 加 ":")
      indent_push(state)
      如果 列表长度(body) 大于 0：
        设 j 为 0
        当 j 小于 列表长度(body)：
          gen_stmt(state, 列表获取(body, j))
          j 加上 1
      否则：
        add_line(state, "pass")
      indent_pop(state)
      i 加上 1
    indent_pop(state)
    add_line(state, "")
    返回
  # With statement: ["with_stmt", context_expr, variable, body]
  如果 node_type 等于 "with_stmt"：
    设 context_expr 为 gen_expr(state, 列表获取(node, 1))
    设 variable 为 列表获取(node, 2)
    设 body 为 列表获取(node, 3)
    如果 variable 不等于 空 且 variable 不等于 ""：
      add_line(state, "with " 加 context_expr 加 " as " 加 variable 加 ":")
    否则：
      add_line(state, "with " 加 context_expr 加 ":")
    indent_push(state)
    设 i 为 0
    当 i 小于 列表长度(body)：
      gen_stmt(state, 列表获取(body, i))
      i 加上 1
    indent_pop(state)
    返回
  # Try statement: ["try_stmt", try_body, catch_clauses, finally_body]
  如果 node_type 等于 "try_stmt"：
    设 try_body 为 列表获取(node, 1)
    设 catch_clauses 为 列表获取(node, 2)
    设 finally_body 为 列表获取(node, 3)
    add_line(state, "try:")
    indent_push(state)
    设 i 为 0
    当 i 小于 列表长度(try_body)：
      gen_stmt(state, 列表获取(try_body, i))
      i 加上 1
    indent_pop(state)
    # 捕获子句
    设 j 为 0
    当 j 小于 列表长度(catch_clauses)：
      设 clause 为 列表获取(catch_clauses, j)
      设 catch_type 为 列表获取(clause, 0)
      设 catch_var 为 列表获取(clause, 1)
      设 catch_body 为 列表获取(clause, 2)
      设 except_str 为 "except"
      如果 catch_type 不等于 空 且 catch_type 不等于 ""：
        设 except_str 为 except_str 加 " " 加 catch_type
      如果 catch_var 不等于 空 且 catch_var 不等于 ""：
        设 except_str 为 except_str 加 " as " 加 catch_var
      否则 如果 catch_type 等于 空 或 catch_type 等于 ""：
        设 except_str 为 except_str 加 " Exception"
      add_line(state, except_str 加 ":")
      indent_push(state)
      设 k 为 0
      当 k 小于 列表长度(catch_body)：
        gen_stmt(state, 列表获取(catch_body, k))
        k 加上 1
      indent_pop(state)
      j 加上 1
    # 最终子句
    如果 finally_body 不等于 空：
      add_line(state, "finally:")
      indent_push(state)
      设 m 为 0
      当 m 小于 列表长度(finally_body)：
        gen_stmt(state, 列表获取(finally_body, m))
        m 加上 1
      indent_pop(state)
    返回
  # Throw statement: ["throw_stmt", value, from_expr]
  如果 node_type 等于 "throw_stmt"：
    设 value 为 列表获取(node, 1)
    设 from_expr 为 列表获取(node, 2)
    如果 value 等于 空：
      add_line(state, "raise")
    否则：
      设 value_code 为 gen_expr(state, value)
      设 from_str 为 ""
      如果 from_expr 不等于 空：
        设 from_str 为 " from " 加 gen_expr(state, from_expr)
      add_line(state, "raise " 加 value_code 加 from_str)
    返回
  # Default: skip unknown nodes
  返回

# =============================================================================
# Import/Export header generation
# =============================================================================
段落 gen_header 接收 state：
  add_line(state, "# Generated by Duan bootstrap compiler")
  add_line(state, "import sys")
  add_line(state, "import types")
  add_line(state, "from abc import ABC, abstractmethod")
  add_line(state, "_duan_builtin = types.ModuleType('_duan_builtin')")
  add_line(state, "_duan_builtin.打印 = print")
  add_line(state, "_duan_builtin.转字符串 = str")
  add_line(state, "_duan_builtin.转整数 = int")
  add_line(state, "_duan_builtin.列表创建 = list")
  add_line(state, "_duan_builtin.列表长度 = len")
  add_line(state, "_duan_builtin.列表获取 = lambda lst, i: lst[i]")
  add_line(state, "_duan_builtin.列表追加 = lambda lst, item: lst.append(item)")
  add_line(state, "_duan_builtin.列表弹出 = lambda lst: lst.pop()")
  add_line(state, "_duan_builtin.列表包含 = lambda lst, item: item in lst")
  add_line(state, "_duan_builtin.字典创建 = dict")
  设 左花 为 "{"
  设 右花 为 "}"
  add_line(state, "_duan_builtin.字典设置 = lambda d, k, v: d.update(" + 左花 + "k: v" + 右花 + ")")
  add_line(state, "_duan_builtin.字典获取 = lambda d, k, default=None: d.get(k, default)")
  add_line(state, "_duan_builtin.字典包含键 = lambda d, k: k in d")
  add_line(state, "_duan_builtin.字典键列表 = lambda d: list(d.keys())")
  add_line(state, "_duan_builtin.字符串长度 = len")
  add_line(state, "_duan_builtin.字符串获取 = lambda s, i: s[i]")
  add_line(state, "_duan_builtin.截取 = lambda s, start, end: s[start:end]")
  add_line(state, "_duan_builtin.分割字符串 = lambda s, sep=' ': s.split(sep)")
  add_line(state, "_duan_builtin.连接字符串 = lambda parts, sep='': sep.join(parts)")
  add_line(state, "_duan_builtin.替换字符串 = lambda s, old, new: s.replace(old, new)")
  add_line(state, "_duan_builtin.去除空白 = lambda s: s.strip()")
  add_line(state, "_duan_builtin.列表排序 = lambda lst, reverse=False: lst.sort(reverse=reverse)")
  add_line(state, "_duan_builtin.列表反转 = lambda lst: lst.reverse()")
  add_line(state, "_duan_builtin.是整数 = lambda x: isinstance(x, int)")
  add_line(state, "_duan_builtin.是浮点 = lambda x: isinstance(x, float)")
  add_line(state, "_duan_builtin.是字符串 = lambda x: isinstance(x, str)")
  add_line(state, "_duan_builtin.是列表 = lambda x: isinstance(x, list)")
  add_line(state, "_duan_builtin.是字典 = lambda x: isinstance(x, dict)")
  add_line(state, "_duan_builtin.是空 = lambda x: x is None")
  add_line(state, "_duan_builtin.字典值列表 = lambda d: list(d.values())")
  add_line(state, "_duan_builtin.字典项列表 = lambda d: list(d.items())")
  add_line(state, "_duan_builtin.字典删除 = lambda d, k: d.pop(k, None)")
  add_line(state, "_duan_builtin.随机整数 = lambda a, b: __import__('random').randint(a, b)")
  add_line(state, "_duan_builtin.随机浮点 = lambda: __import__('random').random()")
  add_line(state, "_duan_builtin.随机选择 = lambda lst: __import__('random').choice(lst)")
  add_line(state, "_duan_builtin.阶乘 = lambda n: __import__('math').factorial(n)")
  add_line(state, "_duan_builtin.平均数 = lambda data: sum(data) / len(data) if data else 0")
  add_line(state, "_duan_builtin.求和 = lambda data: sum(data)")
  add_line(state, "_duan_builtin.时间戳 = lambda: __import__('time').time()")
  add_line(state, "_duan_builtin.格式化时间 = lambda ts, fmt='%Y-%m-%d %H:%M:%S': __import__('time').strftime(fmt, __import__('time').localtime(ts))")
  add_line(state, "_duan_builtin.读取文件 = lambda path: open(path, 'r', encoding='utf-8').read()")
  add_line(state, "_duan_builtin.写入文件 = lambda path, content: open(path, 'w', encoding='utf-8').write(content)")
  add_line(state, "_duan_builtin.追加文件 = lambda path, content: open(path, 'a', encoding='utf-8').write(content)")
  add_line(state, "_duan_builtin.文件存在 = lambda path: __import__('os').path.isfile(path)")
  add_line(state, "_duan_builtin.目录存在 = lambda path: __import__('os').path.isdir(path)")
  add_line(state, "_duan_builtin.创建目录 = lambda path: __import__('os').makedirs(path, exist_ok=True)")
  add_line(state, "_duan_builtin.圆周率 = lambda: __import__('math').pi")
  add_line(state, "_duan_builtin.自然常数 = lambda: __import__('math').e")
  add_line(state, "_duan_builtin._读文件 = lambda path: open(path, 'r', encoding='utf-8').read()")
  add_line(state, "")
  # 全局绑定：在模块级别设置内建函数别名（在所有函数定义的前）
  add_line(state, "# 全局绑定：内建函数别名（模块级别，在函数定义的前）")
  add_line(state, "字符串获取 = _duan_builtin.字符串获取")
  add_line(state, "字符串长度 = _duan_builtin.字符串长度")
  add_line(state, "截取 = _duan_builtin.截取")
  add_line(state, "")
  add_line(state, "")

# =============================================================================
# Module-level initialization
# =============================================================================
段落 gen_module_init 接收 state：
  # 全局绑定：在函数定义的前设置
  add_line(state, "# 全局绑定：内建函数别名")
  add_line(state, "字符串获取 = _duan_builtin.字符串获取")
  add_line(state, "字符串长度 = _duan_builtin.字符串长度")
  add_line(state, "截取 = _duan_builtin.截取")
  add_line(state, "")

# =============================================================================
# Main generate entry point
# =============================================================================
段落 generate 接收 ast_node：
  # 先收集所有语句的代码
  设 stmts_state 为 init_generator()
  设 node_type 为 列表获取(ast_node, 0)
  如果 node_type 等于 "program"：
    设 stmts 为 列表获取(ast_node, 1)
    设 i 为 0
    当 i 小于 列表长度(stmts)：
      gen_stmt(stmts_state, 列表获取(stmts, i))
      i 加上 1
  # 获取语句代码
  设 stmts_result 为 get_output(stmts_state)
  # 输出头部代码和全局绑定
  设 state 为 init_generator()
  gen_header(state)
  gen_module_init(state)
  设 header_result 为 get_output(state)
  # 组合：头部 + 语句
  返回 header_result 加 "\n" 加 stmts_result

# ===== compiler.duan =====

# compiler.duan - Bootstrap compiler main entry point
# v3.2 语法标准
#
# Orchestrates lexer -> parser -> codegen pipeline



# =============================================================================
# Compilation pipeline
# =============================================================================

# compile_source: takes Duan source string, returns Python code string
段落 compile_source 接收 source：
  设 tokens 为 词法分析(source)
  设 ast 为 parse(tokens)
  设 py_code 为 generate(ast)
  返回 py_code

# compile_file: reads a .duan file and compiles it to Python
段落 compile_file 接收 filepath：
  设 content 为 _读文件(filepath)
  返回 compile_source(content)


# ===== main.duan =====

# main.duan - Bootstrap compiler CLI entry point
# v3.2 语法标准
#
# Entry point for the bootstrap compiler.
# Can be invoked from run_compiler.py or directly from interpreter.



# main: invoked from Python wrapper (run_compiler.py)
# Takes a filepath and optionally an output path
段落 main 接收 filepath：
  设 py_code 为 compile_file(filepath)
  打印(py_code)
