class时间差:
    def__init__(self,天数=0,秒数=0,**参数):
        self._时间差=_创建时间差(天数=天数,秒数=秒数,**参数)
    
    def__add__(self,其他):
        如果是日期时间(其他):
            返回日期时间._从日期时间(其他._日期时间+self._时间差)
        返回时间差._从时间差(self._时间差+其他._时间差)
    
    def__sub__(self,其他):
        返回时间差._从时间差(self._时间差-其他._时间差)
    
    def__neg__(self):
        返回时间差._从时间差(-self._时间差)
    
    def__mul__(self,标量):
        返回时间差._从时间差(self._时间差*标量)
    
    def__truediv__(self,其他):
        如果是时间差(其他):
            返回self._时间差/其他._时间差
        返回时间差._从时间差(self._时间差/其他)
    
    def__repr__(self):
        返回'时间差('+转字符串(self.天数())+'天, '+转字符串(self.秒数())+'秒)'
    
    @类方法
    def_from_timedelta(cls,td):
        实例=cls.__新__(cls)
        实例._时间差=td
        返回实例
    
    def天数(self):
        返回self._时间差.总秒数()/(24*60*60)
    
    def总秒数(self):
        返回self._时间差.总秒数()
    
    def秒数(self):
        返回self._时间差.秒数%60
    
    def分钟数(self):
        返回(self._时间差.秒数//60)%60
    
    def小时数(self):
        返回self._时间差.秒数//(60*60)
    
    def周数(self):
        返回self.天数()/7


class日期时间:
    def__init__(self,年,月,日,时=0,分=0,秒=0,微秒=0,时区=无):
        self._日期时间=_创建日期时间(年,月,日,时,分,秒,微秒,时区)
    
    def__add__(self,其他):
        返回日期时间._从日期时间(self._日期时间+其他._时间差)
    
    def__sub__(self,其他):
        如果是日期时间(其他):
            返回时间差._从时间差(self._日期时间-其他._日期时间)
        返回日期时间._从日期时间(self._日期时间-其他._时间差)
    
    def__lt__(self,其他):
        返回self._日期时间<其他._日期时间
    
    def__le__(self,其他):
        返回self._日期时间<=其他._日期时间
    
    def__gt__(self,其他):
        返回self._日期时间>其他._日期时间
    
    def__ge__(self,其他):
        返回self._日期时间>=其他._日期时间
    
    def__eq__(self,其他):
        返回self._日期时间==其他._日期时间
    
    def__repr__(self):
        返回'日期时间('+转字符串(self.年())+', '+转字符串(self.月())+', '+转字符串(self.日())+', '+转字符串(self.时())+', '+转字符串(self.分())+', '+转字符串(self.秒())+')'
    
    @类方法
    def_from_datetime(cls,dt):
        实例=cls.__新__(cls)
        实例._日期时间=dt
        返回实例
    
    def年(self):
        返回self._日期时间.年
    
    def月(self):
        返回self._日期时间.月
    
    def日(self):
        返回self._日期时间.日
    
    def时(self):
        返回self._日期时间.小时
    
    def分(self):
        返回self._日期时间.分钟
    
    def秒(self):
        返回self._日期时间.秒
    
    def微秒(self):
        返回self._日期时间.微秒
    
    def星期(self):
        返回self._日期时间.工作日()
    
    def周几(self):
        星期列表=['周一','周二','周三','周四','周五','周六','周日']
        返回星期列表[self.星期()]
    
    def季度(self):
        返回(self.月()-1)//3+1
    
    def年中第几天(self):
        返回self._日期时间.时间元组().tm_yday
    
    def周中第几天(self):
        返回self._日期时间.isoweekday()
    
    def转换时区(self,目标时区):
        return日期时间._从日期时间(self._日期时间.astimezone(目标时区))
    
    def转为本地时间(self):
        return日期时间._从日期时间(self._日期时间.astimezone())
    
    def转为UTC(self):
        return日期时间._从日期时间(self._日期时间.astimezone(_UTC时区()))
    
    def是否夏令时(self):
        returnself._日期时间.dst()不是无且self._日期时间.dst()>_创建时间差(0)
    
    def格式化(self,格式字符串='%Y-%m-%d %H:%M:%S'):
        returnself._日期时间.strftime(格式字符串)
    
    def转为时间戳(self):
        returnself._日期时间.时间戳()
    
    def是否工作日(self):
        returnself.星期()<5


def当前时间():
    return日期时间._从日期时间(_当前日期时间())


def当前UTC时间():
    return日期时间._从日期时间(_当前UTC日期时间())


def从时间戳(时间戳,时区=无):
    如果时区是无:
        return日期时间._从日期时间(_从时间戳(时间戳))
    return日期时间._从日期时间(_从时间戳(时间戳,时区))


def从字符串(字符串,格式字符串='%Y-%m-%d %H:%M:%S'):
    return日期时间._从日期时间(_从字符串(字符串,格式字符串))


def创建时区(偏移秒数):
    return_创建时区(_创建时间差(秒数=偏移秒数))


def北京时间():
    return创建时区(8*60*60)


def纽约时间():
    return创建时区(-5*60*60)


def伦敦时间():
    return创建时区(0)


def东京时间():
    return创建时区(9*60*60)


def计算时间差(开始时间,结束时间):
    return结束时间-开始时间


def日期加减(日期时间,天数=0,小时=0,分钟=0,秒=0):
    return日期时间+时间差(天数=天数)+时间差(秒数=小时*3600+分钟*60+秒)


def加天数(日期时间,天数):
    return日期时间+时间差(天数=天数)


def减天数(日期时间,天数):
    return日期时间-时间差(天数=天数)


def加小时(日期时间,小时):
    return日期时间+时间差(秒数=小时*3600)


def减小时(日期时间,小时):
    return日期时间-时间差(秒数=小时*3600)


def获取今天():
    return当前时间()


def获取昨天():
    return减天数(当前时间(),1)


def获取明天():
    return加天数(当前时间(),1)


def获取本周一():
    今天=当前时间()
    return减天数(今天,今天.星期())


def获取本周末():
    今天=当前时间()
    return加天数(今天,6-今天.星期())


def获取本月第一天():
    今天=当前时间()
    return日期时间(今天.年(),今天.月(),1)


def获取本月最后一天():
    今天=当前时间()
    下个月=今天.月()+1
    年=今天.年()
    如果下个月>12:
        下个月=1
        年+=1
    return减天数(日期时间(年,下个月,1),1)


def获取本年第一天():
    今天=当前时间()
    return日期时间(今天.年(),1,1)


def获取本年最后一天():
    今天=当前时间()
    return日期时间(今天.年(),12,31)


def计算两个日期天数差(日期1,日期2):
    差值=日期2-日期1
    return整数(差值.天数())


def计算工作日天数(开始日期,结束日期):
    天数=0
    当前日期=开始日期
    当当前日期<=结束日期:
        如果当前日期.是否工作日():
            天数+=1
        当前日期=加天数(当前日期,1)
    返回天数


def判断闰年(年):
    return(年%4==0且年%100!=0)或(年%400==0)


def获取月份天数(年,月):
    月份天数=[31,28,31,30,31,30,31,31,30,31,30,31]
    如果月==2且判断闰年(年):
        返回29
    返回月份天数[月-1]


def格式化时间戳(时间戳,格式字符串='%Y-%m-%d %H:%M:%S'):
    return从时间戳(时间戳).格式化(格式字符串)


def解析相对时间(相对时间):
    当前=当前时间()
    相对时间=相对时间.去除首尾()
    
    如果'前'在相对时间:
        如果'秒'在相对时间:
            秒数=整数(_连接(_过滤(_是数字,相对时间)))
            return当前-时间差(秒数=秒数)
        否则如果'分钟'在相对时间:
            分钟=整数(_连接(_过滤(_是数字,相对时间)))
            return当前-时间差(秒数=分钟*60)
        否则如果'小时'在相对时间:
            小时=整数(_连接(_过滤(_是数字,相对时间)))
            return当前-时间差(秒数=小时*3600)
        否则如果'天'在相对时间:
            天数=整数(_连接(_过滤(_是数字,相对时间)))
            return当前-时间差(天数=天数)
        否则如果'周'在相对时间:
            周数=整数(_连接(_过滤(_是数字,相对时间)))
            return当前-时间差(天数=周数*7)
        否则如果'月'在相对时间:
            月数=整数(_连接(_过滤(_是数字,相对时间)))
            return日期时间(当前.年(),当前.月()-月数,当前.日())
        否则如果'年'在相对时间:
            年数=整数(_连接(_过滤(_是数字,相对时间)))
            return日期时间(当前.年()-年数,当前.月(),当前.日())
    
    否则如果'后'在相对时间或'内'在相对时间:
        如果'秒'在相对时间:
            秒数=整数(_连接(_过滤(_是数字,相对时间)))
            return当前+时间差(秒数=秒数)
        否则如果'分钟'在相对时间:
            分钟=整数(_连接(_过滤(_是数字,相对时间)))
            return当前+时间差(秒数=分钟*60)
        否则如果'小时'在相对时间:
            小时=整数(_连接(_过滤(_是数字,相对时间)))
            return当前+时间差(秒数=小时*3600)
        否则如果'天'在相对时间:
            天数=整数(_连接(_过滤(_是数字,相对时间)))
            return当前+时间差(天数=天数)
        否则如果'周'在相对时间:
            周数=整数(_连接(_过滤(_是数字,相对时间)))
            return当前+时间差(天数=周数*7)
        否则如果'月'在相对时间:
            月数=整数(_连接(_过滤(_是数字,相对时间)))
            return日期时间(当前.年(),当前.月()+月数,当前.日())
        否则如果'年'在相对时间:
            年数=整数(_连接(_过滤(_是数字,相对时间)))
            return日期时间(当前.年()+年数,当前.月(),当前.日())
    
    返回当前