导入数学为math

定义圆周率():
    返回math.pi

定义自然常数():
    返回math.e

定义欧拉常数():
    返回0.57721566490153286060651209008240243104215933593992

定义黄金比例():
    返回(1+5**0.5)/2

定义正弦(x):
    返回math.sin(x)

定义余弦(x):
    返回math.cos(x)

定义正切(x):
    返回math.tan(x)

定义反正弦(x):
    返回math.asin(x)

定义反余弦(x):
    返回math.acos(x)

定义反正切(x):
    返回math.atan(x)

定义双曲正弦(x):
    返回math.sinh(x)

定义双曲余弦(x):
    返回math.cosh(x)

定义双曲正切(x):
    返回math.tanh(x)

定义反双曲正弦(x):
    返回math.asinh(x)

定义反双曲余弦(x):
    返回math.acosh(x)

定义反双曲正切(x):
    返回math.atanh(x)

定义弧度(角度):
    返回math.radians(角度)

定义角度(弧度):
    返回math.degrees(弧度)

定义平方根(x):
    返回math.sqrt(x)

定义立方根(x):
    返回x**(1/3)

定义绝对值(x):
    返回abs(x)

定义幂(底数,指数):
    返回底数**指数

定义对数(x,底数=math.e):
    if底数==math.e:
        返回math.log(x)
    返回math.log(x,底数)

定义自然对数(x):
    返回math.log(x)

定义常用对数(x):
    返回math.log10(x)

定义指数(x):
    返回math.exp(x)

定义阶乘(n):
    if n<0:
        抛出错误("负数没有阶乘")
    返回math.factorial(n)

定义双阶乘(n):
    if n<0:
        抛出错误("负数没有双阶乘")
    结果=1
    i=n
    while i>0:
        结果=结果*i
        i=i-2
    返回结果

定义排列(n,k):
    if n<0或k<0或k>n:
        抛出错误(f"无效的排列参数:n={n},k={k}")
    结果=1
    for i in范围(k):
        结果=结果*(n-i)
    返回结果

定义组合(n,k):
    if n<0或k<0或k>n:
        抛出错误(f"无效的组合参数:n={n},k={k}")
    if k>n-k:
        k=n-k
    结果=1
    for i in范围(k):
        结果=结果*(n-i)//(i+1)
    返回结果

定义复数实部(z):
    返回z.real

定义复数虚部(z):
    返回z.imag

定义复数模(z):
    返回abs(z)

定义复数共轭(z):
    返回z.conjugate()