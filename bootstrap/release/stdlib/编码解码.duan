defHTML实体编码(文本):
    映射={
        '&':'&amp;',
        '<':'&lt;',
        '>':'&gt;',
        '"':'&quot;',
        "'":'&#39;'
    }
    结果=文本
    对于原始,替换在映射:
        结果=结果.replace(原始,替换)
    返回结果


defHTML实体解码(文本):
    映射={
        '&amp;':'&',
        '&lt;':'<',
        '&gt;':'>',
        '&quot;':'"',
        '&#39;':"'",
        '&nbsp;':' '
    }
    结果=文本
    对于原始,替换在映射:
        结果=结果.replace(原始,替换)
    返回结果


