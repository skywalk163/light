class 日志级别:
    DEBUG=10
    INFO=20
    WARNING=30
    ERROR=40
    CRITICAL=50
    
    级别名称={
        DEBUG:'DEBUG',
        INFO:'INFO',
        WARNING:'WARNING',
        ERROR:'ERROR',
        CRITICAL:'CRITICAL'
    }


class 日志格式化器:
    @静态方法
    def创建标准格式(包含时间=真,包含级别=真,包含模块=真,包含线程=假):
        格式部分=[]
        
        如果包含时间:
            格式部分.追加('%(asctime)s')
        如果包含级别:
            格式部分.追加('%(levelname)s')
        如果包含模块:
            格式部分.追加('%(name)s')
        如果包含线程:
            格式部分.追加('%(threadName)s')
        
        格式部分.追加('%(message)s')
        
        return_创建格式化器(' | '.连接(格式部分))
    
    @静态方法
    def创建JSON格式():
        return_创建格式化器(
            '{"时间":"%(asctime)s","级别":"%(levelname)s","模块":"%(name)s","消息":"%(message)s"}'
        )
    
    @静态方法
    def创建简洁格式():
        return_创建格式化器('%(levelname)s: %(message)s')
    
    @静态方法
    def创建详细格式():
        return_创建格式化器(
            '%(asctime)s | %(levelname)-8s | %(name)s | %(filename)s:%(lineno)d | %(funcName)s | %(message)s'
        )


class 日志处理器:
    @静态方法
    def创建控制台处理器(级别=日志级别.DEBUG,格式化器=无):
        处理器=_创建控制台处理器(级别)
        
        如果格式化器:
            处理器.设置格式化器(格式化器)
        
        return处理器
    
    @静态方法
    def创建文件处理器(文件名,级别=日志级别.DEBUG,格式化器=无,编码='utf-8'):
        处理器=_创建文件处理器(文件名,编码)
        处理器.设置级别(级别)
        
        如果格式化器:
            处理器.设置格式化器(格式化器)
        
        return处理器
    
    @静态方法
    def创建滚动文件处理器(文件名,级别=日志级别.DEBUG,格式化器=无,最大大小=1024*1024*10,备份数量=5,编码='utf-8'):
        处理器=_创建滚动文件处理器(文件名,最大大小,备份数量,编码)
        处理器.设置级别(级别)
        
        如果格式化器:
            处理器.设置格式化器(格式化器)
        
        return处理器
    
    @静态方法
    def创建时间滚动处理器(文件名,级别=日志级别.DEBUG,格式化器=无,间隔='D',备份数量=7,编码='utf-8'):
        处理器=_创建时间滚动处理器(文件名,间隔,备份数量,编码)
        处理器.设置级别(级别)
        
        如果格式化器:
            处理器.设置格式化器(格式化器)
        
        return处理器


class 日志过滤器:
    def初始化(允许级别列表=无,拒绝级别列表=无,包含关键词=无,排除关键词=无):
        self._允许级别列表=允许级别列表
        self._拒绝级别列表=拒绝级别列表
        self._包含关键词=包含关键词
        self._排除关键词=排除关键词
    
    def过滤(记录):
        如果self._允许级别列表且记录.级别号不在self._允许级别列表:
            return假
        
        如果self._拒绝级别列表且记录.级别号在self._拒绝级别列表:
            return假
        
        如果self._包含关键词:
            包含=任何(关键词在记录.获取消息()对于关键词在self._包含关键词)
            如果不是包含:
                return假
        
        如果self._排除关键词:
            对于关键词在self._排除关键词:
                如果关键词在记录.获取消息():
                    return假
        
        return真


class 日志记录器:
    def初始化(名称=__名称__,级别=日志级别.DEBUG):
        self._记录器=_获取日志记录器(名称)
        self._记录器.设置级别(级别)
    
    def添加处理器(处理器):
        self._记录器.添加处理器(处理器)
    
    def添加过滤器(过滤器):
        self._记录器.添加过滤器(过滤器)
    
    def设置级别(级别):
        self._记录器.设置级别(级别)
    
    def调试(消息,**额外信息):
        self._记录器.调试(消息,额外=额外信息)
    
    def信息(消息,**额外信息):
        self._记录器.信息(消息,额外=额外信息)
    
    def警告(消息,**额外信息):
        self._记录器.警告(消息,额外=额外信息)
    
    def错误(消息,**额外信息):
        self._记录器.错误(消息,额外=额外信息)
    
    def严重(消息,**额外信息):
        self._记录器.严重(消息,额外=额外信息)
    
    def异常(消息,**额外信息):
        self._记录器.异常(消息,额外=额外信息)
    
    def记录(级别,消息,**额外信息):
        self._记录器.记录(级别,消息,额外=额外信息)


class 日志管理器:
    def初始化():
        self._记录器映射={}
        self._全局级别=日志级别.DEBUG
    
    def设置全局级别(级别):
        self._全局级别=级别
    
    def获取记录器(名称):
        如果名称不在self._记录器映射:
            self._记录器映射[名称]=日志记录器(名称,self._全局级别)
        return self._记录器映射[名称]
    
    def配置控制台日志(级别=日志级别.INFO,格式化器=无):
        格式化器=格式化器或日志格式化器.创建标准格式()
        处理器=日志处理器.创建控制台处理器(级别,格式化器)
        
        对于记录器在self._记录器映射.值():
            记录器.添加处理器(处理器)
    
    def配置文件日志(文件名,级别=日志级别.DEBUG,格式化器=无,滚动=真,最大大小=1024*1024*10,备份数量=5):
        格式化器=格式化器或日志格式化器.创建详细格式()
        
        如果滚动:
            处理器=日志处理器.创建滚动文件处理器(文件名,级别,格式化器,最大大小,备份数量)
        否则:
            处理器=日志处理器.创建文件处理器(文件名,级别,格式化器)
        
        对于记录器在self._记录器映射.值():
            记录器.添加处理器(处理器)
    
    def配置时间滚动日志(文件名,级别=日志级别.DEBUG,格式化器=无,间隔='D',备份数量=7):
        格式化器=格式化器或日志格式化器.创建详细格式()
        处理器=日志处理器.创建时间滚动处理器(文件名,级别,格式化器,间隔,备份数量)
        
        对于记录器在self._记录器映射.值():
            记录器.添加处理器(处理器)


def获取日志记录器(名称=__名称__):
    return日志记录器(名称)


def创建日志记录器(名称=__名称__,级别=日志级别.DEBUG,控制台输出=真,文件输出=假,文件名='app.log'):
    记录器=日志记录器(名称,级别)
    
    如果控制台输出:
        格式化器=日志格式化器.创建标准格式()
        处理器=日志处理器.创建控制台处理器(级别,格式化器)
        记录器.添加处理器(处理器)
    
    如果文件输出:
        格式化器=日志格式化器.创建详细格式()
        处理器=日志处理器.创建滚动文件处理器(文件名,级别,格式化器)
        记录器.添加处理器(处理器)
    
    return记录器


class 日志上下文管理器:
    def初始化(记录器,消息,级别=日志级别.INFO):
        self._记录器=记录器
        self._消息=消息
        self._级别=级别
    
    def__进入__():
        self._记录器.记录(self._级别,'开始: '+self._消息)
        return self
    
    def__退出__(exc_type,exc_val,exc_tb):
        如果exc_type:
            self._记录器.错误('结束: '+self._消息+' - 异常: '+字符串(exc_val))
        否则:
            self._记录器.记录(self._级别,'完成: '+self._消息)


def日志上下文(记录器,消息,级别=日志级别.INFO):
    return日志上下文管理器(记录器,消息,级别)


class 结构化日志:
    @静态方法
    def创建结构化消息(事件,**数据):
        消息部分=['事件='+事件]
        对于键,值在数据.项():
            消息部分.追加(键+'='+字符串(值))
        return' '.连接(消息部分)
    
    @静态方法
    def创建API日志(方法,路径,状态码,耗时):
        return'API '+方法+' '+路径+' '+字符串(状态码)+' '+字符串(耗时)+'秒'
    
    @静态方法
    def创建数据库日志(操作,表名,影响行数,耗时):
        return'DB '+操作+' '+表名+' 影响='+字符串(影响行数)+' '+字符串(耗时)+'秒'
    
    @静态方法
    def创建性能日志(操作,耗时,内存=无):
        消息='性能 '+操作+' 耗时='+字符串(耗时)+'秒'
        如果内存:
            消息+=' 内存='+字符串(内存)+'MB'
        return消息