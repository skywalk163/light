class 对象池:
    def初始化(创建函数,最大大小=10,初始化数量=0,销毁函数=无):
        self._创建函数=创建函数
        self._最大大小=最大大小
        self._销毁函数=销毁函数
        self._可用对象=[]
        self._已使用对象=[]
        
        对于_在范围(最小(初始化数量,最大大小)):
            self._可用对象.追加(self._创建函数())
    
    def获取():
        如果self._可用对象:
            对象=self._可用对象.弹出()
        否则:
            对象=self._创建函数()
        
        self._已使用对象.追加(对象)
        return对象
    
    def释放(对象):
        如果对象在self._已使用对象:
            self._已使用对象.移除(对象)
        
        如果长度(self._可用对象)<self._最大大小:
            self._可用对象.追加(对象)
        否则如果self._销毁函数:
            self._销毁函数(对象)
    
    def清理():
        如果self._销毁函数:
            对于对象在self._可用对象:
                self._销毁函数(对象)
            对于对象在self._已使用对象:
                self._销毁函数(对象)
        
        self._可用对象=[]
        self._已使用对象=[]
    
    def可用数量():
        return长度(self._可用对象)
    
    def已用数量():
        return长度(self._已使用对象)
    
    def总数量():
        return长度(self._可用对象)+长度(self._已使用对象)
    
    def__进入__():
        return self
    
    def__退出__(exc_type,exc_val,exc_tb):
        self.清理()


class 对象上下文:
    def初始化(池):
        self._池=池
        self._对象=无
    
    def__进入__():
        self._对象=self._池.获取()
        return self._对象
    
    def__退出__(exc_type,exc_val,exc_tb):
        如果self._对象:
            self._池.释放(self._对象)


def对象上下文管理器(池):
    return对象上下文(池)


class LRU缓存:
    def初始化(最大容量=128):
        self._最大容量=最大容量
        self._缓存=有序字典()
        self._命中计数=0
        self._未命中计数=0
    
    def获取(键,默认值=无):
        如果键在self._缓存:
            self._命中计数+=1
            值=self._缓存.弹出(键)
            self._缓存[键]=值
            return值
        self._未命中计数+=1
        return默认值
    
    def设置(键,值):
        如果键在self._缓存:
            self._缓存.弹出(键)
        否则如果长度(self._缓存)>=self._最大容量:
            self._缓存.弹出项(last=假)
        
        self._缓存[键]=值
    
    def删除(键):
        如果键在self._缓存:
            删除self._缓存[键]
            return真
        return假
    
    def包含(键):
        return键在self._缓存
    
    def清空():
        self._缓存.清空()
        self._命中计数=0
        self._未命中计数=0
    
    def大小():
        return长度(self._缓存)
    
    def命中率():
        总次数=self._命中计数+self._未命中计数
        如果总次数==0:
            return0.0
        return self._命中计数/总次数
    
    def统计信息():
        return{
            '大小':self.大小(),
            '最大容量':self._最大容量,
            '命中数':self._命中计数,
            '未命中数':self._未命中计数,
            '命中率':self.命中率()
        }
    
    def键列表():
        return列表(self._缓存.键())
    
    def值列表():
        return列表(self._缓存.值())
    
    def项列表():
        return列表(self._缓存.项())


class 简单缓存:
    def初始化(过期时间=无):
        self._缓存={}
        self._过期时间=过期时间
    
    def获取(键,默认值=无):
        如果键在self._缓存:
            值,时间戳=self._缓存[键]
            如果self._过期时间是无或_当前时间()-时间戳<self._过期时间:
                return值
            否则:
                删除self._缓存[键]
        return默认值
    
    def设置(键,值):
        self._缓存[键]=(值,_当前时间())
    
    def删除(键):
        如果键在self._缓存:
            删除self._缓存[键]
            return真
        return假
    
    def包含(键):
        如果键在self._缓存:
            _,时间戳=self._缓存[键]
            如果self._过期时间是无或_当前时间()-时间戳<self._过期时间:
                return真
            否则:
                删除self._缓存[键]
        return假
    
    def清空():
        self._缓存.清空()
    
    def清理过期():
        当前时间=_当前时间()
        过期键=[]
        对于键,(_,时间戳)在self._缓存.项():
            如果self._过期时间且当前时间-时间戳>self._过期时间:
                过期键.追加(键)
        对于键在过期键:
            删除self._缓存[键]
    
    def大小():
        self.清理过期()
        return长度(self._缓存)


class 定时缓存:
    def初始化(刷新函数,刷新间隔=60):
        self._刷新函数=刷新函数
        self._刷新间隔=刷新间隔
        self._值=无
        self._最后刷新时间=0
    
    def获取():
        当前时间=_当前时间()
        如果当前时间-self._最后刷新时间>self._刷新间隔:
            self._值=self._刷新函数()
            self._最后刷新时间=当前时间
        return self._值
    
    def刷新():
        self._值=self._刷新函数()
        self._最后刷新时间=_当前时间()
        return self._值
    
    def清除():
        self._值=无
        self._最后刷新时间=0


def缓存装饰器(最大容量=128):
    def装饰器(函数):
        缓存=LRU缓存(最大容量)
        
        def包装(*参数):
            键=参数
            结果=缓存.获取(键)
            如果结果不是无:
                return结果
            结果=函数(*参数)
            缓存.设置(键,结果)
            return结果
        
        包装.缓存=缓存
        return包装
    return装饰器


defLRU缓存装饰器(最大容量=128):
    return缓存装饰器(最大容量)


def记忆化(函数):
    缓存={}
    
    def包装(*参数):
        如果参数不在缓存:
            缓存[参数]=函数(*参数)
        return缓存[参数]
    
    包装.缓存=缓存
    return包装


def创建对象池(创建函数,最大大小=10,初始化数量=0):
    return对象池(创建函数,最大大小,初始化数量)


def创建LRU缓存(最大容量=128):
    return LRU缓存(最大容量)


def创建简单缓存(过期时间=无):
    return简单缓存(过期时间)


def创建定时缓存(刷新函数,刷新间隔=60):
    return定时缓存(刷新函数,刷新间隔)