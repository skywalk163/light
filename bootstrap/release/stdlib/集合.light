定义创建集合(可迭代对象=None):
    if可迭代对象is None:
        return set()
    return set(可迭代对象)

定义集合转列表(集合):
    return列表(集合)

定义列表转集合(列表):
    return set(列表)

定义集合转元组(集合):
    return元组(集合)

定义集合转字符串(集合,分隔符=','):
    return分隔符.join(str(item)for item in集合)

定义并集(集合1,集合2):
    return集合1|集合2

定义交集(集合1,集合2):
    return集合1&集合2

定义差集(集合1,集合2):
    return集合1-集合2

定义对称差(集合1,集合2):
    return集合1^集合2

定义多个并集(*集合列表):
    if not集合列表:
        return set()
    结果=set(集合列表[0])
    for s in集合列表[1:]:
        结果|=s
    return结果

定义多个交集(*集合列表):
    if not集合列表:
        return set()
    结果=set(集合列表[0])
    for s in集合列表[1:]:
        结果&=s
    return结果

定义是否子集(集合1,集合2):
    return集合1<=集合2

定义是否真子集(集合1,集合2):
    return集合1<集合2

定义是否超集(集合1,集合2):
    return集合1>=集合2

定义是否真超集(集合1,集合2):
    return集合1>集合2

定义是否不相交(集合1,集合2):
    return集合1.isdisjoint(集合2)

定义添加元素(集合,元素):
    集合.add(元素)
    return集合

定义移除元素(集合,元素):
    集合.remove(元素)
    return集合

定义丢弃元素(集合,元素):
    集合.discard(元素)
    return集合

定义弹出元素(集合):
    return集合.pop()

定义清空集合(集合):
    集合.clear()
    return集合

定义集合长度(集合):
    return长(集合)

定义集合包含(集合,元素):
    return元素in集合

定义集合相等(集合1,集合2):
    return集合1==集合2

定义集合不等(集合1,集合2):
    return集合1!=集合2

定义复制集合(集合):
    return集合.copy()

定义冻结集合(可迭代对象=None):
    return frozenset(可迭代对象)

定义集合的幂集(集合):
    元素列表=列表(集合)
    幂集=[set()]
    for元素in元素列表:
        幂集+=[子集|{元素}for子集in幂集]
    return幂集

定义集合的笛卡尔积(集合1,集合2):
    return {(a,b)for a in集合1for b in集合2}

定义集合的补集(集合,全集):
    return全集-集合

定义集合差集的大小(集合1,集合2):
    return长(集合1-集合2)

定义集合交集的大小(集合1,集合2):
    return长(集合1&集合2)

定义集合并集的大小(集合1,集合2):
    return长(集合1|集合2)

定义杰卡德相似度(集合1,集合2):
    交集大小=长(集合1&集合2)
    并集大小=长(集合1|集合2)
    if并集大小==0:
        return 0.0
    return交集大小/并集大小

定义集合的唯一元素(列表):
    return set(列表)

定义集合的重复元素(列表):
    出现次数={}
    for元素in列表:
        出现次数[元素]=出现次数.get(元素,0)+1
    return {元素for元素,次数in出现次数.items()if次数>1}