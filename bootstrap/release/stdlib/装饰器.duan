def缓存(最大缓存数=128,过期秒数=无,忽略关键字参数=假):
    def装饰器(函数):
        def包装器(*参数,**关键字参数):
            返回_缓存装饰器(函数,参数,关键字参数,最大缓存数,过期秒数,忽略关键字参数)
        包装器.清除缓存=lambda:_清除缓存(函数)
        包装器.获取缓存信息=lambda:_获取缓存信息(函数)
        返回包装器
    返回装饰器


