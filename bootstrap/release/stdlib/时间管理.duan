class计时器:
    def__init__(self):
        self._开始时间=无
        self._结束时间=无
        self._记录=[]
    
    def开始(self):
        self._开始时间=_性能计数器()
        self._结束时间=无
    
    def结束(self):
        如果self._开始时间是无:
            抛出错误("计时器未开始")
        self._结束时间=_性能计数器()
        返回self._结束时间-self._开始时间
    
    def经过时间(self):
        如果self._开始时间是无:
            返回0.0
        如果self._结束时间不是无:
            返回self._结束时间-self._开始时间
        返回_性能计数器()-self._开始时间
    
    def重置(self):
        self._开始时间=无
        self._结束时间=无
        self._记录.clear()
    
    def打点(self,名称=''):
        当前时间=self.经过时间()
        self._记录.append(列表(名称,当前时间))
        返回当前时间
    
    def获取记录(self):
        返回列表(self._记录)


class定时器:
    def__init__(self,延迟秒数,回调函数,*参数,**关键字参数):
        self._延迟=延迟秒数
        self._回调=回调函数
        self._参数=参数
        self._关键字参数=关键字参数
        self._定时器=无
    
    def开始(self):
        如果self._定时器不是无:
            抛出错误("定时器已在运行")
        self._定时器=_创建定时器(self._延迟,self._回调,self._参数,self._关键字参数)
    
    def取消(self):
        如果self._定时器不是无:
            _取消定时器(self._定时器)
            self._定时器=无
    
    def是否运行中(self):
        返回self._定时器不是无且_定时器是否运行(self._定时器)


class周期定时器:
    def__init__(self,间隔秒数,回调函数,*参数,**关键字参数):
        self._间隔=间隔秒数
        self._回调=回调函数
        self._参数=参数
        self._关键字参数=关键字参数
        self._运行中=假
    
    def开始(self):
        如果self._运行中:
            抛出错误("定时器已在运行")
        self._运行中=真
        _创建周期定时器(self,self._间隔,self._回调,self._参数,self._关键字参数)
    
    def停止(self):
        self._运行中=假
    
    def是否运行中(self):
        返回self._运行中


class倒计时:
    def__init__(self,总秒数):
        self._总秒数=总秒数
        self._剩余秒数=总秒数
        self._开始时间=无
        self._运行中=假
    
    def开始(self):
        如果self._运行中:
            抛出错误("倒计时已在运行")
        self._开始时间=_性能计数器()
        self._运行中=真
    
    def暂停(self):
        如果不self._运行中:
            返回
        self._剩余秒数=self.剩余时间()
        self._运行中=假
    
    def继续(self):
        如果self._运行中:
            返回
        self._开始时间=_性能计数器()-(self._总秒数-self._剩余秒数)
        self._运行中=真
    
    def重置(self,新总秒数=无):
        如果新总秒数不是无:
            self._总秒数=新总秒数
        self._剩余秒数=self._总秒数
        self._开始时间=无
        self._运行中=假
    
    def剩余时间(self):
        如果不self._运行中:
            返回_最大值(0,self._剩余秒数)
        已过=_性能计数器()-self._开始时间
        返回_最大值(0,self._总秒数-已过)
    
    def已过时间(self):
        返回self._总秒数-self.剩余时间()
    
    def是否结束(self):
        返回self.剩余时间()<=0
    
    def是否运行中(self):
        返回self._运行中
    
    def等待结束(self):
        当不self.是否结束():
            睡眠(0.01)


def格式化耗时(秒数):
    如果秒数<0.001:
        返回_转字符串(秒数*1000000)+"微秒"
    又如果秒数<1:
        返回_转字符串(秒数*1000)+"毫秒"
    又如果秒数<60:
        返回_转字符串(秒数)+"秒"
    又如果秒数<3600:
        分钟=_取整(秒数//60)
        秒=秒数%60
        返回_转字符串(分钟)+"分"+_转字符串(秒)+"秒"
    否则:
        小时=_取整(秒数//3600)
        剩余=秒数%3600
        分钟=_取整(剩余//60)
        秒=剩余%60
        返回_转字符串(小时)+"时"+_转字符串(分钟)+"分"+_转字符串(秒)+"秒"