# Level 9 - 模块系统测试（主模块）
# 测试从其他模块导入函数

# 导入数学工具模块的函数
从 数学工具 导入 平方, 绝对值, 最大值, 阶乘, 是素数, 最大公约数。
从 字符串工具 导入 反转, 重复。
从 列表工具 导入 求和, 平均值, 范围。

输出 "=== Level 9 模块系统测试 ==="
输出 ""

# 测试数学工具模块
输出 "--- 数学工具模块 ---"
输出 "平方(5) = " + 转串(平方(5))
输出 "绝对值(-7) = " + 转串(绝对值(-7))
输出 "最大值(3, 8) = " + 转串(最大值(3, 8))
输出 "阶乘(6) = " + 转串(阶乘(6))
输出 "是素数(13) = " + 转串(是素数(13))
输出 "是素数(15) = " + 转串(是素数(15))
输出 "最大公约数(12, 18) = " + 转串(最大公约数(12, 18))
输出 ""

# 测试字符串工具模块
输出 "--- 字符串工具模块 ---"
输出 "反转(\"hello\") = " + 反转("hello")
输出 "重复(\"ab\", 3) = " + 重复("ab", 3)
输出 ""

# 测试列表工具模块
输出 "--- 列表工具模块 ---"
变量 数列 = 范围(1, 11)
输出 "范围(1, 11) 的长度 = " + 转串(长度(数列))
输出 "求和(范围(1,11)) = " + 转串(求和(数列))
输出 "平均值(范围(1,11)) = " + 转串(平均值(数列))
输出 ""

输出 "=== Level 9 测试完成 ==="
