# ============================================================
# 段言兜底生成器 · 本地密钥模板（DeepSeek 示例）
# 用法：复制本文件为同目录下的 .env，填入你的 key 即可生效
#       cp .env.example .env
# 说明：.env 不入库（已在 .gitignore 忽略）；优先级高于 llm_config.json
# ============================================================

# 你的 API Key（按所用端点申请；AMD 端点 key 以 rc- 开头）
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# LLM 端点（OpenAI 兼容，代码自动拼 /chat/completions，无需手写 /v1）
#   AMD 托管端点（本仓实测在用）：大小写敏感，模型名必须大写（见下）
OPENAI_BASE_URL=https://developer.amd.com.cn/radeon/api/v1

# 模型名（端点大小写敏感！）
#   AMD 端点：DeepSeek-V4-Flash（必须大写，小写会 400 模型不存在）
#   官方 DeepSeek 端点 https://api.deepseek.com：deepseek-chat / deepseek-reasoner（小写）
OPENAI_MODEL=DeepSeek-V4-Flash
