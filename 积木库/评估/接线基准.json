{
  "说明": "接线与类型闸门基准（v0.18）。基准.json 只量化『选对块了吗』，本文件量化『接对线了吗』——这是类型系统 v2 的收益所在，缺了它类型改动等于无尺可量。",
  "字段说明": {
    "编号": "W=链式接线用例，T=类型闸门用例",
    "步骤": "按顺序参与链式接线的块名（W 类）",
    "共享": "共享输入的段言字面量，用于推断输入类型",
    "期望": "可接 | 不可接",
    "期望参数": "可选。期望的逐步参数绑定，null 表示不校验该步",
    "候选": "非链式并行装配的候选块名（T 类）",
    "期望可用": "类型闸门过滤后应当保留的块名集合（T 类）",
    "理由": "人类可读的判定依据，失败时打印",
    "期望回退": "可选。期望被标记为「接不上上游、退回共享输入」的块名列表（链式语义削弱告警）"
  },
  "用例": [
    {
      "编号": "W01",
      "步骤": [
        "切分文本",
        "求和"
      ],
      "共享": "\"a,b,c\"",
      "期望": "不可接",
      "理由": "切分文本输出 列表[文本]，求和要 列表[数]。旧粗类型下两者都叫『列表』会被误接"
    },
    {
      "编号": "W02",
      "步骤": [
        "切分文本",
        "拼接文本"
      ],
      "共享": "\"a,b,c\"",
      "期望": "可接",
      "理由": "列表[文本] 可以喂给 拼接文本 的 列表[任意] 槽位（渐进匹配）"
    },
    {
      "编号": "W03",
      "步骤": [
        "提取数字",
        "求和"
      ],
      "共享": "\"订单 12 元和 30 元\"",
      "期望": "可接",
      "期望参数": [
        [
          "赵料"
        ],
        [
          "赵果1"
        ]
      ],
      "理由": "提取数字输出 列表[数]，正好喂给求和；这是类型 v2 才能确认安全的接线"
